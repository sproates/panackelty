#!/bin/sh

launcher="$0"
while [ -L "$launcher" ]; do
  directory=$(CDPATH= cd -- "$(dirname -- "$launcher")" && pwd)
  target=$(readlink "$launcher")
  case "$target" in
    /*) launcher="$target" ;;
    *) launcher="$directory/$target" ;;
  esac
done

directory=$(CDPATH= cd -- "$(dirname -- "$launcher")" && pwd)

source_root=$(CDPATH= cd -- "$directory/.." && pwd)

if [ -x "$source_root/panack-vm" ] && [ -f "$source_root/bootstrap/compiler-v9.bc" ]; then
  vm="$source_root/panack-vm"
  compiler="$source_root/bootstrap/compiler-v9.bc"
  stdlib="$source_root/src/stdlib"
  package_tool="$source_root/build/tools/panack-packages.bc"
  version_file="$source_root/VERSION"
else
  prefix=$(CDPATH= cd -- "$directory/.." && pwd)
  vm="$prefix/libexec/panackelty/panack-vm"
  compiler="$prefix/share/panackelty/compiler-v9.bc"
  stdlib="$prefix/share/panackelty/stdlib"
  package_tool="$prefix/share/panackelty/panack-packages-v1.bc"
  version_file="$prefix/share/panackelty/VERSION"
fi

if [ ! -x "$vm" ] || [ ! -f "$compiler" ] || [ ! -d "$stdlib" ] || [ ! -f "$version_file" ]; then
  echo "panack: native toolchain not found; run 'make' in a source checkout or reinstall Panackelty" >&2
  exit 127
fi

if [ "${1-}" = "--version" ]; then
  IFS= read -r release_version < "$version_file"
  printf 'panack %s (bytecode 9)\n' "$release_version"
  exit 0
fi

IFS= read -r release_version < "$version_file"
PANACKELTY_VERSION=$release_version
export PANACKELTY_VERSION
PANACKELTY_STDLIB_PATH=$stdlib
export PANACKELTY_STDLIB_PATH
PANACKELTY_COMPILER_PATH=$compiler
export PANACKELTY_COMPILER_PATH

case "${1-}" in
  deps)
    if [ ! -f "$package_tool" ]; then
      echo "panack: package tool not found; run 'make package-tool' in a source checkout or reinstall Panackelty" >&2
      exit 127
    fi
    shift
    exec "$vm" run "$package_tool" deps "$@"
    ;;
  check|compile|run)
    command=$1
    if [ "${2-}" = "--project" ]; then
      project=${3-}
      if [ -z "$project" ]; then
        echo "panack: --project requires a panack.json path" >&2
        exit 2
      fi
      if [ ! -f "$package_tool" ]; then
        echo "panack: package tool not found; run 'make package-tool' in a source checkout or reinstall Panackelty" >&2
        exit 127
      fi
      shift 3
      descriptor=$(mktemp "${TMPDIR:-/tmp}/panack-resolved.XXXXXX") || {
        echo "panack: cannot create a temporary resolved-project descriptor" >&2
        exit 1
      }
      child=
      project_signal() {
        trap - HUP INT TERM
        status=1
        if [ -n "$child" ]; then
          kill -"$1" "$child" 2>/dev/null || :
          wait "$child"
          status=$?
        fi
        rm -f "$descriptor"
        exit "$status"
      }
      trap 'rm -f "$descriptor"' 0
      trap 'project_signal HUP' HUP
      trap 'project_signal INT' INT
      trap 'project_signal TERM' TERM
      status=0
      "$vm" run "$package_tool" prepare --project "$project" <&0 > "$descriptor" &
      child=$!
      wait "$child" || status=$?
      child=
      if [ "$status" -eq 0 ]; then
        "$vm" run "$compiler" "$command" --resolved-project "$descriptor" "$@" <&0 &
        child=$!
        wait "$child" || status=$?
        child=
      fi
      rm -f "$descriptor"
      trap - 0 HUP INT TERM
      exit "$status"
    fi
    if [ "$command" != compile ]; then
      case "${2-}" in
        *.bc)
          artifact=$2
          shift 2
          exec "$vm" "$command" "$artifact" "$@"
          ;;
      esac
    fi
    ;;
  coverage-run|coverage-session)
    exec "$vm" "$@"
    ;;
  *.bc)
    artifact=$1
    shift
    exec "$vm" run "$artifact" "$@"
    ;;
esac

exec "$vm" run "$compiler" "$@"
