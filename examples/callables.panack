pure square(value: Nat): Nat {
  value * value
}

pure total(accumulator: Nat, value: Nat): Nat {
  accumulator + value
}

main(): Void {
  operation: PureFn[Nat,Nat] = @square
  squares: [Nat] = [1, 2, 3, 4].map(operation)
  print(squares)
  print(squares.reduce(0, @total))
  print(operation.call(5))
}
