import stdlib/text as std_text
import stdlib/bytes as byte_buffer

pure name_before(left: Str, right: Str): Bool { left < right }

main(): Void {
  original: [Nat] = [1, 2]
  extended: [Nat] = original.append(3)
  print(original)
  print(extended)

  mut answers: Map[Str,Nat] = map()
  answers = answers.put("ultimate", 42)
  print(answers.get("ultimate"))

  mut names: Set[Str] = set()
  names = names.add("Panackelty")
  print(names.has("Panackelty"))

  message: Bytes = byte_buffer.push(std_text.encode_utf8("Panack"), 33)
  print(byte_buffer.length(message))
  print(std_text.decode_utf8(message))

  // Use an ordinary pure function to choose the ordering.
  files = ["z.txt", "a.panack", "b.panack"].sort_by(@name_before)
  for file in files {
    if file.ends_with(".panack") { print(file) }
  }
}
