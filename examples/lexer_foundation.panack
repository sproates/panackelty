record SourcePos {
  offset: Nat,
  line: Nat,
  column: Nat
}

enum TokenKind {
  Identifier,
  Number,
  Punctuation
}

record Token {
  kind: TokenKind,
  text: Str,
  start: Nat,
  end: Nat
}

record Diagnostic {
  message: Str,
  position: SourcePos
}



pure scan_number(source: Str, start: Nat): Nat {
  mut cursor: Nat = start
  while cursor < source.len() && source[cursor].is_digit() {
    cursor = cursor + 1
  }
  cursor
}

pure scan_identifier(source: Str, start: Nat): Nat {
  mut cursor: Nat = start
  while cursor < source.len() && (source[cursor].is_letter() || source[cursor].is_digit() || source[cursor] == "_") {
    cursor = cursor + 1
  }
  cursor
}

pure lex(source: Str): Result[[Token],[Diagnostic]] {
  mut tokens: [Token] = []
  mut cursor: Nat = 0

  while cursor < source.len() {
    character: Str = source[cursor]

    if character.is_whitespace() {
      cursor = cursor + 1
    } else if character.is_digit() {
      end: Nat = scan_number(source, cursor)
      text: Str = source.slice(cursor, end)
      tokens = tokens.append(Token(Number(), text, cursor, end))
      cursor = end
    } else if character.is_letter() || character == "_" {
      end: Nat = scan_identifier(source, cursor)
      text: Str = source.slice(cursor, end)
      tokens = tokens.append(Token(Identifier(), text, cursor, end))
      cursor = end
    } else {
      end: Nat = cursor + 1
      tokens = tokens.append(Token(Punctuation(), character, cursor, end))
      cursor = end
    }
  }

  Ok(tokens)
}

pure kind_name(kind: TokenKind): Str {
  match kind {
    Identifier() => "identifier",
    Number() => "number",
    Punctuation() => "punctuation"
  }
}

pure render_tokens(tokens: [Token]): Str {
  mut output: Str = ""
  for token in tokens {
    name: Str = kind_name(token.kind)
    text: Str = token.text
    output = output + "${name}:${text}\n"
  }
  output
}

pure render(result: Result[[Token],[Diagnostic]]): Str {
  match result {
    Ok(tokens) => render_tokens(tokens),
    Error(diagnostics) => "lexing failed"
  }
}

main(): Void {
  print(render(lex("answer_42 + 1729")))
}

