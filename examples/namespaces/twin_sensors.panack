import project/twin_sensors/weather as weather
import project/twin_sensors/navigation as navigation

main(): Void {
  forecast: weather.Reading = weather.latest()
  position: navigation.Reading = navigation.latest()
  temperature = forecast.value
  temperature_unit = forecast.unit
  distance = position.value
  distance_unit = position.unit
  print("Weather: ${temperature} ${temperature_unit}")
  print("Navigation: ${distance} ${distance_unit}")
}
