import project/parser::{parse_response}
import project/transport::{exchange}
import project/types::{HttpError.ConnectFailure, HttpError.DnsFailure,
  HttpError.InvalidLimits, HttpError.InvalidUrl, HttpError.LimitExceeded,
  HttpError.ProtocolError, HttpError.TlsFailure, HttpError.Timeout,
  HttpError.TransportFailure, HttpError.UnsupportedHost}
import stdlib/bytes as byte_buffer
import stdlib/text as text

pub import project/types::{Header, HttpError, Response}

pub record ClientLimits {
  timeout_ms: Nat,
  header_limit: Nat,
  body_limit: Nat
}

record ParsedUrl {
  host: Str,
  port: Nat,
  tls: Bool,
  target: Str,
  host_header: Str
}

pure byte_length(data: Bytes): Nat { data->length() }
pure byte_at(data: Bytes, index: Nat): Nat { data->at(index) }

pure slice_text(data: Bytes, start: Nat, end: Nat): Str {
  mut output: Bytes = byte_buffer.empty()
  mut cursor = start
  while cursor < end {
    output = output->push(byte_at(data, cursor))
    cursor = cursor + 1
  }
  output->decode_utf8()
}

pure ascii_host_valid(host: Bytes): Bool {
  size: Nat = byte_length(host)
  if size == 0 || size > 253 { false }
  else {
  mut valid = true
  mut label_length: Nat = 0
  mut label_start_hyphen = false
  mut only_numeric_ipv4 = true
  mut ipv4_parts: [Nat] = []
  mut part_value: Nat = 0
  mut part_digits: Nat = 0
  mut cursor: Nat = 0
  while cursor < size && valid {
    byte: Nat = byte_at(host, cursor)
    if byte == 46 {
      previous: Nat = if cursor == 0 { 0 } else { byte_at(host, cursor - 1) }
      if label_length == 0 || label_start_hyphen || previous == 45 {
        valid = false
      } else {
        ipv4_parts = ipv4_parts->append(part_value)
        part_value = 0
        part_digits = 0
        label_length = 0
        label_start_hyphen = false
      }
    } else {
      ascii_alphanumeric: Bool = (byte >= 48 && byte <= 57) ||
        (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122)
      if !ascii_alphanumeric && byte != 45 { valid = false }
      if byte >= 48 {
        digit: Nat = byte - 48
        if digit <= 9 {
          part_value = part_value * 10 + digit
          part_digits = part_digits + 1
          if part_digits > 3 || part_value > 255 { valid = false }
        } else { only_numeric_ipv4 = false }
      } else { only_numeric_ipv4 = false }
      if label_length == 0 { label_start_hyphen = byte == 45 }
      label_length = label_length + 1
      if label_length > 63 { valid = false }
    }
    cursor = cursor + 1
  }
  if label_length == 0 || label_start_hyphen || byte_at(host, size - 1) == 45 { valid = false }
  if only_numeric_ipv4 {
    ipv4_parts = ipv4_parts->append(part_value)
    if ipv4_parts->len() != 4 { valid = false }
  }
  valid
  }
}

pure parse_port(data: Bytes, start: Nat, end: Nat): Result[Nat,HttpError] {
  if start == end { Error(InvalidUrl("port is empty")) }
  else {
    mut value: Nat = 0
    mut valid = true
    mut cursor = start
    while cursor < end {
      byte: Nat = byte_at(data, cursor)
      if byte >= 48 {
        digit: Nat = byte - 48
        if digit > 9 { valid = false }
        else {
          value = value * 10 + digit
          if value > 65535 { valid = false }
        }
      } else { valid = false }
      cursor = cursor + 1
    }
    if !valid || value == 0 { Error(InvalidUrl("port must be between 1 and 65535")) }
    else { Ok(value) }
  }
}

pure parse_url(url: Str): Result[ParsedUrl,HttpError] {
  data: Bytes = url->encode_utf8()
  size: Nat = byte_length(data)
  mut invalid_char = false
  mut fragment = false
  mut cursor: Nat = 0
  while cursor < size {
    byte: Nat = byte_at(data, cursor)
    if byte == 35 { fragment = true }
    if byte <= 32 || byte == 127 { invalid_char = true }
    cursor = cursor + 1
  }
  tls: Bool = url->starts_with_at("https://", 0)
  scheme_length: Nat = if tls { 8 } else { if url->starts_with_at("http://", 0) { 7 } else { 0 } }
  if invalid_char || fragment || scheme_length == 0 || size > 8192 {
    Error(InvalidUrl("unsupported or malformed HTTP URL"))
  } else {
    mut authority_end = scheme_length
    while authority_end < size && byte_at(data, authority_end) != 47 &&
        byte_at(data, authority_end) != 63 && byte_at(data, authority_end) != 35 {
      authority_end = authority_end + 1
    }
    mut at_sign = false
    mut colon: Option[Nat] = None()
    mut multiple_colons = false
    cursor = scheme_length
    while cursor < authority_end {
      byte: Nat = byte_at(data, cursor)
      if byte == 64 { at_sign = true }
      else if byte == 58 {
        if colon == None() { colon = Some(cursor) } else { multiple_colons = true }
      }
      cursor = cursor + 1
    }
    if authority_end == scheme_length || at_sign {
      Error(InvalidUrl("HTTP URL authority is empty or contains userinfo"))
    } else if byte_at(data, scheme_length) == 91 || multiple_colons {
      Error(UnsupportedHost())
    } else {
      host_end: Nat = match colon { None() => authority_end, Some(position) => position }
      mut host_bytes: Bytes = byte_buffer.empty()
      mut host_cursor = scheme_length
      while host_cursor < host_end {
        host_bytes = host_bytes->push(byte_at(data, host_cursor))
        host_cursor = host_cursor + 1
      }
      if !ascii_host_valid(host_bytes) {
        Error(UnsupportedHost())
      } else {
        port_result: Result[Nat,HttpError] = match colon {
          None() => Ok(if tls { 443 } else { 80 }),
          Some(position) => parse_port(data, position + 1, authority_end)
        }
        match port_result {
          Error(error) => Error(error),
          Ok(port) => {
            target: Str = if authority_end == size { "/" } else {
              if byte_at(data, authority_end) == 63 {
                "/" + slice_text(data, authority_end, size)
              } else {
                slice_text(data, authority_end, size)
              }
            }
            target_bytes: Bytes = target->encode_utf8()
            mut target_valid = byte_length(target_bytes) > 0 && byte_at(target_bytes, 0) == 47
            cursor = 0
            while cursor < byte_length(target_bytes) {
              byte: Nat = byte_at(target_bytes, cursor)
              if byte < 33 || byte > 126 { target_valid = false }
              cursor = cursor + 1
            }
            if !target_valid {
              Error(InvalidUrl("HTTP origin-form path contains unsupported characters"))
            } else {
              host: Str = host_bytes->decode_utf8()
              host_header: Str = if colon != None() { "${host}:${port}" } else { host }
              Ok(ParsedUrl(host, port, tls, target, host_header))
            }
          }
        }
      }
    }
  }
}

pure transport_error(message: Str): HttpError {
  if message == "HTTP DNS failed" { DnsFailure() }
  else if message == "HTTP connection failed" { ConnectFailure() }
  else if message == "HTTP TLS verification failed" || message == "HTTP TLS failed" { TlsFailure() }
  else if message == "HTTP transport timed out" { Timeout() }
  else if message == "HTTP response limit exceeded" { LimitExceeded("response") }
  else { TransportFailure("HTTP transport failed") }
}

pub async get(url: Str): Result[Response,HttpError] {
  await get_with_limits(url, ClientLimits(10000, 65536, 1048576))
}

pub async get_with_limits(url: Str, limits: ClientLimits): Result[Response,HttpError] {
  if limits.timeout_ms == 0 || limits.timeout_ms > 60000 || limits.header_limit == 0 ||
      limits.header_limit > 65536 || limits.body_limit == 0 || limits.body_limit > 1048576 {
    Error(InvalidLimits())
  } else {
    match parse_url(url) {
      Error(error) => Error(error),
      Ok(parsed) => {
        target: Str = parsed.target
        host_header: Str = parsed.host_header
        request: Bytes = ("GET ${target} HTTP/1.1\r\nHost: ${host_header}\r\n" +
          "Accept-Encoding: identity\r\nConnection: close\r\n\r\n")->encode_utf8()
        raw: Result[Bytes,Str] = await exchange(parsed.host, parsed.port, parsed.tls,
          request, 16777216, limits.timeout_ms)
        match raw {
          Error(message) => Error(transport_error(message)),
          Ok(bytes) => parse_response(bytes, limits.header_limit, limits.body_limit)
        }
      }
    }
  }
}
