pub import project/types::{Header, HttpError}
import project/types::{HttpError.Cancelled, HttpError.ConnectFailure, HttpError.DnsFailure,
  HttpError.InvalidLimits, HttpError.InvalidRequest, HttpError.InvalidResponse,
  HttpError.InvalidUrl, HttpError.LimitExceeded, HttpError.ProtocolError,
  HttpError.TlsFailure, HttpError.Timeout, HttpError.TransportFailure,
  HttpError.UnsupportedHost, HttpError.UnsupportedMethod,
  HttpError.UnsupportedTransferEncoding, HttpError.UnsupportedVersion}

pub pure reason_phrase(status: Nat): Str {
  if status == 200 { "OK" }
  else if status == 201 { "Created" }
  else if status == 202 { "Accepted" }
  else if status == 204 { "No Content" }
  else if status == 301 { "Moved Permanently" }
  else if status == 302 { "Found" }
  else if status == 304 { "Not Modified" }
  else if status == 308 { "Permanent Redirect" }
  else if status == 400 { "Bad Request" }
  else if status == 401 { "Unauthorized" }
  else if status == 403 { "Forbidden" }
  else if status == 404 { "Not Found" }
  else if status == 405 { "Method Not Allowed" }
  else if status == 408 { "Request Timeout" }
  else if status == 413 { "Content Too Large" }
  else if status == 415 { "Unsupported Media Type" }
  else if status == 417 { "Expectation Failed" }
  else if status == 431 { "Request Header Fields Too Large" }
  else if status == 500 { "Internal Server Error" }
  else if status == 501 { "Not Implemented" }
  else if status == 503 { "Service Unavailable" }
  else if status == 504 { "Gateway Timeout" }
  else if status == 505 { "HTTP Version Not Supported" }
  else { "Response" }
}

pub pure header_name_valid(value: Str): Bool {
  encoded: Bytes = value.encode_utf8()
  mut valid = encoded.length() > 0
  mut cursor: Nat = 0
  while cursor < encoded.length() {
    byte: Nat = encoded.at(cursor)
    token: Bool = (byte >= 48 && byte <= 57) || (byte >= 65 && byte <= 90) ||
      (byte >= 97 && byte <= 122) || byte == 33 || byte == 35 || byte == 36 ||
      byte == 37 || byte == 38 || byte == 39 || byte == 42 || byte == 43 ||
      byte == 45 || byte == 46 || byte == 94 || byte == 95 || byte == 96 ||
      byte == 124 || byte == 126
    if !token { valid = false }
    cursor = cursor + 1
  }
  valid
}

pub pure header_value_valid(value: Str): Bool {
  encoded: Bytes = value.encode_utf8()
  mut valid = true
  mut cursor: Nat = 0
  while cursor < encoded.length() {
    byte: Nat = encoded.at(cursor)
    if byte != 9 && (byte < 32 || byte > 126) { valid = false }
    cursor = cursor + 1
  }
  valid
}

pub pure lower(value: Str): Str {
  encoded: Bytes = value.encode_utf8()
  mut output: Bytes = "".encode_utf8()
  mut cursor: Nat = 0
  while cursor < encoded.length() {
    byte: Nat = encoded.at(cursor)
    output = output.push(if byte >= 65 && byte <= 90 { byte + 32 } else { byte })
    cursor = cursor + 1
  }
  output.decode_utf8()
}

// Fixed routed-server policy. The legacy serializer keeps its existing budgets
// until all callers migrate; both serializers share token and status spelling.
pub pure routed_wire(status: Nat, headers: [Header], body: Bytes): Result[Bytes,Str] {
  mut valid = status >= 200 && status <= 599 && body.length() <= 1048576
  if (status == 204 || status == 304) && body.length() != 0 { valid = false }
  phrase = reason_phrase(status)
  mut head = "HTTP/1.1 ${status} ${phrase}\r\n".encode_utf8()
  for header in headers {
    name = lower(header.name)
    if !header_name_valid(header.name) || !header_value_valid(header.value) ||
        name == "content-length" || name == "transfer-encoding" || name == "connection" {
      valid = false
    }
    if valid {
      header_name = header.name
      header_value = header.value
      field = "${header_name}: ${header_value}\r\n".encode_utf8()
      if head.length() + field.length() > 16384 { valid = false }
      else { head = head.join(field) }
    }
  }
  if valid && status != 204 && status != 304 {
    length = body.length()
    head = head.join("Content-Length: ${length}\r\n".encode_utf8())
  }
  head = head.join("Connection: close\r\n\r\n".encode_utf8())
  if valid && head.length() <= 16384 { Ok(head.join(body)) }
  else { Error("invalid HTTP response or response limit exceeded") }
}

pub pure error_status(error: HttpError): Nat {
  match error {
    UnsupportedMethod(method) => 405,
    UnsupportedVersion(version) => 505,
    UnsupportedTransferEncoding() => 501,
    LimitExceeded(limit) => if limit == "request headers" || limit == "request headers and trailers" { 431 } else { 413 },
    ProtocolError(message) => 400,
    InvalidRequest() => 400,
    InvalidResponse() => 500,
    InvalidUrl(url) => 500,
    InvalidLimits() => 500,
    DnsFailure() => 500,
    ConnectFailure() => 500,
    TlsFailure() => 500,
    Timeout() => 500,
    Cancelled() => 500,
    UnsupportedHost() => 500,
    TransportFailure(message) => 500
  }
}
