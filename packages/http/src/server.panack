import stdlib/tcp as transport
import project/parser::{parse_request_for_methods}
import project/types::{HttpError.Cancelled, HttpError.ConnectFailure, HttpError.DnsFailure,
  HttpError.InvalidLimits, HttpError.InvalidRequest, HttpError.InvalidResponse,
  HttpError.InvalidUrl, HttpError.LimitExceeded, HttpError.ProtocolError,
  HttpError.TlsFailure, HttpError.Timeout, HttpError.TransportFailure,
  HttpError.UnsupportedHost, HttpError.UnsupportedMethod,
  HttpError.UnsupportedTransferEncoding, HttpError.UnsupportedVersion}
import stdlib/bytes as byte_buffer
import stdlib/tcp::{TcpServerLimits}

pub import project/types::{Header, HttpError, Request, Response}

pub record ServerLimits {
  clients: Nat,
  concurrency: Nat,
  request_limit: Nat,
  response_limit: Nat,
  client_timeout_ms: Nat,
  admission_timeout_ms: Nat,
  drain_ms: Nat
}

// Call from a concrete named worker; generic function references are not needed.
pub record ConnectionContext[T] {
  configuration: T,
  handler: AsyncFn[T,Request,Result[Response,HttpError]],
  request_limit: Nat,
  response_limit: Nat
}

// Error headers apply to responses generated by the connection worker. Normal
// responses remain owned by the application's handler.
pub record ConnectionPolicy {
  methods: [Str],
  error_headers: [Header]
}

record ServeContext {
  handler: AsyncFn[Request,Result[Response,HttpError]],
  request_limit: Nat,
  response_limit: Nat
}

pure reason_phrase(status: Nat): Str {
  if status == 200 { "OK" }
  else if status == 201 { "Created" }
  else if status == 202 { "Accepted" }
  else if status == 204 { "No Content" }
  else if status == 301 { "Moved Permanently" }
  else if status == 302 { "Found" }
  else if status == 304 { "Not Modified" }
  else if status == 308 { "Permanent Redirect" }
  else if status == 400 { "Bad Request" }
  else if status == 401 { "Unauthorized" }
  else if status == 403 { "Forbidden" }
  else if status == 404 { "Not Found" }
  else if status == 405 { "Method Not Allowed" }
  else if status == 408 { "Request Timeout" }
  else if status == 413 { "Content Too Large" }
  else if status == 415 { "Unsupported Media Type" }
  else if status == 431 { "Request Header Fields Too Large" }
  else if status == 500 { "Internal Server Error" }
  else if status == 501 { "Not Implemented" }
  else if status == 503 { "Service Unavailable" }
  else if status == 505 { "HTTP Version Not Supported" }
  else { "Response" }
}

pure header_name_valid(value: Str): Bool {
  encoded: Bytes = value->encode_utf8()
  mut valid = encoded->length() > 0
  mut cursor: Nat = 0
  while cursor < encoded->length() {
    byte: Nat = encoded->at(cursor)
    token: Bool = (byte >= 48 && byte <= 57) || (byte >= 65 && byte <= 90) ||
      (byte >= 97 && byte <= 122) || byte == 33 || byte == 35 || byte == 36 ||
      byte == 37 || byte == 38 || byte == 39 || byte == 42 || byte == 43 ||
      byte == 45 || byte == 46 || byte == 94 || byte == 95 || byte == 96 ||
      byte == 124 || byte == 126
    if !token { valid = false }
    cursor = cursor + 1
  }
  valid
}

pure header_value_valid(value: Str): Bool {
  encoded: Bytes = value->encode_utf8()
  mut valid = true
  mut cursor: Nat = 0
  while cursor < encoded->length() {
    byte: Nat = encoded->at(cursor)
    if byte != 9 && (byte < 32 || byte > 126) { valid = false }
    cursor = cursor + 1
  }
  valid
}

pure lower(value: Str): Str {
  encoded: Bytes = value->encode_utf8()
  mut output: Bytes = byte_buffer.empty()
  mut cursor: Nat = 0
  while cursor < encoded->length() {
    byte: Nat = encoded->at(cursor)
    output = output->push(if byte >= 65 && byte <= 90 { byte + 32 } else { byte })
    cursor = cursor + 1
  }
  output->decode_utf8()
}

pure response_headers_valid(response: Response): Bool {
  mut valid = response.status >= 200 && response.status <= 599
  mut content_length_seen = false
  mut connection_seen = false
  body_length: Nat = response.body->length()
  body_length_text: Str = "${body_length}"
  for header in response.headers {
    name: Str = lower(header.name)
    if !header_name_valid(header.name) || !header_value_valid(header.value) {
      valid = false
    } else if name == "transfer-encoding" {
      valid = false
    } else if name == "content-length" {
      if content_length_seen || header.value != body_length_text ||
          response.status == 204 || response.status == 304 {
        valid = false
      }
      content_length_seen = true
    } else if name == "connection" {
      if connection_seen || lower(header.value) != "close" { valid = false }
      connection_seen = true
    }
  }
  if (response.status == 204 || response.status == 304) && response.body->length() != 0 {
    valid = false
  }
  valid
}

// HEAD validates the same representation as GET, but sends only its headers.
pub pure serialize_head_response(response: Response): Result[Bytes,HttpError] {
  serialize_response_mode(response, true)
}

pub pure serialize_response(response: Response): Result[Bytes,HttpError] {
  serialize_response_mode(response, false)
}

pure serialize_response_mode(response: Response, head_only: Bool): Result[Bytes,HttpError] {
  if !response_headers_valid(response) {
    Error(InvalidResponse())
  } else if response.body->length() > 1048576 {
    Error(LimitExceeded("response"))
  } else {
    status: Nat = response.status
    status_text: Str = reason_phrase(status)
    mut output: Bytes = "HTTP/1.1 ${status} ${status_text}\r\n"->encode_utf8()
    mut too_large = false
    for header in response.headers {
      name: Str = lower(header.name)
      if !too_large && name != "content-length" && name != "connection" {
        header_name: Str = header.name
        header_value: Str = header.value
        field: Bytes = "${header_name}: ${header_value}\r\n"->encode_utf8()
        if output->length() + field->length() > 1048576 {
          too_large = true
        } else {
          output = output->join(field)
        }
      }
    }
    if response.status != 204 && response.status != 304 {
      body_length: Nat = response.body->length()
      body_length_text: Str = "${body_length}"
      framing: Bytes = "Content-Length: ${body_length_text}\r\n"->encode_utf8()
      if output->length() + framing->length() > 1048576 {
        too_large = true
      } else {
        output = output->join(framing)
      }
    }
    closing: Bytes = "Connection: close\r\n\r\n"->encode_utf8()
    total_length: Nat = output->length() + closing->length() +
      response.body->length()
    if too_large || total_length > 1048576 {
      Error(LimitExceeded("response"))
    } else {
      output = output->join(closing)
      Ok(if head_only { output } else { output->join(response.body) })
    }
  }
}

pure error_status(error: HttpError): Nat {
  match error {
    UnsupportedMethod(method) => 405,
    UnsupportedVersion(version) => 505,
    UnsupportedTransferEncoding() => 501,
    LimitExceeded(limit) => if limit == "request headers" || limit == "request headers and trailers" { 431 } else { 413 },
    ProtocolError(message) => 400,
    InvalidRequest() => 400,
    InvalidResponse() => 500,
    InvalidUrl(url) => 500,
    InvalidLimits() => 500,
    DnsFailure() => 500,
    ConnectFailure() => 500,
    TlsFailure() => 500,
    Timeout() => 500,
    Cancelled() => 500,
    UnsupportedHost() => 500,
    TransportFailure(message) => 500
  }
}

pure simple_response(status: Nat, message: Str, head_only: Bool): Bytes {
  simple_response_with_headers(status, message, head_only, [])
}

pure simple_response_with_headers(
  status: Nat, message: Str, head_only: Bool, headers: [Header]
): Bytes {
  body: Bytes = message->encode_utf8()
  response: Response = Response(status,
    headers->append(Header("Content-Type", "text/plain; charset=utf-8")), body)
  serialize_response_mode(response, head_only)->value_or("HTTP/1.1 500 Internal Server Error\r\nContent-Length: 0\r\nConnection: close\r\n\r\n"->encode_utf8())
}

pure response_for_error(error: HttpError, head_only: Bool, policy: ConnectionPolicy): Bytes {
  status: Nat = error_status(error)
  if status == 405 {
    body: Bytes = "Method Not Allowed"->encode_utf8()
    mut allowed = ""
    for method in policy.methods {
      allowed = allowed + (if allowed == "" { "" } else { ", " }) + method
    }
    response: Response = Response(status,
      policy.error_headers->append(Header("Allow", allowed))->append(
        Header("Content-Type", "text/plain; charset=utf-8")), body)
    serialize_response_mode(response, head_only)->value_or(simple_response(500, "Internal Server Error", head_only))
  } else if status == 501 {
    simple_response_with_headers(status, "Not Implemented", head_only, policy.error_headers)
  } else if status == 505 {
    simple_response_with_headers(status, "HTTP Version Not Supported", head_only, policy.error_headers)
  } else if status == 413 {
    simple_response_with_headers(status, "Content Too Large", head_only, policy.error_headers)
  } else if status == 431 {
    simple_response_with_headers(status, "Request Header Fields Too Large", head_only, policy.error_headers)
  } else {
    simple_response_with_headers(status,
      if status == 500 { "Internal Server Error" } else { "Bad Request" }, head_only, policy.error_headers)
  }
}

// Recognise the exact method token even when later request framing is invalid.
// This lets parser errors obey HEAD's no-body rule too.
pure is_head_request(incoming: Bytes): Bool {
  incoming->length() >= 5 && incoming->at(0) == 72 &&
    incoming->at(1) == 69 && incoming->at(2) == 65 &&
    incoming->at(3) == 68 && incoming->at(4) == 32
}

pure successful_report(): Result[Unit,HttpError] { Ok(()) }
pure failed_report(problem: Str): Result[Unit,HttpError] {
  Error(TransportFailure(problem))
}

async invoke_legacy_handler(
  handler: AsyncFn[Request,Result[Response,HttpError]],
  request: Request
): Result[Response,HttpError] {
  await handler->call(request)
}

async serve_connection(context: ServeContext): Result[Bytes,Str] {
  configured: ConnectionContext[AsyncFn[Request,Result[Response,HttpError]]] =
    ConnectionContext(context.handler, @invoke_legacy_handler,
      context.request_limit, context.response_limit)
  await serve_connection_with_context[AsyncFn[Request,Result[Response,HttpError]]](configured)
}

pub async serve_connection_with_context[T](
  context: ConnectionContext[T]
): Result[Bytes,Str] {
  await serve_connection_with_policy[T](context, ConnectionPolicy(["GET", "HEAD", "POST"], []))
}

pub async serve_connection_with_policy[T](
  context: ConnectionContext[T],
  policy: ConnectionPolicy
): Result[Bytes,Str] {
  mut incoming: Bytes = byte_buffer.empty()
  mut outcome: Result[Bytes,Str] = Error("HTTP request failed")
  mut finished = false
  mut head_only = false
  while !finished {
    match await transport.read_chunk(16384) {
      Error(problem) => {
        if problem == "TCP request limit exceeded" {
          outcome = Ok(simple_response_with_headers(
            413, "Content Too Large", head_only, policy.error_headers))
        } else {
          outcome = Error(problem)
        }
        finished = true
      },
      Ok(chunk) => {
        incoming = incoming->join(chunk)
        head_only = is_head_request(incoming)
        eof: Bool = chunk->length() == 0
        match parse_request_for_methods(incoming, eof, context.request_limit, policy.methods) {
          Error(error) => {
            outcome = Ok(response_for_error(error, head_only, policy))
            finished = true
          },
          Ok(parsed) => match parsed {
            None() => { finished = false },
            Some(request) => {
              match await context.handler->call(context.configuration, request) {
                Error(error) => {
                  outcome = Ok(simple_response_with_headers(
                    500, "Internal Server Error", head_only, policy.error_headers))
                  finished = true
                },
                Ok(response) => match serialize_response_mode(response, head_only) {
                  Error(error) => {
                    outcome = Ok(simple_response_with_headers(
                      500, "Internal Server Error", head_only, policy.error_headers))
                    finished = true
                  },
                  Ok(wire) => if wire->length() > context.response_limit {
                    outcome = Error("TCP response limit exceeded")
                    finished = true
                  } else {
                    outcome = Ok(wire)
                    finished = true
                  }
                }
              }
            }
          }
        }
      }
    }
  }
  outcome
}

pub async serve(
  address: Str,
  port: Nat,
  handler: AsyncFn[Request,Result[Response,HttpError]],
  limits: ServerLimits
): Result[[Result[Unit,HttpError]],HttpError] {
  tcp_limits: TcpServerLimits = TcpServerLimits(
    limits.clients,
    limits.concurrency,
    limits.request_limit,
    limits.response_limit,
    limits.client_timeout_ms,
    limits.admission_timeout_ms,
    limits.drain_ms
  )
  context: ServeContext = ServeContext(handler, limits.request_limit, limits.response_limit)
  match await transport.serve_stream(address, port, @serve_connection, context, tcp_limits) {
    Error(problem) => if problem == "invalid TCP server arguments" {
      Error(InvalidLimits())
    } else { Error(TransportFailure(problem)) },
    Ok(reports) => {
      mut results: [Result[Unit,HttpError]] = []
      for report in reports {
        match report {
          Ok(done) => { results = results->append(successful_report()) },
          Error(problem) => { results = results->append(failed_report(problem)) }
        }
      }
      Ok(results)
    }
  }
}
