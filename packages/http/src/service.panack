import stdlib/tcp_service as transport
import project/server as server

pub import stdlib/tcp_service::{TcpServiceReady, TcpServiceSummary}
pub import project/server::{ConnectionContext, serve_connection_with_context}
pub import project/types::{HttpError, HttpError.InvalidLimits, HttpError.TransportFailure}

pub record ServiceLimits {
  concurrency: Nat,
  request_limit: Nat,
  response_limit: Nat,
  client_timeout_ms: Nat,
  drain_ms: Nat
}

// worker is a concrete wrapper around serve_connection_with_context. This keeps
// configuration explicit without requiring captured or generic function values.
pub async serve[T](
  address: Str,
  port: Nat,
  worker: AsyncFn[server.ConnectionContext[T],Result[Bytes,Str]],
  context: server.ConnectionContext[T],
  limits: ServiceLimits,
  ready: AsyncFn[TcpServiceReady,Result[Unit,Str]]
): Result[TcpServiceSummary,HttpError] {
  native_limits = transport.TcpServiceLimits(limits.concurrency, limits.request_limit,
    limits.response_limit, limits.client_timeout_ms, limits.drain_ms)
  match await transport.serve[server.ConnectionContext[T]](
    address, port, worker, context, native_limits, ready
  ) {
    Ok(summary) => Ok(summary),
    Error(problem) => if problem == "invalid TCP server arguments" {
      Error(InvalidLimits())
    } else { Error(TransportFailure(problem)) }
  }
}
