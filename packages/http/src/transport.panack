import stdlib/http_transport as transport
// Package-private adapter boundary. The native operation returns raw bytes;
// the Panackelty parser owns response framing and public errors.
pub async exchange(host: Str, port: Nat, tls: Bool, request: Bytes,
    response_limit: Nat, timeout_ms: Nat): Result[Bytes,Str] {
  await transport.exchange(host, port, tls, request, response_limit, timeout_ms)
}
