import http/server as http
import http/types::{Response}
import project/policy::{header_name_valid, header_value_valid, wire_size}
import project/paths as paths
import project/mime as mime
import stdlib/async_filesystem as filesystem
import stdlib/async_host as host
import stdlib/bytes as buffer
import stdlib/path as path

pub import http/types::{Header}
pub record Endpoint { address: Str, port: Nat }

pub record Config {
  root: Path,
  address: Str,
  port: Nat,
  request_body_limit: Nat,
  response_limit: Nat,
  headers: [Header]
}

record Context {
  configuration: Config,
  identity: filesystem.FilesystemRootIdentity
}

pure lower(input_text: Str): Str {
  mut output = buffer.empty()
  input = input_text.encode_utf8()
  for index in 0..input.length() {
    value = input.at(index)
    output = output.push(if value >= 65 && value <= 90 { value + 32 } else { value })
  }
  output.decode_utf8()
}

pure headers_valid(configuration: Config): Bool {
  mut valid = configuration.request_body_limit <= 1048576 &&
    configuration.response_limit > 512 && configuration.response_limit <= 1048576
  mut header_bytes: Nat = 0
  for header in configuration.headers {
    name = lower(header.name)
    if name == "content-length" || name == "transfer-encoding" || name == "connection" ||
      name == "content-type" || name == "location" || name == "allow" ||
      !header_name_valid(header.name) || !header_value_valid(header.value) { valid = false }
    header_bytes = header_bytes + header.name.encode_utf8().length() + header.value.encode_utf8().length() + 4
  }
  valid && header_bytes + 512 < configuration.response_limit && header_bytes + 512 <= 16384
}

pure error_response(configuration: Config, status: Nat, message: Str): Response {
  headers = configuration.headers.append(Header("Content-Type", "text/plain; charset=utf-8"))
  Response(status, headers, (message + "\n").encode_utf8())
}

async diagnostic(configuration: Config, status: Nat, message: Str): Response {
  ignored = await host.stderr("http-server: " + message)
  error_response(configuration, status, message)
}

async read_failure(configuration: Config, problem: filesystem.HostError): Response {
  code = problem.code
  if code == "not_found" || code == "permission_denied" || code == "not_directory" ||
    code == "not_regular_file" || code == "is_directory" || code == "symlink_loop" ||
    code == "invalid_argument" || code == "out_of_range" {
    error_response(configuration, 404, "Not found")
  } else if code == "output_limit" || code == "resource_limit" {
    limit = configuration.response_limit
    await diagnostic(configuration, 503, "resource limit exceeded (response limit ${limit} bytes)")
  } else {
    await diagnostic(configuration, 500, "file read failed: " + code)
  }
}

async file_response(context: Context, filename: Str, file: filesystem.FilesystemRootRead): Response {
  configuration = context.configuration
  if file.identity != context.identity {
    await diagnostic(configuration, 503, "configured root was replaced")
  } else {
    response = Response(200,
      configuration.headers.append(Header("Content-Type", mime.content_type(lower(filename)))),
      file.contents)
    if wire_size(response) > configuration.response_limit {
      await diagnostic(configuration, 503, "file exceeds serialized response limit")
    } else { response }
  }
}

async index_response(context: Context, target: paths.Target): Response {
  configuration = context.configuration
  filename = target.relative + (if target.slash { "" } else { "/" }) + "index.html"
  match path.from_text(filename) {
    Error(problem) => error_response(configuration, 400, "Invalid path"),
    Ok(relative) => match await filesystem.read_beneath(configuration.root, relative,
      configuration.response_limit) {
      Error(problem) => await read_failure(configuration, problem),
      Ok(file) => if file.identity != context.identity {
        await diagnostic(configuration, 503, "configured root was replaced")
      } else if !target.slash {
        Response(308, configuration.headers.append(Header("Location", target.redirect)),
          buffer.empty())
      } else { await file_response(context, filename, file) }
    }
  }
}

async prepare(context: Context, request: http.Request): Response {
  configuration = context.configuration
  response = if request.body.length() > configuration.request_body_limit {
    error_response(configuration, 413, "Content Too Large")
  } else if request.method != "GET" {
    Response(405, configuration.headers.append(Header("Allow", "GET")),
      "Method not allowed\n".encode_utf8())
  } else {
    raw_target = request.path + (if request.query == "" { "" } else { "?" + request.query })
    match paths.parse(raw_target) {
      Error(problem) => error_response(configuration, 400, "Invalid URL path"),
      Ok(target) => if target.slash {
        await index_response(context, target)
      } else {
        match path.from_text(target.relative) {
          Error(problem) => error_response(configuration, 400, "Invalid path"),
          Ok(relative) => match await filesystem.read_beneath(configuration.root, relative,
            configuration.response_limit) {
            Ok(file) => await file_response(context, target.relative, file),
            Error(problem) => if problem.code == "not_regular_file" || problem.code == "is_directory" {
              await index_response(context, target)
            } else { await read_failure(configuration, problem) }
          }
        }
      }
    }
  }
  response
}

async respond(context: Context, request: http.Request, writer: http.ResponseWriter): Result[Unit,Str] {
  response = await prepare(context, request)
  writer.status(response.status)
  for header in response.headers { writer.add_header(header.name, header.value) }
  writer.send_bytes(response.body)
  Ok(())
}

// Root validation precedes bind/readiness, including roots with no index file.
pub async serve(configuration: Config,
  ready: AsyncFn[Endpoint,Result[Unit, Str]]): Result[Unit, Str] {
  if !headers_valid(configuration) { Error("invalid headers or response budget") }
  else {
    match await filesystem.root_identity(configuration.root) {
      Error(problem) => Error("invalid document root: " + problem.code),
      Ok(identity) => {
        server = http.create_bound_contextual_server(configuration.address, configuration.port,
          Context(configuration, identity))
        server.fallback(@respond)
        match await server.listen() {
          Error(problem) => Error("HTTP service failed: " + problem.message),
          Ok(done) => match await ready.call(Endpoint(configuration.address, configuration.port)) {
            Ok(ready_done) => Ok(()),
            Error(problem) => {
              ignored = await server.destroy()
              Error(problem)
            }
          }
        }
      }
    }
  }
}
