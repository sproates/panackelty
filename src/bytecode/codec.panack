import stdlib/bytes as byte_buffer
import project/src/compiler/emitter::{
  Instruction,
  Instruction.ConstInstruction, Instruction.LoadInstruction, Instruction.StoreInstruction,
  Instruction.PopInstruction, Instruction.UnaryInstruction, Instruction.BinaryInstruction,
  Instruction.MakeRangeInstruction, Instruction.MakeArrayInstruction, Instruction.IndexGetInstruction,
  Instruction.InterpolateInstruction, Instruction.IterInitInstruction, Instruction.IterNextInstruction,
  Instruction.MakeRecordInstruction, Instruction.FieldGetInstruction, Instruction.MakeVariantInstruction,
  Instruction.MatchVariantInstruction, Instruction.MatchFailInstruction, Instruction.CallInstruction,
  Instruction.CallValueInstruction, Instruction.AwaitCallInstruction, Instruction.AwaitValueInstruction,
  Instruction.JumpFalseInstruction, Instruction.JumpInstruction, Instruction.PendingEndJumpInstruction,
  Instruction.ReturnInstruction,
  ConstantValue, ConstantValue.NatConstant, ConstantValue.IntConstant, ConstantValue.DecimalConstant,
  ConstantValue.DecimalPartsConstant, ConstantValue.StringConstant, ConstantValue.BoolConstant,
  ConstantValue.VoidConstant, compile_program
}
pub import project/src/compiler/emitter::{BytecodeProgram, FunctionCode}
import project/src/compiler/purity::{check_program_frontend}
import project/src/compiler/parser::{Diagnostic, lex, parse_program_complete}

pub pure encode_u8(value: Nat): Bytes {
  byte_buffer.empty().push(value)
}

pure encode_u16(value: Nat): Bytes {
  mut output: Bytes = byte_buffer.empty()
  output = output.push((value.divide(256)) % 256)
  output.push(value % 256)
}

pub pure encode_u32(value: Nat): Bytes {
  mut output: Bytes = byte_buffer.empty()
  output = output.push((value.divide(16777216)) % 256)
  output = output.push((value.divide(65536)) % 256)
  output = output.push((value.divide(256)) % 256)
  output.push(value % 256)
}

pure encode_i16_negative(magnitude: Nat): Bytes {
  if magnitude <= 32768 {
    mut encoded: Nat = 65536
    mut remaining: Nat = magnitude
    while remaining > 0 {
      if encoded > 0 { encoded = encoded - 1; } else {}
      remaining = remaining - 1
    }
    encode_u16(encoded)
  } else {
    byte_buffer.empty()
  }
}

pure encode_name(value: Str): Bytes {
  encoded: Bytes = value.encode_utf8()
  encode_u16(encoded.length()).join(encoded)
}

pub pure encode_text(value: Str): Bytes {
  encoded: Bytes = value.encode_utf8()
  encode_u32(encoded.length()).join(encoded)
}

pure encode_nat_body(value: Nat): Bytes {
  if value < 256 {
    encode_u8(value)
  } else {
    encode_nat_body(value.divide(256)).push(value % 256)
  }
}

pure encode_natural(value: Nat): Bytes {
  if value == 0 {
    encode_u16(0)
  } else {
    body: Bytes = encode_nat_body(value)
    encode_u16(body.length()).join(body)
  }
}

pure decimal_digits(text: Str): [Nat] {
  mut digits: [Nat] = []
  mut seen_nonzero: Bool = false
  mut cursor: Nat = 0
  while cursor < text.len() {
    character: Str = text[cursor]
    if character != "." && character != "-" {
      digit: Nat = character.parse_nat()
      if digit != 0 || seen_nonzero {
        seen_nonzero = true
        digits = digits.append(digit)
      } else {
      }
    } else {
    }
    cursor = cursor + 1
  }
  if digits.len() == 0 {
    [0]
  } else {
    digits
  }
}

pure decimal_fraction_digits(text: Str): Nat {
  mut result: Nat = 0
  mut after_point: Bool = false
  mut cursor: Nat = 0
  while cursor < text.len() {
    character: Str = text[cursor]
    if character == "." {
      after_point = true
    } else {
      if after_point { result = result + 1; } else {}
    }
    cursor = cursor + 1
  }
  result
}

pure encode_decimal(text: Str): Bytes {
  negative: Bool = text.len() > 0 && text[0] == "-"
  digits: [Nat] = decimal_digits(text)
  fraction_digits: Nat = decimal_fraction_digits(text)
  mut output: Bytes = encode_u8(if negative { 1 } else { 0 })
  output = output.join(encode_i16_negative(fraction_digits))
  output = output.join(encode_u16(digits.len()))
  mut cursor: Nat = 0
  while cursor < digits.len() {
    high: Nat = digits[cursor]
    low: Nat = if cursor + 1 < digits.len() { digits[cursor + 1] } else { 15 }
    output = output.push(high * 16 + low)
    cursor = cursor + 2
  }
  output
}

pure encode_decimal_parts(negative: Bool, digits: [Nat], exponent_negative: Bool, exponent_magnitude: Nat): Bytes {
  mut output: Bytes = encode_u8(if negative { 1 } else { 0 })
  if exponent_negative {
    output = output.join(encode_i16_negative(exponent_magnitude))
  } else {
    output = output.join(encode_u16(exponent_magnitude))
  }
  output = output.join(encode_u16(digits.len()))
  mut cursor: Nat = 0
  while cursor < digits.len() {
    high: Nat = digits[cursor]
    low: Nat = if cursor + 1 < digits.len() { digits[cursor + 1] } else { 15 }
    output = output.push(high * 16 + low)
    cursor = cursor + 2
  }
  output
}

pure encode_constant(constant: ConstantValue): Bytes {
  match constant {
    NatConstant(number) => encode_u8(0).join(encode_natural(number)),
    IntConstant(negative, magnitude) => {
      mut output: Bytes = encode_u8(1)
      output = output.join(encode_u8(if negative { 1 } else { 0 }))
      output.join(encode_natural(magnitude))
    },
    DecimalConstant(text) => encode_u8(2).join(encode_decimal(text)),
    DecimalPartsConstant(negative, digits, exponent_negative, exponent_magnitude) => {
      body: Bytes = encode_decimal_parts(negative, digits, exponent_negative, exponent_magnitude)
      encode_u8(2).join(body)
    },
    StringConstant(text) => encode_u8(3).join(encode_text(text)),
    BoolConstant(flag) => encode_u8(4).join(encode_u8(if flag { 1 } else { 0 })),
    VoidConstant() => encode_u8(5)
  }
}

pure unary_code(operator: Str): Nat {
  if operator == "-" { 0 } else { 1 }
}

pure binary_code(operator: Str): Nat {
  if operator == "+" { 0 }
  else { if operator == "-" { 1 }
  else { if operator == "*" { 2 }
  else { if operator == "/" { 3 }
  else { if operator == "%" { 4 }
  else { if operator == "==" { 5 }
  else { if operator == "!=" { 6 }
  else { if operator == "<" { 7 }
  else { if operator == "<=" { 8 }
  else { if operator == ">" { 9 }
  else { if operator == ">=" { 10 }
  else { if operator == "&&" { 11 } else { 12 } } } } } } } } } } } }
}

pure encode_names(values: [Str]): Bytes {
  mut output: Bytes = byte_buffer.empty()
  for value in values {
    output = output.join(encode_name(value))
  }
  output
}

pure encode_texts(values: [Str]): Bytes {
  mut output: Bytes = encode_u16(values.len())
  for value in values {
    output = output.join(encode_text(value))
  }
  output
}

pure encode_instruction(instruction: Instruction): Bytes {
  match instruction {
    ConstInstruction(value) => encode_u8(0).join(encode_constant(value)),
    LoadInstruction(name) => encode_u8(1).join(encode_name(name)),
    StoreInstruction(name) => encode_u8(2).join(encode_name(name)),
    PopInstruction() => encode_u8(3),
    UnaryInstruction(operator) => encode_u8(4).join(encode_u8(unary_code(operator))),
    BinaryInstruction(operator) => encode_u8(5).join(encode_u8(binary_code(operator))),
    MakeRangeInstruction() => encode_u8(6),
    MakeArrayInstruction(count) => encode_u8(7).join(encode_u16(count)),
    IndexGetInstruction() => encode_u8(8),
    InterpolateInstruction(parts) => encode_u8(9).join(encode_texts(parts)),
    IterInitInstruction(name) => encode_u8(10).join(encode_name(name)),
    IterNextInstruction(iterator, name, end) => {
      mut output: Bytes = encode_u8(11).join(encode_name(iterator))
      output = output.join(encode_name(name))
      output.join(encode_u32(end))
    },
    MakeRecordInstruction(name, fields) => {
      mut output: Bytes = encode_u8(12).join(encode_name(name))
      output = output.join(encode_u16(fields.len()))
      output.join(encode_names(fields))
    },
    FieldGetInstruction(name) => encode_u8(13).join(encode_name(name)),
    MakeVariantInstruction(enum_name, variant, count) => {
      mut output: Bytes = encode_u8(14).join(encode_name(enum_name))
      output = output.join(encode_name(variant))
      output.join(encode_u16(count))
    },
    MatchVariantInstruction(variant, failure) => {
      mut output: Bytes = encode_u8(15).join(encode_name(variant))
      output.join(encode_u32(failure))
    },
    MatchFailInstruction() => encode_u8(16),
    CallInstruction(name, arity) => {
      mut output: Bytes = encode_u8(17).join(encode_name(name))
      output.join(encode_u8(arity))
    },
    JumpFalseInstruction(target) => encode_u8(18).join(encode_u32(target)),
    JumpInstruction(target) => encode_u8(19).join(encode_u32(target)),
    PendingEndJumpInstruction() => byte_buffer.empty(),
    ReturnInstruction() => encode_u8(20),
    AwaitCallInstruction(name, arity) => encode_u8(22).join(encode_name(name)).join(encode_u8(arity)),
    AwaitValueInstruction(arity) => encode_u8(23).join(encode_u8(arity)),
    CallValueInstruction(arity) => encode_u8(21).join(encode_u8(arity))
  }
}

pure insert_function(functions: [FunctionCode], function: FunctionCode): [FunctionCode] {
  mut result: [FunctionCode] = []
  mut inserted: Bool = false
  for existing in functions {
    if !inserted && function.name < existing.name {
      result = result.append(function)
      inserted = true
    } else {}
    result = result.append(existing)
  }
  if !inserted { result = result.append(function); } else {}
  result
}

pub pure sort_functions(functions: [FunctionCode]): [FunctionCode] {
  mut result: [FunctionCode] = []
  for function in functions {
    result = insert_function(result, function)
  }
  result
}

pure encode_function(function: FunctionCode): Bytes {
  mut output: Bytes = encode_name(function.name)
  output = output.join(encode_u8(if function.is_async { 2 } else { if function.is_pure { 1 } else { 0 } }))
  output = output.join(encode_u8(function.parameters.len()))
  output = output.join(encode_names(function.parameters))
  output = output.join(encode_u32(function.instructions.len()))
  for instruction in function.instructions {
    output = output.join(encode_instruction(instruction))
  }
  output
}

pub pure serialize_bytecode(program: BytecodeProgram): Bytes {
  mut output: Bytes = "PANACKBC".encode_utf8()
  output = output.push(0)
  output = output.join(encode_u16(9))
  functions: [FunctionCode] = sort_functions(program.functions)
  output = output.join(encode_u16(functions.len()))
  for function in functions {
    output = output.join(encode_function(function))
  }
  output
}

pub pure compile_source_bytecode(source: Str): Bytes {
  match lex(source) {
    Ok(tokens) => {
      match parse_program_complete(tokens) {
        Ok(program) => {
          diagnostics: [Diagnostic] = check_program_frontend(program)
          if diagnostics.len() == 0 { serialize_bytecode(compile_program(program)) } else { byte_buffer.empty() }
        },
        Error(error) => byte_buffer.empty()
      }
    },
    Error(errors) => byte_buffer.empty()
  }
}
