}

pure decode_Array_Nat(reader: CacheReader): CacheRead[[Nat]] {
  count = read_count(reader)
  mut cursor: CacheReader = count.reader
  mut values: [Nat] = []
  if count.value > 1000000 || count.value > reader.data.length() { cursor = failed(cursor) }
  mut index: Nat = 0
  while cursor.valid && index < count.value {
    item = decode_Nat(cursor)
    cursor = item.reader
    values = values.append(item.value)
    index = index + 1
  }
  CacheRead(cursor, values)
}

pure encode_SignatureTypeIdentity(pool: CachePool, value: SignatureTypeIdentity): Bytes {
  match value {
    SignatureCore(v0) => encode_u32(0).join(encode_Str(pool, v0)),
    SignatureNominal(v0) => encode_u32(1).join(encode_DeclarationIdentity(pool, v0)),
    SignatureParameter(v0, v1) => encode_u32(2).join(encode_DeclarationIdentity(pool, v0)).join(encode_Nat(pool, v1)),
    SignatureCallable(v0) => encode_u32(3).join(encode_SignatureEffect(pool, v0)),
    SignatureHole(v0, v1, v2) => encode_u32(4).join(encode_DeclarationIdentity(pool, v0)).join(encode_Array_Nat(pool, v1)).join(encode_Nat(pool, v2))
  }
}

pure decode_SignatureTypeIdentity(reader: CacheReader): CacheRead[SignatureTypeIdentity] {
  tag = read_count(reader)
  if tag.reader.valid && tag.value == 0 {
    mut cursor: CacheReader = tag.reader
    v0 = decode_Str(cursor)
    cursor = v0.reader
    CacheRead(cursor, SignatureCore(v0.value))
  } else if tag.reader.valid && tag.value == 1 {
    mut cursor: CacheReader = tag.reader
    v0 = decode_DeclarationIdentity(cursor)
    cursor = v0.reader
    CacheRead(cursor, SignatureNominal(v0.value))
  } else if tag.reader.valid && tag.value == 2 {
    mut cursor: CacheReader = tag.reader
    v0 = decode_DeclarationIdentity(cursor)
    cursor = v0.reader
    v1 = decode_Nat(cursor)
    cursor = v1.reader
    CacheRead(cursor, SignatureParameter(v0.value, v1.value))
  } else if tag.reader.valid && tag.value == 3 {
    mut cursor: CacheReader = tag.reader
    v0 = decode_SignatureEffect(cursor)
    cursor = v0.reader
    CacheRead(cursor, SignatureCallable(v0.value))
  } else if tag.reader.valid && tag.value == 4 {
    mut cursor: CacheReader = tag.reader
    v0 = decode_DeclarationIdentity(cursor)
    cursor = v0.reader
    v1 = decode_Array_Nat(cursor)
    cursor = v1.reader
    v2 = decode_Nat(cursor)
    cursor = v2.reader
    CacheRead(cursor, SignatureHole(v0.value, v1.value, v2.value))
  } else { CacheRead(failed(tag.reader), SignatureCore("")) }
}

pure encode_Array_SignatureType(pool: CachePool, value: [SignatureType]): Bytes {
  mut chunks: [Bytes] = [encode_u32(value.len())]
  for item in value { chunks = chunks.append(encode_SignatureType(pool, item)) }
