pure encode_Statement(pool: CachePool, value: Statement): Bytes {
  match value {
    BindingStatement(v0, v1, v2, v3, v4) => encode_u32(0).join(encode_Str(pool, v0)).join(encode_Str(pool, v1)).join(encode_Optional_SourceSpan(pool, v2)).join(encode_Bool(pool, v3)).join(encode_Expr(pool, v4)),
    AssignmentStatement(v0, v1) => encode_u32(1).join(encode_Str(pool, v0)).join(encode_Expr(pool, v1)),
    ExpressionStatement(v0) => encode_u32(2).join(encode_Expr(pool, v0)),
    WhileStatement(v0, v1) => encode_u32(3).join(encode_Expr(pool, v0)).join(encode_Block(pool, v1)),
    ForStatement(v0, v1, v2) => encode_u32(4).join(encode_Str(pool, v0)).join(encode_Expr(pool, v1)).join(encode_Block(pool, v2))
  }
}

pure decode_Statement(reader: CacheReader): CacheRead[Statement] {
  tag = read_count(reader)
  if tag.reader.valid && tag.value == 0 {
    mut cursor: CacheReader = tag.reader
    v0 = decode_Str(cursor)
    cursor = v0.reader
    v1 = decode_Str(cursor)
    cursor = v1.reader
    v2 = decode_Optional_SourceSpan(cursor)
    cursor = v2.reader
    v3 = decode_Bool(cursor)
    cursor = v3.reader
    v4 = decode_Expr(cursor)
    cursor = v4.reader
    CacheRead(cursor, BindingStatement(v0.value, v1.value, v2.value, v3.value, v4.value))
  } else if tag.reader.valid && tag.value == 1 {
    mut cursor: CacheReader = tag.reader
    v0 = decode_Str(cursor)
    cursor = v0.reader
    v1 = decode_Expr(cursor)
    cursor = v1.reader
    CacheRead(cursor, AssignmentStatement(v0.value, v1.value))
  } else if tag.reader.valid && tag.value == 2 {
    mut cursor: CacheReader = tag.reader
    v0 = decode_Expr(cursor)
    cursor = v0.reader
    CacheRead(cursor, ExpressionStatement(v0.value))
  } else if tag.reader.valid && tag.value == 3 {
    mut cursor: CacheReader = tag.reader
    v0 = decode_Expr(cursor)
    cursor = v0.reader
    v1 = decode_Block(cursor)
    cursor = v1.reader
    CacheRead(cursor, WhileStatement(v0.value, v1.value))
  } else if tag.reader.valid && tag.value == 4 {
    mut cursor: CacheReader = tag.reader
    v0 = decode_Str(cursor)
    cursor = v0.reader
    v1 = decode_Expr(cursor)
    cursor = v1.reader
    v2 = decode_Block(cursor)
    cursor = v2.reader
    CacheRead(cursor, ForStatement(v0.value, v1.value, v2.value))
  } else { CacheRead(failed(tag.reader), BindingStatement("", "", None(), false, StringExpr("\"\""))) }
}

pure encode_Array_Statement(pool: CachePool, value: [Statement]): Bytes {
  mut chunks: [Bytes] = [encode_u32(value.len())]
  for item in value { chunks = chunks.append(encode_Statement(pool, item)) }
  source_map_join(chunks, 0, chunks.len())
}

pure decode_Array_Statement(reader: CacheReader): CacheRead[[Statement]] {
  count = read_count(reader)
  mut cursor: CacheReader = count.reader
  mut values: [Statement] = []
  if count.value > 1000000 || count.value > reader.data.length() { cursor = failed(cursor) }
  mut index: Nat = 0
  while cursor.valid && index < count.value {
    item = decode_Statement(cursor)
    cursor = item.reader
    values = values.append(item.value)
    index = index + 1
  }
  CacheRead(cursor, values)
}

pure encode_BlockValue(pool: CachePool, value: BlockValue): Bytes {
  match value {
    NoBlockValue() => encode_u32(0),
    TailBlockValue(v0) => encode_u32(1).join(encode_Expr(pool, v0))
  }
}

pure decode_BlockValue(reader: CacheReader): CacheRead[BlockValue] {
  tag = read_count(reader)
  if tag.reader.valid && tag.value == 0 {
    CacheRead(tag.reader, NoBlockValue())
  } else if tag.reader.valid && tag.value == 1 {
    mut cursor: CacheReader = tag.reader
    v0 = decode_Expr(cursor)
    cursor = v0.reader
    CacheRead(cursor, TailBlockValue(v0.value))
  } else { CacheRead(failed(tag.reader), NoBlockValue()) }
}

pure encode_Block(pool: CachePool, value: Block): Bytes {
  byte_buffer.empty().join(encode_Array_Statement(pool, value.statements)).join(encode_BlockValue(pool, value.value)).join(encode_Optional_SourceSpan(pool, value.span)).join(encode_Array_SourceSpan(pool, value.statement_spans))
}

pure decode_Block(reader: CacheReader): CacheRead[Block] {
  mut cursor: CacheReader = reader
  field_statements = decode_Array_Statement(cursor)
  cursor = field_statements.reader
  field_value = decode_BlockValue(cursor)
  cursor = field_value.reader
  field_span = decode_Optional_SourceSpan(cursor)
  cursor = field_span.reader
  field_statement_spans = decode_Array_SourceSpan(cursor)
  cursor = field_statement_spans.reader
  CacheRead(cursor, Block(field_statements.value, field_value.value, field_span.value, field_statement_spans.value))
}

pure encode_MatchPattern(pool: CachePool, value: MatchPattern): Bytes {
  byte_buffer.empty().join(encode_Str(pool, value.variant)).join(encode_Array_Str(pool, value.bindings)).join(encode_SourceSpan(pool, value.span))
}

pure decode_MatchPattern(reader: CacheReader): CacheRead[MatchPattern] {
  mut cursor: CacheReader = reader
  field_variant = decode_Str(cursor)
  cursor = field_variant.reader
  field_bindings = decode_Array_Str(cursor)
  cursor = field_bindings.reader
  field_span = decode_SourceSpan(cursor)
  cursor = field_span.reader
  CacheRead(cursor, MatchPattern(field_variant.value, field_bindings.value, field_span.value))
}

pure encode_MatchArm(pool: CachePool, value: MatchArm): Bytes {
  byte_buffer.empty().join(encode_MatchPattern(pool, value.pattern)).join(encode_Expr(pool, value.body))
}

pure decode_MatchArm(reader: CacheReader): CacheRead[MatchArm] {
  mut cursor: CacheReader = reader
  field_pattern = decode_MatchPattern(cursor)
  cursor = field_pattern.reader
  field_body = decode_Expr(cursor)
  cursor = field_body.reader
  CacheRead(cursor, MatchArm(field_pattern.value, field_body.value))
}

pure encode_Array_MatchArm(pool: CachePool, value: [MatchArm]): Bytes {
  mut chunks: [Bytes] = [encode_u32(value.len())]
  for item in value { chunks = chunks.append(encode_MatchArm(pool, item)) }
  source_map_join(chunks, 0, chunks.len())
}

pure decode_Array_MatchArm(reader: CacheReader): CacheRead[[MatchArm]] {
  count = read_count(reader)
  mut cursor: CacheReader = count.reader
  mut values: [MatchArm] = []
  if count.value > 1000000 || count.value > reader.data.length() { cursor = failed(cursor) }
  mut index: Nat = 0
  while cursor.valid && index < count.value {
    item = decode_MatchArm(cursor)
    cursor = item.reader
    values = values.append(item.value)
    index = index + 1
  }
  CacheRead(cursor, values)
}

pure encode_Expr(pool: CachePool, value: Expr): Bytes {
  match value {
    LocatedExpr(v0, v1, v2) => encode_u32(0).join(encode_SourceSpan(pool, v0)).join(encode_Expr(pool, v1)).join(encode_Array_SourceSpan(pool, v2)),
    NatExpr(v0) => encode_u32(1).join(encode_Nat(pool, v0)),
    DecimalExpr(v0) => encode_u32(2).join(encode_Str(pool, v0)),
    StringExpr(v0) => encode_u32(3).join(encode_Str(pool, v0)),
    BoolExpr(v0) => encode_u32(4).join(encode_Bool(pool, v0)),
    NameExpr(v0) => encode_u32(5).join(encode_Str(pool, v0)),
    FunctionExpr(v0) => encode_u32(6).join(encode_Str(pool, v0)),
    ArrayExpr(v0) => encode_u32(7).join(encode_Array_Expr(pool, v0)),
    UnaryExpr(v0, v1) => encode_u32(8).join(encode_Str(pool, v0)).join(encode_Expr(pool, v1)),
    BinaryExpr(v0, v1, v2) => encode_u32(9).join(encode_Str(pool, v0)).join(encode_Expr(pool, v1)).join(encode_Expr(pool, v2)),
    CallExpr(v0, v1, v2) => encode_u32(10).join(encode_Str(pool, v0)).join(encode_Array_Expr(pool, v1)).join(encode_Array_Str(pool, v2)),
    DotCallExpr(v0, v1, v2, v3) => encode_u32(11).join(encode_Expr(pool, v0)).join(encode_Str(pool, v1)).join(encode_Array_Expr(pool, v2)).join(encode_Array_Str(pool, v3)),
    OwnedCallExpr(v0, v1, v2, v3) => encode_u32(12).join(encode_Expr(pool, v0)).join(encode_Str(pool, v1)).join(encode_Array_Expr(pool, v2)).join(encode_Array_Str(pool, v3)),
    FieldExpr(v0, v1) => encode_u32(13).join(encode_Expr(pool, v0)).join(encode_Str(pool, v1)),
    IndexExpr(v0, v1) => encode_u32(14).join(encode_Expr(pool, v0)).join(encode_Expr(pool, v1)),
    IfExpr(v0, v1, v2, v3) => encode_u32(15).join(encode_Expr(pool, v0)).join(encode_Block(pool, v1)).join(encode_Block(pool, v2)).join(encode_Bool(pool, v3)),
    BlockExpr(v0) => encode_u32(16).join(encode_Block(pool, v0)),
    MatchExpr(v0, v1) => encode_u32(17).join(encode_Expr(pool, v0)).join(encode_Array_MatchArm(pool, v1))
  }
}

pure decode_Expr(reader: CacheReader): CacheRead[Expr] {
  if !reader.valid || reader.depth >= 512 {
    CacheRead(failed(reader), StringExpr("\"\""))
  } else {
    nested = decode_Expr_nested(CacheReader(reader.data, reader.offset, true, reader.depth + 1, reader.texts, reader.types, reader.expanded))
    CacheRead(CacheReader(nested.reader.data, nested.reader.offset, nested.reader.valid, reader.depth, reader.texts, reader.types, nested.reader.expanded), nested.value)
  }
}

pure decode_Expr_nested(reader: CacheReader): CacheRead[Expr] {
  tag = read_count(reader)
  if tag.reader.valid && tag.value == 0 {
    mut cursor: CacheReader = tag.reader
    v0 = decode_SourceSpan(cursor)
    cursor = v0.reader
    v1 = decode_Expr(cursor)
    cursor = v1.reader
    v2 = decode_Array_SourceSpan(cursor)
    cursor = v2.reader
    CacheRead(cursor, LocatedExpr(v0.value, v1.value, v2.value))
  } else if tag.reader.valid && tag.value == 1 {
    mut cursor: CacheReader = tag.reader
    v0 = decode_Nat(cursor)
    cursor = v0.reader
    CacheRead(cursor, NatExpr(v0.value))
  } else if tag.reader.valid && tag.value == 2 {
    mut cursor: CacheReader = tag.reader
    v0 = decode_Str(cursor)
    cursor = v0.reader
    CacheRead(cursor, DecimalExpr(v0.value))
  } else if tag.reader.valid && tag.value == 3 {
    mut cursor: CacheReader = tag.reader
    v0 = decode_Str(cursor)
    cursor = v0.reader
    CacheRead(cursor, StringExpr(v0.value))
  } else if tag.reader.valid && tag.value == 4 {
    mut cursor: CacheReader = tag.reader
    v0 = decode_Bool(cursor)
    cursor = v0.reader
    CacheRead(cursor, BoolExpr(v0.value))
  } else if tag.reader.valid && tag.value == 5 {
    mut cursor: CacheReader = tag.reader
    v0 = decode_Str(cursor)
