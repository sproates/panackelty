pure collect_DeclarationSyntax(pool: CachePool, value: DeclarationSyntax): CachePool {
  mut result: CachePool = pool
  result = collect_SourceSpan(result, value.span)
  result = collect_Array_SourceSpan(result, value.type_spans)
  result = collect_Bool(result, value.is_public)
  result = collect_ImportBindingSyntax(result, value.binding)
  result = collect_Optional_OwnedMethodSyntax(result, value.method)
