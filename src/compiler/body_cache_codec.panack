pure encode_ImportBindingSyntax(pool: CachePool, value: ImportBindingSyntax): Bytes {
  match value {
    NoImportBinding() => encode_u32(0),
    NamespaceImportBinding(v0, v1) => encode_u32(1).join(encode_Str(pool, v0)).join(encode_Bool(pool, v1)),
    SelectiveImportBinding(v0) => encode_u32(2).join(encode_Array_ImportSelector(pool, v0))
  }
}

pure decode_ImportBindingSyntax(reader: CacheReader): CacheRead[ImportBindingSyntax] {
  tag = read_count(reader)
  if tag.reader.valid && tag.value == 0 {
    CacheRead(tag.reader, NoImportBinding())
  } else if tag.reader.valid && tag.value == 1 {
    mut cursor: CacheReader = tag.reader
    v0 = decode_Str(cursor)
    cursor = v0.reader
    v1 = decode_Bool(cursor)
    cursor = v1.reader
    CacheRead(cursor, NamespaceImportBinding(v0.value, v1.value))
  } else if tag.reader.valid && tag.value == 2 {
    mut cursor: CacheReader = tag.reader
    v0 = decode_Array_ImportSelector(cursor)
    cursor = v0.reader
    CacheRead(cursor, SelectiveImportBinding(v0.value))
  } else { CacheRead(failed(tag.reader), NoImportBinding()) }
}

pure encode_OwnedMethodSyntax(pool: CachePool, value: OwnedMethodSyntax): Bytes {
