    cursor = v1.reader
    CacheRead(cursor, BodyCall(v0.value, v1.value, []))
    } else {
      CacheRead(tag.reader, BodyArray())
    }
    } else {
      if tag.value < 7 {
      mut cursor: CacheReader = tag.reader
    v0 = decode_Str(cursor)
    cursor = v0.reader
    CacheRead(cursor, BodyUnary(v0.value))
    } else {
      if tag.value < 8 {
      mut cursor: CacheReader = tag.reader
    v0 = decode_Str(cursor)
    cursor = v0.reader
