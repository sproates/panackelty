  for item in value { result = collect_SignatureType(result, item) }
  result
}

pure collect_Optional_SignatureEffect(pool: CachePool, value: Option[SignatureEffect]): CachePool {
  match value { None() => pool, Some(item) => collect_SignatureEffect(pool, item) }
}

pure collect_Array_BodyLocal(pool: CachePool, value: [BodyLocal]): CachePool {
  mut result: CachePool = pool
  for item in value { result = collect_BodyLocal(result, item) }
  result
}

pure collect_BodyLocal(pool: CachePool, value: BodyLocal): CachePool {
  mut result: CachePool = pool
  result = collect_BodyLocalIdentity(result, value.identity)
  result = collect_Optional_SignatureType(result, value.type)
  result = collect_Bool(result, value.mutable)
  result
}

pure collect_BodyLocalIdentity(pool: CachePool, value: BodyLocalIdentity): CachePool {
  mut result: CachePool = pool
  result = collect_DeclarationIdentity(result, value.owner)
  result = collect_Array_Nat(result, value.path)
  result = collect_Str(result, value.name)
  result
}

pure collect_Optional_SignatureType(pool: CachePool, value: Option[SignatureType]): CachePool {
  match value { None() => pool, Some(item) => collect_SignatureType(pool, item) }
}

pure collect_BoundBody(pool: CachePool, value: BoundBody): CachePool {
  mut result: CachePool = pool
  result = collect_BodyNode(result, value.node)
  result = collect_SourceSpan(result, value.span)
  result = collect_Array_BoundBody(result, value.children)
  result = collect_Optional_SignatureType(result, value.type)
  result
}

pure collect_BodyNode(pool: CachePool, value: BodyNode): CachePool {
  match value {
    BodyLiteral(v0) => {
      mut result: CachePool = pool
      result = collect_Expr(result, v0)
      result
    },
    BodyInterpolation(v0) => {
      mut result: CachePool = pool
      result = collect_Array_Str(result, v0)
      result
    },
    BodyLocalUse(v0, v1) => {
      mut result: CachePool = pool
      result = collect_BodyLocalIdentity(result, v0)
      result
    },
    BodyFunction(v0) => {
      mut result: CachePool = pool
      result = collect_ModuleDeclarationBinding(result, v0)
      result
    },
    BodyCall(v0, v1, v2) => {
      mut result: CachePool = pool
      result = collect_BodyTarget(result, v0)
      result = collect_Array_SignatureType(result, v1)
      result
    },
    BodyArray() => pool,
    BodyUnary(v0) => {
      mut result: CachePool = pool
      result = collect_Str(result, v0)
      result
    },
    BodyBinary(v0) => {
      mut result: CachePool = pool
      result = collect_Str(result, v0)
      result
    },
    BodyField(v0) => {
      mut result: CachePool = pool
      result = collect_Str(result, v0)
      result
    },
    BodyIndex() => pool,
    BodyIf(v0) => {
      mut result: CachePool = pool
      result = collect_Bool(result, v0)
      result
    },
    BodyBlock(v0, v1, v2) => {
      mut result: CachePool = pool
      result = collect_Bool(result, v0)
      result = collect_Optional_SourceSpan(result, v1)
      result = collect_Array_SourceSpan(result, v2)
      result
    },
    BodyMatch(v0, v1, v2) => {
      mut result: CachePool = pool
      result = collect_Array_BodyTarget(result, v0)
      result = collect_Array_Array_BodyLocalIdentity(result, v1)
      result = collect_Array_SourceSpan(result, v2)
      result
    },
    BodyBinding(v0, v1, v2, v3, v4) => {
      mut result: CachePool = pool
      result = collect_BodyLocalIdentity(result, v0)
      result = collect_Optional_SignatureType(result, v1)
      result = collect_Bool(result, v2)
      result
    },
    BodyAssignment(v0, v1) => {
      mut result: CachePool = pool
      result = collect_BodyLocalIdentity(result, v0)
      result
    },
    BodyWhile() => pool,
    BodyFor(v0) => {
      mut result: CachePool = pool
      result = collect_BodyLocalIdentity(result, v0)
      result
    },
    BodyEmpty() => pool
  }
}

pure collect_Expr(pool: CachePool, value: Expr): CachePool {
  match value {
    LocatedExpr(v0, v1, v2) => {
      mut result: CachePool = pool
      result = collect_SourceSpan(result, v0)
      result = collect_Expr(result, v1)
      result = collect_Array_SourceSpan(result, v2)
      result
    },
    NatExpr(v0) => {
      mut result: CachePool = pool
      result = collect_Nat(result, v0)
      result
    },
    DecimalExpr(v0) => {
      mut result: CachePool = pool
      result = collect_Str(result, v0)
      result
    },
    StringExpr(v0) => {
      mut result: CachePool = pool
      result = collect_Str(result, v0)
      result
    },
    BoolExpr(v0) => {
      mut result: CachePool = pool
      result = collect_Bool(result, v0)
      result
    },
    NameExpr(v0) => {
      mut result: CachePool = pool
      result = collect_Str(result, v0)
      result
    },
    FunctionExpr(v0) => {
      mut result: CachePool = pool
      result = collect_Str(result, v0)
      result
    },
    ArrayExpr(v0) => {
      mut result: CachePool = pool
      result = collect_Array_Expr(result, v0)
      result
    },
    UnaryExpr(v0, v1) => {
      mut result: CachePool = pool
      result = collect_Str(result, v0)
      result = collect_Expr(result, v1)
      result
    },
    BinaryExpr(v0, v1, v2) => {
      mut result: CachePool = pool
      result = collect_Str(result, v0)
      result = collect_Expr(result, v1)
      result = collect_Expr(result, v2)
      result
    },
    CallExpr(v0, v1, v2) => {
      mut result: CachePool = pool
      result = collect_Str(result, v0)
      result = collect_Array_Expr(result, v1)
      result = collect_Array_Str(result, v2)
      result
    },
    DotCallExpr(v0, v1, v2, v3) => {
      mut result: CachePool = pool
      result = collect_Expr(result, v0)
      result = collect_Str(result, v1)
      result = collect_Array_Expr(result, v2)
      result = collect_Array_Str(result, v3)
      result
    },
    OwnedCallExpr(v0, v1, v2, v3) => {
      mut result: CachePool = pool
      result = collect_Expr(result, v0)
      result = collect_Str(result, v1)
      result = collect_Array_Expr(result, v2)
      result = collect_Array_Str(result, v3)
      result
    },
    FieldExpr(v0, v1) => {
      mut result: CachePool = pool
      result = collect_Expr(result, v0)
      result = collect_Str(result, v1)
      result
    },
    IndexExpr(v0, v1) => {
      mut result: CachePool = pool
      result = collect_Expr(result, v0)
      result = collect_Expr(result, v1)
      result
    },
    IfExpr(v0, v1, v2, v3) => {
      mut result: CachePool = pool
      result = collect_Expr(result, v0)
      result = collect_Block(result, v1)
      result = collect_Block(result, v2)
      result = collect_Bool(result, v3)
      result
    },
    BlockExpr(v0) => {
      mut result: CachePool = pool
      result = collect_Block(result, v0)
      result
    },
    MatchExpr(v0, v1) => {
      mut result: CachePool = pool
      result = collect_Expr(result, v0)
      result = collect_Array_MatchArm(result, v1)
      result
    }
  }
}

