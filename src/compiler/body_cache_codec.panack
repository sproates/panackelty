pure encode_ModuleSummary(pool: CachePool, value: ModuleSummary): Bytes {
  byte_buffer.empty().join(encode_ParsedModule(pool, value.declarations)).join(encode_Bool(pool, value.uses_validation)).join(encode_Array_Diagnostic(pool, value.execution_diagnostics))
}

pure decode_ModuleSummary(reader: CacheReader): CacheRead[ModuleSummary] {
  mut cursor: CacheReader = reader
  field_declarations = decode_ParsedModule(cursor)
  cursor = field_declarations.reader
  field_uses_validation = decode_Bool(cursor)
  cursor = field_uses_validation.reader
  field_execution_diagnostics = decode_Array_Diagnostic(cursor)
  cursor = field_execution_diagnostics.reader
  CacheRead(cursor, ModuleSummary(field_declarations.value, field_uses_validation.value, field_execution_diagnostics.value))
}

record CachePool { text_indices: Map[Str,Nat], texts: [Str], type_indices: Map[SignatureType,Nat], types: [SignatureType] }
pure collect_Str(pool: CachePool, value: Str): CachePool {
  if pool.text_indices.has(value) { pool }
  else { CachePool(pool.text_indices.put(value, pool.texts.len()), pool.texts.append(value), pool.type_indices, pool.types) }
}
pure collect_Nat(pool: CachePool, value: Nat): CachePool { pool }
pure collect_Bool(pool: CachePool, value: Bool): CachePool { pool }

pure collect_Array_BoundFunctionBody(pool: CachePool, value: [BoundFunctionBody]): CachePool {
  mut result: CachePool = pool
  for item in value { result = collect_BoundFunctionBody(result, item) }
  result
}

pure collect_BoundFunctionBody(pool: CachePool, value: BoundFunctionBody): CachePool {
  mut result: CachePool = pool
  result = collect_ModuleSignature(result, value.signature)
  result = collect_Array_BodyLocal(result, value.parameters)
  result = collect_BoundBody(result, value.body)
  result
}

pure collect_ModuleSignature(pool: CachePool, value: ModuleSignature): CachePool {
  mut result: CachePool = pool
  result = collect_ModuleDeclarationBinding(result, value.binding)
  result = collect_Array_Str(result, value.parameters)
  result = collect_Array_SignatureSlot(result, value.slots)
  result = collect_Optional_SignatureEffect(result, value.effect)
  result
}

pure collect_ModuleDeclarationBinding(pool: CachePool, value: ModuleDeclarationBinding): CachePool {
  mut result: CachePool = pool
  result = collect_DeclarationIdentity(result, value.identity)
  result = collect_ModuleDeclarationKind(result, value.kind)
  result = collect_Bool(result, value.is_public)
  result = collect_SourceSpan(result, value.span)
  result = collect_Optional_OwnedMethodIdentity(result, value.method)
  result = collect_Optional_OwnedIntrinsic(result, value.intrinsic)
  result
}

pure collect_DeclarationIdentity(pool: CachePool, value: DeclarationIdentity): CachePool {
  mut result: CachePool = pool
  result = collect_ModuleIdentity(result, value.module)
  result = collect_Str(result, value.name)
  result
}

pure collect_ModuleIdentity(pool: CachePool, value: ModuleIdentity): CachePool {
  mut result: CachePool = pool
  result = collect_ModulePackageIdentity(result, value.package)
  result = collect_Str(result, value.path)
  result
}

pure collect_ModulePackageIdentity(pool: CachePool, value: ModulePackageIdentity): CachePool {
  match value {
    StandaloneModulePackage() => pool,
    ManifestModulePackage(v0, v1) => {
      mut result: CachePool = pool
      result = collect_Str(result, v0)
      result = collect_Str(result, v1)
      result
    },
    ToolchainModulePackage() => pool
  }
}

pure collect_ModuleDeclarationKind(pool: CachePool, value: ModuleDeclarationKind): CachePool {
  match value {
    ModuleFunction() => pool,
    ModuleGuardedType() => pool,
    ModuleRecord() => pool,
    ModuleEnum() => pool,
    ModuleVariant(v0) => {
      mut result: CachePool = pool
      result = collect_Str(result, v0)
      result
    }
  }
}

pure collect_SourceSpan(pool: CachePool, value: SourceSpan): CachePool {
  mut result: CachePool = pool
  result = collect_SourcePos(result, value.start)
  result = collect_SourcePos(result, value.end)
  result
}

pure collect_SourcePos(pool: CachePool, value: SourcePos): CachePool {
  mut result: CachePool = pool
  result = collect_Str(result, value.file)
  result = collect_Nat(result, value.offset)
  result = collect_Nat(result, value.line)
  result = collect_Nat(result, value.column)
  result
}

pure collect_Optional_OwnedMethodIdentity(pool: CachePool, value: Option[OwnedMethodIdentity]): CachePool {
  match value { None() => pool, Some(item) => collect_OwnedMethodIdentity(pool, item) }
}

pure collect_OwnedMethodIdentity(pool: CachePool, value: OwnedMethodIdentity): CachePool {
  mut result: CachePool = pool
  result = collect_MethodOwnerIdentity(result, value.owner)
  result = collect_Str(result, value.name)
  result
}

pure collect_MethodOwnerIdentity(pool: CachePool, value: MethodOwnerIdentity): CachePool {
  match value {
    NominalMethodOwner(v0) => {
      mut result: CachePool = pool
      result = collect_DeclarationIdentity(result, v0)
      result
    },
    BuiltinMethodOwner(v0) => {
      mut result: CachePool = pool
      result = collect_Str(result, v0)
      result
    }
  }
}

pure collect_Optional_OwnedIntrinsic(pool: CachePool, value: Option[OwnedIntrinsic]): CachePool {
  match value { None() => pool, Some(item) => collect_OwnedIntrinsic(pool, item) }
}

pure collect_OwnedIntrinsic(pool: CachePool, value: OwnedIntrinsic): CachePool {
  match value {
    ArrayMap() => pool,
    ArrayReduce() => pool,
    PureCallableCall() => pool,
    OrdinaryCallableCall() => pool,
    AsyncCallableCall() => pool,
    MapPut() => pool,
    MapGet() => pool,
    MapHas() => pool,
    SetAdd() => pool,
    SetHas() => pool,
    ArrayAppend() => pool,
    ArrayConcat() => pool,
    MapLength() => pool,
    SetLength() => pool,
    ArrayLength() => pool,
    StringLength() => pool,
    StringSlice() => pool,
    StringReverse() => pool,
    StringStartsWith() => pool,
    StringStartsWithAt() => pool,
    StringIsDigit() => pool,
    StringIsLetter() => pool,
    StringIsWhitespace() => pool,
    StringParseNat() => pool,
    StringEncodeUtf8() => pool,
    BytesPush() => pool,
    BytesAt() => pool,
    BytesLength() => pool,
    BytesJoin() => pool,
    BytesDecodeUtf8() => pool,
    NaturalDivide() => pool,
    RationalNat() => pool,
    RationalDec() => pool,
    DurationTicks() => pool,
    InstantAdd() => pool,
    InstantDifference() => pool,
    InstantBefore() => pool
  }
}

pure collect_Array_Str(pool: CachePool, value: [Str]): CachePool {
  mut result: CachePool = pool
  for item in value { result = collect_Str(result, item) }
  result
}

pure collect_Array_SignatureSlot(pool: CachePool, value: [SignatureSlot]): CachePool {
  mut result: CachePool = pool
  for item in value { result = collect_SignatureSlot(result, item) }
  result
}

pure collect_SignatureSlot(pool: CachePool, value: SignatureSlot): CachePool {
  mut result: CachePool = pool
  result = collect_Str(result, value.name)
  result = collect_SignatureType(result, value.type)
  result
}

pure collect_SignatureType(pool: CachePool, value: SignatureType): CachePool {
  if pool.type_indices.has(value) { pool } else {
    collected = collect_SignatureTypeIdentity(pool, value.identity)
    result = collect_Array_SignatureType(collected, value.arguments)
    CachePool(result.text_indices, result.texts, result.type_indices.put(value, result.types.len()), result.types.append(value))
  }
}

pure collect_SignatureTypeIdentity(pool: CachePool, value: SignatureTypeIdentity): CachePool {
  match value {
    SignatureCore(v0) => {
      mut result: CachePool = pool
      result = collect_Str(result, v0)
      result
    },
    SignatureNominal(v0) => {
      mut result: CachePool = pool
      result = collect_DeclarationIdentity(result, v0)
      result
    },
    SignatureParameter(v0, v1) => {
      mut result: CachePool = pool
      result = collect_DeclarationIdentity(result, v0)
      result = collect_Nat(result, v1)
      result
    },
    SignatureCallable(v0) => {
      mut result: CachePool = pool
      result = collect_SignatureEffect(result, v0)
      result
    },
    SignatureHole(v0, v1, v2) => {
      mut result: CachePool = pool
      result = collect_DeclarationIdentity(result, v0)
      result = collect_Array_Nat(result, v1)
      result = collect_Nat(result, v2)
      result
    }
  }
}

pure collect_SignatureEffect(pool: CachePool, value: SignatureEffect): CachePool {
  match value {
    SignaturePure() => pool,
    SignatureOrdinary() => pool,
    SignatureAsync() => pool
  }
}

pure collect_Array_Nat(pool: CachePool, value: [Nat]): CachePool {
  mut result: CachePool = pool
  for item in value { result = collect_Nat(result, item) }
  result
}

pure collect_Array_SignatureType(pool: CachePool, value: [SignatureType]): CachePool {
