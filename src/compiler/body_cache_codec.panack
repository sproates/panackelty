  }
}

pure decode_Optional_SourceSpan(reader: CacheReader): CacheRead[Option[SourceSpan]] {
  tag = read_count(reader)
  if tag.reader.valid && tag.value == 1 {
    item = decode_SourceSpan(tag.reader)
    CacheRead(item.reader, Some(item.value))
  } else {
    CacheRead(if tag.value == 0 { tag.reader } else { failed(tag.reader) }, None())
  }
