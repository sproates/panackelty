  CacheRead(cursor, OwnedMethodSyntax(field_owner.value, field_parameters.value, field_name.value))
}

pure encode_Optional_OwnedMethodSyntax(pool: CachePool, value: Option[OwnedMethodSyntax]): Bytes {
  match value {
    None() => encode_u32(0),
    Some(item) => encode_u32(1).join(encode_OwnedMethodSyntax(pool, item))
  }
}

pure decode_Optional_OwnedMethodSyntax(reader: CacheReader): CacheRead[Option[OwnedMethodSyntax]] {
  tag = read_count(reader)
  if tag.reader.valid && tag.value == 1 {
    item = decode_OwnedMethodSyntax(tag.reader)
    CacheRead(item.reader, Some(item.value))
  } else {
    CacheRead(if tag.value == 0 { tag.reader } else { failed(tag.reader) }, None())
  }
}

pure encode_DeclarationSyntax(pool: CachePool, value: DeclarationSyntax): Bytes {
