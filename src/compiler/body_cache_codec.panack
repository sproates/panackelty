pure encode_TopLevel(pool: CachePool, value: TopLevel): Bytes {
  match value {
    ImportDeclaration(v0) => encode_u32(0).join(encode_Str(pool, v0)),
    TypeDeclaration(v0, v1, v2, v3) => encode_u32(1).join(encode_Str(pool, v0)).join(encode_Str(pool, v1)).join(encode_Str(pool, v2)).join(encode_Expr(pool, v3)),
    RecordDeclaration(v0, v1, v2) => encode_u32(2).join(encode_Str(pool, v0)).join(encode_Array_Str(pool, v1)).join(encode_Array_RecordField(pool, v2)),
    EnumDeclaration(v0, v1, v2) => encode_u32(3).join(encode_Str(pool, v0)).join(encode_Array_Str(pool, v1)).join(encode_Array_EnumVariant(pool, v2)),
    FunctionDeclaration(v0, v1, v2, v3, v4, v5, v6) => encode_u32(4).join(encode_Str(pool, v0)).join(encode_Array_FunctionParameter(pool, v1)).join(encode_Str(pool, v2)).join(encode_Bool(pool, v3)).join(encode_Bool(pool, v4)).join(encode_Block(pool, v5)).join(encode_Array_Str(pool, v6))
  }
}

pure decode_TopLevel(reader: CacheReader): CacheRead[TopLevel] {
  tag = read_count(reader)
  if tag.reader.valid && tag.value == 0 {
    mut cursor: CacheReader = tag.reader
    v0 = decode_Str(cursor)
    cursor = v0.reader
    CacheRead(cursor, ImportDeclaration(v0.value))
  } else if tag.reader.valid && tag.value == 1 {
    mut cursor: CacheReader = tag.reader
    v0 = decode_Str(cursor)
    cursor = v0.reader
    v1 = decode_Str(cursor)
    cursor = v1.reader
    v2 = decode_Str(cursor)
    cursor = v2.reader
    v3 = decode_Expr(cursor)
    cursor = v3.reader
    CacheRead(cursor, TypeDeclaration(v0.value, v1.value, v2.value, v3.value))
  } else if tag.reader.valid && tag.value == 2 {
    mut cursor: CacheReader = tag.reader
    v0 = decode_Str(cursor)
    cursor = v0.reader
    v1 = decode_Array_Str(cursor)
    cursor = v1.reader
    v2 = decode_Array_RecordField(cursor)
    cursor = v2.reader
    CacheRead(cursor, RecordDeclaration(v0.value, v1.value, v2.value))
  } else if tag.reader.valid && tag.value == 3 {
    mut cursor: CacheReader = tag.reader
    v0 = decode_Str(cursor)
    cursor = v0.reader
    v1 = decode_Array_Str(cursor)
    cursor = v1.reader
    v2 = decode_Array_EnumVariant(cursor)
    cursor = v2.reader
    CacheRead(cursor, EnumDeclaration(v0.value, v1.value, v2.value))
  } else if tag.reader.valid && tag.value == 4 {
    mut cursor: CacheReader = tag.reader
    v0 = decode_Str(cursor)
    cursor = v0.reader
    v1 = decode_Array_FunctionParameter(cursor)
    cursor = v1.reader
    v2 = decode_Str(cursor)
    cursor = v2.reader
    v3 = decode_Bool(cursor)
    cursor = v3.reader
    v4 = decode_Bool(cursor)
    cursor = v4.reader
    v5 = decode_Block(cursor)
    cursor = v5.reader
    v6 = decode_Array_Str(cursor)
    cursor = v6.reader
    CacheRead(cursor, FunctionDeclaration(v0.value, v1.value, v2.value, v3.value, v4.value, v5.value, v6.value))
  } else { CacheRead(failed(tag.reader), ImportDeclaration("")) }
}

pure encode_Array_TopLevel(pool: CachePool, value: [TopLevel]): Bytes {
  mut chunks: [Bytes] = [encode_u32(value.len())]
  for item in value { chunks = chunks.append(encode_TopLevel(pool, item)) }
  source_map_join(chunks, 0, chunks.len())
}

pure decode_Array_TopLevel(reader: CacheReader): CacheRead[[TopLevel]] {
  count = read_count(reader)
  mut cursor: CacheReader = count.reader
  mut values: [TopLevel] = []
  if count.value > 1000000 || count.value > reader.data.length() { cursor = failed(cursor) }
  mut index: Nat = 0
  while cursor.valid && index < count.value {
    item = decode_TopLevel(cursor)
    cursor = item.reader
    values = values.append(item.value)
    index = index + 1
  }
  CacheRead(cursor, values)
}

pure encode_Program(pool: CachePool, value: Program): Bytes {
  byte_buffer.empty().join(encode_Array_TopLevel(pool, value.declarations))
}

pure decode_Program(reader: CacheReader): CacheRead[Program] {
  mut cursor: CacheReader = reader
  field_declarations = decode_Array_TopLevel(cursor)
  cursor = field_declarations.reader
  CacheRead(cursor, indexed_program(field_declarations.value))
}

