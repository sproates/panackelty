pure encode_BodyNode(pool: CachePool, value: BodyNode): Bytes {
  match value {
    BodyLiteral(v0) => encode_u32(0).join(encode_Expr(pool, v0)),
    BodyInterpolation(v0) => encode_u32(1).join(encode_Array_Str(pool, v0)),
    BodyLocalUse(v0, v1) => encode_u32(2).join(encode_BodyLocalIdentity(pool, v0)),
    BodyFunction(v0) => encode_u32(3).join(encode_ModuleDeclarationBinding(pool, v0)),
    BodyCall(v0, v1, v2) => encode_u32(4).join(encode_BodyTarget(pool, v0)).join(encode_Array_SignatureType(pool, v1)),
    BodyArray() => encode_u32(5),
    BodyUnary(v0) => encode_u32(6).join(encode_Str(pool, v0)),
    BodyBinary(v0) => encode_u32(7).join(encode_Str(pool, v0)),
    BodyField(v0) => encode_u32(8).join(encode_Str(pool, v0)),
    BodyIndex() => encode_u32(9),
    BodyIf(v0) => encode_u32(10).join(encode_Bool(pool, v0)),
    BodyBlock(v0, v1, v2) => encode_u32(11).join(encode_Bool(pool, v0)).join(encode_Optional_SourceSpan(pool, v1)).join(encode_Array_SourceSpan(pool, v2)),
    BodyMatch(v0, v1, v2) => encode_u32(12).join(encode_Array_BodyTarget(pool, v0)).join(encode_Array_Array_BodyLocalIdentity(pool, v1)).join(encode_Array_SourceSpan(pool, v2)),
    BodyBinding(v0, v1, v2, v3, v4) => encode_u32(13).join(encode_BodyLocalIdentity(pool, v0)).join(encode_Optional_SignatureType(pool, v1)).join(encode_Bool(pool, v2)),
    BodyAssignment(v0, v1) => encode_u32(14).join(encode_BodyLocalIdentity(pool, v0)),
    BodyWhile() => encode_u32(15),
    BodyFor(v0) => encode_u32(16).join(encode_BodyLocalIdentity(pool, v0)),
    BodyEmpty() => encode_u32(17)
  }
}

