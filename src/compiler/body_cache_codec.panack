}

pure decode_Array_BoundFunctionBody(reader: CacheReader): CacheRead[[BoundFunctionBody]] {
  count = read_count(reader)
  mut cursor: CacheReader = count.reader
  mut values: [BoundFunctionBody] = []
  if count.value > 1000000 || count.value > reader.data.length() { cursor = failed(cursor) }
  mut index: Nat = 0
  while cursor.valid && index < count.value {
    item = decode_BoundFunctionBody(cursor)
    cursor = item.reader
    values = values.append(item.value)
    index = index + 1
  }
  CacheRead(cursor, values)
}

record TextPool { indices: Map[Str,Nat], texts: [Str] }
pure collect_Str(pool: TextPool, value: Str): TextPool {
  if pool.indices.has(value) { pool }
  else { TextPool(pool.indices.put(value, pool.texts.len()), pool.texts.append(value)) }
}
pure collect_Nat(pool: TextPool, value: Nat): TextPool { pool }
pure collect_Bool(pool: TextPool, value: Bool): TextPool { pool }

pure collect_Array_BoundFunctionBody(pool: TextPool, value: [BoundFunctionBody]): TextPool {
  mut result: TextPool = pool
  for item in value { result = collect_BoundFunctionBody(result, item) }
  result
}

pure collect_BoundFunctionBody(pool: TextPool, value: BoundFunctionBody): TextPool {
  mut result: TextPool = pool
  result = collect_ModuleSignature(result, value.signature)
  result = collect_Array_BodyLocal(result, value.parameters)
  result = collect_BoundBody(result, value.body)
  result
}

pure collect_ModuleSignature(pool: TextPool, value: ModuleSignature): TextPool {
  mut result: TextPool = pool
  result = collect_ModuleDeclarationBinding(result, value.binding)
  result = collect_Array_Str(result, value.parameters)
  result = collect_Array_SignatureSlot(result, value.slots)
  result = collect_Optional_SignatureEffect(result, value.effect)
  result
}

pure collect_ModuleDeclarationBinding(pool: TextPool, value: ModuleDeclarationBinding): TextPool {
  mut result: TextPool = pool
  result = collect_DeclarationIdentity(result, value.identity)
  result = collect_ModuleDeclarationKind(result, value.kind)
  result = collect_Bool(result, value.is_public)
  result = collect_SourceSpan(result, value.span)
  result = collect_Optional_OwnedMethodIdentity(result, value.method)
  result = collect_Optional_OwnedIntrinsic(result, value.intrinsic)
  result
}

pure collect_DeclarationIdentity(pool: TextPool, value: DeclarationIdentity): TextPool {
  mut result: TextPool = pool
  result = collect_ModuleIdentity(result, value.module)
  result = collect_Str(result, value.name)
  result
}

pure collect_ModuleIdentity(pool: TextPool, value: ModuleIdentity): TextPool {
  mut result: TextPool = pool
  result = collect_ModulePackageIdentity(result, value.package)
  result = collect_Str(result, value.path)
  result
}

pure collect_ModulePackageIdentity(pool: TextPool, value: ModulePackageIdentity): TextPool {
  match value {
    StandaloneModulePackage() => pool,
    ManifestModulePackage(v0, v1) => {
      mut result: TextPool = pool
      result = collect_Str(result, v0)
      result = collect_Str(result, v1)
      result
    },
    ToolchainModulePackage() => pool
  }
}

pure collect_ModuleDeclarationKind(pool: TextPool, value: ModuleDeclarationKind): TextPool {
  match value {
    ModuleFunction() => pool,
    ModuleGuardedType() => pool,
    ModuleRecord() => pool,
    ModuleEnum() => pool,
    ModuleVariant(v0) => {
      mut result: TextPool = pool
      result = collect_Str(result, v0)
      result
    }
  }
}

pure collect_SourceSpan(pool: TextPool, value: SourceSpan): TextPool {
  mut result: TextPool = pool
  result = collect_SourcePos(result, value.start)
  result = collect_SourcePos(result, value.end)
  result
}

pure collect_SourcePos(pool: TextPool, value: SourcePos): TextPool {
  mut result: TextPool = pool
  result = collect_Str(result, value.file)
  result = collect_Nat(result, value.offset)
  result = collect_Nat(result, value.line)
  result = collect_Nat(result, value.column)
  result
}

pure collect_Optional_OwnedMethodIdentity(pool: TextPool, value: Option[OwnedMethodIdentity]): TextPool {
  match value { None() => pool, Some(item) => collect_OwnedMethodIdentity(pool, item) }
}

pure collect_OwnedMethodIdentity(pool: TextPool, value: OwnedMethodIdentity): TextPool {
  mut result: TextPool = pool
  result = collect_MethodOwnerIdentity(result, value.owner)
  result = collect_Str(result, value.name)
  result
}

pure collect_MethodOwnerIdentity(pool: TextPool, value: MethodOwnerIdentity): TextPool {
  match value {
    NominalMethodOwner(v0) => {
      mut result: TextPool = pool
      result = collect_DeclarationIdentity(result, v0)
      result
    },
    BuiltinMethodOwner(v0) => {
      mut result: TextPool = pool
      result = collect_Str(result, v0)
      result
    }
  }
}

pure collect_Optional_OwnedIntrinsic(pool: TextPool, value: Option[OwnedIntrinsic]): TextPool {
  match value { None() => pool, Some(item) => collect_OwnedIntrinsic(pool, item) }
}

pure collect_OwnedIntrinsic(pool: TextPool, value: OwnedIntrinsic): TextPool {
  match value {
    ArrayMap() => pool,
    ArrayReduce() => pool,
    PureCallableCall() => pool,
    OrdinaryCallableCall() => pool,
    AsyncCallableCall() => pool,
    MapPut() => pool,
    MapGet() => pool,
    MapHas() => pool,
    SetAdd() => pool,
    SetHas() => pool,
    ArrayAppend() => pool,
    ArrayConcat() => pool,
    MapLength() => pool,
    SetLength() => pool,
    ArrayLength() => pool,
    StringLength() => pool,
    StringSlice() => pool,
    StringReverse() => pool,
    StringStartsWith() => pool,
    StringStartsWithAt() => pool,
    StringIsDigit() => pool,
    StringIsLetter() => pool,
    StringIsWhitespace() => pool,
    StringParseNat() => pool,
    StringEncodeUtf8() => pool,
    BytesPush() => pool,
    BytesAt() => pool,
    BytesLength() => pool,
    BytesJoin() => pool,
    BytesDecodeUtf8() => pool,
    NaturalDivide() => pool,
    RationalNat() => pool,
    RationalDec() => pool,
    DurationTicks() => pool,
    InstantAdd() => pool,
    InstantDifference() => pool,
    InstantBefore() => pool
  }
}

pure collect_Array_Str(pool: TextPool, value: [Str]): TextPool {
  mut result: TextPool = pool
  for item in value { result = collect_Str(result, item) }
  result
}

pure collect_Array_SignatureSlot(pool: TextPool, value: [SignatureSlot]): TextPool {
  mut result: TextPool = pool
  for item in value { result = collect_SignatureSlot(result, item) }
  result
}

pure collect_SignatureSlot(pool: TextPool, value: SignatureSlot): TextPool {
  mut result: TextPool = pool
  result = collect_Str(result, value.name)
  result = collect_SignatureType(result, value.type)
  result
}

pure collect_SignatureType(pool: TextPool, value: SignatureType): TextPool {
  mut result: TextPool = pool
  result = collect_SignatureTypeIdentity(result, value.identity)
  result = collect_Array_SignatureType(result, value.arguments)
  result
}

pure collect_SignatureTypeIdentity(pool: TextPool, value: SignatureTypeIdentity): TextPool {
  match value {
    SignatureCore(v0) => {
      mut result: TextPool = pool
      result = collect_Str(result, v0)
      result
    },
    SignatureNominal(v0) => {
      mut result: TextPool = pool
      result = collect_DeclarationIdentity(result, v0)
      result
    },
    SignatureParameter(v0, v1) => {
      mut result: TextPool = pool
      result = collect_DeclarationIdentity(result, v0)
      result = collect_Nat(result, v1)
      result
    },
    SignatureCallable(v0) => {
      mut result: TextPool = pool
      result = collect_SignatureEffect(result, v0)
      result
    },
    SignatureHole(v0, v1, v2) => {
      mut result: TextPool = pool
      result = collect_DeclarationIdentity(result, v0)
      result = collect_Array_Nat(result, v1)
      result = collect_Nat(result, v2)
      result
    }
  }
}

pure collect_SignatureEffect(pool: TextPool, value: SignatureEffect): TextPool {
  match value {
    SignaturePure() => pool,
    SignatureOrdinary() => pool,
    SignatureAsync() => pool
  }
}

pure collect_Array_Nat(pool: TextPool, value: [Nat]): TextPool {
  mut result: TextPool = pool
  for item in value { result = collect_Nat(result, item) }
  result
}

pure collect_Array_SignatureType(pool: TextPool, value: [SignatureType]): TextPool {
  mut result: TextPool = pool
  for item in value { result = collect_SignatureType(result, item) }
  result
}

pure collect_Optional_SignatureEffect(pool: TextPool, value: Option[SignatureEffect]): TextPool {
  match value { None() => pool, Some(item) => collect_SignatureEffect(pool, item) }
}

pure collect_Array_BodyLocal(pool: TextPool, value: [BodyLocal]): TextPool {
  mut result: TextPool = pool
  for item in value { result = collect_BodyLocal(result, item) }
  result
}

pure collect_BodyLocal(pool: TextPool, value: BodyLocal): TextPool {
  mut result: TextPool = pool
  result = collect_BodyLocalIdentity(result, value.identity)
  result = collect_Optional_SignatureType(result, value.type)
  result = collect_Bool(result, value.mutable)
  result
}

pure collect_BodyLocalIdentity(pool: TextPool, value: BodyLocalIdentity): TextPool {
  mut result: TextPool = pool
  result = collect_DeclarationIdentity(result, value.owner)
  result = collect_Array_Nat(result, value.path)
  result = collect_Str(result, value.name)
  result
}

pure collect_Optional_SignatureType(pool: TextPool, value: Option[SignatureType]): TextPool {
  match value { None() => pool, Some(item) => collect_SignatureType(pool, item) }
}

pure collect_BoundBody(pool: TextPool, value: BoundBody): TextPool {
  mut result: TextPool = pool
  result = collect_BodyNode(result, value.node)
  result = collect_SourceSpan(result, value.span)
  result = collect_Array_BoundBody(result, value.children)
  result = collect_Optional_SignatureType(result, value.type)
  result
}

pure collect_BodyNode(pool: TextPool, value: BodyNode): TextPool {
  match value {
    BodyLiteral(v0) => {
      mut result: TextPool = pool
      result = collect_Expr(result, v0)
      result
    },
    BodyInterpolation(v0) => {
      mut result: TextPool = pool
      result = collect_Array_Str(result, v0)
      result
    },
    BodyLocalUse(v0, v1) => {
      mut result: TextPool = pool
      result = collect_BodyLocalIdentity(result, v0)
      result
    },
    BodyFunction(v0) => {
      mut result: TextPool = pool
      result = collect_ModuleDeclarationBinding(result, v0)
      result
    },
    BodyCall(v0, v1, v2) => {
      mut result: TextPool = pool
      result = collect_BodyTarget(result, v0)
      result = collect_Array_SignatureType(result, v1)
      result
    },
    BodyArray() => pool,
    BodyUnary(v0) => {
      mut result: TextPool = pool
      result = collect_Str(result, v0)
      result
    },
    BodyBinary(v0) => {
      mut result: TextPool = pool
      result = collect_Str(result, v0)
      result
    },
    BodyField(v0) => {
      mut result: TextPool = pool
      result = collect_Str(result, v0)
      result
    },
    BodyIndex() => pool,
    BodyIf(v0) => {
      mut result: TextPool = pool
      result = collect_Bool(result, v0)
      result
    },
    BodyBlock(v0, v1, v2) => {
      mut result: TextPool = pool
      result = collect_Bool(result, v0)
      result = collect_Optional_SourceSpan(result, v1)
      result = collect_Array_SourceSpan(result, v2)
      result
    },
    BodyMatch(v0, v1, v2) => {
      mut result: TextPool = pool
      result = collect_Array_BodyTarget(result, v0)
      result = collect_Array_Array_BodyLocalIdentity(result, v1)
      result = collect_Array_SourceSpan(result, v2)
      result
    },
    BodyBinding(v0, v1, v2, v3, v4) => {
      mut result: TextPool = pool
      result = collect_BodyLocalIdentity(result, v0)
      result = collect_Optional_SignatureType(result, v1)
      result = collect_Bool(result, v2)
      result
    },
    BodyAssignment(v0, v1) => {
      mut result: TextPool = pool
      result = collect_BodyLocalIdentity(result, v0)
      result
    },
    BodyWhile() => pool,
    BodyFor(v0) => {
      mut result: TextPool = pool
      result = collect_BodyLocalIdentity(result, v0)
      result
    },
    BodyEmpty() => pool
  }
}

pure collect_Expr(pool: TextPool, value: Expr): TextPool {
  match value {
    LocatedExpr(v0, v1, v2) => {
      mut result: TextPool = pool
      result = collect_SourceSpan(result, v0)
      result = collect_Expr(result, v1)
      result = collect_Array_SourceSpan(result, v2)
      result
    },
    NatExpr(v0) => {
      mut result: TextPool = pool
      result = collect_Nat(result, v0)
      result
    },
    DecimalExpr(v0) => {
      mut result: TextPool = pool
      result = collect_Str(result, v0)
      result
    },
    StringExpr(v0) => {
      mut result: TextPool = pool
      result = collect_Str(result, v0)
      result
    },
    BoolExpr(v0) => {
      mut result: TextPool = pool
      result = collect_Bool(result, v0)
      result
    },
    NameExpr(unused0) => pool,
    FunctionExpr(unused0) => pool,
    ArrayExpr(unused0) => pool,
    UnaryExpr(unused0, unused1) => pool,
    BinaryExpr(unused0, unused1, unused2) => pool,
    CallExpr(unused0, unused1, unused2) => pool,
    DotCallExpr(unused0, unused1, unused2, unused3) => pool,
    OwnedCallExpr(unused0, unused1, unused2, unused3) => pool,
    FieldExpr(unused0, unused1) => pool,
    IndexExpr(unused0, unused1) => pool,
    IfExpr(unused0, unused1, unused2, unused3) => pool,
    BlockExpr(unused0) => pool,
    MatchExpr(unused0, unused1) => pool
  }
}

pure collect_Array_SourceSpan(pool: TextPool, value: [SourceSpan]): TextPool {
  mut result: TextPool = pool
  for item in value { result = collect_SourceSpan(result, item) }
  result
}

pure collect_BodyTarget(pool: TextPool, value: BodyTarget): TextPool {
  match value {
    BodyDeclaration(v0) => {
      mut result: TextPool = pool
      result = collect_ModuleDeclarationBinding(result, v0)
      result
    },
    BodyCore(v0) => {
      mut result: TextPool = pool
      result = collect_Str(result, v0)
      result
    }
  }
}

pure collect_Optional_SourceSpan(pool: TextPool, value: Option[SourceSpan]): TextPool {
  match value { None() => pool, Some(item) => collect_SourceSpan(pool, item) }
}

pure collect_Array_BodyTarget(pool: TextPool, value: [BodyTarget]): TextPool {
  mut result: TextPool = pool
  for item in value { result = collect_BodyTarget(result, item) }
  result
}

pure collect_Array_Array_BodyLocalIdentity(pool: TextPool, value: [[BodyLocalIdentity]]): TextPool {
  mut result: TextPool = pool
  for item in value { result = collect_Array_BodyLocalIdentity(result, item) }
  result
}

pure collect_Array_BodyLocalIdentity(pool: TextPool, value: [BodyLocalIdentity]): TextPool {
  mut result: TextPool = pool
  for item in value { result = collect_BodyLocalIdentity(result, item) }
  result
}

pure collect_Array_BoundBody(pool: TextPool, value: [BoundBody]): TextPool {
  mut result: TextPool = pool
  for item in value { result = collect_BoundBody(result, item) }
  result
}

pub pure encode_checked_bodies(bodies: [BoundFunctionBody]): Bytes {
  pool = collect_Array_BoundFunctionBody(TextPool(map(), []), bodies)
  mut chunks: [Bytes] = [encode_u32(pool.texts.len())]
  for text in pool.texts { chunks = chunks.append(encode_text(text)) }
  chunks = chunks.append(encode_Array_BoundFunctionBody(pool.indices, bodies))
  source_map_join(chunks, 0, chunks.len())
}
pub pure decode_checked_bodies(data: Bytes): Option[[BoundFunctionBody]] {
  count = read_count(CacheReader(data, 0, true, 0, []))
  mut reader: CacheReader = count.reader
  mut texts: [Str] = []
  if count.value > 1000000 || count.value > data.length() { reader = failed(reader) }
  mut index: Nat = 0
  while reader.valid && index < count.value {
    text = decode_raw_string(reader)
    reader = text.reader
    texts = texts.append(text.value)
    index = index + 1
  }
  result = decode_Array_BoundFunctionBody(CacheReader(data, reader.offset, reader.valid, 0, texts))
  if result.reader.valid && result.reader.offset == data.length() { Some(result.value) }
  else { None() }
}
