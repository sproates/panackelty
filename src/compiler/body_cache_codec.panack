    WhileStatement(v0, v1) => {
      mut result: CachePool = pool
      result = collect_Expr(result, v0)
      result = collect_Block(result, v1)
      result
    },
    ForStatement(v0, v1, v2) => {
      mut result: CachePool = pool
      result = collect_Str(result, v0)
      result = collect_Expr(result, v1)
      result = collect_Block(result, v2)
      result
    }
  }
}

pure collect_Optional_SourceSpan(pool: CachePool, value: Option[SourceSpan]): CachePool {
