}

pure collect_Array_TopLevel(pool: CachePool, value: [TopLevel]): CachePool {
  mut result: CachePool = pool
  for item in value { result = collect_TopLevel(result, item) }
  result
}

pure collect_TopLevel(pool: CachePool, value: TopLevel): CachePool {
  match value {
    ImportDeclaration(v0) => {
      mut result: CachePool = pool
      result = collect_Str(result, v0)
      result
    },
    TypeDeclaration(v0, v1, v2, v3) => {
      mut result: CachePool = pool
      result = collect_Str(result, v0)
      result = collect_Str(result, v1)
      result = collect_Str(result, v2)
      result = collect_Expr(result, v3)
      result
    },
    RecordDeclaration(v0, v1, v2) => {
      mut result: CachePool = pool
      result = collect_Str(result, v0)
      result = collect_Array_Str(result, v1)
      result = collect_Array_RecordField(result, v2)
      result
    },
    EnumDeclaration(v0, v1, v2) => {
      mut result: CachePool = pool
      result = collect_Str(result, v0)
      result = collect_Array_Str(result, v1)
      result = collect_Array_EnumVariant(result, v2)
      result
    },
    FunctionDeclaration(v0, v1, v2, v3, v4, v5, v6) => {
      mut result: CachePool = pool
      result = collect_Str(result, v0)
      result = collect_Array_FunctionParameter(result, v1)
      result = collect_Str(result, v2)
      result = collect_Bool(result, v3)
      result = collect_Bool(result, v4)
      result = collect_Block(result, v5)
      result = collect_Array_Str(result, v6)
      result
    }
  }
}

pure collect_Array_RecordField(pool: CachePool, value: [RecordField]): CachePool {
  mut result: CachePool = pool
  for item in value { result = collect_RecordField(result, item) }
