    mut reader: CacheReader = count.reader
    mut texts: [Str] = []
    if count.value > 1000000 || count.value > data.length() { reader = failed(reader) }
    mut index: Nat = 0
    while reader.valid && index < count.value {
      text = decode_raw_string(reader)
      reader = text.reader
      texts = texts.append(text.value)
      index = index + 1
    }
    table = read_type_table(CacheReader(data, reader.offset, reader.valid, 0, texts, [], 0))
    result = decode_CachedModuleCode(table)
    if result.reader.valid && result.reader.offset == data.length() { Some(result.value) }
    else { None() }
