  }
}

pure decode_Optional_SignatureEffect(reader: CacheReader): CacheRead[Option[SignatureEffect]] {
  tag = read_count(reader)
  if tag.reader.valid && tag.value == 1 {
    item = decode_SignatureEffect(tag.reader)
    CacheRead(item.reader, Some(item.value))
  } else {
    CacheRead(if tag.value == 0 { tag.reader } else { failed(tag.reader) }, None())
  }
}

pure encode_ModuleSignature(pool: CachePool, value: ModuleSignature): Bytes {
  byte_buffer.empty().join(encode_ModuleDeclarationBinding(pool, value.binding)).join(encode_Array_Str(pool, value.parameters)).join(encode_Array_SignatureSlot(pool, value.slots)).join(encode_Optional_SignatureEffect(pool, value.effect))
}

