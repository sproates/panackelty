    BodyAssignment(v0, v1) => encode_u32(14).join(encode_BodyLocalIdentity(pool, v0)),
    BodyWhile() => encode_u32(15),
    BodyFor(v0) => encode_u32(16).join(encode_BodyLocalIdentity(pool, v0)),
    BodyEmpty() => encode_u32(17)
  }
}

