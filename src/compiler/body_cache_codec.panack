    } else {
      mut cursor: CacheReader = tag.reader
    v0 = decode_Str(cursor)
    cursor = v0.reader
    CacheRead(cursor, BodyField(v0.value))
    }
    }
    }
    }
    } else {
      if tag.value < 13 {
