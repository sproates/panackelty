  field_identity = decode_DeclarationIdentity(cursor)
  cursor = field_identity.reader
  field_kind = decode_ModuleDeclarationKind(cursor)
  cursor = field_kind.reader
  field_is_public = decode_Bool(cursor)
  cursor = field_is_public.reader
  field_span = decode_SourceSpan(cursor)
  cursor = field_span.reader
  field_method = decode_Optional_OwnedMethodIdentity(cursor)
  cursor = field_method.reader
  field_intrinsic = decode_Optional_OwnedIntrinsic(cursor)
  cursor = field_intrinsic.reader
  CacheRead(cursor, ModuleDeclarationBinding(field_identity.value, field_kind.value, field_is_public.value, field_span.value, field_method.value, field_intrinsic.value))
}

pure encode_Array_Str(pool: CachePool, value: [Str]): Bytes {
  mut chunks: [Bytes] = [encode_u32(value.len())]
  for item in value { chunks = chunks.append(encode_Str(pool, item)) }
  source_map_join(chunks, 0, chunks.len())
}

pure decode_Array_Str(reader: CacheReader): CacheRead[[Str]] {
  count = read_count(reader)
  mut cursor: CacheReader = count.reader
  mut values: [Str] = []
  if count.value > 1000000 || count.value > reader.data.length() { cursor = failed(cursor) }
  mut index: Nat = 0
  while cursor.valid && index < count.value {
    item = decode_Str(cursor)
    cursor = item.reader
    values = values.append(item.value)
    index = index + 1
  }
  CacheRead(cursor, values)
}

pure encode_SignatureEffect(pool: CachePool, value: SignatureEffect): Bytes {
  match value {
    SignaturePure() => encode_u32(0),
    SignatureOrdinary() => encode_u32(1),
    SignatureAsync() => encode_u32(2)
  }
}

pure decode_SignatureEffect(reader: CacheReader): CacheRead[SignatureEffect] {
  tag = read_count(reader)
  if tag.reader.valid && tag.value == 0 {
    CacheRead(tag.reader, SignaturePure())
  } else if tag.reader.valid && tag.value == 1 {
    CacheRead(tag.reader, SignatureOrdinary())
  } else if tag.reader.valid && tag.value == 2 {
    CacheRead(tag.reader, SignatureAsync())
  } else { CacheRead(failed(tag.reader), SignaturePure()) }
}

pure encode_Array_Nat(pool: CachePool, value: [Nat]): Bytes {
  mut chunks: [Bytes] = [encode_u32(value.len())]
  for item in value { chunks = chunks.append(encode_Nat(pool, item)) }
