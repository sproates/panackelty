import stdlib/host as std_host
import project/src/compiler/path_support as path_support
import stdlib/path as std_path
import stdlib/bytes as byte_buffer
import stdlib/environment as std_environment
import stdlib/filesystem as std_filesystem
pub import project/src/compiler/coverage::{CoverageData}
import project/src/compiler/coverage::{CoverageCell, CoverageFunction, coverage_number, coverage_prefix, decode_coverage_at, render_coverage, coverage_mapped_project}
import project/src/compiler/loader::{LoadedProject, load_project_for_inventory}
import project/src/compiler/emitter::{BytecodeProgram, SourceMappedProgram}
import project/src/bytecode/codec::{encode_u32, serialize_bytecode, sort_functions}
import project/src/compiler/source_inventory::{serialize_source_inventory}
import project/src/compiler/source_maps::{source_map_read, source_map_join, source_map_blob, source_map_matches, source_snapshots_unchanged}

// Aggregate complete, identity-bound execution trees. Registry, nonce and terminal
// checks prevent unrelated or partial observations from entering a report.

record CoverageRoot {
  project: LoadedProject,
  mapped: SourceMappedProgram,
  artifact: Bytes,
  inventory: Bytes,
  root: Str,
  stdlib: Str
}

record CoverageSessionResult {
  valid: Bool,
  nonce: Bytes,
  executions: Nat,
  totals: [CoverageData]
}

pure coverage_zero(program: BytecodeProgram): CoverageData {
  mut functions: [CoverageFunction] = []

  for function in sort_functions(program.functions) {
    mut cells: [CoverageCell] = []
    for instruction in function.instructions {
      cells = cells->append(CoverageCell(0, 0, 0, 0))
    }
    functions = functions->append(CoverageFunction(0, cells))
  }
  CoverageData(true, 1, functions)
}

pub pure coverage_sum(left: CoverageData, right: CoverageData): CoverageData {
  mut functions: [CoverageFunction] = []
  mut valid: Bool = left.valid && right.valid && left.functions->len() == right.functions->len()

  if valid {
    for index in 0..left.functions->len() {
      a: CoverageFunction = left.functions[index]
      b: CoverageFunction = right.functions[index]
      valid = valid && a.cells->len() == b.cells->len() && a.entries + b.entries <= 18446744073709551615
      mut cells: [CoverageCell] = []
      if valid {
        for pc in 0..a.cells->len() {
          x: CoverageCell = a.cells[pc]
          y: CoverageCell = b.cells[pc]
          cell: CoverageCell = CoverageCell(x.attempted + y.attempted, x.completed + y.completed,
            x.fallthrough + y.fallthrough, x.branched + y.branched)
          valid = valid &&
            cell.attempted <= 18446744073709551615 &&
            cell.completed <= 18446744073709551615 &&
            cell.fallthrough <= 18446744073709551615 && cell.branched <= 18446744073709551615
          cells = cells->append(cell)
        }
      }
      functions = functions->append(CoverageFunction(a.entries + b.entries, cells))
    }
  }
  CoverageData(valid, 1, functions)
}

// Canonical bounded hierarchical IDs, never record-supplied filesystem paths.
pub pure coverage_execution_id(id: Str): Bool {
  mut valid: Bool = id->len() > 0 && id->len() < 192 && id->slice(0, 1) == "0"
  mut start: Nat = 2

  if id->len() > 1 {
    valid = valid && id->slice(1, 2) == "." && id->len() > 2
  }
  for i in 2..id->len() {
    c: Str = id->slice(i, i + 1)
    if c == "." {
      valid = valid && i > start
      start = i + 1
    } else {
      valid = valid && c >= "0" && c <= "9" && (i != start || c != "0")
    }
  }
  valid && (id->len() == 1 || start < id->len())
}

pure coverage_parent(id: Str): Str {
  mut end: Nat = 0

  for i in 0..id->len() {
    if id->slice(i, i + 1) == "." {
      end = i
    }
  }
  id->slice(0, end)
}

coverage_session_read(directory: Str, roots: [CoverageRoot]): CoverageSessionResult {
  mut valid: Bool = true
  mut nonce: Bytes = byte_buffer.empty()
  mut totals: [CoverageData] = []

  for root in roots {
    totals = totals->append(coverage_zero(root.mapped.bytecode))
  }
  mut executions: Nat = 0
  match source_map_read(directory + "/registry", 33554432) {
    Error(error) => {
      valid = false
    },
    Ok(registry) => {
      valid = registry->length() >= 35 && coverage_prefix(
        registry,
        "PANACKSESSION1\n"->encode_utf8(),
        0
      )
      if valid {
        for i in 15..31 {
          nonce = nonce->push(registry->at(i))
        }
        mut chunks: [Bytes] = ["PANACKSESSION1\n"->encode_utf8(), nonce, encode_u32(roots->len())]
        for root in roots {
          chunks = chunks->append(source_map_blob(root.artifact))
          chunks = chunks->append(source_map_blob(root.inventory))
        }
        valid = registry == source_map_join(chunks, 0, chunks->len())
      }
    }
  }
  mut names: Map[Str, Bool] = map()
  mut ids: [Str] = []
  match std_path.from_text(directory) {
    Error(error) => {
      valid = false
    },
    Ok(path) => match std_filesystem.list_directory(path) {
      Error(error) => {
        valid = false
      },
      Ok(children) => {
        valid = valid && children->len() <= 12291
        for child in children {
          match child->to_text() {
            Error(error) => {
              valid = false
            },
            Ok(name) => {
              names = names->put(name, true)
              if name->len() > 7 && name->slice(0, 7) == "expect-" {
                ids = ids->append(name->slice(7, name->len()))
              }
            }
          }
        }
      }
    }
  }
  valid = valid && ids->len() > 0 && ids->len() <= 4096 && names->has("expect-0") &&
    names->has("registry") && names->has("closed") && source_map_matches(
    directory + "/closed",
    "closed\n"->encode_utf8()
  )
  // Exact membership prevents surplus/duplicate/renamed records being ignored.
  mut expected_names: Nat = 3
  mut declared_children: Nat = 0
  mut total_bytes: Nat = 0
  for id in ids {
    valid = valid &&
      coverage_execution_id(id) &&
      (id == "0" ||
      names->has("expect-" + coverage_parent(id))) &&
      names->has("claim-" + id) && names->has("raw-" + id)
    expected_names = expected_names + 3
    mut kind: Bytes = byte_buffer.empty()
    match source_map_read(directory + "/expect-" + id, 16) {
      Error(error) => {
        valid = false
      },
      Ok(data) => {
        kind = data
      }
    }
    valid = valid && (if id == "0" {
        kind == "root\n"->encode_utf8()
      } else {
        kind == "nested\n"->encode_utf8() ||
          kind == "task\n"->encode_utf8() ||
          kind == "server\n"->encode_utf8() ||
          kind == "process\n"->encode_utf8()
      }) && source_map_matches(directory + "/claim-" + id, "claimed\n"->encode_utf8())
    if valid {
      match source_map_read(directory + "/raw-" + id, 33554432) {
        Error(error) => {
          valid = false
        },
        Ok(raw) => {
          total_bytes = total_bytes + raw->length()
          valid = valid && total_bytes <= 268435456
          envelope: Bytes = source_map_join(
            ["PANACKEXEC1\n"->encode_utf8(), nonce, source_map_blob(id->encode_utf8())],
            0,
            3
          )
          offset: Nat = envelope->length()
          valid = valid && raw->length() >= offset + 8 && coverage_prefix(raw, envelope, 0)
          if valid {
            identity: Nat = coverage_number(raw, offset, 4)
            children: Nat = coverage_number(raw, offset + 4, 4)
            declared_children = declared_children + children
            valid = identity < roots->len() && children <= 4096
            if valid {
              for child in 1..(children + 1) {
                valid = valid && names->has("expect-" + id + ".${child}")
              }
            }
            if valid {
              root: CoverageRoot = roots[identity]
              observed: CoverageData = decode_coverage_at(
                raw,
                root.artifact,
                root.inventory,
                root.mapped.bytecode,
                offset + 8
              )
              valid = observed.valid
              mut next: [CoverageData] = []
              for i in 0..totals->len() {
                combined: CoverageData = if i == identity {
                  coverage_sum(totals[i], observed)
                } else {
                  totals[i]
                }
                valid = valid && combined.valid
                next = next->append(combined)
              }
              totals = next
              executions = executions + 1
            }
          }
        }
      }
    }
  }
  // fs_list already guarantees unique names; inspect its length again below.
  match std_path.from_text(directory) {
    Error(error) => {
      valid = false
    },
    Ok(path) => match std_filesystem.list_directory(path) {
      Error(error) => {
        valid = false
      },
      Ok(children) => {
        valid = valid && children->len() == expected_names
      }
    }
  }
  CoverageSessionResult(valid && declared_children + 1 == ids->len() &&
    source_map_matches(
    directory + "/budget",
    encode_u32(ids->len())->join(encode_u32(total_bytes))
  ), nonce, executions, totals)
}

pub run_coverage_aggregate(values: [Str]): Nat {
  mut sources: [Str] = []
  mut inventories: [Str] = []
  mut sessions: [Str] = []
  mut valid: Bool = true
  mut cursor: Nat = 1

  while cursor < values->len() {
    if values[cursor] == "--source" && cursor + 2 < values->len() && sessions->len() == 0 {
      sources = sources->append(values[cursor + 1])
      inventories = inventories->append(values[cursor + 2])
      cursor = cursor + 3
    } else {
      if values[cursor] == "--session" && cursor + 1 < values->len() {
        sessions = sessions->append(values[cursor + 1])
        cursor = cursor + 2
      } else {
        valid = false
        cursor = values->len()
      }
    }
  }
  valid = valid &&
    sources->len() > 0 &&
    sources->len() <= 16 &&
    sessions->len() > 0 &&
    sessions->len() <= 256
  mut roots: [CoverageRoot] = []
  mut totals: [CoverageData] = []
  compiler_path: Str = std_environment.get("PANACKELTY_COMPILER_PATH")->value_or("")
  match source_map_read(compiler_path, 16777216) {
    Error(error) => {
      valid = false
    },
    Ok(compiler) => {
      if valid {
        for index in 0..sources->len() {
          entry: Str = path_support.resolve(sources[index])
          root: Str = path_support.parent(entry)
          stdlib: Str = path_support.resolve(std_environment.get("PANACKELTY_STDLIB_PATH")->value_or(""))
          project: LoadedProject = load_project_for_inventory(entry)
          match coverage_mapped_project(project, entry, root, stdlib) {
            Error(errors) => { valid = false },
            Ok(mapped) => {
              artifact: Bytes = serialize_bytecode(mapped.bytecode)
              inner: Bytes = serialize_source_inventory(
                project,
                artifact,
                compiler,
                entry,
                root,
                stdlib
              )
              inventory: Bytes = source_map_join(
                ["PANACKINVENTORY1\n"->encode_utf8(), encode_u32(1), source_map_blob(inner)],
                0,
                3
              )
              valid = valid && inner->length() > 0 &&
                source_map_matches(inventories[index], inventory) && source_snapshots_unchanged(project)
              for prior in roots {
                valid = valid && prior.artifact != artifact
              }
              roots = roots->append(CoverageRoot(project, mapped, artifact, inventory, root, stdlib))
              totals = totals->append(coverage_zero(mapped.bytecode))
            }
          }
        }
      }
      valid = valid && source_map_matches(compiler_path, compiler)
    }
  }
  mut seen: [Bytes] = []
  mut executions: Nat = 0
  if valid {
    for directory in sessions {
      session: CoverageSessionResult = coverage_session_read(directory, roots)
      valid = valid && session.valid
      for nonce in seen {
        valid = valid && nonce != session.nonce
      }
      seen = seen->append(session.nonce)
      if valid {
        mut next: [CoverageData] = []
        for i in 0..totals->len() {
          combined: CoverageData = coverage_sum(totals[i], session.totals[i])
          valid = valid && combined.valid
          next = next->append(combined)
        }
        totals = next
        executions = executions + session.executions
      }
    }
  }
  // Recheck local snapshots after reading all sessions; compilation and report
  // decoding must not straddle different source revisions.
  for root in roots {
    valid = valid && source_snapshots_unchanged(root.project)
  }
  if !valid {
    std_host.stderr("error: coverage aggregate unavailable: missing, partial, duplicate, incompatible or malformed session; no complete report")
    1
  } else {
    count: Nat = sessions->len()
    print("coverage: aggregate sessions=${count} executions=${executions}")
    for i in 0..roots->len() {
      root: CoverageRoot = roots[i]
      print("artifact/${i}")
      report: Str = render_coverage(root.project, root.mapped, totals[i], root.root, root.stdlib)
      print(report->slice("coverage: single-execution terminal=1\n"->len(), report->len()))
    }
    0
  }
}
