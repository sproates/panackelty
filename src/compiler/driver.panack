import stdlib/bytes::{bytes_length}
import stdlib/path::{path_string_suffix, path_string_parent, path_string_resolve, path_string_with_suffix}
import stdlib/environment::{environment, environment_value}
import stdlib/filesystem::{filesystem_write_file_bytes, filesystem_read_file_bytes}
import stdlib/host::{host_run_bytecode, host_command_arguments, host_exit}
import project/src/compiler/explanations::{explanation_function_selector, render_function_explanations}
import project/src/compiler/coverage_session::{run_coverage_aggregate}
import project/src/compiler/coverage::{run_coverage_report}
import project/src/compiler/source_inventory::{run_inventory_command}
import project/src/compiler/module_emission::{ModuleIdentity}
import project/src/compiler/loader::{LoadedProject, load_project, load_project_explained, load_project_for_source_map}
import project/src/compiler/parser::{Program}
pub import project/src/compiler/types::{Diagnostic}
import project/src/compiler/diagnostics::{diagnostic_with_source}
import project/src/compiler/emitter::{BytecodeProgram, SourceMappedProgram, compile_program, compile_program_with_sources, render_bytecode}
import project/src/bytecode/codec::{serialize_bytecode}
import project/src/compiler/source_maps::{SourceMapFunctionSelector, source_map_escape, source_map_destination_available, source_map_matches, source_map_location, source_map_write, source_snapshots_unchanged, serialize_source_map, source_map_function_selector}
import project/src/compiler/module_bindings::{source_module_identity}
import project/src/compiler/project_frontend::{prepare_project_program}
import project/src/bytecode/decoder::{validate_bytecode, disassemble_bytecode}

// The command boundary owns host I/O and user-visible status. Pure compiler passes
// receive prepared projects; failed checks must not publish bytecode.

record PreparedProject {
  valid: Bool,
  program: Program,
  message: Str
}

driver_project_root(entry: Str): Str {
  match environment("PANACKELTY_BOOTSTRAP_ROOT") {
    Some(value) => path_string_resolve(value),
    None() => path_string_parent(entry)
  }
}

pure driver_entry_identity(
  loaded: LoadedProject,
  entry: Str,
  fallback: ModuleIdentity
): ModuleIdentity {
  mut selected: ModuleIdentity = fallback
  for module in loaded.modules {
    if module.source_path == entry {
      selected = module.bindings.identity
    }
  }
  selected
}

pub pure diagnostic_messages(diagnostics: [Diagnostic], sources: Map[Str, Str]): Str {
  mut output: Str = ""
  mut first: Bool = true

  for diagnostic in diagnostics {
    if first {
      first = false
    } else {
      output = output + "\n"
    }
    output = output + diagnostic_with_source(diagnostic, sources)
  }

  output
}

pure namespace_gate_diagnostic(diagnostic: Diagnostic): Bool {
  diagnostic.message == "namespace syntax is parsed but execution is not yet supported (language namespace migration pending)"
}

pure tooling_diagnostics(project: LoadedProject): [Diagnostic] {
  mut diagnostics: [Diagnostic] = []
  for diagnostic in project.diagnostics {
    if !namespace_gate_diagnostic(diagnostic) {
      diagnostics = diagnostics.append(diagnostic)
    }
  }
  diagnostics
}

prepare_project(path: Str): PreparedProject {
  prepare_loaded_project(path, load_project(path))
}

prepare_loaded_project(path: Str, loaded: LoadedProject): PreparedProject {
  entry: Str = path_string_resolve(path)
  root: Str = driver_project_root(entry)
  stdlib_root: Str = match environment("PANACKELTY_STDLIB_PATH") {
    Some(value) => path_string_resolve(value),
    None() => ""
  }
  identity: ModuleIdentity = driver_entry_identity(
    loaded,
    entry,
    source_module_identity(entry, root, stdlib_root)
  )
  match prepare_project_program(loaded, root, stdlib_root, identity) {
    Error(diagnostics) => PreparedProject(false, loaded.program, diagnostic_messages(diagnostics, loaded.sources)),
    Ok(program) => PreparedProject(true, program, "")
  }
}

report_driver_error(message: Str): Nat {
  eprint("error: ${message}")
  1
}

pure driver_usage(): Str {
  "usage: panack coverage-run ARTIFACT.bc INVENTORY RAW [arguments...]\n       panack coverage-session DIRECTORY ARTIFACT INVENTORY [ARTIFACT INVENTORY ...] -- [arguments...]\n       panack coverage-aggregate --source SOURCE INVENTORY [--source SOURCE INVENTORY ...] --session DIRECTORY [--session DIRECTORY ...]\n       panack coverage-report SOURCE.panack --inventory FILE --coverage RAW\n       panack inventory SOURCE.panack -o FILE [--include SOURCE.panack]\n       panack inventory-check SOURCE.panack --inventory FILE [--include SOURCE.panack]\n       panack FILE | panack {check,compile,run,disasm} FILE\n       panack explain SOURCE.panack --function NAME\n       panack compile SOURCE.panack -o ARTIFACT.bc --source-map MAP\n       panack locate ARTIFACT.bc --source SOURCE.panack --source-map MAP --function NAME --instruction PC"
}

pure without_final_newline(text: Str): Str {
  end: Nat = len(text)

  if end > 0 {
    last: Nat = end - 1
    if text[last] == "\n" {
      slice(text, 0, last)
    } else {
      text
    }
  } else {
    text
  }
}

run_source_command(command: Str, path: Str, output: Str, program_arguments: [Str]): Nat {
  prepared: PreparedProject = prepare_project(path)

  if !prepared.valid {
    report_driver_error(prepared.message)
  } else {
    bytecode: BytecodeProgram = compile_program(prepared.program)
    if command == "check" {
      print("ok")
      0
    } else {
      if command == "compile" {
        destination: Str = if len(output) > 0 {
          output
        } else {
          path_string_with_suffix(path, ".bc")
        }
        if path_string_resolve(destination) == path_string_resolve(path) {
          report_driver_error("bytecode output cannot overwrite the source file")
        } else {
          filesystem_write_file_bytes(destination, serialize_bytecode(bytecode))
          print("wrote ${destination}")
          0
        }
      } else {
        if command == "disasm" {
          print(without_final_newline(render_bytecode(bytecode)))
          0
        } else {
          host_run_bytecode(serialize_bytecode(bytecode), program_arguments)
          0
        }
      }
    }
  }
}

run_explain_command(values: [Str]): Nat {
  if len(values) != 4 {
    report_driver_error("explain usage: explain SOURCE.panack --function NAME")
  } else {
    if path_string_suffix(values[1]) != ".panack" || values[2] != "--function" || values[3] == "" {
      report_driver_error("explain usage: explain SOURCE.panack --function NAME")
    } else {
      loaded: LoadedProject = load_project_explained(values[1])
      entry: Str = path_string_resolve(values[1])
      root: Str = driver_project_root(entry)
      stdlib_root: Str = match environment("PANACKELTY_STDLIB_PATH") {
        Some(value) => path_string_resolve(value),
        None() => ""
      }
      selected: Result[SourceMapFunctionSelector, Str] = explanation_function_selector(
        loaded,
        values[3],
        entry,
        root,
        stdlib_root
      )
      match selected {
        Error(message) => if starts_with_at(message, "unknown function selector ", 0) {
          report_driver_error("explain: unknown function " + source_map_escape(values[3]))
        } else {
          report_driver_error("explain: " + message)
        },
        Ok(function) => {
          prepared: PreparedProject = prepare_loaded_project(entry, loaded)
          diagnostics: [Diagnostic] = tooling_diagnostics(loaded)
          valid: Bool = prepared.valid && len(diagnostics) == 0
          print(render_function_explanations(
            loaded,
            function,
            valid,
            root,
            stdlib_root
          ))
          if valid {
            0
          } else {
            if len(diagnostics) > 0 {
              report_driver_error(diagnostic_messages(diagnostics, loaded.sources))
            } else {
              report_driver_error(prepared.message)
            }
          }
        }
      }
    }
  }
}

run_artifact_command(command: Str, path: Str, program_arguments: [Str]): Nat {
  data: Bytes = filesystem_read_file_bytes(path)
  validation: Str = validate_bytecode(data)

  if validation != "ok" {
    report_driver_error(validation)
  } else {
    if command == "check" {
      print("ok")
      0
    } else {
      if command == "disasm" {
        print(without_final_newline(disassemble_bytecode(data)))
        0
      } else {
        host_run_bytecode(data, program_arguments)
        0
      }
    }
  }
}

pure source_map_argument_present(arguments: [Str]): Bool {
  mut present: Bool = false

  for argument in arguments {
    if argument == "--source-map" {
      present = true
    }
  }
  present
}

pub record SourceMapArguments {
  valid: Bool,
  source: Str,
  artifact: Str,
  sidecar: Str,
  function_name: Str,
  instruction: Nat
}

pub pure source_map_instruction(text: Str): Option[Nat] {
  mut valid: Bool = len(text) > 0 && len(text) <= 10

  for index in 0..len(text) {
    if text[index] < "0" || text[index] > "9" {
      valid = false
    }
  }
  if valid {
    value: Nat = nat_from_str(text)
    if value <= 4294967295 {
      Some(value)
    } else {
      None()
    }
  } else {
    None()
  }
}

pub pure source_map_arguments(values: [Str], locating: Bool): SourceMapArguments {
  mut source: Str = ""
  mut artifact: Str = ""
  mut sidecar: Str = ""
  mut function_name: Str = ""
  mut instruction: Option[Nat] = None()
  mut valid: Bool = len(values) >= 2

  if valid {
    if locating {
      artifact = values[1]
    } else {
      source = values[1]
    }
  }
  mut index: Nat = 2
  while index < len(values) && valid {
    if index + 1 >= len(values) {
      valid = false
    } else {
      option: Str = values[index]
      value: Str = values[index + 1]
      if option == "--source-map" && sidecar == "" {
        sidecar = value
      } else {
        if option == "-o" && !locating && artifact == "" {
          artifact = value
        } else {
          if option == "--source" && locating && source == "" {
            source = value
          } else {
            if option == "--function" && locating && function_name == "" {
              function_name = value
            } else {
              if option == "--instruction" && locating {
                match instruction {
                  Some(previous) => {
                    valid = false
                  },
                  None() => {
                    instruction = source_map_instruction(value)
                    match instruction {
                      Some(pc) => {},
                      None() => {
                        valid = false
                      }
                    }
                  }
                }
              } else {
                valid = false
              }
            }
          }
        }
      }
      if value == "" {
        valid = false
      }
      index = index + 2
    }
  }
  valid = valid && source != "" && artifact != "" && sidecar != "" &&
    path_string_suffix(source) == ".panack" && path_string_suffix(artifact) == ".bc"
  mut pc: Nat = 0
  if locating {
    valid = valid && function_name != ""
    match instruction {
      Some(value) => {
        pc = value
      },
      None() => {
        valid = false
      }
    }
  }
  SourceMapArguments(valid, source, artifact, sidecar, function_name, pc)
}

run_source_map_command(values: [Str], locating: Bool): Nat {
  args: SourceMapArguments = source_map_arguments(values, locating)

  if !args.valid {
    report_driver_error("source-map usage: compile SOURCE.panack -o ARTIFACT.bc --source-map MAP | locate ARTIFACT.bc --source SOURCE.panack --source-map MAP --function NAME --instruction PC")
  } else {
    entry: Str = path_string_resolve(args.source)
    artifact_path: Str = path_string_resolve(args.artifact)
    map_path: Str = path_string_resolve(args.sidecar)
    if !locating && (artifact_path == map_path ||
      !source_map_destination_available(artifact_path) ||
      !source_map_destination_available(map_path)) {
      report_driver_error("source-map compilation requires two distinct, nonexistent output files")
    } else {
      loaded: LoadedProject = load_project_for_source_map(entry)
      prepared: PreparedProject = prepare_loaded_project(entry, loaded)
      if !prepared.valid {
        if locating {
          print("source-map: unavailable")
          0
        } else {
          report_driver_error(prepared.message)
        }
      } else {
        root: Str = driver_project_root(entry)
        stdlib_root: Str = path_string_resolve(environment_value("PANACKELTY_STDLIB_PATH"))
        mapped: SourceMappedProgram = compile_program_with_sources(prepared.program)
        artifact: Bytes = serialize_bytecode(mapped.bytecode)
        sidecar: Bytes = serialize_source_map(loaded, mapped, artifact, entry, root, stdlib_root)
        valid: Bool = bytes_length(sidecar) > 0 &&
          validate_bytecode(artifact) == "ok" &&
          source_snapshots_unchanged(loaded)
        if locating {
          selected: Result[SourceMapFunctionSelector, Str] = source_map_function_selector(
            loaded,
            args.function_name,
            entry,
            root,
            stdlib_root
          )
          match selected {
            Error(message) => if starts_with_at(message, "unknown function selector ", 0) {
              print("source-map: unavailable")
              0
            } else {
              report_driver_error(message)
            },
            Ok(function) => if valid && source_map_matches(
            artifact_path,
            artifact
          ) && source_map_matches(map_path, sidecar) {
            print(source_map_location(
              loaded,
              mapped,
              function.emitted_name,
              function.display_name,
              args.instruction,
              root,
              stdlib_root
            ))
            0
          } else {
            print("source-map: unavailable");
            0
          }
          }
        } else {
          if !valid {
            report_driver_error("source-map limit exceeded, invalid artifact, or source changed during compilation")
          } else {
            if !source_map_destination_available(artifact_path) ||
              !source_map_destination_available(map_path) {
              report_driver_error("source-map output appeared during compilation")
            } else {
              // The first write can reveal directory-symlink or case aliases.
              if !source_map_write(artifact_path, artifact) ||
                !source_map_destination_available(map_path) || !source_map_write(
                map_path,
                sidecar
              ) ||
                !source_map_matches(
                artifact_path,
                artifact
              ) || !source_map_matches(map_path, sidecar) {
                report_driver_error("could not write source-map output pair; discard any partial output")
              } else {
                print("wrote " + args.artifact)
                print("wrote source map " + args.sidecar)
                0
              }
            }
          }
        }
      }
    }
  }
}

run_compiler_command(arguments: [Str]): Nat {
  mut values: [Str] = arguments

  if len(values) > 0 && values[0] == "--" {
    mut trimmed: [Str] = []
    mut cursor: Nat = 1
    while cursor < len(values) {
      trimmed = append(trimmed, values[cursor])
      cursor = cursor + 1
    }
    values = trimmed
  } else {}
  if len(values) == 0 || values[0] == "--help" {
    print(driver_usage())
    0
  } else {
    if values[0] == "coverage-report" || values[0] == "coverage-aggregate" {
      if values[0] == "coverage-report" {
        run_coverage_report(values)
      } else {
        run_coverage_aggregate(values)
      }
    } else {
      if values[0] == "inventory" || values[0] == "inventory-check" {
        run_inventory_command(values, values[0] == "inventory-check")
      } else {
        if values[0] == "explain" {
          run_explain_command(values)
        } else {
          if values[0] == "locate" {
            run_source_map_command(values, true)
          } else {
            if values[0] == "compile" && source_map_argument_present(values) {
              run_source_map_command(values, false)
            } else {
              mut command: Str = values[0]
              mut file_index: Nat = 1
              if command != "check" &&
                command != "compile" &&
                command != "run" &&
                command != "disasm" {
                command = "run"
                file_index = 0
              } else {}
              if file_index >= len(values) {
                report_driver_error("missing input file")
              } else {
                path: Str = values[file_index]
                suffix: Str = path_string_suffix(path)
                mut output: Str = ""
                mut program_arguments: [Str] = []
                mut argument_index: Nat = file_index + 1
                while argument_index < len(values) {
                  program_arguments = append(program_arguments, values[argument_index])
                  argument_index = argument_index + 1
                }
                if command == "compile" &&
                  file_index + 2 < len(values) &&
                  values[file_index + 1] == "-o" {
                  output = values[file_index + 2]
                } else {}
                if command == "compile" && suffix != ".panack" {
                  report_driver_error("compile expects a .panack source file")
                } else {
                  if suffix != ".panack" && suffix != ".bc" {
                    report_driver_error("expected a .panack source or .bc bytecode file")
                  } else {
                    if suffix == ".panack" {
                      run_source_command(command, path, output, program_arguments)
                    } else {
                      if command == "compile" {
                        report_driver_error("compile expects a .panack source file")
                      } else {
                        run_artifact_command(command, path, program_arguments)
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

pub compiler_main(): Void {
  status: Nat = run_compiler_command(host_command_arguments())

  if status != 0 {
    host_exit(status);
  } else {}
}
