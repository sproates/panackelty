import project/src/compiler/path_support as path_support
import stdlib/environment as std_environment
import project/src/compiler/filesystem_support as filesystem_support
import stdlib/host as std_host
import project/src/compiler/explanations::{explanation_function_selector, render_function_explanations, render_expression_type_explanation}
import project/src/compiler/coverage_session::{run_coverage_aggregate}
import project/src/compiler/coverage::{run_coverage_report}
import project/src/compiler/source_inventory::{run_inventory_command}
import project/src/compiler/module_emission::{ModuleIdentity}
import project/src/compiler/loader::{
  LoadedProject, load_project, load_project_package, load_project_package_for_check,
  load_project_explained, load_project_for_source_map
}
import project/src/compiler/package_project::{ManifestProject, read_manifest_project}
import project/src/compiler/parser::{Program}
pub import project/src/compiler/types::{Diagnostic}
import project/src/compiler/diagnostics::{diagnostic_with_source}
import project/src/compiler/emitter::{BytecodeProgram, SourceMappedProgram, compile_program, compile_program_with_sources, render_bytecode}
import project/src/bytecode/codec::{serialize_bytecode}
import project/src/compiler/source_maps::{SourceMapFunctionSelector, source_map_escape, source_map_destination_available, source_map_matches, source_map_location, source_map_write, source_snapshots_unchanged, serialize_source_map, source_map_function_selector}
import project/src/compiler/module_bindings::{source_module_identity, source_package_module_identity}
import project/src/compiler/project_frontend::{prepare_project_program, prepare_project_program_with_dependencies}
import project/src/bytecode/decoder::{validate_bytecode, disassemble_bytecode}

// The command boundary owns host I/O and user-visible status. Pure compiler passes
// receive prepared projects; failed checks must not publish bytecode.

record PreparedProject {
  valid: Bool,
  program: Program,
  message: Str
}

driver_project_root(entry: Str): Str {
  match std_environment.get("PANACKELTY_BOOTSTRAP_ROOT") {
    Some(value) => path_support.resolve(value),
    None() => path_support.parent(entry)
  }
}

pure driver_entry_identity(
  loaded: LoadedProject,
  entry: Str,
  fallback: ModuleIdentity
): ModuleIdentity {
  mut selected: ModuleIdentity = fallback
  for module in loaded.modules {
    if module.source_path == entry {
      selected = module.bindings.identity
    }
  }
  selected
}

pub pure diagnostic_messages(diagnostics: [Diagnostic], sources: Map[Str, Str]): Str {
  mut output: Str = ""
  mut first: Bool = true

  for diagnostic in diagnostics {
    if first {
      first = false
    } else {
      output = output + "\n"
    }
    output = output + diagnostic_with_source(diagnostic, sources)
  }

  output
}

pure namespace_gate_diagnostic(diagnostic: Diagnostic): Bool {
  diagnostic.message == "namespace syntax is parsed but execution is not yet supported (language namespace migration pending)"
}

pure tooling_diagnostics(project: LoadedProject): [Diagnostic] {
  mut diagnostics: [Diagnostic] = []
  for diagnostic in project.diagnostics {
    if !namespace_gate_diagnostic(diagnostic) {
      diagnostics = diagnostics.append(diagnostic)
    }
  }
  diagnostics
}

prepare_project(path: Str): PreparedProject {
  prepare_loaded_project(path, load_project(path))
}

prepare_loaded_project(path: Str, loaded: LoadedProject): PreparedProject {
  entry: Str = path_support.resolve(path)
  root: Str = driver_project_root(entry)
  stdlib_root: Str = match std_environment.get("PANACKELTY_STDLIB_PATH") {
    Some(value) => path_support.resolve(value),
    None() => ""
  }
  identity: ModuleIdentity = driver_entry_identity(
    loaded,
    entry,
    source_module_identity(entry, root, stdlib_root)
  )
  match prepare_project_program(loaded, root, stdlib_root, identity) {
    Error(diagnostics) => PreparedProject(false, loaded.program, diagnostic_messages(diagnostics, loaded.sources)),
    Ok(program) => PreparedProject(true, program, "")
  }
}

report_driver_error(message: Str): Nat {
  std_host.stderr("error: ${message}")
  1
}

pure driver_usage(): Str {
  "usage: panack coverage-run ARTIFACT.bc INVENTORY RAW [arguments...]\n       panack coverage-session DIRECTORY ARTIFACT INVENTORY [ARTIFACT INVENTORY ...] -- [arguments...]\n       panack coverage-aggregate --source SOURCE INVENTORY [--source SOURCE INVENTORY ...] --session DIRECTORY [--session DIRECTORY ...]\n       panack coverage-report SOURCE.panack --inventory FILE --coverage RAW\n       panack inventory SOURCE.panack -o FILE [--include SOURCE.panack]\n       panack inventory-check SOURCE.panack --inventory FILE [--include SOURCE.panack]\n       panack FILE | panack {check,compile,run,disasm} FILE\n       panack check --project panack.json\n       panack compile --project panack.json [-o FILE]\n       panack run --project panack.json [arguments...]\n       panack explain SOURCE.panack --function NAME [--type-at LINE COLUMN]\n       panack compile SOURCE.panack -o ARTIFACT.bc --source-map MAP\n       panack locate ARTIFACT.bc --source SOURCE.panack --source-map MAP --function NAME --instruction PC"
}

run_manifest_command(arguments: [Str]): Nat {
  if arguments.len() < 3 {
    report_driver_error("usage: check --project panack.json; compile --project panack.json [-o FILE]; run --project panack.json [arguments]")
  } else {
    command: Str = arguments[0]
    if command != "check" && command != "compile" && command != "run" {
      report_driver_error("--project is supported only with check, compile, and run")
    } else {
      manifest_path: Str = arguments[2]
      mut output: Str = ""
      mut program_arguments: [Str] = []
      mut valid_options: Bool = true
      if command == "compile" {
        if arguments.len() == 5 && arguments[3] == "-o" && arguments[4] != "" {
          output = arguments[4]
        } else {
          if arguments.len() != 3 {
            valid_options = false
          }
        }
      } else {
        if command == "check" {
          valid_options = arguments.len() == 3
        } else {
          mut index: Nat = 3
          while index < arguments.len() {
            program_arguments = program_arguments.append(arguments[index])
            index = index + 1
          }
        }
      }
      if !valid_options {
        report_driver_error("project command options are invalid; use compile --project panack.json [-o FILE], check --project panack.json, or run --project panack.json [arguments]")
      } else {
        run_manifest_source_command(command, manifest_path, output, program_arguments)
      }
    }
  }
}

pure without_final_newline(text: Str): Str {
  end: Nat = text.len()

  if end > 0 {
    last: Nat = end - 1
    if text[last] == "\n" {
      text.slice(0, last)
    } else {
      text
    }
  } else {
    text
  }
}

run_source_command(command: Str, path: Str, output: Str, program_arguments: [Str]): Nat {
  prepared: PreparedProject = prepare_project(path)

  if !prepared.valid {
    report_driver_error(prepared.message)
  } else {
    bytecode: BytecodeProgram = compile_program(prepared.program)
    if command == "check" {
      print("ok")
      0
    } else {
      if command == "compile" {
        destination: Str = if output.len() > 0 {
          output
        } else {
          path_support.with_suffix(path, ".bc")
        }
        if path_support.resolve(destination) == path_support.resolve(path) {
          report_driver_error("bytecode output cannot overwrite the source file")
        } else {
          filesystem_support.write_file_bytes(destination, serialize_bytecode(bytecode))
          print("wrote ${destination}")
          0
        }
      } else {
        if command == "disasm" {
          print(without_final_newline(render_bytecode(bytecode)))
          0
        } else {
          std_host.run(serialize_bytecode(bytecode), program_arguments)
          0
        }
      }
    }
  }
}

prepare_manifest_project(
  project: ManifestProject,
  entry_path: Str,
  loaded: LoadedProject
): PreparedProject {
  entry: Str = path_support.resolve(entry_path)
  root: Str = path_support.resolve(project.source_root)
  stdlib_root: Str = match std_environment.get("PANACKELTY_STDLIB_PATH") {
    Some(value) => path_support.resolve(value),
    None() => ""
  }
  identity: ModuleIdentity = driver_entry_identity(
    loaded,
    entry,
    source_package_module_identity(
      entry,
      root,
      stdlib_root,
      project.package,
      project.version
    )
  )
  match prepare_project_program_with_dependencies(
    loaded, root, stdlib_root, identity, true, project.root_identity, project.dependencies
  ) {
    Error(diagnostics) => PreparedProject(false, loaded.program, diagnostic_messages(diagnostics, loaded.sources)),
    Ok(program) => PreparedProject(true, program, "")
  }
}

run_manifest_source_command(
  command: Str,
  manifest_path: Str,
  output: Str,
  program_arguments: [Str]
): Nat {
  match read_manifest_project(manifest_path) {
    Error(message) => report_driver_error(message),
    Ok(project) => match project.entry {
      None() => if command == "check" {
        run_manifest_library_check(project)
      } else {
        report_driver_error("library manifests support check only; compile and run require an application entry")
      },
      Some(entry) => {
        loaded: LoadedProject = load_project_package(
          entry,
          project.source_root,
          project.package_root,
          project.root_identity,
          project.package,
          project.version,
          project.dependencies
        )
        prepared: PreparedProject = prepare_manifest_project(project, entry, loaded)
        if !prepared.valid {
          report_driver_error(prepared.message)
        } else {
          bytecode: BytecodeProgram = compile_program(prepared.program)
          if command == "check" {
            print("ok")
            0
          } else {
            if command == "compile" {
              destination: Str = if output.len() > 0 {
                output
              } else {
                path_support.with_suffix(entry, ".bc")
              }
              if path_support.resolve(destination) == path_support.resolve(entry) {
                report_driver_error("bytecode output cannot overwrite the source file")
              } else {
                filesystem_support.write_file_bytes(destination, serialize_bytecode(bytecode))
                print("wrote ${destination}")
                0
              }
            } else {
              std_host.run(serialize_bytecode(bytecode), program_arguments)
              0
            }
          }
        }
      }
    }
  }
}

run_manifest_library_check(project: ManifestProject): Nat {
  mut failures: Str = ""
  mut checked_exports: Set[Str] = set()
  for exported in project.exports {
    if !checked_exports.has(exported) {
      checked_exports = checked_exports.add(exported)
      loaded: LoadedProject = load_project_package_for_check(
        exported,
        project.source_root,
        project.package_root,
        project.root_identity,
        project.package,
        project.version,
        project.dependencies
      )
      prepared: PreparedProject = prepare_manifest_project(project, exported, loaded)
      if !prepared.valid {
        if failures.len() > 0 {
          failures = failures + "\n"
        }
        failures = failures + prepared.message
      }
    }
  }
  if failures.len() == 0 {
    print("ok")
    0
  } else {
    report_driver_error(failures)
  }
}

pure explanation_coordinate(text: Str): Option[Nat] {
  mut valid: Bool = text.len() > 0 && text.len() <= 10
  for index in 0..text.len() {
    if text[index] < "0" || text[index] > "9" {
      valid = false
    }
  }
  if valid {
    value: Nat = text.parse_nat()
    if value > 0 && value <= 4294967295 {
      Some(value)
    } else {
      None()
    }
  } else {
    None()
  }
}

run_explain_command(values: [Str]): Nat {
  usage: Str = "explain usage: explain SOURCE.panack --function NAME [--type-at LINE COLUMN]"
  has_type_position: Bool = values.len() == 7
  if values.len() != 4 && !has_type_position {
    report_driver_error(usage)
  } else {
    if path_support.suffix(values[1]) != ".panack" || values[2] != "--function" || values[3] == "" ||
      (has_type_position && values[4] != "--type-at") {
      report_driver_error(usage)
    } else {
      line: Option[Nat] = if has_type_position {
        explanation_coordinate(values[5])
      } else {
        None()
      }
      column: Option[Nat] = if has_type_position {
        explanation_coordinate(values[6])
      } else {
        None()
      }
      if has_type_position && (line == None() || column == None()) {
        report_driver_error(usage + "; line and column must be positive decimal numbers")
      } else {
        loaded: LoadedProject = load_project_explained(values[1])
        entry: Str = path_support.resolve(values[1])
        root: Str = driver_project_root(entry)
        stdlib_root: Str = match std_environment.get("PANACKELTY_STDLIB_PATH") {
          Some(value) => path_support.resolve(value),
          None() => ""
        }
        selected: Result[SourceMapFunctionSelector, Str] = explanation_function_selector(
          loaded,
          values[3],
          entry,
          root,
          stdlib_root
        )
        match selected {
          Error(message) => if message.starts_with_at("unknown function selector ", 0) {
            report_driver_error("explain: unknown function " + source_map_escape(values[3]))
          } else {
            report_driver_error("explain: " + message)
          },
          Ok(function) => {
            prepared: PreparedProject = prepare_loaded_project(entry, loaded)
            diagnostics: [Diagnostic] = tooling_diagnostics(loaded)
            valid: Bool = prepared.valid && diagnostics.len() == 0
            mut report: Str = render_function_explanations(
              loaded,
              function,
              valid,
              root,
              stdlib_root
            )
            if has_type_position {
              report = report + "\n\n" + render_expression_type_explanation(
                loaded,
                function,
                match line { Some(value) => value, None() => 1 },
                match column { Some(value) => value, None() => 1 },
                root,
                stdlib_root
              )
            }
            print(report)
            if valid {
              0
            } else {
              if diagnostics.len() > 0 {
                report_driver_error(diagnostic_messages(diagnostics, loaded.sources))
              } else {
                report_driver_error(prepared.message)
              }
            }
          }
        }
      }
    }
  }
}

run_artifact_command(command: Str, path: Str, program_arguments: [Str]): Nat {
  data: Bytes = filesystem_support.read_file_bytes(path)
  validation: Str = validate_bytecode(data)

  if validation != "ok" {
    report_driver_error(validation)
  } else {
    if command == "check" {
      print("ok")
      0
    } else {
      if command == "disasm" {
        print(without_final_newline(disassemble_bytecode(data)))
        0
      } else {
        std_host.run(data, program_arguments)
        0
      }
    }
  }
}

pure source_map_argument_present(arguments: [Str]): Bool {
  mut present: Bool = false

  for argument in arguments {
    if argument == "--source-map" {
      present = true
    }
  }
  present
}

pub record SourceMapArguments {
  valid: Bool,
  source: Str,
  artifact: Str,
  sidecar: Str,
  function_name: Str,
  instruction: Nat
}

pub pure source_map_instruction(text: Str): Option[Nat] {
  mut valid: Bool = text.len() > 0 && text.len() <= 10

  for index in 0..text.len() {
    if text[index] < "0" || text[index] > "9" {
      valid = false
    }
  }
  if valid {
    value: Nat = text.parse_nat()
    if value <= 4294967295 {
      Some(value)
    } else {
      None()
    }
  } else {
    None()
  }
}

pub pure source_map_arguments(values: [Str], locating: Bool): SourceMapArguments {
  mut source: Str = ""
  mut artifact: Str = ""
  mut sidecar: Str = ""
  mut function_name: Str = ""
  mut instruction: Option[Nat] = None()
  mut valid: Bool = values.len() >= 2

  if valid {
    if locating {
      artifact = values[1]
    } else {
      source = values[1]
    }
  }
  mut index: Nat = 2
  while index < values.len() && valid {
    if index + 1 >= values.len() {
      valid = false
    } else {
      option: Str = values[index]
      value: Str = values[index + 1]
      if option == "--source-map" && sidecar == "" {
        sidecar = value
      } else {
        if option == "-o" && !locating && artifact == "" {
          artifact = value
        } else {
          if option == "--source" && locating && source == "" {
            source = value
          } else {
            if option == "--function" && locating && function_name == "" {
              function_name = value
            } else {
              if option == "--instruction" && locating {
                match instruction {
                  Some(previous) => {
                    valid = false
                  },
                  None() => {
                    instruction = source_map_instruction(value)
                    match instruction {
                      Some(pc) => {},
                      None() => {
                        valid = false
                      }
                    }
                  }
                }
              } else {
                valid = false
              }
            }
          }
        }
      }
      if value == "" {
        valid = false
      }
      index = index + 2
    }
  }
  valid = valid && source != "" && artifact != "" && sidecar != "" &&
    path_support.suffix(source) == ".panack" && path_support.suffix(artifact) == ".bc"
  mut pc: Nat = 0
  if locating {
    valid = valid && function_name != ""
    match instruction {
      Some(value) => {
        pc = value
      },
      None() => {
        valid = false
      }
    }
  }
  SourceMapArguments(valid, source, artifact, sidecar, function_name, pc)
}

run_source_map_command(values: [Str], locating: Bool): Nat {
  args: SourceMapArguments = source_map_arguments(values, locating)

  if !args.valid {
    report_driver_error("source-map usage: compile SOURCE.panack -o ARTIFACT.bc --source-map MAP | locate ARTIFACT.bc --source SOURCE.panack --source-map MAP --function NAME --instruction PC")
  } else {
    entry: Str = path_support.resolve(args.source)
    artifact_path: Str = path_support.resolve(args.artifact)
    map_path: Str = path_support.resolve(args.sidecar)
    if !locating && (artifact_path == map_path ||
      !source_map_destination_available(artifact_path) ||
      !source_map_destination_available(map_path)) {
      report_driver_error("source-map compilation requires two distinct, nonexistent output files")
    } else {
      loaded: LoadedProject = load_project_for_source_map(entry)
      prepared: PreparedProject = prepare_loaded_project(entry, loaded)
      if !prepared.valid {
        if locating {
          print("source-map: unavailable")
          0
        } else {
          report_driver_error(prepared.message)
        }
      } else {
        root: Str = driver_project_root(entry)
        stdlib_root: Str = path_support.resolve(std_environment.get("PANACKELTY_STDLIB_PATH").value_or(""))
        mapped: SourceMappedProgram = compile_program_with_sources(prepared.program)
        artifact: Bytes = serialize_bytecode(mapped.bytecode)
        sidecar: Bytes = serialize_source_map(loaded, mapped, artifact, entry, root, stdlib_root)
        valid: Bool = sidecar.length() > 0 &&
          validate_bytecode(artifact) == "ok" &&
          source_snapshots_unchanged(loaded)
        if locating {
          selected: Result[SourceMapFunctionSelector, Str] = source_map_function_selector(
            loaded,
            args.function_name,
            entry,
            root,
            stdlib_root
          )
          match selected {
            Error(message) => if message.starts_with_at("unknown function selector ", 0) {
              print("source-map: unavailable")
              0
            } else {
              report_driver_error(message)
            },
            Ok(function) => if valid && source_map_matches(
            artifact_path,
            artifact
          ) && source_map_matches(map_path, sidecar) {
            print(source_map_location(
              loaded,
              mapped,
              function.emitted_name,
              function.display_name,
              args.instruction,
              root,
              stdlib_root
            ))
            0
          } else {
            print("source-map: unavailable");
            0
          }
          }
        } else {
          if !valid {
            report_driver_error("source-map limit exceeded, invalid artifact, or source changed during compilation")
          } else {
            if !source_map_destination_available(artifact_path) ||
              !source_map_destination_available(map_path) {
              report_driver_error("source-map output appeared during compilation")
            } else {
              // The first write can reveal directory-symlink or case aliases.
              if !source_map_write(artifact_path, artifact) ||
                !source_map_destination_available(map_path) || !source_map_write(
                map_path,
                sidecar
              ) ||
                !source_map_matches(
                artifact_path,
                artifact
              ) || !source_map_matches(map_path, sidecar) {
                report_driver_error("could not write source-map output pair; discard any partial output")
              } else {
                print("wrote " + args.artifact)
                print("wrote source map " + args.sidecar)
                0
              }
            }
          }
        }
      }
    }
  }
}

run_compiler_command(arguments: [Str]): Nat {
  mut values: [Str] = arguments

  if values.len() > 0 && values[0] == "--" {
    mut trimmed: [Str] = []
    mut cursor: Nat = 1
    while cursor < values.len() {
      trimmed = trimmed.append(values[cursor])
      cursor = cursor + 1
    }
    values = trimmed
  } else {}
  if values.len() == 0 || values[0] == "--help" {
    print(driver_usage())
    0
  } else {
    if values.len() > 1 && values[1] == "--project" {
      run_manifest_command(values)
    } else {
    if values[0] == "coverage-report" || values[0] == "coverage-aggregate" {
      if values[0] == "coverage-report" {
        run_coverage_report(values)
      } else {
        run_coverage_aggregate(values)
      }
    } else {
      if values[0] == "inventory" || values[0] == "inventory-check" {
        run_inventory_command(values, values[0] == "inventory-check")
      } else {
        if values[0] == "explain" {
          run_explain_command(values)
        } else {
          if values[0] == "locate" {
            run_source_map_command(values, true)
          } else {
            if values[0] == "compile" && source_map_argument_present(values) {
              run_source_map_command(values, false)
            } else {
              mut command: Str = values[0]
              mut file_index: Nat = 1
              if command != "check" &&
                command != "compile" &&
                command != "run" &&
                command != "disasm" {
                command = "run"
                file_index = 0
              } else {}
              if file_index >= values.len() {
                report_driver_error("missing input file")
              } else {
                path: Str = values[file_index]
                suffix: Str = path_support.suffix(path)
                mut output: Str = ""
                mut program_arguments: [Str] = []
                mut argument_index: Nat = file_index + 1
                while argument_index < values.len() {
                  program_arguments = program_arguments.append(values[argument_index])
                  argument_index = argument_index + 1
                }
                if command == "compile" &&
                  file_index + 2 < values.len() &&
                  values[file_index + 1] == "-o" {
                  output = values[file_index + 2]
                } else {}
                if command == "compile" && suffix != ".panack" {
                  report_driver_error("compile expects a .panack source file")
                } else {
                  if suffix != ".panack" && suffix != ".bc" {
                    report_driver_error("expected a .panack source or .bc bytecode file")
                  } else {
                    if suffix == ".panack" {
                      run_source_command(command, path, output, program_arguments)
                    } else {
                      if command == "compile" {
                        report_driver_error("compile expects a .panack source file")
                      } else {
                        run_artifact_command(command, path, program_arguments)
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
    }
  }
}

pub compiler_main(): Void {
  status: Nat = run_compiler_command(std_host.arguments())

  if status != 0 {
    std_host.exit(status);
  } else {}
}
