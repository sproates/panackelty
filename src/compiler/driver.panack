import "explanations.panack"
import "source_inventory.panack"

record PreparedProject {
  valid: Bool,
  program: Program,
  message: Str
}

pure diagnostic_messages(diagnostics: [Diagnostic], sources: Map[Str,Str]): Str {
  mut output: Str = ""
  mut first: Bool = true
  for diagnostic in diagnostics {
    if first { first = false; } else { output = output + "\n"; }
    output = output + diagnostic_with_source(diagnostic, sources)
  }
  output
}

prepare_project(path: Str): PreparedProject {
  loaded: LoadedProject = load_project(path)
  if len(loaded.diagnostics) == 0 {
    PreparedProject(true, loaded.program, "")
  } else {
    PreparedProject(false, loaded.program, diagnostic_messages(loaded.diagnostics, loaded.sources))
  }
}

report_driver_error(message: Str): Nat {
  eprint("error: ${message}")
  1
}

pure driver_usage(): Str {
  "usage: panack inventory SOURCE.panack -o FILE [--include SOURCE.panack]\n       panack inventory-check SOURCE.panack --inventory FILE [--include SOURCE.panack]\n       panack FILE | panack {check,compile,run,disasm} FILE\n       panack explain SOURCE.panack --function NAME\n       panack compile SOURCE.panack -o ARTIFACT.bc --source-map MAP\n       panack locate ARTIFACT.bc --source SOURCE.panack --source-map MAP --function NAME --instruction PC"
}

pure without_final_newline(text: Str): Str {
  end: Nat = len(text)
  if end > 0 {
    last: Nat = end - 1
    if text[last] == "\n" { slice(text, 0, last) } else { text }
  } else {
    text
  }
}

run_source_command(command: Str, path: Str, output: Str, program_arguments: [Str]): Nat {
  prepared: PreparedProject = prepare_project(path)
  if !prepared.valid {
    report_driver_error(prepared.message)
  } else {
    if command == "check" {
      print("ok")
      0
    } else {
      bytecode: BytecodeProgram = compile_program(prepared.program)
      if command == "compile" {
        destination: Str = if len(output) > 0 { output } else { path_with_suffix(path, ".bc") }
        if path_resolve(destination) == path_resolve(path) {
          report_driver_error("bytecode output cannot overwrite the source file")
        } else {
          write_bytes(destination, serialize_bytecode(bytecode))
          print("wrote ${destination}")
          0
        }
      } else {
        if command == "disasm" {
          print(without_final_newline(render_bytecode(bytecode)))
          0
        } else {
          run_bytecode_args(serialize_bytecode(bytecode), program_arguments)
          0
        }
      }
    }
  }
}

run_explain_command(values: [Str]): Nat {
  if len(values) != 4 {
    report_driver_error("explain usage: explain SOURCE.panack --function NAME")
  } else {
    if path_suffix(values[1]) != ".panack" || values[2] != "--function" || values[3] == "" {
      report_driver_error("explain usage: explain SOURCE.panack --function NAME")
    } else {
      loaded: LoadedProject = load_project_explained(values[1])
      name: Str = values[3]
      valid: Bool = len(loaded.diagnostics) == 0
      if !function_type(loaded.program, name).found && valid {
        report_driver_error("explain: unknown function " + source_map_escape(name))
      } else {
        stdlib_root: Str = if environment_has("PANACKELTY_STDLIB_PATH") {
          path_resolve(environment_get("PANACKELTY_STDLIB_PATH"))
        } else { "" }
        print(render_function_explanations(loaded, name, path_parent(path_resolve(values[1])), stdlib_root))
        if valid { 0 } else { report_driver_error(diagnostic_messages(loaded.diagnostics, loaded.sources)) }
      }
    }
  }
}

run_artifact_command(command: Str, path: Str, program_arguments: [Str]): Nat {
  data: Bytes = read_bytes(path)
  validation: Str = validate_bytecode(data)
  if validation != "ok" {
    report_driver_error(validation)
  } else {
    if command == "check" {
      print("ok")
      0
    } else {
      if command == "disasm" {
        print(without_final_newline(disassemble_bytecode(data)))
        0
      } else {
        run_bytecode_args(data, program_arguments)
        0
      }
    }
  }
}

pure source_map_argument_present(arguments: [Str]): Bool {
  mut present: Bool = false
  for argument in arguments { if argument == "--source-map" { present = true; } }
  present
}

record SourceMapArguments {
  valid: Bool,
  source: Str,
  artifact: Str,
  sidecar: Str,
  function_name: Str,
  instruction: Nat
}

pure source_map_instruction(text: Str): Option[Nat] {
  mut valid: Bool = len(text) > 0 && len(text) <= 10
  for index in 0..len(text) {
    if text[index] < "0" || text[index] > "9" { valid = false; }
  }
  if valid {
    value: Nat = nat_from_str(text)
    if value <= 4294967295 { Some(value) } else { None() }
  } else { None() }
}

pure source_map_arguments(values: [Str], locating: Bool): SourceMapArguments {
  mut source: Str = ""
  mut artifact: Str = ""
  mut sidecar: Str = ""
  mut function_name: Str = ""
  mut instruction: Option[Nat] = None()
  mut valid: Bool = len(values) >= 2
  if valid {
    if locating { artifact = values[1]; } else { source = values[1]; }
  }
  mut index: Nat = 2
  while index < len(values) && valid {
    if index + 1 >= len(values) { valid = false; }
    else {
      option: Str = values[index]
      value: Str = values[index + 1]
      if option == "--source-map" && sidecar == "" { sidecar = value; }
      else { if option == "-o" && !locating && artifact == "" { artifact = value; }
      else { if option == "--source" && locating && source == "" { source = value; }
      else { if option == "--function" && locating && function_name == "" { function_name = value; }
      else { if option == "--instruction" && locating {
        match instruction {
          Some(previous) => { valid = false; },
          None() => {
            instruction = source_map_instruction(value)
            match instruction { Some(pc) => {}, None() => { valid = false; } }
          }
        }
      } else { valid = false; } } } } }
      if value == "" { valid = false; }
      index = index + 2
    }
  }
  valid = valid && source != "" && artifact != "" && sidecar != "" &&
    path_suffix(source) == ".panack" && path_suffix(artifact) == ".bc"
  mut pc: Nat = 0
  if locating {
    valid = valid && function_name != ""
    match instruction { Some(value) => { pc = value; }, None() => { valid = false; } }
  }
  SourceMapArguments(valid, source, artifact, sidecar, function_name, pc)
}

run_source_map_command(values: [Str], locating: Bool): Nat {
  args: SourceMapArguments = source_map_arguments(values, locating)
  if !args.valid {
    report_driver_error("source-map usage: compile SOURCE.panack -o ARTIFACT.bc --source-map MAP | locate ARTIFACT.bc --source SOURCE.panack --source-map MAP --function NAME --instruction PC")
  } else {
    entry: Str = path_resolve(args.source)
    artifact_path: Str = path_resolve(args.artifact)
    map_path: Str = path_resolve(args.sidecar)
    if !locating && (artifact_path == map_path ||
        !source_map_destination_available(artifact_path) || !source_map_destination_available(map_path)) {
      report_driver_error("source-map compilation requires two distinct, nonexistent output files")
    } else {
      loaded: LoadedProject = load_project_for_source_map(entry)
      if len(loaded.diagnostics) > 0 {
        if locating { print("source-map: unavailable"); 0 }
        else { report_driver_error(diagnostic_messages(loaded.diagnostics, loaded.sources)) }
      } else {
        root: Str = path_parent(entry)
        stdlib_root: Str = path_resolve(environment_get("PANACKELTY_STDLIB_PATH"))
        mapped: SourceMappedProgram = compile_program_with_sources(loaded.program)
        artifact: Bytes = serialize_bytecode(mapped.bytecode)
        sidecar: Bytes = serialize_source_map(loaded, mapped, artifact, entry, root, stdlib_root)
        valid: Bool = byte_len(sidecar) > 0 && validate_bytecode(artifact) == "ok" && source_snapshots_unchanged(loaded)
        if locating {
          if valid && source_map_matches(artifact_path, artifact) && source_map_matches(map_path, sidecar) {
            print(source_map_location(loaded, mapped, args.function_name, args.instruction, root, stdlib_root))
          } else { print("source-map: unavailable"); }
          0
        } else {
          if !valid { report_driver_error("source-map limit exceeded, invalid artifact, or source changed during compilation") }
          else {
            if !source_map_destination_available(artifact_path) || !source_map_destination_available(map_path) {
              report_driver_error("source-map output appeared during compilation")
            } else {
              // The first write can reveal directory-symlink or case aliases.
              if !source_map_write(artifact_path, artifact) ||
                  !source_map_destination_available(map_path) || !source_map_write(map_path, sidecar) ||
                  !source_map_matches(artifact_path, artifact) || !source_map_matches(map_path, sidecar) {
                report_driver_error("could not write source-map output pair; discard any partial output")
              } else {
                print("wrote " + args.artifact)
                print("wrote source map " + args.sidecar)
                0
              }
            }
          }
        }
      }
    }
  }
}

run_compiler_command(arguments: [Str]): Nat {
  mut values: [Str] = arguments
  if len(values) > 0 && values[0] == "--" {
    mut trimmed: [Str] = []
    mut cursor: Nat = 1
    while cursor < len(values) {
      trimmed = append(trimmed, values[cursor])
      cursor = cursor + 1
    }
    values = trimmed
  } else {}
  if len(values) == 0 || values[0] == "--help" {
    print(driver_usage())
    0
  } else {
    if values[0] == "inventory" || values[0] == "inventory-check" {
      run_inventory_command(values, values[0] == "inventory-check")
    } else {
      if values[0] == "explain" {
        run_explain_command(values)
      } else {
        if values[0] == "locate" {
          run_source_map_command(values, true)
        } else {
          if values[0] == "compile" && source_map_argument_present(values) {
            run_source_map_command(values, false)
          } else {
            mut command: Str = values[0]
            mut file_index: Nat = 1
            if command != "check" && command != "compile" && command != "run" && command != "disasm" {
              command = "run"
              file_index = 0
            } else {}
            if file_index >= len(values) {
              report_driver_error("missing input file")
            } else {
              path: Str = values[file_index]
              suffix: Str = path_suffix(path)
              mut output: Str = ""
              mut program_arguments: [Str] = []
              mut argument_index: Nat = file_index + 1
              while argument_index < len(values) {
                program_arguments = append(program_arguments, values[argument_index])
                argument_index = argument_index + 1
              }
              if command == "compile" && file_index + 2 < len(values) && values[file_index + 1] == "-o" {
                output = values[file_index + 2]
              } else {}
              if command == "compile" && suffix != ".panack" {
                report_driver_error("compile expects a .panack source file")
              } else {
                if suffix != ".panack" && suffix != ".bc" {
                  report_driver_error("expected a .panack source or .bc bytecode file")
                } else {
                  if suffix == ".panack" {
                    run_source_command(command, path, output, program_arguments)
                  } else {
                    if command == "compile" { report_driver_error("compile expects a .panack source file") }
                    else { run_artifact_command(command, path, program_arguments) }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

compiler_main(): Void {
  status: Nat = run_compiler_command(command_args())
  if status != 0 { process_exit(status); } else {}
}
