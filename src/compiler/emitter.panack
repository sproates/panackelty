import project/src/compiler/purity::{check_program_frontend}
pub import project/src/compiler/parser::{Expr, Program}
pub import project/src/compiler/types::{SourceSpan}
import project/src/compiler/parser::{
  Expr.ArrayExpr, Expr.BinaryExpr, Expr.BlockExpr, Expr.BoolExpr,
  Expr.CallExpr, Expr.DecimalExpr, Expr.DotCallExpr, Expr.OwnedCallExpr, Expr.FieldExpr, Expr.FunctionExpr,
  Expr.IfExpr, Expr.IndexExpr, Expr.LocatedExpr, Expr.MatchExpr, Expr.NameExpr,
  Expr.NatExpr, Expr.StringExpr, Expr.UnaryExpr,
  Statement, Statement.AssignmentStatement, Statement.BindingStatement,
  Statement.ExpressionStatement, Statement.ForStatement, Statement.WhileStatement,
  Block, BlockValue, BlockValue.NoBlockValue, BlockValue.TailBlockValue,
  Diagnostic, EnumVariant, FunctionParameter, MatchArm, MatchPattern,
  RecordField, TopLevel, TopLevel.EnumDeclaration,
  TopLevel.FunctionDeclaration, TopLevel.ImportDeclaration, TopLevel.RecordDeclaration,
  TopLevel.TypeDeclaration,
  expression_span, lex, parse_program_complete
}
import project/src/compiler/expression_contracts::{decode_string_literal, split_interpolated_string, InterpolatedString}
import project/src/compiler/resolver::{render_resolver_diagnostics}
import project/src/compiler/lexer::{prior_index}
import project/src/compiler/checker::{RecordLookup, VariantLookup, record_type, variant_type}

// Lower checked syntax to deterministic instructions. Temporary names and jump
// offsets are local to each function; source attribution is explicitly optional.

pub enum ConstantValue {
  NatConstant(Nat),
  IntConstant(Bool, Nat),
  DecimalConstant(Str),
  DecimalPartsConstant(Bool, [Nat], Bool, Nat),
  StringConstant(Str),
  BoolConstant(Bool),
  VoidConstant
}

pub enum Instruction {
  ConstInstruction(ConstantValue),
  LoadInstruction(Str),
  StoreInstruction(Str),
  PopInstruction,
  UnaryInstruction(Str),
  BinaryInstruction(Str),
  MakeRangeInstruction,
  MakeArrayInstruction(Nat),
  IndexGetInstruction,
  InterpolateInstruction([Str]),
  IterInitInstruction(Str),
  IterNextInstruction(Str, Str, Nat),
  MakeRecordInstruction(Str, [Str]),
  FieldGetInstruction(Str),
  MakeVariantInstruction(Str, Str, Nat),
  MatchVariantInstruction(Str, Nat),
  MatchFailInstruction,
  CallInstruction(Str, Nat),
  CallValueInstruction(Nat),
  AwaitCallInstruction(Str, Nat),
  AwaitValueInstruction(Nat),
  JumpFalseInstruction(Nat),
  JumpInstruction(Nat),
  PendingEndJumpInstruction,
  ReturnInstruction
}

pub record FunctionCode {
  name: Str,
  parameters: [Str],
  is_pure: Bool,
  is_async: Bool,
  instructions: [Instruction]
}

pub record BytecodeProgram {
  functions: [FunctionCode]
}

pub record EmittedCode {
  instructions: [Instruction],
  next_temporary: Nat,
  sources: [InstructionSource],
  probes: [EmissionProbe]
}

// Sparse, function-local instruction indices; an absent entry means unavailable.
// Lowered entries associate compiler-generated machinery with its source construct,
// rather than claiming a one-to-one source operation. This is an internal contract.
pub record EmissionProbe {
  kind: Str,
  span: SourceSpan,
  start: Nat,
  end: Nat
}

pub record FunctionProbes {
  name: Str,
  entries: [EmissionProbe]
}

pure add_emission_probe(
  probes: [EmissionProbe],
  kind: Str,
  expression: Expr,
  start: Nat,
  end: Nat,
  enabled: Bool
): [EmissionProbe] {
  if enabled {
    match expression_span(expression) {
      Some(span) => probes->append(EmissionProbe(kind, span, start, end)),
      None() => probes
    }
  } else {
    probes
  }
}

pub record InstructionSource {
  index: Nat,
  span: SourceSpan,
  lowered: Bool
}

pub record FunctionSources {
  name: Str,
  entries: [InstructionSource]
}

pub record SourceMappedProgram {
  bytecode: BytecodeProgram,
  sources: [FunctionSources],
  probes: [FunctionProbes]
}

pure add_instruction_source(
  sources: [InstructionSource],
  origin: Option[SourceSpan],
  index: Nat,
  lowered: Bool
): [InstructionSource] {
  match origin {
    None() => sources,
    Some(span) => sources->append(InstructionSource(index, span, lowered))
  }
}

pure parameter_name(parameter: FunctionParameter): Str {
  parameter.name
}

pure parameter_names(parameters: [FunctionParameter]): [Str] {
  parameters->map(@parameter_name)
}

pure record_field_name(field: RecordField): Str {
  field.name
}

pure record_field_names(fields: [RecordField]): [Str] {
  fields->map(@record_field_name)
}

pure resolve_pending_jumps(instructions: [Instruction], target: Nat): [Instruction] {
  mut result: [Instruction] = []

  for instruction in instructions {
    match instruction {
      PendingEndJumpInstruction() => {
        result = result->append(JumpInstruction(target))
      },
      ConstInstruction(value) => {
        result = result->append(instruction)
      },
      LoadInstruction(name) => {
        result = result->append(instruction)
      },
      StoreInstruction(name) => {
        result = result->append(instruction)
      },
      PopInstruction() => {
        result = result->append(instruction)
      },
      UnaryInstruction(operator) => {
        result = result->append(instruction)
      },
      BinaryInstruction(operator) => {
        result = result->append(instruction)
      },
      MakeRangeInstruction() => {
        result = result->append(instruction)
      },
      MakeArrayInstruction(count) => {
        result = result->append(instruction)
      },
      IndexGetInstruction() => {
        result = result->append(instruction)
      },
      InterpolateInstruction(parts) => {
        result = result->append(instruction)
      },
      IterInitInstruction(name) => {
        result = result->append(instruction)
      },
      IterNextInstruction(iterator, name, end) => {
        result = result->append(instruction)
      },
      MakeRecordInstruction(name, fields) => {
        result = result->append(instruction)
      },
      FieldGetInstruction(name) => {
        result = result->append(instruction)
      },
      MakeVariantInstruction(enum_name, variant, count) => {
        result = result->append(instruction)
      },
      MatchVariantInstruction(variant, failure) => {
        result = result->append(instruction)
      },
      MatchFailInstruction() => {
        result = result->append(instruction)
      },
      CallInstruction(name, arity) => {
        result = result->append(instruction)
      },
      CallValueInstruction(arity) => {
        result = result->append(instruction)
      },
      AwaitCallInstruction(name, arity) => {
        result = result->append(instruction)
      },
      AwaitValueInstruction(arity) => {
        result = result->append(instruction)
      },
      JumpFalseInstruction(jump_target) => {
        result = result->append(instruction)
      },
      JumpInstruction(jump_target) => {
        result = result->append(instruction)
      },
      ReturnInstruction() => {
        result = result->append(instruction)
      }
    }
  }

  result
}

pure render_string_items(items: [Str]): Str {
  mut output: Str = ""
  mut first: Bool = true

  for item in items {
    if first {
      first = false
    } else {
      output = output + ","
    }
    output = output + item
  }

  output
}

pure render_constant(value: ConstantValue): Str {
  match value {
    NatConstant(number) => "Nat:${number}",
    IntConstant(negative, magnitude) => {
      if negative {
        "Int:-${magnitude}"
      } else {
        "Int:${magnitude}"
      }
    },
    DecimalConstant(text) => "Dec:${text}",
    DecimalPartsConstant(negative, digits, exponent_negative, exponent_magnitude) => {
      sign: Str = if negative {
        "-"
      } else {
        ""
      }
      exponent_sign: Str = if exponent_negative {
        "-"
      } else {
        "+"
      }
      digits_text: Str = ""
      mut rendered_digits: Str = digits_text
      for digit in digits {
        rendered_digits = rendered_digits + "${digit}"
      }
      "DecParts:${sign}${rendered_digits}e${exponent_sign}${exponent_magnitude}"
    },
    StringConstant(text) => "Str:${text}",
    BoolConstant(flag) => if flag {
      "Bool:true"
    } else {
      "Bool:false"
    },
    VoidConstant() => "Void"
  }
}

pub pure render_instruction(instruction: Instruction): Str {
  match instruction {
    ConstInstruction(value) => {
      value_text: Str = render_constant(value)
      "CONST|${value_text}"
    },
    LoadInstruction(name) => "LOAD|${name}",
    StoreInstruction(name) => "STORE|${name}",
    PopInstruction() => "POP",
    UnaryInstruction(operator) => "UNARY|${operator}",
    BinaryInstruction(operator) => "BINARY|${operator}",
    MakeRangeInstruction() => "MAKE_RANGE",
    MakeArrayInstruction(count) => "MAKE_ARRAY|${count}",
    IndexGetInstruction() => "INDEX_GET",
    InterpolateInstruction(parts) => {
      parts_text: Str = render_string_items(parts)
      "INTERPOLATE|${parts_text}"
    },
    IterInitInstruction(name) => "ITER_INIT|${name}",
    IterNextInstruction(iterator, name, end) => "ITER_NEXT|${iterator}|${name}|${end}",
    MakeRecordInstruction(name, fields) => {
      fields_text: Str = render_string_items(fields)
      "MAKE_RECORD|${name}|${fields_text}"
    },
    FieldGetInstruction(name) => "FIELD_GET|${name}",
    MakeVariantInstruction(enum_name, variant, count) => "MAKE_VARIANT|${enum_name}|${variant}|${count}",
    MatchVariantInstruction(variant, failure) => "MATCH_VARIANT|${variant}|${failure}",
    MatchFailInstruction() => "MATCH_FAIL",
    CallInstruction(name, arity) => "CALL|${name}|${arity}",
    CallValueInstruction(arity) => "CALL_VALUE|${arity}",
    AwaitCallInstruction(name, arity) => "AWAIT_CALL|${name}|${arity}",
    AwaitValueInstruction(arity) => "AWAIT_VALUE|${arity}",
    JumpFalseInstruction(target) => "JUMP_FALSE|${target}",
    JumpInstruction(target) => "JUMP|${target}",
    PendingEndJumpInstruction() => "PENDING_END_JUMP",
    ReturnInstruction() => "RETURN"
  }
}

pub pure render_bytecode(program: BytecodeProgram): Str {
  mut output: Str = ""

  for function in program.functions {
    purity: Str = if function.is_async {
      "async"
    } else {
      if function.is_pure {
        "pure"
      } else {
        "impure"
      }
    }
    function_name: Str = function.name
    parameters_text: Str = render_string_items(function.parameters)
    output = output + "FUNCTION|${function_name}|${purity}|${parameters_text}\n"
    mut index: Nat = 0
    for instruction in function.instructions {
      instruction_text: Str = render_instruction(instruction)
      output = output + "${index}|${instruction_text}\n"
      index = index + 1
    }
  }

  output
}

pure emit_expression_list(
  expressions: [Expr],
  program: Program,
  next_temporary: Nat,
  offset: Nat,
  retain_sources: Bool
): EmittedCode {
  mut sources: [InstructionSource] = []
  mut probes: [EmissionProbe] = []
  mut instructions: [Instruction] = []
  mut temporary: Nat = next_temporary

  for expression in expressions {
    emitted: EmittedCode = emit_expression(
      expression,
      program,
      temporary,
      offset + instructions->len(),
      retain_sources
    )
    sources = sources->concat(emitted.sources)
    probes = probes->concat(emitted.probes)
    instructions = instructions->concat(emitted.instructions)
    temporary = emitted.next_temporary
  }
  EmittedCode(instructions, temporary, sources, probes)
}

pure emit_block(
  block: Block,
  program: Program,
  next_temporary: Nat,
  offset: Nat,
  retain_sources: Bool
): EmittedCode {
  mut sources: [InstructionSource] = []
  mut probes: [EmissionProbe] = []
  mut instructions: [Instruction] = []
  mut temporary: Nat = next_temporary

  for statement in block.statements {
    statement_offset: Nat = offset + instructions->len()
    match statement {
      BindingStatement(name, type_name, annotation_span, mutable, value) => {
        emitted: EmittedCode = emit_expression(
          value,
          program,
          temporary,
          statement_offset,
          retain_sources
        )
        sources = sources->concat(emitted.sources)
        probes = probes->concat(emitted.probes)
        instructions = instructions->concat(emitted.instructions)
        instructions = instructions->append(StoreInstruction(name))
        temporary = emitted.next_temporary
      },
      AssignmentStatement(name, value) => {
        emitted: EmittedCode = emit_expression(
          value,
          program,
          temporary,
          statement_offset,
          retain_sources
        )
        sources = sources->concat(emitted.sources)
        probes = probes->concat(emitted.probes)
        instructions = instructions->concat(emitted.instructions)
        instructions = instructions->append(StoreInstruction(name))
        temporary = emitted.next_temporary
      },
      ExpressionStatement(value) => {
        emitted: EmittedCode = emit_expression(
          value,
          program,
          temporary,
          statement_offset,
          retain_sources
        )
        sources = sources->concat(emitted.sources)
        probes = probes->concat(emitted.probes)
        instructions = instructions->concat(emitted.instructions)
        instructions = instructions->append(PopInstruction())
        temporary = emitted.next_temporary
      },
      WhileStatement(condition, body) => {
        condition_code: EmittedCode = emit_expression(
          condition,
          program,
          temporary,
          statement_offset,
          retain_sources
        )
        jump_index: Nat = statement_offset + condition_code.instructions->len()
        body_code: EmittedCode = emit_block(
          body,
          program,
          condition_code.next_temporary,
          jump_index + 1,
          retain_sources
        )
        end: Nat = jump_index + 1 + body_code.instructions->len() + 2
        sources = sources->concat(condition_code.sources)
        probes = probes->concat(condition_code.probes)
        instructions = instructions->concat(condition_code.instructions)
        probes = add_emission_probe(
          probes,
          "while",
          condition,
          jump_index,
          jump_index + 1,
          retain_sources
        )
        instructions = instructions->append(JumpFalseInstruction(end))
        sources = sources->concat(body_code.sources)
        probes = probes->concat(body_code.probes)
        instructions = instructions->concat(body_code.instructions)
        instructions = instructions->append(PopInstruction())
        instructions = instructions->append(JumpInstruction(statement_offset))
        temporary = body_code.next_temporary
      },
      ForStatement(name, iterable, body) => {
        iterator: Str = "$iter${temporary}"
        iterable_code: EmittedCode = emit_expression(
          iterable,
          program,
          temporary + 1,
          statement_offset,
          retain_sources
        )
        iter_init_index: Nat = statement_offset + iterable_code.instructions->len()
        loop_start: Nat = iter_init_index + 1
        body_start: Nat = loop_start + 1
        body_code: EmittedCode = emit_block(
          body,
          program,
          iterable_code.next_temporary,
          body_start,
          retain_sources
        )
        end: Nat = body_start + body_code.instructions->len() + 2
        sources = sources->concat(iterable_code.sources)
        probes = probes->concat(iterable_code.probes)
        instructions = instructions->concat(iterable_code.instructions)
        instructions = instructions->append(IterInitInstruction(iterator))
        probes = add_emission_probe(
          probes,
          "for",
          iterable,
          loop_start,
          loop_start + 1,
          retain_sources
        )
        instructions = instructions->append(IterNextInstruction(iterator, name, end))
        sources = sources->concat(body_code.sources)
        probes = probes->concat(body_code.probes)
        instructions = instructions->concat(body_code.instructions)
        instructions = instructions->append(PopInstruction())
        instructions = instructions->append(JumpInstruction(loop_start))
        temporary = body_code.next_temporary
      }
    }
  }
  match block.value {
    NoBlockValue() => {
      instructions = instructions->append(ConstInstruction(VoidConstant()))
    },
    TailBlockValue(value) => {
      emitted: EmittedCode = emit_expression(
        value,
        program,
        temporary,
        offset + instructions->len(),
        retain_sources
      )
      sources = sources->concat(emitted.sources)
      probes = probes->concat(emitted.probes)
      instructions = instructions->concat(emitted.instructions)
      temporary = emitted.next_temporary
    }
  }
  EmittedCode(instructions, temporary, sources, probes)
}

pure emit_short_circuit(
  operator: Str,
  left: Expr,
  right: Expr,
  program: Program,
  next_temporary: Nat,
  offset: Nat,
  retain_sources: Bool,
  origin: Option[SourceSpan]
): EmittedCode {
  mut sources: [InstructionSource] = []
  mut probes: [EmissionProbe] = []
  left_code: EmittedCode = emit_expression(left, program, next_temporary, offset, retain_sources)
  branch: Nat = offset + left_code.instructions->len()

  if operator == "&&" {
    right_code: EmittedCode = emit_expression(
      right,
      program,
      left_code.next_temporary,
      branch + 1,
      retain_sources
    )
    false_target: Nat = branch + 1 + right_code.instructions->len() + 1
    end: Nat = false_target + 1
    sources = left_code.sources
    probes = left_code.probes
    mut instructions: [Instruction] = left_code.instructions
    if retain_sources {
      sources = add_instruction_source(sources, origin, offset + instructions->len(), true)
    }
    instructions = instructions->append(JumpFalseInstruction(false_target))
    sources = sources->concat(right_code.sources)
    probes = probes->concat(right_code.probes)
    instructions = instructions->concat(right_code.instructions)
    if retain_sources {
      sources = add_instruction_source(sources, origin, offset + instructions->len(), true)
    }
    instructions = instructions->append(JumpInstruction(end))
    if retain_sources {
      sources = add_instruction_source(sources, origin, offset + instructions->len(), true)
    }
    instructions = instructions->append(ConstInstruction(BoolConstant(false)))
    probes = add_emission_probe(probes, operator, left, branch, branch + 1, retain_sources)
    EmittedCode(instructions, right_code.next_temporary, sources, probes)
  } else {
    true_index: Nat = branch + 1
    right_target: Nat = true_index + 2
    right_code: EmittedCode = emit_expression(
      right,
      program,
      left_code.next_temporary,
      right_target,
      retain_sources
    )
    end: Nat = right_target + right_code.instructions->len()
    sources = left_code.sources
    probes = left_code.probes
    mut instructions: [Instruction] = left_code.instructions
    if retain_sources {
      sources = add_instruction_source(sources, origin, offset + instructions->len(), true)
    }
    instructions = instructions->append(JumpFalseInstruction(right_target))
    if retain_sources {
      sources = add_instruction_source(sources, origin, offset + instructions->len(), true)
    }
    instructions = instructions->append(ConstInstruction(BoolConstant(true)))
    if retain_sources {
      sources = add_instruction_source(sources, origin, offset + instructions->len(), true)
    }
    instructions = instructions->append(JumpInstruction(end))
    sources = sources->concat(right_code.sources)
    probes = probes->concat(right_code.probes)
    instructions = instructions->concat(right_code.instructions)
    probes = add_emission_probe(probes, operator, left, branch, branch + 1, retain_sources)
    EmittedCode(instructions, right_code.next_temporary, sources, probes)
  }
}

pure emit_string_expression(
  token_text: Str,
  next_temporary: Nat,
  retain_sources: Bool,
  origin: Option[SourceSpan],
  offset: Nat
): EmittedCode {
  mut sources: [InstructionSource] = []
  mut probes: [EmissionProbe] = []
  text: Str = decode_string_literal(token_text)
  interpolation: InterpolatedString = split_interpolated_string(text)
  mut instructions: [Instruction] = []

  if interpolation.variables->len() == 0 {
    if retain_sources {
      sources = add_instruction_source(sources, origin, offset + instructions->len(), false)
    }
    instructions = instructions->append(ConstInstruction(StringConstant(text)))
  } else {
    for variable in interpolation.variables {
      if retain_sources {
        sources = add_instruction_source(sources, origin, offset + instructions->len(), true)
      }
      instructions = instructions->append(LoadInstruction(variable))
    }
    if retain_sources {
      sources = add_instruction_source(sources, origin, offset + instructions->len(), false)
    }
    instructions = instructions->append(InterpolateInstruction(interpolation.parts))
  }
  EmittedCode(instructions, next_temporary, sources, probes)
}

pure emit_call(
  name: Str,
  arguments: [Expr],
  program: Program,
  next_temporary: Nat,
  offset: Nat,
  retain_sources: Bool,
  origin: Option[SourceSpan]
): EmittedCode {
  mut sources: [InstructionSource] = []
  mut probes: [EmissionProbe] = []

  if name == "$intrinsic_call" {
    emitted: EmittedCode = emit_expression_list(
      arguments,
      program,
      next_temporary,
      offset,
      retain_sources
    )
    EmittedCode(
      emitted.instructions->append(CallValueInstruction(prior_index(arguments->len()))),
      emitted.next_temporary,
      if retain_sources {
        add_instruction_source(emitted.sources, origin, offset + emitted.instructions->len(), false)
      } else {
        []
      }, emitted.probes)
  } else {
    if name == "$intrinsic_map" || name == "$intrinsic_reduce" {
      collection_name: Str = "$collection${next_temporary}"
      callback_name: Str = "$callback${next_temporary}"
      item_name: Str = "$item${next_temporary}"
      iterator_name: Str = "$iterator${next_temporary}"
      accumulator_name: Str = "$accumulator${next_temporary}"
      collection: EmittedCode = emit_expression(
        arguments[0],
        program,
        next_temporary + 1,
        offset,
        retain_sources
      )
      sources = collection.sources
      probes = collection.probes
      if retain_sources {
        sources = add_instruction_source(
          sources,
          origin,
          offset + collection.instructions->len(),
          true
        )
      }
      mut instructions: [Instruction] = collection.instructions->append(
        StoreInstruction(collection_name)
      )
      mut temporary: Nat = collection.next_temporary
      if name == "$intrinsic_reduce" {
        initial: EmittedCode = emit_expression(
          arguments[1],
          program,
          temporary,
          offset + instructions->len(),
          retain_sources
        )
        sources = sources->concat(initial.sources)
        probes = probes->concat(initial.probes)
        instructions = instructions->concat(initial.instructions)
        if retain_sources {
          sources = add_instruction_source(sources, origin, offset + instructions->len(), true)
        }
        instructions = instructions->append(StoreInstruction(accumulator_name))
        temporary = initial.next_temporary
      } else {
        if retain_sources {
          sources = add_instruction_source(sources, origin, offset + instructions->len(), true)
        }
        instructions = instructions->append(MakeArrayInstruction(0))
        if retain_sources {
          sources = add_instruction_source(sources, origin, offset + instructions->len(), true)
        }
        instructions = instructions->append(StoreInstruction(accumulator_name))
      }
      callback: EmittedCode = emit_expression(
        arguments[prior_index(arguments->len())],
        program,
        temporary,
        offset + instructions->len(),
        retain_sources
      )
      sources = sources->concat(callback.sources)
      probes = probes->concat(callback.probes)
      instructions = instructions->concat(callback.instructions)
      if retain_sources {
        sources = add_instruction_source(sources, origin, offset + instructions->len(), true)
      }
      instructions = instructions->append(StoreInstruction(callback_name))
      if retain_sources {
        sources = add_instruction_source(sources, origin, offset + instructions->len(), true)
      }
      instructions = instructions->append(LoadInstruction(collection_name))
      if retain_sources {
        sources = add_instruction_source(sources, origin, offset + instructions->len(), true)
      }
      instructions = instructions->append(IterInitInstruction(iterator_name))
      loop_start: Nat = offset + instructions->len()
      next_index: Nat = instructions->len()
      if retain_sources {
        sources = add_instruction_source(sources, origin, offset + instructions->len(), true)
      }
      instructions = instructions->append(IterNextInstruction(iterator_name, item_name, 0))
      if name == "$intrinsic_map" {
        if retain_sources {
          sources = add_instruction_source(sources, origin, offset + instructions->len(), true)
        }
        instructions = instructions->append(LoadInstruction(accumulator_name))
        if retain_sources {
          sources = add_instruction_source(sources, origin, offset + instructions->len(), true)
        }
        instructions = instructions->append(LoadInstruction(callback_name))
        if retain_sources {
          sources = add_instruction_source(sources, origin, offset + instructions->len(), true)
        }
        instructions = instructions->append(LoadInstruction(item_name))
        if retain_sources {
          sources = add_instruction_source(sources, origin, offset + instructions->len(), true)
        }
        instructions = instructions->append(CallValueInstruction(1))
        if retain_sources {
          sources = add_instruction_source(sources, origin, offset + instructions->len(), true)
        }
        instructions = instructions->append(CallInstruction("append", 2))
        if retain_sources {
          sources = add_instruction_source(sources, origin, offset + instructions->len(), true)
        }
        instructions = instructions->append(StoreInstruction(accumulator_name))
      } else {
        if retain_sources {
          sources = add_instruction_source(sources, origin, offset + instructions->len(), true)
        }
        instructions = instructions->append(LoadInstruction(callback_name))
        if retain_sources {
          sources = add_instruction_source(sources, origin, offset + instructions->len(), true)
        }
        instructions = instructions->append(LoadInstruction(accumulator_name))
        if retain_sources {
          sources = add_instruction_source(sources, origin, offset + instructions->len(), true)
        }
        instructions = instructions->append(LoadInstruction(item_name))
        if retain_sources {
          sources = add_instruction_source(sources, origin, offset + instructions->len(), true)
        }
        instructions = instructions->append(CallValueInstruction(2))
        if retain_sources {
          sources = add_instruction_source(sources, origin, offset + instructions->len(), true)
        }
        instructions = instructions->append(StoreInstruction(accumulator_name))
      }
      if retain_sources {
        sources = add_instruction_source(sources, origin, offset + instructions->len(), true)
      }
      instructions = instructions->append(JumpInstruction(loop_start))
      end: Nat = offset + instructions->len()
      mut resolved: [Instruction] = []
      mut instruction_index: Nat = 0
      for instruction in instructions {
        if instruction_index == next_index {
          resolved = resolved->append(IterNextInstruction(iterator_name, item_name, end))
        } else {
          resolved = resolved->append(instruction)
        }
        instruction_index = instruction_index + 1
      }
      if retain_sources {
        sources = add_instruction_source(sources, origin, offset + resolved->len(), true)
      }
      resolved = resolved->append(LoadInstruction(accumulator_name))
      EmittedCode(resolved, callback.next_temporary, sources, probes)
    } else {
      emitted: EmittedCode = emit_expression_list(
        arguments,
        program,
        next_temporary,
        offset,
        retain_sources
      )
      sources = emitted.sources
      probes = emitted.probes
      mut instructions: [Instruction] = emitted.instructions
      record: RecordLookup = record_type(program, name)
      variant: VariantLookup = variant_type(program, name)
      if record.found {
        if retain_sources {
          sources = add_instruction_source(sources, origin, offset + instructions->len(), false)
        }
        instructions = instructions->append(
          MakeRecordInstruction(name, record_field_names(record.fields))
        )
      } else {
        if variant.found {
          if retain_sources {
            sources = add_instruction_source(sources, origin, offset + instructions->len(), false)
          }
          instructions = instructions->append(
            MakeVariantInstruction(variant.enum_name, name, arguments->len())
          )
        } else {
          if retain_sources {
            sources = add_instruction_source(sources, origin, offset + instructions->len(), false)
          }
          instructions = instructions->append(CallInstruction(if name == "http_transport_exchange" {
              "$http_transport_exchange"
            } else {
              if name == "tcp_exchange" {
              "$tcp_exchange"
            } else {
              if name == "tcp_serve" {
                "$tcp_serve"
              } else {
                if name == "tcp_serve_stream" {
                  "$tcp_serve_stream"
                } else {
                  if name == "tcp_server_read_chunk" {
                    "$tcp_server_read_chunk"
                  } else {
                    name
                  }
                }
              }
            }}, arguments->len()))
        }
      }
      EmittedCode(instructions, emitted.next_temporary, sources, probes)
    }
  }
}

pure emit_match(
  subject: Expr,
  arms: [MatchArm],
  program: Program,
  next_temporary: Nat,
  offset: Nat,
  retain_sources: Bool,
  origin: Option[SourceSpan]
): EmittedCode {
  mut sources: [InstructionSource] = []
  mut probes: [EmissionProbe] = []
  temporary_name: Str = "$match${next_temporary}"
  subject_code: EmittedCode = emit_expression(
    subject,
    program,
    next_temporary + 1,
    offset,
    retain_sources
  )
  sources = subject_code.sources
  probes = subject_code.probes
  mut instructions: [Instruction] = subject_code.instructions

  if retain_sources {
    sources = add_instruction_source(sources, origin, offset + instructions->len(), true)
  }
  instructions = instructions->append(StoreInstruction(temporary_name))
  mut temporary: Nat = subject_code.next_temporary
  for arm in arms {
    arm_offset: Nat = offset + instructions->len()
    body_offset: Nat = arm_offset + 2 + arm.pattern.bindings->len()
    body_code: EmittedCode = emit_expression(
      arm.body,
      program,
      temporary,
      body_offset,
      retain_sources
    )
    failure: Nat = body_offset + body_code.instructions->len() + 1
    if retain_sources {
      sources = add_instruction_source(sources, origin, offset + instructions->len(), true)
    }
    instructions = instructions->append(LoadInstruction(temporary_name))
    if retain_sources {
      sources = add_instruction_source(sources, origin, offset + instructions->len(), true)
    }
    probes = add_emission_probe(
      probes,
      "arm:" + arm.pattern.variant,
      arm.body,
      arm_offset + 1,
      arm_offset + 2,
      retain_sources
    )
    instructions = instructions->append(MatchVariantInstruction(arm.pattern.variant, failure))
    mut binding_index: Nat = arm.pattern.bindings->len()
    while binding_index > 0 {
      binding_index = binding_index - 1
      if retain_sources {
        sources = add_instruction_source(sources, origin, offset + instructions->len(), true)
      }
      instructions = instructions->append(StoreInstruction(arm.pattern.bindings[binding_index]))
    }
    sources = sources->concat(body_code.sources)
    probes = probes->concat(body_code.probes)
    instructions = instructions->concat(body_code.instructions)
    if retain_sources {
      sources = add_instruction_source(sources, origin, offset + instructions->len(), true)
    }
    instructions = instructions->append(PendingEndJumpInstruction())
    temporary = body_code.next_temporary
  }
  if retain_sources {
    sources = add_instruction_source(sources, origin, offset + instructions->len(), true)
  }
  instructions = instructions->append(MatchFailInstruction())
  end: Nat = offset + instructions->len()
  EmittedCode(resolve_pending_jumps(instructions, end), temporary, sources, probes)
}

pub pure emit_expression(
  expression: Expr,
  program: Program,
  next_temporary: Nat,
  offset: Nat,
  retain_sources: Bool
): EmittedCode {
  emit_expression_at(expression, program, next_temporary, offset, retain_sources, None())
}

pure emit_expression_at(
  expression: Expr,
  program: Program,
  next_temporary: Nat,
  offset: Nat,
  retain_sources: Bool,
  origin: Option[SourceSpan]
): EmittedCode {
  mut sources: [InstructionSource] = []
  mut probes: [EmissionProbe] = []

  match expression {
    LocatedExpr(span, value, located_type_argument_spans) => {
      emitted: EmittedCode = emit_expression_at(
        value,
        program,
        next_temporary,
        offset,
        retain_sources,
        if retain_sources {
          Some(span)
        } else {
          None()
        })
      EmittedCode(emitted.instructions, emitted.next_temporary, emitted.sources,
        if retain_sources {
          emitted.probes->append(
            EmissionProbe("expression", span, offset, offset + emitted.instructions->len())
          )
        } else {
          []
        })
    },
    NatExpr(value) => {
      if retain_sources {
        sources = add_instruction_source(sources, origin, offset, false)
      }
      instructions: [Instruction] = [ConstInstruction(NatConstant(value))]
      EmittedCode(instructions, next_temporary, sources, probes)
    },
    DecimalExpr(text) => {
      if retain_sources {
        sources = add_instruction_source(sources, origin, offset, false)
      }
      instructions: [Instruction] = [ConstInstruction(DecimalConstant(text))]
      EmittedCode(instructions, next_temporary, sources, probes)
    },
    StringExpr(text) => emit_string_expression(
      text,
      next_temporary,
      retain_sources,
      origin,
      offset
    ),
    BoolExpr(value) => {
      if retain_sources {
        sources = add_instruction_source(sources, origin, offset, false)
      }
      instructions: [Instruction] = [ConstInstruction(BoolConstant(value))]
      EmittedCode(instructions, next_temporary, sources, probes)
    },
    NameExpr(name) => {
      if retain_sources {
        sources = add_instruction_source(sources, origin, offset, false)
      }
      instructions: [Instruction] = [LoadInstruction(name)]
      EmittedCode(instructions, next_temporary, sources, probes)
    },
    FunctionExpr(name) => {
      if retain_sources {
        sources = add_instruction_source(sources, origin, offset, false)
      }
      instructions: [Instruction] = [ConstInstruction(StringConstant(name))]
      EmittedCode(instructions, next_temporary, sources, probes)
    },
    ArrayExpr(items) => {
      emitted: EmittedCode = emit_expression_list(
        items,
        program,
        next_temporary,
        offset,
        retain_sources
      )
      sources = emitted.sources
      probes = emitted.probes
      if retain_sources {
        sources = add_instruction_source(sources, origin, offset + emitted.instructions->len(), false)
      }
      instructions: [Instruction] = emitted.instructions->append(MakeArrayInstruction(items->len()))
      EmittedCode(instructions, emitted.next_temporary, sources, probes)
    },
    UnaryExpr(operator, operand) => {
      emitted: EmittedCode = emit_expression(
        operand,
        program,
        next_temporary,
        offset,
        retain_sources
      )
      sources = emitted.sources
      probes = emitted.probes
      mut instructions: [Instruction] = []
      if operator == "await" {
        // Only the terminal invocation is awaited; argument calls keep their effects.
        mut index: Nat = 0
        for instruction in emitted.instructions {
          if index + 1 == emitted.instructions->len() {
            instructions = instructions->append(awaited_instruction(instruction))
          } else {
            instructions = instructions->append(instruction)
          }
          index = index + 1
        }
      } else {
        if retain_sources {
          sources = add_instruction_source(
            sources,
            origin,
            offset + emitted.instructions->len(),
            false
          )
        }
        instructions = emitted.instructions->append(UnaryInstruction(operator))
      }
      EmittedCode(instructions, emitted.next_temporary, sources, probes)
    },
    BinaryExpr(operator, left, right) => {
      if operator == "&&" || operator == "||" {
        emit_short_circuit(
          operator,
          left,
          right,
          program,
          next_temporary,
          offset,
          retain_sources,
          origin
        )
      } else {
        left_code: EmittedCode = emit_expression(
          left,
          program,
          next_temporary,
          offset,
          retain_sources
        )
        right_offset: Nat = offset + left_code.instructions->len()
        right_code: EmittedCode = emit_expression(
          right,
          program,
          left_code.next_temporary,
          right_offset,
          retain_sources
        )
        sources = left_code.sources->concat(right_code.sources)
        probes = left_code.probes->concat(right_code.probes)
        mut instructions: [Instruction] = left_code.instructions->concat(right_code.instructions)
        if operator == ".." {
          if retain_sources {
            sources = add_instruction_source(sources, origin, offset + instructions->len(), false)
          }
          instructions = instructions->append(MakeRangeInstruction())
        } else {
          if retain_sources {
            sources = add_instruction_source(sources, origin, offset + instructions->len(), false)
          }
          instructions = instructions->append(BinaryInstruction(operator))
        }
        EmittedCode(instructions, right_code.next_temporary, sources, probes)
      }
    },
    // Defensive trap for internal callers bypassing the checked frontend.
    OwnedCallExpr(target, name, arguments, types) => EmittedCode(
      [MatchFailInstruction()],
      next_temporary,
      [],
      []
    ),
    DotCallExpr(target, name, arguments, types) => EmittedCode(
      [MatchFailInstruction()],
      next_temporary,
      [],
      []
    ),
    CallExpr(name, arguments, type_arguments) => emit_call(
      name,
      arguments,
      program,
      next_temporary,
      offset,
      retain_sources,
      origin
    ),
    FieldExpr(target, field) => {
      emitted: EmittedCode = emit_expression(
        target,
        program,
        next_temporary,
        offset,
        retain_sources
      )
      sources = emitted.sources
      probes = emitted.probes
      if retain_sources {
        sources = add_instruction_source(sources, origin, offset + emitted.instructions->len(), false)
      }
      instructions: [Instruction] = emitted.instructions->append(FieldGetInstruction(field))
      EmittedCode(instructions, emitted.next_temporary, sources, probes)
    },
    IndexExpr(target, index) => {
      target_code: EmittedCode = emit_expression(
        target,
        program,
        next_temporary,
        offset,
        retain_sources
      )
      index_code: EmittedCode = emit_expression(
        index,
        program,
        target_code.next_temporary,
        offset + target_code.instructions->len(),
        retain_sources
      )
      sources = target_code.sources->concat(index_code.sources)
      probes = target_code.probes->concat(index_code.probes)
      mut instructions: [Instruction] = target_code.instructions->concat(index_code.instructions)
      if retain_sources {
        sources = add_instruction_source(sources, origin, offset + instructions->len(), false)
      }
      instructions = instructions->append(IndexGetInstruction())
      EmittedCode(instructions, index_code.next_temporary, sources, probes)
    },
    IfExpr(condition, yes, no, has_else) => {
      condition_code: EmittedCode = emit_expression(
        condition,
        program,
        next_temporary,
        offset,
        retain_sources
      )
      branch: Nat = offset + condition_code.instructions->len()
      yes_code: EmittedCode = emit_block(
        yes,
        program,
        condition_code.next_temporary,
        branch + 1,
        retain_sources
      )
      if has_else {
        jump: Nat = branch + 1 + yes_code.instructions->len()
        no_start: Nat = jump + 1
        no_code: EmittedCode = emit_block(
          no,
          program,
          yes_code.next_temporary,
          no_start,
          retain_sources
        )
        end: Nat = no_start + no_code.instructions->len()
        sources = condition_code.sources
        probes = condition_code.probes
        mut instructions: [Instruction] = condition_code.instructions
        if retain_sources {
          sources = add_instruction_source(sources, origin, offset + instructions->len(), true)
        }
        instructions = instructions->append(JumpFalseInstruction(no_start))
        sources = sources->concat(yes_code.sources)
        probes = probes->concat(yes_code.probes)
        instructions = instructions->concat(yes_code.instructions)
        if retain_sources {
          sources = add_instruction_source(sources, origin, offset + instructions->len(), true)
        }
        instructions = instructions->append(JumpInstruction(end))
        sources = sources->concat(no_code.sources)
        probes = probes->concat(no_code.probes)
        instructions = instructions->concat(no_code.instructions)
        probes = add_emission_probe(probes, "if", condition, branch, branch + 1, retain_sources)
        EmittedCode(instructions, no_code.next_temporary, sources, probes)
      } else {
        void_start: Nat = branch + 2 + yes_code.instructions->len()
        sources = condition_code.sources
        probes = condition_code.probes
        mut instructions: [Instruction] = condition_code.instructions
        if retain_sources {
          sources = add_instruction_source(sources, origin, offset + instructions->len(), true)
        }
        instructions = instructions->append(JumpFalseInstruction(void_start))
        sources = sources->concat(yes_code.sources)
        probes = probes->concat(yes_code.probes)
        instructions = instructions->concat(yes_code.instructions)
        if retain_sources {
          sources = add_instruction_source(sources, origin, offset + instructions->len(), true)
        }
        instructions = instructions->append(PopInstruction())
        if retain_sources {
          sources = add_instruction_source(sources, origin, offset + instructions->len(), true)
        }
        instructions = instructions->append(ConstInstruction(VoidConstant()))
        probes = add_emission_probe(probes, "if", condition, branch, branch + 1, retain_sources)
        EmittedCode(instructions, yes_code.next_temporary, sources, probes)
      }
    },
    BlockExpr(block) => emit_block(block, program, next_temporary, offset, retain_sources),
    MatchExpr(subject, arms) => emit_match(
      subject,
      arms,
      program,
      next_temporary,
      offset,
      retain_sources,
      origin
    )
  }
}

// Core routines are implicit but emitted only when reachable from user code.
// Keep all ordinary functions: only compiler-owned implementation names are pruned.
pure core_call_name(instruction: Instruction): Str {
  match instruction {
    ConstInstruction(a0) => "",
    LoadInstruction(a0) => "",
    StoreInstruction(a0) => "",
    PopInstruction() => "",
    UnaryInstruction(a0) => "",
    BinaryInstruction(a0) => "",
    MakeRangeInstruction() => "",
    MakeArrayInstruction(a0) => "",
    IndexGetInstruction() => "",
    InterpolateInstruction(a0) => "",
    IterInitInstruction(a0) => "",
    IterNextInstruction(a0, a1, a2) => "",
    MakeRecordInstruction(a0, a1) => "",
    FieldGetInstruction(a0) => "",
    MakeVariantInstruction(a0, a1, a2) => "",
    MatchVariantInstruction(a0, a1) => "",
    MatchFailInstruction() => "",
    CallInstruction(a0, a1) => a0,
    CallValueInstruction(a0) => "",
    AwaitCallInstruction(a0, a1) => a0,
    AwaitValueInstruction(a0) => "",
    JumpFalseInstruction(a0) => "",
    JumpInstruction(a0) => "",
    PendingEndJumpInstruction() => "",
    ReturnInstruction() => ""
  }
}

pure used_core_functions(functions: [FunctionCode]): Set[Str] {
  mut used: Set[Str] = set()
  mut changed: Bool = true

  while changed {
    changed = false
    for function in functions {
      if !function.name->starts_with_at("$core_", 0) || used->has(function.name) {
        for instruction in function.instructions {
          name: Str = core_call_name(instruction)
          if name->starts_with_at("$core_", 0) && !used->has(name) {
            used = used->add(name)
            changed = true
          }
        }
      }
    }
  }
  used
}

pub pure compile_program(program: Program): BytecodeProgram {
  compile_program_emission(program, false).bytecode
}

pub pure compile_program_with_sources(program: Program): SourceMappedProgram {
  compile_program_emission(program, true)
}

pub pure compile_program_emission(program: Program, retain_sources: Bool): SourceMappedProgram {
  mut sources: [FunctionSources] = []
  mut probes: [FunctionProbes] = []
  mut functions: [FunctionCode] = []

  for declaration in program.declarations {
    match declaration {
      FunctionDeclaration(name, parameters, return_type, is_pure, is_async, body, type_parameters) => {
        emitted: EmittedCode = emit_block(body, program, 0, 0, retain_sources)
        instructions: [Instruction] = emitted.instructions->append(ReturnInstruction())
        if retain_sources {
          sources = sources->append(FunctionSources(name, emitted.sources))
          probes = probes->append(FunctionProbes(name, emitted.probes))
        }
        functions = functions->append(
          FunctionCode(name, parameter_names(parameters), is_pure, is_async, instructions)
        )
      },
      ImportDeclaration(path) => {},
      TypeDeclaration(name, base, guard) => {},
      RecordDeclaration(name, parameters, fields) => {},
      EnumDeclaration(name, parameters, variants) => {}
    }
  }
  used: Set[Str] = used_core_functions(functions)
  mut selected: [FunctionCode] = []
  for function in functions {
    if !function.name->starts_with_at("$core_", 0) || used->has(function.name) {
      selected = selected->append(function)
    }
  }
  mut selected_sources: [FunctionSources] = []
  for source in sources {
    if !source.name->starts_with_at("$core_", 0) || used->has(source.name) {
      selected_sources = selected_sources->append(source)
    }
  }
  mut selected_probes: [FunctionProbes] = []
  for probe in probes {
    if !probe.name->starts_with_at("$core_", 0) || used->has(probe.name) {
      selected_probes = selected_probes->append(probe)
    }
  }
  SourceMappedProgram(BytecodeProgram(selected), selected_sources, selected_probes)
}

pub pure compile_source_disassembly(source: Str): Str {
  match lex(source) {
    Ok(tokens) => {
      match parse_program_complete(tokens) {
        Ok(program) => {
          diagnostics: [Diagnostic] = check_program_frontend(program)
          if diagnostics->len() > 0 {
            render_resolver_diagnostics(diagnostics)
          } else {
            render_bytecode(compile_program(program))
          }
        },
        Error(error) => error.message
      }
    },
    Error(errors) => "lexing failed"
  }
}

pure awaited_instruction(instruction: Instruction): Instruction {
  match instruction {
    ConstInstruction(a0) => instruction,
    LoadInstruction(a0) => instruction,
    StoreInstruction(a0) => instruction,
    PopInstruction() => instruction,
    UnaryInstruction(a0) => instruction,
    BinaryInstruction(a0) => instruction,
    MakeRangeInstruction() => instruction,
    MakeArrayInstruction(a0) => instruction,
    IndexGetInstruction() => instruction,
    InterpolateInstruction(a0) => instruction,
    IterInitInstruction(a0) => instruction,
    IterNextInstruction(a0, a1, a2) => instruction,
    MakeRecordInstruction(a0, a1) => instruction,
    FieldGetInstruction(a0) => instruction,
    MakeVariantInstruction(a0, a1, a2) => instruction,
    MatchVariantInstruction(a0, a1) => instruction,
    MatchFailInstruction() => instruction,
    CallInstruction(a0, a1) => AwaitCallInstruction(a0, a1),
    CallValueInstruction(a0) => AwaitValueInstruction(a0),
    AwaitCallInstruction(a0, a1) => instruction,
    AwaitValueInstruction(a0) => instruction,
    JumpFalseInstruction(a0) => instruction,
    JumpInstruction(a0) => instruction,
    PendingEndJumpInstruction() => instruction,
    ReturnInstruction() => instruction
  }
}
