// Render retained proof and effect decisions using the original source snapshots.
// Explanation output cannot manufacture evidence from a diagnostic string.

// Presentation consumes retained checker decisions and the exact loaded text.
// It does not rerun proofs, parse diagnostics, or execute user code.
pure explanation_location(
  origin: Option[SourceSpan],
  sources: Map[Str, Str],
  root: Str,
  stdlib_root: Str
): Str {
  match origin {
    None() => "source: unavailable",
    Some(span) => {
      if !sources.has(span.start.file) {
        "source: unavailable"
      } else {
        source: Str = sources.get(span.start.file)
        if span.end.offset < span.start.offset || span.end.offset > len(source) {
          "source: unavailable"
        } else {
          file: Str = source_map_escape(source_identifier(span.start.file, root, stdlib_root))
          line: Nat = span.start.line
          column: Nat = span.start.column
          end_line: Nat = span.end.line
          end_column: Nat = span.end.column
          expression: Str = source_map_escape(slice(source, span.start.offset, span.end.offset))
          "source: ${file}:${line}:${column}-${end_line}:${end_column}\nexpression: ${expression}"
        }
      }
    }
  }
}

pure render_subtraction_evidence(
  entry: SubtractionEvidence,
  sources: Map[Str, Str],
  root: Str,
  stdlib_root: Str
): Str {
  decision: SubtractionDecision = entry.decision
  unavailable: Bool = decision.rule == "unsupported" || decision.rule == "invalid-operands"
  status: Str = if unavailable {
    "unavailable"
  } else {
    if decision.proven {
      "proved"
    } else {
      "unproved"
    }
  }
  left_type: Str = source_map_escape(entry.left.name)
  right_type: Str = source_map_escape(entry.right.name)
  mut output: Str = "subtraction: ${status}\n" + explanation_location(
    entry.span,
    sources,
    root,
    stdlib_root
  ) +
    "\noperand types: ${left_type}, ${right_type}"
  if unavailable {
    output = output + if decision.rule == "unsupported" {
      "\nreason: this query only explains Nat subtraction obligations"
    } else {
      "\nreason: operand checking failed; no trustworthy subtraction explanation"
    }
  } else {
    output = output + "\nobligation: left >= right"
    if entry.left.has_nat {
      value: Nat = entry.left.nat_value
      output = output + "\nleft constant: ${value}"
    }
    if entry.right.has_nat {
      value: Nat = entry.right.nat_value
      output = output + "\nright constant: ${value}"
    } else {
      output = output + "\nright constant: unknown"
    }
    if decision.has_lower {
      bound: Nat = decision.lower
      output = output + "\nleft lower bound: ${bound}"
      match decision.guard {
        None() => {
          output = output + "\nguard origin: unavailable"
        },
        Some(guard) => {
          truth: Str = if guard.truth {
            "true"
          } else {
            "false"
          }
          output = output + "\nguard branch: ${truth}\n" + explanation_location(
            guard.span,
            sources,
            root,
            stdlib_root
          )
        }
      }
    }
    output = output + if decision.rule == "constants" {
      "\nreason: retained constant values satisfy the obligation"
    } else {
      if decision.rule == "lower-bound" {
        "\nreason: retained lower bound is at least the right constant"
      } else {
        "\nreason: retained facts do not prove the obligation; this does not establish a runtime failure"
      }
    }
  }

  output
}

pure explanation_span_matches(span: Option[SourceSpan], source_path: Str): Bool {
  match span {
    None() => false,
    Some(value) => value.start.file == source_path && value.end.file == source_path
  }
}

pure explanation_has_project_error(project: LoadedProject): Bool {
  mut found: Bool = false
  for diagnostic in project.diagnostics {
    if diagnostic.message != "namespace syntax is parsed but execution is not yet supported (language namespace migration pending)" {
      found = true
    }
  }
  found
}

pub explanation_function_selector(
  project: LoadedProject,
  selector: Str,
  entry_path: Str,
  root: Str,
  stdlib_root: Str
): Result[SourceMapFunctionSelector, Str] {
  selected: Result[SourceMapFunctionSelector, Str] = source_map_function_selector(
    project,
    selector,
    entry_path,
    root,
    stdlib_root
  )
  match selected {
    Error(message) => if starts_with_at(message, "unknown function selector ", 0) &&
      explanation_has_project_error(project) {
      identity: DeclarationIdentity = DeclarationIdentity(
        source_module_identity(entry_path, root, stdlib_root),
        selector
      )
      Ok(SourceMapFunctionSelector(identity, entry_path, selector, selector))
    } else {
      Error(message)
    },
    Ok(value) => Ok(value)
  }
}

pure explanation_function_effect_status(
  project: LoadedProject,
  selector: SourceMapFunctionSelector
): Str {
  mut found: Str = "unavailable"
  for body in project.module_bodies {
    if body.signature.binding.identity == selector.identity {
      match body.status {
        BodyIdentityChecked() => { found = "checked" },
        BodyDeferred() => { found = "deferred" },
        BodyInvalid() => { found = "unavailable" }
      }
    }
  }
  found
}

pure render_subtraction_explanations(
  project: LoadedProject,
  selector: SourceMapFunctionSelector,
  display_name: Str,
  source_path: Str,
  accepted: Bool,
  root: Str,
  stdlib_root: Str
): Str {
  state: Str = if accepted {
    "accepted"
  } else {
    "rejected"
  }
  displayed_function: Str = source_map_escape(display_name)
  mut output: Str = "program: ${state}\nfunction: ${displayed_function}\nscope: Nat subtraction; generic definitions, not call-site specialisations"
  mut count: Nat = 0

  for entry in project.evidence {
    if (entry.function_name == selector.identity.name || entry.function_name == selector.emitted_name) &&
      explanation_span_matches(entry.span, source_path) {
      output = output + "\n\n" + render_subtraction_evidence(
        entry,
        project.sources,
        root,
        stdlib_root
      )
      count = count + 1
    }
  }
  if count == 0 {
    output = output + "\n\nsubtraction: unavailable\nreason: no subtraction evidence was retained for this function"
  }

  output
}

// Each status concerns one local rule boundary, never the execution of a path
// or the validity of the complete expression/program.
pure effect_display_target(name: Str): Str {
  if name == "$unit" {
    "()"
  } else {
    if starts_with_at(name, "$method_", 0) {
      slice(name, 8, len(name))
    } else {
      if starts_with_at(name, "$core_", 0) {
        slice(name, 6, len(name))
      } else {
        name
      }
    }
  }
}

pure render_effect_evidence(
  entry: EffectEvidence,
  sources: Map[Str, Str],
  root: Str,
  stdlib_root: Str
): Str {
  status: Str = if len(entry.violations) > 0 {
    "rejected"
  } else {
    if entry.target_effect == "unavailable" { "unavailable" } else { "allowed" }
  }
  mut output: Str = "effect boundary: ${status}\n" + explanation_location(
    entry.span,
    sources,
    root,
    stdlib_root
  ) +
    "\nboundary: " + entry.kind + "\ncontext: " + entry.mode
  if entry.kind == "call" {
    output = output + "\ncallee: " + source_map_escape(effect_display_target(entry.target)) + "\nclassification basis: " + entry.basis +
      "\ncallee effect: " + entry.target_effect + if entry.awaited {
      "\nawaited: yes"
    } else {
      "\nawaited: no"
    }
  }
  if len(entry.violations) > 0 {
    for reason in entry.violations {
      output = output + "\nreason: " + source_map_escape(reason)
    }
  } else {
    output = output + if entry.kind == "await" {
      "\nreason: enclosing function is async; operand boundaries are checked separately"
    } else {
      if entry.target_effect == "async" {
        "\nreason: async call is awaited inside an async function"
      } else {
        if entry.target_effect == "unavailable" {
          "\nreason: the indirect call was checked, but its callable effect could not be determined"
        } else {
          if entry.target_effect == "pure" {
            "\nreason: pure call is permitted in this context"
          } else {
            "\nreason: ordinary function permits this effectful call"
          }
        }
      }
    }
  }

  output
}

pure body_guard_conversions(body: BoundBody): [GuardConversionEvidence] {
  mut entries: [GuardConversionEvidence] = body.guard_conversions
  for child in body.children {
    entries = concat(entries, body_guard_conversions(child))
  }
  entries
}

pure body_inferred_locals(body: BoundBody): [BoundBody] {
  mut entries: [BoundBody] = []
  match body.node {
    BodyBinding(local, type, mutable, inferred, type_evidence) => match inferred {
      Some(value) => if value { entries = append(entries, body) },
      None() => {}
    },
    BodyLiteral(value) => {},
    BodyInterpolation(parts) => {},
    BodyLocalUse(local) => {},
    BodyFunction(binding) => {},
    BodyCall(target, types, call_arguments) => {},
    BodyArray() => {},
    BodyUnary(operator) => {},
    BodyBinary(operator) => {},
    BodyField(name) => {},
    BodyIndex() => {},
    BodyIf(has_else) => {},
    BodyBlock(has_tail) => {},
    BodyMatch(targets, bindings, spans) => {},
    BodyAssignment(local, assignment_evidence) => {},
    BodyWhile() => {},
    BodyFor(local) => {},
    BodyEmpty() => {}
  }
  for child in body.children {
    entries = concat(entries, body_inferred_locals(child))
  }
  entries
}

pure inferred_local_type(body: BoundBody): Option[SignatureType] {
  match body.node {
    BodyBinding(local, type, mutable, inferred, type_evidence) => match type {
      Some(value) => Some(value),
      None() => None()
    },
    BodyLiteral(value) => None(),
    BodyInterpolation(parts) => None(),
    BodyLocalUse(local) => None(),
    BodyFunction(binding) => None(),
    BodyCall(target, types, call_arguments) => None(),
    BodyArray() => None(),
    BodyUnary(operator) => None(),
    BodyBinary(operator) => None(),
    BodyField(name) => None(),
    BodyIndex() => None(),
    BodyIf(has_else) => None(),
    BodyBlock(has_tail) => None(),
    BodyMatch(targets, bindings, spans) => None(),
    BodyAssignment(local, assignment_evidence) => None(),
    BodyWhile() => None(),
    BodyFor(local) => None(),
    BodyEmpty() => None()
  }
}

pure explanation_expression_node(body: BoundBody): Bool {
  match body.node {
    BodyBinding(local, type, mutable, inferred, type_evidence) => false,
    BodyLiteral(value) => true,
    BodyInterpolation(parts) => true,
    BodyLocalUse(local) => true,
    BodyFunction(binding) => true,
    BodyCall(target, types, call_arguments) => true,
    BodyArray() => true,
    BodyUnary(operator) => true,
    BodyBinary(operator) => true,
    BodyField(name) => true,
    BodyIndex() => true,
    BodyIf(has_else) => true,
    BodyBlock(has_tail) => true,
    BodyMatch(targets, bindings, spans) => true,
    BodyAssignment(local, assignment_evidence) => false,
    BodyWhile() => false,
    BodyFor(local) => false,
    BodyEmpty() => false
  }
}

pure explanation_position_contains(span: SourceSpan, line: Nat, column: Nat): Bool {
  starts_before: Bool = line > span.start.line ||
    (line == span.start.line && column >= span.start.column)
  ends_after: Bool = line < span.end.line ||
    (line == span.end.line && column < span.end.column)
  starts_before && ends_after
}

pure body_explanation_expressions(body: BoundBody): [BoundBody] {
  mut entries: [BoundBody] = []
  if explanation_expression_node(body) {
    entries = append(entries, body)
  }
  for child in body.children {
    entries = concat(entries, body_explanation_expressions(child))
  }
  entries
}

pub pure render_expression_type_explanation(
  project: LoadedProject,
  selector: SourceMapFunctionSelector,
  line: Nat,
  column: Nat,
  root: Str,
  stdlib_root: Str
): Str {
  mut expressions: [BoundBody] = []
  mut found_function: Bool = false
  mut valid_function: Bool = false
  for function in project.module_bodies {
    if function.signature.binding.identity == selector.identity {
      found_function = true
      match function.status {
        BodyIdentityChecked() => {
          valid_function = true
          expressions = concat(expressions, body_explanation_expressions(function.body))
        },
        BodyDeferred() => {},
        BodyInvalid() => {}
      }
    }
  }
  mut has_match: Bool = false
  mut best_index: Nat = 0
  mut best_start: Nat = 0
  mut best_end: Nat = 4294967295
  for index in 0..len(expressions) {
    candidate: BoundBody = expressions[index]
    if candidate.span.start.file == selector.source_path &&
      candidate.span.end.offset >= candidate.span.start.offset &&
      explanation_position_contains(candidate.span, line, column) {
      if !has_match || (candidate.span.start.offset >= best_start &&
        candidate.span.end.offset <= best_end) {
        has_match = true
        best_index = index
        best_start = candidate.span.start.offset
        best_end = candidate.span.end.offset
      }
    }
  }
  if has_match {
    body: BoundBody = expressions[best_index]
    type_text: Str = render_inferred_type(body.type)
    escaped_type: Str = source_map_escape(type_text)
    output: Str = "checked expression type: ${escaped_type}\n" +
      explanation_location(Some(body.span), project.sources, root, stdlib_root)
    output + if type_text == "unavailable" {
      "\nreason: the checker did not retain a complete type for this expression"
    } else {
      "\nreason: type retained from the checked expression"
    }
  } else {
    if !found_function {
      "checked expression type: unavailable\nreason: no checked body was retained for this function"
    } else {
      if !valid_function {
        "checked expression type: unavailable\nreason: function body type checking did not complete"
      } else {
        "checked expression type: unavailable\nreason: no checked expression covers this source location"
      }
    }
  }
}

pure render_inferred_type(type: Option[SignatureType]): Str {
  match type {
    None() => "unavailable",
    Some(value) => if body_type_complete(value) {
      body_type_text(value)
    } else {
      "unavailable"
    }
  }
}

pure render_return_type_evidence(
  evidence: ReturnTypeEvidence,
  sources: Map[Str, Str],
  root: Str,
  stdlib_root: Str
): Str {
  status: Str = match evidence.accepted {
    Some(accepted) => if accepted { "accepted" } else { "rejected" },
    None() => "unavailable"
  }
  actual: Str = source_map_escape(render_inferred_type(evidence.actual))
  expected: Str = source_map_escape(body_type_text(evidence.expected))
  mut output: Str = "return type: ${status}\n" + explanation_location(
    Some(evidence.span),
    sources,
    root,
    stdlib_root
  ) + "\nactual type: ${actual}\nexpected type: ${expected}"
  output + match evidence.accepted {
    Some(accepted) => if accepted {
      "\nreason: the checked function result is compatible with its declared return type"
    } else {
      "\nreason: the checked function result is incompatible with its declared return type"
    },
    None() => "\nreason: the checker did not determine a complete function result type"
  }
}

pure render_return_type_explanation(
  project: LoadedProject,
  selector: SourceMapFunctionSelector,
  root: Str,
  stdlib_root: Str
): Str {
  mut output: Str = "return type: unavailable\nreason: no return type evidence was retained for this function"
  for function in project.module_bodies {
    if function.signature.binding.identity == selector.identity {
      match function.return_type_evidence {
        None() => {},
        Some(evidence) => {
          output = render_return_type_evidence(
            evidence,
            project.sources,
            root,
            stdlib_root
          )
        }
      }
    }
  }
  output
}

pure render_call_argument_evidence(
  evidence: CallArgumentEvidence,
  sources: Map[Str, Str],
  root: Str,
  stdlib_root: Str
): Str {
  status: Str = match evidence.accepted {
    Some(accepted) => if accepted { "accepted" } else { "rejected" },
    None() => "unavailable"
  }
  actual: Str = source_map_escape(render_inferred_type(evidence.actual))
  expected: Str = source_map_escape(body_type_text(evidence.expected))
  label: Str = evidence.label
  mut output: Str = "${label}: ${status}\n" + explanation_location(
    Some(evidence.span),
    sources,
    root,
    stdlib_root
  ) + "\nactual type: ${actual}\nexpected type: ${expected}"
  output + match evidence.accepted {
    Some(accepted) => if accepted {
      "\nreason: the checked argument is compatible with the expected type"
    } else {
      "\nreason: the checked argument is incompatible with the expected type"
    },
    None() => "\nreason: the checker did not determine a complete argument type"
  }
}

pure render_call_argument_explanations(
  project: LoadedProject,
  selector: SourceMapFunctionSelector,
  root: Str,
  stdlib_root: Str
): Str {
  mut entries: [CallArgumentEvidence] = []
  for function in project.module_bodies {
    if function.signature.binding.identity == selector.identity {
      entries = concat(entries, body_call_argument_evidence(function.body))
    }
  }
  mut output: Str = "call argument checks:"
  if len(entries) == 0 {
    output = output + " none (no retained call argument checks)"
  } else {
    for entry in entries {
      output = output + "\n\n" + render_call_argument_evidence(
        entry,
        project.sources,
        root,
        stdlib_root
      )
    }
  }
  output
}

