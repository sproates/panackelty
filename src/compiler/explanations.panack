  mut entries: [TypeJoinEvidence] = []
  for function in project.module_bodies {
    if function.signature.binding.identity == selector.identity {
      entries = concat(entries, body_type_join_evidence(function.body))
    }
  }
  mut output: Str = "checked type joins:"
  if len(entries) == 0 {
    output = output + " none (no retained checked joins for this function)"
  } else {
    for entry in entries {
      output = output + "\n\n" + render_type_join_evidence(
        entry, project.sources, root, stdlib_root
      )
    }
  }
  output
}

pure render_operator_type_evidence(
  evidence: OperatorTypeEvidence,
  sources: Map[Str, Str],
  root: Str,
  stdlib_root: Str
): Str {
  status: Str = match evidence.accepted {
    Some(accepted) => if accepted { "accepted" } else { "rejected" },
    None() => "unavailable"
  }
  operator: Str = source_map_escape(evidence.operator)
  left: Str = source_map_escape(render_inferred_type(evidence.left))
  result: Str = source_map_escape(render_inferred_type(evidence.result))
  right: Str = if evidence.unary {
    "right operand: not applicable"
  } else {
    "right operand type: " + source_map_escape(render_inferred_type(evidence.right))
  }
  "operator type check: ${status}\noperator: ${operator}\n" + explanation_location(
    Some(evidence.span), sources, root, stdlib_root
  ) + "\nleft operand type: ${left}\n${right}\nresulting expression type: ${result}" + match evidence.accepted {
    Some(accepted) => if accepted {
      "\nreason: the existing operator type rules accepted these operand types"
    } else {
      "\nreason: the existing operator type rules rejected these operand types"
    },
    None() => "\nreason: the checker did not determine the required operand types"
  }
}

pure render_operator_type_explanations(
  project: LoadedProject,
  selector: SourceMapFunctionSelector,
  root: Str,
  stdlib_root: Str
): Str {
  mut entries: [OperatorTypeEvidence] = []
  for function in project.module_bodies {
    if function.signature.binding.identity == selector.identity {
      entries = concat(entries, body_operator_type_evidence(function.body))
    }
  }
  mut output: Str = "operator type checks:"
  if len(entries) == 0 {
    output = output + " none (no retained unary or binary operator type checks)"
  } else {
    for entry in entries {
      output = output + "\n\n" + render_operator_type_evidence(
        entry, project.sources, root, stdlib_root
      )
    }
  }
  output
}

pure render_type_check_evidence(
  evidence: BodyTypeCheckEvidence,
  sources: Map[Str, Str],
  root: Str,
  stdlib_root: Str
): Str {
  status: Str = match evidence.accepted {
    Some(accepted) => if accepted { "accepted" } else { "rejected" },
    None() => "unavailable"
  }
  actual: Str = source_map_escape(render_inferred_type(evidence.actual))
  context: Str = source_map_escape(evidence.context)
  expected: Str = source_map_escape(evidence.expected)
  string_interpolation: Bool = evidence.context == "string interpolation"
  void_value_requirement: Bool = evidence.context == "binding storage" ||
    evidence.context == "array element"
  match_payload_type: Bool = evidence.context == "match payload type"
  match_decision: Bool = evidence.context == "match subject" ||
    evidence.context == "match arm uniqueness" ||
    evidence.context == "match payload bindings" || evidence.context == "match exhaustiveness"
  call_arity: Bool = evidence.context == "direct call arity" ||
    evidence.context == "core call arity" || evidence.context == "indirect call arity"
  type_argument_arity: Bool = evidence.context == "type argument arity"
  count_decision: Bool = call_arity || type_argument_arity
  status_label: Str = if call_arity { "checked call arity" } else {
    if type_argument_arity { "checked type argument arity" } else {
      if string_interpolation { "checked interpolation type" } else {
        if void_value_requirement { "checked value requirement" } else {
          if match_payload_type { "checked match payload type" } else {
            if match_decision { "checked match decision" } else { "checked type requirement" }
          }
        }
      }
    }
  }
  actual_label: Str = if string_interpolation { "local type" } else {
    if match_payload_type { "matched enum type" } else {
      if match_decision { "subject type" } else { "actual type" }
    }
  }
  expected_label: Str = if call_arity { "argument counts" } else {
    if type_argument_arity { "type argument counts" } else {
      if string_interpolation { "allowed interpolation types" } else {
        if void_value_requirement { "required value" } else {
          if match_payload_type { "payload source" } else {
            if match_decision { "decision rule" } else { "expected type" }
          }
        }
      }
    }
  }
  result: Str = if string_interpolation || void_value_requirement ||
    evidence.context == "index position" ||
    evidence.context == "if condition" || evidence.context == "while condition" ||
    evidence.context == "match variant" || match_decision {
    "not applicable"
  } else {
    source_map_escape(render_inferred_type(evidence.result))
  }
  "${status_label}: ${status}\ncontext: ${context}\n" +
    explanation_location(Some(evidence.span), sources, root, stdlib_root) +
    (if count_decision { "" } else { "\n${actual_label}: ${actual}" }) +
    "\n${expected_label}: ${expected}" +
    (if count_decision { "" } else { "\nresulting type: ${result}" }) +
    match evidence.accepted {
      Some(accepted) => if accepted {
        if call_arity {
          "\nreason: the existing checker accepted the supplied argument count"
        } else {
          if type_argument_arity {
            "\nreason: the existing checker accepted the supplied type argument count"
          } else {
            if string_interpolation {
              "\nreason: the checker accepted this scalar local for interpolation"
            } else {
              if match_payload_type {
                "\nreason: the checker substituted this variant payload type for the pattern binding"
              } else {
                if match_decision {
                  "\nreason: the existing checker accepted this match rule"
                } else {
                  "\nreason: the existing checker accepted this type for the requirement"
                }
              }
            }
          }
        }
      } else {
        if call_arity {
          "\nreason: the existing checker rejected the supplied argument count"
        } else {
          if type_argument_arity {
            "\nreason: the existing checker rejected the supplied type argument count"
          } else {
            if string_interpolation {
              "\nreason: the checker rejected a non-scalar local for interpolation"
            } else {
              if void_value_requirement {
                if evidence.context == "binding storage" {
                  "\nreason: Void produces no value and cannot be stored in a binding"
                } else {
                  "\nreason: Void produces no element value and cannot be placed in an array"
                }
              } else {
                if match_payload_type {
                  "\nreason: the checker could not substitute this variant payload type for the pattern binding"
                } else {
                  if match_decision {
                    "\nreason: the existing checker rejected this match rule"
                  } else {
                    "\nreason: the existing checker rejected this type for the requirement"
                  }
                }
              }
            }
          }
        }
      },
      None() => if string_interpolation {
        if evidence.actual == None() {
          "\nreason: the checker could not determine the local type needed for interpolation"
        } else {
          "\nreason: the checker deferred interpolation of a guarded local type"
        }
      } else {
        if match_payload_type {
          "\nreason: the checker could not determine the matched enum type needed for payload substitution"
        } else {
          if evidence.context == "indirect call arity" {
            "\nreason: the callable type is unresolved, so the checker could not determine the expected argument count"
          } else {
            "\nreason: the checker did not determine a complete type decision"
          }
        }
      }
    }
}

pure render_type_check_explanations(
  project: LoadedProject,
  selector: SourceMapFunctionSelector,
  root: Str,
  stdlib_root: Str
): Str {
  mut entries: [BodyTypeCheckEvidence] = []
  for function in project.module_bodies {
    if function.signature.binding.identity == selector.identity {
      for evidence in body_type_check_evidence(function.body) {
        if evidence.context != "direct call arity" &&
          evidence.context != "core call arity" && evidence.context != "indirect call arity" &&
          evidence.context != "type argument arity" {
          entries = append(entries, evidence)
        }
      }
    }
  }
  mut output: Str = "checked type requirements:"
  if len(entries) == 0 {
    output = output + " none (no retained checked type requirements)"
  } else {
    for entry in entries {
      output = output + "\n\n" + render_type_check_evidence(
        entry, project.sources, root, stdlib_root
      )
    }
  }
  output
}

