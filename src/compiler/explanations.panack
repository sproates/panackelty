pure render_collection_callback_evidence(
  evidence: CollectionCallbackEvidence,
  sources: Map[Str, Str],
  root: Str,
  stdlib_root: Str
): Str {
  operation: Str = evidence.operation
  status: Str = match evidence.accepted {
    Some(accepted) => if accepted { "accepted" } else { "rejected" },
    None() => "unavailable"
  }
  callback: Str = source_map_escape(render_inferred_type(evidence.callback))
  result: Str = source_map_escape(render_inferred_type(evidence.result))
  mut parameters: Str = ""
  for parameter in evidence.expected_parameters {
    if parameters != "" { parameters = parameters + ", " }
    parameters = parameters + source_map_escape(body_type_text(parameter))
  }
  expected_result: Str = match evidence.expected_result {
    Some(type) => source_map_escape(body_type_text(type)),
    None() => if operation == "array_map" { "any non-Void value" } else { "unavailable" }
  }
  "${operation} callback contract: ${status}\n" + explanation_location(
    Some(evidence.span), sources, root, stdlib_root
  ) + "\ncallback type: ${callback}\nexpected callback parameter types: [${parameters}]\ncallback result type: ${result}\nexpected callback result: ${expected_result}" + match evidence.accepted {
    Some(accepted) => if accepted {
      "\nreason: the checker accepted the callback's purity, arity, parameter types and result constraint"
    } else {
      "\nreason: the checker rejected at least one callback contract requirement"
    },
    None() => "\nreason: the checker did not determine a complete callback contract"
  }
}

pure render_collection_callback_explanations(
  project: LoadedProject,
  selector: SourceMapFunctionSelector,
  root: Str,
  stdlib_root: Str
): Str {
  mut entries: [CollectionCallbackEvidence] = []
  for function in project.module_bodies {
    if function.signature.binding.identity == selector.identity {
      entries = concat(entries, body_collection_callback_evidence(function.body))
    }
  }
  mut output: Str = "collection callback contracts:"
  if len(entries) == 0 {
    output = output + " none (no retained array map or reduce callback checks)"
  } else {
    for entry in entries {
      output = output + "\n\n" + render_collection_callback_evidence(
        entry, project.sources, root, stdlib_root
      )
    }
  }
  output
}

pure render_inferred_local(
  body: BoundBody,
  sources: Map[Str, Str],
  root: Str,
  stdlib_root: Str
): Str {
  match body.node {
    BodyBinding(local, type, mutable, inferred, type_evidence) => {
      local_name: Str = source_map_escape(local.name)
      mut output: Str = "inferred local: ${local_name}"
      if len(body.children) == 0 {
        output = output + "\nsource: unavailable\ninferred type: unavailable\nreason: no initializer evidence was retained"
      } else {
        initializer: BoundBody = body.children[0]
        output = output + "\n" + explanation_location(
          Some(initializer.span),
          sources,
          root,
          stdlib_root
        )
        initializer_type: Str = render_inferred_type(initializer.type)
        inferred_type: Str = render_inferred_type(inferred_local_type(body))
        escaped_initializer_type: Str = source_map_escape(initializer_type)
        escaped_inferred_type: Str = source_map_escape(inferred_type)
        output = output + "\ninitializer type: ${escaped_initializer_type}"
        output = output + "\ninferred type: ${escaped_inferred_type}"
        output = output + if inferred_type == "unavailable" {
          "\nreason: the initializer did not determine a complete type"
        } else {
          "\nreason: the checked initializer type determines this local type"
        }
      }
      output
    },
    BodyLiteral(value) => "inferred local: unavailable",
    BodyInterpolation(parts) => "inferred local: unavailable",
    BodyLocalUse(local) => "inferred local: unavailable",
    BodyFunction(binding) => "inferred local: unavailable",
    BodyCall(target, types, call_arguments) => "inferred local: unavailable",
    BodyArray() => "inferred local: unavailable",
    BodyUnary(operator) => "inferred local: unavailable",
    BodyBinary(operator) => "inferred local: unavailable",
    BodyField(name) => "inferred local: unavailable",
    BodyIndex() => "inferred local: unavailable",
    BodyIf(has_else) => "inferred local: unavailable",
    BodyBlock(has_tail) => "inferred local: unavailable",
    BodyMatch(targets, bindings, spans) => "inferred local: unavailable",
    BodyAssignment(local, assignment_evidence) => "inferred local: unavailable",
    BodyWhile() => "inferred local: unavailable",
    BodyFor(local) => "inferred local: unavailable",
    BodyEmpty() => "inferred local: unavailable"
  }
}

pure render_guard_nat(value: Nat): Str {
  "${value}"
}

pure render_guard_bounds(bounds: Bounds): Str {
  mut output: Str = ""
  if bounds.has_lower {
    lower: Str = render_guard_nat(bounds.lower)
    output = "value >= ${lower}"
  }
  if bounds.has_upper {
    upper: Str = render_guard_nat(bounds.upper)
    output = output + if output == "" {
      "value <= ${upper}"
    } else {
      " and value <= ${upper}"
    }
  }
  if output == "" {
    "no numeric bounds retained"
  } else {
    output
  }
}

pure render_guard_conversion(
  entry: GuardConversionEvidence,
  sources: Map[Str, Str],
  root: Str,
  stdlib_root: Str
): Str {
  status: Str = match entry.proven {
    Some(proven) => if proven { "proved" } else { "unproved" },
    None() => "unavailable"
  }
  source_type: Str = source_map_escape(entry.source_type)
  target_type: Str = source_map_escape(entry.target_type)
  target_guard: Str = source_map_escape(entry.target_guard)
  mut output: Str = "guarded conversion: ${status}\n" + explanation_location(
    Some(entry.span),
    sources,
    root,
    stdlib_root
  ) + "\nconversion: ${source_type} -> ${target_type}"
  match entry.source_guard {
    None() => {},
    Some(guard) => {
      source_guard: Str = source_map_escape(guard)
      output = output + "\nsource guard: ${source_guard}"
    }
  }
  output = output + "\ntarget guard: ${target_guard}"
  match entry.bounds {
    None() => {
      output = output + "\nfacts: unavailable"
    },
    Some(bounds) => {
      facts: Str = render_guard_bounds(bounds)
      output = output + "\nfacts: ${facts}"
    }
  }
  output = output + if entry.proven == Some(true) {
    "\nreason: retained value facts satisfy the target guard"
  } else {
    if entry.proven == Some(false) {
      "\nreason: retained value facts do not prove the target guard; this does not establish a runtime failure"
    } else {
      "\nreason: no applicable value facts were retained for this conversion"
    }
  }
  output
}

pure render_guard_conversion_explanations(
  project: LoadedProject,
  selector: SourceMapFunctionSelector,
  root: Str,
  stdlib_root: Str
): Str {
  mut entries: [GuardConversionEvidence] = []
  mut found_function: Bool = false
  for body in project.module_bodies {
    if body.signature.binding.identity == selector.identity {
      found_function = true
      entries = concat(entries, body_guard_conversions(body.body))
    }
  }
  mut output: Str = "guarded conversions:"
  if !found_function {
    output = output + " unavailable\nreason: no checked body was retained for this function"
  } else {
    if len(entries) == 0 {
      output = output + " none"
    } else {
      for entry in entries {
        output = output + "\n\n" + render_guard_conversion(
          entry,
          project.sources,
          root,
          stdlib_root
        )
      }
    }
  }
  output
}

pure render_inferred_local_explanations(
  project: LoadedProject,
  selector: SourceMapFunctionSelector,
  root: Str,
  stdlib_root: Str
): Str {
  mut entries: [BoundBody] = []
  mut found_function: Bool = false
  for function in project.module_bodies {
    if function.signature.binding.identity == selector.identity {
      found_function = true
      entries = concat(entries, body_inferred_locals(function.body))
    }
  }
  mut output: Str = "inferred locals:"
  if !found_function {
    output = output + " unavailable\nreason: no checked body was retained for this function"
  } else {
    if len(entries) == 0 {
      output = output + " none"
    } else {
      for entry in entries {
        output = output + "\n\n" + render_inferred_local(
          entry,
          project.sources,
          root,
          stdlib_root
        )
      }
    }
  }
  output
}

pub pure render_function_explanations(
  project: LoadedProject,
  selector: SourceMapFunctionSelector,
  accepted: Bool,
  root: Str,
  stdlib_root: Str
): Str {
  mut output: Str = render_subtraction_explanations(
    project,
    selector,
    selector.display_name,
    selector.source_path,
    accepted,
    root,
    stdlib_root
  )
  output = output + "\n\n" + render_guard_conversion_explanations(
    project,
    selector,
    root,
    stdlib_root
  )
  output = output + "\n\n" + render_inferred_local_explanations(
    project,
    selector,
    root,
    stdlib_root
  )
  output = output + "\n\n" + render_return_type_explanation(
    project,
    selector,
    root,
    stdlib_root
  )
  output = output + "\n\n" + render_call_argument_explanations(
    project,
    selector,
    root,
    stdlib_root
  )
  output = output + "\n\n" + render_binding_type_explanations(
    project,
    selector,
    root,
    stdlib_root
  )
  output = output + "\n\n" + render_assignment_type_explanations(
    project,
    selector,
    root,
    stdlib_root
  )
  output = output + "\n\n" + render_type_join_explanations(
    project, selector, root, stdlib_root
  )
  output = output + "\n\n" + render_operator_type_explanations(
    project, selector, root, stdlib_root
  )
  output = output + "\n\n" + render_type_check_explanations(
    project, selector, root, stdlib_root
  )
  output = output + "\n\n" + render_call_arity_explanations(
    project, selector, root, stdlib_root
  )
  output = output + "\n\n" + render_type_argument_arity_explanations(
    project, selector, root, stdlib_root
  )
  output = output + "\n\n" + render_collection_callback_explanations(
    project,
    selector,
    root,
    stdlib_root
  )
  output = output + "\n\neffect scope: local call and await boundaries; declarations and callable types, not transitive/runtime effects"

  if !project.effects_checked {
    output = output + "\neffects: unavailable\nreason: loading, resolution or global declaration checking prevented the effect pass"
  } else {
    function_effect_status: Str = explanation_function_effect_status(project, selector)
    if function_effect_status == "unavailable" {
      output = output + "\neffects: unavailable\nreason: function body type checking prevented the effect pass for this function"
    } else {
      mut count: Nat = 0
      for entry in project.effects {
        if (entry.function_name == selector.identity.name || entry.function_name == selector.emitted_name) &&
          explanation_span_matches(entry.span, selector.source_path) {
          output = output + "\n\n" + render_effect_evidence(
            entry,
            project.sources,
            root,
            stdlib_root
          )
          count = count + 1
        }
      }
      if count == 0 {
        output = output + "\neffects: unavailable\nreason: no call or await boundary was retained for this function"
      } else {
        if function_effect_status == "deferred" {
          output = output + "\n\nfunction status: type checking is deferred; these are the effect boundaries the checker retained"
        }
      }
    }
  }

  output
}
