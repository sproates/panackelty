pure render_type_join_evidence(
  evidence: TypeJoinEvidence,
  sources: Map[Str, Str],
  root: Str,
  stdlib_root: Str
): Str {
  status: Str = match evidence.accepted {
    Some(accepted) => if accepted { "accepted" } else { "rejected" },
    None() => "unavailable"
  }
  context: Str = source_map_escape(evidence.context)
  left: Str = source_map_escape(render_inferred_type(evidence.left))
  right: Str = source_map_escape(render_inferred_type(evidence.right))
  result: Str = source_map_escape(render_inferred_type(evidence.result))
  "checked type join: ${status}\ncontext: ${context}\n" + explanation_location(
    Some(evidence.span), sources, root, stdlib_root
  ) + "\ninput types: ${left} and ${right}\nresulting type: ${result}" + match evidence.accepted {
    Some(accepted) => if accepted {
      "\nreason: the checker combined these input types using its existing compatibility rules"
    } else {
      "\nreason: the checker rejected these incompatible input types"
    },
    None() => "\nreason: the checker did not determine a complete join from the available input types"
  }
}

pure render_type_join_explanations(
  project: LoadedProject,
