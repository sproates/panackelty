// Literal decoding and scalar arithmetic rules shared by the legacy and bound
// frontends. Nominal type identity belongs to the module passes.

pub record InterpolatedString {
  parts: [Str],
  variables: [Str],
  invalid: Option[Nat]
}

// The lexer has already found the string boundary. Unknown escapes retain their
// escaped character, matching the existing literal contract.
pub pure decoded_escape(escape: Str): Str {
  mut decoded: Str = escape

  if escape == "n" {
    decoded = "\n"
  }
  if escape == "r" {
    decoded = "\r"
  }
  if escape == "t" {
    decoded = "\t"
  }
  if escape == "b" {
    decoded = "\b"
  }
  if escape == "f" {
    decoded = "\f"
  }
  decoded
}

pub pure decode_string_literal(text: Str): Str {
  mut output: Str = ""
  mut cursor: Nat = 1

  while cursor + 1 < text.len() {
    character: Str = text[cursor]
    if character == "\\" && cursor + 2 < text.len() {
      escape: Str = text[cursor + 1]
      output = output + decoded_escape(escape)
      cursor = cursor + 2
    } else {
      output = output + character
      cursor = cursor + 1
    }
  }

  output
}

pub pure interpolation_name_start(character: Str): Bool {
  character.is_letter() || character == "_"
}

pub pure interpolation_name_part(character: Str): Bool {
  interpolation_name_start(character) || character.is_digit()
}

pub pure split_interpolated_string(text: Str): InterpolatedString {
  mut parts: [Str] = []
  mut variables: [Str] = []
  mut part_start: Nat = 0
  mut cursor: Nat = 0

  mut invalid: Option[Nat] = None()
  while cursor + 1 < text.len() {
    if text[cursor] == "$" && text[cursor + 1] == "{" {
      mut end: Nat = cursor + 2
      valid_start = end < text.len() && interpolation_name_start(text[end])
      while end < text.len() && interpolation_name_part(text[end]) {
        end = end + 1
      }
      if valid_start && end < text.len() && text[end] == "}" {
        parts = parts.append(text.slice(part_start, cursor))
        variables = variables.append(text.slice(cursor + 2, end))
        cursor = end + 1
        part_start = cursor
      } else {
        // A bare opening sequence is also used when building source text.
        while end < text.len() && text[end] != "}" { end = end + 1 }
        if end < text.len() && invalid == None() { invalid = Some(cursor) }
        cursor = end
      }
    } else {
      cursor = cursor + 1
    }
  }
  if variables.len() == 0 {
    InterpolatedString([], [], invalid)
  } else {
    parts = parts.append(text.slice(part_start, text.len()))
    InterpolatedString(parts, variables, invalid)
  }
}

pub pure scalar_numeric(name: Str): Bool {
  name == "Nat" || name == "Int" || name == "Dec" || name == "Rat"
}

pub pure scalar_compatible_numeric(left: Str, right: Str): Bool {
  scalar_numeric(left) &&
    scalar_numeric(right) &&
    !((left == "Dec" ||
    right == "Dec") &&
    left != right)
}

pub pure scalar_arithmetic_result(operator: Str, left: Str, right: Str): Str {
  if left == "Dec" {
    "Dec"
  } else {
    if operator == "/" || left == "Rat" || right == "Rat" {
      "Rat"
    } else {
      if left == "Int" || right == "Int" {
        "Int"
      } else {
        "Nat"
      }
    }
  }
}
