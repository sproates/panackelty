import "types.panack"

record StringScan {
  end: Nat,
  terminated: Bool
}

pure scan_digits(source: Str, start: Nat): Nat {
  mut cursor: Nat = start
  while cursor < len(source) && is_digit(source[cursor]) {
    cursor = cursor + 1
  }
  cursor
}

pure scan_identifier(source: Str, start: Nat): Nat {
  mut cursor: Nat = start
  while cursor < len(source) && (is_letter(source[cursor]) || is_digit(source[cursor]) || source[cursor] == "_") {
    cursor = cursor + 1
  }
  cursor
}

pure scan_comment(source: Str, start: Nat): Nat {
  mut cursor: Nat = start
  while cursor < len(source) && source[cursor] != "\n" {
    cursor = cursor + 1
  }
  cursor
}

pure scan_string(source: Str, start: Nat): StringScan {
  mut cursor: Nat = start + 1
  mut escaped: Bool = false
  mut terminated: Bool = false
  while cursor < len(source) && !terminated {
    if escaped {
      escaped = false
    } else {
      if source[cursor] == "\\" {
        escaped = true
      } else {
        if source[cursor] == "\"" {
          terminated = true
        } else {
        }
      }
    }
    cursor = cursor + 1
  }
  StringScan(cursor, terminated)
}

pure advance_position(source: Str, start: Nat, end: Nat, position: SourcePos): SourcePos {
  mut cursor: Nat = start
  mut line: Nat = position.line
  mut column: Nat = position.column
  while cursor < end {
    if source[cursor] == "\n" { line = line + 1; column = 1; }
    else { column = column + 1; }
    cursor = cursor + 1
  }
  SourcePos(position.file, end, line, column)
}

pure source_token(source: Str, kind: TokenKind, text: Str, start: Nat, end: Nat, position: SourcePos): Token {
  end_position: SourcePos = advance_position(source, start, end, position)
  Token(kind, text, start, end, position, end_position.line, end_position.column)
}

pure is_two_character_symbol(source: Str, cursor: Nat): Bool {
  starts_with_at(source, "=>", cursor) ||
  starts_with_at(source, "..", cursor) ||
  starts_with_at(source, "==", cursor) ||
  starts_with_at(source, "!=", cursor) ||
  starts_with_at(source, "<=", cursor) ||
  starts_with_at(source, ">=", cursor) ||
  starts_with_at(source, "&&", cursor) ||
  starts_with_at(source, "||", cursor)
}

pure is_single_character_symbol(character: Str): Bool {
  character == "(" || character == ")" ||
  character == "{" || character == "}" ||
  character == "[" || character == "]" ||
  character == "." || character == "," ||
  character == ";" || character == ":" || character == "=" ||
  character == "@" ||
  character == "+" || character == "-" || character == "*" ||
  character == "/" || character == "%" ||
  character == "<" || character == ">" || character == "!"
}

pure is_line_prefix_keyword(text: Str): Bool {
  text == "pure" || text == "import" || text == "type" ||
  text == "record" || text == "enum" || text == "mut" ||
  text == "for" || text == "while" || text == "if" ||
  text == "match" || text == "where" || text == "in"
}

pure is_line_continuation_keyword(text: Str): Bool {
  text == "else" || text == "where" || text == "in"
}

pure token_can_end_statement(token: Token): Bool {
  ((token.kind == Identifier() || token.kind == Number() ||
    token.kind == DecimalNumber() || token.kind == StringLiteral()) &&
   !is_line_prefix_keyword(token.text)) ||
  token.text == ")" || token.text == "]" || token.text == "}"
}

pure token_can_start_statement(token: Token): Bool {
  !is_line_continuation_keyword(token.text) &&
  (token.kind == Identifier() || token.kind == Number() ||
   token.kind == DecimalNumber() || token.kind == StringLiteral() ||
   token.text == "(" || token.text == "[")
}

pure prior_index(value: Nat): Nat {
  if value == 0 { 0 } else { value - 1 }
}

pure normalize_line_breaks(tokens: [Token]): [Token] {
  mut result: [Token] = []
  mut soft_depth: Nat = 0
  mut brace_depth: Nat = 0
  mut brace_soft_depths: Map[Nat,Nat] = map()
  mut index: Nat = 0

  while index < len(tokens) {
    token: Token = tokens[index]
    if token.text == "\n" {
      mut next_index: Nat = index + 1
      while next_index < len(tokens) && tokens[next_index].text == "\n" {
        next_index = next_index + 1
      }
      baseline: Nat = if brace_depth > 0 && brace_soft_depths.has(brace_depth) {
        brace_soft_depths.get(brace_depth)
      } else {
        0
      }
      if soft_depth <= baseline && len(result) > 0 && next_index < len(tokens) &&
          token_can_end_statement(result[prior_index(len(result))]) &&
          token_can_start_statement(tokens[next_index]) {
        result = append(result, Token(Punctuation(), ";", token.start, token.end, token.position, token.end_line, token.end_column))
      }
    } else {
      result = append(result, token)
      if token.text == "(" || token.text == "[" {
        soft_depth = soft_depth + 1
      } else {
        if (token.text == ")" || token.text == "]") && soft_depth > 0 {
          soft_depth = prior_index(soft_depth)
        } else {
          if token.text == "{" {
            brace_depth = brace_depth + 1
            brace_soft_depths = brace_soft_depths.put(brace_depth, soft_depth)
          } else {
            if token.text == "}" && brace_depth > 0 {
              brace_depth = prior_index(brace_depth)
            }
          }
        }
      }
    }
    index = index + 1
  }

  result
}

pure lex_file(source: Str, file: Str): Result[[Token],[Diagnostic]] {
  mut tokens: [Token] = []
  mut diagnostics: [Diagnostic] = []
  mut cursor: Nat = 0
  mut current_position: SourcePos = SourcePos(file, 0, 1, 1)

  while cursor < len(source) {
    iteration_start: Nat = cursor
    character: Str = source[cursor]
    if character == "\n" {
      end: Nat = cursor + 1
      tokens = append(tokens, source_token(source, Punctuation(), "\n", cursor, end, current_position))
      cursor = end
    } else {
      if is_whitespace(character) {
        cursor = cursor + 1
      } else {
        if starts_with_at(source, "//", cursor) {
          cursor = scan_comment(source, cursor + 2)
        } else {
          if is_digit(character) {
            integer_end: Nat = scan_digits(source, cursor)
            if integer_end < len(source) && source[integer_end] == "." && integer_end + 1 < len(source) && is_digit(source[integer_end + 1]) {
              end: Nat = scan_digits(source, integer_end + 1)
              tokens = append(tokens, source_token(source, DecimalNumber(), slice(source, cursor, end), cursor, end, current_position))
              cursor = end
            } else {
              tokens = append(tokens, source_token(source, Number(), slice(source, cursor, integer_end), cursor, integer_end, current_position))
              cursor = integer_end
            }
          } else {
            if is_letter(character) || character == "_" {
              end: Nat = scan_identifier(source, cursor)
              tokens = append(tokens, source_token(source, Identifier(), slice(source, cursor, end), cursor, end, current_position))
              cursor = end
            } else {
              if character == "\"" {
                scanned: StringScan = scan_string(source, cursor)
                end: Nat = scanned.end
                if !scanned.terminated {
                  diagnostics = append(diagnostics, Diagnostic("unterminated string", current_position))
                }
                tokens = append(tokens, source_token(source, StringLiteral(), slice(source, cursor, end), cursor, end, current_position))
                cursor = end
              } else {
                if is_two_character_symbol(source, cursor) {
                  end: Nat = cursor + 2
                  tokens = append(tokens, source_token(source, Punctuation(), slice(source, cursor, end), cursor, end, current_position))
                  cursor = end
                } else {
                  if is_single_character_symbol(character) {
                    end: Nat = cursor + 1
                    tokens = append(tokens, source_token(source, Punctuation(), character, cursor, end, current_position))
                    cursor = end
                  } else {
                    diagnostics = append(diagnostics, Diagnostic("unexpected character ${character}", current_position))
                    cursor = cursor + 1
                  }
                }
              }
            }
          }
        }
      }
    }
    current_position = advance_position(source, iteration_start, cursor, current_position)
  }

  if len(diagnostics) == 0 { Ok(normalize_line_breaks(tokens)) } else { Error(diagnostics) }
}

pure lex(source: Str): Result[[Token],[Diagnostic]] {
  lex_file(source, "")
}

pure kind_name(kind: TokenKind): Str {
  match kind {
    Identifier() => "identifier",
    Number() => "number",
    DecimalNumber() => "decimal",
    StringLiteral() => "string",
    Punctuation() => "punctuation"
  }
}

pure render_tokens(tokens: [Token]): Str {
  mut output: Str = ""
  for token in tokens {
    name: Str = kind_name(token.kind)
    text: Str = token.text
    output = output + "${name}:${text}\n"
  }
  output
}

pure render_diagnostics(diagnostics: [Diagnostic]): Str {
  mut output: Str = ""
  for diagnostic in diagnostics {
    line: Nat = diagnostic.position.line
    column: Nat = diagnostic.position.column
    message: Str = diagnostic.message
    output = output + "${line}:${column}: ${message}\n"
  }
  output
}

pure render(result: Result[[Token],[Diagnostic]]): Str {
  match result {
    Ok(tokens) => render_tokens(tokens),
    Error(diagnostics) => render_diagnostics(diagnostics)
  }
}
