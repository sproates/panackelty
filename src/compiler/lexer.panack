pub import project/src/compiler/types::{SourcePos, SourceSpan, TokenKind, TokenKind.Identifier, TokenKind.Number, TokenKind.DecimalNumber, TokenKind.StringLiteral, TokenKind.Punctuation, Token, Diagnostic}

// Scan Unicode source while retaining original offsets and line/column positions.
// Physical line breaks become separators only at statement boundaries.

pub record StringScan {
  end: Nat,
  terminated: Bool
}

pure scan_digits(source: Str, start: Nat): Nat {
  mut cursor: Nat = start

  while cursor < source->len() && source[cursor]->is_digit() {
    cursor = cursor + 1
  }

  cursor
}

pure scan_identifier(source: Str, start: Nat): Nat {
  mut cursor: Nat = start

  while cursor < source->len() &&
    (source[cursor]->is_letter() ||
    source[cursor]->is_digit() ||
    source[cursor] == "_") {
    cursor = cursor + 1
  }

  cursor
}

pure scan_comment(source: Str, start: Nat): Nat {
  mut cursor: Nat = start

  while cursor < source->len() && source[cursor] != "\n" {
    cursor = cursor + 1
  }

  cursor
}

pub pure scan_string(source: Str, start: Nat): StringScan {
  mut cursor: Nat = start + 1
  mut escaped: Bool = false
  mut terminated: Bool = false

  // An escape consumes exactly one character. Only an unescaped quote closes
  // the token; the cursor returned to the lexer includes that closing quote.
  while cursor < source->len() && !terminated {
    if escaped {
      escaped = false
    } else {
      escaped = source[cursor] == "\\"
      terminated = source[cursor] == "\""
    }
    cursor = cursor + 1
  }

  StringScan(cursor, terminated)
}

pure advance_position(source: Str, start: Nat, end: Nat, position: SourcePos): SourcePos {
  mut cursor: Nat = start
  mut line: Nat = position.line
  mut column: Nat = position.column

  while cursor < end {
    if source[cursor] == "\n" {
      line = line + 1
      column = 1
    } else {
      column = column + 1
    }
    cursor = cursor + 1
  }
  SourcePos(position.file, end, line, column)
}

pure source_token(
  source: Str,
  kind: TokenKind,
  text: Str,
  start: Nat,
  end: Nat,
  position: SourcePos
): Token {
  end_position: SourcePos = advance_position(source, start, end, position)
  Token(kind, text, start, end, position, end_position.line, end_position.column)
}

pure is_two_character_symbol(source: Str, cursor: Nat): Bool {
  source->starts_with_at("=>", cursor) ||
    source->starts_with_at("->", cursor) ||
    source->starts_with_at("..", cursor) ||
    source->starts_with_at("==", cursor) ||
    source->starts_with_at("!=", cursor) ||
    source->starts_with_at("<=", cursor) ||
    source->starts_with_at(">=", cursor) ||
    source->starts_with_at("&&", cursor) ||
    source->starts_with_at("||", cursor)
}

pure is_single_character_symbol(character: Str): Bool {
  character == "(" || character == ")" ||
    character == "{" || character == "}" ||
    character == "[" || character == "]" ||
    character == "." || character == "," ||
    character == ";" || character == ":" || character == "=" ||
    character == "@" ||
    character == "+" || character == "-" || character == "*" ||
    character == "/" || character == "%" ||
    character == "<" || character == ">" || character == "!"
}

pure is_line_prefix_keyword(text: Str): Bool {
  text == "pure" || text == "import" || text == "type" ||
    text == "record" || text == "enum" || text == "mut" ||
    text == "for" || text == "while" || text == "if" ||
    text == "match" || text == "else" || text == "where" || text == "in"
}

pure is_line_continuation_keyword(text: Str): Bool {
  text == "else" || text == "where" || text == "in"
}

pure token_can_end_statement(token: Token): Bool {
  ((token.kind == Identifier() || token.kind == Number() ||
    token.kind == DecimalNumber() || token.kind == StringLiteral()) &&
    !is_line_prefix_keyword(token.text)) ||
    token.text == ")" || token.text == "]" || token.text == "}"
}

pure token_can_start_statement(token: Token): Bool {
  !is_line_continuation_keyword(token.text) &&
    (token.kind == Identifier() || token.kind == Number() ||
    token.kind == DecimalNumber() || token.kind == StringLiteral() ||
    token.text == "(" || token.text == "[")
}

pub pure prior_index(value: Nat): Nat {
  if value == 0 {
    0
  } else {
    value - 1
  }
}

pure normalize_line_breaks(tokens: [Token]): [Token] {
  mut result: [Token] = []
  mut soft_depth: Nat = 0
  mut brace_depth: Nat = 0
  mut brace_soft_depths: Map[Nat, Nat] = map()
  mut index: Nat = 0

  while index < tokens->len() {
    token: Token = tokens[index]
    if token.text == "\n" {
      mut next_index: Nat = index + 1
      while next_index < tokens->len() && tokens[next_index].text == "\n" {
        next_index = next_index + 1
      }
      baseline: Nat = if brace_depth > 0 && brace_soft_depths->has(brace_depth) {
        brace_soft_depths->get(brace_depth)
      } else {
        0
      }
      if soft_depth <= baseline && result->len() > 0 && next_index < tokens->len() &&
        token_can_end_statement(result[prior_index(result->len())]) &&
        token_can_start_statement(tokens[next_index]) {
        result = result->append(
          Token(
          Punctuation(),
          ";",
          token.start,
          token.end,
          token.position,
          token.end_line,
          token.end_column
        )
        )
      }
    } else {
      result = result->append(token)
      if token.text == "(" || token.text == "[" {
        soft_depth = soft_depth + 1
      } else {
        if (token.text == ")" || token.text == "]") && soft_depth > 0 {
          soft_depth = prior_index(soft_depth)
        } else {
          if token.text == "{" {
            brace_depth = brace_depth + 1
            brace_soft_depths = brace_soft_depths->put(brace_depth, soft_depth)
          } else {
            if token.text == "}" && brace_depth > 0 {
              brace_depth = prior_index(brace_depth)
            }
          }
        }
      }
    }
    index = index + 1
  }

  result
}

pub pure lex_file(source: Str, file: Str): Result[[Token], [Diagnostic]] {
  mut tokens: [Token] = []
  mut diagnostics: [Diagnostic] = []
  mut cursor: Nat = 0
  mut current_position: SourcePos = SourcePos(file, 0, 1, 1)

  while cursor < source->len() {
    iteration_start: Nat = cursor
    character: Str = source[cursor]
    if character == "\n" {
      end: Nat = cursor + 1
      tokens = tokens->append(
        source_token(source, Punctuation(), "\n", cursor, end, current_position)
      )
      cursor = end
    } else {
      if character->is_whitespace() {
        cursor = cursor + 1
      } else {
        if source->starts_with_at("//", cursor) {
          cursor = scan_comment(source, cursor + 2)
        } else {
          if character->is_digit() {
            integer_end: Nat = scan_digits(source, cursor)
            if integer_end < source->len() &&
              source[integer_end] == "." &&
              integer_end + 1 < source->len() &&
              source[integer_end + 1]->is_digit() {
              end: Nat = scan_digits(source, integer_end + 1)
              tokens = tokens->append(
                source_token(
                source,
                DecimalNumber(),
                source->slice(cursor, end),
                cursor,
                end,
                current_position
              )
              )
              cursor = end
            } else {
              tokens = tokens->append(
                source_token(
                source,
                Number(),
                source->slice(cursor, integer_end),
                cursor,
                integer_end,
                current_position
              )
              )
              cursor = integer_end
            }
          } else {
            if character->is_letter() || character == "_" {
              end: Nat = scan_identifier(source, cursor)
              tokens = tokens->append(
                source_token(
                source,
                Identifier(),
                source->slice(cursor, end),
                cursor,
                end,
                current_position
              )
              )
              cursor = end
            } else {
              if character == "\"" {
                scanned: StringScan = scan_string(source, cursor)
                end: Nat = scanned.end
                if !scanned.terminated {
                  diagnostics = diagnostics->append(
                    Diagnostic("unterminated string", current_position)
                  )
                }
                tokens = tokens->append(
                  source_token(
                  source,
                  StringLiteral(),
                  source->slice(cursor, end),
                  cursor,
                  end,
                  current_position
                )
                )
                cursor = end
              } else {
                if is_two_character_symbol(source, cursor) {
                  end: Nat = cursor + 2
                  tokens = tokens->append(
                    source_token(
                    source,
                    Punctuation(),
                    source->slice(cursor, end),
                    cursor,
                    end,
                    current_position
                  )
                  )
                  cursor = end
                } else {
                  if is_single_character_symbol(character) {
                    end: Nat = cursor + 1
                    tokens = tokens->append(
                      source_token(source, Punctuation(), character, cursor, end, current_position)
                    )
                    cursor = end
                  } else {
                    diagnostics = diagnostics->append(
                      Diagnostic("unexpected character ${character}", current_position)
                    )
                    cursor = cursor + 1
                  }
                }
              }
            }
          }
        }
      }
    }
    current_position = advance_position(source, iteration_start, cursor, current_position)
  }

  if diagnostics->len() == 0 {
    Ok(normalize_line_breaks(tokens))
  } else {
    Error(diagnostics)
  }
}

pub pure lex(source: Str): Result[[Token], [Diagnostic]] {
  lex_file(source, "")
}

pure kind_name(kind: TokenKind): Str {
  match kind {
    Identifier() => "identifier",
    Number() => "number",
    DecimalNumber() => "decimal",
    StringLiteral() => "string",
    Punctuation() => "punctuation"
  }
}

pure render_tokens(tokens: [Token]): Str {
  mut output: Str = ""

  for token in tokens {
    name: Str = kind_name(token.kind)
    text: Str = token.text
    output = output + "${name}:${text}\n"
  }

  output
}

pure render_diagnostics(diagnostics: [Diagnostic]): Str {
  mut output: Str = ""

  for diagnostic in diagnostics {
    line: Nat = diagnostic.position.line
    column: Nat = diagnostic.position.column
    message: Str = diagnostic.message
    output = output + "${line}:${column}: ${message}\n"
  }

  output
}

pub pure render(result: Result[[Token], [Diagnostic]]): Str {
  match result {
    Ok(tokens) => render_tokens(tokens),
    Error(diagnostics) => render_diagnostics(diagnostics)
  }
}
