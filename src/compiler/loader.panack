  CheckedModuleBodies, check_module_guards, body_subtraction_evidence_entries, BodyCheckStatus.BodyIdentityChecked, check_module_bodies, check_module_bodies_explained
}
import project/src/compiler/module_effects::{CheckedModuleEffects, check_module_effects}
import project/src/compiler/module_bindings::{ModuleBindings, ModuleIdentity, ModuleDeclarationKind.ModuleFunction, collect_module_bindings, loaded_module_declaration_index, module_binding_diagnostics, source_module_identity, source_package_module_identity, module_relative_path, module_programs}
import project/src/compiler/module_signatures::{CheckedModuleSignatures, check_module_signatures}
import project/src/compiler/module_resolution::{ModuleImportEdge, module_graph_diagnostics}
