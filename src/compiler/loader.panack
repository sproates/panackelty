import project/src/compiler/package_manifest::{PackageManifestExport}

// Resolve and read the module closure once, preserving traversal order and original
// source snapshots. Host I/O belongs here rather than in the pure frontend.

record ProjectLoadState {
  modules: [LoadedModule],
  visited: Set[Str],
  diagnostics: [Diagnostic],
  sources: Map[Str, Str],
  source_paths: [Str]
}

pub record LoadedProject {
  program: Program,
  modules: [LoadedModule],
  diagnostics: [Diagnostic],
  sources: Map[Str, Str],
  source_paths: [Str],
  evidence: [SubtractionEvidence],
  effects: [EffectEvidence],
  effects_checked: Bool,
  identity_ready: Bool,
  function_types: Map[Str, Bool],
  module_signatures: [ModuleSignature],
  module_bodies: [BoundFunctionBody]
}

pure path_in_stack(stack: [Str], path: Str): Bool {
  mut found: Bool = false

  for item in stack {
    if item == path {
      found = true
    } else {}
  }

  found
}

pure loader_diagnostic(message: Str): Diagnostic {
  Diagnostic(message, SourcePos("", 0, 1, 1))
}

pure is_logical_import(path: Str): Bool {
  path.starts_with_at("stdlib/", 0) || path.starts_with_at("project/", 0)
}

pure logical_import_without_suffix(path: Str): Str {
  mut output: Str = ""
  mut index: Nat = 0

  while index < path.len() {
    if path.starts_with_at(".panack", index) && index + ".panack".len() == path.len() {
      index = path.len()
    } else {
      output = output + path[index]
      index = index + 1
    }
  }

  output
}

pure logical_import_segments_valid(path: Str): Bool {
  mut valid: Bool = path.len() > 0
  mut segment_start: Bool = true
  mut index: Nat = 0

  while index < path.len() {
    character: Str = path[index]
    if character == "/" {
      if segment_start {
        valid = false
      } else {}
      segment_start = true
    } else {
      if segment_start {
        if !(character.is_letter() || character == "_") {
          valid = false
        } else {}
        segment_start = false
      } else {
        if !(character.is_letter() || character.is_digit() || character == "_") {
          valid = false
        } else {}
      }
    }
    index = index + 1
  }
  valid && !segment_start
}

pure logical_import_valid(path: Str): Bool {
  suffix: Str = path_support.suffix(path)
  without_suffix: Str = logical_import_without_suffix(path)
  relative: Str = if without_suffix.starts_with_at("stdlib/", 0) {
    without_suffix.slice("stdlib/".len(), without_suffix.len())
  } else {
    if without_suffix.starts_with_at("project/", 0) {
      without_suffix.slice("project/".len(), without_suffix.len())
    } else {
      without_suffix
    }
  }
  (suffix == "" || suffix == ".panack") && logical_import_segments_valid(relative)
}

pure resolve_import_path(imported: Str, parent: Str, project_root: Str, stdlib_root: Str): Str {
  if imported.starts_with_at("stdlib/", 0) {
    without_suffix: Str = logical_import_without_suffix(imported)
    relative: Str = without_suffix.slice("stdlib/".len(), without_suffix.len())
    path_support.join(stdlib_root, "${relative}.panack")
  } else {
    if imported.starts_with_at("project/", 0) {
      without_suffix: Str = logical_import_without_suffix(imported)
      relative: Str = without_suffix.slice("project/".len(), without_suffix.len())
      path_support.join(project_root, "${relative}.panack")
    } else {
      path_support.join(parent, imported)
    }
  }
}

pure package_dependency_import(
  imported: Str,
  owner_root_identity: FilesystemRootIdentity,
  dependencies: [ManifestDependencyProject]
): Bool {
  mut found: Bool = false
  for dependency in dependencies {
    found = found || (dependency.owner_root_identity == owner_root_identity &&
      imported.starts_with_at(dependency.alias + "/", 0))
  }
  found
}

pure package_owner_identity(
  path: Str,
  project_root_identity: FilesystemRootIdentity,
  dependencies: [ManifestDependencyProject]
): FilesystemRootIdentity {
  mut identity: FilesystemRootIdentity = project_root_identity
  for dependency in dependencies {
    if loader_path_within(path, dependency.source_root) {
      identity = dependency.root_identity
    }
  }
  identity
}

pure package_owner_source_root(
  path: Str,
  project_root: Str,
  dependencies: [ManifestDependencyProject]
): Str {
  mut root: Str = project_root
  for dependency in dependencies {
    if loader_path_within(path, dependency.source_root) {
      root = dependency.source_root
    }
  }
  root
}

pure package_owner_root(
  path: Str,
  package_root: Str,
  dependencies: [ManifestDependencyProject]
): Str {
  mut root: Str = package_root
  for dependency in dependencies {
    if loader_path_within(path, dependency.source_root) {
      root = dependency.package_root
    }
  }
  root
}

pure package_owner_name(
  path: Str,
  package_name: Str,
  dependencies: [ManifestDependencyProject]
): Str {
  mut name: Str = package_name
  for dependency in dependencies {
    if loader_path_within(path, dependency.source_root) {
      name = dependency.package
    }
  }
  name
}

pure package_owner_version(
  path: Str,
  package_version: Str,
  dependencies: [ManifestDependencyProject]
): Str {
  mut version: Str = package_version
  for dependency in dependencies {
    if loader_path_within(path, dependency.source_root) {
      version = dependency.version
    }
  }
  version
}

pure package_source_contains(
  path: Str,
  project_root: Str,
  stdlib_root: Str,
  dependencies: [ManifestDependencyProject]
): Bool {
  mut within: Bool = loader_path_within(path, project_root) || loader_path_within(path, stdlib_root)
  for dependency in dependencies {
    within = within || loader_path_within(path, dependency.source_root)
  }
  within
}

pure package_import_export_path(
  imported: Str,
  owner_root_identity: FilesystemRootIdentity,
  dependencies: [ManifestDependencyProject]
): Option[Str] {
  mut found: Option[Str] = None()
  mut selected_count: Nat = 0
  for dependency in dependencies {
    if dependency.owner_root_identity == owner_root_identity &&
        imported.starts_with_at(dependency.alias + "/", 0) {
      logical: Str = logical_import_without_suffix(imported)
      module: Str = logical.slice(dependency.alias.len() + 1, logical.len())
      for exported in dependency.exported_modules {
        if exported.module == module {
          found = Some(path_support.join(dependency.source_root, exported.path))
          selected_count = selected_count + 1
        }
      }
    }
  }
  if selected_count == 1 { found } else { None() }
}

pure resolve_package_import_path(
  imported: Str,
  parent: Str,
  project_root: Str,
  stdlib_root: Str,
  owner_root_identity: FilesystemRootIdentity,
  dependencies: [ManifestDependencyProject]
): Result[Str, Str] {
  if imported.starts_with_at("stdlib/", 0) || imported.starts_with_at("project/", 0) {
    if imported.starts_with_at("stdlib/", 0) && stdlib_root.len() == 0 {
      Error("standard library root is not configured")
    } else {
      Ok(resolve_import_path(imported, parent, project_root, stdlib_root))
    }
  } else if package_dependency_import(imported, owner_root_identity, dependencies) {
    match package_import_export_path(imported, owner_root_identity, dependencies) {
      Some(path) => Ok(path),
      None() => Error("dependency import is not declared or the module is not exported: ${imported}")
    }
  } else if path_support.suffix(imported) == ".panack" {
    Ok(path_support.join(parent, imported))
  } else {
    Error("dependency import is not declared or the module is not exported: ${imported}")
  }
}

pure loader_path_within(path: Str, root: Str): Bool {
  if root == "/" {
    path.starts_with_at("/", 0)
  } else {
    path == root || path.starts_with_at(root + "/", 0)
  }
}

loader_path_component_is_symlink(path: Str): Bool {
  match std_path.from_text(path) {
    Error(error) => true,
    Ok(file) => match std_filesystem.metadata(file) {
      Error(error) => false,
      Ok(metadata) => metadata.kind == SymbolicLink()
    }
  }
}

loader_path_has_symlink(path: Str, root: Str, allow_leaf_symlink: Bool): Bool {
  if !loader_path_within(path, root) {
    true
  } else {
    relative: Str = if path == root {
      ""
    } else {
      if root == "/" { path.slice(1, path.len()) } else { path.slice(root.len() + 1, path.len()) }
    }
    mut current: Str = root
    mut segment: Str = ""
    mut found: Bool = false
    mut index: Nat = 0
    while index < relative.len() {
      character: Str = relative[index]
      if character == "/" {
        if segment.len() > 0 {
          current = path_support.join(current, segment)
          found = found || loader_path_component_is_symlink(current)
          segment = ""
        } else {}
      } else {
        segment = segment + character
      }
      index = index + 1
    }
    if segment.len() > 0 {
      current = path_support.join(current, segment)
      if !allow_leaf_symlink {
        found = found || loader_path_component_is_symlink(current)
      } else {}
    } else {}
    found
  }
}

pub read_project_source(
  path: Str,
  bounded: Bool,
  paths: [Str],
  sources: Map[Str, Str]
): Result[Str, Str] {
  if !bounded {
    Ok(filesystem_support.read_text(path))
  } else {
    mut total: Nat = 0
    for loaded in paths {
      total = total + sources.get(loaded).encode_utf8().length()
    }
    if paths.len() >= 256 || total > 8388608 {
      Error("source-map source closure limit exceeded")
    } else {
      match std_path.from_text(path) {
        Error(error) => Error("invalid source path"),
        Ok(file) => match std_filesystem.read(file, 1048576) {
          Error(error) => Error("source-map source unavailable or exceeds 1 MiB"),
          Ok(data) => {
            if total + data.length() > 8388608 {
              Error("source-map source closure exceeds 8 MiB")
            } else {
              if !valid_utf8(data) {
                Error("source-map source is not valid UTF-8")
              } else {
                Ok(data.decode_utf8())
              }
            }
          }
        }
      }
    }
  }
}

pub read_package_source(
  path: Str,
  package_root: Str,
  expected_root_identity: Option[FilesystemRootIdentity],
  bounded: Bool,
  paths: [Str],
  sources: Map[Str, Str]
): Result[Str, Str] {
  if !loader_path_within(path, package_root) {
    Error("package source path escapes its physical root")
  } else {
    mut total: Nat = 0
    for loaded in paths {
      total = total + sources.get(loaded).encode_utf8().length()
    }
    relative: Str = module_relative_path(path, package_root)
    if paths.len() >= 256 || total > 8388608 {
      Error("package source closure limit exceeded")
    } else {
      match std_path.from_text(package_root) {
        Error(error) => Error("invalid package root path"),
        Ok(root) => match std_path.from_text(relative) {
          Error(error) => Error("invalid package-relative source path"),
          Ok(source) => match std_package_filesystem.read_beneath(root, source, 1048576) {
            Error(problem) => {
              code: Str = problem.code
              Error("package source read failed (${code})")
            },
            Ok(read) => {
              if match expected_root_identity {
                None() => false,
                Some(expected) => read.identity != expected
              } {
                Error("package root identity changed while loading source")
              } else if bounded && total + read.contents.length() > 8388608 {
                Error("package source closure exceeds 8 MiB")
              } else {
                if !valid_utf8(read.contents) {
                  Error("package source is not valid UTF-8")
                } else {
                  Ok(read.contents.decode_utf8())
                }
              }
            }
          }
        }
      }
    }
  }
}

load_project_module(
  path: Str,
  state: ProjectLoadState,
  stack: [Str],
  project_root: Str,
  stdlib_root: Str,
  bounded: Bool,
  allow_leaf_symlink: Bool,
  package_root: Str,
  package_root_identity: FilesystemRootIdentity,
  package_name: Str,
  package_version: Str,
  package_confined: Bool,
  dependencies: [ManifestDependencyProject]
): ProjectLoadState {
  if state.visited.has(path) {
    state
  } else {
    if (package_confined && !package_source_contains(path, project_root, stdlib_root, dependencies)) ||
        (!package_confined && !loader_path_within(path, project_root) && !loader_path_within(path, stdlib_root)) {
      diagnostics: [Diagnostic] = state.diagnostics.append(
        loader_diagnostic("module path escapes the entry directory and standard library roots: " + path)
      )
      ProjectLoadState(state.modules, state.visited.add(path), diagnostics, state.sources, state.source_paths)
    } else {
    trusted_root: Str = if loader_path_within(path, stdlib_root) { stdlib_root } else {
      if package_confined { package_owner_root(path, package_root, dependencies) } else { project_root }
    }
    if !package_confined && loader_path_has_symlink(path, trusted_root, allow_leaf_symlink) {
      diagnostics: [Diagnostic] = state.diagnostics.append(
        loader_diagnostic("module path traverses a symbolic link: " + path)
      )
      ProjectLoadState(state.modules, state.visited.add(path), diagnostics, state.sources, state.source_paths)
    } else {
    if path_in_stack(stack, path) {
      diagnostics: [Diagnostic] = state.diagnostics.append(
        loader_diagnostic("import cycle includes ${path}")
      )
      ProjectLoadState(state.modules, state.visited, diagnostics, state.sources, state.source_paths)
    } else {
      if path_support.suffix(path) != ".panack" {
        diagnostics: [Diagnostic] = state.diagnostics.append(
          loader_diagnostic("import must reference a .panack file: ${path}")
        )
        ProjectLoadState(
          state.modules,
          state.visited,
          diagnostics,
          state.sources,
          state.source_paths
        )
      } else {
        if !package_confined && !filesystem_support.exists(path) {
          diagnostics: [Diagnostic] = state.diagnostics.append(
            loader_diagnostic("missing source module ${path}")
          )
          ProjectLoadState(
            state.modules,
            state.visited,
            diagnostics,
            state.sources,
            state.source_paths
          )
        } else {
          match if package_confined {
            read_package_source(
              path,
              trusted_root,
              if loader_path_within(path, stdlib_root) { None() } else {
                mut identity: Option[FilesystemRootIdentity] = Some(package_root_identity)
                for dependency in dependencies {
                  if loader_path_within(path, dependency.source_root) {
                    identity = Some(dependency.root_identity)
                  }
                }
                identity
              },
              bounded,
              state.source_paths,
              state.sources
            )
          } else {
            read_project_source(path, bounded, state.source_paths, state.sources)
          } {
            Error(message) => ProjectLoadState(
              state.modules,
              state.visited,
              state.diagnostics.append(loader_diagnostic(message + ": " + path)),
              state.sources,
              state.source_paths
            ),
            Ok(source) => {
              paths: [Str] = state.source_paths.append(path)
              sources: Map[Str, Str] = state.sources.put(path, source)
              match lex_file(source, path) {
                Error(errors) => {
                  mut diagnostics: [Diagnostic] = state.diagnostics
                  for error in errors {
                    diagnostics = diagnostics.append(error)
                  }
                  ProjectLoadState(
                    state.modules,
                    state.visited.add(path),
                    diagnostics,
                    sources,
                    paths
                  )
                },
                Ok(tokens) => {
                  match parse_module_complete(tokens) {
                    Error(error) => {
                      diagnostics: [Diagnostic] = state.diagnostics.append(error)
                      ProjectLoadState(
                        state.modules,
                        state.visited.add(path),
                        diagnostics,
                        sources,
                        paths
                      )
                    },
                    Ok(parsed) => {
                      identity: ModuleIdentity = if package_confined && !loader_path_within(path, stdlib_root) {
                        source_package_module_identity(
                          path,
                          package_owner_source_root(path, project_root, dependencies),
                          stdlib_root,
                          package_owner_name(path, package_name, dependencies),
                          package_owner_version(path, package_version, dependencies)
                        )
                      } else {
                        source_module_identity(path, project_root, stdlib_root)
                      }
                      bindings: ModuleBindings = collect_module_bindings(identity, parsed)
                      module: LoadedModule = LoadedModule(
                        path,
                        parsed,
                        parsed.program,
                        bindings,
                        loaded_module_declaration_index(parsed)
                      )
                      staged: [Diagnostic] = module_execution_diagnostics(parsed)
                      binding_errors: [Diagnostic] = if staged.len() > 0 {
                        module_binding_diagnostics(bindings)
                      } else {
                        []
                      }
                      mut current: ProjectLoadState = ProjectLoadState(
                        state.modules,
                        state.visited,
                        state.diagnostics.concat(binding_errors.concat(staged)),
                        sources,
                        paths
                      )
                      next_stack: [Str] = stack.append(path)
                      for declaration in parsed.program.declarations {
                        match declaration {
                          ImportDeclaration(imported) => {
                            if is_logical_import(imported) ||
                                (package_confined && logical_import_valid(imported)) {
                              if !logical_import_valid(imported) {
                                diagnostics: [Diagnostic] = current.diagnostics.append(
                                  loader_diagnostic("invalid logical import path: ${imported}")
                                )
                                current = ProjectLoadState(
                                  current.modules,
                                  current.visited,
                                  diagnostics,
                                  current.sources,
                                  current.source_paths
                                )
                              } else {
                                if imported.starts_with_at("stdlib/", 0) && stdlib_root.len() == 0 {
                                  diagnostics: [Diagnostic] = current.diagnostics.append(
                                    loader_diagnostic("standard library root is not configured")
                                  )
                                  current = ProjectLoadState(
                                    current.modules,
                                    current.visited,
                                    diagnostics,
                                    current.sources,
                                    current.source_paths
                                  )
                                } else {
                                  parent: Str = path_support.parent(path)
                                  import_root: Str = if package_confined {
                                    package_owner_source_root(path, project_root, dependencies)
                                  } else { project_root }
                                  match if package_confined {
                                    resolve_package_import_path(
                                      imported,
                                      parent,
                                      import_root,
                                      stdlib_root,
                                      package_owner_identity(path, package_root_identity, dependencies),
                                      dependencies
                                    )
                                  } else {
                                    Ok(resolve_import_path(imported, parent, project_root, stdlib_root))
                                  } {
                                    Error(message) => {
                                      current = ProjectLoadState(
                                        current.modules,
                                        current.visited,
                                        current.diagnostics.append(loader_diagnostic(message)),
                                        current.sources,
                                        current.source_paths
                                      )
                                    },
                                    Ok(dependency) => {
                                      current = load_project_module(
                                        dependency,
                                        current,
                                        next_stack,
                                        project_root,
                                        stdlib_root,
                                        bounded,
                                        false,
                                        package_root,
                                        package_root_identity,
                                        package_name,
                                        package_version,
                                        package_confined,
                                        dependencies
                                      )
                                    }
                                  }
                                }
                              }
                            } else {
                              if path_support.is_absolute(imported) {
                                diagnostics: [Diagnostic] = current.diagnostics.append(
                                  loader_diagnostic("imports must use relative or logical paths: ${imported}")
                                )
                                current = ProjectLoadState(
                                  current.modules,
                                  current.visited,
                                  diagnostics,
                                  current.sources,
                                  current.source_paths
                                )
                              } else {
                                if path_support.suffix(imported) != ".panack" {
                                  diagnostics: [Diagnostic] = current.diagnostics.append(
                                    loader_diagnostic("relative import must reference a .panack file: ${imported}")
                                  )
                                  current = ProjectLoadState(
                                    current.modules,
                                    current.visited,
                                    diagnostics,
                                    current.sources,
                                    current.source_paths
                                  )
                                } else {
                                  parent: Str = path_support.parent(path)
                                  dependency: Str = path_support.join(parent, imported)
                                  current = load_project_module(
                                    dependency,
                                    current,
                                    next_stack,
                                    project_root,
                                    stdlib_root,
                                    bounded,
                                    false,
                                    package_root,
                                    package_root_identity,
                                    package_name,
                                    package_version,
                                    package_confined,
                                    dependencies
                                  )
                                }
                              }
                            }
                          },
                          TypeDeclaration(name, base, guard) => {},
                          RecordDeclaration(name, parameters, fields) => {},
                          EnumDeclaration(name, parameters, variants) => {},
                          FunctionDeclaration(name, parameters, return_type, is_pure, is_async, body, type_parameters) => {}
                        }
                      }
                      modules: [LoadedModule] = current.modules.append(module)
                      ProjectLoadState(
                        modules,
                        current.visited.add(path),
                        current.diagnostics,
                        current.sources,
                        current.source_paths
                      )
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
    }
    }
  }
}

pub load_project(entry: Str): LoadedProject {
  load_project_mode(entry, false, false)
}

pub load_project_diagnostics(entry: Str): [Diagnostic] {
  load_project(entry).diagnostics
}

pub load_project_for_source_map(entry: Str): LoadedProject {
  load_project_mode(entry, true, false)
}

pub load_project_explained(entry: Str): LoadedProject {
  load_project_mode(entry, true, true)
}

pub load_project_for_inventory(entry: Str): LoadedProject {
  load_project_mode_with_main(entry, true, false, false)
}

load_project_mode(entry: Str, bounded: Bool, retain: Bool): LoadedProject {
  load_project_mode_with_main(entry, bounded, retain, true)
}

load_project_mode_with_main(
  entry: Str,
  bounded: Bool,
  retain: Bool,
  require_main: Bool
): LoadedProject {
  load_project_mode_with_configuration(
    entry, bounded, retain, require_main, "", "", FilesystemRootIdentity(0, 0), "", "", false, []
  )
}

pub load_project_package(
  entry: Str,
  source_root: Str,
  package_root: Str,
  package_root_identity: FilesystemRootIdentity,
  package_name: Str,
  package_version: Str,
  dependencies: [ManifestDependencyProject]
): LoadedProject {
  load_project_mode_with_configuration(
    entry,
    true,
    false,
    true,
    source_root,
    package_root,
    package_root_identity,
    package_name,
    package_version,
    true,
    dependencies
  )
}

pub load_project_package_for_check(
  entry: Str,
  source_root: Str,
  package_root: Str,
  package_root_identity: FilesystemRootIdentity,
  package_name: Str,
  package_version: Str,
  dependencies: [ManifestDependencyProject]
): LoadedProject {
  load_project_mode_with_configuration(
    entry,
    true,
    false,
    false,
    source_root,
    package_root,
    package_root_identity,
    package_name,
    package_version,
    true,
    dependencies
  )
}

load_project_mode_with_configuration(
  entry: Str,
  bounded: Bool,
  retain: Bool,
  require_main: Bool,
  configured_project_root: Str,
  package_root: Str,
  package_root_identity: FilesystemRootIdentity,
  package_name: Str,
  package_version: Str,
  package_confined: Bool,
  dependencies: [ManifestDependencyProject]
): LoadedProject {
  resolved: Str = path_support.resolve(entry)
  project_root: Str = if package_confined {
    path_support.resolve(configured_project_root)
  } else {
    match std_environment.get("PANACKELTY_BOOTSTRAP_ROOT") {
      Some(value) => path_support.resolve(value),
      None() => path_support.parent(resolved)
    }
  }
  stdlib_root: Str = match std_environment.get("PANACKELTY_STDLIB_PATH") {
    Some(value) => path_support.resolve(value),
    None() => ""
  }
  empty: Set[Str] = set()
  initial: ProjectLoadState = ProjectLoadState([], empty, [], map(), [])
  stack: [Str] = []
  mut core: ProjectLoadState = initial

  if stdlib_root.len() == 0 {
    core = ProjectLoadState(
      [],
      empty,
      [loader_diagnostic("standard library root is not configured; core types require the bundled standard library")],
      map(),
      []
    )
  } else {
    core = load_project_module(
      path_support.join(stdlib_root, "core.panack"),
      initial,
      stack,
      project_root,
      stdlib_root,
      bounded,
      false,
      "",
      FilesystemRootIdentity(0, 0),
      "",
      "",
      false,
      []
    )
  }
  // Namespace staging is handled by the identity pipeline, including core impls.
  mut core_failed: Bool = false
  for diagnostic in core.diagnostics {
    core_failed = core_failed || diagnostic.message !=
      "namespace syntax is parsed but execution is not yet supported (language namespace migration pending)"
  }
  loaded: ProjectLoadState = if !core_failed {
    load_project_module(
      resolved,
      core,
      stack,
      project_root,
      stdlib_root,
      bounded,
      true,
      package_root,
      package_root_identity,
      package_name,
      package_version,
      package_confined,
      dependencies
    )
  } else {
    core
  }
  mut program: Program = append_program_declarations(module_programs(loaded.modules))
  mut diagnostics: [Diagnostic] = []
  // Every source module uses checked identities. Parser staging markers belong
  // to the standalone syntax API, not a second executable language frontend.
  for diagnostic in loaded.diagnostics {
    if diagnostic.message !=
        "namespace syntax is parsed but execution is not yet supported (language namespace migration pending)" {
      diagnostics = diagnostics.append(diagnostic)
    }
  }
  mut has_main: Bool = false
  for module in loaded.modules {
    if module.source_path == resolved {
      for declaration in module.parsed.program.declarations {
        match declaration {
          FunctionDeclaration(name, parameters, output, pure_flag, async_flag, body, types) => {
            if name == "main" {
              has_main = true
              if parameters.len() > 0 { diagnostics = diagnostics.append(loader_diagnostic("main cannot take parameters")) }
              if types.len() > 0 { diagnostics = diagnostics.append(loader_diagnostic("main cannot have type parameters")) }
              if async_flag && output != "Unit" { diagnostics = diagnostics.append(loader_diagnostic("async main must return Unit")) }
            }
          },
          ImportDeclaration(path) => {},
          TypeDeclaration(name, base, guard) => {},
          RecordDeclaration(name, parameters, fields) => {},
          EnumDeclaration(name, parameters, variants) => {}
        }
      }
    }
  }
  if require_main && !has_main && diagnostics.len() == 0 { diagnostics = diagnostics.append(loader_diagnostic("program has no main function")) }
  graph: ModuleBindingGraph = loaded_package_binding_graph(
    loaded.modules, project_root, stdlib_root, package_confined, package_root_identity, dependencies
  )
  diagnostics = diagnostics.concat(module_graph_diagnostics(graph))
  mut signatures: [ModuleSignature] = []
  mut bodies: [BoundFunctionBody] = []
  mut effects: [EffectEvidence] = []
  mut effects_checked: Bool = false
  mut identity_ready: Bool = diagnostics.len() == 0
  mut function_types: Map[Str, Bool] = map()
  mut evidence: [SubtractionEvidence] = []
  if identity_ready {
    for module in loaded.modules {
      checked: CheckedModuleSignatures = check_module_signatures(graph, loaded.modules, module)
      signatures = signatures.concat(checked.declarations)
      diagnostics = diagnostics.concat(checked.diagnostics)
    }
    if diagnostics.len() == 0 {
      for module in loaded.modules {
        guards: CheckedModuleBodies = check_module_guards(graph, loaded.modules, signatures, module)
        diagnostics = diagnostics.concat(guards.diagnostics)
        guard_effects: CheckedModuleEffects = check_module_effects(graph, loaded.modules, signatures, guards.functions, false)
        diagnostics = diagnostics.concat(guard_effects.diagnostics)
      }
    }
    identity_ready = diagnostics.len() == 0
    signatures_valid: Bool = identity_ready
    for module in loaded.modules {
      checked: CheckedModuleBodies = check_module_bodies_explained(
        graph, loaded.modules, signatures, module, retain)
      bodies = bodies.concat(checked.functions)
      diagnostics = diagnostics.concat(checked.diagnostics)
      identity_ready = identity_ready && checked.diagnostics.len() == 0
      for body in checked.functions {
        if retain { evidence = evidence.concat(body_subtraction_evidence_entries(body.body)) }
        identity_ready = identity_ready && body.status == BodyIdentityChecked() && body.deferred.len() == 0
      }
    }
    checked_effects: CheckedModuleEffects = check_module_effects(
      graph, loaded.modules, signatures, bodies, retain)
    if signatures_valid {
      diagnostics = diagnostics.concat(checked_effects.diagnostics)
      effects = effects.concat(checked_effects.evidence)
    }
    identity_ready = identity_ready && checked_effects.diagnostics.len() == 0
    for body in bodies {
      name: Str = body.signature.binding.identity.name
      if checked_effects.function_types.has(name) {
        function_types = function_types.put(name, checked_effects.function_types.get(name))
      }
    }
    for module in loaded.modules {
      for declaration in module.bindings.declarations {
        if declaration.kind == ModuleFunction() && declaration.intrinsic == None() {
          mut found: Bool = false
          for body in bodies { found = found || body.signature.binding.identity == declaration.identity }
          identity_ready = identity_ready && found
        }
      }
    }
    effects_checked = signatures_valid
    if identity_ready {
      entry_identity: ModuleIdentity = if package_confined {
        source_package_module_identity(resolved, project_root, stdlib_root, package_name, package_version)
      } else { source_module_identity(resolved, project_root, stdlib_root) }
      emitted: ModuleEmissionResult = module_emission_program(
        graph, loaded.modules, signatures, bodies, entry_identity)
      diagnostics = diagnostics.concat(emitted.diagnostics)
      if emitted.diagnostics.len() == 0 {
        program = emitted.program
      }
    }
  }
  LoadedProject(
    program,
    loaded.modules,
    diagnostics,
    loaded.sources,
    loaded.source_paths,
    evidence,
    effects,
    effects_checked,
    identity_ready,
    function_types,
    signatures,
    bodies
  )
}

// Build semantic edges only from the loader's normalized path decisions.
pure loaded_identity_for_path(
  path: Str,
  modules: [LoadedModule],
  project_root: Str,
  stdlib_root: Str
): ModuleIdentity {
  mut identity: ModuleIdentity = source_module_identity(path, project_root, stdlib_root)
  for module in modules {
    if module.source_path == path {
      identity = module.bindings.identity
    }
  }
  identity
}

pub pure loaded_binding_graph(
  modules: [LoadedModule],
  project_root: Str,
  stdlib_root: Str
): ModuleBindingGraph {
  loaded_package_binding_graph(
    modules, project_root, stdlib_root, false, FilesystemRootIdentity(0, 0), []
  )
}

pub pure loaded_package_binding_graph(
  modules: [LoadedModule],
  project_root: Str,
  stdlib_root: Str,
  package_confined: Bool,
  package_root_identity: FilesystemRootIdentity,
  dependencies: [ManifestDependencyProject]
): ModuleBindingGraph {
  mut bindings: [ModuleBindings] = []
  mut edges: [ModuleImportEdge] = []

  for module in modules {
    bindings = bindings.append(module.bindings)
    mut index: Nat = 0
    for imported in module.bindings.imports {
      parent: Str = path_support.parent(module.source_path)
      owner_root: Str = if package_confined {
        package_owner_source_root(module.source_path, project_root, dependencies)
      } else { project_root }
      owner_identity: FilesystemRootIdentity = package_owner_identity(
        module.source_path, package_root_identity, dependencies
      )
      path: Str = if package_confined {
        match resolve_package_import_path(
          imported.path, parent, owner_root, stdlib_root, owner_identity, dependencies
        ) {
          Error(message) => "",
          Ok(resolved) => resolved
        }
      } else {
        resolve_import_path(imported.path, parent, project_root, stdlib_root)
      }
      edges = edges.append(
        ModuleImportEdge(
        module.bindings.identity,
        index,
        loaded_identity_for_path(path, modules, project_root, stdlib_root)
      )
      )
      index = index + 1
    }
  }
  ModuleBindingGraph(bindings, edges)
}
