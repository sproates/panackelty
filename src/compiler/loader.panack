import project/src/bytecode/decoder
import project/src/compiler/module_bodies
import project/src/compiler/module_effects
import stdlib/filesystem

// Resolve and read the module closure once, preserving traversal order and original
// source snapshots. Host I/O belongs here rather than in the pure frontend.

record ProjectLoadState {
  modules: [LoadedModule],
  visited: Set[Str],
  diagnostics: [Diagnostic],
  sources: Map[Str, Str],
  source_paths: [Str]
}

record LoadedProject {
  program: Program,
  modules: [LoadedModule],
  diagnostics: [Diagnostic],
  sources: Map[Str, Str],
  source_paths: [Str],
  evidence: [SubtractionEvidence],
  effects: [EffectEvidence],
  effects_checked: Bool,
  function_types: Map[Str, Bool],
  module_signatures: [ModuleSignature],
  module_bodies: [BoundFunctionBody]
}

pure path_in_stack(stack: [Str], path: Str): Bool {
  mut found: Bool = false

  for item in stack {
    if item == path {
      found = true
    } else {}
  }

  found
}

pure loader_diagnostic(message: Str): Diagnostic {
  Diagnostic(message, SourcePos("", 0, 1, 1))
}

pure is_logical_import(path: Str): Bool {
  starts_with(path, "stdlib/") || starts_with(path, "project/")
}

pure logical_import_without_suffix(path: Str): Str {
  mut output: Str = ""
  mut index: Nat = 0

  while index < len(path) {
    if starts_with_at(path, ".panack", index) && index + len(".panack") == len(path) {
      index = len(path)
    } else {
      output = output + path[index]
      index = index + 1
    }
  }

  output
}

pure logical_import_segments_valid(path: Str): Bool {
  mut valid: Bool = len(path) > 0
  mut segment_start: Bool = true
  mut index: Nat = 0

  while index < len(path) {
    character: Str = path[index]
    if character == "/" {
      if segment_start {
        valid = false
      } else {}
      segment_start = true
    } else {
      if segment_start {
        if !(is_letter(character) || character == "_") {
          valid = false
        } else {}
        segment_start = false
      } else {
        if !(is_letter(character) || is_digit(character) || character == "_") {
          valid = false
        } else {}
      }
    }
    index = index + 1
  }
  valid && !segment_start
}

pure logical_import_valid(path: Str): Bool {
  suffix: Str = path_suffix(path)
  without_suffix: Str = logical_import_without_suffix(path)
  relative: Str = if starts_with(without_suffix, "stdlib/") {
    slice(without_suffix, len("stdlib/"), len(without_suffix))
  } else {
    if starts_with(without_suffix, "project/") {
      slice(without_suffix, len("project/"), len(without_suffix))
    } else {
      ""
    }
  }
  (suffix == "" || suffix == ".panack") && logical_import_segments_valid(relative)
}

pure resolve_import_path(imported: Str, parent: Str, project_root: Str, stdlib_root: Str): Str {
  if starts_with(imported, "stdlib/") {
    without_suffix: Str = logical_import_without_suffix(imported)
    relative: Str = slice(without_suffix, len("stdlib/"), len(without_suffix))
    path_join(stdlib_root, "${relative}.panack")
  } else {
    if starts_with(imported, "project/") {
      without_suffix: Str = logical_import_without_suffix(imported)
      relative: Str = slice(without_suffix, len("project/"), len(without_suffix))
      path_join(project_root, "${relative}.panack")
    } else {
      path_join(parent, imported)
    }
  }
}

pure loader_path_within(path: Str, root: Str): Bool {
  if root == "/" {
    starts_with(path, "/")
  } else {
    path == root || starts_with(path, root + "/")
  }
}

loader_path_component_is_symlink(path: Str): Bool {
  match path_from_text(path) {
    Error(error) => true,
    Ok(file) => match fs_metadata(file) {
      Error(error) => false,
      Ok(metadata) => metadata.kind == SymbolicLink()
    }
  }
}

loader_path_has_symlink(path: Str, root: Str, allow_leaf_symlink: Bool): Bool {
  if !loader_path_within(path, root) {
    true
  } else {
    relative: Str = if path == root {
      ""
    } else {
      if root == "/" { slice(path, 1, len(path)) } else { slice(path, len(root) + 1, len(path)) }
    }
    mut current: Str = root
    mut segment: Str = ""
    mut found: Bool = false
    mut index: Nat = 0
    while index < len(relative) {
      character: Str = relative[index]
      if character == "/" {
        if len(segment) > 0 {
          current = path_join(current, segment)
          found = found || loader_path_component_is_symlink(current)
          segment = ""
        } else {}
      } else {
        segment = segment + character
      }
      index = index + 1
    }
    if len(segment) > 0 {
      current = path_join(current, segment)
      if !allow_leaf_symlink {
        found = found || loader_path_component_is_symlink(current)
      } else {}
    } else {}
    found
  }
}

read_project_source(
  path: Str,
  bounded: Bool,
  paths: [Str],
  sources: Map[Str, Str]
): Result[Str, Str] {
  if !bounded {
    Ok(read_file(path))
  } else {
    mut total: Nat = 0
    for loaded in paths {
      total = total + byte_len(utf8_encode(sources.get(loaded)))
    }
    if len(paths) >= 256 || total > 8388608 {
      Error("source-map source closure limit exceeded")
    } else {
      match path_from_text(path) {
        Error(error) => Error("invalid source path"),
        Ok(file) => match fs_read(file, 1048576) {
          Error(error) => Error("source-map source unavailable or exceeds 1 MiB"),
          Ok(data) => {
            if total + byte_len(data) > 8388608 {
              Error("source-map source closure exceeds 8 MiB")
            } else {
              if !valid_utf8(data) {
                Error("source-map source is not valid UTF-8")
              } else {
                Ok(utf8_decode(data))
              }
            }
          }
        }
      }
    }
  }
}

load_project_module(
  path: Str,
  state: ProjectLoadState,
  stack: [Str],
  project_root: Str,
  stdlib_root: Str,
  bounded: Bool,
  allow_leaf_symlink: Bool
): ProjectLoadState {
  if state.visited.has(path) {
    state
  } else {
    if !loader_path_within(path, project_root) && !loader_path_within(path, stdlib_root) {
      diagnostics: [Diagnostic] = append(
        state.diagnostics,
        loader_diagnostic("module path escapes the entry directory and standard library roots: " + path)
      )
      ProjectLoadState(state.modules, state.visited.add(path), diagnostics, state.sources, state.source_paths)
    } else {
    trusted_root: Str = if loader_path_within(path, stdlib_root) { stdlib_root } else { project_root }
    if loader_path_has_symlink(path, trusted_root, allow_leaf_symlink) {
      diagnostics: [Diagnostic] = append(
        state.diagnostics,
        loader_diagnostic("module path traverses a symbolic link: " + path)
      )
      ProjectLoadState(state.modules, state.visited.add(path), diagnostics, state.sources, state.source_paths)
    } else {
    if path_in_stack(stack, path) {
      diagnostics: [Diagnostic] = append(
        state.diagnostics,
        loader_diagnostic("import cycle includes ${path}")
      )
      ProjectLoadState(state.modules, state.visited, diagnostics, state.sources, state.source_paths)
    } else {
      if path_suffix(path) != ".panack" {
        diagnostics: [Diagnostic] = append(
          state.diagnostics,
          loader_diagnostic("import must reference a .panack file: ${path}")
        )
        ProjectLoadState(
          state.modules,
          state.visited,
          diagnostics,
          state.sources,
          state.source_paths
        )
      } else {
        if !file_exists(path) {
          diagnostics: [Diagnostic] = append(
            state.diagnostics,
            loader_diagnostic("missing source module ${path}")
          )
          ProjectLoadState(
            state.modules,
            state.visited,
            diagnostics,
            state.sources,
            state.source_paths
          )
        } else {
          match read_project_source(path, bounded, state.source_paths, state.sources) {
            Error(message) => ProjectLoadState(
              state.modules,
              state.visited,
              append(state.diagnostics, loader_diagnostic(message + ": " + path)),
              state.sources,
              state.source_paths
            ),
            Ok(source) => {
              paths: [Str] = append(state.source_paths, path)
              sources: Map[Str, Str] = state.sources.put(path, source)
              match lex_file(source, path) {
                Error(errors) => {
                  mut diagnostics: [Diagnostic] = state.diagnostics
                  for error in errors {
                    diagnostics = append(diagnostics, error)
                  }
                  ProjectLoadState(
                    state.modules,
                    state.visited.add(path),
                    diagnostics,
                    sources,
                    paths
                  )
                },
                Ok(tokens) => {
                  match parse_module_complete(tokens) {
                    Error(error) => {
                      diagnostics: [Diagnostic] = append(state.diagnostics, error)
                      ProjectLoadState(
                        state.modules,
                        state.visited.add(path),
                        diagnostics,
                        sources,
                        paths
                      )
                    },
                    Ok(parsed) => {
                      identity: ModuleIdentity = source_module_identity(
                        path,
                        project_root,
                        stdlib_root
                      )
                      bindings: ModuleBindings = collect_module_bindings(identity, parsed)
                      // Retain original source bindings before the existing core-only
                      // callable internalization used by the execution frontend.
                      program: Program = if path == path_join(stdlib_root, "core.panack") {
                        match parse_module_complete(core_tokens(tokens)) {
                          Ok(internal) => lower_legacy_program(internal.program),
                          Error(error) => lower_legacy_program(parsed.program)
                        }
                      } else {
                        lower_legacy_program(parsed.program)
                      }
                      module: LoadedModule = LoadedModule(path, parsed, program, bindings)
                      staged: [Diagnostic] = module_execution_diagnostics(parsed)
                      binding_errors: [Diagnostic] = if len(staged) > 0 {
                        module_binding_diagnostics(bindings)
                      } else {
                        []
                      }
                      mut current: ProjectLoadState = ProjectLoadState(
                        state.modules,
                        state.visited,
                        concat(state.diagnostics, concat(binding_errors, staged)),
                        sources,
                        paths
                      )
                      next_stack: [Str] = append(stack, path)
                      for declaration in program.declarations {
                        match declaration {
                          ImportDeclaration(imported) => {
                            if is_logical_import(imported) {
                              if !logical_import_valid(imported) {
                                diagnostics: [Diagnostic] = append(
                                  current.diagnostics,
                                  loader_diagnostic("invalid logical import path: ${imported}")
                                )
                                current = ProjectLoadState(
                                  current.modules,
                                  current.visited,
                                  diagnostics,
                                  current.sources,
                                  current.source_paths
                                )
                              } else {
                                if starts_with(imported, "stdlib/") && len(stdlib_root) == 0 {
                                  diagnostics: [Diagnostic] = append(
                                    current.diagnostics,
                                    loader_diagnostic("standard library root is not configured")
                                  )
                                  current = ProjectLoadState(
                                    current.modules,
                                    current.visited,
                                    diagnostics,
                                    current.sources,
                                    current.source_paths
                                  )
                                } else {
                                  parent: Str = path_parent(path)
                                  dependency: Str = resolve_import_path(
                                    imported,
                                    parent,
                                    project_root,
                                    stdlib_root
                                  )
                                  current = load_project_module(
                                    dependency,
                                    current,
                                    next_stack,
                                    project_root,
                                    stdlib_root,
                                    bounded,
                                    false
                                  )
                                }
                              }
                            } else {
                              if path_is_absolute(imported) {
                                diagnostics: [Diagnostic] = append(
                                  current.diagnostics,
                                  loader_diagnostic("imports must use relative or logical paths: ${imported}")
                                )
                                current = ProjectLoadState(
                                  current.modules,
                                  current.visited,
                                  diagnostics,
                                  current.sources,
                                  current.source_paths
                                )
                              } else {
                                if path_suffix(imported) != ".panack" {
                                  diagnostics: [Diagnostic] = append(
                                    current.diagnostics,
                                    loader_diagnostic("relative import must reference a .panack file: ${imported}")
                                  )
                                  current = ProjectLoadState(
                                    current.modules,
                                    current.visited,
                                    diagnostics,
                                    current.sources,
                                    current.source_paths
                                  )
                                } else {
                                  parent: Str = path_parent(path)
                                  dependency: Str = resolve_import_path(
                                    imported,
                                    parent,
                                    project_root,
                                    stdlib_root
                                  )
                                  current = load_project_module(
                                    dependency,
                                    current,
                                    next_stack,
                                    project_root,
                                    stdlib_root,
                                    bounded,
                                    false
                                  )
                                }
                              }
                            }
                          },
                          TypeDeclaration(name, base, guard) => {},
                          RecordDeclaration(name, parameters, fields) => {},
                          EnumDeclaration(name, parameters, variants) => {},
                          FunctionDeclaration(name, parameters, return_type, is_pure, is_async, body, type_parameters) => {}
                        }
                      }
                      modules: [LoadedModule] = append(current.modules, module)
                      ProjectLoadState(
                        modules,
                        current.visited.add(path),
                        current.diagnostics,
                        current.sources,
                        current.source_paths
                      )
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
    }
    }
  }
}

load_project(entry: Str): LoadedProject {
  load_project_mode(entry, false, false)
}

load_project_for_source_map(entry: Str): LoadedProject {
  load_project_mode(entry, true, false)
}

load_project_explained(entry: Str): LoadedProject {
  load_project_mode(entry, true, true)
}

load_project_for_inventory(entry: Str): LoadedProject {
  load_project_mode_with_main(entry, true, false, false)
}

load_project_mode(entry: Str, bounded: Bool, retain: Bool): LoadedProject {
  load_project_mode_with_main(entry, bounded, retain, true)
}

load_project_mode_with_main(
  entry: Str,
  bounded: Bool,
  retain: Bool,
  require_main: Bool
): LoadedProject {
  resolved: Str = path_resolve(entry)
  project_root: Str = if environment_has("PANACKELTY_BOOTSTRAP_ROOT") {
    path_resolve(environment_get("PANACKELTY_BOOTSTRAP_ROOT"))
  } else {
    path_parent(resolved)
  }
  stdlib_root: Str = if environment_has("PANACKELTY_STDLIB_PATH") {
    path_resolve(environment_get("PANACKELTY_STDLIB_PATH"))
  } else {
    ""
  }
  empty: Set[Str] = set()
  initial: ProjectLoadState = ProjectLoadState([], empty, [], map(), [])
  stack: [Str] = []
  mut core: ProjectLoadState = initial

  if len(stdlib_root) == 0 {
    core = ProjectLoadState(
      [],
      empty,
      [loader_diagnostic("standard library root is not configured; core types require the bundled standard library")],
      map(),
      []
    )
  } else {
    core = load_project_module(
      path_join(stdlib_root, "core.panack"),
      initial,
      stack,
      project_root,
      stdlib_root,
      bounded,
      false
    )
  }
  loaded: ProjectLoadState = if len(core.diagnostics) == 0 {
    load_project_module(resolved, core, stack, project_root, stdlib_root, bounded, true)
  } else {
    core
  }
  program: Program = append_program_declarations(module_programs(loaded.modules))
  mut diagnostics: [Diagnostic] = loaded.diagnostics
  mut signatures: [ModuleSignature] = []
  mut bodies: [BoundFunctionBody] = []
  mut effects: [EffectEvidence] = []
  mut effects_checked: Bool = false
  mut function_types: Map[Str, Bool] = map()
  mut staged: Bool = false
  for module in loaded.modules {
    staged = staged || len(module_execution_diagnostics(module.parsed)) > 0
  }
  if staged {
    graph: ModuleBindingGraph = loaded_binding_graph(loaded.modules, project_root, stdlib_root)
    graph_errors: [Diagnostic] = module_graph_diagnostics(graph)
    diagnostics = concat(diagnostics, graph_errors)
    if len(graph_errors) == 0 {
      mut signatures_valid: Bool = true
      // Complete contracts before bodies: source/import order and recursion
      // cannot select a different callable identity or miss a later contract.
      for module in loaded.modules {
        checked_signatures: CheckedModuleSignatures = check_module_signatures(
          graph,
          loaded.modules,
          module
        )
        signatures = concat(signatures, checked_signatures.declarations)
        signatures_valid = signatures_valid && len(checked_signatures.diagnostics) == 0
        if len(module_execution_diagnostics(module.parsed)) > 0 {
          diagnostics = concat(diagnostics, checked_signatures.diagnostics)
        }
      }
      for module in loaded.modules {
        if len(module_execution_diagnostics(module.parsed)) > 0 {
          checked_bodies: CheckedModuleBodies = check_module_bodies(
            graph,
            loaded.modules,
            signatures,
            module
          )
          diagnostics = concat(diagnostics, checked_bodies.diagnostics)
          bodies = concat(bodies, checked_bodies.functions)
          if signatures_valid {
            checked_effects: CheckedModuleEffects = check_module_effects(
              graph,
              loaded.modules,
              signatures,
              checked_bodies.functions,
              retain
            )
            diagnostics = concat(diagnostics, checked_effects.diagnostics)
            effects = concat(effects, checked_effects.evidence)
            effects_checked = true
            for function in checked_bodies.functions {
              name: Str = function.signature.binding.identity.name
              if checked_effects.function_types.has(name) {
                function_types = function_types.put(name, checked_effects.function_types.get(name))
              }
            }
          }
        }
      }
    }
  }
  if len(diagnostics) == 0 {
    diagnostics = concat(
      diagnostics,
      resolve_program_at(program, module_declaration_positions(loaded.modules))
    )
  } else {}
  mut evidence: [SubtractionEvidence] = []
  if len(diagnostics) == 0 {
    checked: CheckedProgram = check_program_evidence_mode(program, retain, require_main)
    checked_effects: CheckedEffects = check_frontend_effects(program, checked, retain)
    diagnostics = checked_effects.diagnostics
    evidence = checked.evidence
    effects = checked_effects.evidence
    function_types = checked.function_types
    effects_checked = len(checked.diagnostics) == 0 || (retain && checked.declarations_valid)
  }
  LoadedProject(
    program,
    loaded.modules,
    diagnostics,
    loaded.sources,
    loaded.source_paths,
    evidence,
    effects,
    effects_checked,
    function_types,
    signatures,
    bodies
  )
}

// Build semantic edges only from the loader's normalized path decisions.
pure loaded_binding_graph(
  modules: [LoadedModule],
  project_root: Str,
  stdlib_root: Str
): ModuleBindingGraph {
  mut bindings: [ModuleBindings] = []
  mut edges: [ModuleImportEdge] = []

  for module in modules {
    bindings = append(bindings, module.bindings)
    mut index: Nat = 0
    for imported in module.bindings.imports {
      path: Str = resolve_import_path(
        imported.path,
        path_parent(module.source_path),
        project_root,
        stdlib_root
      )
      edges = append(
        edges,
        ModuleImportEdge(
        module.bindings.identity,
        index,
        source_module_identity(path, project_root, stdlib_root)
      )
      )
      index = index + 1
    }
  }
  ModuleBindingGraph(bindings, edges)
}
