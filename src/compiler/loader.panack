import "../bytecode/decoder.panack"
import "../stdlib/filesystem.panack"

record ProjectLoadState {
  programs: [Program],
  visited: Set[Str],
  diagnostics: [Diagnostic],
  sources: Map[Str,Str],
  source_paths: [Str]
}

record LoadedProject {
  program: Program,
  diagnostics: [Diagnostic],
  sources: Map[Str,Str],
  source_paths: [Str],
  evidence: [SubtractionEvidence],
  effects: [EffectEvidence],
  effects_checked: Bool,
  function_types: Map[Str,Bool]
}

pure path_in_stack(stack: [Str], path: Str): Bool {
  mut found: Bool = false
  for item in stack {
    if item == path { found = true; } else {}
  }
  found
}

pure loader_diagnostic(message: Str): Diagnostic {
  Diagnostic(message, SourcePos("", 0, 1, 1))
}

pure is_logical_import(path: Str): Bool {
  starts_with(path, "stdlib/") || starts_with(path, "project/")
}

pure logical_import_without_suffix(path: Str): Str {
  mut output: Str = ""
  mut index: Nat = 0
  while index < len(path) {
    if starts_with_at(path, ".panack", index) && index + len(".panack") == len(path) {
      index = len(path)
    } else {
      output = output + path[index]
      index = index + 1
    }
  }
  output
}

pure logical_import_segments_valid(path: Str): Bool {
  mut valid: Bool = len(path) > 0
  mut segment_start: Bool = true
  mut index: Nat = 0
  while index < len(path) {
    character: Str = path[index]
    if character == "/" {
      if segment_start { valid = false } else {}
      segment_start = true
    } else {
      if segment_start {
        if !(is_letter(character) || character == "_") { valid = false } else {}
        segment_start = false
      } else {
        if !(is_letter(character) || is_digit(character) || character == "_") { valid = false } else {}
      }
    }
    index = index + 1
  }
  valid && !segment_start
}

pure logical_import_valid(path: Str): Bool {
  suffix: Str = path_suffix(path)
  without_suffix: Str = logical_import_without_suffix(path)
  relative: Str = if starts_with(without_suffix, "stdlib/") {
    slice(without_suffix, len("stdlib/"), len(without_suffix))
  } else {
    if starts_with(without_suffix, "project/") {
      slice(without_suffix, len("project/"), len(without_suffix))
    } else {
      ""
    }
  }
  (suffix == "" || suffix == ".panack") && logical_import_segments_valid(relative)
}

pure resolve_import_path(imported: Str, parent: Str, project_root: Str, stdlib_root: Str): Str {
  if starts_with(imported, "stdlib/") {
    without_suffix: Str = logical_import_without_suffix(imported)
    relative: Str = slice(without_suffix, len("stdlib/"), len(without_suffix))
    path_join(stdlib_root, "${relative}.panack")
  } else {
    if starts_with(imported, "project/") {
      without_suffix: Str = logical_import_without_suffix(imported)
      relative: Str = slice(without_suffix, len("project/"), len(without_suffix))
      path_join(project_root, "${relative}.panack")
    } else {
      path_join(parent, imported)
    }
  }
}

read_project_source(path: Str, bounded: Bool, paths: [Str], sources: Map[Str,Str]): Result[Str,Str] {
  if !bounded { Ok(read_file(path)) }
  else {
    mut total: Nat = 0
    for loaded in paths { total = total + byte_len(utf8_encode(sources.get(loaded))); }
    if len(paths) >= 256 || total > 8388608 {
      Error("source-map source closure limit exceeded")
    } else {
      match path_from_text(path) {
        Error(error) => Error("invalid source path"),
        Ok(file) => match fs_read(file, 1048576) {
          Error(error) => Error("source-map source unavailable or exceeds 1 MiB"),
          Ok(data) => {
            if total + byte_len(data) > 8388608 { Error("source-map source closure exceeds 8 MiB") }
            else { if !valid_utf8(data) { Error("source-map source is not valid UTF-8") }
            else { Ok(utf8_decode(data)) } }
          }
        }
      }
    }
  }
}

load_project_module(path: Str, state: ProjectLoadState, stack: [Str], project_root: Str, stdlib_root: Str, bounded: Bool): ProjectLoadState {
  if state.visited.has(path) {
    state
  } else {
    if path_in_stack(stack, path) {
      diagnostics: [Diagnostic] = append(state.diagnostics, loader_diagnostic("import cycle includes ${path}"))
      ProjectLoadState(state.programs, state.visited, diagnostics, state.sources, state.source_paths)
    } else {
      if path_suffix(path) != ".panack" {
        diagnostics: [Diagnostic] = append(state.diagnostics, loader_diagnostic("import must reference a .panack file: ${path}"))
        ProjectLoadState(state.programs, state.visited, diagnostics, state.sources, state.source_paths)
      } else {
        if !file_exists(path) {
          diagnostics: [Diagnostic] = append(state.diagnostics, loader_diagnostic("missing source module ${path}"))
          ProjectLoadState(state.programs, state.visited, diagnostics, state.sources, state.source_paths)
        } else {
          match read_project_source(path, bounded, state.source_paths, state.sources) {
            Error(message) => ProjectLoadState(state.programs, state.visited, append(state.diagnostics, loader_diagnostic(message + ": " + path)), state.sources, state.source_paths),
            Ok(source) => {
              paths: [Str] = append(state.source_paths, path)
              sources: Map[Str,Str] = state.sources.put(path, source)
              match lex_file(source, path) {
                Error(errors) => {
                  mut diagnostics: [Diagnostic] = state.diagnostics
                  for error in errors {
                    diagnostics = append(diagnostics, error)
                  }
                  ProjectLoadState(state.programs, state.visited.add(path), diagnostics, sources, paths)
                },
                Ok(tokens) => {
                  selected: [Token] = if path == path_join(stdlib_root, "core.panack") { core_tokens(tokens) } else { tokens }
                  match parse_program_complete(selected) {
                    Error(error) => {
                      diagnostics: [Diagnostic] = append(state.diagnostics, error)
                      ProjectLoadState(state.programs, state.visited.add(path), diagnostics, sources, paths)
                    },
                    Ok(program) => {
                      mut current: ProjectLoadState = ProjectLoadState(state.programs, state.visited, state.diagnostics, sources, paths)
                      next_stack: [Str] = append(stack, path)
                      for declaration in program.declarations {
                        match declaration {
                          ImportDeclaration(imported) => {
                            if is_logical_import(imported) {
                              if !logical_import_valid(imported) {
                                diagnostics: [Diagnostic] = append(current.diagnostics, loader_diagnostic("invalid logical import path: ${imported}"))
                                current = ProjectLoadState(current.programs, current.visited, diagnostics, current.sources, current.source_paths)
                              } else {
                                if starts_with(imported, "stdlib/") && len(stdlib_root) == 0 {
                                  diagnostics: [Diagnostic] = append(current.diagnostics, loader_diagnostic("standard library root is not configured"))
                                  current = ProjectLoadState(current.programs, current.visited, diagnostics, current.sources, current.source_paths)
                                } else {
                                  parent: Str = path_parent(path)
                                  dependency: Str = resolve_import_path(imported, parent, project_root, stdlib_root)
                                  current = load_project_module(dependency, current, next_stack, project_root, stdlib_root, bounded)
                                }
                              }
                            } else {
                              if path_is_absolute(imported) {
                                diagnostics: [Diagnostic] = append(current.diagnostics, loader_diagnostic("imports must use relative or logical paths: ${imported}"))
                                current = ProjectLoadState(current.programs, current.visited, diagnostics, current.sources, current.source_paths)
                              } else {
                                if path_suffix(imported) != ".panack" {
                                  diagnostics: [Diagnostic] = append(current.diagnostics, loader_diagnostic("relative import must reference a .panack file: ${imported}"))
                                  current = ProjectLoadState(current.programs, current.visited, diagnostics, current.sources, current.source_paths)
                                } else {
                                  parent: Str = path_parent(path)
                                  dependency: Str = resolve_import_path(imported, parent, project_root, stdlib_root)
                                  current = load_project_module(dependency, current, next_stack, project_root, stdlib_root, bounded)
                                }
                              }
                            }
                          },
                          TypeDeclaration(name, base, guard) => {},
                          RecordDeclaration(name, parameters, fields) => {},
                          EnumDeclaration(name, parameters, variants) => {},
                          FunctionDeclaration(name, parameters, return_type, is_pure, is_async, body, type_parameters) => {}
                        }
                      }
                      programs: [Program] = append(current.programs, program)
                      ProjectLoadState(programs, current.visited.add(path), current.diagnostics, current.sources, current.source_paths)
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

load_project(entry: Str): LoadedProject {
  load_project_mode(entry, false, false)
}

load_project_for_source_map(entry: Str): LoadedProject {
  load_project_mode(entry, true, false)
}

load_project_explained(entry: Str): LoadedProject {
  load_project_mode(entry, true, true)
}

load_project_mode(entry: Str, bounded: Bool, retain: Bool): LoadedProject {
  resolved: Str = path_resolve(entry)
  project_root: Str = path_parent(resolved)
  stdlib_root: Str = if environment_has("PANACKELTY_STDLIB_PATH") {
    path_resolve(environment_get("PANACKELTY_STDLIB_PATH"))
  } else {
    ""
  }
  empty: Set[Str] = set()
  initial: ProjectLoadState = ProjectLoadState([], empty, [], map(), [])
  stack: [Str] = []
  mut core: ProjectLoadState = initial
  if len(stdlib_root) == 0 {
    core = ProjectLoadState([], empty, [loader_diagnostic("standard library root is not configured; core types require the bundled standard library")], map(), [])
  } else {
    core = load_project_module(path_join(stdlib_root, "core.panack"), initial, stack, project_root, stdlib_root, bounded)
  }
  loaded: ProjectLoadState = if len(core.diagnostics) == 0 {
    load_project_module(resolved, core, stack, project_root, stdlib_root, bounded)
  } else { core }
  program: Program = append_program_declarations(loaded.programs)
  mut diagnostics: [Diagnostic] = loaded.diagnostics
  if len(diagnostics) == 0 {
    diagnostics = concat(diagnostics, resolve_program(program))
  } else {}
  mut evidence: [SubtractionEvidence] = []
  mut effects: [EffectEvidence] = []
  mut effects_checked: Bool = false
  mut function_types: Map[Str,Bool] = map()
  if len(diagnostics) == 0 {
    checked: CheckedProgram = check_program_evidence(program, retain)
    checked_effects: CheckedEffects = check_frontend_effects(program, checked, retain)
    diagnostics = checked_effects.diagnostics
    evidence = checked.evidence
    effects = checked_effects.evidence
    function_types = checked.function_types
    effects_checked = len(checked.diagnostics) == 0 || (retain && checked.declarations_valid)
  }
  LoadedProject(program, diagnostics, loaded.sources, loaded.source_paths, evidence, effects, effects_checked, function_types)
}
