pub pure module_internal_primitive_name(identity: ModuleIdentity, name: Str): Bool {
  identity.package == ToolchainModulePackage() && (
    (identity.path == "http_runtime.panack" && (name == "http_bytes_slice" || name == "http_body" || name == "http_body_size" || name == "http_body_append" || name == "http_connection_continue")) ||
    (identity.path == "http_runtime.panack" && (name == "http_listen_ordinary" || name == "http_listen_contextual" || name == "http_close" || name == "http_destroy")) ||
    (identity.path == "http_runtime.panack" && (name == "http_connection_writer" || name == "http_connection_routes" || name == "http_connection_fallback" || name == "http_connection_admit" || name == "http_connection_invoke")) ||
    (identity.path == "http_runtime.panack" && (name == "http_writer_get_status" || name == "http_writer_get_headers" || name == "http_writer_reject" || name == "http_writer_status" || name == "http_writer_headers" || name == "http_writer_commit")) ||
    (identity.path == "http_runtime.panack" && (name == "http_state_create" || name == "http_state_context" || name == "http_state_setup_error" || name == "http_state_fail_setup" || name == "http_state_register")) ||
    (identity.path == "async_host.panack" && (name == "host_arguments_async" || name == "host_exit_async" || name == "host_stderr_async" || name == "host_stdout_async")) ||
    (identity.path == "time.panack" && (name == "duration_from_seconds" || name == "duration_nanoseconds" || name == "instant_now")) ||
    (identity.path == "process.panack" && (name == "process_run")) ||
    (identity.path == "http_transport.panack" && (name == "http_transport_exchange")) ||
    (identity.path == "async_filesystem.panack" && (name == "fs_read_beneath_async" || name == "fs_root_identity_async")) ||
    (identity.path == "environment.panack" && (name == "environment_get" || name == "environment_has")) ||
    (identity.path == "testing_files.panack" && (name == "fs_list" || name == "fs_metadata" || name == "fs_remove_directory" || name == "fs_temp_directory")) ||
    (identity.path == "host.panack" && (name == "command_args" || name == "eprint" || name == "host_decode_utf8" || name == "host_sleep" || name == "process_exit" || name == "run_bytecode_args")) ||
    (identity.path == "tcp.panack" && (name == "tcp_exchange" || name == "tcp_serve" || name == "tcp_serve_stream" || name == "tcp_server_read_chunk")) ||
    (identity.path == "path.panack" && (name == "path_current" || name == "path_from_native" || name == "path_from_text")) ||
    (identity.path == "testing_async.panack" && (name == "async_fake_read")) ||
    (identity.path == "filesystem.panack" && (name == "fs_create_directory" || name == "fs_list" || name == "fs_metadata" || name == "fs_read" || name == "fs_remove_directory" || name == "fs_remove_file" || name == "fs_temp_directory" || name == "fs_temp_file" || name == "fs_write")) ||
    (identity.path == "core.panack" && (name == "duration_from_seconds" || name == "duration_nanoseconds" || name == "path_absolute" || name == "path_append" || name == "path_directory" || name == "path_display" || name == "path_filename" || name == "path_native_bytes" || name == "path_to_text")) ||
    (identity.path == "compiler_paths.panack" && (name == "path_is_absolute" || name == "path_join" || name == "path_parent" || name == "path_resolve" || name == "path_suffix" || name == "path_with_suffix")) ||
    (identity.path == "package_filesystem.panack" && (name == "fs_directories_overlap" || name == "fs_read_beneath")) ||
    (identity.path == "tcp_service.panack" && (name == "tcp_service")) ||
    (identity.path == "compiler_files.panack" && (name == "file_exists" || name == "read_bytes" || name == "read_file" || name == "write_bytes"))
  )
}
