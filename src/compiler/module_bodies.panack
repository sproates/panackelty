// Bind namespace-aware bodies and solve local type constraints by semantic identity.
// A checked identity/type subset does not certify effects or enable execution.

// Structural lexical paths are identities, never names lowered into Program.
pub record BodyLocalIdentity {
  owner: DeclarationIdentity,
  path: [Nat],
  name: Str
}

pub record BodyLocal {
  identity: BodyLocalIdentity,
  type: Option[SignatureType],
  mutable: Bool
}

pub enum BodyTarget {
  BodyDeclaration(ModuleDeclarationBinding),
  BodyCore(Str)
}

pub enum BodyNode {
  BodyLiteral(Expr),
  BodyInterpolation([Str]),
  BodyLocalUse(BodyLocalIdentity),
  BodyFunction(ModuleDeclarationBinding),
  BodyCall(BodyTarget, [SignatureType], [CallArgumentEvidence]),
  BodyArray,
  BodyUnary(Str),
  BodyBinary(Str),
  BodyField(Str),
  BodyIndex,
  BodyIf(Bool),
  BodyBlock(Bool),
  BodyMatch([BodyTarget], [[BodyLocalIdentity]], [SourceSpan]),
  // The optional flag is populated only for explicit explanation checks. It
  // records whether this local's type came from its initializer or annotation.
  BodyBinding(BodyLocalIdentity, Option[SignatureType], Bool, Option[Bool], Option[BindingTypeEvidence]),
  BodyAssignment(BodyLocalIdentity, Option[AssignmentTypeEvidence]),
  BodyWhile,
  BodyFor(BodyLocalIdentity),
  BodyEmpty
}

pub record GuardConversionEvidence {
  span: SourceSpan,
  source_type: Str,
  target_type: Str,
  source_guard: Option[Str],
  target_guard: Str,
  bounds: Option[Bounds],
  proven: Option[Bool]
}

pub record BoundBody {
  node: BodyNode,
  span: SourceSpan,
  children: [BoundBody],
  type: Option[SignatureType],
  constraints: [BodySolution],
  guard_conversions: [GuardConversionEvidence],
  type_joins: [TypeJoinEvidence],
  callback_contracts: [CollectionCallbackEvidence],
  operator_checks: [OperatorTypeEvidence],
  type_checks: [BodyTypeCheckEvidence]
}

pub record BodyContext {
  graph: ModuleBindingGraph,
  modules: [LoadedModule],
  signatures: [ModuleSignature],
  owner: DeclarationIdentity,
  parameters: [Str],
  facts: Map[Str, Bounds],
  retain_guard_conversions: Bool
}

record BodyResult {
  body: BoundBody,
  diagnostics: [Diagnostic],
  deferred: [SourceSpan]
}

// Status certifies this identity-type subset only, never effects or execution.
pub enum BodyCheckStatus {
  BodyIdentityChecked,
  BodyDeferred,
  BodyInvalid
}

pub record ReturnTypeEvidence {
  span: SourceSpan,
  actual: Option[SignatureType],
  expected: SignatureType,
  accepted: Option[Bool]
}

pub record CallArgumentEvidence {
  label: Str,
  span: SourceSpan,
  actual: Option[SignatureType],
  expected: SignatureType,
  accepted: Option[Bool]
}

pub record BindingTypeEvidence {
  label: Str,
  span: SourceSpan,
  actual: Option[SignatureType],
  expected: SignatureType,
  accepted: Option[Bool]
}

pub record AssignmentTypeEvidence {
  label: Str,
  span: SourceSpan,
  actual: Option[SignatureType],
  expected: Option[SignatureType],
  accepted: Option[Bool]
}

pub record TypeJoinEvidence {
  context: Str,
  span: SourceSpan,
  left: Option[SignatureType],
  right: Option[SignatureType],
  result: Option[SignatureType],
  accepted: Option[Bool]
}

pub record CollectionCallbackEvidence {
  operation: Str,
  span: SourceSpan,
  callback: Option[SignatureType],
  expected_parameters: [SignatureType],
  result: Option[SignatureType],
  expected_result: Option[SignatureType],
  accepted: Option[Bool]
}

pub record OperatorTypeEvidence {
  operator: Str,
  unary: Bool,
  span: SourceSpan,
  left: Option[SignatureType],
  right: Option[SignatureType],
  result: Option[SignatureType],
  accepted: Option[Bool]
}

pub record BodyTypeCheckEvidence {
  context: Str,
  span: SourceSpan,
  actual: Option[SignatureType],
  expected: Str,
  result: Option[SignatureType],
  accepted: Option[Bool]
}

pub record BoundFunctionBody {
  signature: ModuleSignature,
  parameters: [BodyLocal],
  body: BoundBody,
  deferred: [SourceSpan],
  status: BodyCheckStatus,
  return_type_evidence: Option[ReturnTypeEvidence]
}

pub pure body_call_argument_evidence(body: BoundBody): [CallArgumentEvidence] {
  mut entries: [CallArgumentEvidence] = []
  match body.node {
    BodyCall(target, types, call_arguments) => {
      entries = concat(entries, call_arguments)
    },
    BodyBinding(local, type, mutable, inferred, type_evidence) => {},
    BodyLiteral(value) => {},
    BodyInterpolation(parts) => {},
    BodyLocalUse(local) => {},
    BodyFunction(binding) => {},
    BodyArray() => {},
    BodyUnary(operator) => {},
    BodyBinary(operator) => {},
    BodyField(name) => {},
    BodyIndex() => {},
    BodyIf(has_else) => {},
    BodyBlock(has_tail) => {},
    BodyMatch(targets, bindings, spans) => {},
    BodyAssignment(local, assignment_evidence) => {},
    BodyWhile() => {},
    BodyFor(local) => {},
    BodyEmpty() => {}
  }
  for child in body.children {
    entries = concat(entries, body_call_argument_evidence(child))
  }
  entries
}

pure body_direct_call_argument_metadata(body: BoundBody): [CallArgumentEvidence] {
  match body.node {
    BodyCall(target, types, call_arguments) => call_arguments,
    BodyBinding(local, type, mutable, inferred, type_evidence) => [],
    BodyLiteral(value) => [],
    BodyInterpolation(parts) => [],
    BodyLocalUse(local) => [],
    BodyFunction(binding) => [],
    BodyArray() => [],
    BodyUnary(operator) => [],
    BodyBinary(operator) => [],
    BodyField(name) => [],
    BodyIndex() => [],
    BodyIf(has_else) => [],
    BodyBlock(has_tail) => [],
    BodyMatch(targets, bindings, spans) => [],
    BodyAssignment(local, assignment_evidence) => [],
    BodyWhile() => [],
    BodyFor(local) => [],
    BodyEmpty() => []
  }
}

pub pure body_binding_type_evidence(body: BoundBody): [BindingTypeEvidence] {
  mut entries: [BindingTypeEvidence] = []
  match body.node {
    BodyBinding(local, type, mutable, inferred, type_evidence) => match type_evidence {
      None() => {},
      Some(evidence) => { entries = append(entries, evidence) }
    },
    BodyCall(target, types, call_arguments) => {},
    BodyLiteral(value) => {},
    BodyInterpolation(parts) => {},
    BodyLocalUse(local) => {},
    BodyFunction(binding) => {},
    BodyArray() => {},
    BodyUnary(operator) => {},
    BodyBinary(operator) => {},
    BodyField(name) => {},
    BodyIndex() => {},
    BodyIf(has_else) => {},
    BodyBlock(has_tail) => {},
    BodyMatch(targets, bindings, spans) => {},
    BodyAssignment(local, assignment_evidence) => {},
    BodyWhile() => {},
    BodyFor(local) => {},
    BodyEmpty() => {}
  }
  for child in body.children {
    entries = concat(entries, body_binding_type_evidence(child))
  }
  entries
}

pub pure body_assignment_type_evidence(body: BoundBody): [AssignmentTypeEvidence] {
  mut entries: [AssignmentTypeEvidence] = []
  match body.node {
    BodyAssignment(local, assignment_evidence) => match assignment_evidence {
      None() => {},
      Some(evidence) => { entries = append(entries, evidence) }
    },
    BodyBinding(local, type, mutable, inferred, type_evidence) => {},
    BodyCall(target, types, call_arguments) => {},
    BodyLiteral(value) => {},
    BodyInterpolation(parts) => {},
    BodyLocalUse(local) => {},
    BodyFunction(binding) => {},
    BodyArray() => {},
    BodyUnary(operator) => {},
    BodyBinary(operator) => {},
    BodyField(name) => {},
    BodyIndex() => {},
    BodyIf(has_else) => {},
    BodyBlock(has_tail) => {},
    BodyMatch(targets, bindings, spans) => {},
    BodyWhile() => {},
    BodyFor(local) => {},
    BodyEmpty() => {}
  }
  for child in body.children {
    entries = concat(entries, body_assignment_type_evidence(child))
  }
  entries
}

pub pure body_type_join_evidence(body: BoundBody): [TypeJoinEvidence] {
  mut entries: [TypeJoinEvidence] = body.type_joins
  for child in body.children {
    entries = concat(entries, body_type_join_evidence(child))
  }
  entries
}

pub pure body_collection_callback_evidence(body: BoundBody): [CollectionCallbackEvidence] {
  mut entries: [CollectionCallbackEvidence] = body.callback_contracts
  for child in body.children {
    entries = concat(entries, body_collection_callback_evidence(child))
  }
  entries
}

pub pure body_operator_type_evidence(body: BoundBody): [OperatorTypeEvidence] {
  mut entries: [OperatorTypeEvidence] = body.operator_checks
  for child in body.children {
    entries = concat(entries, body_operator_type_evidence(child))
  }
  entries
}

pub pure body_type_check_evidence(body: BoundBody): [BodyTypeCheckEvidence] {
  mut entries: [BodyTypeCheckEvidence] = body.type_checks
  for child in body.children {
    entries = concat(entries, body_type_check_evidence(child))
  }
  entries
}

pub record CheckedModuleBodies {
  functions: [BoundFunctionBody],
  diagnostics: [Diagnostic]
}

pure body_core_type(name: Str): Option[SignatureType] {
  Some(SignatureType(SignatureCore(name), []))
}

pure body_result(
  node: BodyNode,
  span: SourceSpan,
  children: [BoundBody],
  type: Option[SignatureType]
): BodyResult {
  BodyResult(BoundBody(node, span, children, type, [], [], [], [], [], []), [], [])
}

pure body_failure(message: Str, span: SourceSpan): BodyResult {
  BodyResult(BoundBody(BodyEmpty(), span, [], None(), [], [], [], [], [], []), [Diagnostic(message, span.start)], [])
}

pub pure body_signature(
  signatures: [ModuleSignature],
  identity: DeclarationIdentity
): Option[ModuleSignature] {
  mut found: Option[ModuleSignature] = None()

  for signature in signatures {
    if signature.binding.identity == identity {
      found = Some(signature)
    }
  }

  found
}

pub pure body_type_text(type: SignatureType): Str {
  head: Str = match type.identity {
    SignatureCore(name) => name,
    SignatureNominal(identity) => identity.module.path + ":" + identity.name,
    SignatureHole(owner, path, index) => "unresolved type",
    SignatureParameter(owner, index) => owner.module.path + ":" + owner.name + " parameter ${index}",
    SignatureCallable(effect) => match effect {
      SignaturePure() => "PureFn",
      SignatureOrdinary() => "Fn",
      SignatureAsync() => "AsyncFn"
    }
  }
  mut arguments: [Str] = []

  for argument in type.arguments {
    arguments = append(arguments, body_type_text(argument))
  }
  if len(arguments) == 0 {
    head
  } else {
    render_type(head, arguments)
  }
}

// Guarded nominal conversions need proof evidence from the shared checker.
// Resolving a declaration here only identifies that boundary; it cannot prove it.
pure body_is_guarded(context: BodyContext, type: SignatureType): Bool {
  mut guarded: Bool = false

  match type.identity {
    SignatureNominal(identity) => match signature_declaration(context.modules, identity) {
      Error(message) => {},
      Ok(declaration) => match declaration {
        TypeDeclaration(name, base, guard) => {
          guarded = true
        },
        ImportDeclaration(path) => {},
        RecordDeclaration(name, types, fields) => {},
        EnumDeclaration(name, types, variants) => {},
        FunctionDeclaration(name, values, result, pure_flag, async_flag, body, types) => {}
      }
    },
    SignatureCore(name) => {},
    SignatureParameter(owner, index) => {},
    SignatureCallable(effect) => {},
    SignatureHole(owner, path, index) => {}
  }
  guarded
}

// Fact keys are derived from the structural binder path, never the spelling.
// The context is scoped to one function, so the path uniquely identifies a local.
pure body_fact_key(identity: BodyLocalIdentity): Str {
  mut result: Str = ""
  for part in identity.path {
    result = result + "/${part}"
  }
  result
}

pure body_guard_bounds(context: BodyContext, value: BoundBody): Option[Bounds] {
  mut result: Option[Bounds] = None()
  match value.node {
    BodyLocalUse(identity) => {
      key: Str = body_fact_key(identity)
      if context.facts.has(key) {
        bounds: Bounds = context.facts.get(key)
        if bounds.has_lower || bounds.has_upper {
          result = Some(bounds)
        }
      }
    },
    BodyBlock(has_tail) => {
      if has_tail && len(value.children) > 0 {
        mut last: Option[BoundBody] = None()
        for child in value.children {
          last = Some(child)
        }
        match last {
          None() => {},
          Some(child) => {
            result = body_guard_bounds(context, child)
          }
        }
      }
    },
    BodyLiteral(literal) => match unlocated_expression(literal) {
      NatExpr(number) => {
        result = Some(Bounds(true, number, true, number, None()))
      },
      LocatedExpr(position, inner, located_type_argument_spans) => {},
      DecimalExpr(text) => {},
      StringExpr(text) => {},
      BoolExpr(flag) => {},
      NameExpr(name) => {},
      FunctionExpr(name) => {},
      ArrayExpr(items) => {},
      UnaryExpr(operator, operand) => {},
      BinaryExpr(operator, left, right) => {},
      CallExpr(name, arguments, types) => {},
      DotCallExpr(target, name, arguments, types) => {},
      FieldExpr(target, field) => {},
      IndexExpr(target, index) => {},
      IfExpr(condition, yes, no, has_else) => {},
      BlockExpr(block) => {},
      MatchExpr(subject, arms) => {}
    },
    BodyInterpolation(parts) => {},
    BodyFunction(binding) => {},
    BodyCall(target, types, call_arguments) => {},
    BodyArray() => {},
    BodyUnary(operator) => {},
    BodyBinary(operator) => {},
    BodyField(field) => {},
    BodyIndex() => {},
    BodyIf(has_else) => {},
    BodyMatch(targets, bindings, spans) => {},
    BodyBinding(identity, type, mutable, inferred, type_evidence) => {},
    BodyAssignment(identity, assignment_evidence) => {},
    BodyWhile() => {},
    BodyFor(identity) => {},
    BodyEmpty() => {}
  }
  result
}

pure body_guard_spec(context: BodyContext, type: SignatureType): Option[GuardedTypeLookup] {
  mut result: Option[GuardedTypeLookup] = None()
  match type.identity {
    SignatureNominal(identity) => match signature_declaration(context.modules, identity) {
      Error(message) => {},
      Ok(declaration) => match declaration {
        TypeDeclaration(name, base, guard) => {
          result = Some(GuardedTypeLookup(true, base, guard))
        },
        ImportDeclaration(path) => {},
        RecordDeclaration(name, types, fields) => {},
        EnumDeclaration(name, types, variants) => {},
        FunctionDeclaration(name, values, output, pure_flag, async_flag, body, types) => {}
      }
    },
    SignatureCore(name) => {},
    SignatureParameter(owner, index) => {},
    SignatureCallable(effect) => {},
    SignatureHole(owner, path, index) => {}
  }
  result
}

record BodyGuardConversionDecision {
  proven: Option[Bool],
  evidence: Option[GuardConversionEvidence]
}

pure body_guard_source_span(value: BoundBody): SourceSpan {
  mut span: SourceSpan = value.span
  match value.node {
    BodyBlock(has_tail) => if has_tail {
      for child in value.children {
        span = body_guard_source_span(child)
      }
    },
    BodyLiteral(literal) => {},
    BodyInterpolation(parts) => {},
    BodyLocalUse(identity) => {},
    BodyFunction(binding) => {},
    BodyCall(target, types, call_arguments) => {},
    BodyArray() => {},
    BodyUnary(operator) => {},
    BodyBinary(operator) => {},
    BodyField(field) => {},
    BodyIndex() => {},
    BodyIf(has_else) => {},
    BodyMatch(targets, bindings, spans) => {},
    BodyBinding(identity, type, mutable, inferred, type_evidence) => {},
    BodyAssignment(identity, assignment_evidence) => {},
    BodyWhile() => {},
    BodyFor(identity) => {},
    BodyEmpty() => {}
  }
  span
}

pure body_guard_conversion(
  context: BodyContext,
  value: BoundBody,
  expected: SignatureType
): Option[BodyGuardConversionDecision] {
  mut result: Option[BodyGuardConversionDecision] = None()
  match value.type {
    None() => {},
    Some(actual) => match body_guard_spec(context, expected) {
      Some(target) => match actual.identity {
        SignatureCore(actual_base) => {
          compatible: Bool = actual_base == target.base ||
            (actual_base == "Nat" && target.base == "Int")
          if compatible {
            bounds: Option[Bounds] = body_guard_bounds(context, value)
            proven: Option[Bool] = match bounds {
              None() => None(),
              Some(facts) => Some(prove_guard_bounds(target.guard, facts))
            }
            evidence: GuardConversionEvidence = GuardConversionEvidence(
              body_guard_source_span(value),
              body_type_text(actual),
              body_type_text(expected),
              None(),
              render_expr(target.guard),
              bounds,
              proven
            )
            result = Some(BodyGuardConversionDecision(proven, Some(evidence)))
          } else {}
        },
        SignatureNominal(identity) => match body_guard_spec(context, actual) {
          None() => {},
          Some(source) => {
            compatible: Bool = source.base == target.base ||
              (source.base == "Nat" && target.base == "Int")
            if compatible {
              source_facts: Map[Str, Bounds] = condition_facts(source.guard, map(), true)
              mut bounds: Option[Bounds] = None()
              if source_facts.has("value") {
                bounds = Some(source_facts.get("value"))
              }
              proven: Option[Bool] = match bounds {
                None() => None(),
                Some(facts) => Some(prove_guard_bounds(target.guard, facts))
              }
              evidence: GuardConversionEvidence = GuardConversionEvidence(
                body_guard_source_span(value),
                body_type_text(actual),
                body_type_text(expected),
                Some(render_expr(source.guard)),
                render_expr(target.guard),
                bounds,
                proven
              )
              result = Some(BodyGuardConversionDecision(proven, Some(evidence)))
            } else {}
          }
        },
        SignatureParameter(owner, index) => {},
        SignatureCallable(effect) => {},
        SignatureHole(owner, path, index) => {}
      },
      None() => match body_guard_spec(context, actual) {
        Some(source) => {
          target_base: Str = match expected.identity {
            SignatureCore(name) => name,
            SignatureNominal(identity) => "",
            SignatureParameter(owner, index) => "",
            SignatureCallable(effect) => "",
            SignatureHole(owner, path, index) => ""
          }
          if target_base == source.base ||
            (source.base == "Nat" && target_base == "Int") {
            result = Some(BodyGuardConversionDecision(Some(true), None()))
          } else {}
        },
        None() => {}
      }
    }
  }
  result
}

pure body_compatibility_value(
  context: BodyContext,
  value: BoundBody,
  expected: SignatureType
): Option[Bool] {
  match body_guard_conversion(context, value, expected) {
    Some(decision) => match decision.proven {
      Some(valid) => Some(valid),
      None() => match value.type {
        None() => None(),
        Some(actual) => body_compatibility(context, actual, expected)
      }
    },
    None() => match value.type {
      None() => None(),
      Some(actual) => body_compatibility(context, actual, expected)
    }
  }
}

pure body_require_value(
  context: BodyContext,
  value: BoundBody,
  expected: SignatureType,
  label: Str
): BodyResult {
  match body_compatibility_value(context, value, expected) {
    None() => BodyResult(body_result(BodyEmpty(), value.span, [], None()).body, [], [value.span]),
    Some(valid) => if valid {
      body_result(BodyEmpty(), value.span, [], None())
    } else {
      body_failure(
        label + " is " + body_type_text(match value.type {
          Some(actual) => actual,
          None() => expected
        }) + ", expected " + body_type_text(expected),
        value.span
      )
    }
  }
}

pure body_return_value_span(body: BoundBody): SourceSpan {
  mut span: SourceSpan = body.span
  match body.node {
    BodyBlock(has_tail) => if has_tail {
      for child in body.children {
        span = child.span
      }
    },
    BodyBinding(local, type, mutable, inferred, type_evidence) => {},
    BodyLiteral(value) => {},
    BodyInterpolation(parts) => {},
    BodyLocalUse(local) => {},
    BodyFunction(binding) => {},
    BodyCall(target, types, call_arguments) => {},
    BodyArray() => {},
    BodyUnary(operator) => {},
    BodyBinary(operator) => {},
    BodyField(name) => {},
    BodyIndex() => {},
    BodyIf(has_else) => {},
    BodyMatch(targets, bindings, spans) => {},
    BodyAssignment(local, assignment_evidence) => {},
    BodyWhile() => {},
    BodyFor(local) => {},
    BodyEmpty() => {}
  }
  span
}

pure body_operation_scalar(context: BodyContext, value: BoundBody): Str {
  mut result: Str = ""
  match value.type {
    None() => {},
    Some(type) => {
      result = body_scalar(type)
      if result == "" {
        match body_guard_spec(context, type) {
          None() => {},
          Some(guarded) => {
            result = guarded.base
          }
        }
      }
    }
  }
  result
}

pure body_operand_lower_bound(context: BodyContext, value: BoundBody): Option[Nat] {
  mut result: Option[Nat] = None()
  match body_guard_bounds(context, value) {
    None() => {},
    Some(bounds) => if bounds.has_lower {
      result = Some(bounds.lower)
    }
  }
  match value.type {
    None() => {},
    Some(type) => match body_guard_spec(context, type) {
      None() => {},
      Some(guarded) => {
        intrinsic: Map[Str, Bounds] = condition_facts(guarded.guard, map(), true)
        if intrinsic.has("value") {
          intrinsic_bounds: Bounds = intrinsic.get("value")
          if intrinsic_bounds.has_lower {
            match result {
              None() => {
                result = Some(intrinsic_bounds.lower)
              },
              Some(existing) => if intrinsic_bounds.lower > existing {
                result = Some(intrinsic_bounds.lower)
              }
            }
          }
        }
      }
    }
  }
  result
}

pure body_proves_nat_subtraction(
  context: BodyContext,
  left: BoundBody,
  right: BoundBody
): Bool {
  match body_condition_literal(right) {
    None() => false,
    Some(amount) => match left.node {
      BodyLocalUse(identity) => match body_operand_lower_bound(context, left) {
        None() => false,
        Some(lower) => lower >= amount
      },
      BodyLiteral(literal) => match body_condition_literal(left) {
        None() => false,
        Some(value) => value >= amount
      },
      BodyInterpolation(parts) => false,
      BodyFunction(binding) => false,
      BodyCall(target, types, call_arguments) => false,
      BodyArray() => false,
      BodyUnary(operator) => false,
      BodyBinary(operator) => false,
      BodyField(field) => false,
      BodyIndex() => false,
      BodyIf(has_else) => false,
      BodyBlock(has_tail) => false,
      BodyMatch(targets, bindings, spans) => false,
      BodyBinding(identity, type, mutable, inferred, type_evidence) => false,
      BodyAssignment(identity, assignment_evidence) => false,
      BodyWhile() => false,
      BodyFor(identity) => false,
      BodyEmpty() => false
    }
  }
}

pure body_context_with_facts(context: BodyContext, facts: Map[Str, Bounds]): BodyContext {
  BodyContext(
    context.graph,
    context.modules,
    context.signatures,
    context.owner,
    context.parameters,
    facts,
    context.retain_guard_conversions
  )
}

pure body_condition_literal(value: BoundBody): Option[Nat] {
  mut result: Option[Nat] = None()
  match value.node {
    BodyLiteral(literal) => match unlocated_expression(literal) {
      NatExpr(number) => {
        result = Some(number)
      },
      LocatedExpr(position, inner, located_type_argument_spans) => {},
      DecimalExpr(text) => {},
      StringExpr(text) => {},
      BoolExpr(flag) => {},
      NameExpr(name) => {},
      FunctionExpr(name) => {},
      ArrayExpr(items) => {},
      UnaryExpr(operator, operand) => {},
      BinaryExpr(operator, left, right) => {},
      CallExpr(name, arguments, types) => {},
      DotCallExpr(target, name, arguments, types) => {},
      FieldExpr(target, field) => {},
      IndexExpr(target, index) => {},
      IfExpr(condition, yes, no, has_else) => {},
      BlockExpr(block) => {},
      MatchExpr(subject, arms) => {}
    },
    BodyInterpolation(parts) => {},
    BodyLocalUse(identity) => {},
    BodyFunction(binding) => {},
    BodyCall(target, types, call_arguments) => {},
    BodyArray() => {},
    BodyUnary(operator) => {},
    BodyBinary(operator) => {},
    BodyField(field) => {},
    BodyIndex() => {},
    BodyIf(has_else) => {},
    BodyBlock(has_tail) => {},
    BodyMatch(targets, bindings, spans) => {},
    BodyBinding(identity, type, mutable, inferred, type_evidence) => {},
    BodyAssignment(identity, assignment_evidence) => {},
    BodyWhile() => {},
    BodyFor(identity) => {},
    BodyEmpty() => {}
  }
  result
}

pure body_add_local_bound(
  facts: Map[Str, Bounds],
  identity: BodyLocalIdentity,
  operator: Str,
  value: Nat,
  truth: Bool
): Map[Str, Bounds] {
  key: Str = body_fact_key(identity)
  prior: Bounds = if facts.has(key) {
    facts.get(key)
  } else {
    Bounds(false, 0, false, 0, None())
  }
  mut next: Bounds = prior
  if (operator == ">" && truth) || (operator == "<=" && !truth) {
    next = Bounds(true, value + 1, prior.has_upper, prior.upper, None())
  }
  if (operator == ">=" && truth) || (operator == "<" && !truth) {
    next = Bounds(true, value, prior.has_upper, prior.upper, None())
  }
  if (operator == "<=" && truth) || (operator == ">" && !truth) {
    next = Bounds(prior.has_lower, prior.lower, true, value, prior.lower_origin)
  }
  if (operator == "<" && truth) || (operator == ">=" && !truth) {
    if value > 0 {
      next = Bounds(prior.has_lower, prior.lower, true, value - 1, prior.lower_origin)
    }
  }
  if operator == "==" && truth {
    next = Bounds(true, value, true, value, None())
  }
  if operator == "!=" && truth && value == 0 {
    next = Bounds(true, 1, prior.has_upper, prior.upper, None())
  }
  if operator == "==" && !truth && value == 0 {
    next = Bounds(true, 1, prior.has_upper, prior.upper, None())
  }
  facts.put(key, next)
}

// Facts flow only when a boolean composition guarantees them on this path.
// Both conjunction-true and disjunction-false establish each operand in order.
pure body_condition_facts(
  condition: BoundBody,
  facts: Map[Str, Bounds],
  truth: Bool
): Map[Str, Bounds] {
  mut result: Map[Str, Bounds] = facts
  match condition.node {
    BodyUnary(operator) => {
      if operator == "!" && len(condition.children) == 1 {
        result = body_condition_facts(condition.children[0], facts, !truth)
      }
    },
    BodyBinary(operator) => {
      if (operator == "&&" && truth) || (operator == "||" && !truth) {
        result = body_condition_facts(condition.children[0], facts, truth)
        result = body_condition_facts(condition.children[1], result, truth)
      } else {
        if operator != "&&" && operator != "||" && len(condition.children) == 2 {
          match condition.children[0].node {
            BodyLocalUse(identity) => match body_condition_literal(condition.children[1]) {
              None() => {},
              Some(value) => {
                result = body_add_local_bound(facts, identity, operator, value, truth)
              }
            },
            BodyLiteral(literal) => match condition.children[1].node {
              BodyLocalUse(identity) => match body_condition_literal(condition.children[0]) {
                None() => {},
                Some(value) => {
                  reversed: Str = if operator == ">" {
                    "<"
                  } else {
                    if operator == ">=" {
                      "<="
                    } else {
                      if operator == "<" {
                        ">"
                      } else {
                        if operator == "<=" { ">=" } else { operator }
                      }
                    }
                  }
                  result = body_add_local_bound(facts, identity, reversed, value, truth)
                }
              },
              BodyLiteral(other_literal) => {},
              BodyInterpolation(parts) => {},
              BodyFunction(binding) => {},
              BodyCall(target, types, call_arguments) => {},
              BodyArray() => {},
              BodyUnary(other_operator) => {},
              BodyBinary(other_operator) => {},
              BodyField(field) => {},
              BodyIndex() => {},
              BodyIf(has_else) => {},
              BodyBlock(has_tail) => {},
              BodyMatch(targets, bindings, spans) => {},
              BodyBinding(other_identity, type, mutable, inferred, type_evidence) => {},
              BodyAssignment(other_identity, assignment_evidence) => {},
              BodyWhile() => {},
              BodyFor(other_identity) => {},
              BodyEmpty() => {}
            },
            BodyInterpolation(parts) => {},
            BodyFunction(binding) => {},
            BodyCall(target, types, call_arguments) => {},
            BodyArray() => {},
            BodyField(field) => {},
            BodyIndex() => {},
            BodyIf(has_else) => {},
            BodyBlock(has_tail) => {},
            BodyMatch(targets, bindings, spans) => {},
            BodyBinding(identity, type, mutable, inferred, type_evidence) => {},
            BodyAssignment(identity, assignment_evidence) => {},
            BodyFor(identity) => {},
            BodyWhile() => {},
            BodyUnary(other_operator) => {},
            BodyBinary(other_operator) => {},
            BodyEmpty() => {}
          }
        }
      }
    },
    BodyLiteral(value) => {},
    BodyInterpolation(parts) => {},
    BodyLocalUse(identity) => {},
    BodyFunction(binding) => {},
    BodyCall(target, types, call_arguments) => {},
    BodyArray() => {},
    BodyField(field) => {},
    BodyIndex() => {},
    BodyIf(has_else) => {},
    BodyBlock(has_tail) => {},
    BodyMatch(targets, bindings, spans) => {},
    BodyBinding(identity, type, mutable, inferred, type_evidence) => {},
    BodyAssignment(identity, assignment_evidence) => {},
    BodyWhile() => {},
    BodyFor(identity) => {},
    BodyEmpty() => {}
  }
  result
}

pure body_invalidate_assigned_locals(
  facts: Map[Str, Bounds],
  body: BoundBody
): Map[Str, Bounds] {
  mut result: Map[Str, Bounds] = facts
  match body.node {
    BodyAssignment(identity, assignment_evidence) => {
      result = result.put(body_fact_key(identity), Bounds(false, 0, false, 0, None()))
    },
    BodyLiteral(value) => {},
    BodyInterpolation(parts) => {},
    BodyLocalUse(identity) => {},
    BodyFunction(binding) => {},
    BodyCall(target, types, call_arguments) => {},
    BodyArray() => {},
    BodyUnary(operator) => {},
    BodyBinary(operator) => {},
    BodyField(field) => {},
    BodyIndex() => {},
    BodyIf(has_else) => {},
    BodyBlock(has_tail) => {},
    BodyMatch(targets, bindings, spans) => {},
    BodyBinding(identity, type, mutable, inferred, type_evidence) => {},
    BodyWhile() => {},
    BodyFor(identity) => {},
    BodyEmpty() => {}
  }
  for child in body.children {
    result = body_invalidate_assigned_locals(result, child)
  }
  result
}

pure body_is_callable(type: SignatureType): Bool {
  match type.identity {
    SignatureCallable(effect) => true,
    SignatureCore(name) => false,
    SignatureNominal(identity) => false,
    SignatureParameter(owner, index) => false,
    SignatureHole(owner, path, index) => false
  }
}

// An incompatible argument dominates a deferred one. Keep examining all slots
// so that missing evidence cannot conceal a known contradiction.
pure body_argument_compatibility(
  context: BodyContext,
  actual: [SignatureType],
  expected: [SignatureType]
): Option[Bool] {
  mut compatible: Bool = true
  mut deferred: Bool = false
  mut index: Nat = 0

  for argument in actual {
    match body_compatibility(context, argument, expected[index]) {
      None() => {
        deferred = true
      },
      Some(valid) => {
        compatible = compatible && valid
      }
    }
    index = index + 1
  }
  if !compatible {
    Some(false)
  } else {
    if deferred {
      None()
    } else {
      Some(true)
    }
  }
}

pure body_concrete_compatibility(
  context: BodyContext,
  actual: SignatureType,
  expected: SignatureType
): Option[Bool] {
  if body_is_guarded(context, actual) || body_is_guarded(context, expected) {
    None()
  } else {
    if body_is_callable(actual) || body_is_callable(expected) {
      // Only pure-to-ordinary coercion is supported, with identical slots.
      Some(actual.identity == SignatureCallable(SignaturePure()) &&
        expected.identity == SignatureCallable(SignatureOrdinary()) &&
        actual.arguments == expected.arguments)
    } else {
      if actual.identity != expected.identity || len(actual.arguments) != len(expected.arguments) {
        Some(false)
      } else {
        body_argument_compatibility(context, actual.arguments, expected.arguments)
      }
    }
  }
}

// Missing expression evidence has a distinct hole tag. It admits constraints
// for later solving, but never turns Void into a storable value.
pub pure body_compatibility(
  context: BodyContext,
  actual: SignatureType,
  expected: SignatureType
): Option[Bool] {
  if body_is_hole(actual) || body_is_hole(expected) {
    void_type: SignatureType = SignatureType(SignatureCore("Void"), [])
    Some(actual != void_type && expected != void_type)
  } else {
    if actual == expected ||
      (actual == SignatureType(SignatureCore("Nat"), []) &&
      expected == SignatureType(SignatureCore("Int"), [])) {
      Some(true)
    } else {
      body_concrete_compatibility(context, actual, expected)
    }
  }
}

pure body_require(
  context: BodyContext,
  actual: Option[SignatureType],
  expected: SignatureType,
  label: Str,
  span: SourceSpan
): BodyResult {
  mut result: BodyResult = body_result(BodyEmpty(), span, [], None())

  match actual {
    None() => {
      result = BodyResult(result.body, [], [span])
    },
    Some(type) => match body_compatibility(context, type, expected) {
      None() => {
        result = BodyResult(result.body, [], [span])
      },
      Some(valid) => {
        if !valid {
          result = body_failure(
            label + " is " + body_type_text(type) + ", expected " + body_type_text(expected),
            span
          )
        }
      }
    }
  }

  result
}

pure body_target(context: BodyContext, name: Str, function_only: Bool): Result[BodyTarget, Str] {
  if !function_only && module_reserved_binding(name) {
    Ok(BodyCore(name))
  } else {
    match resolve_module_path(context.graph, context.owner.module, name) {
      Error(message) => Error(message),
      Ok(target) => match target {
        NamespaceTarget(owner) => Error("namespace cannot be called: " + name),
        DeclarationTarget(binding) => {
          if function_only && binding.kind != ModuleFunction() {
            Error("declaration is not a function: " + name)
          } else {
            if binding.kind == ModuleEnum() {
              Error("enum type cannot be called: " + name)
            } else {
              Ok(BodyDeclaration(binding))
            }
          }
        }
      }
    }
  }
}

pure body_type_argument_span(
  type_argument_spans: [SourceSpan],
  index: Nat,
  fallback: SourceSpan
): SourceSpan {
  if index < len(type_argument_spans) {
    type_argument_spans[index]
  } else {
    fallback
  }
}

pure body_type_argument_count_span(
  type_argument_spans: [SourceSpan],
  expected_count: Nat,
  fallback: SourceSpan
): SourceSpan {
  if len(type_argument_spans) > expected_count {
    type_argument_spans[expected_count]
  } else {
    if len(type_argument_spans) > 0 {
      type_argument_spans[prior_index(len(type_argument_spans))]
    } else {
      fallback
    }
  }
}

// Select from the receiver's nominal identity, never the caller's global name.
// Binding the receiver here only inspects its type; emitted children evaluate it once.
pure body_owned_target(
  context: BodyContext, method: Str, arguments: [Expr], span: SourceSpan,
  locals: Map[Str, BodyLocal], path: [Nat]
): Result[BodyTarget, Str] {
  mut result: Result[BodyTarget, Str] = Error("owned method requires a local record receiver: " + method)
  if len(arguments) > 0 {
    receiver: BodyResult = bind_body_expression(context, arguments[0], span, locals, append(path, 0))
    if len(receiver.diagnostics) > 0 {
      result = Error(receiver.diagnostics[0].message)
    } else {
      match receiver.body.type {
        None() => {},
        Some(type) => match type.identity {
          SignatureNominal(owner) => {
            if owner.module == context.owner.module && len(type.arguments) == 0 {
              match resolve_module_function(context.graph, owner.module, owned_method_name(owner.name, method)) {
                Error(message) => { result = Error("unknown owned method " + owner.name + "->" + method) },
                Ok(binding) => { result = Ok(BodyDeclaration(binding)) }
              }
            }
          },
          SignatureCore(name) => {},
          SignatureParameter(owner, index) => {},
          SignatureCallable(effect) => {},
          SignatureHole(owner, location, index) => {}
        }
      }
    }
  }
  result
}

pure body_call(
  context: BodyContext,
  target: BodyTarget,
  arguments: [Expr],
  types: [Str],
  type_argument_spans: [SourceSpan],
  span: SourceSpan,
  locals: Map[Str, BodyLocal],
  path: [Nat]
): BodyResult {
  mut children: [BoundBody] = []
  mut diagnostics: [Diagnostic] = []
  mut deferred: [SourceSpan] = []
  mut index: Nat = 0

  for argument in arguments {
    checked: BodyResult = bind_body_expression(context, argument, span, locals, append(path, index))
    children = append(children, checked.body)
    diagnostics = concat(diagnostics, checked.diagnostics)
    deferred = concat(deferred, checked.deferred)
    if checked.body.type == body_core_type("Void") {
      diagnostics = append(
        diagnostics,
        Diagnostic(
        "Void is not a value and cannot be passed as an argument",
        checked.body.span.start
      )
      )
    }
    index = index + 1
  }
  mut resolved_types: [SignatureType] = []
  mut call_arguments: [CallArgumentEvidence] = []
  mut type_checks: [BodyTypeCheckEvidence] = []
  mut type_joins: [TypeJoinEvidence] = []
  mut type_index: Nat = 0
  for type in types {
    match signature_type(
      context.graph,
      context.modules,
      context.owner,
      context.parameters,
      type,
      false,
      false
    ) {
      Error(message) => {
        type_span: SourceSpan = body_type_argument_span(type_argument_spans, type_index, span)
        diagnostics = append(diagnostics, Diagnostic(message, type_span.start))
      },
      Ok(resolved) => {
        resolved_types = append(resolved_types, resolved)
      }
    }
    type_index = type_index + 1
  }
  mut output: Option[SignatureType] = None()
  if !body_special_core_call(target) {
    match body_contract(context, target) {
    Error(message) => {
      diagnostics = append(diagnostics, Diagnostic(message, span.start))
    },
    Ok(optional) => match optional {
      None() => {
        deferred = append(deferred, span)
      },
      Some(contract) => {
        if len(children) != len(contract.inputs) {
          expected_count: Nat = len(contract.inputs)
          actual_count: Nat = len(children)
          if context.retain_guard_conversions {
            type_checks = append(type_checks, BodyTypeCheckEvidence(
              "direct call arity",
              span,
              None(),
              "expected ${expected_count}; found ${actual_count}",
              None(),
              Some(false)
            ))
          }
          diagnostics = append(
            diagnostics,
            Diagnostic(
            contract.name + " expects ${expected_count} arguments, got ${actual_count}",
            span.start
          )
          )
        } else {
          if context.retain_guard_conversions {
            expected_count: Nat = len(contract.inputs)
            actual_count: Nat = len(children)
            type_checks = append(type_checks, BodyTypeCheckEvidence(
              "direct call arity",
              span,
              None(),
              "expected ${expected_count}; found ${actual_count}",
              None(),
              Some(true)
            ))
          }
        }
        if len(types) > 0 && (contract.constructor || len(contract.parameters) == 0) {
          type_span: SourceSpan = body_type_argument_span(type_argument_spans, 0, span)
          type_checks = concat(
            type_checks,
            body_explicit_type_argument_arity_evidence(context, type_span, 0, len(types))
          )
          diagnostics = append(
            diagnostics,
            Diagnostic("explicit type arguments require a generic function", type_span.start)
          )
        }
        mut inferred: [SignatureType] = []
        index = 0
        while index < len(contract.parameters) {
          inferred = append(inferred, SignatureType(SignatureHole(context.owner, path, index), []))
          index = index + 1
        }
        mut inference_deferred: Bool = false
        if len(types) > 0 {
          type_span: SourceSpan = body_type_argument_count_span(
            type_argument_spans,
            len(contract.parameters),
            span
          )
          if !contract.constructor && len(contract.parameters) > 0 {
            type_checks = concat(
              type_checks,
              body_explicit_type_argument_arity_evidence(
                context,
                type_span,
                len(contract.parameters),
                len(types)
              )
            )
          }
          if len(types) != len(contract.parameters) {
            diagnostics = append(
              diagnostics,
              Diagnostic("call " + contract.name + " has incorrect type argument count", type_span.start)
            )
          } else {
            if len(resolved_types) == len(types) {
              inferred = resolved_types
            }
          }
        } else {
          index = 0
          for child in children {
            if index < len(contract.inputs) {
              match child.type {
                None() => {
                  inference_deferred = true
                },
                Some(actual) => {
                  inference: BodyInference = body_infer(
                    context,
                    contract.inputs[index],
                    actual,
                    contract.owner,
                    inferred,
                    contract.name,
                    contract.parameters,
                    child.span
                  )
                  type_joins = concat(type_joins, inference.type_joins)
                  match inference.failure {
                    Some(message) => {
                      diagnostics = append(
                        diagnostics,
                        Diagnostic(
                          "inference for " + contract.name + ": " + message,
                          child.span.start
                        )
                      )
                    },
                    None() => {
                      inferred = inference.arguments
                      inference_deferred = inference_deferred || inference.deferred
                    }
                  }
                }
              }
            }
            index = index + 1
          }
        }
        if !contract.constructor && len(types) == 0 {
          index = 0
          for argument in inferred {
            if !body_type_complete(argument) {
              if inference_deferred {
                deferred = append(deferred, span)
              } else {
                parameter_name: Str = contract.parameters[index]
                diagnostics = append(
                  diagnostics,
                  Diagnostic(
                  "cannot infer type parameter " + parameter_name + " for " + contract.name + "; supply explicit type arguments",
                  span.start
                )
                )
              }
            }
            index = index + 1
          }
        }
        if inference_deferred {
          deferred = append(deferred, span)
        }
        resolved_types = inferred
        index = 0
        mut refined: [BoundBody] = []
        for child in children {
          mut value: BoundBody = child
          if index < len(contract.inputs) {
            match substitute_signature_type(contract.inputs[index], contract.owner, inferred) {
              Error(message) => {
                diagnostics = append(diagnostics, Diagnostic(message, child.span.start))
              },
              Ok(expected) => {
                number: Nat = index + 1
                required: BodyResult = body_require_value(
                  context,
                  child,
                  expected,
                  "argument ${number} to " + contract.name
                )
                diagnostics = concat(diagnostics, required.diagnostics)
                deferred = concat(deferred, required.deferred)
                refined_child: BodyResult = body_refine(
                  context,
                  BodyResult(child, [], []),
                  expected
                )
                if context.retain_guard_conversions {
                  argument_diagnostics: [Diagnostic] = concat(
                    required.diagnostics,
                    refined_child.diagnostics
                  )
                  argument_deferred: [SourceSpan] = concat(
                    required.deferred,
                    refined_child.deferred
                  )
                  accepted: Option[Bool] = if len(argument_diagnostics) > 0 {
                    Some(false)
                  } else {
                    if len(argument_deferred) > 0 {
                      None()
                    } else {
                      Some(true)
                    }
                  }
                  call_arguments = append(call_arguments, CallArgumentEvidence(
                    "call argument " + body_nat_text(index + 1) + " to " + contract.name,
                    child.span,
                    child.type,
                    expected,
                    accepted
                  ))
                }
                value = refined_child.body
                diagnostics = concat(diagnostics, refined_child.diagnostics)
                deferred = concat(deferred, refined_child.deferred)
              }
            }
          }
          refined = append(refined, value)
          index = index + 1
        }
        children = refined
        match substitute_signature_type(contract.output, contract.owner, inferred) {
          Error(message) => {
            diagnostics = append(diagnostics, Diagnostic(message, span.start))
          },
          Ok(type) => {
            if inference_deferred && !body_type_complete(type) {
              output = None()
            } else {
              output = Some(type)
            }
          }
        }
      }
    }
    }
  }
  if body_special_core_call(target) {
    body_retain_rejected_type_argument_arity(
      context,
      body_check_special_core_call(
        context,
        target,
        children,
        resolved_types,
        body_type_argument_span(type_argument_spans, 0, span),
        span,
        diagnostics,
        deferred
      ),
      len(types),
      body_type_argument_span(type_argument_spans, 0, span)
    )
  } else {
    BodyResult(
      BoundBody(BodyCall(target, resolved_types, call_arguments), span, children, output, [], [], type_joins, [], [], type_checks),
      diagnostics,
      deferred
    )
  }
}

pure body_special_core_call(target: BodyTarget): Bool {
  match target {
    BodyDeclaration(binding) => false,
    BodyCore(name) => name == "$unit" || name == "$method_call" || name == "len" || name == "$method_map" ||
      name == "$method_reduce" || name == "$method_put" || name == "$method_get" ||
      name == "$method_has" || name == "$method_add" || name == "map_put" ||
      name == "map_get" || name == "map_has" || name == "has" || name == "set_add" ||
      name == "set_has" || name == "append" || name == "concat" || name == "print" ||
      name == "eprint" || name == "nat_from_str" || name == "nat" || name == "dec" || name == "quotient" || name == "is_digit" || name == "is_letter" ||
      name == "is_whitespace" || name == "starts_with" || name == "starts_with_at" ||
      name == "reverse" || name == "slice" ||
      name == "bytes" || name == "byte_append" || name == "bytes_concat" ||
      name == "byte_len" || name == "byte_get" || name == "utf8_encode" || name == "utf8_decode" ||
      name == "environment_has" || name == "environment_get" ||
      name == "duration_nanoseconds" || name == "duration_ticks" ||
      name == "duration_from_seconds" || name == "instant_now" ||
      name == "instant_add" || name == "instant_difference" || name == "instant_before" ||
      name == "host_arguments_async" || name == "host_stdout_async" ||
    name == "host_stderr_async" || name == "host_exit_async" || name == "run_bytecode_args" || name == "command_args" || name == "process_exit" ||
      name == "process_run" || name == "host_sleep" || name == "host_decode_utf8" ||
      name == "fs_root_identity_async" || name == "fs_metadata" || (name == "fs_read_beneath" || name == "fs_read_beneath_async") || name == "fs_directories_overlap" || name == "fs_read" || name == "fs_write" ||
      name == "fs_list" || name == "fs_create_directory" || name == "fs_remove_file" ||
      name == "fs_remove_directory" || name == "fs_temp_file" || name == "fs_temp_directory" ||
      name == "read_file" || name == "file_exists" || name == "read_bytes" || name == "write_bytes" ||
      name == "async_fake_read" || name == "tcp_exchange" || name == "http_transport_exchange" || name == "tcp_serve" ||
      name == "tcp_service" || name == "tcp_serve_stream" || name == "tcp_server_read_chunk" ||
      body_path_core_call(target)
  }
}

pure body_path_core_call(target: BodyTarget): Bool {
  match target {
    BodyDeclaration(binding) => false,
    BodyCore(name) => name == "path_from_text" || name == "path_from_native" ||
      name == "path_append" || name == "path_to_text" || name == "path_native_bytes" ||
      name == "path_display" || name == "path_absolute" || name == "path_directory" ||
      name == "path_filename" || name == "path_current" || name == "path_join" ||
      name == "path_suffix" || name == "path_parent" || name == "path_is_absolute" ||
      name == "path_with_suffix" || name == "path_resolve"
  }
}

pure body_nat_text(value: Nat): Str {
  "${value}"
}

pure body_call_arity_evidence(
  context: BodyContext,
  kind: Str,
  span: SourceSpan,
  expected_count: Option[Nat],
  actual_count: Nat
): [BodyTypeCheckEvidence] {
  if !context.retain_guard_conversions {
    []
  } else {
    [BodyTypeCheckEvidence(
      kind + " call arity",
      span,
      None(),
      match expected_count {
        Some(expected) => "expected ${expected}; found ${actual_count}",
        None() => "expected count unavailable because the callable type is unresolved; found ${actual_count}"
      },
      None(),
      match expected_count {
        Some(expected) => Some(expected == actual_count),
        None() => None()
      }
    )]
  }
}

pure body_explicit_type_argument_arity_evidence(
  context: BodyContext,
  span: SourceSpan,
  expected_count: Nat,
  actual_count: Nat
): [BodyTypeCheckEvidence] {
  if !context.retain_guard_conversions {
    []
  } else {
    [BodyTypeCheckEvidence(
      "type argument arity",
      span,
      None(),
      "expected ${expected_count}; found ${actual_count}",
      None(),
      Some(expected_count == actual_count)
    )]
  }
}

pure body_retain_rejected_type_argument_arity(
  context: BodyContext,
  checked: BodyResult,
  type_count: Nat,
  span: SourceSpan
): BodyResult {
  if type_count == 0 || !context.retain_guard_conversions {
    checked
  } else {
    body: BoundBody = checked.body
    type_checks: [BodyTypeCheckEvidence] = concat(
      body.type_checks,
      body_explicit_type_argument_arity_evidence(context, span, 0, type_count)
    )
    BodyResult(
      BoundBody(
        body.node,
        body.span,
        body.children,
        body.type,
        body.constraints,
        body.guard_conversions,
        body.type_joins,
        body.callback_contracts,
        body.operator_checks,
        type_checks
      ),
      checked.diagnostics,
      checked.deferred
    )
  }
}

pure body_tcp_limits_type(): SignatureType {
  SignatureType(
    SignatureNominal(DeclarationIdentity(
      ModuleIdentity(ToolchainModulePackage(), "tcp.panack"),
      "TcpServerLimits"
    )),
    []
  )
}

pure body_tcp_bytes_result_type(): SignatureType {
  SignatureType(SignatureCore("Result"), [
    SignatureType(SignatureCore("Bytes"), []),
    SignatureType(SignatureCore("Str"), [])
  ])
}

pure body_tcp_serve_result_type(): SignatureType {
  item: SignatureType = SignatureType(SignatureCore("Result"), [
    SignatureType(SignatureCore("Unit"), []),
    SignatureType(SignatureCore("Str"), [])
  ])
  SignatureType(SignatureCore("Result"), [
    SignatureType(SignatureCore("Array"), [item]),
    SignatureType(SignatureCore("Str"), [])
  ])
}

pure body_tcp_stream_worker_type(context_type: SignatureType): SignatureType {
  SignatureType(SignatureCallable(SignatureAsync()), [
    context_type,
    body_tcp_bytes_result_type()
  ])
}

pure body_tcp_stream_context_type(context: BodyContext, value: BoundBody): SignatureType {
  match value.type {
    None() => SignatureType(SignatureHole(context.owner, [], 0), []),
    Some(type) => type
  }
}

pure body_tcp_service_type(name: Str): SignatureType {
  SignatureType(SignatureNominal(DeclarationIdentity(
    ModuleIdentity(ToolchainModulePackage(), "tcp_service.panack"), name
  )), [])
}

pure body_tcp_expected_argument(
  name: Str,
  index: Nat,
  context_type: SignatureType
): SignatureType {
  if name == "tcp_service" && index == 4 {
    body_tcp_service_type("TcpServiceLimits")
  } else if name == "tcp_service" && index == 5 {
    SignatureType(SignatureCallable(SignatureAsync()), [
      body_tcp_service_type("TcpServiceReady"),
      body_intrinsic_result(SignatureType(SignatureCore("Unit"), []),
        SignatureType(SignatureCore("Str"), []))
    ])
  } else { body_tcp_legacy_expected_argument(name, index, context_type) }
}

pure body_tcp_legacy_expected_argument(
  name: Str,
  index: Nat,
  context_type: SignatureType
): SignatureType {
  if name == "http_transport_exchange" {
    if index == 0 {
      SignatureType(SignatureCore("Str"), [])
    } else {
      if index == 1 {
        SignatureType(SignatureCore("Nat"), [])
      } else {
        if index == 2 {
          SignatureType(SignatureCore("Bool"), [])
        } else {
          if index == 3 {
            SignatureType(SignatureCore("Bytes"), [])
          } else {
            SignatureType(SignatureCore("Nat"), [])
          }
        }
      }
    }
  } else {
  if name == "async_fake_read" {
    SignatureType(SignatureCore("Bool"), [])
  } else {
    if name == "tcp_server_read_chunk" {
      SignatureType(SignatureCore("Nat"), [])
    } else {
      if index == 0 {
        SignatureType(SignatureCore("Str"), [])
      } else {
        if name == "tcp_exchange" && index == 2 {
          SignatureType(SignatureCore("Bytes"), [])
        } else {
          if (name == "tcp_serve_stream" || name == "tcp_service") && index == 2 {
            body_tcp_stream_worker_type(context_type)
          } else {
            if (name == "tcp_serve_stream" || name == "tcp_service") && index == 3 {
              context_type
            } else {
              if name == "tcp_serve" && index == 2 {
                SignatureType(SignatureCallable(SignatureAsync()), [
                  SignatureType(SignatureCore("Bytes"), []),
                  body_tcp_bytes_result_type()
                ])
              } else {
                if (name == "tcp_serve" && index == 3) ||
                  ((name == "tcp_serve_stream" || name == "tcp_service") && index == 4) {
                  body_tcp_limits_type()
                } else {
                  SignatureType(SignatureCore("Nat"), [])
                }
              }
            }
          }
        }
      }
    }
  }}
}

pure body_check_tcp_core_call(
  context: BodyContext,
  name: Str,
  children: [BoundBody],
  span: SourceSpan,
  initial_diagnostics: [Diagnostic],
  initial_deferred: [SourceSpan]
): BodyResult {
  expected_count: Nat = if name == "tcp_service" { 6 } else { if name == "tcp_serve" { 4 } else {
    if name == "tcp_serve_stream" { 5 } else {
      if name == "http_transport_exchange" { 6 } else {
        if name == "tcp_exchange" { 5 } else { 1 }
      }
    }
  }
  }
  mut diagnostics: [Diagnostic] = initial_diagnostics
  mut deferred: [SourceSpan] = initial_deferred
  mut output: Option[SignatureType] = None()
  mut type_checks: [BodyTypeCheckEvidence] = []

  if len(children) != expected_count {
    diagnostics = append(
      diagnostics,
      Diagnostic(name + " expects ${expected_count} arguments, got " + body_nat_text(len(children)), span.start)
    )
  } else {
    mut index: Nat = 0
    while index < expected_count {
      context_type: SignatureType = if name == "tcp_serve_stream" || name == "tcp_service" {
        body_tcp_stream_context_type(context, children[3])
      } else {
        SignatureType(SignatureCore("Void"), [])
      }
      expected: SignatureType = body_tcp_expected_argument(name, index, context_type)
      number: Nat = index + 1
      required: BodyResult = body_require_value(
        context,
        children[index],
        expected,
        "argument ${number} to " + name
      )
      diagnostics = concat(diagnostics, required.diagnostics)
      deferred = concat(deferred, required.deferred)
      if context.retain_guard_conversions {
        accepted: Option[Bool] = if len(required.diagnostics) > 0 {
          Some(false)
        } else {
          if len(required.deferred) > 0 { None() } else { Some(true) }
        }
        type_checks = append(type_checks, BodyTypeCheckEvidence(
          "argument ${number} to " + name,
          children[index].span,
          children[index].type,
          body_type_text(expected),
          None(),
          accepted
        ))
      }
      index = index + 1
    }
    if len(diagnostics) == 0 && len(deferred) == 0 {
      output = if name == "tcp_service" {
        Some(body_intrinsic_result(body_tcp_service_type("TcpServiceSummary"),
          SignatureType(SignatureCore("Str"), [])))
      } else if name == "tcp_serve" || name == "tcp_serve_stream" {
        Some(body_tcp_serve_result_type())
      } else {
        Some(body_tcp_bytes_result_type())
      }
    }
  }
  BodyResult(BoundBody(
    BodyCall(BodyCore(name), [], []), span, children, output, [], [], [], [], [],
    concat(
      type_checks,
      body_call_arity_evidence(context, "core", span, Some(expected_count), len(children))
    )
  ), diagnostics, deferred)
}

pure body_check_existing_special_core_call(
  context: BodyContext,
  target: BodyTarget,
  children: [BoundBody],
  types: [SignatureType],
  type_argument_span: SourceSpan,
  span: SourceSpan,
  initial_diagnostics: [Diagnostic],
  initial_deferred: [SourceSpan]
): BodyResult {
  mut diagnostics: [Diagnostic] = initial_diagnostics
  mut deferred: [SourceSpan] = initial_deferred
  mut output: Option[SignatureType] = None()
  mut call_arguments: [CallArgumentEvidence] = []
  mut callback_contracts: [CollectionCallbackEvidence] = []
  mut type_joins: [TypeJoinEvidence] = []
  mut type_checks: [BodyTypeCheckEvidence] = []
  name: Str = match target {
    BodyCore(value) => value,
    BodyDeclaration(binding) => ""
  }

  if name != "$method_call" && len(types) > 0 {
    diagnostics = append(
      diagnostics,
      Diagnostic("explicit type arguments require a generic function", type_argument_span.start)
    )
  }
  if name == "$method_call" && len(types) > 0 {
    diagnostics = append(
      diagnostics,
      Diagnostic("explicit type arguments require a generic function", type_argument_span.start)
    )
  }
  if body_path_core_call(target) {
    checked: BodyResult = body_check_path_core_call(context, name, children, span)
    diagnostics = concat(diagnostics, checked.diagnostics)
    deferred = concat(deferred, checked.deferred)
    output = checked.body.type;
    call_arguments = body_direct_call_argument_metadata(checked.body)
    type_checks = checked.body.type_checks
  } else {
  if name == "$unit" {
    if len(children) != 0 {
      diagnostics = append(diagnostics, Diagnostic("Unit expects 0 arguments, got ${len(children)}", span.start))
    } else {
      output = body_core_type("Unit")
    }
  } else {
  if name == "$method_call" && len(children) == 0 {
    diagnostics = append(diagnostics, Diagnostic("call requires a callable", span.start))
  } else {
    if name == "$method_call" {
    if context.retain_guard_conversions {
      target_accepted: Option[Bool] = match children[0].type {
        None() => None(),
        Some(callable) => match callable.identity {
          SignatureCallable(effect) => Some(true),
          SignatureHole(owner, path, index) => None(),
          SignatureParameter(owner, index) => None(),
          SignatureCore(core_name) => Some(false),
          SignatureNominal(identity) => Some(false)
        }
      }
      type_checks = append(type_checks, BodyTypeCheckEvidence(
        "indirect call target",
        children[0].span,
        children[0].type,
        "callable type",
        None(),
        target_accepted
      ))
    }
    match children[0].type {
      None() => {
        deferred = append(deferred, span)
      },
      Some(callable) => match callable.identity {
        SignatureCallable(effect) => {
          expected_count: Nat = prior_index(len(callable.arguments))
          actual_count: Nat = prior_index(len(children))
          if expected_count != actual_count {
            diagnostics = append(
              diagnostics,
              Diagnostic("call expects ${expected_count} arguments, got ${actual_count}", span.start)
            )
          }
          mut index: Nat = 0
          while index < expected_count && index < actual_count {
            number: Nat = index + 1
            required: BodyResult = body_require_value(
              context,
              children[index + 1],
              callable.arguments[index],
              "argument ${number} to call"
            )
            diagnostics = concat(diagnostics, required.diagnostics)
            deferred = concat(deferred, required.deferred)
            if context.retain_guard_conversions {
              accepted: Option[Bool] = if len(required.diagnostics) > 0 {
                Some(false)
              } else {
                if len(required.deferred) > 0 { None() } else { Some(true) }
              }
              call_arguments = append(call_arguments, CallArgumentEvidence(
                "indirect call argument ${number}",
                children[index + 1].span,
                children[index + 1].type,
                callable.arguments[index],
                accepted
              ))
            }
            index = index + 1
          }
          output = Some(callable.arguments[expected_count])
        },
        SignatureHole(owner, path, index) => {
          deferred = append(deferred, span)
        },
        SignatureParameter(owner, index) => {
          deferred = append(deferred, span)
        },
        SignatureCore(core_name) => {
          diagnostics = append(
            diagnostics,
            Diagnostic("call expects a callable, got " + body_type_text(callable), span.start)
          )
        },
        SignatureNominal(identity) => {
          diagnostics = append(
            diagnostics,
            Diagnostic("call expects a callable, got " + body_type_text(callable), span.start)
          )
        }
      }
    }
    } else {
      if name == "print" || name == "eprint" {
        if len(children) != 1 {
          diagnostics = append(diagnostics, Diagnostic(name + " expects 1 arguments, got " + body_nat_text(len(children)), span.start))
        } else {
          match children[0].type {
            None() => {
              deferred = append(deferred, span)
              if context.retain_guard_conversions {
                type_checks = append(type_checks, BodyTypeCheckEvidence(
                  name + " argument",
                  children[0].span,
                  None(),
                  "any non-Void value",
                  None(),
                  None()
                ))
              }
            },
            Some(type) => {
              valid: Bool = type != SignatureType(SignatureCore("Void"), [])
              if context.retain_guard_conversions {
                type_checks = append(type_checks, BodyTypeCheckEvidence(
                  name + " argument",
                  children[0].span,
                  Some(type),
                  "any non-Void value",
                  None(),
                  Some(valid)
                ))
              }
              if !valid {
                diagnostics = append(diagnostics, Diagnostic("Void is not a value and cannot be printed", span.start))
              } else {
                output = body_core_type("Void")
              }
            }
          }
        }
      } else {
      if name == "len" {
        if len(children) != 1 {
          diagnostics = append(diagnostics, Diagnostic("len expects 1 arguments, got ${len(children)}", span.start))
        } else {
          match children[0].type {
            None() => {
              deferred = append(deferred, span)
              if context.retain_guard_conversions {
                type_checks = append(type_checks, BodyTypeCheckEvidence(
                  "len argument",
                  children[0].span,
                  None(),
                  "Str, Bytes, or array",
                  None(),
                  None()
                ))
              }
            },
            Some(type) => {
              valid: Bool = type.identity == SignatureCore("Str") ||
                type.identity == SignatureCore("Bytes") || type.identity == SignatureCore("Array")
              if context.retain_guard_conversions {
                type_checks = append(type_checks, BodyTypeCheckEvidence(
                  "len argument",
                  children[0].span,
                  Some(type),
                  "Str, Bytes, or array",
                  None(),
                  Some(valid)
                ))
              }
              if valid {
                output = body_core_type("Nat")
              } else {
                diagnostics = append(diagnostics, Diagnostic("len expects Str, Bytes, or array, got " + body_type_text(type), span.start))
              }
            }
          }
        }
      } else {
        if name == "is_digit" || name == "is_letter" || name == "is_whitespace" ||
          name == "starts_with" || name == "starts_with_at" || name == "reverse" || name == "slice" {
          checked: BodyResult = body_check_text_core_call(
            context,
            name,
            children,
            span,
            diagnostics,
            deferred
          )
          diagnostics = checked.diagnostics
          deferred = checked.deferred
          output = checked.body.type;
          call_arguments = body_direct_call_argument_metadata(checked.body)
          type_checks = checked.body.type_checks
        } else {
          if name == "bytes" || name == "byte_append" || name == "bytes_concat" ||
            name == "byte_len" || name == "byte_get" || name == "utf8_encode" || name == "utf8_decode" {
            checked: BodyResult = body_check_bytes_core_call(context, name, children, span)
            diagnostics = checked.diagnostics
            deferred = checked.deferred
            output = checked.body.type;
            call_arguments = body_direct_call_argument_metadata(checked.body)
            type_checks = checked.body.type_checks
          } else {
          if name == "nat_from_str" {
            if len(children) != 1 {
              diagnostics = append(diagnostics, Diagnostic("nat_from_str expects 1 arguments, got " + body_nat_text(len(children)), span.start))
            } else {
              required: BodyResult = body_require_value(
                context,
                children[0],
                SignatureType(SignatureCore("Str"), []),
                "argument 1 to nat_from_str"
              )
              diagnostics = concat(diagnostics, required.diagnostics)
              deferred = concat(deferred, required.deferred)
              if context.retain_guard_conversions {
                accepted: Option[Bool] = if len(required.diagnostics) > 0 {
                  Some(false)
                } else {
                  if len(required.deferred) > 0 { None() } else { Some(true) }
                }
                call_arguments = append(call_arguments, CallArgumentEvidence(
                  "call argument 1 to nat_from_str",
                  children[0].span,
                  children[0].type,
                  SignatureType(SignatureCore("Str"), []),
                  accepted
                ))
              }
              if len(diagnostics) == 0 && len(deferred) == 0 {
                output = body_core_type("Nat")
              }
            }
          } else {
            if name == "quotient" {
              if len(children) != 2 {
                diagnostics = append(diagnostics, Diagnostic("quotient expects 2 arguments, got " + body_nat_text(len(children)), span.start))
              } else {
                left: BodyResult = body_require_value(context, children[0], SignatureType(SignatureCore("Nat"), []), "argument 1 to quotient")
                right: BodyResult = body_require_value(context, children[1], SignatureType(SignatureCore("Nat"), []), "argument 2 to quotient")
                diagnostics = concat(diagnostics, concat(left.diagnostics, right.diagnostics))
                deferred = concat(deferred, concat(left.deferred, right.deferred))
                if context.retain_guard_conversions {
                  left_accepted: Option[Bool] = if len(left.diagnostics) > 0 {
                    Some(false)
                  } else {
                    if len(left.deferred) > 0 { None() } else { Some(true) }
                  }
                  right_accepted: Option[Bool] = if len(right.diagnostics) > 0 {
                    Some(false)
                  } else {
                    if len(right.deferred) > 0 { None() } else { Some(true) }
                  }
                  call_arguments = append(call_arguments, CallArgumentEvidence(
                    "call argument 1 to quotient",
                    children[0].span,
                    children[0].type,
                    SignatureType(SignatureCore("Nat"), []),
                    left_accepted
                  ))
                  call_arguments = append(call_arguments, CallArgumentEvidence(
                    "call argument 2 to quotient",
                    children[1].span,
                    children[1].type,
                    SignatureType(SignatureCore("Nat"), []),
                    right_accepted
                  ))
                }
                if len(diagnostics) == 0 && len(deferred) == 0 {
                  output = body_core_type("Nat")
                }
              }
            } else {
              checked: BodyResult = body_check_collection_core_call(
                context,
                name,
                children,
                span,
                diagnostics,
                deferred
              )
              diagnostics = checked.diagnostics
              deferred = checked.deferred
              output = checked.body.type;
              call_arguments = body_direct_call_argument_metadata(checked.body)
              callback_contracts = checked.body.callback_contracts
              type_joins = checked.body.type_joins
              type_checks = checked.body.type_checks
            }
          }
        }
      }
      }
    }
  }
  }
  }
  }
  if name == "$method_call" {
    if len(children) > 0 {
      match children[0].type {
        None() => {
          type_checks = concat(
            type_checks,
            body_call_arity_evidence(context, "indirect", span, None(), prior_index(len(children)))
          )
        },
        Some(callable) => match callable.identity {
          SignatureCallable(effect) => {
            type_checks = concat(type_checks, body_call_arity_evidence(
              context,
              "indirect",
              span,
              Some(prior_index(len(callable.arguments))),
              prior_index(len(children))
            ))
          },
          SignatureHole(owner, path, index) => {
            type_checks = concat(
              type_checks,
              body_call_arity_evidence(context, "indirect", span, None(), prior_index(len(children)))
            )
          },
          SignatureParameter(owner, index) => {
            type_checks = concat(
              type_checks,
              body_call_arity_evidence(context, "indirect", span, None(), prior_index(len(children)))
            )
          },
          SignatureCore(core_name) => {},
          SignatureNominal(identity) => {}
        }
      }
    }
  } else {
    if name == "$unit" {
      type_checks = body_call_arity_evidence(context, "core", span, Some(0), len(children))
    } else {
      if name == "len" {
        type_checks = concat(
          type_checks,
          body_call_arity_evidence(context, "core", span, Some(1), len(children))
        )
      } else {
      if name == "print" || name == "eprint" {
        type_checks = concat(
          type_checks,
          body_call_arity_evidence(context, "core", span, Some(1), len(children))
        )
      } else {
        if name == "nat_from_str" {
          type_checks = body_call_arity_evidence(context, "core", span, Some(1), len(children))
        } else {
          if name == "quotient" {
            type_checks = body_call_arity_evidence(context, "core", span, Some(2), len(children))
          }
        }
      }
      }
    }
  }
  BodyResult(
    BoundBody(
      BodyCall(target, types, call_arguments),
      span,
      children,
      output,
      body_collection_call_solutions(name, children),
      [],
      type_joins,
      callback_contracts,
      [], type_checks
    ),
    diagnostics,
    deferred
  )
}

pure body_check_rational_conversion(
  context: BodyContext,
  name: Str,
  children: [BoundBody],
  span: SourceSpan,
  initial_diagnostics: [Diagnostic],
  initial_deferred: [SourceSpan]
): BodyResult {
  mut diagnostics: [Diagnostic] = initial_diagnostics
  mut deferred: [SourceSpan] = initial_deferred
  mut output: Option[SignatureType] = None()
  mut call_arguments: [CallArgumentEvidence] = []

  if len(children) != 1 {
    diagnostics = append(
      diagnostics,
      Diagnostic(name + " expects 1 arguments, got " + body_nat_text(len(children)), span.start)
    )
  } else {
    required: BodyResult = body_require_value(
      context,
      children[0],
      SignatureType(SignatureCore("Rat"), []),
      "argument 1 to " + name
    )
    diagnostics = concat(diagnostics, required.diagnostics)
    deferred = concat(deferred, required.deferred)
    if context.retain_guard_conversions {
      accepted: Option[Bool] = if len(required.diagnostics) > 0 {
        Some(false)
      } else {
        if len(required.deferred) > 0 { None() } else { Some(true) }
      }
      call_arguments = append(call_arguments, CallArgumentEvidence(
        "call argument 1 to " + name,
        children[0].span,
        children[0].type,
        SignatureType(SignatureCore("Rat"), []),
        accepted
      ))
    }
    if len(diagnostics) == 0 && len(deferred) == 0 {
      output = body_core_type(if name == "nat" { "Nat" } else { "Dec" })
    }
  }
  BodyResult(BoundBody(
    BodyCall(BodyCore(name), [], call_arguments), span, children, output, [], [], [], [], [],
    body_call_arity_evidence(context, "core", span, Some(1), len(children))
  ), diagnostics, deferred)
}

pure body_check_environment_core_call(
  context: BodyContext,
  name: Str,
  children: [BoundBody],
  span: SourceSpan,
  initial_diagnostics: [Diagnostic],
  initial_deferred: [SourceSpan]
): BodyResult {
  mut diagnostics: [Diagnostic] = initial_diagnostics
  mut deferred: [SourceSpan] = initial_deferred
  mut output: Option[SignatureType] = None()
  mut call_arguments: [CallArgumentEvidence] = []
  if len(children) != 1 {
    diagnostics = append(
      diagnostics,
      Diagnostic(name + " expects 1 arguments, got " + body_nat_text(len(children)), span.start)
    )
  } else {
    required: BodyResult = body_require_value(
      context,
      children[0],
      SignatureType(SignatureCore("Str"), []),
      "argument 1 to " + name
    )
    diagnostics = concat(diagnostics, required.diagnostics)
    deferred = concat(deferred, required.deferred)
    if context.retain_guard_conversions {
      accepted: Option[Bool] = if len(required.diagnostics) > 0 {
        Some(false)
      } else {
        if len(required.deferred) > 0 { None() } else { Some(true) }
      }
      call_arguments = append(call_arguments, CallArgumentEvidence(
        "call argument 1 to " + name,
        children[0].span,
        children[0].type,
        SignatureType(SignatureCore("Str"), []),
        accepted
      ))
    }
    if len(diagnostics) == 0 && len(deferred) == 0 {
      output = body_core_type(if name == "environment_has" { "Bool" } else { "Str" })
    }
  }
  BodyResult(BoundBody(
    BodyCall(BodyCore(name), [], call_arguments), span, children, output, [], [], [], [], [],
    body_call_arity_evidence(context, "core", span, Some(1), len(children))
  ), diagnostics, deferred)
}

pure body_check_time_core_call(
  context: BodyContext,
  name: Str,
  children: [BoundBody],
  span: SourceSpan,
  initial_diagnostics: [Diagnostic],
  initial_deferred: [SourceSpan]
): BodyResult {
  mut diagnostics: [Diagnostic] = initial_diagnostics
  mut deferred: [SourceSpan] = initial_deferred
  mut output: Option[SignatureType] = None()
  mut inputs: [SignatureType] = []
  mut call_arguments: [CallArgumentEvidence] = []
  duration: SignatureType = SignatureType(SignatureCore("Duration"), [])
  instant: SignatureType = SignatureType(SignatureCore("Instant"), [])
  if name == "duration_nanoseconds" {
    inputs = [SignatureType(SignatureCore("Int"), [])]
    output = Some(duration)
  } else {
    if name == "duration_ticks" {
      inputs = [duration]
      output = body_core_type("Int")
    } else {
      if name == "duration_from_seconds" {
        inputs = [SignatureType(SignatureCore("Rat"), [])]
        output = Some(SignatureType(SignatureCore("Result"), [
          duration,
          body_intrinsic_type(context, "DurationError")
        ]))
      } else {
        if name == "instant_now" {
          output = Some(SignatureType(SignatureCore("Result"), [
            instant,
            body_intrinsic_type(context, "ClockError")
          ]))
        } else {
          if name == "instant_add" {
            inputs = [instant, duration]
            output = Some(instant)
          } else {
            if name == "instant_difference" {
              inputs = [instant, instant]
              output = Some(duration)
            } else {
              if name == "instant_before" {
                inputs = [instant, instant]
                output = body_core_type("Bool")
              } else {}
            }
          }
        }
      }
    }
  }
  if len(children) != len(inputs) {
    diagnostics = append(
      diagnostics,
      Diagnostic(name + " expects " + body_nat_text(len(inputs)) + " arguments, got " + body_nat_text(len(children)), span.start)
    )
  } else {
    mut index: Nat = 0
    for child in children {
      number: Nat = index + 1
      required: BodyResult = body_require_value(
        context,
        child,
        inputs[index],
        "argument ${number} to " + name
      )
      diagnostics = concat(diagnostics, required.diagnostics)
      deferred = concat(deferred, required.deferred)
      if context.retain_guard_conversions {
        accepted: Option[Bool] = if len(required.diagnostics) > 0 {
          Some(false)
        } else {
          if len(required.deferred) > 0 { None() } else { Some(true) }
        }
        call_arguments = append(call_arguments, CallArgumentEvidence(
          "call argument ${number} to " + name,
          child.span,
          child.type,
          inputs[index],
          accepted
        ))
      }
      index = index + 1
    }
  }
  if len(diagnostics) > 0 || len(deferred) > 0 {
    output = None()
  }
  BodyResult(BoundBody(
    BodyCall(BodyCore(name), [], call_arguments), span, children, output, [], [], [], [], [],
    body_call_arity_evidence(context, "core", span, Some(len(inputs)), len(children))
  ), diagnostics, deferred)
}

pure body_intrinsic_type(context: BodyContext, name: Str): SignatureType {
  if name == "Path" || name == "Duration" || name == "Instant" || name == "Unit" ||
    name == "Bool" || name == "Bytes" || name == "Int" || name == "Nat" ||
    name == "Rat" || name == "Str" || name == "Void" {
    SignatureType(SignatureCore(name), [])
  } else {
    mut module_path: Str = ""
    if name == "PathError" {
      module_path = "path.panack"
    } else {
      if name == "DurationError" || name == "ClockError" {
        module_path = "time.panack"
      } else {
        if name == "HostError" {
          module_path = "host.panack"
        } else {
          if name == "ProcessOutput" {
            module_path = "process.panack"
          } else {
            if name == "FileMetadata" || name == "FileKind" {
              module_path = "filesystem.panack"
            } else {
              if name == "TcpServerLimits" {
                module_path = "tcp.panack"
              } else {}
            }
          }
        }
      }
    }
    if module_path != "" {
      SignatureType(SignatureNominal(DeclarationIdentity(
        ModuleIdentity(ToolchainModulePackage(), module_path),
        name
      )), [])
    } else {
      match resolve_module_type(context.graph, context.owner.module, name) {
        Ok(binding) => SignatureType(SignatureNominal(binding.identity), []),
        Error(message) => SignatureType(SignatureCore(name), [])
      }
    }
  }
}

pure body_intrinsic_array(element: SignatureType): SignatureType {
  SignatureType(SignatureCore("Array"), [element])
}

pure body_intrinsic_result(value: SignatureType, error: SignatureType): SignatureType {
  SignatureType(SignatureCore("Result"), [value, error])
}

pure body_check_typed_intrinsic(
  context: BodyContext,
  name: Str,
  children: [BoundBody],
  span: SourceSpan,
  inputs: [SignatureType],
  result: SignatureType
): BodyResult {
  mut diagnostics: [Diagnostic] = []
  mut deferred: [SourceSpan] = []
  mut output: Option[SignatureType] = None()
  mut call_arguments: [CallArgumentEvidence] = []
  if len(children) != len(inputs) {
    diagnostics = append(
      diagnostics,
      Diagnostic(name + " expects " + body_nat_text(len(inputs)) + " arguments, got " + body_nat_text(len(children)), span.start)
    )
  } else {
    mut index: Nat = 0
    for child in children {
      number: Nat = index + 1
      required: BodyResult = body_require_value(
        context,
        child,
        inputs[index],
        "argument ${number} to " + name
      )
      diagnostics = concat(diagnostics, required.diagnostics)
      deferred = concat(deferred, required.deferred)
      if context.retain_guard_conversions && (
        name == "fs_read" || (name == "fs_read_beneath" || name == "fs_read_beneath_async") || name == "fs_write" || name == "fs_root_identity_async" || name == "fs_metadata" || name == "fs_list" ||
        name == "fs_directories_overlap" || name == "fs_create_directory" || name == "fs_remove_file" ||
        name == "fs_remove_directory" || name == "fs_temp_file" || name == "fs_temp_directory"
      ) {
        accepted: Option[Bool] = if len(required.diagnostics) > 0 {
          Some(false)
        } else {
          if len(required.deferred) > 0 { None() } else { Some(true) }
        }
        call_arguments = append(call_arguments, CallArgumentEvidence(
          "call argument ${number} to " + name,
          child.span,
          child.type,
          inputs[index],
          accepted
        ))
      }
      index = index + 1
    }
  }
  if len(diagnostics) == 0 && len(deferred) == 0 {
    output = Some(result)
  }
  BodyResult(BoundBody(
    BodyCall(BodyCore(name), [], call_arguments), span, children, output, [], [], [], [], [],
    body_call_arity_evidence(context, "core", span, Some(len(inputs)), len(children))
  ), diagnostics, deferred)
}

pure body_check_host_filesystem_core_call(
  context: BodyContext,
  name: Str,
  children: [BoundBody],
  span: SourceSpan
): BodyResult {
  if name == "host_stdout_async" || name == "host_stderr_async" {
    body_check_typed_intrinsic(context, name, children, span,
      [body_intrinsic_type(context, "Str")],
      body_intrinsic_result(body_intrinsic_type(context, "Unit"),
        body_intrinsic_type(context, "HostError")))
  } else { body_check_legacy_host_filesystem_core_call(context, name, children, span) }
}

pure body_check_legacy_host_filesystem_core_call(
  context: BodyContext,
  name: Str,
  children: [BoundBody],
  span: SourceSpan
): BodyResult {
  path: SignatureType = body_intrinsic_type(context, "Path")
  duration: SignatureType = body_intrinsic_type(context, "Duration")
  bytes: SignatureType = body_intrinsic_type(context, "Bytes")
  strings: SignatureType = body_intrinsic_array(body_intrinsic_type(context, "Str"))
  natural: SignatureType = body_intrinsic_type(context, "Nat")
  unit: SignatureType = body_intrinsic_type(context, "Unit")
  host_error: SignatureType = body_intrinsic_type(context, "HostError")
  mut inputs: [SignatureType] = []
  mut result: SignatureType = body_intrinsic_type(context, "Void")
  if name == "run_bytecode_args" {
    inputs = [bytes, strings]
  } else {
    if name == "command_args" || name == "host_arguments_async" {
      result = strings
    } else {
      if name == "process_exit" || name == "host_exit_async" {
        inputs = [natural]
        if name == "host_exit_async" { result = unit }
      } else {
        if name == "process_run" {
          inputs = [path, strings, bytes, path, strings, duration, natural]
          result = body_intrinsic_result(body_intrinsic_type(context, "ProcessOutput"), host_error)
        } else {
          if name == "host_sleep" {
            inputs = [duration]
            result = body_intrinsic_result(unit, host_error)
          } else {
            if name == "fs_directories_overlap" || name == "host_decode_utf8" {
              if name == "fs_directories_overlap" {
                inputs = [path, path]
                result = body_intrinsic_result(body_intrinsic_type(context, "Bool"), host_error)
              } else {
                inputs = [bytes]
                result = body_intrinsic_result(body_intrinsic_type(context, "Str"), host_error)
              }
            } else {
              if name == "fs_metadata" || name == "fs_root_identity_async" {
                inputs = [path]
                result = body_intrinsic_result(body_intrinsic_type(context,
                  if name == "fs_root_identity_async" { "FilesystemRootIdentity" } else { "FileMetadata" }), host_error)
              } else {
                if (name == "fs_read_beneath" || name == "fs_read_beneath_async") || name == "fs_read" {
                  if (name == "fs_read_beneath" || name == "fs_read_beneath_async") {
                    inputs = [path, path, natural]
                    result = body_intrinsic_result(body_intrinsic_type(context, "FilesystemRootRead"), host_error)
                  } else {
                    inputs = [path, natural]
                    result = body_intrinsic_result(bytes, host_error)
                  }
                } else {
                  if name == "fs_write" {
                    inputs = [path, bytes]
                    result = body_intrinsic_result(unit, host_error)
                  } else {
                    if name == "fs_list" {
                      inputs = [path]
                      result = body_intrinsic_result(body_intrinsic_array(path), host_error)
                    } else {
                      if name == "fs_create_directory" || name == "fs_remove_file" ||
                        name == "fs_remove_directory" {
                        inputs = [path]
                        result = body_intrinsic_result(unit, host_error)
                      } else {
                        if name == "fs_temp_file" || name == "fs_temp_directory" {
                          inputs = [path]
                          result = body_intrinsic_result(path, host_error)
                        } else {
                          if name == "read_file" {
                            inputs = [body_intrinsic_type(context, "Str")]
                            result = body_intrinsic_type(context, "Str")
                          } else {
                            if name == "file_exists" {
                              inputs = [body_intrinsic_type(context, "Str")]
                              result = body_intrinsic_type(context, "Bool")
                            } else {
                              if name == "read_bytes" {
                                inputs = [body_intrinsic_type(context, "Str")]
                                result = bytes
                              } else {
                                if name == "write_bytes" {
                                  inputs = [body_intrinsic_type(context, "Str"), bytes]
                                } else {}
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
  body_check_typed_intrinsic(context, name, children, span, inputs, result)
}

pure body_check_special_core_call(
  context: BodyContext,
  target: BodyTarget,
  children: [BoundBody],
  types: [SignatureType],
  type_argument_span: SourceSpan,
  span: SourceSpan,
  initial_diagnostics: [Diagnostic],
  initial_deferred: [SourceSpan]
): BodyResult {
  name: Str = match target {
    BodyCore(value) => value,
    BodyDeclaration(binding) => ""
  }
  if name == "environment_has" || name == "environment_get" {
    if len(types) > 0 {
      body_failure("explicit type arguments require a generic function", type_argument_span)
    } else {
      body_check_environment_core_call(
        context,
        name,
        children,
        span,
        initial_diagnostics,
        initial_deferred
      )
    }
  } else {
  if name == "host_arguments_async" || name == "host_stdout_async" ||
    name == "host_stderr_async" || name == "host_exit_async" || name == "run_bytecode_args" || name == "command_args" || name == "process_exit" ||
    name == "process_run" || name == "host_sleep" || name == "host_decode_utf8" ||
    name == "fs_root_identity_async" || name == "fs_metadata" || (name == "fs_read_beneath" || name == "fs_read_beneath_async") || name == "fs_directories_overlap" || name == "fs_read" || name == "fs_write" ||
    name == "fs_list" || name == "fs_create_directory" || name == "fs_remove_file" ||
    name == "fs_remove_directory" || name == "fs_temp_file" || name == "fs_temp_directory" ||
    name == "read_file" || name == "file_exists" || name == "read_bytes" || name == "write_bytes" {
    if len(types) > 0 {
      body_failure("explicit type arguments require a generic function", type_argument_span)
    } else {
      body_check_host_filesystem_core_call(context, name, children, span)
    }
  } else {
  if name == "duration_nanoseconds" || name == "duration_ticks" ||
    name == "duration_from_seconds" || name == "instant_now" ||
    name == "instant_add" || name == "instant_difference" || name == "instant_before" {
    if len(types) > 0 {
      body_failure("explicit type arguments require a generic function", type_argument_span)
    } else {
      body_check_time_core_call(
        context,
        name,
        children,
        span,
        initial_diagnostics,
        initial_deferred
      )
    }
  } else {
  if name == "nat" || name == "dec" {
    if len(types) > 0 {
      body_failure("explicit type arguments require a generic function", type_argument_span)
    } else {
      body_check_rational_conversion(
        context,
        name,
        children,
        span,
        initial_diagnostics,
        initial_deferred
      )
    }
  } else {
  if name == "async_fake_read" || name == "tcp_exchange" || name == "http_transport_exchange" || name == "tcp_serve" ||
    name == "tcp_service" || name == "tcp_serve_stream" || name == "tcp_server_read_chunk" {
    if len(types) > 0 {
      body_failure("explicit type arguments require a generic function", type_argument_span)
    } else {
      body_check_tcp_core_call(context, name, children, span, initial_diagnostics, initial_deferred)
    }
  } else {
    body_check_existing_special_core_call(
      context,
      target,
      children,
      types,
      type_argument_span,
      span,
      initial_diagnostics,
      initial_deferred
    )
  }
  }
  }
  }
  }
}

pure body_check_text_core_call(
  context: BodyContext,
  name: Str,
  children: [BoundBody],
  span: SourceSpan,
  initial_diagnostics: [Diagnostic],
  initial_deferred: [SourceSpan]
): BodyResult {
  expected_count: Nat = if name == "starts_with_at" || name == "slice" { 3 } else { if name == "starts_with" { 2 } else { 1 } }
  mut diagnostics: [Diagnostic] = initial_diagnostics
  mut deferred: [SourceSpan] = initial_deferred
  mut output: Option[SignatureType] = None()
  mut call_arguments: [CallArgumentEvidence] = []
  mut index: Nat = 0

  if len(children) != expected_count {
    diagnostics = append(
      diagnostics,
      Diagnostic(name + " expects ${expected_count} arguments, got " + body_nat_text(len(children)), span.start)
    )
  } else {
    while index < expected_count {
      expected: SignatureType = if name == "starts_with_at" && index == 2 {
        SignatureType(SignatureCore("Nat"), [])
      } else {
        if name == "slice" && index > 0 {
          SignatureType(SignatureCore("Nat"), [])
        } else {
          SignatureType(SignatureCore("Str"), [])
        }
      }
      number: Nat = index + 1
      required: BodyResult = body_require_value(
        context,
        children[index],
        expected,
        "argument ${number} to " + name
      )
      diagnostics = concat(diagnostics, required.diagnostics)
      deferred = concat(deferred, required.deferred)
      if context.retain_guard_conversions {
        accepted: Option[Bool] = if len(required.diagnostics) > 0 {
          Some(false)
        } else {
          if len(required.deferred) > 0 { None() } else { Some(true) }
        }
        call_arguments = append(call_arguments, CallArgumentEvidence(
          "call argument ${number} to " + name,
          children[index].span,
          children[index].type,
          expected,
          accepted
        ))
      }
      index = index + 1
    }
    if len(diagnostics) == 0 && len(deferred) == 0 {
      output = if name == "slice" || name == "reverse" { body_core_type("Str") } else { body_core_type("Bool") }
    }
  }
  BodyResult(BoundBody(
    BodyCall(BodyCore(name), [], call_arguments), span, children, output, [], [], [], [], [],
    body_call_arity_evidence(context, "core", span, Some(expected_count), len(children))
  ), diagnostics, deferred)
}

pure body_check_bytes_core_call(
  context: BodyContext,
  name: Str,
  children: [BoundBody],
  span: SourceSpan
): BodyResult {
  expected_count: Nat = if name == "bytes" { 0 } else {
    if name == "byte_append" || name == "bytes_concat" || name == "byte_get" { 2 } else { 1 }
  }
  mut diagnostics: [Diagnostic] = []
  mut deferred: [SourceSpan] = []
  mut output: Option[SignatureType] = None()
  mut call_arguments: [CallArgumentEvidence] = []

  if len(children) != expected_count {
    diagnostics = append(
      diagnostics,
      Diagnostic(name + " expects ${expected_count} arguments, got " + body_nat_text(len(children)), span.start)
    )
  } else {
    mut index: Nat = 0
    while index < expected_count {
      number: Nat = index + 1
      expected: SignatureType = if name == "utf8_encode" {
        SignatureType(SignatureCore("Str"), [])
      } else {
        if (name == "byte_append" || name == "byte_get") && index == 1 {
          SignatureType(SignatureCore("Nat"), [])
        } else {
          SignatureType(SignatureCore("Bytes"), [])
        }
      }
      required: BodyResult = body_require_value(
        context,
        children[index],
        expected,
        "argument ${number} to " + name
      )
      diagnostics = concat(diagnostics, required.diagnostics)
      deferred = concat(deferred, required.deferred)
      if context.retain_guard_conversions {
        accepted: Option[Bool] = if len(required.diagnostics) > 0 {
          Some(false)
        } else {
          if len(required.deferred) > 0 { None() } else { Some(true) }
        }
        call_arguments = append(call_arguments, CallArgumentEvidence(
          "call argument ${number} to " + name,
          children[index].span,
          children[index].type,
          expected,
          accepted
        ))
      }
      index = index + 1
    }
    if len(diagnostics) == 0 && len(deferred) == 0 {
      output = if name == "byte_len" || name == "byte_get" {
        body_core_type("Nat")
      } else {
        if name == "utf8_decode" {
          body_core_type("Str")
        } else {
          body_core_type("Bytes")
        }
      }
    }
  }
  BodyResult(BoundBody(
    BodyCall(BodyCore(name), [], call_arguments), span, children, output, [], [], [], [], [],
    body_call_arity_evidence(context, "core", span, Some(expected_count), len(children))
  ), diagnostics, deferred)
}

pure body_path_error_type(): SignatureType {
  SignatureType(
    SignatureNominal(DeclarationIdentity(
      ModuleIdentity(ToolchainModulePackage(), "path.panack"),
      "PathError"
    )),
    []
  )
}

pure body_path_result_type(value: SignatureType): Option[SignatureType] {
  Some(SignatureType(SignatureCore("Result"), [value, body_path_error_type()]))
}

pure body_check_path_core_call(
  context: BodyContext,
  name: Str,
  children: [BoundBody],
  span: SourceSpan
): BodyResult {
  expected_count: Nat = if name == "path_current" { 0 } else {
    if name == "path_append" || name == "path_join" || name == "path_with_suffix" { 2 } else { 1 }
  }
  mut diagnostics: [Diagnostic] = []
  mut deferred: [SourceSpan] = []
  mut output: Option[SignatureType] = None()
  mut call_arguments: [CallArgumentEvidence] = []
  if len(children) != expected_count {
    diagnostics = append(
      diagnostics,
      Diagnostic(name + " expects ${expected_count} arguments, got " + body_nat_text(len(children)), span.start)
    )
  } else {
    mut index: Nat = 0
    while index < expected_count {
      number: Nat = index + 1
      expected: SignatureType = if name == "path_from_text" {
        SignatureType(SignatureCore("Str"), [])
      } else {
        if name == "path_from_native" {
          SignatureType(SignatureCore("Bytes"), [])
        } else {
          if name == "path_join" || name == "path_suffix" || name == "path_parent" ||
            name == "path_is_absolute" || name == "path_with_suffix" || name == "path_resolve" {
            SignatureType(SignatureCore("Str"), [])
          } else {
            SignatureType(SignatureCore("Path"), [])
          }
        }
      }
      required: BodyResult = body_require_value(
        context,
        children[index],
        expected,
        "argument ${number} to " + name
      )
      diagnostics = concat(diagnostics, required.diagnostics)
      deferred = concat(deferred, required.deferred)
      if context.retain_guard_conversions {
        accepted: Option[Bool] = if len(required.diagnostics) > 0 {
          Some(false)
        } else {
          if len(required.deferred) > 0 { None() } else { Some(true) }
        }
        call_arguments = append(call_arguments, CallArgumentEvidence(
          "call argument ${number} to " + name,
          children[index].span,
          children[index].type,
          expected,
          accepted
        ))
      }
      index = index + 1
    }
    if len(diagnostics) == 0 && len(deferred) == 0 {
      path: SignatureType = SignatureType(SignatureCore("Path"), [])
      output = if name == "path_from_text" || name == "path_from_native" || name == "path_append" {
        body_path_result_type(path)
      } else {
        if name == "path_join" || name == "path_suffix" || name == "path_parent" ||
          name == "path_with_suffix" || name == "path_resolve" {
          body_core_type("Str")
        } else {
        if name == "path_is_absolute" {
          body_core_type("Bool")
        } else {
        if name == "path_to_text" {
          body_path_result_type(SignatureType(SignatureCore("Str"), []))
        } else {
          if name == "path_native_bytes" {
            body_core_type("Bytes")
          } else {
            if name == "path_display" {
              body_core_type("Str")
            } else {
              if name == "path_absolute" {
                body_core_type("Bool")
              } else {
                if name == "path_directory" || name == "path_current" {
                  Some(path)
                } else {
                  if name == "path_filename" {
                    Some(SignatureType(SignatureCore("Option"), [path]))
                  } else {
                    None()
                  }
                }
              }
            }
          }
        }
        }
        }
      }
    }
  }
  BodyResult(BoundBody(
    BodyCall(BodyCore(name), [], call_arguments), span, children, output, [], [], [], [], [],
    body_call_arity_evidence(context, "core", span, Some(expected_count), len(children))
  ), diagnostics, deferred)
}

pure body_optional_type(type: Option[SignatureType]): SignatureType {
  match type {
    Some(value) => value,
    None() => SignatureType(SignatureCore("Void"), [])
  }
}

pure body_concat_item_type(type: Option[SignatureType]): Option[SignatureType] {
  match type {
    None() => None(),
    Some(collection) => if collection.identity == SignatureCore("Array") && len(collection.arguments) == 1 {
      Some(collection.arguments[0])
    } else {
      None()
    }
  }
}

pure body_check_collection_core_call(
  context: BodyContext,
  name: Str,
  children: [BoundBody],
  span: SourceSpan,
  initial_diagnostics: [Diagnostic],
  initial_deferred: [SourceSpan]
): BodyResult {
  operation: Str = if name == "$method_put" { "map_put" } else {
    if name == "$method_get" { "map_get" } else {
      if name == "$method_add" { "set_add" } else {
        if name == "$method_has" { "has" } else {
          if name == "$method_map" { "array_map" } else {
            if name == "$method_reduce" { "array_reduce" } else { name }
          }
        }
      }
    }
  }
  expected_count: Nat = if operation == "map_put" || operation == "array_reduce" { 3 } else { 2 }
  mut diagnostics: [Diagnostic] = initial_diagnostics
  mut deferred: [SourceSpan] = initial_deferred
  mut output: Option[SignatureType] = None()
  mut call_arguments: [CallArgumentEvidence] = []
  mut callback_contracts: [CollectionCallbackEvidence] = []
  mut type_joins: [TypeJoinEvidence] = []
  mut type_checks: [BodyTypeCheckEvidence] = []

  if len(children) != expected_count {
    diagnostics = append(diagnostics, Diagnostic(operation + " expects ${expected_count} arguments, got ${len(children)}", span.start))
  } else {
    if context.retain_guard_conversions {
      type_checks = append(type_checks, BodyTypeCheckEvidence(
        "collection receiver",
        children[0].span,
        children[0].type,
        body_collection_receiver_requirement(operation),
        None(),
        body_collection_receiver_acceptance(operation, children[0].type)
      ))
      if operation == "concat" {
        type_checks = append(type_checks, BodyTypeCheckEvidence(
          "collection receiver",
          children[1].span,
          children[1].type,
          body_collection_receiver_requirement(operation),
          None(),
          body_collection_receiver_acceptance(operation, children[1].type)
        ))
      }
    }
    if children[0].type == None() ||
      ((operation != "append" && operation != "map_put" && operation != "map_get" &&
        operation != "map_has" && operation != "set_add" && operation != "set_has" &&
        operation != "has" && operation != "array_map") && children[1].type == None()) {
      deferred = append(deferred, span)
      if operation == "concat" && context.retain_guard_conversions {
        type_joins = append(type_joins, TypeJoinEvidence(
          "array concatenation",
          span,
          body_concat_item_type(children[0].type),
          body_concat_item_type(children[1].type),
          None(),
          None()
        ))
      }
    } else {
      collection: SignatureType = body_optional_type(children[0].type)
      value: SignatureType = body_optional_type(children[1].type)
      if operation == "append" || operation == "concat" {
        if operation == "append" {
          if collection.identity != SignatureCore("Array") || len(collection.arguments) != 1 {
            diagnostics = append(diagnostics, Diagnostic("append expects an array, got " + body_type_text(collection), span.start))
          } else {
            item: BodyResult = body_require_value(
              context,
              children[1],
              collection.arguments[0],
              "append item"
            )
            diagnostics = concat(diagnostics, item.diagnostics)
            deferred = concat(deferred, item.deferred)
            if context.retain_guard_conversions {
              accepted: Option[Bool] = if len(item.diagnostics) > 0 {
                Some(false)
              } else {
                if len(item.deferred) > 0 { None() } else { Some(true) }
              }
              call_arguments = append(call_arguments, CallArgumentEvidence(
                "call argument 2 to append",
                children[1].span,
                children[1].type,
                collection.arguments[0],
                accepted
              ))
            }
            if len(item.diagnostics) == 0 && len(item.deferred) == 0 {
              output = Some(collection)
            }
          }
        } else {
          if collection.identity != SignatureCore("Array") || value.identity != SignatureCore("Array") ||
            len(collection.arguments) != 1 || len(value.arguments) != 1 {
            diagnostics = append(diagnostics, Diagnostic("concat expects two arrays", span.start))
          } else {
            match body_join(context, collection.arguments[0], value.arguments[0]) {
              Error(message) => {
                diagnostics = append(diagnostics, Diagnostic("cannot concatenate " + body_type_text(collection) + " and " + body_type_text(value), span.start))
                if context.retain_guard_conversions {
                  type_joins = append(type_joins, TypeJoinEvidence(
                    "array concatenation",
                    span,
                    Some(collection.arguments[0]),
                    Some(value.arguments[0]),
                    None(),
                    Some(false)
                  ))
                }
              },
              Ok(joined) => match joined {
                None() => {
                  deferred = append(deferred, span)
                  if context.retain_guard_conversions {
                    type_joins = append(type_joins, TypeJoinEvidence(
                      "array concatenation",
                      span,
                      Some(collection.arguments[0]),
                      Some(value.arguments[0]),
                      None(),
                      None()
                    ))
                  }
                },
                Some(item) => {
                  output = Some(SignatureType(SignatureCore("Array"), [item]))
                  if context.retain_guard_conversions {
                    type_joins = append(type_joins, TypeJoinEvidence(
                      "array concatenation",
                      span,
                      Some(collection.arguments[0]),
                      Some(value.arguments[0]),
                      Some(item),
                      Some(true)
                    ))
                  }
                }
              }
            }
          }
        }
      } else {
        if operation == "array_map" || operation == "array_reduce" {
          if collection.identity != SignatureCore("Array") || len(collection.arguments) != 1 {
            diagnostics = append(diagnostics, Diagnostic(operation + " expects an array, got " + body_type_text(collection), span.start))
          } else {
            callback_index: Nat = if operation == "array_map" { 1 } else { 2 }
            callback_option: Option[SignatureType] = children[callback_index].type;
            expected_parameters: [SignatureType] = if operation == "array_map" {
              [collection.arguments[0]]
            } else {
              [value, collection.arguments[0]]
            }
            expected_result: Option[SignatureType] = if operation == "array_map" { None() } else { Some(value) }
            match callback_option {
              None() => {
                deferred = append(deferred, span)
                if context.retain_guard_conversions {
                  callback_contracts = append(callback_contracts, CollectionCallbackEvidence(
                    operation,
                    children[callback_index].span,
                    None(),
                    expected_parameters,
                    None(),
                    expected_result,
                    None()
                  ))
                }
              },
              Some(callback) => match callback.identity {
                SignatureCallable(effect) => {
                  expected_arguments: Nat = if operation == "array_map" { 1 } else { 2 }
                  mut accepted: Option[Bool] = None()
                  mut callback_result: Option[SignatureType] = if len(callback.arguments) > 0 {
                    Some(callback.arguments[prior_index(len(callback.arguments))])
                  } else {
                    None()
                  }
                  if effect != SignaturePure() {
                    diagnostics = append(diagnostics, Diagnostic(operation + " requires a pure callable", span.start))
                    accepted = Some(false)
                  } else {
                    if len(callback.arguments) != expected_arguments + 1 {
                      diagnostics = append(diagnostics, Diagnostic(operation + " callback has incorrect arity", span.start))
                      accepted = Some(false)
                    } else {
                      diagnostic_start: Nat = len(diagnostics)
                      deferred_start: Nat = len(deferred)
                      accumulator: SignatureType = value
                      expected_input: SignatureType = if operation == "array_map" { collection.arguments[0] } else { accumulator }
                      first_argument: BodyResult = body_require(context, Some(expected_input), callback.arguments[0], operation + " callback", children[callback_index].span)
                      diagnostics = concat(diagnostics, first_argument.diagnostics)
                      deferred = concat(deferred, first_argument.deferred)
                      if operation == "array_map" {
                        callback_result = Some(callback.arguments[1])
                        if callback.arguments[1] == SignatureType(SignatureCore("Void"), []) {
                          diagnostics = append(diagnostics, Diagnostic("map callback cannot return Void", span.start))
                        } else {
                          output = Some(SignatureType(SignatureCore("Array"), [callback.arguments[1]]))
                        }
                      } else {
                        callback_result = Some(callback.arguments[2])
                        second_argument: BodyResult = body_require(context, Some(collection.arguments[0]), callback.arguments[1], "reduce callback", children[callback_index].span)
                        result_argument: BodyResult = body_require(context, Some(callback.arguments[2]), accumulator, "reduce callback result", children[callback_index].span)
                        diagnostics = concat(diagnostics, concat(second_argument.diagnostics, result_argument.diagnostics))
                        deferred = concat(deferred, concat(second_argument.deferred, result_argument.deferred))
                        output = Some(accumulator)
                      }
                      accepted = if len(diagnostics) > diagnostic_start {
                        Some(false)
                      } else {
                        if len(deferred) > deferred_start { None() } else { Some(true) }
                      }
                    }
                  }
                  if context.retain_guard_conversions {
                    callback_contracts = append(callback_contracts, CollectionCallbackEvidence(
                      operation,
                      children[callback_index].span,
                      Some(callback),
                      expected_parameters,
                      callback_result,
                      expected_result,
                      accepted
                    ))
                  }
                },
                SignatureHole(owner, path, index) => {
                  deferred = append(deferred, span)
                  if context.retain_guard_conversions {
                    callback_contracts = append(callback_contracts, CollectionCallbackEvidence(operation, children[callback_index].span, Some(callback), expected_parameters, None(), expected_result, None()))
                  }
                },
                SignatureParameter(owner, index) => {
                  deferred = append(deferred, span)
                  if context.retain_guard_conversions {
                    callback_contracts = append(callback_contracts, CollectionCallbackEvidence(operation, children[callback_index].span, Some(callback), expected_parameters, None(), expected_result, None()))
                  }
                },
                SignatureCore(core_identity) => {
                  diagnostics = append(diagnostics, Diagnostic(operation + " requires a callable", span.start))
                  if context.retain_guard_conversions {
                    callback_contracts = append(callback_contracts, CollectionCallbackEvidence(operation, children[callback_index].span, Some(callback), expected_parameters, None(), expected_result, Some(false)))
                  }
                },
                SignatureNominal(identity) => {
                  diagnostics = append(diagnostics, Diagnostic(operation + " requires a callable", span.start))
                  if context.retain_guard_conversions {
                    callback_contracts = append(callback_contracts, CollectionCallbackEvidence(operation, children[callback_index].span, Some(callback), expected_parameters, None(), expected_result, Some(false)))
                  }
                }
              }
            }
          }
        } else {
          checked: BodyResult = body_check_map_set_call(
            context,
            operation,
            collection,
            children,
            span,
            diagnostics,
            deferred
          )
          diagnostics = checked.diagnostics
          deferred = checked.deferred
          output = checked.body.type;
          call_arguments = body_direct_call_argument_metadata(checked.body)
          type_checks = concat(type_checks, body_type_check_evidence(checked.body))
        }
      }
    }
  }
  type_checks = concat(type_checks, body_call_arity_evidence(context, "core", span, Some(expected_count), len(children)))
  node: BodyNode = if context.retain_guard_conversions {
    BodyCall(BodyCore(operation), [], call_arguments)
  } else {
    BodyEmpty()
  }
  BodyResult(BoundBody(node, span, [], output, [], [], type_joins, callback_contracts, [], type_checks), diagnostics, deferred)
}

pure body_collection_receiver_requirement(operation: Str): Str {
  if operation == "append" || operation == "concat" || operation == "array_map" || operation == "array_reduce" {
    "Array"
  } else {
    if operation == "map_put" || operation == "map_get" || operation == "map_has" {
      "Map"
    } else {
      if operation == "set_add" || operation == "set_has" {
        "Set"
      } else {
        "Map or Set"
      }
    }
  }
}

pure body_collection_receiver_acceptance(
  operation: Str,
  actual: Option[SignatureType]
): Option[Bool] {
  match actual {
    None() => None(),
    Some(type) => if operation == "append" || operation == "concat" || operation == "array_map" || operation == "array_reduce" {
      Some(type.identity == SignatureCore("Array") && len(type.arguments) == 1)
    } else {
      if operation == "map_put" || operation == "map_get" || operation == "map_has" {
        Some(type.identity == SignatureCore("Map") && len(type.arguments) == 2)
      } else {
        if operation == "set_add" || operation == "set_has" {
          Some(type.identity == SignatureCore("Set") && len(type.arguments) == 1)
        } else {
          Some((type.identity == SignatureCore("Map") && len(type.arguments) == 2) ||
            (type.identity == SignatureCore("Set") && len(type.arguments) == 1))
        }
      }
    }
  }
}

pure body_check_map_set_call(
  context: BodyContext,
  operation: Str,
  collection: SignatureType,
  children: [BoundBody],
  span: SourceSpan,
  initial_diagnostics: [Diagnostic],
  initial_deferred: [SourceSpan]
): BodyResult {
  mut diagnostics: [Diagnostic] = initial_diagnostics
  mut deferred: [SourceSpan] = initial_deferred
  mut output: Option[SignatureType] = None()
  mut call_arguments: [CallArgumentEvidence] = []
  is_map: Bool = collection.identity == SignatureCore("Map") && len(collection.arguments) == 2
  is_set: Bool = collection.identity == SignatureCore("Set") && len(collection.arguments) == 1
  is_lookup: Bool = operation == "map_get" || operation == "map_has" || operation == "has"

  if (operation == "map_put" || operation == "map_get" || operation == "map_has") && !is_map {
    diagnostics = append(diagnostics, Diagnostic(operation + " expects a Map, got " + body_type_text(collection), span.start))
  } else {
    if (operation == "set_add" || operation == "set_has") && !is_set {
      diagnostics = append(diagnostics, Diagnostic(operation + " expects a Set, got " + body_type_text(collection), span.start))
    } else {
      if operation == "has" && !is_map && !is_set {
        diagnostics = append(diagnostics, Diagnostic("has expects a Map or Set, got " + body_type_text(collection), span.start))
      } else {
        if is_map {
          expected_key: SignatureType = collection.arguments[0]
          key: BodyResult = body_require_value(context, children[1], expected_key, "key to " + operation)
          diagnostics = concat(diagnostics, key.diagnostics)
          deferred = concat(deferred, key.deferred)
          if context.retain_guard_conversions {
            accepted: Option[Bool] = if len(key.diagnostics) > 0 {
              Some(false)
            } else {
              if len(key.deferred) > 0 { None() } else { Some(true) }
            }
            call_arguments = append(call_arguments, CallArgumentEvidence(
              "call argument 2 to " + operation,
              children[1].span,
              children[1].type,
              expected_key,
              accepted
            ))
          }
          if operation == "map_put" {
            value: BodyResult = body_require_value(context, children[2], collection.arguments[1], "value to map_put")
            diagnostics = concat(diagnostics, value.diagnostics)
            deferred = concat(deferred, value.deferred)
            if context.retain_guard_conversions {
              accepted: Option[Bool] = if len(value.diagnostics) > 0 {
                Some(false)
              } else {
                if len(value.deferred) > 0 { None() } else { Some(true) }
              }
              call_arguments = append(call_arguments, CallArgumentEvidence(
                "call argument 3 to map_put",
                children[2].span,
                children[2].type,
                collection.arguments[1],
                accepted
              ))
            }
            output = Some(collection)
          } else {
            if is_lookup {
              output = if operation == "map_get" { Some(collection.arguments[1]) } else { body_core_type("Bool") }
            }
          }
        }
        if is_set {
          item: BodyResult = body_require_value(context, children[1], collection.arguments[0], operation)
          diagnostics = concat(diagnostics, item.diagnostics)
          deferred = concat(deferred, item.deferred)
          if context.retain_guard_conversions {
            accepted: Option[Bool] = if len(item.diagnostics) > 0 {
              Some(false)
            } else {
              if len(item.deferred) > 0 { None() } else { Some(true) }
            }
            call_arguments = append(call_arguments, CallArgumentEvidence(
              "call argument 2 to " + operation,
              children[1].span,
              children[1].type,
              collection.arguments[0],
              accepted
            ))
          }
          output = if operation == "set_add" { Some(collection) } else { body_core_type("Bool") }
        }
      }
    }
  }
  node: BodyNode = if context.retain_guard_conversions {
    BodyCall(BodyCore(operation), [], call_arguments)
  } else {
    BodyEmpty()
  }
  BodyResult(
    BoundBody(node, span, [], output, body_collection_call_solutions(operation, children), [],  [], [], [], []),
    diagnostics,
    deferred
  )
}

pure body_collection_call_solutions(
  operation: Str,
  children: [BoundBody]
): [BodySolution] {
  if (operation == "map_put" || operation == "$method_put") && len(children) == 3 {
    match children[0].type {
      None() => [],
      Some(collection) => if collection.identity == SignatureCore("Map") && len(collection.arguments) == 2 {
        match children[1].type {
          None() => [],
          Some(key) => concat(
            body_solutions(collection.arguments[0], key),
            match children[2].type {
              None() => [],
              Some(value) => body_solutions(collection.arguments[1], value)
            }
          )
        }
      } else {
        []
      }
    }
  } else {
    if (operation == "set_add" || operation == "$method_add") && len(children) == 2 {
      match children[0].type {
        None() => [],
        Some(collection) => if collection.identity == SignatureCore("Set") && len(collection.arguments) == 1 {
          match children[1].type {
            None() => [],
            Some(item) => body_solutions(collection.arguments[0], item)
          }
        } else {
          []
        }
      }
    } else {
      []
    }
  }
}

pure bind_body_expression(
  context: BodyContext,
  expression: Expr,
  origin: SourceSpan,
  locals: Map[Str, BodyLocal],
  path: [Nat]
): BodyResult {
  bind_body_expression_with_type_argument_spans(
    context,
    expression,
    origin,
    locals,
    path,
    []
  )
}

pure bind_body_expression_with_type_argument_spans(
  context: BodyContext,
  expression: Expr,
  origin: SourceSpan,
  locals: Map[Str, BodyLocal],
  path: [Nat],
  type_argument_spans: [SourceSpan]
): BodyResult {
  mut result: BodyResult = body_result(BodyEmpty(), origin, [], None())

  match expression {
    LocatedExpr(span, value, located_type_argument_spans) => {
      result = bind_body_expression_with_type_argument_spans(
        context,
        value,
        span,
        locals,
        path,
        located_type_argument_spans
      )
    },
    NatExpr(value) => {
      result = body_result(BodyLiteral(expression), origin, [], body_core_type("Nat"))
    },
    DecimalExpr(value) => {
      result = body_result(BodyLiteral(expression), origin, [], body_core_type("Dec"))
    },
    StringExpr(value) => {
      result = bind_body_string(context, expression, value, origin, locals)
    },
    BoolExpr(value) => {
      result = body_result(BodyLiteral(expression), origin, [], body_core_type("Bool"))
    },
    NameExpr(name) => {
      if !locals.has(name) {
        result = body_failure("unknown local value " + name, origin)
      } else {
        local: BodyLocal = locals.get(name)
        result = body_result(BodyLocalUse(local.identity), origin, [], local.type)
      }
    },
    FunctionExpr(name) => {
      match resolve_module_function(context.graph, context.owner.module, name) {
        Error(message) => {
          result = body_failure(message, origin)
        },
        Ok(binding) => {
          mut type: Option[SignatureType] = None()
          mut deferred: [SourceSpan] = []
          match body_signature(context.signatures, binding.identity) {
            None() => {
              deferred = [origin]
            },
            Some(signature) => {
              if len(signature.parameters) > 0 {
                result = body_failure(
                  "generic function references require a non-generic wrapper",
                  origin
                )
              } else {
                mut arguments: [SignatureType] = []
                for slot in signature.slots {
                  arguments = append(arguments, slot.type)
                }
                match signature.effect {
                  None() => {},
                  Some(effect) => {
                    type = Some(SignatureType(SignatureCallable(effect), arguments))
                  }
                }
              }
            }
          }
          result = BodyResult(
            BoundBody(BodyFunction(binding), origin, [], type, [], [], [], [], [], []),
            result.diagnostics,
            deferred
          )
        }
      }
    },
    CallExpr(name, arguments, types) => {
      selected: Result[BodyTarget, Str] = if name.starts_with("$owned_call$") {
        body_owned_target(context, name.slice(12, name.len()), arguments, origin, locals, path)
      } else {
        body_target(context, name, false)
      }
      match selected {
        Error(message) => {
          result = body_failure(message, origin)
        },
        Ok(target) => {
          result = body_call(
            context,
            target,
            arguments,
            types,
            type_argument_spans,
            origin,
            locals,
            path
          )
        }
      }
    },
    DotCallExpr(receiver, name, arguments, types) => {
      mut visible: Set[Str] = set()
      head: Str = reference_head(expression_reference_path(receiver))
      if locals.has(head) {
        visible = visible.add(head)
      }
      match resolve_module_dot_call_scoped(
        context.graph,
        context.owner.module,
        receiver,
        name,
        arguments,
        types,
        visible
      ) {
        Error(message) => {
          result = body_failure(message, origin)
        },
        Ok(call) => match call {
          NamespaceCall(binding, values, type_arguments) => {
            result = body_call(
              context,
              BodyDeclaration(binding),
              values,
              type_arguments,
              type_argument_spans,
              origin,
              locals,
              path
            )
          },
          ValueMethodCall(value, method, values, type_arguments) => {
            if module_reserved_binding(method) || lowered_method_name(method) != method {
              result = body_call(
                context,
                BodyCore(lowered_method_name(method)),
                concat([value], values),
                type_arguments,
                type_argument_spans,
                origin,
                locals,
                path
              )
            } else {
              match body_target(context, method, true) {
                Error(message) => {
                  result = body_failure(message, origin)
                },
                Ok(target) => {
                  result = body_call(
                    context,
                    target,
                    concat([value], values),
                    type_arguments,
                    type_argument_spans,
                    origin,
                    locals,
                    path
                  )
                }
              }
            }
          }
        }
      }
    },
    BlockExpr(block) => {
      result = bind_body_block(context, block, origin, locals, path)
    },
    ArrayExpr(items) => {
      result = check_body_array(
        context,
        bind_body_children(context, BodyArray(), items, origin, locals, path),
        path
      )
    },
    UnaryExpr(operator, operand) => {
      result = check_body_operation(
        context,
        bind_body_children(context, BodyUnary(operator), [operand], origin, locals, path),
        operator,
        true
      )
    },
    BinaryExpr(operator, left, right) => {
      result = check_body_operation(
        context,
        bind_body_children(context, BodyBinary(operator), [left, right], origin, locals, path),
        operator,
        false
      )
    },
    FieldExpr(target, field) => {
      raw_path: Str = expression_reference_path(expression)
      if raw_path != "" && !locals.has(reference_head(raw_path)) && module_head_is_namespace(
        context.graph,
        context.owner.module,
        raw_path
      ) {
        result = body_failure("qualified binding is not a value: " + raw_path, origin)
      } else {
        result = check_body_field(
          context,
          bind_body_children(context, BodyField(field), [target], origin, locals, path),
          field
        )
      }
    },
    IndexExpr(target, index) => {
      result = check_body_index(
        context,
        bind_body_children(context, BodyIndex(), [target, index], origin, locals, path)
      )
    },
    IfExpr(condition, yes, no, has_else) => {
      result = bind_body_if(context, condition, yes, no, has_else, origin, locals, path)
    },
    MatchExpr(subject, arms) => {
      result = bind_body_match(context, subject, arms, origin, locals, path)
    }
  }

  result
}

pure bind_body_if(
  context: BodyContext,
  condition: Expr,
  yes: Block,
  no: Block,
  has_else: Bool,
  origin: SourceSpan,
  locals: Map[Str, BodyLocal],
  path: [Nat]
): BodyResult {
  checked_condition: BodyResult = bind_body_expression(
    context,
    condition,
    origin,
    locals,
    append(path, 0)
  )
  yes_context: BodyContext = body_context_with_facts(
    context,
    body_condition_facts(checked_condition.body, context.facts, true)
  )
  no_context: BodyContext = body_context_with_facts(
    context,
    body_condition_facts(checked_condition.body, context.facts, false)
  )
  checked_yes: BodyResult = bind_body_expression(
    yes_context,
    BlockExpr(yes),
    origin,
    locals,
    append(path, 1)
  )
  checked_no: BodyResult = bind_body_expression(
    no_context,
    BlockExpr(no),
    origin,
    locals,
    append(path, 2)
  )
  condition_result: BodyResult = BodyResult(
    BoundBody(
    BodyIf(has_else),
    origin,
    [checked_condition.body, checked_yes.body, checked_no.body],
    None(),
    [],
    [],

    [],
    [],
    [], []
    ),
    concat(checked_condition.diagnostics, concat(checked_yes.diagnostics, checked_no.diagnostics)),
    concat(checked_condition.deferred, concat(checked_yes.deferred, checked_no.deferred))
  )
  check_body_conditional(context, condition_result, has_else, false)
}

pure bind_body_children(
  context: BodyContext,
  node: BodyNode,
  expressions: [Expr],
  span: SourceSpan,
  locals: Map[Str, BodyLocal],
  path: [Nat]
): BodyResult {
  mut children: [BoundBody] = []
  mut diagnostics: [Diagnostic] = []
  mut deferred: [SourceSpan] = [span]
  mut index: Nat = 0

  for expression in expressions {
    checked: BodyResult = bind_body_expression(
      context,
      expression,
      span,
      locals,
      append(path, index)
    )
    children = append(children, checked.body)
    diagnostics = concat(diagnostics, checked.diagnostics)
    deferred = concat(deferred, checked.deferred)
    index = index + 1
  }
  BodyResult(BoundBody(node, span, children, None(), [], [], [], [], [], []), diagnostics, deferred)
}

pure bind_body_block(
  context: BodyContext,
  block: Block,
  span: SourceSpan,
  locals: Map[Str, BodyLocal],
  path: [Nat]
): BodyResult {
  mut current_context: BodyContext = context
  mut visible: Map[Str, BodyLocal] = locals
  mut children: [BoundBody] = []
  mut diagnostics: [Diagnostic] = []
  mut deferred: [SourceSpan] = []
  mut index: Nat = 0

  for statement in block.statements {
    statement_path: [Nat] = append(path, index)
    mut checked: BodyResult = body_result(BodyEmpty(), span, [], None())
    match statement {
      BindingStatement(name, spelling, annotation_span, mutable, value) => {
        if visible.has(name) {
          diagnostics = append(
            diagnostics,
            Diagnostic("local " + name + " shadows an existing binding", span.start)
          )
        }
        checked = bind_body_expression(current_context, value, span, visible, append(statement_path, 0))
        mut value_type_checks: [BodyTypeCheckEvidence] = []
        if checked.body.type == body_core_type("Void") {
          diagnostics = append(
            diagnostics,
            Diagnostic(
            "Void is not a value and cannot be stored in binding " + name,
            checked.body.span.start
          )
          )
          if current_context.retain_guard_conversions {
            value_type_checks = append(value_type_checks, BodyTypeCheckEvidence(
              "binding storage",
              checked.body.span,
              checked.body.type,
              "non-Void stored value",
              None(),
              Some(false)
            ))
          }
        }
        mut type: Option[SignatureType] = checked.body.type;
        mut type_evidence: Option[BindingTypeEvidence] = None()
        if spelling != "" {
          match signature_type(
            current_context.graph,
            current_context.modules,
            current_context.owner,
            current_context.parameters,
            spelling,
            false,
            false
          ) {
            Error(message) => {
              error_position: SourcePos = match annotation_span {
                Some(type_location) => type_location.start,
                None() => checked.body.span.start
              }
              diagnostics = append(diagnostics, Diagnostic(message, error_position))
            },
            Ok(annotation) => {
              required: BodyResult = body_require_value(
                current_context,
                checked.body,
                annotation,
                "binding " + name
              )
              diagnostics = concat(diagnostics, required.diagnostics)
              deferred = concat(deferred, required.deferred)
              type = Some(annotation)
              refined_type: BodyResult = body_refine(
                current_context,
                BodyResult(checked.body, [], []),
                annotation
              )
              if current_context.retain_guard_conversions {
                argument_diagnostics: [Diagnostic] = concat(
                  required.diagnostics,
                  refined_type.diagnostics
                )
                argument_deferred: [SourceSpan] = concat(
                  required.deferred,
                  refined_type.deferred
                )
                accepted: Option[Bool] = if len(argument_diagnostics) > 0 {
                  Some(false)
                } else {
                  if len(argument_deferred) > 0 {
                    None()
                  } else {
                    Some(true)
                  }
                }
                type_evidence = Some(BindingTypeEvidence(
                  "annotated local " + name + " initializer",
                  checked.body.span,
                  checked.body.type,
                  annotation,
                  accepted
                ))
              }
              checked = BodyResult(
                refined_type.body,
                concat(checked.diagnostics, refined_type.diagnostics),
                concat(checked.deferred, refined_type.deferred)
              )
            }
          }
        }
        if spelling == "" {
          diagnostics = concat(diagnostics, body_incomplete_local(name, checked))
        }
        local: BodyLocalIdentity = BodyLocalIdentity(current_context.owner, statement_path, name)
        visible = visible.put(name, BodyLocal(local, type, mutable))
        checked = BodyResult(
          BoundBody(
            BodyBinding(
              local,
              type,
              mutable,
              if current_context.retain_guard_conversions { Some(spelling == "") } else { None() },
              type_evidence
            ),
          checked.body.span,
          [checked.body],
          body_core_type("Void"),
          [],
          [],

          [],
          [],
            [], value_type_checks
          ),
          checked.diagnostics,
          checked.deferred
        )
      },
      AssignmentStatement(name, value) => {
        checked = bind_body_expression(current_context, value, span, visible, append(statement_path, 0))
        if !visible.has(name) {
          diagnostics = concat(diagnostics, body_incomplete_local(name, checked))
          mut value_type_checks: [BodyTypeCheckEvidence] = []
          if checked.body.type == body_core_type("Void") {
            diagnostics = append(
              diagnostics,
              Diagnostic(
              "Void is not a value and cannot be stored in binding " + name,
              checked.body.span.start
            )
            )
            if current_context.retain_guard_conversions {
              value_type_checks = append(value_type_checks, BodyTypeCheckEvidence(
                "binding storage",
                checked.body.span,
                checked.body.type,
                "non-Void stored value",
                None(),
                Some(false)
              ))
            }
          }
          local: BodyLocalIdentity = BodyLocalIdentity(current_context.owner, statement_path, name)
          visible = visible.put(name, BodyLocal(local, checked.body.type, false))
          checked = BodyResult(
            BoundBody(
            BodyBinding(
              local,
              checked.body.type,
              false,
              if current_context.retain_guard_conversions { Some(true) } else { None() },
              None()
            ),
            checked.body.span,
            [checked.body],
            body_core_type("Void"),
            [],
            [],

            [],
            [],
            [], value_type_checks
            ),
            checked.diagnostics,
            checked.deferred
          )
        } else {
          local: BodyLocal = visible.get(name)
          mut assignment_evidence: Option[AssignmentTypeEvidence] = None()
          if !local.mutable {
            diagnostics = append(
              diagnostics,
              Diagnostic("cannot assign immutable binding " + name, checked.body.span.start)
            )
          }
          match local.type {
            None() => {
              deferred = append(deferred, checked.body.span)
              if current_context.retain_guard_conversions {
                assignment_evidence = Some(AssignmentTypeEvidence(
                  "assignment value compatibility for " + name,
                  checked.body.span,
                  checked.body.type,
                  None(),
                  None()
                ))
              }
            },
            Some(type) => {
              required: BodyResult = body_require_value(
                current_context,
                checked.body,
                type,
                "assignment " + name
              )
              diagnostics = concat(diagnostics, required.diagnostics)
              deferred = concat(deferred, required.deferred)
              refined_type: BodyResult = body_refine(
                current_context,
                BodyResult(checked.body, [], []),
                type
              )
              if current_context.retain_guard_conversions {
                assignment_diagnostics: [Diagnostic] = concat(
                  required.diagnostics,
                  refined_type.diagnostics
                )
                assignment_deferred: [SourceSpan] = concat(
                  required.deferred,
                  refined_type.deferred
                )
                accepted: Option[Bool] = if len(assignment_diagnostics) > 0 {
                  Some(false)
                } else {
                  if len(assignment_deferred) > 0 {
                    None()
                  } else {
                    Some(true)
                  }
                }
                assignment_evidence = Some(AssignmentTypeEvidence(
                  "assignment value compatibility for " + name,
                  checked.body.span,
                  checked.body.type,
                  Some(type),
                  accepted
                ))
              }
              checked = BodyResult(
                refined_type.body,
                concat(checked.diagnostics, refined_type.diagnostics),
                concat(checked.deferred, refined_type.deferred)
              )
            }
          }
          checked = BodyResult(
            BoundBody(
            BodyAssignment(local.identity, assignment_evidence),
            checked.body.span,
            [checked.body],
            body_core_type("Void"),
            [],
            [],

            [],
            [],
            [], []
            ),
            checked.diagnostics,
            checked.deferred
          )
        }
      },
      ExpressionStatement(value) => {
        checked = bind_body_expression(current_context, value, span, visible, statement_path)
      },
      WhileStatement(condition, body) => {
        checked_condition: BodyResult = bind_body_expression(
          current_context,
          condition,
          span,
          visible,
          append(statement_path, 0)
        )
        loop_context: BodyContext = body_context_with_facts(
          current_context,
          body_condition_facts(checked_condition.body, current_context.facts, true)
        )
        checked_body: BodyResult = bind_body_expression(
          loop_context,
          BlockExpr(body),
          span,
          visible,
          append(statement_path, 1)
        )
        checked = check_body_conditional(
          current_context,
          BodyResult(
            BoundBody(BodyWhile(), span, [checked_condition.body, checked_body.body], None(), [], [], [], [], [], []),
            concat(checked_condition.diagnostics, checked_body.diagnostics),
            concat(checked_condition.deferred, checked_body.deferred)
          ),
          false,
          true
        )
      },
      ForStatement(name, values, body) => {
        if visible.has(name) {
          diagnostics = append(
            diagnostics,
            Diagnostic("loop variable " + name + " shadows an existing binding", span.start)
          )
        }
        local: BodyLocalIdentity = BodyLocalIdentity(current_context.owner, append(statement_path, 0), name)
        iterable: BodyResult = bind_body_expression(
          current_context,
          values,
          span,
          visible,
          append(statement_path, 1)
        )
        item: BodyResult = body_iteration_item(current_context, iterable)
        iterable_with_evidence: BoundBody = BoundBody(
          iterable.body.node,
          iterable.body.span,
          iterable.body.children,
          iterable.body.type,
          iterable.body.constraints,
          iterable.body.guard_conversions,
          iterable.body.type_joins,
          iterable.body.callback_contracts,
          iterable.body.operator_checks,
          item.body.type_checks
        )
        nested: BodyResult = bind_body_block(
          current_context,
          body,
          span,
          visible.put(name, BodyLocal(local, item.body.type, false)),
          append(statement_path, 2)
        )
        checked = BodyResult(
          BoundBody(BodyFor(local), span, [iterable_with_evidence, nested.body], body_core_type("Void"), [], [], [], [], [], []),
          concat(item.diagnostics, nested.diagnostics),
          concat(item.deferred, nested.deferred)
        )
      }
    }
    current_context = body_context_with_facts(
      current_context,
      body_invalidate_assigned_locals(current_context.facts, checked.body)
    )
    children = append(children, checked.body)
    diagnostics = concat(diagnostics, checked.diagnostics)
    deferred = concat(deferred, checked.deferred)
    index = index + 1
  }
  mut output: Option[SignatureType] = body_core_type("Void")
  match block.value {
    NoBlockValue() => {},
    TailBlockValue(value) => {
      checked: BodyResult = bind_body_expression(current_context, value, span, visible, append(path, index))
      children = append(children, checked.body)
      diagnostics = concat(diagnostics, checked.diagnostics)
      deferred = concat(deferred, checked.deferred)
      output = checked.body.type
    }
  }
  BodyResult(
    BoundBody(BodyBlock(block.value != NoBlockValue()), span, children, output, [], [], [], [], [], []),
    diagnostics,
    deferred
  )
}

pub pure check_module_bodies(
  graph: ModuleBindingGraph,
  modules: [LoadedModule],
  signatures: [ModuleSignature],
  module: LoadedModule
): CheckedModuleBodies {
  check_module_bodies_mode(graph, modules, signatures, module, false)
}

pub pure check_module_bodies_explained(
  graph: ModuleBindingGraph,
  modules: [LoadedModule],
  signatures: [ModuleSignature],
  module: LoadedModule,
  retain_guard_conversions: Bool
): CheckedModuleBodies {
  check_module_bodies_mode(graph, modules, signatures, module, retain_guard_conversions)
}

pure check_module_bodies_mode(
  graph: ModuleBindingGraph,
  modules: [LoadedModule],
  signatures: [ModuleSignature],
  module: LoadedModule,
  retain_guard_conversions: Bool
): CheckedModuleBodies {
  mut functions: [BoundFunctionBody] = []
  mut diagnostics: [Diagnostic] = module_import_shadow_diagnostics(module.bindings, module.parsed)

  if len(diagnostics) == 0 {
    for declaration in module.parsed.program.declarations {
      match declaration {
        FunctionDeclaration(name, parameters, return_type, pure_flag, async_flag, body, type_parameters) => {
          owner: DeclarationIdentity = DeclarationIdentity(module.bindings.identity, name)
          match body_signature(signatures, owner) {
            None() => {},
            Some(signature) => {
              diagnostic_start: Nat = len(diagnostics)
              context: BodyContext = BodyContext(
                graph, modules, signatures, owner, type_parameters, map(), retain_guard_conversions
              )
              mut locals: Map[Str, BodyLocal] = map()
              mut bound_parameters: [BodyLocal] = []
              mut index: Nat = 0
              for parameter in parameters {
                local: BodyLocal = BodyLocal(
                  BodyLocalIdentity(owner, [0, index], parameter.name),
                  Some(signature.slots[index].type),
                  false
                )
                if locals.has(parameter.name) {
                  diagnostics = append(
                    diagnostics,
                    Diagnostic(
                    "duplicate parameter " + parameter.name,
                    signature.binding.span.start
                  )
                  )
                }
                locals = locals.put(parameter.name, local)
                bound_parameters = append(bound_parameters, local)
                index = index + 1
              }
              initial: BodyResult = bind_body_block(
                context,
                body,
                signature.binding.span,
                locals,
                [1]
              )
              expected: SignatureType = signature.slots[len(parameters)].type;
              checked: BodyResult = body_finish_constraints(
                context,
                body_refine(context, initial, expected)
              )
              required: BodyResult = body_require_value(
                context,
                checked.body,
                expected,
                "return of " + name
              )
              diagnostics = concat(diagnostics, concat(checked.diagnostics, required.diagnostics))
              all_deferred: [SourceSpan] = concat(
                concat(checked.deferred, required.deferred),
                body_unresolved_spans(checked.body)
              )
              status: BodyCheckStatus = if len(diagnostics) > diagnostic_start {
                BodyInvalid()
              } else {
                if len(all_deferred) > 0 {
                  BodyDeferred()
                } else {
                  BodyIdentityChecked()
                }
              }
              return_type_evidence: Option[ReturnTypeEvidence] = if context.retain_guard_conversions {
                accepted: Option[Bool] = if len(required.diagnostics) > 0 {
                  Some(false)
                } else {
                  if len(required.deferred) > 0 {
                    None()
                  } else {
                    Some(true)
                  }
                }
                Some(ReturnTypeEvidence(
                  body_return_value_span(checked.body),
                  checked.body.type,
                  expected,
                  accepted
                ))
              } else {
                None()
              }
              functions = append(
                functions,
                BoundFunctionBody(
                  signature,
                  bound_parameters,
                  checked.body,
                  all_deferred,
                  status,
                  return_type_evidence
                )
              )
            }
          }
        },
        TypeDeclaration(name, base, guard) => {
          for binding in module.bindings.declarations {
            if binding.identity.name == name {
              diagnostics = concat(
                diagnostics,
                resolve_module_expression_uses(
                graph,
                module.bindings.identity,
                guard,
                binding.span,
                set_add(set(), "value")
              ).diagnostics
              )
            }
          }
        },
        ImportDeclaration(path) => {},
        RecordDeclaration(name, types, fields) => {},
        EnumDeclaration(name, types, variants) => {}
      }
    }
  }
  CheckedModuleBodies(functions, diagnostics)
}

// Remove only this operation's pending marker, preserving every child obligation.
pure body_child_obligations(checked: BodyResult): [SourceSpan] {
  mut result: [SourceSpan] = []
  mut index: Nat = 0

  for span in checked.deferred {
    if index > 0 {
      result = append(result, span)
    }
    index = index + 1
  }

  result
}

pure body_guarded(context: BodyContext, value: SignatureType): Bool {
  mut result: Bool = false

  match value.identity {
    SignatureNominal(identity) => {
      match signature_declaration(context.modules, identity) {
        Error(message) => {},
        Ok(declaration) => match declaration {
          TypeDeclaration(name, base, guard) => {
            result = true
          },
          FunctionDeclaration(name, parameters, return_type, pure_flag, async_flag, body, types) => {},
          ImportDeclaration(path) => {},
          RecordDeclaration(name, parameters, fields) => {},
          EnumDeclaration(name, parameters, variants) => {}
        }
      }
    },
    SignatureCore(name) => {},
    SignatureParameter(owner, index) => {},
    SignatureCallable(effect) => {},
    SignatureHole(owner, path, index) => {}
  }

  result
}

pure body_scalar(value: SignatureType): Str {
  match value.identity {
    SignatureCore(name) => if len(value.arguments) == 0 {
      name
    } else {
      ""
    },
    SignatureNominal(identity) => "",
    SignatureParameter(owner, index) => "",
    SignatureCallable(effect) => "",
    SignatureHole(owner, path, index) => ""
  }
}

pure check_body_operation(
  context: BodyContext,
  checked: BodyResult,
  operator: Str,
  unary: Bool
): BodyResult {
  node: BoundBody = checked.body
  mut diagnostics: [Diagnostic] = checked.diagnostics
  mut deferred: [SourceSpan] = body_child_obligations(checked)
  mut output: Option[SignatureType] = None()
  mut solutions: [BodySolution] = []
  mut operator_accepted: Option[Bool] = None()
  mut operator_checks: [OperatorTypeEvidence] = node.operator_checks
  left_type: Option[SignatureType] = node.children[0].type;
  right_type: Option[SignatureType] = if unary {
    left_type
  } else {
    node.children[1].type
  }
  if operator == "await" {
    output = left_type
  } else {
    match left_type {
      None() => {
        deferred = append(deferred, node.span)
      },
      Some(left) => match right_type {
        None() => {
          deferred = append(deferred, node.span)
        },
        Some(right) => {
            a: Str = body_operation_scalar(context, node.children[0])
            b: Str = if unary {
              a
            } else {
              body_operation_scalar(context, node.children[1])
            }
            mut valid: Bool = true
            if unary {
              if operator == "!" && a == "Bool" {
                output = body_core_type("Bool")
              } else {
                if operator == "-" && scalar_numeric(a) {
                  output = body_core_type(if a == "Nat" {
                      "Int"
                    } else {
                      a
                    })
                } else {
                  valid = false
                }
              }
            } else {
              if operator == ".." {
                valid = a == "Nat" && b == "Nat"
                output = body_core_type("Range")
              } else {
                if operator == "&&" || operator == "||" {
                  valid = a == "Bool" && b == "Bool"
                  output = body_core_type("Bool")
                } else {
                  if operator == "==" ||
                    operator == "!=" ||
                    operator == "<" ||
                    operator == "<=" ||
                    operator == ">" ||
                    operator == ">=" {
                    numeric_pair: Bool = (a == "Nat" ||
                      a == "Int" ||
                      a == "Rat") &&
                      (b == "Nat" ||
                      b == "Int" ||
                      b == "Rat")
                    ordered: Bool = operator != "==" && operator != "!="
                    valid = (left == right || numeric_pair) && a != "Void" && b != "Void"
                    if ordered {
                      valid = valid && (scalar_numeric(a) || a == "Str")
                    } else {
                      if !numeric_pair && left != right && a != "Void" && b != "Void" {
                        match body_join(context, left, right) {
                          Error(message) => {
                            valid = false
                          },
                          Ok(joined) => match joined {
                            None() => {
                              valid = true
                              deferred = append(deferred, node.span)
                            },
                            Some(type) => {
                              valid = true
                              solutions = concat(
                                body_solutions(left, type),
                                body_solutions(right, type)
                              )
                            }
                          }
                        }
                      }
                    }
                    output = body_core_type("Bool")
                  } else {
                    if operator == "+" && a == "Str" && b == "Str" {
                      output = body_core_type("Str")
                    } else {
                      valid = scalar_compatible_numeric(
                        a,
                        b
                      ) && !(operator == "%" && (a == "Rat" || b == "Rat"))
                      if valid {
                        output = body_core_type(scalar_arithmetic_result(operator, a, b))
                        // A Nat subtraction is checked against the lower bound for
                        // this exact local identity, including its guarded type.
                        if operator == "-" && output == body_core_type("Nat") &&
                          !body_proves_nat_subtraction(context, node.children[0], node.children[1]) {
                          deferred = append(deferred, node.span)
                        }
                      }
                    }
                  }
                }
              }
            }
            if !valid {
              message: Str = "operator " + operator + " does not accept " + body_type_text(left) + if unary {
                ""
              } else {
                " and " + body_type_text(right)
              }
              diagnostics = append(diagnostics, Diagnostic(message, node.span.start))
              output = None()
            }
            operator_accepted = Some(valid)
        }
      }
    }
  }
  if operator != "await" && context.retain_guard_conversions {
    operator_checks = append(operator_checks, OperatorTypeEvidence(
      operator,
      unary,
      node.span,
      left_type,
      if unary { None() } else { right_type },
      output,
      operator_accepted
    ))
  }
  body_apply_solutions(
    context,
    BodyResult(
    BoundBody(node.node, node.span, node.children, output, node.constraints, node.guard_conversions, node.type_joins, node.callback_contracts, operator_checks, node.type_checks),
    diagnostics,
    deferred
  ),
    solutions
  )
}

// Joins combine structural evidence without erasing nominal or binder identity.
// Guard-dependent joins remain separate proof obligations.
pure body_join(
  context: BodyContext,
  left: SignatureType,
  right: SignatureType
): Result[Option[SignatureType], Str] {
  if left == right {
    Ok(Some(left))
  } else {
    if body_is_hole(left) {
      Ok(Some(right))
    } else {
      if body_is_hole(right) {
        Ok(Some(left))
      } else {
        if left.identity == right.identity &&
          len(left.arguments) > 0 &&
          len(left.arguments) == len(right.arguments) &&
          !body_callable(left) {
          mut joined: [SignatureType] = []
          mut failure: Option[Str] = None()
          mut deferred: Bool = false
          mut index: Nat = 0
          for argument in left.arguments {
            match body_join(context, argument, right.arguments[index]) {
              Error(message) => {
                failure = Some(message)
              },
              Ok(optional) => match optional {
                None() => {
                  deferred = true
                },
                Some(type) => {
                  joined = append(joined, type)
                }
              }
            }
            index = index + 1
          }
          match failure {
            Some(message) => Error(message),
            None() => if deferred {
              Ok(None())
            } else {
              Ok(Some(SignatureType(left.identity, joined)))
            }
          }
        } else {
          match body_compatibility(context, left, right) {
            None() => Ok(None()),
            Some(forward) => if forward {
              Ok(Some(right))
            } else {
              match body_compatibility(context, right, left) {
                None() => Ok(None()),
                Some(backward) => if backward {
                  Ok(Some(left))
                } else {
                  a: Str = body_scalar(left)
                  b: Str = body_scalar(right)
                  // Do not inherit the legacy Rat/integer join's loss of rational identity.
                  rational_join: Bool = (a == "Rat" &&
                    (b == "Nat" ||
                    b == "Int")) ||
                    (b == "Rat" &&
                    (a == "Nat" ||
                    a == "Int"))
                  if rational_join {
                    Ok(None())
                  } else {
                    Error("incompatible types " + body_type_text(left) + " and " + body_type_text(right))
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

pure check_body_conditional(
  context: BodyContext,
  checked: BodyResult,
  has_else: Bool,
  loop: Bool
): BodyResult {
  node: BoundBody = checked.body
  required: BodyResult = body_require(
    context,
    node.children[0].type,
    SignatureType(SignatureCore("Bool"), []),
    if loop {
      "while condition"
    } else {
      "if condition"
    }, node.children[0].span)
  mut diagnostics: [Diagnostic] = concat(checked.diagnostics, required.diagnostics)
  // If/while callers already aggregate condition and branch obligations, so
  // there is no synthetic leading marker to remove here.
  mut deferred: [SourceSpan] = concat(checked.deferred, required.deferred)
  mut type_checks: [BodyTypeCheckEvidence] = node.type_checks
  if context.retain_guard_conversions {
    accepted: Option[Bool] = if len(required.diagnostics) > 0 {
      Some(false)
    } else {
      if len(required.deferred) > 0 { None() } else { Some(true) }
    }
    type_checks = append(type_checks, BodyTypeCheckEvidence(
      if loop { "while condition" } else { "if condition" },
      node.children[0].span,
      node.children[0].type,
      "Bool",
      None(),
      accepted
    ))
  }
  mut type_joins: [TypeJoinEvidence] = []
  mut output: Option[SignatureType] = body_core_type("Void")
  if has_else {
    output = None()
    match node.children[1].type {
      None() => {
        deferred = append(deferred, node.span)
        if context.retain_guard_conversions {
          type_joins = append(type_joins, TypeJoinEvidence(
            if loop { "loop result" } else { "conditional result" },
            node.span,
            node.children[1].type,
            None(),
            None(),
            None()
          ))
        }
      },
      Some(left) => match node.children[2].type {
        None() => {
          deferred = append(deferred, node.span)
          if context.retain_guard_conversions {
            type_joins = append(type_joins, TypeJoinEvidence(
              if loop { "loop result" } else { "conditional result" },
              node.span,
              Some(left),
              None(),
              None(),
              None()
            ))
          }
        },
        Some(right) => match body_join(context, left, right) {
          Error(message) => {
            diagnostics = append(diagnostics, Diagnostic(message, node.span.start))
            if context.retain_guard_conversions {
              type_joins = append(type_joins, TypeJoinEvidence(
                if loop { "loop result" } else { "conditional result" },
                node.span,
                Some(left),
                Some(right),
                None(),
                Some(false)
              ))
            }
          },
          Ok(joined) => {
            output = joined
            if context.retain_guard_conversions {
              type_joins = append(type_joins, TypeJoinEvidence(
                if loop { "loop result" } else { "conditional result" },
                node.span,
                Some(left),
                Some(right),
                joined,
                if joined == None() { None() } else { Some(true) }
              ))
            }
            if joined == None() {
              deferred = append(deferred, node.span)
            }
          }
        }
      }
    }
  }
  mut solutions: [BodySolution] = []
  match output {
    None() => {},
    Some(type) => {
      if has_else {
        for child in [node.children[1], node.children[2]] {
          match child.type {
            None() => {},
            Some(actual) => {
              solutions = concat(solutions, body_solutions(actual, type))
            }
          }
        }
      }
    }
  }
  body_apply_solutions(
    context,
    BodyResult(
    BoundBody(node.node, node.span, node.children, output, node.constraints, node.guard_conversions, concat(node.type_joins, type_joins), node.callback_contracts, node.operator_checks, type_checks),
    diagnostics,
    deferred
  ),
    solutions
  )
}

pure body_iteration_item(context: BodyContext, checked: BodyResult): BodyResult {
  mut output: Option[SignatureType] = None()
  mut diagnostics: [Diagnostic] = checked.diagnostics
  mut deferred: [SourceSpan] = checked.deferred
  mut accepted: Option[Bool] = None()

  match checked.body.type {
    None() => {
      deferred = append(deferred, checked.body.span)
    },
    Some(type) => {
      if body_guarded(context, type) {
        deferred = append(deferred, checked.body.span)
      } else {
        if type == SignatureType(
          SignatureCore("Range"),
          []
        ) || type == SignatureType(SignatureCore("Bytes"), []) {
          output = body_core_type("Nat")
          accepted = Some(true)
        } else {
          if type.identity == SignatureCore("Array") && len(type.arguments) == 1 {
            output = Some(type.arguments[0])
            accepted = Some(true)
          } else {
            accepted = Some(false)
            diagnostics = append(
              diagnostics,
              Diagnostic(
              "for requires Range, Bytes or array, got " + body_type_text(type),
              checked.body.span.start
            )
            )
          }
        }
      }
    }
  }
  BodyResult(
    BoundBody(
    checked.body.node,
    checked.body.span,
    checked.body.children,
    output,
    checked.body.constraints,
    checked.body.guard_conversions,
    checked.body.type_joins,
    checked.body.callback_contracts,
    checked.body.operator_checks,
    if context.retain_guard_conversions {
      append(checked.body.type_checks, BodyTypeCheckEvidence(
        "for iterable",
        checked.body.span,
        checked.body.type,
        "Range, Bytes or Array[T]",
        output,
        accepted
      ))
    } else {
      checked.body.type_checks
    }
  ),
    diagnostics,
    deferred
  )
}

pure check_body_index(context: BodyContext, checked: BodyResult): BodyResult {
  node: BoundBody = checked.body
  required: BodyResult = body_require(
    context,
    node.children[1].type,
    SignatureType(SignatureCore("Nat"), []),
    "index",
    node.children[1].span
  )
  mut diagnostics: [Diagnostic] = concat(checked.diagnostics, required.diagnostics)
  mut deferred: [SourceSpan] = concat(body_child_obligations(checked), required.deferred)
  mut output: Option[SignatureType] = None()
  mut receiver_accepted: Option[Bool] = None()

  match node.children[0].type {
    None() => {
      deferred = append(deferred, node.span)
    },
    Some(type) => {
      if type == SignatureType(SignatureCore("Str"), []) {
        output = body_core_type("Str")
        receiver_accepted = Some(true)
      } else {
        if type == SignatureType(SignatureCore("Bytes"), []) {
          output = body_core_type("Nat")
          receiver_accepted = Some(true)
        } else {
          if type.identity == SignatureCore("Array") && len(type.arguments) == 1 {
            output = Some(type.arguments[0])
            receiver_accepted = Some(true)
          } else {
            if body_guarded(context, type) {
              deferred = append(deferred, node.span)
            } else {
              receiver_accepted = Some(false)
              diagnostics = append(
                diagnostics,
                Diagnostic(
                "indexing requires Str, Bytes or array, got " + body_type_text(type),
                node.span.start
              )
              )
            }
          }
        }
      }
    }
  }
  mut type_checks: [BodyTypeCheckEvidence] = node.type_checks
  if context.retain_guard_conversions {
    index_accepted: Option[Bool] = if len(required.diagnostics) > 0 {
      Some(false)
    } else {
      if len(required.deferred) > 0 { None() } else { Some(true) }
    }
    type_checks = append(type_checks, BodyTypeCheckEvidence(
      "index receiver",
      node.children[0].span,
      node.children[0].type,
      "Str, Bytes or Array[T]",
      output,
      receiver_accepted
    ))
    type_checks = append(type_checks, BodyTypeCheckEvidence(
      "index position",
      node.children[1].span,
      node.children[1].type,
      "Nat",
      None(),
      index_accepted
    ))
  }
  BodyResult(
    BoundBody(node.node, node.span, node.children, output, node.constraints, node.guard_conversions, node.type_joins, node.callback_contracts, node.operator_checks, type_checks),
    diagnostics,
    deferred
  )
}

pure bind_body_string(
  context: BodyContext,
  expression: Expr,
  token: Str,
  span: SourceSpan,
  locals: Map[Str, BodyLocal]
): BodyResult {
  interpolation: InterpolatedString = split_interpolated_string(decode_string_literal(token))
  mut result: BodyResult = body_result(BodyLiteral(expression), span, [], body_core_type("Str"))

  if len(interpolation.variables) > 0 {
    mut children: [BoundBody] = []
    mut diagnostics: [Diagnostic] = []
    mut deferred: [SourceSpan] = []
    mut type_checks: [BodyTypeCheckEvidence] = []
    for name in interpolation.variables {
      if !locals.has(name) {
        diagnostics = append(
          diagnostics,
          Diagnostic("unknown interpolation local " + name, span.start)
        )
      } else {
        local: BodyLocal = locals.get(name)
        mut accepted: Option[Bool] = None()
        children = append(
          children,
          BoundBody(BodyLocalUse(local.identity), span, [], local.type, [], [], [], [], [], [])
        )
        match local.type {
          None() => {
            deferred = append(deferred, span)
          },
          Some(type) => {
            if body_guarded(context, type) {
              deferred = append(deferred, span)
            } else {
              scalar: Str = body_scalar(type)
              valid: Bool = scalar_numeric(scalar) ||
                scalar == "Str" ||
                scalar == "Bool" ||
                scalar == "Unit"
              accepted = Some(valid)
              if !valid {
                diagnostics = append(
                  diagnostics,
                  Diagnostic(
                  "interpolation requires a scalar local, got " + body_type_text(type),
                  span.start
                )
                )
              }
            }
          }
        }
        if context.retain_guard_conversions {
          type_checks = append(type_checks, BodyTypeCheckEvidence(
            "string interpolation",
            span,
            local.type,
            "scalar type (Nat, Int, Dec, Rat, Str, Bool or Unit)",
            None(),
            accepted
          ))
        }
      }
    }
    result = BodyResult(
      BoundBody(BodyInterpolation(interpolation.parts), span, children, body_core_type("Str"), [], [], [], [], [], type_checks),
      diagnostics,
      deferred
    )
  }

  result
}

// Inference holes describe absent expression evidence, not universally quantified
// parameters. They never enter declaration signatures or nominal identities.
pure body_is_hole(type: SignatureType): Bool {
  match type.identity {
    SignatureHole(owner, path, index) => true,
    SignatureCore(name) => false,
    SignatureNominal(identity) => false,
    SignatureParameter(owner, index) => false,
    SignatureCallable(effect) => false
  }
}

pure body_callable(type: SignatureType): Bool {
  match type.identity {
    SignatureCallable(effect) => true,
    SignatureHole(owner, path, index) => false,
    SignatureCore(name) => false,
    SignatureNominal(identity) => false,
    SignatureParameter(owner, index) => false
  }
}

pub pure body_type_complete(type: SignatureType): Bool {
  mut complete: Bool = !body_is_hole(type)

  for argument in type.arguments {
    complete = complete && body_type_complete(argument)
  }
  complete
}

pure body_type_holes_covered(
  type: SignatureType,
  constraints: [BodySolution]
): Bool {
  if body_is_hole(type) {
    mut covered: Bool = false
    for constraint in constraints {
      if constraint.hole == type.identity && body_type_complete(constraint.type) {
        covered = true
      }
    }
    covered
  } else {
    mut covered: Bool = true
    for argument in type.arguments {
      covered = covered && body_type_holes_covered(argument, constraints)
    }
    covered
  }
}

pure body_incomplete_local(name: Str, checked: BodyResult): [Diagnostic] {
  body: BoundBody = checked.body
  mut diagnostics: [Diagnostic] = []

  match body.type {
    None() => {},
    Some(type) => {
      if !body_type_complete(type) {
        if !body_type_holes_covered(type, body.constraints) {
          diagnostics = [Diagnostic(
            "cannot infer complete type for local " + name + "; add a type annotation",
            body.span.start
          )]
        }
      }
    }
  }

  diagnostics
}

pub record BodySolution {
  hole: SignatureTypeIdentity,
  type: SignatureType
}

pure body_solutions(actual: SignatureType, expected: SignatureType): [BodySolution] {
  mut solutions: [BodySolution] = []

  if body_is_hole(actual) {
    if actual != expected {
      solutions = [BodySolution(actual.identity, expected)]
    }
  } else {
    if actual.identity == expected.identity && len(actual.arguments) == len(expected.arguments) {
      mut index: Nat = 0
      for argument in actual.arguments {
        solutions = concat(solutions, body_solutions(argument, expected.arguments[index]))
        index = index + 1
      }
    }
  }
  solutions
}

pure body_solve_type(type: SignatureType, solutions: [BodySolution]): SignatureType {
  mut replacement: Option[SignatureType] = None()

  for solution in solutions {
    if solution.hole == type.identity {
      replacement = Some(solution.type)
    }
  }
  match replacement {
    Some(value) => body_solve_type(value, solutions),
    None() => {
      mut arguments: [SignatureType] = []
      for argument in type.arguments {
        arguments = append(arguments, body_solve_type(argument, solutions))
      }
      SignatureType(type.identity, arguments)
    }
  }
}

pure body_solve_optional(
  type: Option[SignatureType],
  solutions: [BodySolution]
): Option[SignatureType] {
  match type {
    None() => None(),
    Some(value) => Some(body_solve_type(value, solutions))
  }
}

pure body_solve(body: BoundBody, solutions: [BodySolution]): BoundBody {
  mut children: [BoundBody] = []

  for child in body.children {
    children = append(children, body_solve(child, solutions))
  }
  mut node: BodyNode = body.node
  match node {
    BodyCall(target, types, call_arguments) => {
      mut arguments: [SignatureType] = []
      for type in types {
        arguments = append(arguments, body_solve_type(type, solutions))
      }
      mut solved_arguments: [CallArgumentEvidence] = []
      for argument in call_arguments {
        solved_arguments = append(solved_arguments, CallArgumentEvidence(
          argument.label,
          argument.span,
          body_solve_optional(argument.actual, solutions),
          body_solve_type(argument.expected, solutions),
          argument.accepted
        ))
      }
      node = BodyCall(target, arguments, solved_arguments)
    },
    BodyBinding(local, type, mutable, inferred, type_evidence) => {
      solved_evidence: Option[BindingTypeEvidence] = match type_evidence {
        None() => None(),
        Some(evidence) => Some(BindingTypeEvidence(
          evidence.label,
          evidence.span,
          body_solve_optional(evidence.actual, solutions),
          body_solve_type(evidence.expected, solutions),
          evidence.accepted
        ))
      }
      node = BodyBinding(
        local,
        body_solve_optional(type, solutions),
        mutable,
        inferred,
        solved_evidence
      )
    },
    BodyLiteral(value) => {},
    BodyInterpolation(parts) => {},
    BodyLocalUse(local) => {},
    BodyFunction(binding) => {},
    BodyArray() => {},
    BodyUnary(operator) => {},
    BodyBinary(operator) => {},
    BodyField(name) => {},
    BodyIndex() => {},
    BodyIf(has_else) => {},
    BodyBlock(has_tail) => {},
    BodyMatch(targets, bindings, spans) => {},
    BodyAssignment(local, assignment_evidence) => {
      solved_assignment: Option[AssignmentTypeEvidence] = match assignment_evidence {
        None() => None(),
        Some(evidence) => Some(AssignmentTypeEvidence(
          evidence.label,
          evidence.span,
          body_solve_optional(evidence.actual, solutions),
          body_solve_optional(evidence.expected, solutions),
          evidence.accepted
        ))
      }
      node = BodyAssignment(local, solved_assignment)
    },
    BodyWhile() => {},
    BodyFor(local) => {},
    BodyEmpty() => {}
  }
  mut callback_contracts: [CollectionCallbackEvidence] = []
  for evidence in body.callback_contracts {
    mut expected_parameters: [SignatureType] = []
    for parameter in evidence.expected_parameters {
      expected_parameters = append(expected_parameters, body_solve_type(parameter, solutions))
    }
    callback_contracts = append(callback_contracts, CollectionCallbackEvidence(
      evidence.operation,
      evidence.span,
      body_solve_optional(evidence.callback, solutions),
      expected_parameters,
      body_solve_optional(evidence.result, solutions),
      body_solve_optional(evidence.expected_result, solutions),
      evidence.accepted
    ))
  }
    mut type_checks: [BodyTypeCheckEvidence] = []
    for evidence in body.type_checks {
      type_checks = append(type_checks, BodyTypeCheckEvidence(
        evidence.context,
        evidence.span,
        body_solve_optional(evidence.actual, solutions),
        evidence.expected,
        body_solve_optional(evidence.result, solutions),
        evidence.accepted
      ))
    }
    BoundBody(node, body.span, children, body_solve_optional(body.type, solutions), body.constraints, body.guard_conversions, body.type_joins, callback_contracts, body.operator_checks, type_checks)
}

pure body_refine(context: BodyContext, checked: BodyResult, expected: SignatureType): BodyResult {
  match body_guard_conversion(context, checked.body, expected) {
    Some(decision) => {
      mut with_evidence: BodyResult = checked
      if context.retain_guard_conversions {
        match decision.evidence {
          None() => {},
          Some(evidence) => {
            retained: BoundBody = BoundBody(
              checked.body.node,
              checked.body.span,
              checked.body.children,
              checked.body.type,
              checked.body.constraints,
              append(checked.body.guard_conversions, evidence),
              checked.body.type_joins,
              checked.body.callback_contracts,
              checked.body.operator_checks,
              checked.body.type_checks
            )
            with_evidence = BodyResult(retained, checked.diagnostics, checked.deferred)
          }
        }
      }
      match decision.proven {
        Some(proven) => if proven {
          with_evidence
        } else {
          match checked.body.type {
            None() => with_evidence,
            Some(actual) => body_apply_solutions(context, with_evidence, body_solutions(actual, expected))
          }
        },
        None() => match checked.body.type {
          None() => with_evidence,
          Some(actual) => body_apply_solutions(context, with_evidence, body_solutions(actual, expected))
        }
      }
    },
    None() => match checked.body.type {
      None() => checked,
      Some(actual) => body_apply_solutions(context, checked, body_solutions(actual, expected))
    }
  }
}

pure body_contains_hole(type: SignatureType, hole: SignatureTypeIdentity): Bool {
  mut found: Bool = type.identity == hole

  for argument in type.arguments {
    found = found || body_contains_hole(argument, hole)
  }

  found
}

record BodyUnification {
  type: SignatureType,
  solutions: [BodySolution],
  deferred: Bool
}

// Context imposes simultaneous constraints, unlike argument evidence widening.
// Resolve chains and reject recursive or incompatible uses of one expression hole.
pure body_unify(
  context: BodyContext,
  left: SignatureType,
  right: SignatureType,
  solutions: [BodySolution]
): Result[BodyUnification, Str] {
  a: SignatureType = body_solve_type(left, solutions)
  b: SignatureType = body_solve_type(right, solutions)
  mut merged: SignatureType = a
  mut resolved: [BodySolution] = solutions
  mut failure: Option[Str] = None()
  mut deferred: Bool = false

  if a != b {
    if body_is_hole(a) {
      if body_contains_hole(b, a.identity) {
        failure = Some("recursive inference evidence")
      } else {
        merged = b
        resolved = append(resolved, BodySolution(a.identity, b))
      }
    } else {
      if body_is_hole(b) {
        if body_contains_hole(a, b.identity) {
          failure = Some("recursive inference evidence")
        } else {
          resolved = append(resolved, BodySolution(b.identity, a))
        }
      } else {
        if a.identity == b.identity &&
          len(a.arguments) > 0 &&
          len(a.arguments) == len(b.arguments) &&
          !body_callable(a) {
          mut arguments: [SignatureType] = []
          mut index: Nat = 0
          for argument in a.arguments {
            match body_unify(context, argument, b.arguments[index], resolved) {
              Error(message) => {
                failure = Some(message)
              },
              Ok(result) => {
                arguments = append(arguments, result.type)
                resolved = result.solutions
                deferred = deferred || result.deferred
              }
            }
            index = index + 1
          }
          merged = SignatureType(a.identity, arguments)
        } else {
          match body_compatibility(context, a, b) {
            None() => {
              deferred = true
            },
            Some(forward) => {
              if !forward {
                match body_compatibility(context, b, a) {
                  None() => {
                    deferred = true
                  },
                  Some(backward) => {
                    if backward {
                      merged = b
                    } else {
                      failure = Some("incompatible inference constraints " + body_type_text(a) + " and " + body_type_text(b))
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
  if failure == None() {
    for source in [left, right] {
      if body_is_hole(source) && source != merged && !body_contains_hole(merged, source.identity) {
        resolved = append(resolved, BodySolution(source.identity, merged))
      }
    }
  }
  match failure {
    Some(message) => Error(message),
    None() => Ok(BodyUnification(merged, resolved, deferred))
  }
}

pure body_apply_solutions(
  context: BodyContext,
  checked: BodyResult,
  constraints: [BodySolution]
): BodyResult {
  mut solutions: [BodySolution] = []
  mut diagnostics: [Diagnostic] = checked.diagnostics
  mut deferred: [SourceSpan] = checked.deferred

  for constraint in constraints {
    match body_unify(context, SignatureType(constraint.hole, []), constraint.type, solutions) {
      Error(message) => {
        diagnostics = append(diagnostics, Diagnostic(message, checked.body.span.start))
      },
      Ok(result) => {
        solutions = result.solutions
        if result.deferred {
          deferred = append(deferred, checked.body.span)
        }
      }
    }
  }
  body: BoundBody = checked.body
  retained: BoundBody = BoundBody(
    body.node,
    body.span,
    body.children,
    body.type,
    concat(body.constraints, constraints),
    body.guard_conversions,
    body.type_joins,
    body.callback_contracts,
    body.operator_checks,
    body.type_checks
  )
  BodyResult(retained, diagnostics, deferred)
}

pure body_all_constraints(body: BoundBody): [BodySolution] {
  mut constraints: [BodySolution] = body.constraints

  for child in body.children {
    constraints = concat(constraints, body_all_constraints(child))
  }
  constraints
}

pure body_finish_constraints(context: BodyContext, checked: BodyResult): BodyResult {
  mut solutions: [BodySolution] = []
  mut diagnostics: [Diagnostic] = checked.diagnostics
  mut deferred: [SourceSpan] = checked.deferred

  for constraint in body_all_constraints(checked.body) {
    match body_unify(context, SignatureType(constraint.hole, []), constraint.type, solutions) {
      Error(message) => {
        diagnostics = append(diagnostics, Diagnostic(message, checked.body.span.start))
      },
      Ok(result) => {
        solutions = result.solutions
        if result.deferred {
          deferred = append(deferred, checked.body.span)
        }
      }
    }
  }
  BodyResult(body_solve(checked.body, solutions), diagnostics, deferred)
}

pure body_unresolved_spans(body: BoundBody): [SourceSpan] {
  mut spans: [SourceSpan] = []

  match body.type {
    None() => {},
    Some(type) => {
      if !body_type_complete(type) {
        spans = [body.span]
      }
    }
  }
  for child in body.children {
    spans = concat(spans, body_unresolved_spans(child))
  }
  spans
}

record BodyContract {
  owner: DeclarationIdentity,
  name: Str,
  parameters: [Str],
  inputs: [SignatureType],
  output: SignatureType,
  constructor: Bool
}

pub pure body_core_owner(name: Str): DeclarationIdentity {
  DeclarationIdentity(ModuleIdentity(ToolchainModulePackage(), "core.panack"), name)
}

pub pure body_core_function_name(name: Str): Str {
  if name == "$core_first" {
    "core_first"
  } else {
    if name == "$core_ends_with" {
      "core_ends_with"
    } else {
      if name == "$core_sort_by" {
        "core_sort_by"
      } else {
        ""
      }
    }
  }
}

pure body_signature_contract(signature: ModuleSignature, name: Str): BodyContract {
  owner: DeclarationIdentity = signature.binding.identity
  mut inputs: [SignatureType] = []
  mut output: SignatureType = SignatureType(SignatureCore("Void"), [])
  mut index: Nat = 0

  for slot in signature.slots {
    if index + 1 == len(signature.slots) {
      output = slot.type
    } else {
      inputs = append(inputs, slot.type)
    }
    index = index + 1
  }
  BodyContract(
    owner,
    name,
    signature.parameters,
    inputs,
    output,
    false
  )
}

pure body_core_constructor(name: Str): Option[BodyContract] {
  mut parent: Str = ""
  mut count: Nat = 0

  if name == "Some" || name == "None" {
    parent = "Option"
    count = 1
  }
  if name == "Ok" || name == "Error" {
    parent = "Result"
    count = 2
  }
  if name == "map" {
    parent = "Map"
    count = 2
  }
  if name == "set" {
    parent = "Set"
    count = 1
  }
  if parent == "" {
    None()
  } else {
    owner: DeclarationIdentity = body_core_owner(parent)
    mut arguments: [SignatureType] = []
    mut index: Nat = 0
    while index < count {
      arguments = append(arguments, SignatureType(SignatureParameter(owner, index), []))
      index = index + 1
    }
    mut inputs: [SignatureType] = []
    if name == "Some" || name == "Ok" {
      inputs = [arguments[0]]
    }
    if name == "Error" {
      inputs = [arguments[1]]
    }
    Some(BodyContract(owner, name, if count == 1 {
        ["T"]
      } else {
        if name == "map" {
          ["K", "V"]
        } else {
          ["T", "E"]
        }
      }, inputs, SignatureType(SignatureCore(parent), arguments), true))
  }
}

pure body_contract(context: BodyContext, target: BodyTarget): Result[Option[BodyContract], Str] {
  match target {
    BodyCore(name) => match body_core_constructor(name) {
      Some(contract) => Ok(Some(contract)),
      None() => {
        function_name: Str = body_core_function_name(name)
        if function_name == "" {
          Ok(None())
        } else {
          match body_signature(context.signatures, body_core_owner(function_name)) {
            None() => Ok(None()),
            Some(signature) => Ok(Some(body_signature_contract(
              signature,
              if function_name == "core_first" {
                "first"
              } else {
                if function_name == "core_ends_with" {
                  "ends_with"
                } else {
                  "sort_by"
                }
              }
            )))
          }
        }
      }
    },
    BodyDeclaration(binding) => {
      mut owner: DeclarationIdentity = binding.identity
      mut variant: Str = ""
      match binding.kind {
        ModuleVariant(parent) => {
          owner = DeclarationIdentity(owner.module, parent)
          variant = binding.identity.name
        },
        ModuleFunction() => {},
        ModuleRecord() => {},
        ModuleEnum() => {},
        ModuleGuardedType() => {}
      }
      if owner.module == ModuleIdentity(
        ToolchainModulePackage(),
        "core.panack"
      ) && (owner.name == "Option" || owner.name == "Result") && variant != "" {
        Ok(body_core_constructor(variant))
      } else {
        if binding.kind == ModuleGuardedType() {
          Ok(None())
        } else {
          match body_signature(context.signatures, owner) {
            None() => Error("call signature unavailable for " + owner.module.path + ":" + owner.name),
            Some(signature) => {
              mut arguments: [SignatureType] = []
              mut index: Nat = 0
              for parameter in signature.parameters {
                arguments = append(arguments, SignatureType(SignatureParameter(owner, index), []))
                index = index + 1
              }
              mut inputs: [SignatureType] = []
              mut output: SignatureType = SignatureType(SignatureNominal(owner), arguments)
              index = 0
              for slot in signature.slots {
                if binding.kind == ModuleFunction() {
                  if index + 1 == len(signature.slots) {
                    output = slot.type
                  } else {
                    inputs = append(inputs, slot.type)
                  }
                } else {
                  if variant == "" || starts_with_at(slot.name, variant + ":", 0) {
                    inputs = append(inputs, slot.type)
                  }
                }
                index = index + 1
              }
              Ok(Some(BodyContract(
                owner,
                binding.identity.name,
                signature.parameters,
                inputs,
                output,
                binding.kind != ModuleFunction()
              )))
            }
          }
        }
      }
    }
  }
}

record BodyInference {
  arguments: [SignatureType],
  deferred: Bool,
  type_joins: [TypeJoinEvidence],
  failure: Option[Str]
}

pure body_infer(
  context: BodyContext,
  template: SignatureType,
  actual: SignatureType,
  owner: DeclarationIdentity,
  arguments: [SignatureType],
  function_name: Str,
  parameter_names: [Str],
  span: SourceSpan
): BodyInference {
  mut result: [SignatureType] = arguments
  mut failure: Option[Str] = None()
  mut deferred: Bool = false
  mut type_joins: [TypeJoinEvidence] = []
  mut parameter: Option[Nat] = None()

  match template.identity {
    SignatureParameter(binder, index) => {
      if binder == owner {
        parameter = Some(index)
      }
    },
    SignatureCore(name) => {},
    SignatureNominal(identity) => {},
    SignatureCallable(effect) => {},
    SignatureHole(binder, path, index) => {}
  }
  match parameter {
    Some(index) => {
      if index >= len(result) {
        failure = Some("missing inference parameter")
      } else {
        previous: SignatureType = result[index]
        repeated: Bool = body_type_complete(previous)
        match body_join(context, result[index], actual) {
          Error(message) => {
            if context.retain_guard_conversions && repeated {
              parameter_name: Str = if index < len(parameter_names) { parameter_names[index] } else { "?" }
              type_joins = append(type_joins, TypeJoinEvidence(
                "generic parameter " + parameter_name + " for " + function_name,
                span,
                Some(previous),
                Some(actual),
                None(),
                Some(false)
              ))
            }
            failure = Some(message)
          },
          Ok(optional) => match optional {
            None() => {
              deferred = true
              if context.retain_guard_conversions && repeated {
                parameter_name: Str = if index < len(parameter_names) { parameter_names[index] } else { "?" }
                type_joins = append(type_joins, TypeJoinEvidence(
                  "generic parameter " + parameter_name + " for " + function_name,
                  span,
                  Some(previous),
                  Some(actual),
                  None(),
                  None()
                ))
              }
            },
            Some(type) => {
              if context.retain_guard_conversions && repeated {
                parameter_name: Str = if index < len(parameter_names) { parameter_names[index] } else { "?" }
                type_joins = append(type_joins, TypeJoinEvidence(
                  "generic parameter " + parameter_name + " for " + function_name,
                  span,
                  Some(previous),
                  Some(actual),
                  Some(type),
                  Some(true)
                ))
              }
              mut joined: [SignatureType] = []
              mut cursor: Nat = 0
              for argument in result {
                joined = append(joined, if cursor == index {
                    type
                  } else {
                    argument
                  })
                cursor = cursor + 1
              }
              result = joined
            }
          }
        }
      }
    },
    None() => {
      compatible_head: Bool = template.identity == actual.identity ||
        (template.identity == SignatureCallable(SignatureOrdinary()) &&
        actual.identity == SignatureCallable(SignaturePure()))
      if compatible_head && len(template.arguments) == len(actual.arguments) {
        mut index: Nat = 0
        for child in template.arguments {
          inferred: BodyInference = body_infer(
            context,
            child,
            actual.arguments[index],
            owner,
            result,
            function_name,
            parameter_names,
            span
          )
          type_joins = concat(type_joins, inferred.type_joins)
          match inferred.failure {
            Some(message) => {
              failure = Some(message)
            },
            None() => {
              result = inferred.arguments
              deferred = deferred || inferred.deferred
            }
          }
          index = index + 1
        }
      }
    }
  }
  BodyInference(result, deferred, type_joins, failure)
}

pure check_body_array(context: BodyContext, checked: BodyResult, path: [Nat]): BodyResult {
  mut diagnostics: [Diagnostic] = checked.diagnostics
  mut deferred: [SourceSpan] = body_child_obligations(checked)
  mut item: Option[SignatureType] = Some(SignatureType(SignatureHole(context.owner, path, 0), []))
  mut type_joins: [TypeJoinEvidence] = []
  mut type_checks: [BodyTypeCheckEvidence] = checked.body.type_checks
  mut seen_element: Bool = false

  for child in checked.body.children {
    previous_item: Option[SignatureType] = item
    if child.type == body_core_type("Void") {
      diagnostics = append(
        diagnostics,
        Diagnostic("Void is not an array element", child.span.start)
      )
      if context.retain_guard_conversions {
        type_checks = append(type_checks, BodyTypeCheckEvidence(
          "array element",
          child.span,
          child.type,
          "non-Void array element",
          None(),
          Some(false)
        ))
      }
    }
    match child.type {
      None() => {
        item = None()
        deferred = append(deferred, child.span)
        if context.retain_guard_conversions && seen_element {
          type_joins = append(type_joins, TypeJoinEvidence(
            "array element type",
            child.span,
            previous_item,
            None(),
            None(),
            None()
          ))
        }
      },
      Some(type) => match item {
        None() => {
          if context.retain_guard_conversions && seen_element {
            type_joins = append(type_joins, TypeJoinEvidence(
              "array element type", child.span, None(), Some(type), None(), None()
            ))
          }
        },
        Some(previous) => match body_join(context, previous, type) {
          Error(message) => {
            diagnostics = append(
              diagnostics,
              Diagnostic("array elements have " + message, child.span.start)
            )
            if context.retain_guard_conversions && !body_is_hole(previous) {
              type_joins = append(type_joins, TypeJoinEvidence(
                "array element type", child.span, Some(previous), Some(type), None(), Some(false)
              ))
            }
          },
          Ok(joined) => {
            item = joined
            if context.retain_guard_conversions && !body_is_hole(previous) {
              type_joins = append(type_joins, TypeJoinEvidence(
                "array element type",
                child.span,
                Some(previous),
                Some(type),
                joined,
                if joined == None() { None() } else { Some(true) }
              ))
            }
            if joined == None() {
              deferred = append(deferred, child.span)
            }
          }
        }
      }
    }
    seen_element = true
  }
  mut output: Option[SignatureType] = None()
  mut solutions: [BodySolution] = []
  match item {
    None() => {},
    Some(type) => {
      output = Some(SignatureType(SignatureCore("Array"), [type]))
      for child in checked.body.children {
        match child.type {
          None() => {},
          Some(actual) => {
            solutions = concat(solutions, body_solutions(actual, type))
          }
        }
      }
    }
  }
  body_apply_solutions(
    context,
    BodyResult(
    BoundBody(
    BodyArray(),
    checked.body.span,
    checked.body.children,
    output,
    checked.body.constraints,
    checked.body.guard_conversions,
    concat(checked.body.type_joins, type_joins),
    checked.body.callback_contracts,
    checked.body.operator_checks,
    type_checks
  ),
    diagnostics,
    deferred
  ),
    solutions
  )
}

pure check_body_field(context: BodyContext, checked: BodyResult, field: Str): BodyResult {
  mut diagnostics: [Diagnostic] = checked.diagnostics
  mut deferred: [SourceSpan] = body_child_obligations(checked)
  mut output: Option[SignatureType] = None()
  mut accepted: Option[Bool] = None()

  match checked.body.children[0].type {
    None() => {
      deferred = append(deferred, checked.body.span)
    },
    Some(type) => {
      mut record: Option[ModuleSignature] = None()
      match type.identity {
        SignatureNominal(owner) => {
          record = body_signature(context.signatures, owner)
        },
        SignatureCore(name) => {},
        SignatureParameter(owner, index) => {},
        SignatureCallable(effect) => {},
        SignatureHole(owner, path, index) => {}
      }
      match record {
        Some(signature) => {
          if signature.binding.kind != ModuleRecord() {
            accepted = Some(false)
            diagnostics = append(
              diagnostics,
              Diagnostic(
              "field access requires a record, got " + body_type_text(type),
              checked.body.span.start
            )
            )
          } else {
            mut found: Bool = false
            for slot in signature.slots {
              if slot.name == field {
                found = true
                match substitute_signature_type(
                  slot.type,
                  signature.binding.identity,
                  type.arguments
                ) {
                  Error(message) => {
                    accepted = Some(false)
                    diagnostics = append(diagnostics, Diagnostic(message, checked.body.span.start))
                  },
                  Ok(value) => {
                    output = Some(value)
                    accepted = Some(true)
                  }
                }
              }
            }
            if !found {
              accepted = Some(false)
              diagnostics = append(
                diagnostics,
                Diagnostic(
                "record " + body_type_text(type) + " has no field " + field,
                checked.body.span.start
              )
              )
            }
          }
        },
        None() => {
          if body_is_hole(type) {
            deferred = append(deferred, checked.body.span)
          } else {
            accepted = Some(false)
            diagnostics = append(
              diagnostics,
              Diagnostic(
              "field access requires a record, got " + body_type_text(type),
              checked.body.span.start
            )
            )
          }
        }
      }
    }
  }
  mut type_checks: [BodyTypeCheckEvidence] = checked.body.type_checks
  if context.retain_guard_conversions {
    type_checks = append(type_checks, BodyTypeCheckEvidence(
      "field access",
      checked.body.span,
      checked.body.children[0].type,
      "record with field " + field,
      output,
      accepted
    ))
  }
  BodyResult(
    BoundBody(
    checked.body.node,
    checked.body.span,
    checked.body.children,
    output,
    checked.body.constraints,
    checked.body.guard_conversions,
    checked.body.type_joins,
    checked.body.callback_contracts,
    checked.body.operator_checks,
    type_checks
  ),
    diagnostics,
    deferred
  )
}

pure body_variant_identity(target: BodyTarget): DeclarationIdentity {
  match target {
    BodyCore(name) => body_core_owner(name),
    BodyDeclaration(binding) => binding.identity
  }
}

pure body_enum_variants(context: BodyContext, type: SignatureType): Result[[BodyTarget], Str] {
  mut variants: [BodyTarget] = []
  mut known: Bool = false

  if type.identity == SignatureCore("Option") {
    known = true
    variants = [BodyCore("None"), BodyCore("Some")]
  }
  if type.identity == SignatureCore("Result") {
    known = true
    variants = [BodyCore("Ok"), BodyCore("Error")]
  }
  match type.identity {
    SignatureNominal(owner) => {
      match body_signature(context.signatures, owner) {
        None() => {},
        Some(signature) => {
          if signature.binding.kind == ModuleEnum() {
            known = true
            match binding_graph_module(context.graph, owner.module) {
              Error(message) => {},
              Ok(module) => {
                for binding in module.declarations {
                  if binding.kind == ModuleVariant(owner.name) {
                    variants = append(variants, BodyDeclaration(binding))
                  }
                }
              }
            }
          }
        }
      }
    },
    SignatureCore(name) => {},
    SignatureParameter(owner, index) => {},
    SignatureCallable(effect) => {},
    SignatureHole(owner, path, index) => {}
  }
  if known {
    Ok(variants)
  } else {
    Error("match requires an enum, got " + body_type_text(type))
  }
}

pure bind_body_match(
  context: BodyContext,
  subject: Expr,
  arms: [MatchArm],
  span: SourceSpan,
  locals: Map[Str, BodyLocal],
  path: [Nat]
): BodyResult {
  subject_result: BodyResult = bind_body_expression(context, subject, span, locals, append(path, 0))
  mut children: [BoundBody] = [subject_result.body]
  mut targets: [BodyTarget] = []
  mut bindings: [[BodyLocalIdentity]] = []
  mut pattern_spans: [SourceSpan] = []
  mut diagnostics: [Diagnostic] = subject_result.diagnostics
  mut deferred: [SourceSpan] = subject_result.deferred
  mut variants: [BodyTarget] = []
  mut variants_available: Bool = false
  mut type_checks: [BodyTypeCheckEvidence] = []

  match subject_result.body.type {
    None() => {
      deferred = append(deferred, span)
      if context.retain_guard_conversions {
        type_checks = append(type_checks, BodyTypeCheckEvidence(
          "match subject", subject_result.body.span, None(), "enum type", None(), None()
        ))
      }
    },
    Some(type) => match body_enum_variants(context, type) {
      Error(message) => {
        diagnostics = append(diagnostics, Diagnostic(message, subject_result.body.span.start))
        if context.retain_guard_conversions {
          type_checks = append(type_checks, BodyTypeCheckEvidence(
            "match subject", subject_result.body.span, Some(type), "enum type", None(), Some(false)
          ))
        }
      },
      Ok(values) => {
        variants = values
        variants_available = true
        if context.retain_guard_conversions {
          type_checks = append(type_checks, BodyTypeCheckEvidence(
            "match subject", subject_result.body.span, Some(type), "enum type", None(), Some(true)
          ))
        }
      }
    }
  }
  mut output: Option[SignatureType] = None()
  mut type_joins: [TypeJoinEvidence] = []
  mut first: Bool = true
  mut seen: [DeclarationIdentity] = []
  mut index: Nat = 1
  for arm in arms {
    pattern_position: SourcePos = arm.pattern.span.start
    mut payload: [SignatureType] = []
    mut payload_substitution_failed: Bool = false
    mut arm_locals: Map[Str, BodyLocal] = locals
    mut arm_bindings: [BodyLocalIdentity] = []
    mut payload_variant_name: Str = ""
    match body_target(context, arm.pattern.variant, false) {
      Error(message) => {
        diagnostics = append(diagnostics, Diagnostic(message, pattern_position))
      },
      Ok(target) => {
        targets = append(targets, target)
        pattern_spans = append(pattern_spans, arm.pattern.span)
        is_variant: Bool = match target {
          BodyCore(name) => name == "Some" || name == "None" || name == "Ok" || name == "Error",
          BodyDeclaration(binding) => match binding.kind {
            ModuleVariant(parent) => true,
            ModuleFunction() => false,
            ModuleRecord() => false,
            ModuleEnum() => false,
            ModuleGuardedType() => false
          }
        }
        if !is_variant {
          diagnostics = append(
            diagnostics,
            Diagnostic("pattern is not a variant: " + arm.pattern.variant, pattern_position)
          )
        }
        identity: DeclarationIdentity = body_variant_identity(target)
        payload_variant_name = identity.name
        mut found: Bool = false
        for variant in variants {
          if body_variant_identity(variant) == identity {
            found = true
          }
        }
        if context.retain_guard_conversions {
          expected: Str = match subject_result.body.type {
            None() => "variant of the matched enum",
            Some(type) => "variant of " + body_type_text(type)
          }
          accepted: Option[Bool] = match subject_result.body.type {
            None() => None(),
            Some(type) => Some(is_variant && found)
          }
          type_checks = append(type_checks, BodyTypeCheckEvidence(
            "match variant",
            arm.pattern.span,
            subject_result.body.type,
            expected,
            None(),
            accepted
          ))
        }
        if subject_result.body.type != None() && !found {
          diagnostics = append(
            diagnostics,
            Diagnostic(
            "pattern " + arm.pattern.variant + " is not a variant of the matched enum",
            pattern_position
          )
          )
        }
        for previous in seen {
          if previous == identity {
            diagnostics = append(
              diagnostics,
              Diagnostic("duplicate match arm " + arm.pattern.variant, pattern_position)
            )
          }
        }
        if context.retain_guard_conversions {
          mut unique: Bool = true
          for previous in seen {
            if previous == identity {
              unique = false
            }
          }
          type_checks = append(type_checks, BodyTypeCheckEvidence(
            "match arm uniqueness",
            arm.pattern.span,
            subject_result.body.type,
            "variant " + identity.name + " appears at most once in this match",
            None(),
            Some(unique)
          ))
        }
        seen = append(seen, identity)
        if is_variant {
          match body_contract(context, target) {
            Error(message) => {
              diagnostics = append(diagnostics, Diagnostic(message, pattern_position))
            },
            Ok(optional) => match optional {
              None() => {
                deferred = append(deferred, span)
              },
              Some(contract) => {
                if len(arm.pattern.bindings) != len(contract.inputs) {
                  count: Nat = len(contract.inputs)
                  diagnostics = append(
                    diagnostics,
                    Diagnostic(
                    "pattern " + arm.pattern.variant + " expects ${count} bindings",
                    pattern_position
                  )
                  )
                }
                if context.retain_guard_conversions {
                  expected_count: Nat = len(contract.inputs)
                  actual_count: Nat = len(arm.pattern.bindings)
                  type_checks = append(type_checks, BodyTypeCheckEvidence(
                    "match payload bindings",
                    arm.pattern.span,
                    subject_result.body.type,
                    "expected ${expected_count} binding(s) for variant " + identity.name +
                      "; found ${actual_count}",
                    None(),
                    Some(actual_count == expected_count)
                  ))
                }
                match subject_result.body.type {
                  None() => {},
                  Some(type) => {
                    if found {
                      for input in contract.inputs {
                        match substitute_signature_type(input, contract.owner, type.arguments) {
                          Error(message) => {
                            diagnostics = append(diagnostics, Diagnostic(message, pattern_position))
                            payload_substitution_failed = true
                          },
                          Ok(value) => {
                            payload = append(payload, value)
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
    mut binding_index: Nat = 0
    for name in arm.pattern.bindings {
      if arm_locals.has(name) {
        diagnostics = append(
          diagnostics,
          Diagnostic("pattern binding " + name + " shadows an existing binding", pattern_position)
        )
      }
      local: BodyLocalIdentity = BodyLocalIdentity(
        context.owner,
        concat(path, [index, 0, binding_index]),
        name
      )
      type: Option[SignatureType] = if binding_index < len(payload) {
        Some(payload[binding_index])
      } else {
        None()
      }
      if context.retain_guard_conversions && (
        type != None() || subject_result.body.type == None() || payload_substitution_failed
      ) {
        number: Nat = binding_index + 1
        accepted: Option[Bool] = if type != None() {
          Some(true)
        } else {
          if payload_substitution_failed { Some(false) } else { None() }
        }
        type_checks = append(type_checks, BodyTypeCheckEvidence(
          "match payload type",
          arm.pattern.span,
          subject_result.body.type,
          "binding ${name} receives payload ${number} of " + payload_variant_name,
          type,
          accepted
        ))
      }
      arm_bindings = append(arm_bindings, local)
      arm_locals = arm_locals.put(name, BodyLocal(local, type, false))
      binding_index = binding_index + 1
    }
    checked: BodyResult = bind_body_expression(
      context,
      arm.body,
      span,
      arm_locals,
      concat(path, [index, 1])
    )
    children = append(children, checked.body)
    bindings = append(bindings, arm_bindings)
    diagnostics = concat(diagnostics, checked.diagnostics)
    deferred = concat(deferred, checked.deferred)
    if first {
      output = checked.body.type;
      first = false
    } else {
      match output {
        None() => {
          if context.retain_guard_conversions {
            type_joins = append(type_joins, TypeJoinEvidence(
              "match result", checked.body.span, None(), checked.body.type, None(), None()
            ))
          }
        },
        Some(previous) => match checked.body.type {
          None() => {
            output = None()
            if context.retain_guard_conversions {
              type_joins = append(type_joins, TypeJoinEvidence(
                "match result", checked.body.span, Some(previous), None(), None(), None()
              ))
            }
          },
          Some(type) => match body_join(context, previous, type) {
            Error(message) => {
              diagnostics = append(
                diagnostics,
                Diagnostic("match arms have " + message, checked.body.span.start)
              )
              if context.retain_guard_conversions {
                type_joins = append(type_joins, TypeJoinEvidence(
                  "match result", checked.body.span, Some(previous), Some(type), None(), Some(false)
                ))
              }
            },
            Ok(joined) => {
              output = joined
              if context.retain_guard_conversions {
                type_joins = append(type_joins, TypeJoinEvidence(
                  "match result",
                  checked.body.span,
                  Some(previous),
                  Some(type),
                  joined,
                  if joined == None() { None() } else { Some(true) }
                ))
              }
            }
          }
        }
      }
    }
    index = index + 1
  }
  mut missing_variants: [Str] = []
  for variant in variants {
    mut found: Bool = false
    for identity in seen {
      if identity == body_variant_identity(variant) {
        found = true
      }
    }
    if !found {
      missing_variants = append(missing_variants, body_variant_identity(variant).name)
      diagnostics = append(
        diagnostics,
        Diagnostic(
        "non-exhaustive match; missing " + body_variant_identity(variant).name,
        span.start
      )
      )
    }
  }
  if context.retain_guard_conversions {
    mut expected_coverage: Str = "all variants of the matched enum are covered"
    match subject_result.body.type {
      None() => {},
      Some(type) => {
        expected_coverage = if variants_available {
          "all variants of " + body_type_text(type) + " are covered"
        } else {
          "all variants of an enum subject are covered"
        }
        if len(missing_variants) > 0 {
          expected_coverage = expected_coverage + "; missing "
          mut missing_index: Nat = 0
          for missing in missing_variants {
            if missing_index > 0 {
              expected_coverage = expected_coverage + ", "
            }
            expected_coverage = expected_coverage + missing
            missing_index = missing_index + 1
          }
        }
      }
    }
    type_checks = append(type_checks, BodyTypeCheckEvidence(
      "match exhaustiveness",
      span,
      subject_result.body.type,
      expected_coverage,
      None(),
      if !variants_available { None() } else { Some(len(missing_variants) == 0) }
    ))
  }
  if output == None() {
    deferred = append(deferred, span)
  }
  mut solutions: [BodySolution] = []
  match output {
    None() => {},
    Some(type) => {
      index = 0
      for child in children {
        if index > 0 {
          match child.type {
            None() => {},
            Some(actual) => {
              solutions = concat(solutions, body_solutions(actual, type))
            }
          }
        }
        index = index + 1
      }
    }
  }
  body: BoundBody = BoundBody(BodyMatch(targets, bindings, pattern_spans), span, children, output, [], [], type_joins, [], [], type_checks)
  body_apply_solutions(context, BodyResult(body, diagnostics, deferred), solutions)
}
