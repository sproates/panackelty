pub import project/src/compiler/types::{SourceSpan}
import project/src/compiler/module_bindings::{module_declaration_display}
pub import project/src/compiler/module_bindings::{DeclarationIdentity}
pub import project/src/compiler/module_bodies::{
  Diagnostic, LoadedModule, ModuleBindingGraph, ModuleSignature, BoundFunctionBody,
  BodyTarget, BodyCheckStatus, SignatureEffect
}
import project/src/compiler/module_bodies::{
  BodyCheckStatus.BodyIdentityChecked, BodyCheckStatus.BodyInvalid,
  BodyContext, BodyTarget.BodyCore, BodyTarget.BodyDeclaration,
  BodyNode, BodyNode.BodyArray, BodyNode.BodyAssignment, BodyNode.BodyBinary,
  BodyNode.BodyBinding, BodyNode.BodyBlock, BodyNode.BodyCall, BodyNode.BodyEmpty,
  BodyNode.BodyField, BodyNode.BodyFor, BodyNode.BodyFunction, BodyNode.BodyIf,
  BodyNode.BodyIndex, BodyNode.BodyInterpolation, BodyNode.BodyLiteral,
  BodyNode.BodyLocalUse, BodyNode.BodyMatch, BodyNode.BodyUnary, BodyNode.BodyWhile,
  BoundBody, body_signature, body_type_text,
  ModuleDeclarationKind.ModuleFunction,
  SignatureEffect.SignatureAsync, SignatureEffect.SignatureOrdinary,
  SignatureEffect.SignaturePure, SignatureTypeIdentity.SignatureCallable,
  SignatureTypeIdentity.SignatureCore, SignatureTypeIdentity.SignatureHole,
  SignatureTypeIdentity.SignatureNominal, SignatureTypeIdentity.SignatureParameter
}
pub import project/src/compiler/purity::{EffectEvidence}
import project/src/compiler/purity::{EffectDependency, CheckedEffects, combine_effects, is_impure_builtin}

// Check local call/await boundaries after names and callable types have been
// resolved to module identities. Infer only the closed local-resource permission
// for direct ordinary wrappers; other effect declarations remain explicit.
record ModuleEffectContext {
  body: BodyContext,
  function_name: Str,
  owner_file: Str,
  mode: Str,
  local_functions: Set[DeclarationIdentity],
  local_reasons: Map[DeclarationIdentity,[EffectDependency]]
}

pub record CheckedModuleEffects {
  diagnostics: [Diagnostic],
  evidence: [EffectEvidence],
  function_types: Map[Str, Bool]
}

pure module_effect_mode(effect: Option[SignatureEffect]): Str {
  match effect {
    None() => "ordinary",
    Some(value) => match value {
      SignaturePure() => "pure",
      SignatureOrdinary() => "ordinary",
      SignatureAsync() => "async"
    }
  }
}

pure module_async_builtin(name: Str): Bool {
  name == "http_connection_continue" ||
  name == "http_listen_ordinary" || name == "http_listen_contextual" || name == "http_close" || name == "http_destroy" ||
  name == "http_connection_invoke" ||
  name == "host_arguments_async" || name == "host_stdout_async" ||
    name == "host_stderr_async" || name == "host_exit_async" || name == "fs_read_beneath_async" || name == "fs_root_identity_async" || name == "async_fake_read" || name == "tcp_exchange" || name == "http_transport_exchange" || name == "tcp_serve" ||
    name == "tcp_service" || name == "tcp_serve_stream" || name == "tcp_server_read_chunk"
}

pure module_effect_for_target(
  context: BodyContext,
  target: BodyTarget
): Option[SignatureEffect] {
  match target {
    BodyDeclaration(binding) => match body_signature(context.signatures, binding.identity) {
      None() => if binding.kind == ModuleFunction() { None() } else { Some(SignaturePure()) },
      Some(signature) => match signature.effect {
        None() => if binding.kind == ModuleFunction() { None() } else { Some(SignaturePure()) },
        Some(effect) => Some(effect)
      }
    },
    BodyCore(name) => {
      if name == "$intrinsic_call" {
        None()
      } else {
        if module_async_builtin(name) {
          Some(SignatureAsync())
        } else {
          if is_impure_builtin(name) {
            Some(SignatureOrdinary())
          } else {
            Some(SignaturePure())
          }
        }
      }
    }
  }
}

pure module_effect_for_call(
  context: BodyContext,
  target: BodyTarget,
  expression: BoundBody
): Option[SignatureEffect] {
  match target {
    BodyCore(name) => if name == "$intrinsic_call" {
      if expression.children.len() == 0 {
        None()
      } else {
        match expression.children[0].type {
          None() => None(),
          Some(signature_type) => match signature_type.identity {
            SignatureCallable(callable_effect) => Some(callable_effect),
            SignatureCore(core_name) => None(),
            SignatureNominal(identity) => None(),
            SignatureParameter(owner, index) => None(),
            SignatureHole(owner, path, index) => None()
          }
        }
      }
    } else {
      module_effect_for_target(context, target)
    },
    BodyDeclaration(binding) => module_effect_for_target(context, target)
  }
}

pure module_call_effect_known(context: BodyContext, target: BodyTarget, expression: BoundBody): Bool {
  match target {
    BodyCore(name) => if name == "$intrinsic_call" {
      if expression.children.len() == 0 {
        false
      } else {
        match expression.children[0].type {
          None() => false,
          Some(signature_type) => match signature_type.identity {
            SignatureHole(owner, path, index) => false,
            SignatureCore(core_name) => true,
            SignatureNominal(identity) => true,
            SignatureParameter(owner, index) => true,
            SignatureCallable(effect) => true
          }
        }
      }
    } else { true },
    BodyDeclaration(binding) => match module_effect_for_target(context, target) {
      None() => false,
      Some(effect) => true
    }
  }
}

pure module_effect_target_name(target: BodyTarget): Str {
  match target {
    BodyDeclaration(binding) => binding.identity.module.path + ":" + module_declaration_display(binding),
    BodyCore(name) => if name == "$intrinsic_call" {
      "call"
    } else {
      name
    }
  }
}

pure module_effect_name(effect: SignatureEffect): Str {
  match effect {
    SignaturePure() => "pure",
    SignatureOrdinary() => "ordinary",
    SignatureAsync() => "async"
  }
}

// Local resource operations mutate owned shells but cannot block on host I/O.
// Infer only their direct wrappers, transitively through checked identities.
// Unknown/indirect calls and ordinary host services never acquire this permission.
pure module_local_primitive(name: Str): Bool {
  name == "http_body" || name == "http_body_size" || name == "http_body_append" ||
  name == "http_state_create" || name == "http_state_setup_error" ||
    name == "http_state_fail_setup" || name == "http_state_register" ||
    name == "http_writer_get_status" || name == "http_writer_get_headers" ||
    name == "http_writer_status" || name == "http_writer_headers" ||
    name == "http_writer_commit" || name == "http_writer_reject" ||
    name == "http_connection_writer" || name == "http_connection_routes" ||
    name == "http_connection_fallback" || name == "http_connection_admit"
}

pure module_local_target(target: BodyTarget, known: Set[DeclarationIdentity]): Bool {
  match target {
    BodyCore(name) => module_local_primitive(name),
    BodyDeclaration(binding) => known.has(binding.identity)
  }
}

record LocalEffectSummary { safe: Bool, local: Bool, dependencies: [EffectDependency] }
record LocalPermissions { allowed: Set[DeclarationIdentity], reasons: Map[DeclarationIdentity,[EffectDependency]] }

pure module_local_body(context: BodyContext, body: BoundBody, known: Set[DeclarationIdentity], retain: Bool): LocalEffectSummary {
  mut safe = true
  mut local = false
  mut dependencies: [EffectDependency] = []
  match body.node {
    BodyCall(target, types, arguments) => {
      local = module_local_target(target, known)
      if retain && local { dependencies = dependencies.append(EffectDependency(module_effect_target_name(target), body.span)) }
      safe = local || module_effect_for_call(context, target, body) == Some(SignaturePure())
      match target {
        BodyCore(name) => if name == "$intrinsic_call" { safe = false },
        BodyDeclaration(binding) => {}
      }
    },
    BodyLiteral(value) => {}, BodyInterpolation(parts) => {}, BodyLocalUse(identity, captured_domain) => {},
    BodyFunction(binding) => {}, BodyArray() => {}, BodyUnary(operator) => {},
    BodyBinary(operator) => {}, BodyField(field) => {}, BodyIndex() => {}, BodyIf(value) => {},
    BodyBlock(value, original_span, statement_spans) => {}, BodyMatch(targets, locals, spans) => {}, BodyBinding(identity, type, mutable, inferred, evidence) => {},
    BodyAssignment(identity, evidence) => {}, BodyWhile() => {}, BodyFor(identity) => {}, BodyEmpty() => {}
  }
  for child in body.children {
    summary = module_local_body(context, child, known, retain)
    if retain { dependencies = dependencies.concat(summary.dependencies) }
    safe = safe && summary.safe
    local = local || summary.local
  }
  LocalEffectSummary(safe, local, dependencies)
}

pure module_local_functions(graph: ModuleBindingGraph, modules: [LoadedModule],
    signatures: [ModuleSignature], functions: [BoundFunctionBody], retain: Bool): LocalPermissions {
  mut reasons: Map[DeclarationIdentity,[EffectDependency]] = map()
  mut known: Set[DeclarationIdentity] = set()
  mut changed = true
  while changed {
    changed = false
    for function in functions {
      identity = function.signature.binding.identity
      if function.status != BodyInvalid() && function.signature.effect == Some(SignatureOrdinary()) && !known.has(identity) {
        context = BodyContext(graph, modules, signatures, identity, function.signature.parameters, map(), false)
        summary = module_local_body(context, function.body, known, retain)
        if summary.safe && summary.local {
          if retain { reasons = reasons.put(identity, summary.dependencies) }
          known = known.add(identity)
          changed = true
        }
      }
    }
  }
  LocalPermissions(known, reasons)
}

pure module_effect_call(
  context: ModuleEffectContext, target: BodyTarget, expression: BoundBody,
  awaited: Bool, retain: Bool
): CheckedEffects {
  effect = module_effect_for_call(context.body, target, expression)
  known = if effect == None() && awaited {
    module_call_effect_known(context.body, target, expression)
  } else { false }
  module_effect_call_details(context, target, expression.span, effect, known, awaited, retain)
}

pure module_effect_call_details(
  context: ModuleEffectContext, target: BodyTarget, span: SourceSpan,
  effect: Option[SignatureEffect], known: Bool, awaited: Bool, retain: Bool
): CheckedEffects {
  mut diagnostics: [Diagnostic] = []
  mut evidence: [EffectEvidence] = []
  mut violations: [Str] = []
  target_name: Str = module_effect_target_name(target)
  display_name: Str = if target_name == "call" { "call" } else { target_name }

  match effect {
    None() => {
      if awaited && known {
        reason: Str = "await requires an async call"
        diagnostics = diagnostics.append(Diagnostic(reason, span.start))
        violations = violations.append(reason)
      }
      mut indirect_call: Bool = false
      match target {
        BodyCore(name) => { indirect_call = name == "$intrinsic_call" },
        BodyDeclaration(binding) => {}
      }
      if retain && indirect_call {
        evidence = evidence.append(EffectEvidence(
          context.function_name,
          Some(span),
          "call",
          context.mode,
          target_name,
          "indirect call; effect unavailable",
          "unavailable",
          awaited,
          violations, [], context.owner_file
        ))
      }
    },
    Some(target_effect) => {
      async_call: Bool = target_effect == SignatureAsync()
      impure: Bool = target_effect != SignaturePure()
      if awaited && !async_call {
        reason: Str = "await requires an async call"
        diagnostics = diagnostics.append(Diagnostic(reason, span.start))
        violations = violations.append(reason)
      }
      if async_call && !awaited {
        reason: Str = "async call requires await inside an async function"
        diagnostics = diagnostics.append(Diagnostic(reason, span.start))
        violations = violations.append(reason)
      }
      if context.mode == "pure" && impure {
        reason: Str = "pure function cannot call impure function ${display_name}"
        diagnostics = diagnostics.append(Diagnostic(reason, span.start))
        violations = violations.append(reason)
      }
      if context.mode == "async" && impure && !async_call && !module_local_target(target, context.local_functions) {
        reason: Str = "async function cannot call blocking function ${display_name}"
        diagnostics = diagnostics.append(Diagnostic(reason, span.start))
        violations = violations.append(reason)
      }
      if retain {
        allowed_local = context.mode == "async" && impure && !async_call && module_local_target(target, context.local_functions)
        mut supporting: [EffectDependency] = []
        if allowed_local {
          match target {
            BodyCore(name) => {},
            BodyDeclaration(binding) => if context.local_reasons.has(binding.identity) {
              supporting = context.local_reasons.get(binding.identity)
            }
          }
        }
        evidence = evidence.append(EffectEvidence(
          context.function_name,
          Some(span),
          "call",
          context.mode,
          target_name,
          if allowed_local { "local resource permission" } else if target_name == "call" { "callable type" } else { "checked declaration identity" },
          module_effect_name(target_effect),
          awaited,
          violations, supporting, context.owner_file
        ))
      }
    }
  }
  CheckedEffects(diagnostics, evidence)
}

pure module_effect_expression(
  context: ModuleEffectContext,
  expression: BoundBody,
  awaited: Bool,
  retain: Bool
): CheckedEffects {
  mut result: CheckedEffects = CheckedEffects([], [])
  mut children_walked: Bool = false
  match expression.node {
    BodyUnary(operator) => {
      if operator == "await" {
        mut violations: [Str] = []
        mut diagnostics: [Diagnostic] = []
        if context.mode != "async" {
          reason: Str = "await requires an async function"
          diagnostics = diagnostics.append(Diagnostic(reason, expression.span.start))
          violations = violations.append(reason)
        }
        mut invalid_await_operand: Bool = expression.children.len() == 0
        if expression.children.len() > 0 {
          match expression.children[0].node {
            BodyCall(target, types, call_arguments) => {},
            BodyLiteral(value) => { invalid_await_operand = true },
            BodyInterpolation(parts) => { invalid_await_operand = true },
            BodyLocalUse(identity, captured_domain) => { invalid_await_operand = true },
            BodyFunction(binding) => { invalid_await_operand = true },
            BodyArray() => { invalid_await_operand = true },
            BodyUnary(nested) => { invalid_await_operand = true },
            BodyBinary(nested) => { invalid_await_operand = true },
            BodyField(field) => { invalid_await_operand = true },
            BodyIndex() => { invalid_await_operand = true },
            BodyIf(has_else) => { invalid_await_operand = true },
            BodyBlock(has_value, original_span, statement_spans) => { invalid_await_operand = true },
            BodyMatch(targets, locals, spans) => { invalid_await_operand = true },
            BodyBinding(identity, type, mutable, inferred, type_evidence) => { invalid_await_operand = true },
            BodyAssignment(identity, assignment_evidence) => { invalid_await_operand = true },
            BodyWhile() => { invalid_await_operand = true },
            BodyFor(identity) => { invalid_await_operand = true },
            BodyEmpty() => { invalid_await_operand = true }
          }
        }
        if invalid_await_operand {
          reason: Str = "await requires an async call"
          diagnostics = diagnostics.append(Diagnostic(reason, expression.span.start))
          violations = violations.append(reason)
        }
        if retain {
          result = CheckedEffects(diagnostics, [EffectEvidence(
            context.function_name,
            Some(expression.span),
            "await",
            context.mode,
            "",
            "checked call boundary",
            "async",
            true,
            violations, [], context.owner_file
          )])
        } else {
          result = CheckedEffects(diagnostics, [])
        }
        if expression.children.len() > 0 {
          result = combine_effects(result, module_effect_expression(context, expression.children[0], true, retain))
        }
        children_walked = true
      } else {
        if expression.children.len() > 0 {
          result = module_effect_expression(context, expression.children[0], false, retain)
        }
        children_walked = true
      }
    },
    BodyCall(target, types, call_arguments) => {
      result = module_effect_call(context, target, expression, awaited, retain)
      for child in expression.children {
        result = combine_effects(result, module_effect_expression(context, child, false, retain))
      }
      children_walked = true
    },
    BodyBlock(has_value, original_span, statement_spans) => {
      mut statement_count: Nat = expression.children.len()
      if has_value {
        if statement_count > 0 {
          statement_count = statement_count - 1
        }
      }
      mut index: Nat = 0
      for child in expression.children {
        if index < statement_count {
          match child.node {
            BodyUnary(operator) => if operator == "await" {
              match child.type {
                None() => {},
                Some(type) => if type.identity != SignatureCore("Unit") {
                  reason: Str = "bind, match or return a non-Unit await result"
                  result = combine_effects(result, CheckedEffects(
                    [Diagnostic(reason, child.span.start)],
                    if retain { [EffectEvidence(
                      context.function_name,
                      Some(child.span),
                      "await result",
                      context.mode,
                      "",
                      "result type",
                      body_type_text(type),
                      true,
                      [reason], [], context.owner_file
                    )] } else { [] }
                  ))
                }
              }
            },
            BodyLiteral(value) => {}, BodyInterpolation(parts) => {}, BodyLocalUse(identity, captured_domain) => {},
            BodyFunction(binding) => {}, BodyCall(target, types, call_arguments) => {}, BodyArray() => {},
            BodyBinary(operator) => {}, BodyField(field) => {}, BodyIndex() => {}, BodyIf(value) => {},
            BodyBlock(value, nested_span, nested_statement_spans) => {}, BodyMatch(targets, locals, spans) => {}, BodyBinding(identity, type, mutable, inferred, type_evidence) => {},
            BodyAssignment(identity, assignment_evidence) => {}, BodyWhile() => {}, BodyFor(identity) => {}, BodyEmpty() => {}
          }
        }
        result = combine_effects(result, module_effect_expression(context, child, false, retain))
        index = index + 1
      }
      children_walked = true
    },
    BodyLiteral(value) => {}, BodyInterpolation(parts) => {}, BodyLocalUse(identity, captured_domain) => {},
    BodyFunction(binding) => {}, BodyArray() => {}, BodyBinary(operator) => {}, BodyField(field) => {},
    BodyIndex() => {}, BodyIf(value) => {}, BodyMatch(targets, locals, spans) => {},
    BodyBinding(identity, type, mutable, inferred, type_evidence) => {}, BodyAssignment(identity, assignment_evidence) => {},
    BodyWhile() => {}, BodyFor(identity) => {}, BodyEmpty() => {}
  }
  if !children_walked {
    for child in expression.children {
      result = combine_effects(result, module_effect_expression(context, child, false, retain))
    }
  }
  result
}

pub pure check_module_effects(
  graph: ModuleBindingGraph,
  modules: [LoadedModule],
  signatures: [ModuleSignature],
  functions: [BoundFunctionBody],
  retain: Bool
): CheckedModuleEffects {
  mut diagnostics: [Diagnostic] = []
  mut evidence: [EffectEvidence] = []
  mut function_types: Map[Str, Bool] = map()
  local_functions = module_local_functions(graph, modules, signatures, functions, retain)
  for function in functions {
    valid_body: Bool = function.status != BodyInvalid()
    function_types = function_types.put(function.signature.binding.identity.name,
      valid_body && function.status == BodyIdentityChecked())
    if valid_body {
      body_context: BodyContext = BodyContext(
        graph,
        modules,
        signatures,
        function.signature.binding.identity,
        function.signature.parameters,
        map(),
        false
      )
      context: ModuleEffectContext = ModuleEffectContext(
        body_context,
        function.signature.binding.identity.name,
        function.signature.binding.span.start.file,
        module_effect_mode(function.signature.effect),
        local_functions.allowed, local_functions.reasons
      )
      checked: CheckedEffects = module_effect_expression(context, function.body, false, retain)
      diagnostics = diagnostics.concat(checked.diagnostics)
      evidence = evidence.concat(checked.evidence)
    }
  }
  CheckedModuleEffects(diagnostics, evidence, function_types)
}

// Plain-mode cache facts retain call boundaries, not checked expression trees.
// Direct declaration effects and local-resource permissions are resolved again
// against the current project. Only indirect callable type facts are retained.
pub record EffectCallFact {
  target: BodyTarget,
  span: SourceSpan,
  indirect_effect: Option[SignatureEffect],
  indirect_known: Bool
}
pub enum EffectCheckFact {
  EffectCallCheck(EffectCallFact, Bool),
  EffectStaticCheck(Diagnostic)
}
pub record FunctionEffectFacts {
  identity: DeclarationIdentity,
  owner_file: Str,
  effect: Option[SignatureEffect],
  status: BodyCheckStatus,
  local_calls: [EffectCallFact],
  checks: [EffectCheckFact]
}

pure effect_call_fact(expression: BoundBody, target: BodyTarget): EffectCallFact {
  mut effect: Option[SignatureEffect] = None()
  mut known = false
  match target {
    BodyCore(name) => if name == "$intrinsic_call" && expression.children.len() > 0 {
      match expression.children[0].type {
        None() => {},
        Some(type) => match type.identity {
          SignatureCallable(callable_effect) => { effect = Some(callable_effect); known = true },
          SignatureHole(owner, path, index) => {},
          SignatureCore(core_name) => { known = true },
          SignatureNominal(identity) => { known = true },
          SignatureParameter(owner, index) => { known = true }
        }
      }
    },
    BodyDeclaration(binding) => {}
  }
  EffectCallFact(target, expression.span, effect, known)
}

pure effect_local_calls(body: BoundBody): [EffectCallFact] {
  mut calls: [EffectCallFact] = []
  match body.node {
    BodyCall(target, types, arguments) => { calls = calls.append(effect_call_fact(body, target)) },
    BodyLiteral(value) => {}, BodyInterpolation(parts) => {}, BodyLocalUse(identity, domain) => {},
    BodyFunction(binding) => {}, BodyArray() => {}, BodyUnary(ignored_unary) => {},
    BodyBinary(ignored_binary) => {}, BodyField(field) => {}, BodyIndex() => {}, BodyIf(value) => {},
    BodyBlock(value, ignored_span, ignored_spans) => {}, BodyMatch(targets, locals, ignored_match_spans) => {},
    BodyBinding(identity, type, mutable, inferred, evidence) => {}, BodyAssignment(identity, evidence) => {},
    BodyWhile() => {}, BodyFor(identity) => {}, BodyEmpty() => {}
  }
  for child in body.children { calls = calls.concat(effect_local_calls(child)) }
  calls
}

pure effect_check_facts(expression: BoundBody, mode: Str, awaited: Bool): [EffectCheckFact] {
  mut checks: [EffectCheckFact] = []
  mut walked = false
  match expression.node {
    BodyUnary(operator) => {
      if operator == "await" {
        if mode != "async" {
          checks = checks.append(EffectStaticCheck(Diagnostic("await requires an async function", expression.span.start)))
        }
        mut valid_operand = false
        if expression.children.len() > 0 {
          match expression.children[0].node {
            BodyCall(target, types, arguments) => { valid_operand = true },
            BodyLiteral(value) => {}, BodyInterpolation(parts) => {}, BodyLocalUse(identity, domain) => {},
            BodyFunction(binding) => {}, BodyArray() => {}, BodyUnary(ignored_unary) => {},
            BodyBinary(ignored_binary) => {}, BodyField(field) => {}, BodyIndex() => {}, BodyIf(value) => {},
            BodyBlock(value, ignored_span, ignored_spans) => {}, BodyMatch(targets, locals, ignored_match_spans) => {},
            BodyBinding(identity, type, mutable, inferred, evidence) => {}, BodyAssignment(identity, evidence) => {},
            BodyWhile() => {}, BodyFor(identity) => {}, BodyEmpty() => {}
          }
        }
        if !valid_operand {
          checks = checks.append(EffectStaticCheck(Diagnostic("await requires an async call", expression.span.start)))
        }
      }
      if expression.children.len() > 0 {
        checks = checks.concat(effect_check_facts(expression.children[0], mode, operator == "await"))
      }
      walked = true
    },
    BodyCall(target, types, arguments) => {
      checks = checks.append(EffectCallCheck(effect_call_fact(expression, target), awaited))
    },
    BodyBlock(has_value, span, spans) => {
      mut statements = expression.children.len()
      if has_value && statements > 0 { statements = statements - 1 }
      mut index: Nat = 0
      for child in expression.children {
        if index < statements {
          match child.node {
            BodyUnary(operator) => if operator == "await" {
              match child.type {
                None() => {},
                Some(type) => if type.identity != SignatureCore("Unit") {
                  checks = checks.append(EffectStaticCheck(Diagnostic("bind, match or return a non-Unit await result", child.span.start)))
                }
              }
            },
            BodyLiteral(value) => {}, BodyInterpolation(parts) => {}, BodyLocalUse(identity, domain) => {},
            BodyFunction(binding) => {}, BodyCall(target, types, arguments) => {}, BodyArray() => {},
            BodyBinary(ignored_binary) => {}, BodyField(field) => {}, BodyIndex() => {}, BodyIf(value) => {},
            BodyBlock(value, ignored_span, ignored_spans) => {}, BodyMatch(targets, locals, ignored_match_spans) => {},
            BodyBinding(identity, type, mutable, inferred, evidence) => {}, BodyAssignment(identity, evidence) => {},
            BodyWhile() => {}, BodyFor(identity) => {}, BodyEmpty() => {}
          }
        }
        checks = checks.concat(effect_check_facts(child, mode, false))
        index = index + 1
      }
      walked = true
    },
    BodyLiteral(value) => {}, BodyInterpolation(parts) => {}, BodyLocalUse(identity, domain) => {},
    BodyFunction(binding) => {}, BodyArray() => {}, BodyBinary(ignored_binary) => {}, BodyField(field) => {},
    BodyIndex() => {}, BodyIf(value) => {}, BodyMatch(targets, locals, ignored_match_spans) => {},
    BodyBinding(identity, type, mutable, inferred, evidence) => {}, BodyAssignment(identity, evidence) => {},
    BodyWhile() => {}, BodyFor(identity) => {}, BodyEmpty() => {}
  }
  if !walked {
    for child in expression.children { checks = checks.concat(effect_check_facts(child, mode, false)) }
  }
  checks
}

pub pure collect_function_effect_facts(functions: [BoundFunctionBody]): [FunctionEffectFacts] {
  mut result: [FunctionEffectFacts] = []
  for function in functions {
    valid = function.status != BodyInvalid()
    result = result.append(FunctionEffectFacts(
      function.signature.binding.identity, function.signature.binding.span.start.file,
      function.signature.effect, function.status,
      if valid { effect_local_calls(function.body) } else { [] },
      if valid { effect_check_facts(function.body, module_effect_mode(function.signature.effect), false) } else { [] }
    ))
  }
  result
}

pure effect_fact_effect(context: BodyContext, call: EffectCallFact): Option[SignatureEffect] {
  match call.target {
    BodyCore(name) => if name == "$intrinsic_call" { call.indirect_effect }
      else { module_effect_for_target(context, call.target) },
    BodyDeclaration(binding) => module_effect_for_target(context, call.target)
  }
}

pub pure check_function_effect_facts(
  graph: ModuleBindingGraph, modules: [LoadedModule], signatures: [ModuleSignature],
  functions: [FunctionEffectFacts]
): CheckedModuleEffects {
  mut known: Set[DeclarationIdentity] = set()
  mut changed = true
  while changed {
    changed = false
    for function in functions {
      if function.status != BodyInvalid() && function.effect == Some(SignatureOrdinary()) && !known.has(function.identity) {
        context = BodyContext(graph, modules, signatures, function.identity, [], map(), false)
        mut safe = true
        mut local = false
        for call in function.local_calls {
          allowed = module_local_target(call.target, known)
          local = local || allowed
          safe = safe && (allowed || effect_fact_effect(context, call) == Some(SignaturePure()))
          match call.target {
            BodyCore(name) => if name == "$intrinsic_call" { safe = false },
            BodyDeclaration(binding) => {}
          }
        }
        if safe && local { known = known.add(function.identity); changed = true }
      }
    }
  }
  mut diagnostics: [Diagnostic] = []
  mut function_types: Map[Str,Bool] = map()
  for function in functions {
    valid = function.status != BodyInvalid()
    function_types = function_types.put(function.identity.name, valid && function.status == BodyIdentityChecked())
    if valid {
      context = BodyContext(graph, modules, signatures, function.identity, [], map(), false)
      checking = ModuleEffectContext(context, function.identity.name, function.owner_file,
        module_effect_mode(function.effect), known, map())
      for check in function.checks {
        match check {
          EffectStaticCheck(diagnostic) => { diagnostics = diagnostics.append(diagnostic) },
          EffectCallCheck(call, awaited) => {
            effect = effect_fact_effect(context, call)
            effect_known = match call.target {
              BodyCore(name) => if name == "$intrinsic_call" { call.indirect_known } else { true },
              BodyDeclaration(binding) => effect != None()
            }
            checked = module_effect_call_details(checking, call.target, call.span, effect, effect_known, awaited, false)
            diagnostics = diagnostics.concat(checked.diagnostics)
          }
        }
      }
    }
  }
  CheckedModuleEffects(diagnostics, [], function_types)
}
