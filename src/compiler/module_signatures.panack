import project/src/compiler/owned_intrinsics::{owned_intrinsic_declarations}
import project/src/compiler/module_bindings::{builtin_owner_arity, builtin_owner_module}
pub import project/src/compiler/module_resolution::{ModuleBindingGraph, ResolvedModuleUses, ModuleIdentity, DeclarationIdentity, ModuleDeclarationBinding, ModuleDeclarationKind.ModuleFunction, ModuleDeclarationKind.ModuleGuardedType, ModuleDeclarationKind.ModuleRecord, ModuleDeclarationKind.ModuleEnum, ModuleDeclarationKind.ModuleVariant, ResolvedModuleTarget.DeclarationTarget, ResolvedModuleTarget.NamespaceTarget, binding_graph_module, binding_graph_target, module_identity_in, resolve_module_expression_uses, resolve_module_path_inner, resolve_module_type, module_import_names, module_reserved_binding}
pub import project/src/compiler/module_bindings::{LoadedModule, ModulePackageIdentity, ModulePackageIdentity.ToolchainModulePackage}
pub import project/src/compiler/parser::{TopLevel, TopLevel.ImportDeclaration, TopLevel.TypeDeclaration, TopLevel.RecordDeclaration, TopLevel.EnumDeclaration, TopLevel.FunctionDeclaration, DeclarationSyntax, RecordField, FunctionParameter, EnumVariant, SourceSpan, Diagnostic}
import project/src/compiler/checker::{TypeShape, is_scalar_base, type_shape}

// Check declaration signatures before binding bodies. Tagged nominal, parameter,
// callable and hole identities must never collapse into spelling-based equality.

// Semantic tags never encode nominal identity as an inference-placeholder name.
pub enum SignatureEffect {
  SignaturePure,
  SignatureOrdinary,
  SignatureAsync
}

pub enum SignatureTypeIdentity {
  SignatureCore(Str),
  SignatureNominal(DeclarationIdentity),
  SignatureParameter(DeclarationIdentity, Nat),
  SignatureCallable(SignatureEffect),
  // Body-local missing evidence; never a declaration name or a signature binder.
  SignatureHole(DeclarationIdentity, [Nat], Nat)
}

pub record SignatureType {
  identity: SignatureTypeIdentity,
  arguments: [SignatureType]
}

pub record SignatureSlot {
  name: Str,
  type: SignatureType
}

pub record ModuleSignature {
  binding: ModuleDeclarationBinding,
  parameters: [Str],
  slots: [SignatureSlot],
  effect: Option[SignatureEffect]
}

pub record CheckedModuleSignatures {
  declarations: [ModuleSignature],
  diagnostics: [Diagnostic]
}

pub pure signature_effect(is_pure: Bool, is_async: Bool): SignatureEffect {
  if is_async {
    SignatureAsync()
  } else {
    if is_pure {
      SignaturePure()
    } else {
      SignatureOrdinary()
    }
  }
}

pub pure signature_declaration(
  modules: [LoadedModule],
  identity: DeclarationIdentity
): Result[TopLevel, Str] {
  mut found: Option[TopLevel] = None()

  for module in modules {
    if module.bindings.identity == identity.module {
      if module.declaration_index->has(identity.name) {
        found = Some(module.declaration_index->get(identity.name))
      }
    }
  }
  match found {
    Some(declaration) => Ok(declaration),
    None() => Error("missing signature declaration " + identity.module.path + ":" + identity.name)
  }
}

// Reachability is by original identity, not the spelling chosen in a signature.
// Thus an explicit public re-export can expose an otherwise private import alias.
pub pure signature_public_identity(
  graph: ModuleBindingGraph,
  owner: ModuleIdentity,
  identity: DeclarationIdentity,
  visited: [ModuleIdentity]
): Bool {
  mut reachable: Bool = identity.module == ModuleIdentity(
    ToolchainModulePackage(),
    "core.panack"
  ) && (identity.name == "Option" || identity.name == "Result")

  if !reachable && !module_identity_in(visited, owner) {
    match binding_graph_module(graph, owner) {
      Error(message) => {},
      Ok(module) => {
        for binding in module.declarations {
          if binding.is_public && binding.identity == identity {
            reachable = true
          }
        }
        mut index: Nat = 0
        for imported in module.imports {
          if imported.is_public {
            match binding_graph_target(graph, owner, index) {
              Error(message) => {},
              Ok(target) => {
                for selector in module_import_names(imported) {
                  if selector.name == "" {
                    reachable = reachable || signature_public_identity(
                      graph,
                      target,
                      identity,
                      visited->append(owner)
                    )
                  } else {
                    match resolve_module_path_inner(graph, target, selector.name, true, []) {
                      Error(message) => {},
                      Ok(resolved) => match resolved {
                        DeclarationTarget(binding) => {
                          reachable = reachable || binding.identity == identity
                        },
                        NamespaceTarget(namespace) => {
                          reachable = reachable || signature_public_identity(
                            graph,
                            namespace,
                            identity,
                            visited->append(owner)
                          )
                        }
                      }
                    }
                  }
                }
              }
            }
          }
          index = index + 1
        }
      }
    }
  }
  // Exporting an enum exposes its qualified constructors, but exporting only
  // one constructor does not expose the parent enum type.
  if !reachable {
    match binding_graph_module(graph, identity.module) {
      Error(message) => {},
      Ok(origin) => {
        for declaration in origin.declarations {
          if declaration.identity == identity {
            match declaration.kind {
              ModuleVariant(parent) => {
                reachable = signature_public_identity(
                  graph,
                  owner,
                  DeclarationIdentity(identity.module, parent),
                  visited
                )
              },
              ModuleFunction() => {},
              ModuleGuardedType() => {},
              ModuleRecord() => {},
              ModuleEnum() => {}
            }
          }
        }
      }
    }
  }
  reachable
}

pub pure signature_type(
  graph: ModuleBindingGraph,
  modules: [LoadedModule],
  owner: DeclarationIdentity,
  parameters: [Str],
  spelling: Str,
  exported: Bool,
  allow_void: Bool
): Result[SignatureType, Str] {
  shape: TypeShape = type_shape(spelling)
  mut head: SignatureTypeIdentity = SignatureCore(shape.base)
  mut arity: Nat = 0
  mut known: Bool = false
  mut callable: Bool = false
  mut failure: Option[Str] = None()
  mut index: Nat = 0

  for parameter in parameters {
    if parameter == shape.base {
      known = true
      head = SignatureParameter(owner, index)
    }
    index = index + 1
  }
  if !known {
    known = is_scalar_base(shape.base) ||
      shape.base == "Bytes" ||
      shape.base == "Path" ||
      shape.base == "Duration" ||
      shape.base == "Instant"
    if shape.base == "Void" {
      known = true
      if !allow_void {
        failure = Some("Void is only valid as a function return type")
      }
    }
    if shape.base == "Array" || shape.base == "Set" || shape.base == "Option" {
      known = true
      arity = 1
    }
    if shape.base == "Map" || shape.base == "Result" {
      known = true
      arity = 2
    }
    if shape.base == "Fn" || shape.base == "PureFn" || shape.base == "AsyncFn" {
      known = true
      callable = true
      arity = shape.arguments->len()
      head = SignatureCallable(signature_effect(shape.base == "PureFn", shape.base == "AsyncFn"))
      if arity == 0 {
        failure = Some(shape.base + " expects at least a return type")
      }
    }
    if !known {
      match resolve_module_type(graph, owner.module, shape.base) {
        Error(message) => {
          failure = Some(message)
        },
        Ok(binding) => {
          head = SignatureNominal(binding.identity)
          implicit_core: Bool = binding.identity.module == ModuleIdentity(
            ToolchainModulePackage(),
            "core.panack"
          ) && (binding.identity.name == "Option" || binding.identity.name == "Result")
          if implicit_core {
            head = SignatureCore(binding.identity.name)
          }
          if exported && !implicit_core && !signature_public_identity(
            graph,
            owner.module,
            binding.identity,
            []
          ) {
            failure = Some("public signature exposes inaccessible type " + shape.base + " from " + binding.identity.module.path)
          }
          match signature_declaration(modules, binding.identity) {
            Error(message) => {
              failure = Some(message)
            },
            Ok(declaration) => match declaration {
              RecordDeclaration(name, types, fields) => {
                arity = types->len()
              },
              EnumDeclaration(name, types, variants) => {
                arity = types->len()
              },
              TypeDeclaration(name, base, guard) => {},
              ImportDeclaration(path) => {
                failure = Some("import is not a nominal type")
              },
              FunctionDeclaration(name, values, result, pure_flag, async_flag, body, types) => {
                failure = Some("function is not a nominal type")
              }
            }
          }
        }
      }
    }
  }
  if shape.arguments->len() != arity {
    failure = Some(shape.base + " has incorrect type argument count")
  }
  mut arguments: [SignatureType] = []
  index = 0
  for argument in shape.arguments {
    return_slot: Bool = callable && shape.base != "AsyncFn" && index + 1 == shape.arguments->len()
    match signature_type(graph, modules, owner, parameters, argument, exported, return_slot) {
      Error(message) => {
        if failure == None() {
          failure = Some(message)
        }
      },
      Ok(resolved) => {
        arguments = arguments->append(resolved)
      }
    }
    index = index + 1
  }
  match failure {
    Some(message) => Error(message),
    None() => Ok(SignatureType(head, arguments))
  }
}

// Substitution uses the binder's tagged identity, not another module's spelling.
pub pure substitute_signature_type(
  value: SignatureType,
  owner: DeclarationIdentity,
  arguments: [SignatureType]
): Result[SignatureType, Str] {
  mut replacement: Option[SignatureType] = None()
  mut failure: Option[Str] = None()

  match value.identity {
    SignatureParameter(binder, index) => {
      if binder == owner {
        if index < arguments->len() {
          replacement = Some(arguments[index])
        } else {
          failure = Some("missing signature substitution")
        }
      }
    },
    SignatureCore(name) => {},
    SignatureNominal(identity) => {},
    SignatureCallable(effect) => {},
    SignatureHole(binder, path, index) => {}
  }
  mut nested: [SignatureType] = []
  for child in value.arguments {
    match substitute_signature_type(child, owner, arguments) {
      Error(message) => {
        failure = Some(message)
      },
      Ok(resolved) => {
        nested = nested->append(resolved)
      }
    }
  }
  match failure {
    Some(message) => Error(message),
    None() => match replacement {
      Some(resolved) => Ok(resolved),
      None() => Ok(SignatureType(value.identity, nested))
    }
  }
}

pub pure check_module_signatures(
  graph: ModuleBindingGraph,
  modules: [LoadedModule],
  module: LoadedModule
): CheckedModuleSignatures {
  mut signatures: [ModuleSignature] = []
  mut diagnostics: [Diagnostic] = []
  mut declaration_index: Nat = 0

  // Validate every impl header, including empty blocks, against the complete
  // declaration set. The owner spelling is never used as its semantic identity.
  for implementation in module.parsed.implementations {
    shape: TypeShape = type_shape(implementation.owner)
    mut owner_arity: Option[Nat] = builtin_owner_arity(shape.base)
    builtin_owner: Bool = owner_arity != None()
    match signature_declaration(modules, DeclarationIdentity(module.bindings.identity, shape.base)) {
      Error(message) => {},
      Ok(owner_declaration) => match owner_declaration {
        RecordDeclaration(name, types, fields) => { owner_arity = Some(types->len()) },
        EnumDeclaration(name, types, variants) => { owner_arity = Some(types->len()) },
        TypeDeclaration(name, base, guard) => {},
        ImportDeclaration(path) => {},
        FunctionDeclaration(name, values, result, pure_flag, async_flag, body, types) => {}
      }
    }
    mut valid: Bool = (!builtin_owner || module.bindings.identity == builtin_owner_module()) &&
      owner_arity == Some(implementation.parameters->len()) &&
      shape.arguments->len() == implementation.parameters->len()
    mut binders: Set[Str] = set()
    for parameter in implementation.parameters {
      valid = valid && !binders->has(parameter) && !module_reserved_binding(parameter)
      binders = binders->add(parameter)
    }
    mut arguments: Set[Str] = set()
    for argument in shape.arguments {
      valid = valid && binders->has(argument) && !arguments->has(argument)
      arguments = arguments->add(argument)
    }
    if !valid {
      diagnostics = diagnostics->append(Diagnostic(
        if builtin_owner && module.bindings.identity != builtin_owner_module() {
          "built-in impl requires the designated toolchain core module: " + shape.base
        } else if builtin_owner {
          "built-in impl requires uniform type parameters: " + shape.base
        } else { "impl requires a local nominal owner with uniform type parameters: " + shape.base },
        implementation.span.start))
    }
  }

  for declaration in module.parsed.program.declarations {
    before: Nat = diagnostics->len()
    syntax: DeclarationSyntax = module.parsed.syntax[declaration_index]
    mut name: Str = ""
    mut parameters: [Str] = []
    mut fields: [RecordField] = []
    mut effect: Option[SignatureEffect] = None()
    mut result_void: Bool = false
    match declaration {
      ImportDeclaration(path) => {},
      TypeDeclaration(declared, base, guard) => {
        name = declared
        fields = [RecordField("base", base)]
        if syntax.is_public {
          uses: ResolvedModuleUses = resolve_module_expression_uses(
            graph,
            module.bindings.identity,
            guard,
            syntax.span,
            set()->add("value")
          )
          diagnostics = diagnostics->concat(uses.diagnostics)
          for reference in uses.references {
            match reference.target {
              NamespaceTarget(identity) => {},
              DeclarationTarget(binding) => {
                if !signature_public_identity(
                  graph,
                  module.bindings.identity,
                  binding.identity,
                  []
                ) {
                  diagnostics = diagnostics->append(
                    Diagnostic(
                    "public guard depends on inaccessible declaration " + reference.spelling + " from " + binding.identity.module.path,
                    reference.span.start
                  )
                  )
                }
              }
            }
          }
        }
      },
      RecordDeclaration(declared, types, members) => {
        name = declared
        parameters = types
        fields = members
      },
      EnumDeclaration(declared, types, variants) => {
        name = declared
        parameters = types
        for variant in variants {
          mut payload_index: Nat = 0
          for payload in variant.payload {
            fields = fields->append(RecordField(variant.name + ":${payload_index}", payload))
            payload_index = payload_index + 1
          }
        }
      },
      FunctionDeclaration(declared, values, result, pure_flag, async_flag, body, types) => {
        name = declared
        parameters = types
        effect = Some(signature_effect(pure_flag, async_flag))
        result_void = !async_flag
        for parameter in values {
          fields = fields->append(RecordField(parameter.name, parameter.type_name))
        }
        fields = fields->append(RecordField("return", result))
      }
    }
    if name != "" {
      owner: DeclarationIdentity = DeclarationIdentity(module.bindings.identity, name)
      mut seen: Set[Str] = set()
      mut valid: Bool = diagnostics->len() == before
      core_owner: Bool = owner.module == ModuleIdentity(ToolchainModulePackage(), "core.panack")
      if (module_reserved_binding(name) ||
        name == "Rat" ||
        name == "Array") &&
        !(core_owner &&
        (name == "Option" ||
        name == "Result")) {
        diagnostics = diagnostics->append(
          Diagnostic(
          "declaration " + name + " conflicts with a reserved core identity",
          syntax.span.start
        )
        )
        valid = false
      }
      match syntax.method {
        None() => {},
        Some(method) => {
          mut value_index: Nat = 0
          for field in fields {
            if value_index > 0 && field.name == "self" {
              diagnostics = diagnostics->append(Diagnostic(
                "owned method cannot declare an explicit self parameter", syntax.span.start))
              valid = false
            }
            value_index = value_index + 1
          }
        }
      }
      for parameter in parameters {
        if seen->has(parameter) ||
          module_reserved_binding(parameter) ||
          parameter == "Rat" ||
          parameter == "Array" {
          diagnostics = diagnostics->append(
            Diagnostic("invalid or duplicate type parameter " + parameter, syntax.span.start)
          )
          valid = false
        }
        seen = seen->add(parameter)
      }
      mut slots: [SignatureSlot] = []
      mut field_index: Nat = 0
      for field in fields {
        field_span: SourceSpan = if field_index < syntax.type_spans->len() {
          syntax.type_spans[field_index]
        } else {
          syntax.span
        }
        match signature_type(
          graph,
          modules,
          owner,
          parameters,
          field.type_name,
          syntax.is_public,
          field_index + 1 == fields->len() && result_void
        ) {
          Error(message) => {
            diagnostics = diagnostics->append(
              Diagnostic("signature " + (match syntax.method {
                None() => name,
                Some(method) => method.owner + "->" + method.name
              }) + "." + field.name + ": " + message, field_span.start)
            )
            valid = false
          },
          Ok(resolved) => {
            slots = slots->append(SignatureSlot(field.name, resolved))
          }
        }
        field_index = field_index + 1
      }
      if valid {
        for binding in module.bindings.declarations {
          if binding.identity == owner {
            signatures = signatures->append(ModuleSignature(binding, parameters, slots, effect))
          }
        }
      }
    }
    declaration_index = declaration_index + 1
  }
  // Synthetic declarations use the same canonical signature types and effects.
  if module.bindings.identity == builtin_owner_module() {
    for intrinsic in owned_intrinsic_declarations() {
      for binding in module.bindings.declarations {
        if binding.intrinsic == Some(intrinsic.id) {
          mut slots: [SignatureSlot] = []
          mut slot_index: Nat = 0
          for spelling in intrinsic.inputs->concat([intrinsic.output]) {
            match signature_type(graph, modules, binding.identity, intrinsic.parameters,
                spelling, true, false) {
              Error(message) => { diagnostics = diagnostics->append(Diagnostic(message, binding.span.start)) },
              Ok(type) => { slots = slots->append(SignatureSlot(
                if slot_index == intrinsic.inputs->len() { "return" }
                else if slot_index == 0 { "self" } else { "argument" }, type)) }
            }
            slot_index = slot_index + 1
          }
          signatures = signatures->append(ModuleSignature(binding, intrinsic.parameters,
            slots, Some(if intrinsic.owner == "AsyncFn" { SignatureAsync() }
              else if intrinsic.owner == "Fn" { SignatureOrdinary() }
              else { SignaturePure() })))
        }
      }
    }
  }
  CheckedModuleSignatures(signatures, diagnostics)
}
