pub import project/src/compiler/loader::{LoadedProject}
import project/src/compiler/loader::{loaded_package_binding_graph}
pub import project/src/compiler/package_project::{ManifestDependencyProject, FilesystemRootIdentity}
import project/src/compiler/module_emission::{ModuleBindingGraph, ModuleEmissionResult, module_emission_program}
pub import project/src/compiler/module_bindings::{ModuleIdentity}
pub import project/src/compiler/parser::{Program}
pub import project/src/compiler/types::{Diagnostic}

pub pure namespace_gate_diagnostic(diagnostic: Diagnostic): Bool {
  diagnostic.message == "namespace syntax is parsed but execution is not yet supported (language namespace migration pending)"
}

// Prepare the exact executable declaration set for compiler tooling. Namespace
// loading retains a temporary parser gate in diagnostics; the checked identity
// pipeline is authoritative for every project and emits one shared program for
// compile, inventory, coverage, and source-map commands.
pub pure prepare_project_program(
  project: LoadedProject,
  project_root: Str,
  stdlib_root: Str,
  entry: ModuleIdentity
): Result[Program, [Diagnostic]] {
  prepare_project_program_with_dependencies(
    project, project_root, stdlib_root, entry, false, FilesystemRootIdentity(0, 0), []
  )
}

pub pure prepare_project_program_with_dependencies(
  project: LoadedProject,
  project_root: Str,
  stdlib_root: Str,
  entry: ModuleIdentity,
  package_confined: Bool,
  package_root_identity: FilesystemRootIdentity,
  dependencies: [ManifestDependencyProject]
): Result[Program, [Diagnostic]] {
  mut diagnostics: [Diagnostic] = []
  for diagnostic in project.diagnostics {
    if !namespace_gate_diagnostic(diagnostic) {
      diagnostics = diagnostics.append(diagnostic)
    }
  }
  if len(diagnostics) > 0 {
    Error(diagnostics)
  } else {
    graph: ModuleBindingGraph = loaded_package_binding_graph(
      project.modules,
      project_root,
      stdlib_root,
      package_confined,
      package_root_identity,
      dependencies
    )
    emitted: ModuleEmissionResult = module_emission_program(
      graph,
      project.modules,
      project.module_signatures,
      project.module_bodies,
      entry
    )
    if len(emitted.diagnostics) > 0 {
      Error(emitted.diagnostics)
    } else {
      Ok(emitted.program)
    }
  }
}
