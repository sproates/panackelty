import "checker.panack"

pure is_impure_builtin(name: Str): Bool {
  name == "async_fake_read" || name == "fs_read" || name == "fs_write" || name == "fs_metadata" || name == "fs_list" || name == "fs_create_directory" || name == "fs_remove_file" || name == "fs_remove_directory" || name == "fs_temp_file" || name == "fs_temp_directory" || name == "host_sleep" || name == "process_run" ||
  name == "instant_now" || name == "print" || name == "read_line" || name == "read_file" ||
  name == "write_file" || name == "read_bytes" || name == "write_bytes" ||
  name == "command_args" || name == "environment_has" ||
  name == "environment_get" || name == "eprint" || name == "process_exit" ||
  name == "path_resolve" || name == "file_exists" || name == "run_bytecode" ||
  name == "run_bytecode_args"
}

pure check_expression_purity(expression: Expr, program: Program, environment: Map[Str,TypeInfo]): [Diagnostic] {
  check_expression_effects(expression, program, environment, false)
}

pure check_expression_effects(expression: Expr, program: Program, environment: Map[Str,TypeInfo], awaited: Bool): [Diagnostic] {
  mut diagnostics: [Diagnostic] = []
  mode: Str = if map_has(environment, "$effect") { map_get(environment, "$effect").name } else { "pure" }
  mut await_call: Bool = false
  match expression {
    LocatedExpr(position, value) => {
      await_call = true
      diagnostics = checker_diagnostics_at(check_expression_effects(value, program, environment, awaited), position)
    },
    NatExpr(value) => {},
    DecimalExpr(text) => {},
    StringExpr(text) => {},
    BoolExpr(value) => {},
    NameExpr(name) => {},
    FunctionExpr(name) => {},
    ArrayExpr(items) => {
      for item in items {
        diagnostics = concat(diagnostics, check_expression_purity(item, program, environment))
      }
    },
    UnaryExpr(operator, operand) => {
      if operator == "await" {
        if mode != "async" { diagnostics = append(diagnostics, checker_diagnostic("await requires an async function")); }
        diagnostics = concat(diagnostics, check_expression_effects(operand, program, environment, true))
      } else { diagnostics = check_expression_purity(operand, program, environment); }
    },
    BinaryExpr(operator, left, right) => {
      diagnostics = check_expression_purity(left, program, environment)
      diagnostics = concat(diagnostics, check_expression_purity(right, program, environment))
    },
    CallExpr(name, arguments, type_arguments) => {
      await_call = true
      function: FunctionLookup = function_type(program, name)
      mut async_call: Bool = name == "async_fake_read" || (function.found && function.is_async)
      mut impure: Bool = is_impure_builtin(name) || (function.found && !function.is_pure)
      if name == "$method_call" && len(arguments) > 0 {
        target: CheckedExpression = check_expression(arguments[0], environment, map(), program)
        effect: Str = type_shape(target.info.name).base
        async_call = effect == "AsyncFn"
        impure = effect != "PureFn"
      }
      display_name: Str = if name == "$method_call" { "call" } else { name }
      if awaited && !async_call {
        diagnostics = append(diagnostics, checker_diagnostic("await requires an async call"))
      }
      if async_call && (!awaited || mode != "async") {
        diagnostics = append(diagnostics, checker_diagnostic("async call requires await inside an async function"))
      }
      if mode == "pure" && impure {
        diagnostics = append(diagnostics, checker_diagnostic("pure function cannot call impure function ${display_name}"))
      }
      if mode == "async" && impure && !async_call {
        diagnostics = append(diagnostics, checker_diagnostic("async function cannot call blocking function ${display_name}"))
      }
      for argument in arguments {
        diagnostics = concat(diagnostics, check_expression_purity(argument, program, environment))
      }
    },
    FieldExpr(target, field) => {
      diagnostics = check_expression_purity(target, program, environment)
    },
    IndexExpr(target, index) => {
      diagnostics = check_expression_purity(target, program, environment)
      diagnostics = concat(diagnostics, check_expression_purity(index, program, environment))
    },
    IfExpr(condition, yes, no, has_else) => {
      diagnostics = check_expression_purity(condition, program, environment)
      diagnostics = concat(diagnostics, check_block_purity(yes, program, environment))
      diagnostics = concat(diagnostics, check_block_purity(no, program, environment))
    },
    BlockExpr(block) => {
      diagnostics = check_block_purity(block, program, environment)
    },
    MatchExpr(subject, arms) => {
      diagnostics = check_expression_purity(subject, program, environment)
      checked: CheckedExpression = check_expression(subject, environment, map(), program)
      shape: TypeShape = type_shape(checked.info.name)
      enum_value: EnumLookup = enum_type(program, shape.base)
      mut substitutions: Map[Str,Str] = map()
      mut index: Nat = 0
      while index < len(enum_value.parameters) && index < len(shape.arguments) {
        substitutions = map_put(substitutions, enum_value.parameters[index], shape.arguments[index])
        index = index + 1
      }
      for arm in arms {
        mut arm_environment: Map[Str,TypeInfo] = environment
        for variant in enum_value.variants {
          if variant.name == arm.pattern.variant {
            mut binding_index: Nat = 0
            for binding in arm.pattern.bindings {
              if binding_index < len(variant.payload) {
                binding_type: Str = substitute_type(variant.payload[binding_index], enum_value.parameters, substitutions)
                arm_environment = map_put(arm_environment, binding, plain_type(binding_type))
              }
              binding_index = binding_index + 1
            }
          }
        }
        diagnostics = concat(diagnostics, check_expression_purity(arm.body, program, arm_environment))
      }
    }
  }
  if awaited && !await_call { diagnostics = append(diagnostics, checker_diagnostic("await requires an async call")); }
  diagnostics
}

pure check_block_purity(block: Block, program: Program, parent: Map[Str,TypeInfo]): [Diagnostic] {
  mut diagnostics: [Diagnostic] = []
  mut environment: Map[Str,TypeInfo] = parent
  for statement in block.statements {
    match statement {
      BindingStatement(name, type_name, mutable, value) => {
        diagnostics = concat(diagnostics, check_expression_purity(value, program, environment))
        if len(type_name) > 0 {
          environment = map_put(environment, name, TypeInfo(type_name, false, 0, mutable))
        } else {
          checked: CheckedExpression = check_expression(value, environment, map(), program)
          environment = map_put(environment, name, local_binding_info(checked.info.name, checked.info, mutable))
        }
      },
      AssignmentStatement(name, value) => {
        diagnostics = concat(diagnostics, check_expression_purity(value, program, environment))
        if !map_has(environment, name) {
          checked: CheckedExpression = check_expression(value, environment, map(), program)
          environment = map_put(environment, name, local_binding_info(checked.info.name, checked.info, false))
        }
      },
      ExpressionStatement(value) => {
        if expression_is_await(value) {
          checked: CheckedExpression = check_expression(value, environment, map(), program)
          if checked.info.name != "Unit" {
            diagnostics = append(diagnostics, checker_diagnostic("bind, match or return a non-Unit await result"))
          }
        }
        diagnostics = concat(diagnostics, check_expression_purity(value, program, environment))
      },
      WhileStatement(condition, body) => {
        diagnostics = concat(diagnostics, check_expression_purity(condition, program, environment))
        diagnostics = concat(diagnostics, check_block_purity(body, program, environment))
      },
      ForStatement(name, iterable, body) => {
        diagnostics = concat(diagnostics, check_expression_purity(iterable, program, environment))
        checked: CheckedExpression = check_expression(iterable, environment, map(), program)
        shape: TypeShape = type_shape(checked.info.name)
        item: Str = if len(shape.arguments) > 0 { shape.arguments[0] } else { "Nat" }
        loop_environment: Map[Str,TypeInfo] = map_put(environment, name, plain_type(item))
        diagnostics = concat(diagnostics, check_block_purity(body, program, loop_environment))
      }
    }
  }
  match block.value {
    NoBlockValue() => {},
    TailBlockValue(value) => {
      diagnostics = concat(diagnostics, check_expression_purity(value, program, environment))
    }
  }
  diagnostics
}

pure check_program_purity(program: Program): [Diagnostic] {
  mut diagnostics: [Diagnostic] = []
  for declaration in program.declarations {
    match declaration {
      TypeDeclaration(name, base, guard) => {
        diagnostics = concat(diagnostics, check_expression_purity(guard, program, map()))
      },
      FunctionDeclaration(name, parameters, return_type, is_pure, is_async, body, type_parameters) => {
        mut environment: Map[Str,TypeInfo] = map()
        environment = map_put(environment, "$effect", plain_type(if is_async { "async" } else { if is_pure { "pure" } else { "ordinary" } }))
        for parameter in parameters {
          environment = map_put(environment, parameter.name, plain_type(parameter.type_name))
        }
        diagnostics = concat(diagnostics, check_block_purity(body, program, environment))
      },
      ImportDeclaration(path) => {},
      RecordDeclaration(name, parameters, fields) => {},
      EnumDeclaration(name, parameters, variants) => {}
    }
  }
  diagnostics
}

pure check_program_frontend(program: Program): [Diagnostic] {
  type_diagnostics: [Diagnostic] = check_program_types(program)
  if len(type_diagnostics) > 0 {
    type_diagnostics
  } else {
    check_program_purity(program)
  }
}

pure check_source_frontend(source: Str): Str {
  match lex(source) {
    Ok(tokens) => {
      match parse_program_complete(tokens) {
        Ok(program) => render_resolver_diagnostics(check_program_frontend(program)),
        Error(error) => error.message
      }
    },
    Error(errors) => "lexing failed"
  }
}

pure check_module_graph_frontend(units: [SourceUnit], entry: Str): [Diagnostic] {
  empty: Set[Str] = set()
  initial: ModuleGraphState = ModuleGraphState([], empty, empty, duplicate_module_diagnostics(units))
  graph: ModuleGraphState = visit_module(units, entry, initial)
  if len(graph.diagnostics) > 0 {
    graph.diagnostics
  } else {
    check_program_frontend(append_program_declarations(graph.programs))
  }
}

pure check_loaded_source_frontend(sources: [LoadedSource], entry: Str): Str {
  mut units: [SourceUnit] = []
  mut diagnostics: [Diagnostic] = []
  for source in sources {
    match lex_file(source.source, source.path) {
      Ok(tokens) => {
        match parse_program_complete(tokens) {
          Ok(program) => { units = append(units, SourceUnit(source.path, program)); },
          Error(error) => { diagnostics = append(diagnostics, error); }
        }
      },
      Error(errors) => {
        for error in errors {
          diagnostics = append(diagnostics, error)
        }
      }
    }
  }
  if len(diagnostics) > 0 {
    render_resolver_diagnostics(diagnostics)
  } else {
    render_resolver_diagnostics(check_module_graph_frontend(units, entry))
  }
}

pure expression_is_await(expression: Expr): Bool {
  mut result: Bool = false
  match expression {
    LocatedExpr(position, value) => { result = expression_is_await(value); },
    NatExpr(value) => {}, DecimalExpr(text) => {}, StringExpr(text) => {}, BoolExpr(value) => {},
    NameExpr(name) => {}, FunctionExpr(name) => {}, ArrayExpr(items) => {},
    UnaryExpr(operator, operand) => { result = operator == "await"; }, BinaryExpr(operator, left, right) => {},
    CallExpr(name, arguments, type_arguments) => {}, FieldExpr(target, field) => {}, IndexExpr(target, index) => {},
    IfExpr(condition, yes, no, has_else) => {}, BlockExpr(block) => {}, MatchExpr(subject, arms) => {}
  }
  result
}
