pub import project/src/compiler/parser::{indexed_program, parse_program_complete, lex, Expr, TopLevel, FunctionParameter, Program, Block, SourcePos, Diagnostic, Expr.LocatedExpr, Expr.NatExpr, Expr.DecimalExpr, Expr.StringExpr, Expr.BoolExpr, Expr.NameExpr, Expr.FunctionExpr, Expr.ArrayExpr, Expr.UnaryExpr, Expr.BinaryExpr, Expr.CallExpr, Expr.DotCallExpr, Expr.OwnedCallExpr, Expr.FieldExpr, Expr.IndexExpr, Expr.IfExpr, Expr.BlockExpr, Expr.MatchExpr, TopLevel.ImportDeclaration, TopLevel.TypeDeclaration, TopLevel.RecordDeclaration, TopLevel.EnumDeclaration, TopLevel.FunctionDeclaration, Statement.BindingStatement, Statement.AssignmentStatement, Statement.ExpressionStatement, Statement.WhileStatement, Statement.ForStatement, BlockValue.NoBlockValue, BlockValue.TailBlockValue}
import project/src/compiler/lexer::{lex_file}
import project/src/compiler/types::{diagnostic_text}

// Resolve names in the executable frontend and preserve ordered module diagnostics.
// Builtin names and local bindings remain distinct from declaration indexes.

pub record ResolverSymbols {
  declarations: Set[Str],
  callables: Set[Str],
  variants: Set[Str],
  diagnostics: [Diagnostic]
}

pub record SourceUnit {
  path: Str,
  program: Program
}

pub record LoadedSource {
  path: Str,
  source: Str
}

pub record ModuleGraphState {
  programs: [Program],
  visiting: Set[Str],
  visited: Set[Str],
  diagnostics: [Diagnostic]
}

pure resolver_diagnostic(message: Str): Diagnostic {
  Diagnostic(message, SourcePos("", 0, 1, 1))
}

pure resolver_diagnostics_at(diagnostics: [Diagnostic], position: SourcePos): [Diagnostic] {
  mut result: [Diagnostic] = []

  for diagnostic in diagnostics {
    selected: SourcePos = if diagnostic.position.file.len() == 0 {
      position
    } else {
      diagnostic.position
    }
    result = result.append(Diagnostic(diagnostic.message, selected))
  }

  result
}

// Source-visible constructors and explicit core services. Receiver operations are owned.
pub pure source_builtin(name: Str): Bool {
  name == "$unit" || name == "bytes" || name == "map" || name == "print" || name == "read_line" || name == "set" || name == "write_file"
}

// Internal operations accepted only after checked declaration lowering.
pub pure is_builtin(name: Str): Bool {
  name == "async_fake_read" || name == "tcp_exchange" || name == "http_transport_exchange" || name == "tcp_serve" ||
    name == "tcp_service" || name == "tcp_serve_stream" || name == "tcp_server_read_chunk" ||
    (name == "fs_read_beneath" || name == "host_arguments_async" || name == "host_stdout_async" ||
    name == "host_stderr_async" || name == "host_exit_async" || name == "fs_read_beneath_async" || name == "fs_root_identity_async") || name == "fs_directories_overlap" || name == "fs_read" ||
    name == "fs_write" ||
    name == "fs_metadata" ||
    name == "fs_list" ||
    name == "fs_create_directory" ||
    name == "fs_remove_file" ||
    name == "fs_remove_directory" ||
    name == "fs_temp_file" ||
    name == "fs_temp_directory" ||
    name == "host_decode_utf8" ||
    name == "host_sleep" ||
    name == "process_run" ||
    name == "path_from_text" || name == "path_from_native" || name == "path_to_text" ||
    name == "path_native_bytes" || name == "path_display" || name == "path_absolute" ||
    name == "path_append" || name == "path_directory" || name == "path_filename" ||
    name == "path_current" || name == "duration_nanoseconds" || name == "duration_ticks" ||
    name == "duration_from_seconds" || name == "instant_now" || name == "instant_add" ||
    name == "instant_difference" || name == "instant_before" ||
    name == "$unit" || name == "nat" || name == "dec" || name == "quotient" ||
    name == "print" || name == "read_line" || name == "read_file" ||
    name == "write_file" || name == "len" || name == "append" ||
    name == "concat" || name == "slice" || name == "starts_with" ||
    name == "starts_with_at" || name == "reverse" || name == "is_digit" || name == "is_letter" ||
    name == "is_whitespace" || name == "map" || name == "map_put" ||
    name == "map_has" || name == "map_get" ||
      name == "set" ||
    name == "set_add" || name == "set_has" ||
    name == "$intrinsic_call" ||
    name == "$intrinsic_map" ||
    name == "$intrinsic_reduce" ||
    name == "bytes" ||
    name == "byte_append" || name == "bytes_concat" || name == "byte_len" ||
    name == "byte_get" || name == "utf8_encode" || name == "utf8_decode" ||
    name == "read_bytes" || name == "write_bytes" || name == "nat_from_str" ||
    name == "command_args" || name == "environment_has" ||
    name == "environment_get" || name == "eprint" || name == "process_exit" ||
    name == "path_resolve" || name == "path_parent" || name == "path_join" ||
    name == "path_suffix" || name == "path_with_suffix" ||
    name == "path_is_absolute" || name == "file_exists" || name == "run_bytecode" ||
    name == "run_bytecode_args"
}

pure add_variant_symbol(symbols: ResolverSymbols, name: Str, position: SourcePos): ResolverSymbols {
  mut diagnostics: [Diagnostic] = symbols.diagnostics

  if name == "Path" || name == "Duration" || name == "Instant" || is_builtin(name) {
    diagnostics = diagnostics.append(
      Diagnostic("variant constructor ${name} conflicts with a built-in", position)
    )
  } else {
  }
  if symbols.variants.has(name) {
    diagnostics = diagnostics.append(
      Diagnostic("variant constructor ${name} is declared by more than one enum", position)
    )
  } else {
  }
  ResolverSymbols(
    symbols.declarations,
    symbols.callables.add(name),
    symbols.variants.add(name),
    diagnostics
  )
}

pure collect_variants(program: Program, positions: [SourcePos]): ResolverSymbols {
  declarations: Set[Str] = set()
  callables: Set[Str] = set()
  variants: Set[Str] = set()
  diagnostics: [Diagnostic] = []
  mut symbols: ResolverSymbols = ResolverSymbols(declarations, callables, variants, diagnostics)
  mut index: Nat = 0

  for declaration in program.declarations {
    position: SourcePos = declaration_position(positions, index)
    match declaration {
      ImportDeclaration(path) => {},
      TypeDeclaration(name, base, guard) => {},
      RecordDeclaration(name, parameters, fields) => {},
      EnumDeclaration(name, parameters, declared_variants) => {
        for variant in declared_variants {
          symbols = add_variant_symbol(symbols, variant.name, position)
        }
      },
      FunctionDeclaration(name, parameters, return_type, is_pure, is_async, body, type_parameters) => {}
    }
    index = index + 1
  }
  symbols
}

pure add_top_level_symbol(
  symbols: ResolverSymbols,
  name: Str,
  callable: Bool,
  position: SourcePos
): ResolverSymbols {
  mut diagnostics: [Diagnostic] = symbols.diagnostics

  if symbols.declarations.has(name) {
    diagnostics = diagnostics.append(
      Diagnostic("top-level name ${name} is already declared", position)
    )
  } else {
  }
  if name == "Path" || name == "Duration" || name == "Instant" || is_builtin(name) || symbols.variants.has(
    name
  ) {
    diagnostics = diagnostics.append(
      Diagnostic("top-level name ${name} conflicts with a constructor or built-in", position)
    )
  } else {
  }
  next_callables: Set[Str] = if callable {
    symbols.callables.add(name)
  } else {
    symbols.callables
  }
  ResolverSymbols(
    symbols.declarations.add(name),
    next_callables,
    symbols.variants,
    diagnostics
  )
}

pure collect_symbols_at(program: Program, positions: [SourcePos]): ResolverSymbols {
  mut symbols: ResolverSymbols = collect_variants(program, positions)
  mut index: Nat = 0

  for declaration in program.declarations {
    position: SourcePos = declaration_position(positions, index)
    match declaration {
      ImportDeclaration(path) => {},
      TypeDeclaration(name, base, guard) => {
        symbols = add_top_level_symbol(symbols, name, false, position)
      },
      RecordDeclaration(name, parameters, fields) => {
        symbols = add_top_level_symbol(symbols, name, true, position)
      },
      EnumDeclaration(name, parameters, variants) => {
        symbols = add_top_level_symbol(symbols, name, false, position)
      },
      FunctionDeclaration(name, parameters, return_type, is_pure, is_async, body, type_parameters) => {
        symbols = add_top_level_symbol(symbols, name, true, position)
      }
    }
    index = index + 1
  }
  symbols
}

pure collect_symbols(program: Program): ResolverSymbols {
  collect_symbols_at(program, [])
}

pub pure collect_symbol_diagnostics(program: Program): [Diagnostic] {
  collect_symbols(program).diagnostics
}

// Synthetic AST callers have no declaration positions. Production loading
// supplies positions in declaration order before any flattening occurs.
pure declaration_position(positions: [SourcePos], index: Nat): SourcePos {
  if index < positions.len() {
    positions[index]
  } else {
    SourcePos("", 0, 1, 1)
  }
}

pub pure append_program_declarations(programs: [Program]): Program {
  mut declarations: [TopLevel] = []

  for program in programs {
    for declaration in program.declarations {
      declarations = declarations.append(declaration)
    }
  }
  indexed_program(declarations)
}

pub pure visit_module(units: [SourceUnit], path: Str, state: ModuleGraphState): ModuleGraphState {
  if state.visited.has(path) {
    state
  } else {
    if state.visiting.has(path) {
      diagnostics: [Diagnostic] = state.diagnostics.append(
        resolver_diagnostic("import cycle includes ${path}")
      )
      ModuleGraphState(state.programs, state.visiting, state.visited, diagnostics)
    } else {
      mut found: Bool = false
      mut selected: Program = indexed_program([])
      for unit in units {
        if unit.path == path {
          if found {
          } else {
            found = true
            selected = unit.program
          }
        } else {
        }
      }
      if !found {
        diagnostics: [Diagnostic] = state.diagnostics.append(
          resolver_diagnostic("module ${path} is not loaded")
        )
        ModuleGraphState(state.programs, state.visiting, state.visited, diagnostics)
      } else {
        active: Set[Str] = state.visiting.add(path)
        mut current: ModuleGraphState = ModuleGraphState(
          state.programs,
          active,
          state.visited,
          state.diagnostics
        )
        for declaration in selected.declarations {
          match declaration {
            ImportDeclaration(imported) => {
              current = visit_module(units, imported, current)
            },
            TypeDeclaration(name, base, guard) => {},
            RecordDeclaration(name, parameters, fields) => {},
            EnumDeclaration(name, parameters, variants) => {},
            FunctionDeclaration(name, parameters, return_type, is_pure, is_async, body, type_parameters) => {}
          }
        }
        ModuleGraphState(
          current.programs.append(selected),
          state.visiting,
          current.visited.add(path),
          current.diagnostics
        )
      }
    }
  }
}

pub pure duplicate_module_diagnostics(units: [SourceUnit]): [Diagnostic] {
  paths: Set[Str] = set()
  mut seen: Set[Str] = paths
  mut diagnostics: [Diagnostic] = []

  for unit in units {
    if seen.has(unit.path) {
      path: Str = unit.path
      diagnostics = diagnostics.append(
        resolver_diagnostic("module ${path} is loaded more than once")
      )
    } else {
    }
    seen = seen.add(unit.path)
  }

  diagnostics
}

pure resolve_module_graph(units: [SourceUnit], entry: Str): [Diagnostic] {
  empty: Set[Str] = set()
  initial: ModuleGraphState = ModuleGraphState(
    [],
    empty,
    empty,
    duplicate_module_diagnostics(units)
  )
  graph: ModuleGraphState = visit_module(units, entry, initial)
  program: Program = append_program_declarations(graph.programs)
  graph.diagnostics.concat(resolve_program(program))
}

pure resolve_expression(expression: Expr, scope: Set[Str], symbols: ResolverSymbols): [Diagnostic] {
  mut diagnostics: [Diagnostic] = []

  match expression {
    LocatedExpr(position, value, located_type_argument_spans) => {
      diagnostics = resolver_diagnostics_at(
        resolve_expression(value, scope, symbols),
        position.start
      )
    },
    NatExpr(value) => {},
    DecimalExpr(text) => {},
    StringExpr(text) => {},
    BoolExpr(value) => {},
    NameExpr(name) => {
      if !scope.has(name) {
        diagnostics = diagnostics.append(resolver_diagnostic("unknown name ${name}"))
      } else {
      }
    },
    FunctionExpr(name) => {
      if !symbols.callables.has(name) {
        diagnostics = diagnostics.append(resolver_diagnostic("unknown function ${name}"))
      } else {}
    },
    ArrayExpr(items) => {
      for item in items {
        diagnostics = diagnostics.concat(resolve_expression(item, scope, symbols))
      }
    },
    UnaryExpr(operator, operand) => {
      diagnostics = resolve_expression(operand, scope, symbols)
    },
    BinaryExpr(operator, left, right) => {
      diagnostics = resolve_expression(left, scope, symbols)
      diagnostics = diagnostics.concat(resolve_expression(right, scope, symbols))
    },
    OwnedCallExpr(target, name, arguments, types) => {
      diagnostics = diagnostics.append(
        resolver_diagnostic("owned call requires module binding resolution")
      )
    },
    DotCallExpr(target, name, arguments, types) => {
      diagnostics = diagnostics.append(
        resolver_diagnostic("unresolved dot call requires module binding resolution")
      )
    },
    CallExpr(name, arguments, type_arguments) => {
      if !is_builtin(name) && !symbols.callables.has(name) {
        diagnostics = diagnostics.append(resolver_diagnostic("unknown function ${name}"))
      } else {
      }
      for argument in arguments {
        diagnostics = diagnostics.concat(resolve_expression(argument, scope, symbols))
      }
    },
    FieldExpr(target, field) => {
      diagnostics = resolve_expression(target, scope, symbols)
    },
    IndexExpr(target, index) => {
      diagnostics = resolve_expression(target, scope, symbols)
      diagnostics = diagnostics.concat(resolve_expression(index, scope, symbols))
    },
    IfExpr(condition, yes, no, has_else) => {
      diagnostics = resolve_expression(condition, scope, symbols)
      diagnostics = diagnostics.concat(resolve_block(yes, scope, symbols))
      diagnostics = diagnostics.concat(resolve_block(no, scope, symbols))
    },
    BlockExpr(block) => {
      diagnostics = resolve_block(block, scope, symbols)
    },
    MatchExpr(subject, arms) => {
      diagnostics = resolve_expression(subject, scope, symbols)
      for arm in arms {
        variant: Str = arm.pattern.variant
        if !symbols.variants.has(variant) {
          diagnostics = diagnostics.append(resolver_diagnostic("unknown variant ${variant}"))
        } else {
        }
        mut arm_scope: Set[Str] = scope
        for binding in arm.pattern.bindings {
          if arm_scope.has(binding) {
            diagnostics = diagnostics.append(
              resolver_diagnostic("pattern binding ${binding} shadows an existing binding")
            )
          } else {
          }
          arm_scope = arm_scope.add(binding)
        }
        diagnostics = diagnostics.concat(resolve_expression(arm.body, arm_scope, symbols))
      }
    }
  }

  diagnostics
}

pure resolve_block(block: Block, parent_scope: Set[Str], symbols: ResolverSymbols): [Diagnostic] {
  mut diagnostics: [Diagnostic] = []
  mut scope: Set[Str] = parent_scope

  for statement in block.statements {
    match statement {
      BindingStatement(name, type_name, annotation_span, mutable, value) => {
        diagnostics = diagnostics.concat(resolve_expression(value, scope, symbols))
        if scope.has(name) {
          diagnostics = diagnostics.append(
            resolver_diagnostic("local ${name} shadows an existing binding")
          )
        } else {
        }
        scope = scope.add(name)
      },
      AssignmentStatement(name, value) => {
        diagnostics = diagnostics.concat(resolve_expression(value, scope, symbols))
        scope = scope.add(name)
      },
      ExpressionStatement(value) => {
        diagnostics = diagnostics.concat(resolve_expression(value, scope, symbols))
      },
      WhileStatement(condition, body) => {
        diagnostics = diagnostics.concat(resolve_expression(condition, scope, symbols))
        diagnostics = diagnostics.concat(resolve_block(body, scope, symbols))
      },
      ForStatement(name, iterable, body) => {
        diagnostics = diagnostics.concat(resolve_expression(iterable, scope, symbols))
        mut body_scope: Set[Str] = scope
        if scope.has(name) {
          diagnostics = diagnostics.append(
            resolver_diagnostic("loop variable ${name} shadows an existing binding")
          )
        } else {
        }
        body_scope = body_scope.add(name)
        diagnostics = diagnostics.concat(resolve_block(body, body_scope, symbols))
      }
    }
  }
  match block.value {
    NoBlockValue() => {},
    TailBlockValue(value) => {
      diagnostics = diagnostics.concat(resolve_expression(value, scope, symbols))
    }
  }

  diagnostics
}

pure resolve_function(
  parameters: [FunctionParameter],
  body: Block,
  symbols: ResolverSymbols
): [Diagnostic] {
  scope: Set[Str] = set()
  mut function_scope: Set[Str] = scope
  mut diagnostics: [Diagnostic] = []

  for parameter in parameters {
    name: Str = parameter.name
    if function_scope.has(name) {
      diagnostics = diagnostics.append(
        resolver_diagnostic("parameter ${name} is already declared")
      )
    } else {
    }
    function_scope = function_scope.add(name)
  }
  diagnostics.concat(resolve_block(body, function_scope, symbols))
}

pub pure resolve_program_at(program: Program, positions: [SourcePos]): [Diagnostic] {
  symbols: ResolverSymbols = collect_symbols_at(program, positions)
  mut diagnostics: [Diagnostic] = symbols.diagnostics

  for declaration in program.declarations {
    match declaration {
      ImportDeclaration(path) => {},
      TypeDeclaration(name, base, guard) => {
        guard_scope: Set[Str] = set().add("value")
        diagnostics = diagnostics.concat(resolve_expression(guard, guard_scope, symbols))
      },
      RecordDeclaration(name, parameters, fields) => {},
      EnumDeclaration(name, parameters, variants) => {},
      FunctionDeclaration(name, parameters, return_type, is_pure, is_async, body, type_parameters) => {
        diagnostics = diagnostics.concat(resolve_function(parameters, body, symbols))
      }
    }
  }

  diagnostics
}

pub pure resolve_program(program: Program): [Diagnostic] {
  resolve_program_at(program, [])
}

pub pure render_resolver_diagnostics(diagnostics: [Diagnostic]): Str {
  if diagnostics.len() == 0 {
    "ok"
  } else {
    mut output: Str = ""
    for diagnostic in diagnostics {
      if output.len() > 0 {
        output = output + "\n"
      } else {
      }
      output = output + diagnostic_text(diagnostic)
    }
    output
  }
}

pub pure resolve_loaded_sources(sources: [LoadedSource], entry: Str): Str {
  mut units: [SourceUnit] = []
  mut diagnostics: [Diagnostic] = []

  for source in sources {
    match lex_file(source.source, source.path) {
      Ok(tokens) => {
        match parse_program_complete(tokens) {
          Ok(program) => {
            units = units.append(SourceUnit(source.path, program))
          },
          Error(error) => {
            diagnostics = diagnostics.append(error)
          }
        }
      },
      Error(errors) => {
        for error in errors {
          diagnostics = diagnostics.append(error)
        }
      }
    }
  }
  if diagnostics.len() > 0 {
    render_resolver_diagnostics(diagnostics)
  } else {
    render_resolver_diagnostics(resolve_module_graph(units, entry))
  }
}

pub pure resolve_source(source: Str): Str {
  match lex(source) {
    Ok(tokens) => {
      match parse_program_complete(tokens) {
        Ok(program) => render_resolver_diagnostics(resolve_program(program)),
        Error(error) => error.message
      }
    },
    Error(errors) => "lexing failed"
  }
}
