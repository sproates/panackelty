import "parser.panack"

record ResolverSymbols {
  declarations: Set[Str],
  callables: Set[Str],
  variants: Set[Str],
  diagnostics: [Diagnostic]
}

record SourceUnit {
  path: Str,
  program: Program
}

record LoadedSource {
  path: Str,
  source: Str
}

record ModuleGraphState {
  programs: [Program],
  visiting: Set[Str],
  visited: Set[Str],
  diagnostics: [Diagnostic]
}

pure resolver_diagnostic(message: Str): Diagnostic {
  Diagnostic(message, SourcePos("", 0, 1, 1))
}

pure resolver_diagnostics_at(diagnostics: [Diagnostic], position: SourcePos): [Diagnostic] {
  mut result: [Diagnostic] = []
  for diagnostic in diagnostics {
    selected: SourcePos = if len(diagnostic.position.file) == 0 { position } else { diagnostic.position }
    result = append(result, Diagnostic(diagnostic.message, selected))
  }
  result
}

pure is_builtin(name: Str): Bool {
  name == "print" || name == "read_line" || name == "read_file" ||
  name == "write_file" || name == "len" || name == "append" ||
  name == "concat" || name == "slice" || name == "starts_with" ||
  name == "starts_with_at" || name == "reverse" || name == "is_digit" || name == "is_letter" ||
  name == "is_whitespace" || name == "map" || name == "map_put" ||
  name == "map_has" || name == "map_get" || name == "$method_put" ||
  name == "$method_has" || name == "$method_get" || name == "set" ||
  name == "set_add" || name == "set_has" || name == "$method_add" ||
  name == "$method_call" || name == "$method_map" || name == "$method_reduce" || name == "bytes" ||
  name == "byte_append" || name == "bytes_concat" || name == "byte_len" ||
  name == "byte_get" || name == "utf8_encode" || name == "utf8_decode" ||
  name == "read_bytes" || name == "write_bytes" || name == "nat_from_str" ||
  name == "command_args" || name == "environment_has" ||
  name == "environment_get" || name == "eprint" || name == "process_exit" ||
  name == "path_resolve" || name == "path_parent" || name == "path_join" ||
  name == "path_suffix" || name == "path_with_suffix" ||
  name == "path_is_absolute" || name == "file_exists" || name == "run_bytecode" ||
  name == "run_bytecode_args"
}

pure add_variant_symbol(symbols: ResolverSymbols, name: Str): ResolverSymbols {
  mut diagnostics: [Diagnostic] = symbols.diagnostics
  if is_builtin(name) {
    diagnostics = append(diagnostics, resolver_diagnostic("variant constructor ${name} conflicts with a built-in"))
  } else {
  }
  if set_has(symbols.variants, name) {
    diagnostics = append(diagnostics, resolver_diagnostic("variant constructor ${name} is declared by more than one enum"))
  } else {
  }
  ResolverSymbols(
    symbols.declarations,
    set_add(symbols.callables, name),
    set_add(symbols.variants, name),
    diagnostics
  )
}

pure collect_variants(program: Program): ResolverSymbols {
  declarations: Set[Str] = set()
  callables: Set[Str] = set()
  variants: Set[Str] = set()
  diagnostics: [Diagnostic] = []
  mut symbols: ResolverSymbols = ResolverSymbols(declarations, callables, variants, diagnostics)
  for declaration in program.declarations {
    match declaration {
      ImportDeclaration(path) => {},
      TypeDeclaration(name, base, guard) => {},
      RecordDeclaration(name, parameters, fields) => {},
      EnumDeclaration(name, parameters, declared_variants) => {
        for variant in declared_variants {
          symbols = add_variant_symbol(symbols, variant.name)
        }
      },
      FunctionDeclaration(name, parameters, return_type, is_pure, body) => {}
    }
  }
  symbols
}

pure add_top_level_symbol(symbols: ResolverSymbols, name: Str, callable: Bool): ResolverSymbols {
  mut diagnostics: [Diagnostic] = symbols.diagnostics
  if set_has(symbols.declarations, name) {
    diagnostics = append(diagnostics, resolver_diagnostic("top-level name ${name} is already declared"))
  } else {
  }
  if is_builtin(name) || set_has(symbols.variants, name) {
    diagnostics = append(diagnostics, resolver_diagnostic("top-level name ${name} conflicts with a constructor or built-in"))
  } else {
  }
  next_callables: Set[Str] = if callable { set_add(symbols.callables, name) } else { symbols.callables }
  ResolverSymbols(
    set_add(symbols.declarations, name),
    next_callables,
    symbols.variants,
    diagnostics
  )
}

pure collect_symbols(program: Program): ResolverSymbols {
  mut symbols: ResolverSymbols = collect_variants(program)
  for declaration in program.declarations {
    match declaration {
      ImportDeclaration(path) => {},
      TypeDeclaration(name, base, guard) => {
        symbols = add_top_level_symbol(symbols, name, false)
      },
      RecordDeclaration(name, parameters, fields) => {
        symbols = add_top_level_symbol(symbols, name, true)
      },
      EnumDeclaration(name, parameters, variants) => {
        symbols = add_top_level_symbol(symbols, name, false)
      },
      FunctionDeclaration(name, parameters, return_type, is_pure, body) => {
        symbols = add_top_level_symbol(symbols, name, true)
      }
    }
  }
  symbols
}

pure append_program_declarations(programs: [Program]): Program {
  mut declarations: [TopLevel] = []
  for program in programs {
    for declaration in program.declarations {
      declarations = append(declarations, declaration)
    }
  }
  Program(declarations)
}

pure visit_module(units: [SourceUnit], path: Str, state: ModuleGraphState): ModuleGraphState {
  if set_has(state.visited, path) {
    state
  } else {
    if set_has(state.visiting, path) {
      diagnostics: [Diagnostic] = append(state.diagnostics, resolver_diagnostic("import cycle includes ${path}"))
      ModuleGraphState(state.programs, state.visiting, state.visited, diagnostics)
    } else {
      mut found: Bool = false
      mut selected: Program = Program([])
      for unit in units {
        if unit.path == path {
          if found {
          } else {
            found = true
            selected = unit.program
          }
        } else {
        }
      }
      if !found {
        diagnostics: [Diagnostic] = append(state.diagnostics, resolver_diagnostic("module ${path} is not loaded"))
        ModuleGraphState(state.programs, state.visiting, state.visited, diagnostics)
      } else {
        active: Set[Str] = set_add(state.visiting, path)
        mut current: ModuleGraphState = ModuleGraphState(state.programs, active, state.visited, state.diagnostics)
        for declaration in selected.declarations {
          match declaration {
            ImportDeclaration(imported) => {
              current = visit_module(units, imported, current)
            },
            TypeDeclaration(name, base, guard) => {},
            RecordDeclaration(name, parameters, fields) => {},
            EnumDeclaration(name, parameters, variants) => {},
            FunctionDeclaration(name, parameters, return_type, is_pure, body) => {}
          }
        }
        ModuleGraphState(
          append(current.programs, selected),
          state.visiting,
          set_add(current.visited, path),
          current.diagnostics
        )
      }
    }
  }
}

pure duplicate_module_diagnostics(units: [SourceUnit]): [Diagnostic] {
  paths: Set[Str] = set()
  mut seen: Set[Str] = paths
  mut diagnostics: [Diagnostic] = []
  for unit in units {
    if set_has(seen, unit.path) {
      path: Str = unit.path
      diagnostics = append(diagnostics, resolver_diagnostic("module ${path} is loaded more than once"))
    } else {
    }
    seen = set_add(seen, unit.path)
  }
  diagnostics
}

pure resolve_module_graph(units: [SourceUnit], entry: Str): [Diagnostic] {
  empty: Set[Str] = set()
  initial: ModuleGraphState = ModuleGraphState([], empty, empty, duplicate_module_diagnostics(units))
  graph: ModuleGraphState = visit_module(units, entry, initial)
  program: Program = append_program_declarations(graph.programs)
  concat(graph.diagnostics, resolve_program(program))
}

pure resolve_expression(expression: Expr, scope: Set[Str], symbols: ResolverSymbols): [Diagnostic] {
  mut diagnostics: [Diagnostic] = []
  match expression {
    LocatedExpr(position, value) => {
      diagnostics = resolver_diagnostics_at(resolve_expression(value, scope, symbols), position)
    },
    NatExpr(value) => {},
    DecimalExpr(text) => {},
    StringExpr(text) => {},
    BoolExpr(value) => {},
    NameExpr(name) => {
      if !set_has(scope, name) {
        diagnostics = append(diagnostics, resolver_diagnostic("unknown name ${name}"))
      } else {
      }
    },
    FunctionExpr(name) => {
      if !set_has(symbols.callables, name) {
        diagnostics = append(diagnostics, resolver_diagnostic("unknown function ${name}"))
      } else {}
    },
    ArrayExpr(items) => {
      for item in items {
        diagnostics = concat(diagnostics, resolve_expression(item, scope, symbols))
      }
    },
    UnaryExpr(operator, operand) => {
      diagnostics = resolve_expression(operand, scope, symbols)
    },
    BinaryExpr(operator, left, right) => {
      diagnostics = resolve_expression(left, scope, symbols)
      diagnostics = concat(diagnostics, resolve_expression(right, scope, symbols))
    },
    CallExpr(name, arguments) => {
      if !is_builtin(name) && !set_has(symbols.callables, name) {
        diagnostics = append(diagnostics, resolver_diagnostic("unknown function ${name}"))
      } else {
      }
      for argument in arguments {
        diagnostics = concat(diagnostics, resolve_expression(argument, scope, symbols))
      }
    },
    FieldExpr(target, field) => {
      diagnostics = resolve_expression(target, scope, symbols)
    },
    IndexExpr(target, index) => {
      diagnostics = resolve_expression(target, scope, symbols)
      diagnostics = concat(diagnostics, resolve_expression(index, scope, symbols))
    },
    IfExpr(condition, yes, no, has_else) => {
      diagnostics = resolve_expression(condition, scope, symbols)
      diagnostics = concat(diagnostics, resolve_block(yes, scope, symbols))
      diagnostics = concat(diagnostics, resolve_block(no, scope, symbols))
    },
    BlockExpr(block) => {
      diagnostics = resolve_block(block, scope, symbols)
    },
    MatchExpr(subject, arms) => {
      diagnostics = resolve_expression(subject, scope, symbols)
      for arm in arms {
        variant: Str = arm.pattern.variant
        if !set_has(symbols.variants, variant) {
          diagnostics = append(diagnostics, resolver_diagnostic("unknown variant ${variant}"))
        } else {
        }
        mut arm_scope: Set[Str] = scope
        for binding in arm.pattern.bindings {
          if set_has(arm_scope, binding) {
            diagnostics = append(diagnostics, resolver_diagnostic("pattern binding ${binding} shadows an existing binding"))
          } else {
          }
          arm_scope = set_add(arm_scope, binding)
        }
        diagnostics = concat(diagnostics, resolve_expression(arm.body, arm_scope, symbols))
      }
    }
  }
  diagnostics
}

pure resolve_block(block: Block, parent_scope: Set[Str], symbols: ResolverSymbols): [Diagnostic] {
  mut diagnostics: [Diagnostic] = []
  mut scope: Set[Str] = parent_scope
  for statement in block.statements {
    match statement {
      BindingStatement(name, type_name, mutable, value) => {
        diagnostics = concat(diagnostics, resolve_expression(value, scope, symbols))
        if set_has(scope, name) {
          diagnostics = append(diagnostics, resolver_diagnostic("local ${name} shadows an existing binding"))
        } else {
        }
        scope = set_add(scope, name)
      },
      AssignmentStatement(name, value) => {
        if !set_has(scope, name) {
          diagnostics = append(diagnostics, resolver_diagnostic("unknown name ${name}"))
        } else {
        }
        diagnostics = concat(diagnostics, resolve_expression(value, scope, symbols))
      },
      ExpressionStatement(value) => {
        diagnostics = concat(diagnostics, resolve_expression(value, scope, symbols))
      },
      WhileStatement(condition, body) => {
        diagnostics = concat(diagnostics, resolve_expression(condition, scope, symbols))
        diagnostics = concat(diagnostics, resolve_block(body, scope, symbols))
      },
      ForStatement(name, iterable, body) => {
        diagnostics = concat(diagnostics, resolve_expression(iterable, scope, symbols))
        mut body_scope: Set[Str] = scope
        if set_has(scope, name) {
          diagnostics = append(diagnostics, resolver_diagnostic("loop variable ${name} shadows an existing binding"))
        } else {
        }
        body_scope = set_add(body_scope, name)
        diagnostics = concat(diagnostics, resolve_block(body, body_scope, symbols))
      }
    }
  }
  match block.value {
    NoBlockValue() => {},
    TailBlockValue(value) => {
      diagnostics = concat(diagnostics, resolve_expression(value, scope, symbols))
    }
  }
  diagnostics
}

pure resolve_function(parameters: [FunctionParameter], body: Block, symbols: ResolverSymbols): [Diagnostic] {
  scope: Set[Str] = set()
  mut function_scope: Set[Str] = scope
  mut diagnostics: [Diagnostic] = []
  for parameter in parameters {
    name: Str = parameter.name
    if set_has(function_scope, name) {
      diagnostics = append(diagnostics, resolver_diagnostic("parameter ${name} is already declared"))
    } else {
    }
    function_scope = set_add(function_scope, name)
  }
  concat(diagnostics, resolve_block(body, function_scope, symbols))
}

pure resolve_program(program: Program): [Diagnostic] {
  symbols: ResolverSymbols = collect_symbols(program)
  mut diagnostics: [Diagnostic] = symbols.diagnostics
  for declaration in program.declarations {
    match declaration {
      ImportDeclaration(path) => {},
      TypeDeclaration(name, base, guard) => {
        guard_scope: Set[Str] = set_add(set(), "value")
        diagnostics = concat(diagnostics, resolve_expression(guard, guard_scope, symbols))
      },
      RecordDeclaration(name, parameters, fields) => {},
      EnumDeclaration(name, parameters, variants) => {},
      FunctionDeclaration(name, parameters, return_type, is_pure, body) => {
        diagnostics = concat(diagnostics, resolve_function(parameters, body, symbols))
      }
    }
  }
  diagnostics
}

pure render_resolver_diagnostics(diagnostics: [Diagnostic]): Str {
  if len(diagnostics) == 0 {
    "ok"
  } else {
    mut output: Str = ""
    for diagnostic in diagnostics {
      if len(output) > 0 {
        output = output + "\n"
      } else {
      }
      output = output + diagnostic_text(diagnostic)
    }
    output
  }
}

pure resolve_loaded_sources(sources: [LoadedSource], entry: Str): Str {
  mut units: [SourceUnit] = []
  mut diagnostics: [Diagnostic] = []
  for source in sources {
    match lex_file(source.source, source.path) {
      Ok(tokens) => {
        match parse_program_complete(tokens) {
          Ok(program) => {
            units = append(units, SourceUnit(source.path, program))
          },
          Error(error) => { diagnostics = append(diagnostics, error); }
        }
      },
      Error(errors) => {
        for error in errors {
          diagnostics = append(diagnostics, error)
        }
      }
    }
  }
  if len(diagnostics) > 0 {
    render_resolver_diagnostics(diagnostics)
  } else {
    render_resolver_diagnostics(resolve_module_graph(units, entry))
  }
}

pure resolve_source(source: Str): Str {
  match lex(source) {
    Ok(tokens) => {
      match parse_program_complete(tokens) {
        Ok(program) => render_resolver_diagnostics(resolve_program(program)),
        Error(error) => error.message
      }
    },
    Error(errors) => "lexing failed"
  }
}
