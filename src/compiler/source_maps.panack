import stdlib/numeric::{nat_quotient}
import stdlib/bytes::{bytes_empty, bytes_push, bytes_join, bytes_length, text_encode_utf8}
import stdlib/path::{path_value_from_text}
import stdlib/filesystem::{filesystem_read_bytes, filesystem_metadata, filesystem_write_bytes}
pub import project/src/compiler/loader::{LoadedProject}
import project/src/compiler/loader::{loaded_binding_graph}
import project/src/compiler/diagnostics::{diagnostic_character}
import project/src/compiler/module_emission::{module_emission_symbol}
pub import project/src/compiler/module_bindings::{DeclarationIdentity, ModuleIdentity, ModuleDeclarationKind.ModuleFunction, source_module_identity}
import project/src/compiler/module_resolution::{ModuleBindingGraph}
pub import project/src/compiler/types::{SourcePos, SourceSpan}
import project/src/bytecode/codec::{encode_u32, encode_text}
pub import project/src/compiler/emitter::{SourceMappedProgram}

// Serialize and replay bounded, local source maps. Foreign paths and lengths are
// never instructions to open files or allocate unchecked buffers.

pub record SourceSnapshot {
  name: Str,
  path: Str,
  text: Str
}

pub record SourceMapFunctionSelector {
  identity: DeclarationIdentity,
  source_path: Str,
  emitted_name: Str,
  display_name: Str
}

// Tool queries use stable module identities rather than the private emitted
// symbol. Bare names remain convenient only while they identify one function.
pub source_map_function_selector(
  project: LoadedProject,
  selector: Str,
  entry_path: Str,
  root: Str,
  stdlib_root: Str
): Result[SourceMapFunctionSelector, Str] {
  mut separator: Option[Nat] = None()
  for index in 0..len(selector) {
    if selector[index] == ":" {
      separator = Some(index)
    }
  }
  mut selected_module: Str = ""
  mut function_name: Str = selector
  qualified: Bool = match separator {
    None() => false,
    Some(index) => {
      selected_module = slice(selector, 0, index)
      function_name = slice(selector, index + 1, len(selector))
      true
    }
  }
  if function_name == "" || (qualified && selected_module == "") {
    Error("invalid function selector " + source_map_escape(selector))
  } else {
    graph: ModuleBindingGraph = loaded_binding_graph(project.modules, root, stdlib_root)
    entry: ModuleIdentity = source_module_identity(entry_path, root, stdlib_root)
    mut found: Option[SourceMapFunctionSelector] = None()
    mut matches: Nat = 0
    for module in project.modules {
      module_selector: Str = source_identifier(module.source_path, root, stdlib_root)
      module_matches: Bool = !qualified || module_selector == selected_module
      if module_matches {
        for binding in module.bindings.declarations {
          if binding.kind == ModuleFunction() && binding.identity.name == function_name {
            found = Some(SourceMapFunctionSelector(
              binding.identity,
              module.source_path,
              module_emission_symbol(graph, entry, binding.identity),
              selector
            ))
            matches = matches + 1
          }
        }
      }
    }
    if matches > 1 {
      Error("ambiguous function selector " + source_map_escape(selector) + "; use a module-qualified selector")
    } else {
      match found {
        None() => if qualified {
          Error("mismatched module identity selector " + source_map_escape(selector))
        } else {
          Error("unknown function selector " + source_map_escape(selector))
        },
        Some(value) => Ok(value)
      }
    }
  }
}

pure source_snapshot_less(left: SourceSnapshot, right: SourceSnapshot): Bool {
  left.name < right.name
}

pure source_path_parts(path: Str): [Str] {
  mut parts: [Str] = []
  mut start: Nat = 0
  mut cursor: Nat = 0

  while cursor <= len(path) {
    if cursor == len(path) || path[cursor] == "/" {
      if start < cursor {
        parts = append(parts, slice(path, start, cursor))
      }
      start = cursor + 1
    }
    cursor = cursor + 1
  }

  parts
}

// Inputs are normalized absolute paths from the loader. Parent segments are
// descriptive identifiers only: the consumer never opens paths from a sidecar.
pub pure source_relative_path(root: Str, path: Str): Str {
  base: [Str] = source_path_parts(root)
  target: [Str] = source_path_parts(path)
  mut common: Nat = 0

  while common < len(base) && common < len(target) && base[common] == target[common] {
    common = common + 1
  }
  mut output: Str = ""
  for index in common..len(base) {
    output = output + "../"
  }
  for index in common..len(target) {
    output = output + target[index]
    if index + 1 < len(target) {
      output = output + "/"
    }
  }

  output
}

pub pure source_identifier(path: Str, root: Str, stdlib_root: Str): Str {
  if starts_with_at(path, stdlib_root + "/", 0) {
    "stdlib/" + source_relative_path(stdlib_root, path)
  } else {
    "project/" + source_relative_path(root, path)
  }
}

pub pure source_snapshots(project: LoadedProject, root: Str, stdlib_root: Str): [SourceSnapshot] {
  mut snapshots: [SourceSnapshot] = []

  for path in project.source_paths {
    snapshots = append(
      snapshots,
      SourceSnapshot(source_identifier(path, root, stdlib_root), path, project.sources.get(path))
    )
  }
  snapshots.sort_by(@source_snapshot_less)
}

pub pure source_map_blob(data: Bytes): Bytes {
  bytes_join(encode_u32(bytes_length(data)), data)
}

pub pure source_map_position(position: SourcePos): Bytes {
  bytes_join(
    bytes_join(encode_u32(position.offset), encode_u32(position.line)),
    encode_u32(position.column)
  )
}

// Join a bounded set of chunks as a balanced tree. In particular, do not copy
// the entire captured source closure for each emitted instruction.
pub pure source_map_join(chunks: [Bytes], start: Nat, end: Nat): Bytes {
  if start >= end {
    bytes_empty()
  } else {
    if end == start + 1 {
      chunks[start]
    } else {
      middle: Nat = nat_quotient(start + end, 2)
      bytes_join(source_map_join(chunks, start, middle), source_map_join(chunks, middle, end))
    }
  }
}

// No consumer decodes foreign bytes. Reproduction by the installed compiler is
// the trust boundary; this marker specifies a format, not producer authentication.
// The format embeds exact artifact/source bytes rather than collision-prone IDs.
pub pure serialize_source_map(
  project: LoadedProject,
  mapped: SourceMappedProgram,
  artifact: Bytes,
  entry: Str,
  root: Str,
  stdlib_root: Str
): Bytes {
  snapshots: [SourceSnapshot] = source_snapshots(project, root, stdlib_root)
  mut valid: Bool = bytes_length(artifact) <= 16777216 && len(snapshots) <= 256
  mut chunks: [Bytes] = [text_encode_utf8("PANACKMAP1\nlocal-replay-v9\n"),
    encode_text(source_identifier(
    entry,
    root,
    stdlib_root
  )), source_map_blob(artifact), encode_u32(len(snapshots))]
  mut size: Nat = 0

  for chunk in chunks {
    size = size + bytes_length(chunk)
  }
  valid = valid && size <= 16777216
  mut indices: Map[Str, Nat] = map()
  mut index: Nat = 0
  for snapshot in snapshots {
    if valid {
      indices = indices.put(snapshot.path, index)
      name: Bytes = encode_text(snapshot.name)
      text: Bytes = encode_text(snapshot.text)
      size = size + bytes_length(name) + bytes_length(text)
      valid = size <= 16777216
      if valid {
        chunks = chunks.append(name).append(text)
      }
      index = index + 1
    }
  }
  chunks = chunks.append(encode_u32(len(mapped.sources)))
  size = size + 4
  for function in mapped.sources {
    if valid {
      header: Bytes = bytes_join(encode_text(function.name), encode_u32(len(function.entries)))
      size = size + bytes_length(header)
      valid = size <= 16777216
      if valid {
        chunks = chunks.append(header)
      }
      for location in function.entries {
        span: SourceSpan = location.span
        size = size + 33
        if valid &&
          size <= 16777216 &&
          indices.has(span.start.file) &&
          span.start.file == span.end.file {
          mut chunk: Bytes = bytes_join(
            encode_u32(location.index),
            encode_u32(indices.get(span.start.file))
          )
          chunk = bytes_join(chunk, source_map_position(span.start))
          chunk = bytes_join(chunk, source_map_position(span.end))
          chunk = bytes_push(chunk, if location.lowered {
              1
            } else {
              0
            })
          chunks = chunks.append(chunk)
        } else {
          valid = false
        }
      }
    }
  }
  if valid && size <= 16777216 {
    source_map_join(chunks, 0, len(chunks))
  } else {
    bytes_empty()
  }
}

pub source_map_read(path: Str, limit: Nat): Result[Bytes, Str] {
  match path_value_from_text(path) {
    Error(error) => Error("invalid path"),
    Ok(file) => match filesystem_read_bytes(file, limit) {
      Error(error) => Error("file unavailable or exceeds source-map limit"),
      Ok(data) => Ok(data)
    }
  }
}

pub source_map_matches(path: Str, expected: Bytes): Bool {
  match source_map_read(path, bytes_length(expected)) {
    Error(error) => false,
    Ok(actual) => actual == expected
  }
}

// Detect observed modifications since loading. This is not an atomic snapshot
// of a concurrently edited tree; all reported coordinates describe captured text.
pub source_snapshots_unchanged(project: LoadedProject): Bool {
  mut unchanged: Bool = true

  for path in project.source_paths {
    if !source_map_matches(path, text_encode_utf8(project.sources.get(path))) {
      unchanged = false
    }
  }
  unchanged
}

pub pure source_map_escape(text: Str): Str {
  mut output: Str = ""

  for index in 0..len(text) {
    output = output + diagnostic_character(text[index])
  }

  output
}

pub pure source_map_location(
  project: LoadedProject,
  mapped: SourceMappedProgram,
  emitted_name: Str,
  display_name: Str,
  pc: Nat,
  root: Str,
  stdlib_root: Str
): Str {
  mut output: Str = "source-map: unavailable"

  for function in mapped.sources {
    if function.name == emitted_name {
      for location in function.entries {
        if location.index == pc {
          span: SourceSpan = location.span
          kind: Str = if location.lowered {
            "lowered"
          } else {
            "expression"
          }
          file: Str = source_map_escape(source_identifier(span.start.file, root, stdlib_root))
          name: Str = source_map_escape(display_name)
          start: Nat = span.start.offset
          end: Nat = span.end.offset
          line: Nat = span.start.line
          column: Nat = span.start.column
          end_line: Nat = span.end.line
          end_column: Nat = span.end.column
          source: Str = project.sources.get(span.start.file)
          expression: Str = source_map_escape(slice(source, start, end))
          output = "source-map: ${kind}\nfunction: ${name}\ninstruction: ${pc}\nfile: ${file}\nrange: ${start}..${end}\nstart: ${line}:${column}\nend: ${end_line}:${end_column}\nexpression: ${expression}"
        }
      }
    }
  }

  output
}

// Fresh destinations prevent overwriting loaded sources through existing hard
// links or symlinks as well as ordinary path aliases. Publication is not atomic;
// consumers reject incomplete pairs. Output directories must be caller-controlled.
pub source_map_destination_available(path: Str): Bool {
  match path_value_from_text(path) {
    Error(error) => false,
    Ok(file) => match filesystem_metadata(file) {
      Ok(metadata) => false,
      Error(error) => error.code == "not_found"
    }
  }
}

pub source_map_write(path: Str, data: Bytes): Bool {
  match path_value_from_text(path) {
    Error(error) => false,
    Ok(file) => match filesystem_write_bytes(file, data) {
      Error(error) => false,
      Ok(unit) => true
    }
  }
}
