// Source positions use Unicode code-point offsets and one-based line/column values.
// Shared token and diagnostic records preserve those coordinates across passes.

pub record SourcePos {
  file: Str,
  offset: Nat,
  line: Nat,
  column: Nat
}

// Half-open Unicode code-point range in one original source file.
pub record SourceSpan {
  start: SourcePos,
  end: SourcePos
}

pub enum TokenKind {
  Identifier,
  Number,
  DecimalNumber,
  StringLiteral,
  Punctuation
}

pub record Token {
  kind: TokenKind,
  text: Str,
  start: Nat,
  end: Nat,
  position: SourcePos,
  end_line: Nat,
  end_column: Nat
}

pub record Diagnostic {
  message: Str,
  position: SourcePos
}

pub pure diagnostic_text(diagnostic: Diagnostic): Str {
  position: SourcePos = diagnostic.position

  if len(position.file) > 0 {
    file: Str = position.file
    line: Nat = position.line
    column: Nat = position.column
    message: Str = diagnostic.message
    "${file}:${line}:${column}: ${message}"
  } else {
    diagnostic.message
  }
}
