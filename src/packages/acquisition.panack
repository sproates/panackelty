pub import project/src/packages/diagnostic::{PackageProblem}
import project/src/packages/diagnostic::{host_detail, package_problem, problem_context, package_result}
import project/src/packages/manifest::{parse_package_manifest}
import project/src/packages/remote_archive::{stage_remote_archive}
pub import project/src/packages/lock::{PackageLock, PackageLockEdge, PackageLockPackage}
import project/src/packages/lock::{lock_package_id, serialize_package_lock}
import project/src/packages/archive::{StagedArchive, stage_archive, discard_archive}
import project/src/packages/tree_digest::{tree_digest, verify_tree_digest}
import project/src/packages/sha256::{Sha256, sha256_new, sha256_feed, sha256_finish, sha256_bytes, sha256_close}
import project/src/project_model/package_manifest::{manifest_json_string_field}
import stdlib/path as path
import stdlib/filesystem as filesystem
import stdlib/filesystem::{FileKind.Directory, FileKind.RegularFile}
import stdlib/bounded_filesystem as bounded
import stdlib/filesystem_stage as staging
import stdlib/environment as environment

pub record ArchiveSource {
  source: Str,
  root: Str,
  name: Str,
  version: Str,
  archive_hash: Str,
  manifest_hash: Str,
  tree_hash: Str,
  stage: Option[Nat]
}

pub record AcquisitionOptions { root: Str, materialize: Bool, locked: Option[PackageLock], offline: Bool, refresh: Bool, aliases: [Str], boundary: Option[Str] }

pub pure locked_edge(lock: PackageLock, owner: Str, alias: Str): Option[PackageLockEdge] {
  mut edges: [PackageLockEdge] = []
  if owner == lock_package_id(lock.root_name, lock.root_version) { edges = lock.dependencies }
  else { for package in lock.packages {
    if owner == lock_package_id(package.name, package.version) { edges = package.dependencies }
  } }
  mut found: Option[PackageLockEdge] = None()
  for edge in edges { if edge.alias == alias { found = Some(edge) } }
  found
}

pub pure locked_package(lock: PackageLock, id: Str): Option[PackageLockPackage] {
  mut found: Option[PackageLockPackage] = None()
  for package in lock.packages {
    if lock_package_id(package.name, package.version) == id { found = Some(package) }
  }
  found
}

pub ensure_directory(name: Str, create: Bool): Result[Unit, PackageProblem] {
  match path.from_text(name) {
    Error(problem) => Error(package_problem("PKG_FILESYSTEM", "invalid directory path")),
    Ok(directory) => match filesystem.metadata(directory) {
      Ok(info) => if info.kind == Directory() { Ok(()) }
        else { Error(package_problem("PKG_FILESYSTEM", "cache or state path is not a directory: " + name)) },
      Error(problem) => if problem.code == "not_found" && create {
        match filesystem.create_directory(directory) {
          Error(creation_error) => Error(package_problem("PKG_FILESYSTEM", "cannot create cache directory: " + host_detail(creation_error.code))),
          Ok(completed_1) => ensure_directory(name, false)
        }
      } else if problem.code == "not_found" { Error(package_problem("PKG_CACHE_MISSING", "missing cache: " + name)) }
      else { Error(package_problem("PKG_FILESYSTEM", "cannot inspect cache: " + host_detail(problem.code))) }
    }
  }
}

pub hash_archive_file(name: Str): Result[Str, PackageProblem] {
  match path.from_text(name) {
    Error(problem) => Error(package_problem("PKG_FILESYSTEM", "invalid archive path")),
    Ok(file) => {
      mut hash: Sha256 = sha256_new()
      mut offset: Nat = 0
      mut done: Bool = false
      mut failure: Option[PackageProblem] = None()
      while !done && failure == None() {
        match bounded.read_chunk(file, offset, 65536) {
          Error(problem) => { failure = Some(package_problem("PKG_FILESYSTEM", "cannot read archive: " + host_detail(problem.code))) },
          Ok(bytes) => {
            offset = offset + bytes.length()
            if offset > 67108864 { failure = Some(package_problem("PKG_LIMIT", "archive exceeds 64 MiB compressed input")) }
            else { hash = sha256_feed(hash, bytes) }
            done = bytes.length() == 0
          }
        }
      }
      match failure {
        Some(problem) => { sha256_close(hash); Error(problem) },
        None() => package_result(sha256_finish(hash), "PKG_TOOL")
      }
    }
  }
}

inspect_staged_archive(source: Str, archive: StagedArchive): Result[ArchiveSource, PackageProblem] {
  match path.from_text(archive.root + "/panack.json") {
    Error(problem) => Error(package_problem("PKG_MANIFEST", "invalid staged manifest path")),
    Ok(file) => match filesystem.read(file, 65536) {
      Error(problem) => Error(package_problem("PKG_MANIFEST", "cannot read staged manifest")),
      Ok(bytes) => match parse_package_manifest(bytes, environment.get("PANACKELTY_VERSION").value_or("")) {
        Error(problem) => Error(package_problem("PKG_MANIFEST", "invalid archive manifest in " + source + ": " + problem.message)),
        Ok(manifest) => match package_result(sha256_bytes(bytes), "PKG_TOOL") {
          Error(problem) => Error(problem),
          Ok(manifest_hash) => match package_result(tree_digest(archive.root, archive.entries), "PKG_ARCHIVE") {
            Error(problem) => Error(problem),
            Ok(tree_hash) => Ok(ArchiveSource(source, archive.root, manifest.package,
              manifest.version, archive.compressed_sha256, manifest_hash, tree_hash, Some(archive.handle)))
          }
        }
      }
    }
  }
}

cached_archive(options: AcquisitionOptions, source: Str, owner: Str, alias: Str): Result[ArchiveSource, PackageProblem] {
  match options.locked {
    None() => Error(package_problem("PKG_LOCK_MISSING", "missing lockfile")),
    Some(lock) => match locked_edge(lock, owner, alias) {
      None() => Error(package_problem("PKG_LOCK_STALE", "dependency is missing from lock")),
      Some(edge) => match locked_package(lock, edge.package) {
        None() => Error(package_problem("PKG_LOCK_INVALID", "locked package is missing")),
        Some(package) => match manifest_json_string_field(edge.source, "archive_sha256") {
          Error(problem) => Error(package_problem("PKG_LOCK_STALE", "locked dependency is not an archive")),
          Ok(expected) => match if source.starts_with_at("https://", 0) { Ok(expected) } else { hash_archive_file(source) } {
            Error(problem) => Error(problem),
            Ok(actual) => if actual != expected { Error(package_problem("PKG_INTEGRITY", "archive contents do not match the SHA-256 checksum in panack.lock.json")) }
            else {
              root: Str = options.root + "/.panack_modules/" + package.name
              match ensure_directory(root, false) {
                Error(problem) => Error(problem),
                Ok(completed_2) => match package.tree_sha256 {
                  None() => Error(package_problem("PKG_LOCK_INVALID", "archive lock is missing tree digest")),
                  Some(tree) => match package_result(verify_tree_digest(root, tree), "PKG_CACHE_INVALID") {
                    Error(problem) => Error(problem),
                    Ok(completed_3) => Ok(ArchiveSource(source, root, package.name, package.version,
                      actual, package.manifest_sha256, tree, None()))
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

acquire_local_archive(options: AcquisitionOptions, source: Str, owner: Str, alias: Str,
  previous: [ArchiveSource]): Result[ArchiveSource, PackageProblem] {
  mut known: Option[ArchiveSource] = None()
  for acquired in previous { if acquired.source == source { known = Some(acquired) } }
  match known {
    Some(acquired) => Ok(acquired),
    None() => if !options.materialize && options.locked == None() {
      Error(package_problem("PKG_LOCK_MISSING", "missing lockfile"))
    } else { match ensure_directory(options.root + "/.panack_modules", options.materialize) {
      Error(problem) => Error(problem),
      Ok(completed_4) => if !options.materialize { cached_archive(options, source, owner, alias) }
      else {
        match package_result(stage_archive(options.root + "/.panack_modules", source), "PKG_ARCHIVE") {
          Error(problem) => Error(problem),
          Ok(archive) => {
            result = inspect_staged_archive(source, archive)
            match result {
              Ok(acquired) => Ok(acquired),
              Error(problem) => { cleanup = discard_archive(archive); Error(problem) }
            }
          }
        }
      }
    }
  }
}
}

pub verify_cache_state(root: Str, lock: PackageLock): Result[Unit, PackageProblem] {
  mut archives: Bool = false
  for package in lock.packages { if package.tree_sha256 != None() { archives = true } }
  if !archives { Ok(()) } else {
    match ensure_directory(root + "/.panack_modules", false) {
      Error(problem) => Error(problem),
      Ok(completed_5) => match ensure_directory(root + "/.panack_modules/.state", false) {
        Error(problem) => Error(problem),
        Ok(completed_6) => match path.from_text(root + "/.panack_modules/.state/lock.json") {
          Error(problem) => Error(package_problem("PKG_FILESYSTEM", "invalid state path")),
          Ok(file) => match filesystem.metadata(file) {
            Error(problem) => Error(if problem.code == "not_found" { package_problem("PKG_CACHE_MISSING", "the record of prepared local packages is missing") } else { package_problem("PKG_FILESYSTEM", "cannot inspect cache state: " + host_detail(problem.code)) }),
            Ok(info) => if info.kind != RegularFile() { Error(package_problem("PKG_CACHE_INVALID", "the record of prepared local packages must be an ordinary file")) }
            else { match filesystem.read(file, 1048576) {
              Error(problem) => Error(package_problem("PKG_CACHE_INVALID", "cannot read the record of prepared local packages")),
              Ok(bytes) => if bytes == serialize_package_lock(lock).encode_utf8() { Ok(()) }
                else { Error(package_problem("PKG_CACHE_INVALID", "the record of prepared local packages does not match panack.lock.json")) }
            } }
          }
        }
      }
    }
  }
}

pub publish_archives(root: Str, sources: [ArchiveSource], lock: PackageLock): Result[Unit, PackageProblem] {
  mut pending: Bool = false
  for package in lock.packages { pending = pending || package.tree_sha256 != None() }
  if !pending { Ok(()) } else {
    // All graph and lock validation precedes this per-entry commit. Each exchange
    // preserves its previous entry if that exchange fails; this is not a
    // multi-package transaction. State is published only after all entries.
    match ensure_directory(root + "/.panack_modules/.state", true) {
      Error(problem) => Error(problem),
      Ok(completed_7) => {
        mut failure: Option[PackageProblem] = None()
        for source in sources {
          if failure == None() { match source.stage {
            None() => {},
            Some(handle) => match path.from_text(source.name) {
              Error(problem) => { failure = Some(package_problem("PKG_GRAPH", "invalid package cache name")) },
              Ok(name) => match staging.publish(handle, name, true) {
                Error(problem) => { failure = Some(package_problem("PKG_PUBLICATION", "cannot save the unpacked package: " + host_detail(problem.code))) },
                Ok(completed_8) => {}
              }
            }
          } }
        }
        match failure {
          Some(problem) => Error(problem),
          None() => match path.from_text(root + "/.panack_modules/.state/lock.json") {
            Error(problem) => Error(package_problem("PKG_FILESYSTEM", "invalid state path")),
            Ok(file) => match bounded.atomic_write(file, serialize_package_lock(lock).encode_utf8()) {
              Error(problem) => Error(package_problem("PKG_PUBLICATION", "cannot save the record of prepared local packages: " + host_detail(problem.code))),
              Ok(completed_9) => Ok(())
            }
          }
        }
      }
    }
  }
}

remote_pin(options: AcquisitionOptions, source: Str, owner: Str, alias: Str): Result[Str, PackageProblem] {
  match options.locked {
    None() => Error(package_problem("PKG_LOCK_MISSING", "missing lockfile")),
    Some(lock) => match locked_edge(lock, owner, alias) {
      None() => Error(package_problem("PKG_LOCK_STALE", "remote dependency is missing from lock")),
      Some(edge) => match manifest_json_string_field(edge.source, "url") {
        Error(problem) => Error(package_problem("PKG_LOCK_STALE", "remote source changed")),
        Ok(url) => if url != source { Error(package_problem("PKG_LOCK_STALE", "remote source changed")) }
          else { match manifest_json_string_field(edge.source, "archive_sha256") {
            Error(problem) => Error(package_problem("PKG_ARCHIVE", "remote archive digest missing")), Ok(hash) => Ok(hash)
          } }
      }
    }
  }
}

pub acquire_archive(options: AcquisitionOptions, source: Str, owner: Str, alias: Str,
  previous: [ArchiveSource]): Result[ArchiveSource, PackageProblem] {
  if !source.starts_with_at("https://", 0) { acquire_local_archive(options, source, owner, alias, previous) }
  else {
    pin = if options.refresh { Ok("") } else { remote_pin(options, source, owner, alias) }
    match pin {
      Error(problem) => Error(problem),
      Ok(expected) => {
        mut known: Option[ArchiveSource] = None()
        for acquired in previous { if acquired.source == source { known = Some(acquired) } }
        match known {
          Some(acquired) => if expected != "" && acquired.archive_hash != expected { Error(package_problem("PKG_INTEGRITY", "archive contents do not match the SHA-256 checksum in panack.lock.json")) } else { Ok(acquired) },
          None() => {
            cached = if options.refresh { Error(package_problem("PKG_GRAPH", "refresh requested")) } else {
              match options.locked {
                None() => Error(package_problem("PKG_LOCK_MISSING", "missing lockfile")),
                Some(lock) => match verify_cache_state(options.root, lock) {
                  Error(problem) => Error(problem),
                  Ok(unit) => cached_archive(options, source, owner, alias)
                }
              }
            }
            match cached {
              Ok(acquired) => Ok(acquired),
              Error(cache_problem) => if options.offline || !options.materialize {
                Error(problem_context(cache_problem, "remote archive cache; this command cannot download replacement content"))
              } else { match ensure_directory(options.root + "/.panack_modules", true) {
                Error(problem) => Error(problem),
                Ok(unit) => match stage_remote_archive(options.root + "/.panack_modules", source) {
                  Error(problem) => Error(problem),
                  Ok(archive) => {
                    result = if expected != "" && expected != archive.compressed_sha256 {
                      Error(package_problem("PKG_INTEGRITY", "archive contents do not match the SHA-256 checksum in panack.lock.json"))
                    } else { inspect_staged_archive(source, archive) }
                    match result { Ok(acquired) => Ok(acquired), Error(problem) => { closed = discard_archive(archive); Error(problem) } }
                  }
                }
              } }
            }
          }
        }
      }
    }
  }
}
