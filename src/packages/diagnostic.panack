// Package diagnostics are data until the public command boundary. Codes are
// assigned where a failure is detected, never inferred from rendered prose.
pub record ProblemContext { label: Str, value: Str }

pub record PackageProblem {
  code: Str,
  message: Str,
  phase: Str,
  reason: Str,
  help: Str,
  contexts: [ProblemContext]
}

pub pure package_problem(code: Str, message: Str): PackageProblem {
  mut phase = "finding dependencies"
  mut reason = "Panack could not finish checking the dependencies. It has stopped before using them."
  mut help = "Check the named dependencies in panack.json and correct the problem reported above, then retry the command."
  if code == "PKG_LOCK_MISSING" {
    phase = "checking panack.lock.json"
    reason = "panack.lock.json records the exact dependencies this project uses. Panack needs that record before it can build the project."
    help = "Run the command below to select the dependencies and create panack.lock.json. Review and commit that file with the project."
  } else if code == "PKG_LOCK_STALE" {
    phase = "checking panack.lock.json"
    reason = "The dependencies described by panack.json no longer match panack.lock.json."
    help = "If the edit was accidental, restore the previous panack.json. If it was intentional, review it before running panack deps update. Updating can select different package contents."
  } else if code == "PKG_LOCK_INVALID" {
    phase = "checking panack.lock.json"
    reason = "Panack cannot read a valid dependency record from panack.lock.json, so it cannot determine which packages to use."
    help = "Restore panack.lock.json from version control or obtain a valid copy from the project maintainer. Deleting it and creating a new lock may select different packages."
  } else if code == "PKG_CACHE_MISSING" {
    phase = "checking saved packages"
    reason = "Panack cannot find all the saved files needed to use the dependencies in panack.lock.json."
    help = "Run the command below to obtain the missing package without changing the versions or contents recorded in panack.lock.json. An internet connection is needed for remote packages."
  } else if code == "PKG_CACHE_INVALID" {
    phase = "checking saved packages"
    reason = "Panack could not verify the saved local packages against panack.lock.json. It will not use them for this build."
    help = "Run the command below to restore and check the packages recorded in panack.lock.json. Keep the lockfile unchanged so the repair uses the same package contents."
  } else if code == "PKG_INTEGRITY" {
    phase = "checking package contents"
    reason = "This package has different contents from those recorded in panack.lock.json. Panack has refused to use it."
    help = "Ask the package maintainer why the contents changed, or restore the original package contents. Use panack deps update only after you have reviewed and accepted the new contents."
  } else if code == "PKG_MANIFEST_MISSING" {
    phase = "finding panack.json"
    reason = "Panack looked for panack.json at the location shown above and could not find it. It needs that file to read the package definition."
    help = "Check the dependency path in the declaring panack.json and make sure the package contains panack.json at the location shown above."
  } else if code == "PKG_MANIFEST" {
    phase = "reading panack.json"
    reason = "Panack cannot load this package until the problem above is corrected."
    help = "Fix the reported problem in panack.json, then retry the command. If this is someone else's package, send them this error so they can fix it."
  } else if code == "PKG_CONTAINMENT" {
    phase = "checking package paths"
    reason = "The path would let this package read files outside the directory it is allowed to use. Panack has rejected it."
    help = "Change the dependency path so it stays inside its containing archive or Git repository. If the path belongs to a downloaded package, ask its maintainer to correct it."
  } else if code == "PKG_LAYOUT" {
    phase = "checking source directories"
    reason = "These packages would share source files because their source directories overlap. Panack requires a separate source directory for each package."
    help = "Check the source fields in the named packages' panack.json files. Move the source files or correct those fields so neither source directory contains the other."
  } else if code == "PKG_LIMIT" {
    phase = "checking size and count limits"
    reason = "Panack stopped because the operation exceeded the limit shown above."
    help = "Reduce the number or size of the affected files or dependencies to the stated limit. For a downloaded package, ask its maintainer for a smaller package."
  } else if code == "PKG_ARCHIVE" {
    phase = "unpacking the archive"
    reason = "Panack stopped while unpacking the archive. The specific failure is shown above."
    help = "Correct the reported problem before retrying the same command. If the archive needs to be replaced, obtain it from the package maintainer and review the changed contents before updating the lockfile."
  } else if code == "PKG_HTTP" {
    phase = "downloading the archive"
    reason = "Panack could not download the archive. No downloaded package has been accepted."
    help = "Check the failure above and retry the same command after correcting it. Keep panack.lock.json unchanged when restoring existing dependencies."
  } else if code == "PKG_HTTP_STATUS" {
    phase = "checking the download response"
    reason = "The server returned the HTTP status shown above instead of the requested archive."
    help = "Check the archive URL in panack.json. It must be directly downloadable without signing in. Ask the package maintainer to correct a missing or inaccessible download."
  } else if code == "PKG_REDIRECT" {
    phase = "following a download redirect"
    reason = "The server tried to send Panack to another address, but Panack could not follow that redirect."
    help = "Use a direct HTTPS download URL. It must not contain a username, password, query string (after ?) or fragment (after #). Ask the server maintainer to fix the redirect if the URL is already correct."
  } else if code == "PKG_GIT_RESOLVE" {
    phase = "looking up a Git branch or tag"
    reason = "Panack could not find a single Git commit for the requested branch, tag or commit ID."
    help = "Check the repository URL and the ref field in panack.json. To distinguish a branch from a tag with the same name, use refs/heads/<name> for a branch or refs/tags/<name> for a tag."
  } else if code == "PKG_GIT_FETCH" {
    phase = "preparing files from Git"
    reason = "Panack could not prepare the package files from this Git commit. The failure reported above is the information available from this operation."
    help = "If the message identifies a problem with the repository contents, ask its maintainer to fix it. If Git only reports a failed command, check connectivity and repository access; that status alone does not identify the cause. Retry the same command and keep the existing lockfile."
  } else if code == "PKG_GIT_REQUIRED" {
    phase = "finding Git"
    reason = "Panack needs Git to download this dependency. It could not find a supported Git installation."
    help = "Install Git 2.29 or newer and make sure git --version works in this terminal, then retry the command."
  } else if code == "PKG_PUBLICATION" {
    phase = "saving packages"
    reason = "Panack could not save the file or package named above. Earlier packages or the lockfile may already have been saved."
    help = "Check the reported filesystem error and available disk space. After fixing it, run panack deps restore to finish preparing the packages recorded in panack.lock.json."
  } else if code == "PKG_FILESYSTEM" {
    phase = "accessing files"
    reason = "Panack could not access the file or directory needed for this operation."
    help = "Check that the path exists and that your account can access it. Follow the specific filesystem error above; if it is a permission error, ask the directory owner to grant the required access."
  } else if code == "PKG_SELECTIVE" {
    phase = "checking selected dependencies"
    reason = "The requested update has been stopped. The lockfile has not been changed."
    help = "Check the dependency named above before retrying."
  } else if code == "PKG_TOOL" {
    phase = "checking the Panack installation"
    reason = "Panack could not complete an internal operation needed to verify this package."
    help = "Check that Panack and its required native libraries are installed correctly. Retry the command; if the problem persists, report this error with your Panack version and operating system."
  } else if code == "PKG_USAGE" {
    phase = "reading the command"
    reason = "Panack could not understand this package command."
    help = "Use panack deps lock to create a lock, panack deps update to accept dependency changes, or panack deps restore to restore recorded packages. Add --project /path/to/panack.json to select the project. Only restore accepts --offline."
  }
  PackageProblem(code, message, phase, reason, help, [])
}

// Use the known cause at the detection site, rather than listing all possible
// failures in the same error family.
pub pure explain_problem(problem: PackageProblem, reason: Str, help: Str): PackageProblem {
  PackageProblem(problem.code, problem.message, problem.phase, reason, help, problem.contexts)
}

pub pure problem_context(problem: PackageProblem, context: Str): PackageProblem {
  problem_label(problem, "Context", context)
}

pub pure problem_dependency(problem: PackageProblem, context: Str): PackageProblem {
  problem_label(problem, "Dependency", context)
}

pure problem_label(problem: PackageProblem, label: Str, context: Str): PackageProblem {
  mut contexts = [ProblemContext(label, context)]
  for existing in problem.contexts { contexts = contexts.append(existing) }
  PackageProblem(problem.code, problem.message, problem.phase, problem.reason, problem.help, contexts)
}

// Escape terminal controls in paths and supplied text. Do not render raw Git
// stderr or HTTP headers: those can contain server-controlled credentials.
pub pure diagnostic_text(text: Str): Str {
  mut safe = ""
  for index in 0..text.len() {
    character = text.slice(index, index + 1)
    encoded = character.encode_utf8()
    if character == "\n" { safe = safe + "\\n" }
    else if character == "\r" { safe = safe + "\\r" }
    else if character == "\t" { safe = safe + "\\t" }
    else if encoded.at(0) < 32 || encoded.at(0) == 127 || (encoded.length() == 2 && encoded.at(0) == 194 && encoded.at(1) >= 128 && encoded.at(1) <= 159) { safe = safe + "?" }
    else { safe = safe + character }
  }
  safe
}

pure diagnostic_quote(text: Str): Str {
  mut quoted = "'"
  for index in 0..text.len() {
    character = text.slice(index, index + 1)
    quoted = quoted + if character == "'" { "'\"'\"'" } else { character }
  }
  quoted + "'"
}

pub pure render_problem(problem: PackageProblem, manifest: Str, operation: Str): Str {
  mut output = "panack: error[" + problem.code + "]: " + diagnostic_text(problem.message) + "\n"
  if manifest != "" { output = output + "\n  Project: " + diagnostic_text(manifest) + "\n" }
  output = output + "  Operation: " + diagnostic_text(operation) + "\n  Phase: " + problem.phase + "\n"
  for context in problem.contexts { output = output + "  " + context.label + ": " + diagnostic_text(context.value) + "\n" }
  output = output + "\n" + problem.reason + "\n\n" + problem.help
  if manifest != "" && diagnostic_text(manifest) == manifest {
    if problem.code == "PKG_LOCK_MISSING" {
      output = output + "\n\n  panack deps lock --project " + diagnostic_quote(manifest)
    } else if problem.code == "PKG_CACHE_MISSING" || problem.code == "PKG_CACHE_INVALID" {
      output = output + "\n\n  panack deps restore --project " + diagnostic_quote(manifest)
    }
  }
  output
}

pub pure package_result[T](result: Result[T, Str], code: Str): Result[T, PackageProblem] {
  match result { Error(message) => Error(package_problem(code, message)), Ok(value) => Ok(value) }
}

pub pure host_detail(code: Str): Str {
  if code == "not_found" { "the path does not exist (not_found)" }
  else if code == "permission_denied" { "your account does not have permission (permission_denied)" }
  else if code == "already_exists" { "the destination already exists (already_exists)" }
  else if code == "not_directory" { "a path component is not a directory (not_directory)" }
  else if code == "is_directory" { "the path is a directory, but a file is required (is_directory)" }
  else if code == "not_empty" { "the directory is not empty (not_empty)" }
  else if code == "symlink_loop" { "the path contains a symbolic-link loop (symlink_loop)" }
  else if code == "io_error" { "the operating system could not complete the file operation (io_error)" }
  else if code == "launch_failed" { "the process could not be started; check that the executable exists and can be run (launch_failed)" }
  else if code == "invalid_path" { "the path is not valid for this operation (invalid_path)" }
  else if code == "invalid_parent" { "the parent directory could not be opened safely (invalid_parent)" }
  else if code == "parent_changed" { "the parent directory was replaced during this command (parent_changed)" }
  else if code == "stage_changed" { "the temporary package directory was replaced during this command (stage_changed)" }
  else if code == "destination_conflict" { "the destination is not a replaceable package directory (destination_conflict)" }
  else if code == "publication_failed" { "the filesystem could not move the prepared package into its destination (publication_failed)" }
  else if code == "cleanup_failed" { "the filesystem could not remove temporary files (cleanup_failed)" }
  else if code == "create_failed" { "the filesystem could not create the temporary directory (create_failed)" }
  else if code == "open_failed" { "the filesystem could not open the temporary directory (open_failed)" }
  else if code == "resource_limit" { "the operation reached a system resource limit (resource_limit)" }
  else if code == "unsupported" || code == "unsupported_host" { "this operation is not supported by this Panack installation (" + code + ")" }
  else if code == "filesystem_error" { "the filesystem operation failed; no more specific cause was reported (filesystem_error)" }
  else { "the system reported " + code }
}
