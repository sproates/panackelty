pub import project/src/packages/diagnostic::{PackageProblem}
import project/src/packages/diagnostic::{publication_problem, host_detail, package_problem, problem_context, package_result, problem_label, explain_problem}
pub import project/src/packages/acquisition::{AcquisitionOptions}
import project/src/packages/acquisition::{ensure_directory, locked_edge, locked_package, verify_cache_state}
pub import project/src/packages/git_snapshot::{GitSource}
import project/src/packages/git_snapshot::{stage_git_commit, git_source_key}
import project/src/packages/git_refs::{git_executable, resolve_git_ref}
import project/src/packages/git_cache::{verify_git_cache, git_package_subdir}
pub import project/src/packages/manifest::{PackageManifestDependency}
import project/src/project_model/package_manifest::{manifest_json_string_field}
import stdlib/path as path
import stdlib/environment as environment
import stdlib/filesystem_stage as staging

pub record AcquiredGit {
  source: GitSource,
  selector: Str,
  refreshed: Bool,
  root: Str,
  key: Str,
  tree: Str,
  links: Map[Str, Str],
  stage: Option[Nat]
}

pure checked_path(value: Str): Path { path.from_text(value).value_or(path.current()) }

pub pure git_containing(root: Str, sources: [AcquiredGit]): Option[AcquiredGit] {
  mut found: Option[AcquiredGit] = None()
  for source in sources {
    if root == source.root || root.starts_with_at(source.root + "/", 0) { found = Some(source) }
  }
  found
}

pub pure git_relative(root: Str, source: AcquiredGit): Str {
  if root == source.root { "." } else { root.slice(source.root.len() + 1, root.len()) }
}

pub pure git_package_root(source: AcquiredGit, subdir: Str): Result[Str, PackageProblem] {
  match git_package_subdir(subdir, source.links) {
    Error(problem) => Error(problem),
    Ok(relative) => Ok(if relative == "." { source.root } else { source.root + "/" + relative })
  }
}

locked_git(options: AcquisitionOptions, declaration: PackageManifestDependency,
    owner: Str): Result[GitSource, PackageProblem] {
  match options.locked {
    None() => Error(package_problem("PKG_LOCK_MISSING", "missing Git lock")),
    Some(lock) => match locked_edge(lock, owner, declaration.alias) {
      None() => Error(package_problem("PKG_LOCK_STALE", "Cannot use this Git dependency because the lockfile does not record the dependency.")),
      Some(edge) => {
        kind = manifest_json_string_field(edge.source, "kind").value_or("")
        url = manifest_json_string_field(edge.source, "url").value_or("")
        format = manifest_json_string_field(edge.source, "object_format").value_or("")
        commit = manifest_json_string_field(edge.source, "commit").value_or("")
        if kind != "git" {
          Error(package_problem("PKG_LOCK_STALE", "Cannot use this Git dependency because the lockfile records a different source type for the dependency."))
        } else if url != declaration.path {
          Error(package_problem("PKG_LOCK_STALE", "Cannot use this Git dependency because its repository URL differs from the URL recorded in the lockfile."))
        } else { Ok(GitSource(url, format, commit)) }
      }
    }
  }
}

expected_tree(options: AcquisitionOptions, owner: Str, alias: Str): Result[Str, PackageProblem] {
  match options.locked {
    None() => Error(package_problem("PKG_LOCK_MISSING", "missing Git lock")),
    Some(lock) => match locked_edge(lock, owner, alias) {
      None() => Error(package_problem("PKG_GRAPH", "missing Git edge")),
      Some(edge) => match locked_package(lock, edge.package) {
        None() => Error(package_problem("PKG_GRAPH", "missing Git package")),
        Some(package) => match package.tree_sha256 {
          None() => Error(package_problem("PKG_GRAPH", "missing Git tree digest")), Some(tree) => Ok(tree)
        }
      }
    }
  }
}

acquire_snapshot(options: AcquisitionOptions, source: GitSource, selector: Str,
    expected: Str, previous: [AcquiredGit]): Result[AcquiredGit, PackageProblem] {
  mut known: Option[AcquiredGit] = None()
  for candidate in previous { if candidate.source == source { known = Some(candidate) } }
  match known {
    Some(candidate) => if expected != "" && candidate.tree != expected { Error(package_problem("PKG_GRAPH", "the lockfile records different checksums for the same Git commit")) }
      else { Ok(AcquiredGit(source, selector, options.refresh, candidate.root, candidate.key, candidate.tree, candidate.links, candidate.stage)) },
    None() => match package_result(git_source_key(source), "PKG_FILESYSTEM") {
      Error(problem) => Error(problem),
      Ok(key) => {
        parent = options.root + "/.panack_modules/.sources"
        root = parent + "/" + key
        cached = if expected == "" { Error(package_problem("PKG_GRAPH", "Git refresh requires acquisition")) }
          else {
            state = match options.locked { None() => Error(package_problem("PKG_LOCK_MISSING", "missing lock")), Some(lock) => verify_cache_state(options.root, lock) }
            match state {
              Error(problem) => Error(problem),
              Ok(completed_1) => match ensure_directory(parent, false) {
                Error(problem) => Error(problem),
                Ok(completed_2) => match ensure_directory(root, false) {
                  Error(problem) => Error(problem),
                  Ok(completed_3) => verify_git_cache(root, expected)
                }
              }
            }
          }
        match cached {
          Ok(links) => Ok(AcquiredGit(source, selector, options.refresh, root, key, expected, links, None())),
          Error(cache_problem) => if !options.materialize || options.offline {
            Error(problem_context(cache_problem, "Git cache; this command cannot download replacement content"))
          } else {
            match ensure_directory(options.root + "/.panack_modules", true) {
              Error(problem) => Error(problem),
              Ok(completed_4) => match ensure_directory(parent, true) {
                Error(problem) => Error(problem),
                Ok(completed_5) => match git_executable() {
                  Error(problem) => Error(problem),
                  Ok(executable) => match stage_git_commit(checked_path(parent), executable, source, environment.get("CURL_CA_BUNDLE")) {
                    Error(problem) => Error(problem_label(problem, "Requested commit", source.commit)),
                    Ok(snapshot) => {
                      result = if expected != "" && snapshot.tree_sha256 != expected { Error(problem_label(problem_label(explain_problem(package_problem("PKG_INTEGRITY", "Cannot use the downloaded Git files because their checksum does not match the lockfile."),
                        "Panack has refused to use those files.", "Ask the package maintainer to investigate the mismatch. Keep the existing lockfile while investigating; updating the lockfile would accept a new dependency selection."), "Expected checksum", expected), "Downloaded checksum", snapshot.tree_sha256)) }
                        else { match verify_git_cache(snapshot.root, snapshot.tree_sha256) {
                          Error(problem) => Error(if problem.code.starts_with_at("PKG_CACHE_", 0) {
                            explain_problem(package_problem("PKG_INTEGRITY", "Cannot use the prepared Git package because verification failed."),
                              if problem.code == "PKG_CACHE_CHECKSUM" { "The prepared files do not match the checksum calculated while preparing the Git package. Panack has refused to publish those files." } else { problem.message },
                              "Retry your command. If the failure persists, report this error with your Panack version and repository URL. Keep the existing lockfile while investigating.")
                          } else { problem }),
                          Ok(links) => Ok(AcquiredGit(source, selector, options.refresh, snapshot.root, key, snapshot.tree_sha256, links, Some(snapshot.handle)))
                        } }
                      match result {
                        Ok(acquired) => Ok(acquired),
                        Error(problem) => { closed = staging.close(snapshot.handle); Error(problem) }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

pub acquire_git(options: AcquisitionOptions, declaration: PackageManifestDependency,
    owner: Str, previous: [AcquiredGit]): Result[AcquiredGit, PackageProblem] {
  mut known: Option[GitSource] = None()
  for candidate in previous {
    if candidate.refreshed && candidate.source.url == declaration.path && candidate.selector == declaration.selector {
      known = Some(candidate.source)
    }
  }
  selected = if !options.refresh { locked_git(options, declaration, owner) }
    else { match known {
      Some(source) => Ok(source),
      None() => match ensure_directory(options.root + "/.panack_modules", true) {
        Error(problem) => Error(problem),
        Ok(completed_6) => match git_executable() {
          Error(problem) => Error(problem),
          Ok(executable) => resolve_git_ref(checked_path(options.root + "/.panack_modules"), executable,
            declaration.path, declaration.selector, environment.get("CURL_CA_BUNDLE"))
        }
      }
    } }
  match selected {
    Error(problem) => Error(problem),
    Ok(source) => match if options.refresh { Ok("") } else { expected_tree(options, owner, declaration.alias) } {
      Error(problem) => Error(problem),
      Ok(expected) => acquire_snapshot(options, source, declaration.selector, expected, previous)
    }
  }
}

pub publish_git(root: Str, sources: [AcquiredGit]): Result[Unit, PackageProblem] {
  mut published: Set[Str] = set()
  mut failure: Option[PackageProblem] = None()
  for source in sources {
    if failure == None() && !published.has(source.key) {
      match source.stage {
        None() => {},
        Some(handle) => match staging.publish(handle, checked_path(source.key), true) {
          Error(problem) => { failure = Some(publication_problem(root + "/.panack_modules/.sources/" + source.key, problem.code, false)) },
          Ok(completed_7) => { published = published.add(source.key) }
        }
      }
    }
  }
  match failure { Some(problem) => Error(problem), None() => Ok(()) }
}
