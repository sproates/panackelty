pub import project/src/packages/diagnostic::{PackageProblem}
import project/src/packages/diagnostic::{package_problem, problem_label, explain_problem}

pure link_components(value: Str): [Str] {
  mut parts: [Str] = []
  mut start: Nat = 0
  for index in 0..value.len() + 1 {
    if index == value.len() || value[index] == "/" {
      parts = parts.append(value.slice(start, index))
      start = index + 1
    }
  }
  parts
}

pure join_components(parts: [Str]): Str {
  mut text: Str = ""
  for part in parts {
    if text != "" { text = text + "/" }
    text = text + part
  }
  text
}

pure link_relative_target(value: Str): Bool {
  mut valid: Bool = value != "" && !value.starts_with_at("/", 0) && value.encode_utf8().length() <= 4096
  data = value.encode_utf8()
  for index in 0..data.length() {
    if data.at(index) == 0 || data.at(index) == 92 || data.at(index) == 58 { valid = false }
  }
  valid
}

// Resolve against the complete snapshot's link inventory before creating links.
// Parent components are handled after link expansion, matching filesystem order.
// Dangling targets inside the root are allowed; cycles and escapes are not.
pub pure git_resolve_link(name: Str, target: Str, links: Map[Str, Str]): Result[Str, PackageProblem] {
  mut resolved: [Str] = []
  original: [Str] = link_components(name)
  for index in 0..original.len() {
    if index + 1 < original.len() { resolved = resolved.append(original[index]) }
  }
  mut pending: [Str] = link_components(target)
  mut position: Nat = 0
  mut hops: Nat = 0
  mut valid: Bool = link_relative_target(target)
  mut failure = link_target_problem(name, target)
  while valid && position < pending.len() {
    component: Str = pending[position]
    position = position + 1
    if component == ".." {
      if resolved.len() == 0 { valid = false; failure = problem_label(package_problem("PKG_SYMLINK_ESCAPE", "Cannot prepare the Git package because a symbolic link points outside the repository."), "Symbolic link", name) }
      else {
        mut parent: [Str] = []
        for index in 0..resolved.len() {
          if index + 1 < resolved.len() { parent = parent.append(resolved[index]) }
        }
        resolved = parent
      }
    } else if component != "" && component != "." {
      candidate: Str = join_components(resolved.append(component))
      if links.has(candidate) {
        hops = hops + 1
        next: Str = links.get(candidate)
        if hops > 40 { valid = false; failure = problem_label(explain_problem(package_problem("PKG_SYMLINK_LIMIT", "Cannot prepare the Git package because resolving a symbolic link exceeded Panack's limit of 40 links."), "The limit does not establish that the links form a cycle.", "If you maintain this package, shorten the link chain and check for links that point back to each other. Otherwise, ask the package maintainer for a corrected package."), "Symbolic link", name) }
        else if !link_relative_target(next) { valid = false; failure = link_target_problem(candidate, next) }
        else {
          mut expanded: [Str] = link_components(next)
          for index in position..pending.len() { expanded = expanded.append(pending[index]) }
          pending = expanded
          position = 0
        }
      } else { resolved = resolved.append(component) }
    }
  }
  if valid { Ok(if resolved.len() == 0 { "." } else { join_components(resolved) }) }
  else { Error(failure) }
}

pub pure git_link_beneath(name: Str, target: Str, links: Map[Str, Str]): Bool {
  match git_resolve_link(name, target, links) { Ok(value) => true, Error(problem) => false }
}

pure link_target_problem(name: Str, target: Str): PackageProblem {
  mut reason = "the target is not a supported relative path"
  if target == "" { reason = "the target is empty" }
  else if target.starts_with_at("/", 0) { reason = "the target is an absolute path" }
  else if target.encode_utf8().length() > 4096 { reason = "the target exceeds Panack's 4096-byte limit" }
  else {
    data = target.encode_utf8()
    for index in 0..data.length() {
      if data.at(index) == 0 { reason = "the target contains a NUL character" }
      else if data.at(index) == 92 { reason = "the target contains a backslash" }
      else if data.at(index) == 58 { reason = "the target contains a colon" }
    }
  }
  problem_label(package_problem("PKG_SYMLINK_INVALID", "Cannot prepare the Git package because " + reason + "."), "Symbolic link", name)
}
