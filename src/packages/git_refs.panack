pub import project/src/packages/diagnostic::{PackageProblem}
import project/src/packages/diagnostic::{package_problem, problem_label, problem_value, explain_problem, host_detail}
pub import project/src/packages/git_snapshot::{GitSource}
import project/src/packages/git_process::{GitContext, git_command, git_version_output}
import project/src/packages/git_inventory::{git_object_id}
import project/src/project_model/utf8::{valid_utf8}
import stdlib/filesystem_stage as staging
import stdlib/filesystem as filesystem
import stdlib/filesystem::{FileKind.RegularFile, FileKind.SymbolicLink}
import stdlib/environment as environment
import stdlib/path as path
import stdlib/bytes as byte_buffer

pub git_executable(): Result[Path, PackageProblem] {
  search = environment.get("PATH").value_or("/usr/bin:/bin")
  mut start: Nat = 0
  mut found: Option[Path] = None()
  for index in 0..search.len() + 1 {
    if index == search.len() || search[index] == ":" {
      directory = search.slice(start, index)
      if found == None() && directory.starts_with_at("/", 0) {
        match path.from_text(directory + "/git") {
          Error(problem) => {},
          Ok(candidate) => match filesystem.metadata(candidate) {
            Error(problem) => {},
            Ok(info) => if info.kind == RegularFile() || info.kind == SymbolicLink() { found = Some(candidate) }
          }
        }
      }
      start = index + 1
    }
  }
  match found {
    None() => Error(package_problem("PKG_GIT_REQUIRED", "Cannot obtain the Git dependency because Panack could not find Git on PATH.")),
    Some(executable) => {
      result = match git_version_output(executable) {
        Error(problem) => Error(if problem.code == "PKG_GIT_FETCH" {
          explain_problem(problem, "Panack could not query the installed Git version.", "Check that the Git executable can run git --version, then retry your command.")
        } else { problem }),
        Ok(output) => match check_git_version(output) { Error(problem) => Error(problem), Ok(done) => Ok(executable) }
      }
      match result {
        Error(problem) => Error(problem_label(problem, "Git executable", executable.to_text().value_or(""))),
        Ok(value) => Ok(value)
      }
    }
  }
}

// Exact matches only. An ambiguous short branch/tag name is rejected. Annotated
// tags use their peeled commit; stage_git_commit subsequently verifies its type.
pub pure parse_git_refs(data: Bytes, url: Str, selector: Str): Result[GitSource, PackageProblem] {
  mut failure: Option[PackageProblem] = None()
  mut branch: Str = ""
  mut tag: Str = ""
  mut peeled: Str = ""
  mut head: Str = ""
  if !valid_utf8(data) { failure = Some(package_problem("PKG_GIT_RESPONSE", "Cannot understand Git's reference listing because the listing is not valid UTF-8 text.")) }
  text = data.decode_utf8()
  mut start: Nat = 0
  for index in 0..text.len() {
    if text[index] == "\n" && failure == None() {
      line = text.slice(start, index)
      mut tab: Nat = line.len()
      for cursor in 0..line.len() { if line[cursor] == "\t" && tab == line.len() { tab = cursor } }
      if tab == line.len() { failure = Some(package_problem("PKG_GIT_RESPONSE", "Cannot understand Git's reference listing because a record has no tab separator.")) }
      else {
        object = line.slice(0, tab)
        name = line.slice(tab + 1, line.len())
        if !git_object_id(object, 40) && !git_object_id(object, 64) {
          failure = Some(package_problem("PKG_GIT_RESPONSE", "Cannot understand Git's reference listing because a record has no complete object ID."))
        } else {
          if name == "HEAD" { head = object }
          if name == selector || name == "refs/heads/" + selector {
            if name.starts_with_at("refs/tags/", 0) { tag = object }
            else { branch = object }
          }
          if name == "refs/tags/" + selector { tag = object }
          if name == "refs/tags/" + selector + "^{}" || name == selector + "^{}" { peeled = object }
        }
      }
      start = index + 1
    }
  }
  if failure == None() && start != text.len() { failure = Some(package_problem("PKG_GIT_RESPONSE", "Cannot understand Git's reference listing because the final record is incomplete.")) }
  if failure == None() && branch != "" && tag != "" { failure = Some(package_problem("PKG_GIT_REF_AMBIGUOUS", "Cannot select the Git reference because the name matches both a branch and a tag.")) }
  selected = if selector == "" { head } else if branch != "" { branch }
    else if peeled != "" { peeled } else { tag }
  if failure == None() && selected == "" { failure = Some(missing_git_ref(selector)) }
  match failure {
    Some(problem) => Error(problem_label(problem, "Requested reference", if selector == "" { "default branch (HEAD)" } else { selector })),
    None() => Ok(GitSource(url, if selected.len() == 40 { "sha1" } else { "sha256" }, selected))
  }
}

pub resolve_git_ref(parent: Path, executable: Path, url: Str, selector: Str,
    certificate: Option[Str]): Result[GitSource, PackageProblem] {
  if git_object_id(selector, 40) || git_object_id(selector, 64) {
    Ok(GitSource(url, if selector.len() == 40 { "sha1" } else { "sha256" }, selector))
  } else {
    match staging.begin(parent) {
      Error(problem) => Error(package_problem("PKG_FILESYSTEM", "Panack cannot create a temporary directory to look up the Git branch or tag" + ": " + host_detail(problem.code))),
      Ok(handle) => {
        result = match staging.path(handle) {
          Error(problem) => Error(package_problem("PKG_FILESYSTEM", "Panack cannot locate the temporary directory used to look up the Git branch or tag" + ": " + host_detail(problem.code))),
          Ok(repository) => {
            context = GitContext(executable, repository, repository.to_text().value_or(""), certificate)
            patterns = if selector == "" { ["HEAD"] }
              else if selector.starts_with_at("refs/", 0) { [selector, selector + "^{}"] }
              else { ["refs/heads/" + selector, "refs/tags/" + selector, "refs/tags/" + selector + "^{}"] }
            mut arguments = ["ls-remote", "--exit-code", "--", url]
            for pattern in patterns { arguments = arguments.append(pattern) }
            match git_command(context, arguments, byte_buffer.empty()) {
              Error(problem) => Error(if problem.code == "PKG_GIT_FETCH" && problem_value(problem, "Exit status") == "2" {
                problem_label(missing_git_ref(selector), "Requested reference", if selector == "" { "default branch (HEAD)" } else { selector })
              } else { problem_label(problem, "Git operation", "looking up the requested reference") }),
              Ok(data) => parse_git_refs(data, url, selector)
            }
          }
        }
        closed = staging.close(handle)
        match closed { Error(problem) => Error(package_problem("PKG_FILESYSTEM", "Panack cannot remove the temporary directory used to look up the Git branch or tag" + ": " + host_detail(problem.code))), Ok(done) => result }
      }
    }
  }
}

pure missing_git_ref(selector: Str): PackageProblem {
  if selector == "" {
    explain_problem(package_problem("PKG_GIT_REF_NOT_FOUND", "Cannot select the Git dependency because Git did not return a default branch."), "",
      "Set ref to an existing branch, tag or complete commit ID, or ask the repository maintainer to configure a default branch.")
  } else { package_problem("PKG_GIT_REF_NOT_FOUND", "Cannot select the Git dependency because Git did not find the requested branch or tag.") }
}

// Parse only the numeric release version. Vendor suffixes do not determine
// capability, and unrecognisable output is never called an old Git version.
pub pure check_git_version(data: Bytes): Result[Unit, PackageProblem] {
  text = data.decode_utf8()
  mut valid = valid_utf8(data) && text.starts_with_at("git version ", 0) && text.ends_with("\n")
  for index in 0..text.len() {
    if text[index] == "\n" && index + 1 != text.len() { valid = false }
  }
  mut cursor: Nat = 12
  mut parts: [Nat] = []
  for part in 0..3 {
    mut value: Nat = 0
    mut digits: Nat = 0
    mut reading = true
    while valid && reading && cursor < text.len() {
      character = text[cursor]
      if character >= "0" && character <= "9" {
        if digits >= 6 { valid = false }
        else {
          for digit in 0..10 { if character == "${digit}" { value = value * 10 + digit } }
          digits = digits + 1
          cursor = cursor + 1
        }
      } else { reading = false }
    }
    if digits == 0 { valid = false }
    parts = parts.append(value)
    if part < 2 {
      if cursor < text.len() && text[cursor] == "." { cursor = cursor + 1 }
      else { valid = false }
    }
  }
  if cursor >= text.len() || !(text[cursor] == "\n" || text[cursor] == " " || text[cursor] == ".") { valid = false }
  if !valid { Error(package_problem("PKG_GIT_VERSION_UNKNOWN", "Cannot determine the Git version because Git returned an unrecognisable version response.")) }
  else if parts[0] < 2 || (parts[0] == 2 && parts[1] < 29) {
    major = parts[0]
    minor = parts[1]
    patch = parts[2]
    Error(problem_label(package_problem("PKG_GIT_VERSION", "Cannot obtain the Git dependency because the installed Git version is older than 2.29."), "Installed Git version", "${major}.${minor}.${patch}"))
  } else { Ok(()) }
}
