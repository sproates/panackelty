import project/src/packages/git_acquisition::{AcquiredGit, git_containing, git_relative, git_package_root}
import project/src/packages/manifest::{parse_package_manifest, PackageManifest, PackageManifestDependency}
import stdlib/compiler_paths as paths
pub import project/src/packages/project_graph::{ManifestProject}
import project/src/packages/project_graph::{package_project_from_manifest}
import project/src/project_model/resolved_project::{ResolvedPackage, ResolvedProject}
import project/src/project_model/package_manifest::{
  ManifestJsonMember,
  ManifestJsonValue.ManifestJsonObject, ManifestJsonValue.ManifestJsonString
}
pub import project/src/packages/lock::{PackageLock}
import project/src/packages/lock::{PackageLockPackage, PackageLockEdge,
  parse_package_lock, serialize_package_lock, normalize_dependency_path}
import project/src/packages/sha256::{sha256_bytes}
import project/src/packages/acquisition::{ArchiveSource}
import stdlib/environment as environment
import stdlib/path as path
import stdlib/filesystem as filesystem
import stdlib/bounded_filesystem as bounded_filesystem
import stdlib/filesystem::{FileKind.RegularFile}
import stdlib/package_filesystem as package_filesystem

record LockedManifest {
  manifest: PackageManifest,
  digest: Str
}

read_locked_manifest(package: ResolvedPackage, toolchain: Str): Result[LockedManifest, Str] {
  match path.from_text(package.package_root) {
    Error(problem) => Error("invalid package root"),
    Ok(root) => match path.from_text("panack.json") {
      Error(problem) => Error("invalid manifest name"),
      Ok(relative) => match package_filesystem.read_beneath(root, relative, 65536) {
        Error(problem) => Error("cannot read dependency manifest: " + package.package_root),
        Ok(read) => if read.identity != package.identity {
          Error("package root changed while reading its lock identity")
        } else {
          match parse_package_manifest(read.contents, toolchain) {
            Error(problem) => Error(problem.message),
            Ok(manifest) => if manifest.package != package.name || manifest.version != package.version ||
              paths.resolve(paths.join(package.package_root, manifest.source)) != package.source_root ||
              manifest.exports != package.exports ||
              match manifest.entry {
                None() => package.entry != None(),
                Some(entry) => package.entry != Some(paths.resolve(paths.join(package.source_root, entry)))
              } {
              Error("package identity changed while resolving dependencies")
            } else {
              match sha256_bytes(read.contents) {
                Error(problem) => Error(problem),
                Ok(hash) => Ok(LockedManifest(manifest, hash))
              }
            }
          }
        }
      }
    }
  }
}

pure local_edges(
  package: ResolvedPackage,
  declarations: [PackageManifestDependency],
  archives: [ArchiveSource],
  gits: [AcquiredGit],
  packages: [ResolvedPackage]
): [PackageLockEdge] {
  mut edges: [PackageLockEdge] = []
  for declaration in declarations {
    for resolved in package.dependencies {
      if resolved.alias == declaration.alias {
        mut fields: [ManifestJsonMember] = [
          ManifestJsonMember("kind", ManifestJsonString(declaration.kind), 0),
          ManifestJsonMember(if declaration.path.starts_with_at("https://", 0) { "url" } else { "path" },
            ManifestJsonString(if declaration.path.starts_with_at("https://", 0) { declaration.path } else { normalize_dependency_path(declaration.path) }), 0)
        ]
        if declaration.kind == "archive" {
          for archive in archives {
            if resolved.target == archive.name + "@" + archive.version {
              fields = fields.append(ManifestJsonMember("archive_sha256", ManifestJsonString(archive.archive_hash), 0))
            }
          }
        }
        for target in packages {
          if target.id == resolved.target {
            match git_containing(target.package_root, gits) {
              None() => {},
              Some(snapshot) => {
                fields = [
                  ManifestJsonMember("kind", ManifestJsonString("git"), 0),
                  ManifestJsonMember("url", ManifestJsonString(snapshot.source.url), 0),
                  ManifestJsonMember("subdir", ManifestJsonString(git_relative(target.package_root, snapshot)), 0),
                  ManifestJsonMember("object_format", ManifestJsonString(snapshot.source.object_format), 0),
                  ManifestJsonMember("commit", ManifestJsonString(snapshot.source.commit), 0)
                ]
              }
            }
          }
        }
        edges = edges.append(PackageLockEdge(declaration.alias, resolved.target, ManifestJsonObject(fields)))
      }
    }
  }
  edges
}

pub current_local_lock(project: ManifestProject): Result[PackageLock, Str] {
  toolchain: Str = environment.get("PANACKELTY_VERSION").value_or("")
  resolved: ResolvedProject = package_project_from_manifest(project, project.dependencies, toolchain)
  mut root_hash: Str = ""
  mut root_edges: [PackageLockEdge] = []
  mut packages: [PackageLockPackage] = []
  mut failure: Option[Str] = None()
  for package in resolved.packages {
    if failure == None() {
      match read_locked_manifest(package, toolchain) {
        Error(problem) => { failure = Some(problem) },
        Ok(read) => {
          for declaration in read.manifest.dependencies {
            source: Str = if declaration.path.starts_with_at("https://", 0) { declaration.path }
              else { paths.resolve(paths.join(package.package_root, declaration.path)) }
            mut agrees: Bool = false
            for edge in package.dependencies {
              if edge.alias == declaration.alias {
                for target in resolved.packages {
                  if target.id == edge.target {
                    if declaration.kind == "git" {
                      for snapshot in project.gits {
                        if snapshot.source.url == declaration.path {
                          match git_package_root(snapshot, declaration.subdir) {
                            Error(problem) => {}, Ok(root) => { agrees = agrees || root == target.package_root }
                          }
                        }
                      }
                    } else if declaration.kind == "path" {
                      match git_containing(package.package_root, project.gits) {
                        None() => { agrees = source == target.package_root },
                        Some(snapshot) => match git_package_root(snapshot, git_relative(package.package_root, snapshot) + "/" + declaration.path) {
                          Error(problem) => {}, Ok(root) => { agrees = root == target.package_root }
                        }
                      }
                    } else { for archive in project.archives {
                      agrees = agrees || (archive.root == target.package_root && archive.source == source)
                    } }
                  }
                }
              }
            }
            if !agrees { failure = Some("dependency source changed while resolving graph") }
          }
          edges: [PackageLockEdge] = local_edges(package, read.manifest.dependencies, project.archives, project.gits, resolved.packages)
          if edges.len() != package.dependencies.len() {
            failure = Some("package manifest changed while constructing lock graph")
          } else if package.id == resolved.root {
            root_hash = read.digest
            root_edges = edges
          } else {
            mut tree: Option[Str] = None()
            for archive in project.archives { if archive.root == package.package_root { tree = Some(archive.tree_hash) } }
            match git_containing(package.package_root, project.gits) {
              None() => {}, Some(snapshot) => { tree = Some(snapshot.tree) }
            }
            packages = packages.append(PackageLockPackage(
              package.name, package.version, read.digest, tree, edges
            ))
          }
        }
      }
    }
  }
  match failure {
    Some(problem) => Error(problem),
    None() => Ok(PackageLock(project.package, project.version, root_hash, toolchain, root_edges, packages))
  }
}

pub read_local_lock(root: Str): Result[Option[PackageLock], Str] {
  match path.from_text(root + "/panack.lock.json") {
    Error(problem) => Error("invalid lock path"),
    Ok(lock_path) => match filesystem.metadata(lock_path) {
      Error(problem) => if problem.code == "not_found" { Ok(None()) } else { Error("cannot inspect lockfile") },
      Ok(metadata) => if metadata.kind != RegularFile() {
        Error("lockfile must be a regular file, not a symlink")
      } else {
        match filesystem.read(lock_path, 1048576) {
          Error(problem) => Error("cannot read lockfile"),
          Ok(data) => match parse_package_lock(data) {
            Error(problem) => Error("invalid lockfile: " + problem.message),
            Ok(lock) => Ok(Some(lock))
          }
        }
      }
    }
  }
}

pub write_local_lock(root: Str, lock: PackageLock): Result[Unit, Str] {
  match path.from_text(root + "/panack.lock.json") {
    Error(problem) => Error("invalid lock path"),
    Ok(destination) => match bounded_filesystem.atomic_write(destination, serialize_package_lock(lock).encode_utf8()) {
      Error(problem) => Error("cannot atomically publish lockfile: " + problem.code),
      Ok(unit) => Ok(())
    }
  }
}

pub pure locks_match(left: PackageLock, right: PackageLock): Bool {
  serialize_package_lock(left) == serialize_package_lock(right)
}

pub verify_local_lock(project: ManifestProject): Result[Unit, Str] {
  if project.dependencies.len() == 0 {
    Ok(())
  } else {
    match read_local_lock(project.package_root) {
      Error(problem) => Error(problem),
      Ok(existing) => match existing {
        None() => Error("missing lockfile; run panack deps lock"),
        Some(lock) => match current_local_lock(project) {
          Error(problem) => Error(problem),
          Ok(current) => if locks_match(lock, current) {
            Ok(())
          } else {
            Error("lockfile is stale: project or dependency manifest changed; run panack deps update")
          }
        }
      }
    }
  }
}
