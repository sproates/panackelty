import project/src/packages/local_lock::{current_local_lock, read_local_lock, write_local_lock, locks_match, verify_local_lock}
import project/src/packages/project_graph::{ManifestProject, read_manifest_project, package_project_from_manifest}
import project/src/project_model/resolved_project::{ResolvedProject, serialize_resolved_project}
import stdlib/environment as std_environment
import stdlib/host as std_host

package_tool_usage(): Str {
  "usage: panack-packages prepare --project panack.json"
}

package_tool_error(message: Str): Nat {
  std_host.stderr("panack: ${message}")
  1
}

package_tool_prepare(manifest: Str): Nat {
  match read_manifest_project(manifest) {
    Error(message) => package_tool_error(message),
    Ok(project) => match verify_local_lock(project) {
      Error(problem) => package_tool_error(problem),
      Ok(unit) => {
      toolchain: Str = std_environment.get("PANACKELTY_VERSION").value_or("")
      if toolchain == "" {
        package_tool_error("running toolchain version is unavailable")
      } else {
        resolved: ResolvedProject = package_project_from_manifest(
          project, project.dependencies, toolchain
        )
        std_host.stdout(serialize_resolved_project(resolved))
        0
      }
      }
    }
  }
}

package_tool_command(arguments: [Str]): Nat {
  if arguments.len() == 3 && arguments[0] == "prepare" &&
      arguments[1] == "--project" && arguments[2] != "" {
    package_tool_prepare(arguments[2])
  } else if arguments.len() >= 4 && arguments[0] == "deps" && arguments[2] == "--project" {
    package_tool_dependencies(arguments)
  } else {
    package_tool_error(package_tool_usage())
  }
}

package_tool_dependencies(arguments: [Str]): Nat {
  operation: Str = arguments[1]
  valid: Bool = (operation == "lock" || operation == "update" || operation == "restore") &&
    (arguments.len() == 4 || (operation == "restore" && arguments.len() == 5 && arguments[4] == "--offline"))
  if !valid {
    package_tool_error("usage: deps lock|update|restore --project panack.json [--offline]")
  } else {
    match read_manifest_project(arguments[3]) {
      Error(problem) => package_tool_error(problem),
      Ok(project) => match read_local_lock(project.package_root) {
        Error(problem) => package_tool_error(problem),
        Ok(existing) => match current_local_lock(project) {
          Error(problem) => package_tool_error(problem),
          Ok(current) => {
            mut failure: Option[Str] = None()
            mut write: Bool = operation == "update"
            if operation != "update" {
              match existing {
                None() => if operation == "lock" { write = true } else {
                  failure = Some("missing lockfile; run panack deps lock")
                },
                Some(lock) => if !locks_match(lock, current) {
                  failure = Some("lockfile is stale; run panack deps update")
                }
              }
            }
            if failure == None() && write {
              match write_local_lock(project.package_root, current) {
                Error(problem) => { failure = Some(problem) },
                Ok(unit) => {}
              }
            }
            match failure {
              Some(problem) => package_tool_error(problem),
              None() => { print("ok"); 0 }
            }
          }
        }
      }
    }
  }
}

main(): Void {
  status: Nat = package_tool_command(std_host.arguments())
  if status != 0 {
    std_host.exit(status)
  }
}
