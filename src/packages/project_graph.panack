import stdlib/compiler_paths as path_support
import stdlib/path as std_path
import stdlib/package_filesystem as std_package_filesystem
import stdlib/environment as std_environment
pub import project/src/project_model/package_project::{ManifestDependencyProject}
pub import project/src/project_model/resolved_project::{ResolvedPackage, ResolvedPackageEdge, ResolvedProject}
pub import stdlib/package_filesystem::{FilesystemRootIdentity}
import stdlib/package_filesystem::{FilesystemRootRead}
pub import project/src/project_model/package_manifest::{PackageManifestExport}
import project/src/project_model/package_manifest::{PackageManifest, PackageManifestDependency, parse_package_manifest, package_manifest_byte_limit}
import project/src/project_model/utf8::{valid_utf8}

// A dependency edge binds an owner-scoped alias to the target's public module map
// and captured physical root. The loader consumes edges without filesystem search.
pub record ManifestProject {
  package_root: Str,
  source_root: Str,
  entry: Option[Str],
  exports: [Str],
  exported_modules: [PackageManifestExport],
  package: Str,
  version: Str,
  dependencies: [ManifestDependencyProject],
  root_identity: FilesystemRootIdentity
}

record ManifestPackageDeclaration {
  project: ManifestProject,
  dependencies: [PackageManifestDependency]
}

record PackageDependencyGraph {
  packages: [ManifestPackageDeclaration],
  edges: [ManifestDependencyProject]
}

package_dependency_graph_max_packages(): Nat { 64 }
package_dependency_graph_max_edges(): Nat { 256 }
package_dependency_graph_max_depth(): Nat { 32 }

pure package_project_package_id(name: Str, version: Str): Str {
  name + "@" + version
}

pure package_project_edges_for(
  edges: [ManifestDependencyProject],
  owner: FilesystemRootIdentity
): [ResolvedPackageEdge] {
  mut output: [ResolvedPackageEdge] = []
  for edge in edges {
    if edge.owner_root_identity == owner {
      output = output.append(ResolvedPackageEdge(
        edge.alias, package_project_package_id(edge.package, edge.version)
      ))
    }
  }
  output
}

pure package_project_has_identity(
  packages: [ResolvedPackage],
  identity: FilesystemRootIdentity
): Bool {
  mut found: Bool = false
  for package in packages {
    if package.identity == identity { found = true }
  }
  found
}

pub pure package_project_from_manifest(
  root: ManifestProject,
  edges: [ManifestDependencyProject],
  toolchain: Str
): ResolvedProject {
  mut packages: [ResolvedPackage] = [ResolvedPackage(
    package_project_package_id(root.package, root.version),
    root.package,
    root.version,
    root.package_root,
    root.source_root,
    root.entry,
    root.exported_modules,
    root.root_identity,
    package_project_edges_for(edges, root.root_identity)
  )]
  for edge in edges {
    if !package_project_has_identity(packages, edge.root_identity) {
      packages = packages.append(ResolvedPackage(
        package_project_package_id(edge.package, edge.version),
        edge.package,
        edge.version,
        edge.package_root,
        edge.source_root,
        None(),
        edge.exported_modules,
        edge.root_identity,
        package_project_edges_for(edges, edge.root_identity)
      ))
    }
  }
  ResolvedProject(
    package_project_package_id(root.package, root.version),
    toolchain,
    packages
  )
}

physical_source_roots_overlap(left: Str, right: Str): Result[Bool, Str] {
  match std_path.from_text(left) {
    Error(error) => Error("invalid source root path"),
    Ok(left_path) => match std_path.from_text(right) {
      Error(error) => Error("invalid source root path"),
      Ok(right_path) => match std_package_filesystem.directories_overlap(left_path, right_path) {
        Error(error) => Error("cannot inspect source root directories"),
        Ok(overlaps) => Ok(overlaps)
      }
    }
  }
}

pub read_manifest_project(path: Str): Result[ManifestProject, Str] {
  match read_manifest_project_file(path, true) {
    Error(message) => Error(message),
    Ok(declaration) => manifest_project_with_dependencies(
      declaration.project, declaration.dependencies
    )
  }
}

read_manifest_project_file(path: Str, is_project_manifest: Bool): Result[ManifestPackageDeclaration, Str] {
  resolved: Str = path_support.resolve(path)
  package_root: Str = path_support.parent(resolved)
  if resolved != package_root + "/panack.json" {
    Error("project manifest must be named panack.json")
  } else {
    match std_path.from_text(package_root) {
      Error(error) => Error("invalid package root path"),
      Ok(root) => match std_path.from_text("panack.json") {
        Error(error) => Error("invalid manifest path"),
        Ok(relative) => match std_package_filesystem.read_beneath(root, relative, package_manifest_byte_limit()) {
          Error(problem) => {
            code: Str = problem.code
            Error(if is_project_manifest {
              "cannot read project manifest (${code})"
            } else {
              "cannot read local dependency manifest (${code})"
            })
          },
          Ok(read) => manifest_project_from_read(package_root, read, is_project_manifest)
        }
      }
    }
  }
}

manifest_project_from_read(
  package_root: Str,
  read: FilesystemRootRead,
  is_project_manifest: Bool
): Result[ManifestPackageDeclaration, Str] {
  if !valid_utf8(read.contents) {
    Error("project manifest is not valid UTF-8")
  } else {
    toolchain: Str = std_environment.get("PANACKELTY_VERSION").value_or("")
    if toolchain == "" {
      Error("running toolchain version is unavailable")
    } else {
      match parse_package_manifest(read.contents, toolchain) {
        Error(error) => {
          offset: Nat = error.offset
          detail: Str = error.message
          Error("invalid project manifest at byte ${offset}: ${detail}")
        },
        Ok(manifest) => match manifest_project_from_manifest(package_root, read.identity, manifest) {
          Error(message) => Error(message),
          Ok(project) => Ok(ManifestPackageDeclaration(project, manifest.dependencies))
        }
      }
    }
  }
}

manifest_project_from_manifest(
  package_root: Str,
  root_identity: FilesystemRootIdentity,
  manifest: PackageManifest
): Result[ManifestProject, Str] {
  source_root: Str = path_support.resolve(path_support.join(package_root, manifest.source))
  match manifest.entry {
    None() => if manifest.exports.len() == 0 {
      Error("library manifest must export at least one module")
    } else {
      mut exports: [Str] = []
      for exported in manifest.exports {
        exports = exports.append(path_support.resolve(path_support.join(source_root, exported.path)))
      }
      Ok(ManifestProject(
        package_root,
        source_root,
        None(),
        exports,
        manifest.exports,
        manifest.package,
        manifest.version,
        [],
        root_identity
      ))
    },
    Some(entry) => {
      entry_path: Str = path_support.resolve(path_support.join(source_root, entry))
      Ok(ManifestProject(
        package_root,
        source_root,
        Some(entry_path),
        [],
        manifest.exports,
        manifest.package,
        manifest.version,
        [],
        root_identity
      ))
    }
  }
}

manifest_project_with_dependencies(
  project: ManifestProject,
  dependencies: [PackageManifestDependency]
): Result[ManifestProject, Str] {
  initial: PackageDependencyGraph = PackageDependencyGraph(
    [ManifestPackageDeclaration(project, dependencies)], []
  )
  match resolve_package_dependency_graph(project, dependencies, [project.root_identity], initial) {
    Error(message) => Error(message),
    Ok(graph) => Ok(ManifestProject(
      project.package_root,
      project.source_root,
      project.entry,
      project.exports,
      project.exported_modules,
      project.package,
      project.version,
      graph.edges,
      project.root_identity
    ))
  }
}

resolve_package_dependency_graph(
  owner: ManifestProject,
  declarations: [PackageManifestDependency],
  ancestry: [FilesystemRootIdentity],
  graph: PackageDependencyGraph
): Result[PackageDependencyGraph, Str] {
  mut current: PackageDependencyGraph = graph
  mut failure: Option[Str] = None()
  for dependency in declarations {
    match failure {
      Some(message) => {},
      None() => {
        alias: Str = dependency.alias
        dependency_root: Str = path_support.resolve(path_support.join(owner.package_root, dependency.path))
        dependency_manifest: Str = path_support.join(dependency_root, "panack.json")
        match read_manifest_project_file(dependency_manifest, false) {
          Error(message) => { failure = Some("dependency ${alias}: ${message}") },
          Ok(declaration) => {
            package: ManifestProject = declaration.project
            match package.entry {
              Some(entry) => { failure = Some("dependency ${alias} must be a library package") },
              None() => {
                if package.exported_modules.len() == 0 {
                  failure = Some("dependency ${alias} must export at least one module")
                } else {
                  mut cycle: Bool = false
                  for ancestor in ancestry {
                    cycle = cycle || ancestor == package.root_identity
                  }
                  if cycle {
                    if package.root_identity == ancestry[0] {
                      failure = Some("dependency ${alias} resolves to the application package root")
                    } else {
                      failure = Some("dependency ${alias}: package dependency cycle detected")
                    }
                  } else if current.edges.len() >= package_dependency_graph_max_edges() {
                    failure = Some("package dependency graph exceeds 256 edges")
                  } else if ancestry.len() >= package_dependency_graph_max_depth() {
                    failure = Some("package dependency graph exceeds 32 package levels")
                  } else {
                    mut conflict: Option[Str] = None()
                    mut known: Option[ManifestPackageDeclaration] = None()
                    for previous_declaration in current.packages {
                      previous: ManifestProject = previous_declaration.project
                      if previous.root_identity == package.root_identity {
                        if previous.package != package.package || previous.version != package.version {
                          conflict = Some("one physical package root declares conflicting package identities")
                        } else if previous.source_root != package.source_root ||
                            previous.exported_modules != package.exported_modules ||
                            previous_declaration.dependencies != declaration.dependencies {
                          conflict = Some("package manifest changed while resolving dependency graph")
                        } else {
                          known = Some(previous_declaration)
                        }
                      } else if previous.package == package.package {
                        if previous.version != package.version {
                          package_name: Str = package.package
                          conflict = Some("package ${package_name} is declared with conflicting versions")
                        } else {
                          package_name: Str = package.package
                          package_version: Str = package.version
                          conflict = Some("package ${package_name}@${package_version} resolves to multiple physical roots")
                        }
                      } else {
                        match physical_source_roots_overlap(previous.source_root, package.source_root) {
                          Error(message) => { conflict = Some("dependency ${alias}: ${message}") },
                          Ok(overlaps) => {
                            if overlaps {
                              if previous.root_identity == ancestry[0] {
                                conflict = Some("dependency ${alias} physical source root overlaps the application source root")
                              } else {
                                previous_alias: Str = package_graph_first_alias(previous.root_identity, current.edges)
                                conflict = Some("dependency ${alias} physical source root overlaps dependency ${previous_alias}")
                              }
                            }
                          }
                        }
                      }
                    }
                    match conflict {
                      Some(message) => { failure = Some(message) },
                      None() => {
                        edge: ManifestDependencyProject = ManifestDependencyProject(
                          owner.root_identity,
                          alias,
                          package.package_root,
                          package.source_root,
                          package.exported_modules,
                          package.package,
                          package.version,
                          package.root_identity
                        )
                        current = PackageDependencyGraph(current.packages, current.edges.append(edge))
                        match known {
                          Some(previous) => {},
                          None() => {
                            if current.packages.len() >= package_dependency_graph_max_packages() {
                              failure = Some("package dependency graph exceeds 64 packages")
                            } else {
                              current = PackageDependencyGraph(
                                current.packages.append(declaration), current.edges
                              )
                              match resolve_package_dependency_graph(
                                package,
                                declaration.dependencies,
                                ancestry.append(package.root_identity),
                                current
                              ) {
                                Error(message) => { failure = Some("dependency ${alias}: ${message}") },
                                Ok(expanded) => { current = expanded }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
  match failure {
    Some(message) => Error(message),
    None() => Ok(current)
  }
}

pure package_graph_first_alias(
  root_identity: FilesystemRootIdentity,
  edges: [ManifestDependencyProject]
): Str {
  mut alias: Str = "unknown"
  mut found: Bool = false
  for edge in edges {
    if !found && edge.root_identity == root_identity {
      alias = edge.alias
      found = true
    }
  }
  alias
}
