pub import project/src/packages/diagnostic::{PackageProblem}
pub import project/packages/http/src/types::{HttpError}
import project/src/packages/diagnostic::{package_problem, explain_problem, package_result}
import project/packages/http/src/stream as http
import project/packages/http/src/parser::{lower_ascii}
import project/packages/http/src/types::{HttpError.ProtocolError}
pub import project/src/packages/archive::{StagedArchive}
import project/src/packages/archive::{consume_compressed}
import project/src/packages/tar_stream::{TarStream, tar_stream_new, tar_stream_finish}
import project/src/packages/sha256::{Sha256, sha256_new, sha256_feed, sha256_finish, sha256_close}
import stdlib/filesystem_stage as staging
import stdlib/gzip as gzip
import stdlib/path as path
import stdlib/bytes as byte_buffer

record Decoder { stage: Nat, gzip_handle: Nat, tar: TarStream, hash: Sha256 }

consume(state: Decoder, input: Bytes): Result[Decoder, http.HttpError] {
  match consume_compressed(state.stage, state.gzip_handle, state.tar, input, false) {
    Error(problem) => Error(ProtocolError("archive extraction: " + problem)),
    Ok(tar) => Ok(Decoder(state.stage, state.gzip_handle, tar, sha256_feed(state.hash, input)))
  }
}

pure safe_url(url: Str): Bool {
  mut valid: Bool = url.starts_with_at("https://", 0)
  data = url.encode_utf8()
  for index in 0..data.length() { byte = data.at(index); if byte <= 32 || byte == 127 || byte == 64 || byte == 63 || byte == 35 || byte == 92 { valid = false } }
  valid
}

pure redirect_url(current: Str, location: Str): Str {
  if location.starts_with_at("https://", 0) { location }
  else if location.starts_with_at("//", 0) { "https:" + location }
  else {
    mut origin_end: Nat = current.len()
    for index in 8..current.len() { if current.slice(index, index + 1) == "/" && origin_end == current.len() { origin_end = index } }
    origin = current.slice(0, origin_end)
    if location.starts_with_at("/", 0) { origin + location }
    else {
      mut slash: Nat = origin_end
      for index in origin_end..current.len() { if current.slice(index, index + 1) == "/" { slash = index } }
      if origin_end == current.len() { origin + "/" + location }
      else { current.slice(0, slash + 1) + location }
    }
  }
}

open_archive(url: Str): Result[http.ResponseStream, PackageProblem] {
  mut current = url
  mut hops: Nat = 0
  mut response: Option[http.ResponseStream] = None()
  mut failure: Option[PackageProblem] = None()
  while response == None() && failure == None() {
    if !safe_url(current) { failure = Some(package_problem("PKG_REDIRECT", "archive download address is not an allowed HTTPS URL")) }
    else { match http.open_response(current, 60000, 67108864) {
      Error(problem) => { failure = Some(http_problem(problem)) },
      Ok(opened) => {
        if opened.status == 200 {
          mut encoding: Bool = false
          for header in opened.headers { if lower_ascii(header.name) == "content-encoding" && lower_ascii(header.value) != "identity" { encoding = true } }
          if encoding { closed = http.close_response(opened); failure = Some(package_problem("PKG_HTTP", "archive server applied an unsupported Content-Encoding; serve the .tar.gz bytes directly")) }
          else { response = Some(opened) }
        } else {
          closed = http.close_response(opened)
          if opened.status == 301 || opened.status == 302 || opened.status == 303 || opened.status == 307 || opened.status == 308 {
            mut locations: [Str] = []
            for header in opened.headers { if lower_ascii(header.name) == "location" { locations = locations.append(header.value) } }
            if hops >= 5 { failure = Some(package_problem("PKG_REDIRECT", "archive server redirected the download more than 5 times")) }
            else if locations.len() != 1 || locations[0] == "" { failure = Some(package_problem("PKG_REDIRECT", "archive server returned a redirect without exactly one nonempty Location header")) }
            else if !safe_url("https://placeholder/" + locations[0]) { failure = Some(package_problem("PKG_REDIRECT", "unsafe archive redirect")) }
            else if locations[0].starts_with_at("http:", 0) { failure = Some(package_problem("PKG_REDIRECT", "archive server redirected the download to HTTP; HTTPS is required")) }
            else { current = redirect_url(current, locations[0]); hops = hops + 1 }
          } else { status = opened.status; failure = Some(package_problem("PKG_HTTP_STATUS", "archive server returned HTTP ${status}; expected 200")) }
        }
      }
    } }
  }
  match failure { Some(problem) => Error(problem), None() => match response { Some(value) => Ok(value), None() => Error(package_problem("PKG_HTTP", "missing HTTP response")) } }
}

extract(stage: Nat, response: http.ResponseStream): Result[StagedArchive, PackageProblem] {
  match gzip.open(268435456) {
    Error(problem) => Error(package_problem("PKG_ARCHIVE", "cannot open gzip decoder")),
    Ok(handle) => {
      hash = sha256_new()
      decoded = http.fold_body(response, Decoder(stage, handle, tar_stream_new(), hash), @consume, 67108864)
      result = match decoded {
        Error(problem) => { sha256_close(hash); Error(http_problem(problem)) },
        Ok(state) => match consume_compressed(stage, handle, state.tar, byte_buffer.empty(), true) {
          Error(problem) => { sha256_close(state.hash); Error(package_problem("PKG_ARCHIVE", problem)) },
          Ok(tar) => match package_result(sha256_finish(state.hash), "PKG_TOOL") {
            Error(problem) => Error(problem),
            Ok(digest) => match package_result(tar_stream_finish(tar), "PKG_ARCHIVE") {
              Error(problem) => Error(problem),
              Ok(entries) => match staging.path(stage) {
                Error(problem) => Error(package_problem("PKG_FILESYSTEM", "staging path unavailable")),
                Ok(root) => match root.to_text() {
                  Error(problem) => Error(package_problem("PKG_FILESYSTEM", "staging path is not UTF-8")),
                  Ok(text) => Ok(StagedArchive(stage, text, digest, entries))
                }
              }
            }
          }
        }
      }
      closed = gzip.close(handle)
      result
    }
  }
}

pub stage_remote_archive(parent: Str, url: Str): Result[StagedArchive, PackageProblem] {
  match path.from_text(parent) {
    Error(problem) => Error(package_problem("PKG_FILESYSTEM", "cannot use the parent path for the temporary archive directory")),
    Ok(parent_path) => match staging.begin(parent_path) {
      Error(problem) => Error(package_problem("PKG_FILESYSTEM", "cannot create a temporary directory to unpack the archive")),
      Ok(stage) => {
        result = match open_archive(url) {
          Error(problem) => Error(problem),
          Ok(response) => { extracted = extract(stage, response); closed = http.close_response(response); extracted }
        }
        match result { Ok(archive) => Ok(archive), Error(problem) => { closed = staging.close(stage); Error(problem) } }
      }
    }
  }
}

pub pure http_problem(problem: HttpError): PackageProblem {
  match problem {
    http.HttpError.InvalidUrl(detail) => package_problem("PKG_HTTP", "archive URL is invalid"),
    http.HttpError.InvalidLimits() => package_problem("PKG_LIMIT", "archive transport limits are invalid"),
    http.HttpError.DnsFailure() => explain_problem(package_problem("PKG_HTTP", "could not find the archive server's network address (DNS lookup failed)"),
      "Panack could not turn the hostname in the archive URL into a network address, so it could not contact the server.",
      "Check the hostname in panack.json and your network or VPN connection, then retry the command."),
    http.HttpError.ConnectFailure() => explain_problem(package_problem("PKG_HTTP", "could not connect to the archive server"),
      "The connection failed before Panack could download the archive. This does not tell us whether the server is down or the connection is blocked.",
      "Check your network or VPN connection and whether the server is reachable. Retry the same command once access is restored."),
    http.HttpError.TlsFailure() => explain_problem(package_problem("PKG_HTTP", "could not establish a trusted HTTPS connection to the archive server"),
      "The secure connection failed before the archive could be downloaded. This error alone does not identify a particular certificate problem.",
      "Check your system clock and trusted certificates. If they are correct, ask the server administrator to check its HTTPS configuration. Do not disable certificate verification."),
    http.HttpError.Timeout() => explain_problem(package_problem("PKG_HTTP", "archive request did not finish within 60 seconds"),
      "Panack stopped waiting before it had a complete download.",
      "Check your connection and retry the same command. If it repeatedly times out, ask the package maintainer to check the download server."),
    http.HttpError.ProtocolError(detail) => package_problem(if detail.starts_with_at("archive extraction: ", 0) { "PKG_ARCHIVE" } else { "PKG_HTTP" }, detail),
    http.HttpError.LimitExceeded(detail) => package_problem("PKG_LIMIT", "archive transport limit exceeded: " + detail + " (body: 64 MiB; headers/trailers: 64 KiB; chunk line: 8 KiB; informational responses: 8)"),
    http.HttpError.Cancelled() => explain_problem(package_problem("PKG_HTTP", "archive request was cancelled"),
      "The download stopped before it finished.", "Run the same command again when you are ready to continue."),
    http.HttpError.UnsupportedHost() => explain_problem(package_problem("PKG_HTTP", "this Panack installation cannot make HTTPS requests"),
      "The required native HTTPS support is unavailable in this installation.",
      "Use a supported native Panack release with libcurl installed. Reinstall Panack if this installation should already provide HTTPS support."),
    http.HttpError.UnsupportedMethod(detail) => package_problem("PKG_HTTP", "unsupported archive request method"),
    http.HttpError.UnsupportedVersion(detail) => package_problem("PKG_HTTP", "unsupported archive HTTP version"),
    http.HttpError.UnsupportedTransferEncoding() => package_problem("PKG_HTTP", "unsupported archive transfer encoding"),
    http.HttpError.InvalidRequest() => package_problem("PKG_HTTP", "invalid archive request"),
    http.HttpError.InvalidResponse() => package_problem("PKG_HTTP", "invalid archive response"),
    http.HttpError.TransportFailure(detail) => package_problem("PKG_HTTP", "connection to the archive server failed before the download finished")
  }
}
