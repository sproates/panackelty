pub import project/src/packages/diagnostic::{PackageProblem}
import project/src/packages/diagnostic::{package_problem, explain_problem}
pub import project/src/packages/lock::{PackageLock, PackageLockPackage, PackageLockEdge, lock_package_id, serialize_package_lock}

pure selected_alias(aliases: [Str], alias: Str): Bool {
  mut found: Bool = false
  for selected in aliases { found = found || selected == alias }
  found
}

pure selected_packages(lock: PackageLock, aliases: [Str]): Set[Str] {
  mut selected: Set[Str] = set()
  for edge in lock.dependencies { if selected_alias(aliases, edge.alias) { selected = selected.add(edge.package) } }
  // Package graphs have at most 64 nodes. Bounded closure also terminates for a
  // malformed cyclic input; the lock parser separately rejects such graphs.
  for iteration in 0..64 {
    for package in lock.packages {
      if selected.has(lock_package_id(package.name, package.version)) {
        for edge in package.dependencies { selected = selected.add(edge.package) }
      }
    }
  }
  selected
}

pure package_signature(package: PackageLockPackage): Str {
  serialize_package_lock(PackageLock("root", "1.0.0", "", "", [], [package]))
}

pure edge_signature(edge: PackageLockEdge): Str {
  serialize_package_lock(PackageLock("root", "1.0.0", "", "", [edge], []))
}

pub pure validate_selective_update(previous: PackageLock, current: PackageLock, aliases: [Str]): Result[Unit, PackageProblem] {
  mut failure: Option[PackageProblem] = None()
  if previous.root_name != current.root_name { failure = Some(project_change("package name")) }
  else if previous.root_version != current.root_version { failure = Some(project_change("version")) }
  else if previous.toolchain != current.toolchain { failure = Some(project_change("toolchain version")) }
  for alias in aliases {
    mut found: Bool = false
    for edge in previous.dependencies { found = found || edge.alias == alias }
    for edge in current.dependencies { found = found || edge.alias == alias }
    if !found && failure == None() { failure = Some(explain_problem(package_problem("PKG_DEPENDENCY_UNKNOWN", "Cannot update dependency '" + alias + "' because this project has no dependency with that name."), "Panack could not find this dependency name in panack.json or in the existing lockfile. Panack has not changed the lockfile.", "Check the name in your command. Use the dependency name declared in panack.json, which may differ from the package's own name.")) }
  }
  for edge in previous.dependencies {
    if !selected_alias(aliases, edge.alias) {
      mut found: Bool = false
      for candidate in current.dependencies { found = found || edge_signature(candidate) == edge_signature(edge) }
      if !found && failure == None() { failure = Some(explain_problem(package_problem("PKG_DEPENDENCY_NOT_SELECTED", "Cannot complete this update without also changing dependency '" + edge.alias + "'."), "Your command did not select this dependency. Panack has stopped because the update would also change this dependency. Panack has not changed the lockfile.", "If you intend to update this dependency too, include its declaration name in your update command. Otherwise, undo the change to this dependency in panack.json and retry your original command.")) }
    }
  }
  for edge in current.dependencies {
    if !selected_alias(aliases, edge.alias) {
      mut found: Bool = false
      for candidate in previous.dependencies { found = found || edge_signature(candidate) == edge_signature(edge) }
      if !found && failure == None() { failure = Some(explain_problem(package_problem("PKG_DEPENDENCY_NOT_SELECTED", "Cannot complete this update without also changing dependency '" + edge.alias + "'."), "Your command did not select this dependency. Panack has stopped because the update would also change this dependency. Panack has not changed the lockfile.", "If you intend to update this dependency too, include its declaration name in your update command. Otherwise, undo the change to this dependency in panack.json and retry your original command.")) }
    }
  }
  old_selected: Set[Str] = selected_packages(previous, aliases)
  new_selected: Set[Str] = selected_packages(current, aliases)
  for package in previous.packages {
    id: Str = lock_package_id(package.name, package.version)
    if !old_selected.has(id) && !new_selected.has(id) {
      mut found: Bool = false
      for candidate in current.packages { found = found || package_signature(candidate) == package_signature(package) }
      if !found && failure == None() { failure = Some(explain_problem(package_problem("PKG_DEPENDENCY_NOT_SELECTED", "Cannot complete this update because package '" + id + "' would change outside the selected dependencies."), "Panack has stopped this update without changing the lockfile.", "Check which direct dependency uses this package. Include that dependency in your update command if you intend to update it too. Otherwise, undo the change affecting this package and retry your command.")) }
    }
  }
  for package in current.packages {
    id: Str = lock_package_id(package.name, package.version)
    if !old_selected.has(id) && !new_selected.has(id) {
      mut found: Bool = false
      for candidate in previous.packages { found = found || package_signature(candidate) == package_signature(package) }
      if !found && failure == None() { failure = Some(explain_problem(package_problem("PKG_DEPENDENCY_NOT_SELECTED", "Cannot complete this update because package '" + id + "' would change outside the selected dependencies."), "Panack has stopped this update without changing the lockfile.", "Check which direct dependency uses this package. Include that dependency in your update command if you intend to update it too. Otherwise, undo the change affecting this package and retry your command.")) }
    }
  }
  match failure { Some(problem) => Error(problem), None() => Ok(()) }
}

pure project_change(field: Str): PackageProblem {
  explain_problem(package_problem("PKG_PROJECT_CHANGED", "Cannot update only the selected dependencies because the project's " + field + " has changed."),
    "Updating only the named dependencies cannot record changes to the project itself. Panack has not changed the lockfile.",
    "Check this change in panack.json. If it is intended, review it before running panack deps update without dependency names. That command updates the whole lock.")
}
