pure utf8_continuation(value: Nat): Bool {
  value >= 128 && value <= 191
}

pub pure valid_utf8(data: Bytes): Bool {
  mut valid: Bool = true
  mut cursor: Nat = 0
  while cursor < data.length() && valid {
    first: Nat = data.at(cursor)
    if first <= 127 {
      cursor = cursor + 1
    } else {
      if first >= 194 && first <= 223 {
        if cursor + 1 < data.length() && utf8_continuation(data.at(cursor + 1)) {
          cursor = cursor + 2
        } else { valid = false; }
      } else {
        if first >= 224 && first <= 239 {
          if cursor + 2 < data.length() {
            second: Nat = data.at(cursor + 1)
            third: Nat = data.at(cursor + 2)
            second_valid: Bool = utf8_continuation(second) &&
              (first != 224 || second >= 160) && (first != 237 || second <= 159)
            if second_valid && utf8_continuation(third) { cursor = cursor + 3; }
            else { valid = false; }
          } else { valid = false; }
        } else {
          if first >= 240 && first <= 244 {
            if cursor + 3 < data.length() {
              second: Nat = data.at(cursor + 1)
              third: Nat = data.at(cursor + 2)
              fourth: Nat = data.at(cursor + 3)
              second_valid: Bool = utf8_continuation(second) &&
                (first != 240 || second >= 144) && (first != 244 || second <= 143)
              if second_valid && utf8_continuation(third) && utf8_continuation(fourth) {
                cursor = cursor + 4
              } else { valid = false; }
            } else { valid = false; }
          } else { valid = false; }
        }
      }
    }
  }
  valid
}
