pub import stdlib/host::{HostError}

pub read_chunk(file: Path, offset: Nat, limit: Nat): Result[Bytes, HostError] {
  fs_read_chunk(file, offset, limit)
}

pub atomic_write(file: Path, data: Bytes): Result[Unit, HostError] {
  fs_atomic_write(file, data)
}

// Read at most 4096 native target bytes, without following the final link or
// symlinked ancestors. The relative path must remain below root.
pub read_link(root: Path, relative: Path): Result[Bytes, HostError] {
  fs_read_link(root, relative)
}
