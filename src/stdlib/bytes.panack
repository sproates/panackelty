pub pure bytes_empty(): Bytes {
  bytes()
}

pub pure bytes_push(buffer: Bytes, value: Nat): Bytes {
  byte_append(buffer, value)
}

pub pure bytes_join(left: Bytes, right: Bytes): Bytes {
  bytes_concat(left, right)
}

pub pure bytes_length(buffer: Bytes): Nat {
  byte_len(buffer)
}

pub pure bytes_at(buffer: Bytes, index: Nat): Nat {
  byte_get(buffer, index)
}

pub pure text_encode_utf8(value: Str): Bytes {
  utf8_encode(value)
}

pub pure text_decode_utf8(buffer: Bytes): Str {
  utf8_decode(buffer)
}
