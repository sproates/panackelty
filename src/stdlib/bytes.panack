pub pure empty(): Bytes {
  bytes()
}

pub pure push(buffer: Bytes, value: Nat): Bytes {
  byte_append(buffer, value)
}

pub pure join(left: Bytes, right: Bytes): Bytes {
  bytes_concat(left, right)
}

pub pure length(buffer: Bytes): Nat {
  byte_len(buffer)
}

pub pure at(buffer: Bytes, index: Nat): Nat {
  byte_get(buffer, index)
}
