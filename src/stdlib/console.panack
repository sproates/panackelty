pub import stdlib/host::{HostError}

// Messages are limited to 16 KiB before the optional newline.
pub write(message: Str): Result[Unit,HostError] {
  console_output(message, false, false)
}

pub write_line(message: Str): Result[Unit,HostError] {
  console_output(message, false, true)
}

pub write_error(message: Str): Result[Unit,HostError] {
  console_output(message, true, false)
}

pub write_error_line(message: Str): Result[Unit,HostError] {
  console_output(message, true, true)
}

// One non-empty chunk of at most limit bytes, or None at EOF. Limit: 1..65536.
pub read(limit: Nat): Result[Option[Bytes],HostError] {
  console_input(limit)
}
