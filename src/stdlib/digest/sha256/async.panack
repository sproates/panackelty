pub import stdlib/host::{HostError}
pub import stdlib/digest/sha256::{hash}

// Handles belong to this invocation. Async mutations yield after one bounded step.
pub async create(): Result[Sha256Context,HostError] {
  await sha256_create_async()
}

pub async update(context: Sha256Context, data: Bytes): Result[Unit,HostError] {
  await sha256_update_async(context, data)
}

pub async finish(context: Sha256Context): Result[Bytes,HostError] {
  await sha256_finish_async(context)
}

pub async close(context: Sha256Context): Result[Unit,HostError] {
  await sha256_close_async(context)
}
