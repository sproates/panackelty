pub import stdlib/host::{HostError}

pub enum FileKind { RegularFile, Directory, SymbolicLink, OtherFile }
pub record FileMetadata { kind: FileKind, size: Nat }

pub metadata(path: Path): Result[FileMetadata, HostError] {
  fs_metadata(path)
}

pub read(path: Path, limit: Nat): Result[Bytes, HostError] {
  fs_read(path, limit)
}

pub write(path: Path, data: Bytes): Result[Unit, HostError] {
  fs_write(path, data)
}

pub list_directory(path: Path): Result[[Path], HostError] {
  fs_list(path)
}

pub remove_file(path: Path): Result[Unit, HostError] {
  fs_remove_file(path)
}

pub remove_directory(path: Path): Result[Unit, HostError] {
  fs_remove_directory(path)
}

pub create_directory(path: Path): Result[Unit, HostError] {
  fs_create_directory(path)
}

pub temp_directory(parent: Path): Result[Path, HostError] {
  fs_temp_directory(parent)
}

pub temp_file(parent: Path): Result[Path, HostError] {
  fs_temp_file(parent)
}
