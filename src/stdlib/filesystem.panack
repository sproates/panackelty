import stdlib/bounded_filesystem as bounded
import stdlib/package_filesystem as confined_support
pub import stdlib/host::{HostError}

pub enum FileKind { RegularFile, Directory, SymbolicLink, OtherFile }
pub record FileMetadata { kind: FileKind, size: Nat }

pub metadata(path: Path): Result[FileMetadata, HostError] {
  fs_metadata(path)
}

pub read(path: Path, limit: Nat): Result[Bytes, HostError] {
  fs_read(path, limit)
}

pub write(path: Path, data: Bytes): Result[Unit, HostError] {
  fs_write(path, data)
}

pub list_directory(path: Path): Result[[Path], HostError] {
  fs_list(path)
}

pub remove_file(path: Path): Result[Unit, HostError] {
  fs_remove_file(path)
}

pub remove_directory(path: Path): Result[Unit, HostError] {
  fs_remove_directory(path)
}

pub create_directory(path: Path): Result[Unit, HostError] {
  fs_create_directory(path)
}

pub temp_directory(parent: Path): Result[Path, HostError] {
  fs_temp_directory(parent)
}

pub temp_file(parent: Path): Result[Path, HostError] {
  fs_temp_file(parent)
}

// Canonical names retain the existing creation and path-safety contracts.
pub create_temp_file(parent: Path): Result[Path,HostError] { temp_file(parent) }
pub create_temp_directory(parent: Path): Result[Path,HostError] { temp_directory(parent) }
pub read_chunk(file: Path, offset: Nat, limit: Nat): Result[Bytes,HostError] {
  bounded.read_chunk(file, offset, limit)
}
pub write_atomic(file: Path, data: Bytes): Result[Unit,HostError] {
  bounded.atomic_write(file, data)
}
pub directories_overlap(left: Path, right: Path): Result[Bool,HostError] {
  confined_support.directories_overlap(left, right)
}
