import stdlib/filesystem/errors::{FilesystemOperation.CreateStage, FilesystemOperation.StagePath, FilesystemOperation.StageCreateDirectory, FilesystemOperation.StageWriteChunk, FilesystemOperation.StageCreateSymlink, FilesystemOperation.StagePublish, FilesystemOperation.StageDiscard}
import stdlib/filesystem/errors as errors
pub import stdlib/filesystem/errors::{FilesystemError, FilesystemErrorKind, FilesystemOperation}
pub import stdlib/host::{HostError}
pub import stdlib/filesystem/staging::{PublishMode, PublishMode.CreateOnly, PublishMode.ReplaceExisting}

pub async create(parent: Path): Result[DirectoryStage,FilesystemError] {
  errors.convert(await stage_create_async(parent), CreateStage(parent))
}
pub async path(stage: DirectoryStage): Result[Path,FilesystemError] {
  errors.convert(await stage_path_async(stage), StagePath())
}
pub async create_directory(stage: DirectoryStage, relative: Path): Result[Unit,FilesystemError] {
  errors.convert(await stage_directory_async(stage, relative), StageCreateDirectory(relative))
}
pub async write_chunk(stage: DirectoryStage, relative: Path, data: Bytes, offset: Nat): Result[Unit,FilesystemError] {
  errors.convert(await stage_write_async(stage, relative, data, offset), StageWriteChunk(relative, offset))
}
pub async create_symlink(stage: DirectoryStage, relative: Path, target: Path): Result[Unit,FilesystemError] {
  errors.convert(await stage_symlink_async(stage, relative, target), StageCreateSymlink(relative, target))
}
pub async publish(stage: DirectoryStage, name: Path, mode: PublishMode): Result[Unit,FilesystemError] {
  replace = match mode { CreateOnly() => false, ReplaceExisting() => true }
  errors.convert(await stage_publish_async(stage, name, replace), StagePublish(name, replace))
}
pub async discard(stage: DirectoryStage): Result[Unit,FilesystemError] {
  errors.convert(await stage_discard_async(stage), StageDiscard())
}
