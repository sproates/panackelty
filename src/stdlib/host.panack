// code is a stable portable category; native_code is the POSIX errno, or zero.
pub record HostError { operation: Str, code: Str, native_code: Nat }

pub run(data: Bytes, arguments: [Str]): Void {
  run_bytecode_args(data, arguments)
}

pub arguments(): [Str] {
  command_args()
}

pub exit(status: Nat): Void {
  process_exit(status)
}

pub stderr(message: Str): Void {
  eprint(message)
}

pub stdout(message: Str): Void {
  print(message)
}

pub sleep(duration: Duration): Result[Unit,HostError] {
  host_sleep(duration)
}

pub decode_utf8(value: Bytes): Result[Str,HostError] {
  host_decode_utf8(value)
}
