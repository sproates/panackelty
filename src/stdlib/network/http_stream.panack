import stdlib/network/http_stream/errors as errors
pub import stdlib/network/http_stream/errors::{HttpStreamError, HttpStreamErrorKind, HttpStreamOperation}
import stdlib/network/http_stream/errors::{HttpStreamOperation.Open, HttpStreamOperation.Read, HttpStreamOperation.Close}
// Raw bounded transport support. HTTP parsing and framing belong to the HTTP package.
// The deadline includes time between reads. Empty Bytes means end of stream.
// Handles belong to this invocation; close invalidates every alias.
pub open(host: Str, port: Nat, tls: Bool, request: Bytes, response_limit: Nat, timeout: Duration): Result[HttpStream,HttpStreamError] {
  errors.convert(http_stream_open_typed(host, port, tls, request, response_limit, timeout), Open(host, port, tls, response_limit, timeout))
}

pub read(stream: HttpStream): Result[Bytes,HttpStreamError] {
  errors.convert(http_stream_read_typed(stream), Read())
}

pub close(stream: HttpStream): Result[Unit,HttpStreamError] {
  errors.convert(http_stream_close_typed(stream), Close())
}
