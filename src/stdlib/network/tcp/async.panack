import stdlib/network/tcp/errors as errors
pub import stdlib/network/tcp/errors::{TcpError, TcpErrorKind, TcpOperation}
import stdlib/network/tcp/errors::{TcpOperation.Exchange, TcpOperation.ServeBounded, TcpOperation.ServeStream, TcpOperation.Serve, TcpOperation.ReadChunk}
import stdlib/tcp as legacy
import stdlib/tcp_service as service
pub import stdlib/tcp_service::{TcpServiceReady, TcpServiceSummary}

pub record TcpServerLimits {
  clients: Nat, concurrency: Nat, request_limit: Nat, response_limit: Nat,
  client_timeout: Duration, admission_timeout: Duration, drain: Duration
}
pub record TcpServiceLimits {
  concurrency: Nat, request_limit: Nat, response_limit: Nat,
  client_timeout: Duration, drain: Duration
}

// The existing TCP runtime measures whole milliseconds. Never round a duration.
pure milliseconds(value: Duration, field: Str, allow_zero: Bool): Result[Nat,Str] {
  ticks = value.as_nanoseconds()
  zero: Int = 0
  million: Int = 1000000
  maximum: Int = 60000000000
  if ticks < zero || ticks > maximum || (!allow_zero && ticks <= zero) {
    Error("TCP ${field} must be " + if allow_zero { "between zero and 60 seconds." } else { "greater than zero and at most 60 seconds." })
  } else if ticks % million > zero {
    Error("TCP ${field} must be a whole number of milliseconds; this runtime cannot represent finer TCP deadlines.")
  } else { Ok((ticks / million).nat()) }
}

pure bounded_limits(limits: TcpServerLimits): Result[legacy.TcpServerLimits,Str] {
  match milliseconds(limits.client_timeout, "client_timeout", false) {
    Error(problem) => Error(problem), Ok(client) =>
      match milliseconds(limits.admission_timeout, "admission_timeout", false) {
        Error(problem) => Error(problem), Ok(admission) =>
          match milliseconds(limits.drain, "drain", true) {
            Error(problem) => Error(problem), Ok(drain) => Ok(legacy.TcpServerLimits(
              limits.clients, limits.concurrency, limits.request_limit,
              limits.response_limit, client, admission, drain))
          }
      }
  }
}

pure service_limits(limits: TcpServiceLimits): Result[service.TcpServiceLimits,Str] {
  match milliseconds(limits.client_timeout, "client_timeout", false) {
    Error(problem) => Error(problem), Ok(client) =>
      match milliseconds(limits.drain, "drain", true) {
        Error(problem) => Error(problem), Ok(drain) => Ok(service.TcpServiceLimits(
          limits.concurrency, limits.request_limit, limits.response_limit, client, drain))
      }
  }
}

pub async exchange(address: Str, port: Nat, request: Bytes, response_limit: Nat,
  timeout: Duration): Result[Bytes,TcpError] {
  match errors.configuration(milliseconds(timeout, "timeout", false), Exchange(address,port,timeout,response_limit)) {
    Error(problem) => Error(problem),
    Ok(timeout_ms) => errors.convert(await legacy.exchange(address, port, request, response_limit, timeout_ms), Exchange(address,port,timeout,response_limit))
  }
}

pub async serve_bounded(address: Str, port: Nat, handler: AsyncFn[Bytes,Result[Bytes,Str]],
  limits: TcpServerLimits): Result[[Result[Unit,TcpError]],TcpError] {
  match errors.configuration(bounded_limits(limits),ServeBounded(address,port)) {
    Error(problem) => Error(problem),
    Ok(native) => errors.outcomes(await legacy.serve(address, port, handler, native),ServeBounded(address,port))
  }
}

// Finite streaming server: clients and admission timeout remain bounded.
pub async serve_stream[T](address: Str, port: Nat, worker: AsyncFn[T,Result[Bytes,Str]],
  context: T, limits: TcpServerLimits): Result[[Result[Unit,TcpError]],TcpError] {
  match errors.configuration(bounded_limits(limits),ServeStream(address,port)) {
    Error(problem) => Error(problem),
    Ok(native) => errors.outcomes(await legacy.serve_stream(address, port, worker, context, native),ServeStream(address,port))
  }
}

pub async serve[T](address: Str, port: Nat, worker: AsyncFn[T,Result[Bytes,Str]],
  context: T, limits: TcpServiceLimits,
  ready: AsyncFn[TcpServiceReady,Result[Unit,Str]]): Result[TcpServiceSummary,TcpError] {
  match errors.configuration(service_limits(limits),Serve(address,port)) {
    Error(problem) => Error(problem),
    Ok(native) => errors.convert(await service.serve(address, port, worker, context, native, ready),Serve(address,port))
  }
}

pub async read_chunk(limit: Nat): Result[Bytes,TcpError] { errors.convert(await legacy.read_chunk(limit),ReadChunk(limit)) }
