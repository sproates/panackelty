pub import stdlib/host::{HostError}
import stdlib/path as std_path

pub record PackageArchiveInspection {
  archive_sha256: Str,
  tree_sha256: Str,
  manifest: Bytes
}

pure archive_bytes_range(data: Bytes, start: Nat, end: Nat): Bytes {
  mut result = bytes()
  mut index = start
  while index < end && index < data.length() {
    result = result.push(data.at(index))
    index = index + 1
  }
  result
}

pub inspect_local_archive(path: Str): Result[PackageArchiveInspection, HostError] {
  match std_path.from_text(path) {
    Error(problem) => Error(HostError("package_archive_inspect", "invalid_argument", 0)),
    Ok(archive_path) => match package_archive_inspect(archive_path) {
      Error(problem) => Error(problem),
      Ok(encoded) => if encoded.length() < 130 || encoded.at(64) != 10 || encoded.at(129) != 10 {
        Error(HostError("package_archive_inspect", "invalid_archive", 0))
      } else {
        Ok(PackageArchiveInspection(
          archive_bytes_range(encoded, 0, 64).decode_utf8(),
          archive_bytes_range(encoded, 65, 129).decode_utf8(),
          archive_bytes_range(encoded, 130, encoded.length())
        ))
      }
    }
  }
}

pub restore_local_archive(
  archive: Str,
  destination: Str,
  archive_sha256: Str,
  tree_sha256: Str
): Result[Unit, HostError] {
  match std_path.from_text(archive) {
    Error(problem) => Error(HostError("package_archive_restore", "invalid_argument", 0)),
    Ok(archive_path) => match std_path.from_text(destination) {
      Error(problem) => Error(HostError("package_archive_restore", "invalid_argument", 0)),
      Ok(destination_path) => package_archive_restore(
        archive_path,
        destination_path,
        archive_sha256,
        tree_sha256
      )
    }
  }
}
