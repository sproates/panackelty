pub import stdlib/host::{HostError}

// Package loading needs a physical root identity and a confined source read.
pub record FilesystemRootIdentity { device: Nat, inode: Nat }
pub record FilesystemRootRead { identity: FilesystemRootIdentity, contents: Bytes }

pub filesystem_read_beneath(
  root: Path,
  relative: Path,
  limit: Nat
): Result[FilesystemRootRead, HostError] {
  fs_read_beneath(root, relative, limit)
}
