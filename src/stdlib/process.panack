pub import stdlib/host::{HostError}

// Exactly one of exit_code or signal describes termination; signal zero means exit.
pub record ProcessOutput { exit_code: Nat, signal: Nat, stdout: Bytes, stderr: Bytes }

pub run(executable: Path, arguments: [Str], stdin: Bytes,
        working_directory: Path, environment: [Str], timeout: Duration,
        output_limit: Nat): Result[ProcessOutput,HostError] {
  process_run(executable, arguments, stdin, working_directory, environment,
    timeout, output_limit)
}

// Supply the complete child environment. No inherited variables or automatic
// coverage ticket are added; executable lookup remains an explicit Path.
pub run_isolated(executable: Path, arguments: [Str], stdin: Bytes,
        working_directory: Path, environment: [Str], timeout: Duration,
        output_limit: Nat): Result[ProcessOutput,HostError] {
  process_run_isolated(executable, arguments, stdin, working_directory, environment,
    timeout, output_limit)
}
