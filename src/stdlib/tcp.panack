// Finite TCP server limits. See docs/reference/SPEC.md for bounds, framing and shutdown.
pub record TcpServerLimits {
  clients: Nat,
  concurrency: Nat,
  request_limit: Nat,
  response_limit: Nat,
  client_timeout_ms: Nat,
  admission_timeout_ms: Nat,
  drain_ms: Nat
}

// Explicit transport services; implementations are bound to this toolchain identity.
pub async exchange(address: Str, port: Nat, request: Bytes, response_limit: Nat,
  timeout_ms: Nat): Result[Bytes,Str] {
  await tcp_exchange(address, port, request, response_limit, timeout_ms)
}

pub async serve(address: Str, port: Nat, handler: AsyncFn[Bytes,Result[Bytes,Str]],
  limits: TcpServerLimits): Result[[Result[Unit,Str]],Str] {
  await tcp_serve(address, port, handler, limits)
}

pub async serve_stream[T](address: Str, port: Nat, worker: AsyncFn[T,Result[Bytes,Str]],
  context: T, limits: TcpServerLimits): Result[[Result[Unit,Str]],Str] {
  await tcp_serve_stream(address, port, worker, context, limits)
}

pub async read_chunk(limit: Nat): Result[Bytes,Str] {
  await tcp_server_read_chunk(limit)
}
