pub import stdlib/testing::{TestResult}
import stdlib/testing::{TestOutcome.TestPassed, TestOutcome.TestFailed}
pub import stdlib/process::{ProcessOutput}
pub import stdlib/host::{HostError}
import stdlib/result as std_result
import stdlib/path as std_path
import stdlib/time as std_time
import stdlib/host as std_host
import stdlib/filesystem as std_filesystem
import stdlib/bytes as byte_buffer
import stdlib/text as std_text
import stdlib/testing as std_testing
import stdlib/process as std_process

// Callers select the exact executable and resource bounds; there is no shell
// or PATH search unless the caller explicitly invokes a shell.
pub record TestCommand {
  executable: Path,
  arguments: [Str],
  stdin: Bytes,
  working_directory: Path,
  environment: [Str],
  timeout: Duration,
  output_limit: Nat
}

pub pure command_output(name: Str, actual: ProcessOutput,
                         expected: ProcessOutput): TestResult {
  if actual.exit_code != expected.exit_code {
    wanted = expected.exit_code
    got = actual.exit_code
    std_testing.expect(name, false, "expected exit ${wanted}, got ${got}")
  } else {
    if actual.signal != expected.signal {
      wanted = expected.signal
      got = actual.signal
      std_testing.expect(name, false, "expected signal ${wanted}, got ${got}")
    } else {
      if actual.stdout != expected.stdout {
        std_testing.expect(name, false, "stdout differed")
      } else {
        if actual.stderr != expected.stderr {
          std_testing.expect(name, false, "stderr differed")
        } else {
          std_testing.expect(name, true, "")
        }
      }
    }
  }
}

pub pure command_result(name: Str, actual: Result[ProcessOutput,HostError],
                         expected: ProcessOutput): TestResult {
  match actual {
    Ok(output) => command_output(name, output, expected),
    Error(error) => {
      code = error.code
      std_testing.expect(name, false, "command failed: ${code}")
    }
  }
}

pure harness_path(text: Str): Path {
  std_result.value_or(std_path.from_text(text), std_path.current())
}

harness_write(destination: Str, contents: Bytes): Bool {
  match std_path.from_text(destination) {
    Error(error) => false,
    Ok(file) => match std_filesystem.write(file, contents) {
      Ok(done) => true,
      Error(error) => false
    }
  }
}

// Keep the command supervisor behind the standard-library boundary so its
// command, path, and host result identities are checked together.
pub harness_command(): Void {
  args = std_host.arguments()
  if len(args) < 6 {
    std_host.stderr("harness command requires six arguments")
    std_host.exit(1)
  }
  mut command: [Str] = []
  for index in 6..len(args) { command = command.append(args[index]) }
  match std_process.run(harness_path(args[5]), command, bytes(),
      harness_path(args[4]), [], std_time.seconds(nat_from_str(args[1])), 16777216) {
    Error(problem) => {
      code = problem.code
      if !harness_write(args[2], bytes()) ||
          !harness_write(args[3], std_text.encode_utf8("harness host error: ${code}\n")) {
        std_host.stderr("harness output write failed")
      } else {}
      std_host.exit(1)
    },
    Ok(output) => {
      if !harness_write(args[2], output.stdout) || !harness_write(args[3], output.stderr) {
        std_host.stderr("harness output write failed")
        std_host.exit(1)
      } else {
        accepted = if args[0] == "failure" { output.exit_code != 0 } else {
          output.exit_code == nat_from_str(args[0])
        }
        if !accepted || output.signal != 0 {
          std_host.stderr("harness command returned unexpected exit status or signal")
          std_host.exit(1)
        } else {}
      }
    }
  }
}

// Publish only a complete, byte-exact successful subprocess observation.
pub capture_report(name: Str, command: TestCommand, expected: ProcessOutput,
                        destination: Option[Path]): TestResult {
  actual = std_process.run(command.executable, command.arguments, command.stdin,
    command.working_directory, command.environment, command.timeout,
    command.output_limit)
  result = command_result(name, actual, expected)
  match result.outcome {
    TestFailed(reason) => match actual {
      Error(error) => result,
      Ok(output) => if output.exit_code != expected.exit_code ||
          output.signal != expected.signal || output.stdout != expected.stdout {
        actual_stdout: Str = std_text.decode_utf8(output.stdout)
        std_testing.expect(name, false, "${reason}; actual stdout: ${actual_stdout}")
      } else { result }
    },
    TestPassed() => match destination {
      None() => result,
      Some(file) => match actual {
        Error(error) => std_testing.expect(name, false, "report command failed"),
        Ok(output) => match std_filesystem.write(file, output.stdout) {
          Ok(done) => result,
          Error(error) => std_testing.expect(name, false, "runner report capture failed")
        }
      }
    }
  }
}

pub run_command(name: Str, command: TestCommand,
                 expected: ProcessOutput): TestResult {
  command_result(name, std_process.run(command.executable, command.arguments,
    command.stdin, command.working_directory, command.environment,
    command.timeout, command.output_limit), expected)
}

pub expect_command_error(name: Str, command: TestCommand,
                          expected_code: Str): TestResult {
  match std_process.run(command.executable, command.arguments, command.stdin,
                    command.working_directory, command.environment,
                    command.timeout, command.output_limit) {
    Ok(output) => std_testing.expect(name, false, "expected host error ${expected_code}, command completed"),
    Error(error) => {
      code = error.code
      std_testing.expect(name, code == expected_code, "expected host error ${expected_code}, got ${code}")
    }
  }
}
