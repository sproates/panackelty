pub import stdlib/host::{HostError}
import stdlib/filesystem::{FileKind, FileKind.Directory}

// The caller owns this unique temporary directory and all files created in it.
pub record TestWorkspace { root: Path }

pub workspace_create(parent: Path): Result[TestWorkspace,HostError] {
  match fs_temp_directory(parent) {
    Ok(root) => Ok(TestWorkspace(root)),
    Error(error) => Error(error)
  }
}

// Refuse to discard a workspace that still contains fixtures or output.
impl TestWorkspace {
  pub remove_empty(): Result[Unit,HostError] {
    fs_remove_directory(self.root)
  }
}

// Discover immediate directory children in fs_list's native-byte sorted order.
// Symlinks are not followed. A filesystem error aborts discovery without a
// partial result; fs_list guarantees child names are relative.
pub discover_fixtures(root: Path): Result[[Path],HostError] {
  match fs_list(root) {
    Error(error) => Error(error),
    Ok(names) => {
      mut fixtures: [Path] = []
      mut failure: Option[HostError] = None()
      for name in names {
        match failure {
          Some(problem) => {},
          None() => {
            match root.join(name) {
              Error(path_error) => {
                failure = Some(HostError("discover_fixtures", "invalid_argument", 0))
              },
              Ok(child) => {
                match fs_metadata(child) {
                  Error(error) => { failure = Some(error) },
                  Ok(metadata) => {
                    if metadata.kind == Directory() {
                      fixtures = fixtures.append(child)
                    }
                  }
                }
              }
            }
          }
        }
      }
      match failure {
        Some(error) => Error(error),
        None() => Ok(fixtures)
      }
    }
  }
}
