pure text_length(value: Str): Nat {
  len(value)
}

pure text_slice(value: Str, start: Nat, end: Nat): Str {
  slice(value, start, end)
}

pure text_starts_with(value: Str, prefix: Str): Bool {
  starts_with(value, prefix)
}

pure text_starts_with_at(value: Str, prefix: Str, offset: Nat): Bool {
  starts_with_at(value, prefix, offset)
}

pure text_reverse(value: Str): Str {
  value.reverse()
}

pure text_is_digit(value: Str): Bool {
  is_digit(value)
}

pure text_is_letter(value: Str): Bool {
  is_letter(value)
}

pure text_is_whitespace(value: Str): Bool {
  is_whitespace(value)
}

pure text_parse_nat(value: Str): Nat {
  nat_from_str(value)
}

// Lengths and offsets use Unicode code points, like starts_with_at.
pure text_ends_with(value: Str, suffix: Str): Bool {
  value_length = len(value)
  suffix_length = len(suffix)
  if value_length >= suffix_length {
    // The checker proves constant bounds, not relations between two lengths.
    // Use exact signed arithmetic and a checked natural-number projection.
    length: Int = value_length
    offset = ((length - suffix_length) / 1).nat()
    starts_with_at(value, suffix, offset)
  } else {
    false
  }
}
