pub import stdlib/time/errors::{SleepError, SleepErrorKind}
import stdlib/time/errors as sleep_errors
pub import stdlib/host::{HostError}
pub import stdlib/core::{DurationError, DurationError.FractionalNanosecond, DurationError.ZeroDurationDivisor}
pub enum ClockError { ClockUnavailable }

pub pure from_nanoseconds(value: Int): Duration { duration_nanoseconds(value) }
pub pure from_seconds(value: Rat): Result[Duration,DurationError] {
  duration_from_seconds(value)
}
pub now(): Result[Instant,ClockError] { instant_now() }
pub pure seconds(value: Int): Duration {
  duration_nanoseconds(value * 1000000000)
}
pub pure milliseconds(value: Int): Duration {
  duration_nanoseconds(value * 1000000)
}

// Canonical names; legacy factories retain their implementation during migration.
pub pure nanoseconds(value: Int): Duration { from_nanoseconds(value) }
pub pure from_fractional_seconds(value: Rat): Result[Duration,DurationError] {
  from_seconds(value)
}

// Blocking wait; use time/async from an async function.
pub sleep(duration: Duration): Result[Unit,SleepError] { sleep_errors.convert(host_sleep(duration), duration) }
