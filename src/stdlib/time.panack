pub import stdlib/core::{DurationError, DurationError.FractionalNanosecond, DurationError.ZeroDurationDivisor}
pub enum ClockError { ClockUnavailable }

pub pure from_nanoseconds(value: Int): Duration { duration_nanoseconds(value) }
pub pure from_seconds(value: Rat): Result[Duration,DurationError] {
  duration_from_seconds(value)
}
pub now(): Result[Instant,ClockError] { instant_now() }
pub pure seconds(value: Int): Duration {
  duration_nanoseconds(value * 1000000000)
}
pub pure milliseconds(value: Int): Duration {
  duration_nanoseconds(value * 1000000)
}
