import "../../../src/compiler/driver.panack"

// Consume actual emitter entries. The test-only sidecar/observer remains bounded
// to INDEX_GET; it never infers instruction identity from AST shape or proximity.
source_mapping_probe(mapped: SourceMappedProgram): Void {
  for mapping in mapped.sources {
    for function in mapped.bytecode.functions {
      if function.name == mapping.name {
        for entry in mapping.entries {
          if entry.index < len(function.instructions) {
            if render_instruction(function.instructions[entry.index]) == "INDEX_GET" && !entry.lowered {
              name: Str = mapping.name
              pc: Nat = entry.index
              file: Str = entry.span.start.file
              start: Nat = entry.span.start.offset
              end: Nat = entry.span.end.offset
              print("map\t${name}\t${pc}\t${file}\t${start}\t${end}")
            }
          }
        }
      }
    }
  }
}

main(): Void {
  args: [Str] = command_args()
  if len(args) != 3 { eprint("expected entry, output and map/plain mode"); process_exit(1); } else {}
  loaded: LoadedProject = load_project(args[0])
  if len(loaded.diagnostics) > 0 {
    eprint(diagnostic_messages(loaded.diagnostics, loaded.sources))
    process_exit(1)
  } else {
    if args[2] == "map" {
      mapped: SourceMappedProgram = compile_program_with_sources(loaded.program)
      write_bytes(args[1], serialize_bytecode(mapped.bytecode))
      source_mapping_probe(mapped)
    } else {
      write_bytes(args[1], serialize_bytecode(compile_program(loaded.program)))
    }
  }
}
