
pure twice(value: Nat): Nat { value * 2 }
pure total(accumulator: Nat, value: Nat): Nat { accumulator + value }
pure apply(callback: PureFn[Nat,Nat], value: Nat): Nat { intrinsic_call(callback, value) }
main(): Void {
  callback: PureFn[Nat,Nat] = @twice
  print(intrinsic_map([1, 2], callback))
  print(intrinsic_reduce([1, 2], 0, @total))
  print(apply(callback, 3))
}
