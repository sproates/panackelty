
record Pair { left: Nat, right: Nat }
pure total(pair: Pair, extra: Nat): Nat { pair.left + pair.right + extra }
main(): Void {
  pair: Pair = Pair(20, 21);
  values: [Nat] = append([total(pair, 1)], 43);
  mut answers: Map[Str,Nat] = map();
  answers = map_put(answers, "answer", values[0]);
  mut seen: Set[Str] = set();
  seen = set_add(seen, "answer");
  print(len(values));
  print(map_has(answers, "answer"));
  print(map_get(answers, "answer"));
  print(set_has(seen, "answer"));
}
