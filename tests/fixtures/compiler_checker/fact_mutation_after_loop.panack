type Positive = Nat where value > 0
enum Choice { Chosen(Nat), AbsentChoice }
consume(a: Nat, b: Nat): Void { print(b) }
consume_positive(a: Nat, b: Positive): Void { print(b) }
main(): Void {
  mut balance: Nat = 5
  if balance >= 2 {
    while balance > 0 { balance = balance - 1 }
    print(balance - 2)
  }
}
