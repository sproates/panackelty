
pure increment(value: Nat, amount: Nat): Nat { value + amount }
main(): Void {
  values: [Nat] = append([increment(40, 2)], 43);
  mut answers: Map[Str,Nat] = map();
  answers = map_put(answers, "answer", values[0]);
  print(map_has(answers, "answer"));
  print(map_get(answers, "answer"));
  print(set_has(set_add(set(), "answer"), "answer"));
  print(len(values));
}
