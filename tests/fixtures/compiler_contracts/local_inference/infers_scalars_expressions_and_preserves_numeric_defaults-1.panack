
pure natural(value: Nat): Nat { value }
pure signed(): Int { 41 }
main(): Void {
  answer = 41
  zero = 0
  negative = -41
  price = 41.0
  name = "Ada"
  active = true
  label = "Hi, ${name}"
  result = signed()
  data = utf8_encode(label)
  choice = if active { "yes" } else { "no" }
  remaining = answer - 40
  natural(answer)
  natural(zero)
  checked_negative: Int = negative
  checked_price: Dec = price
  checked_data: Bytes = data
  checked_result: Int = result
}
