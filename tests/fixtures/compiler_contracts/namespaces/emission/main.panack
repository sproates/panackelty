import "left.panack" as left
import "right.panack" as right
pure invoke(callback: PureFn[Nat]): Nat { callback.call() }
main(): Void {
  left_item: left.Envelope[Nat] = left.make()
  right_item: right.Envelope[Nat] = right.make()
  left_outcome: left.Outcome[Nat] = left.make_outcome()
  right_outcome: right.Outcome[Nat] = right.make_outcome()
  print(left.identity(left_item.item.value))
  print(right.identity(right_item.item.value))
  print(invoke(@left.indirect_value))
  print(invoke(@right.indirect_value))
  match left_outcome { left.Outcome.Finished(value) => print(value.item.value) }
  match right_outcome { right.Outcome.Finished(value) => print(value.item.value) }
}
