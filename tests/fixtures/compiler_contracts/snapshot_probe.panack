import project/src/compiler/loader::{LoadedProject, load_project}
import project/src/compiler/diagnostics::{diagnostic_with_source}
import stdlib/testing::{test_equal_str, test_report}
import stdlib/host::{host_command_arguments, host_exit}
import stdlib/bytes::{text_encode_utf8}
import stdlib/filesystem::{filesystem_read_text, filesystem_write_file_bytes}
main(): Void {
  filename = host_command_arguments()[0]
  filesystem_write_file_bytes(filename, text_encode_utf8("main(): Void { print(missing) }\n"))
  loaded: LoadedProject = load_project(filename)
  filesystem_write_file_bytes(filename, text_encode_utf8("main(): Void {}"))
  results = [
    test_equal_str("snapshot file changed", filesystem_read_text(filename), "main(): Void {}"),
    test_equal_str("loader retains original diagnostic source",
      diagnostic_with_source(loaded.diagnostics[0], loaded.sources) + "\n",
      "${filename}:1:22: unknown name missing\n  1 | main(): Void { print(missing) }\n    |                      ^\n")
  ]
  if test_report(results) > 0 { host_exit(1) }
}
