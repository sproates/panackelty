import "unused.panack"

pure choose(flag: Bool): Nat { if flag { 1 } else { 2 } }
pure generic[T](value: T): T { value }
pure empty(): Void {}
main(): Void {
  mut value: Nat = 0
  while value < 2 { value = value + 1; }
  for item in [1, 2] { print(item); }
  skipped: Bool = false && true
  taken: Bool = true || false
  match Some(3) { Some(item) => { print(item); }, None() => {} }
  print(choose(true))
  print(generic[Nat](4))
  print(generic[Str]("x"))
}
