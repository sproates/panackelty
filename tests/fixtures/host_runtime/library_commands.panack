import stdlib/testing_commands
main(): Void {
  expected = ProcessOutput(0, 0, utf8_encode("out"), utf8_encode("err"))
  print(test_report([
    test_command_output("match", expected, expected),
    test_command_output("exit", ProcessOutput(2, 0, bytes(), bytes()), expected),
    test_command_output("signal", ProcessOutput(0, 9, bytes(), bytes()), expected),
    test_command_output("stdout", ProcessOutput(0, 0, bytes(), utf8_encode("err")), expected),
    test_command_output("stderr", ProcessOutput(0, 0, utf8_encode("out"), bytes()), expected),
    test_command_result("host", Error(HostError("process", "timeout", 0)), expected)
  ]))
}
