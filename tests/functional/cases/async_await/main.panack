import stdlib/testing_async as testing_async

// A failed assertion traps, so a silent successful exit verifies the values.
pure expect(value: Bool): Unit { checked = [0][if value { 0 } else { 1 }]; () }
async read(fail: Bool): Result[Bytes,Str] { await testing_async.read(fail) }
async nested(depth: Nat): Result[Bytes,Str] {
  if depth > 0 { await nested(depth - 1) } else { await read(false) }
}
async select(value: Nat): Result[Bytes, Str] {
  if value == 0 {
    await read(false)
  } else if value == 1 {
    await read(true)
  } else {
    await read(false)
  }
}

async main(): Unit {
  reader: AsyncFn[Bool,Result[Bytes,Str]] = @read
  match await reader->call(false) {
    Ok(data) => expect(data->decode_utf8() == "fake bytes"),
    Error(problem) => expect(false)
  }
  match await read(true) {
    Ok(data) => expect(false),
    Error(problem) => expect(problem == "fake I/O error")
  }
  match await nested(128) {
    Ok(data) => expect(data->length() == 10),
    Error(problem) => expect(false)
  }
  for value in [0, 1, 2] {
    match await select(value) {
      Ok(data) => expect(value != 1 && data->decode_utf8() == "fake bytes"),
      Error(problem) => expect(value == 1 && problem == "fake I/O error")
    }
  }
  ()
}
