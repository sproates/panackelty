import stdlib/result::{result_value_or}
import stdlib/testing_files::{test_workspace_create, test_workspace_remove_empty}
import stdlib/testing_commands::{TestCommand, ProcessOutput, test_run_command}
import stdlib/testing::{TestResult, test_expect, test_report}
import stdlib/time::{duration_seconds}
import stdlib/environment::{environment_value}
import stdlib/path::{path_value_from_text, path_value_current, path_value_append, path_value_to_text}
import stdlib/filesystem::{filesystem_read_bytes, filesystem_write_bytes, filesystem_create_directory, filesystem_remove_file, filesystem_remove_directory}
import stdlib/testing_commands::{testing_process_run}
import stdlib/bytes::{bytes_empty, text_encode_utf8, text_decode_utf8}
import stdlib/host::{host_exit, host_stderr_text}
pure path(value: Str): Path {
  result_value_or(path_value_from_text(value), path_value_current())
}

pure child(root: Path, name: Str): Path {
  result_value_or(path_value_append(root, path(name)), root)
}

pure contains(value: Str, fragment: Str): Bool {
  mut found = false
  for index in 0..value.len() {
    if value.starts_with_at(fragment, index) { found = true }
  }
  found
}

pure replace_first(value: Str, needle: Str, replacement: Str): Str {
  mut index: Nat = 0
  mut found: Bool = false
  while index + len(needle) <= len(value) && !found {
    if slice(value, index, index + len(needle)) == needle { found = true }
    else { index = index + 1 }
  }
  if found {
    slice(value, 0, index) + replacement + slice(value, index + len(needle), len(value))
  } else { value }
}

pure manifest_version_from_output(value: Str): Str {
  mut end: Nat = 7
  while end < len(value) && !value.starts_with_at(" ", end) {
    end = end + 1
  }
  if end > 7 { slice(value, 7, end) } else { "" }
}

manifest_toolchain_version(): Str {
  match testing_process_run(path("./panack"), ["--version"], bytes_empty(),
      path_value_current(), [], duration_seconds(10), 1024) {
    Error(error) => "",
    Ok(output) => if output.exit_code == 0 && output.signal == 0 && output.stderr == bytes_empty() {
      manifest_version_from_output(text_decode_utf8(output.stdout))
    } else { "" }
  }
}

pure command(arguments: [Str]): TestCommand {
  TestCommand(path("./panack"), arguments, bytes_empty(), path_value_current(), [],
    duration_seconds(10), 1048576)
}

source_compiler_arguments(arguments: [Str]): [Str] {
  compiler: Str = environment_value("PANACK_TEST_COMPILER")
  mut invocation: [Str] = ["run", if compiler == "" {
    "build/bootstrap/stage2/compiler.bc"
  } else { compiler }]
  for argument in arguments {
    invocation = invocation.append(argument)
  }
  invocation
}

source_compiler_command(arguments: [Str], toolchain_version: Str): TestCommand {
  TestCommand(path("./panack-vm"), source_compiler_arguments(arguments), bytes_empty(), path_value_current(),
    ["PANACKELTY_VERSION=${toolchain_version}"], duration_seconds(10), 1048576)
}

main(): Void {
  match test_workspace_create(path("/tmp")) {
    Error(error) => { print("workspace creation failed"); host_exit(1) },
    Ok(workspace) => {
      original = "tests/functional/cases/hello_world/main.panack"
      source = child(workspace.root, "hello.panack")
      bytecode = child(workspace.root, "hello.bc")
      arguments_source = child(workspace.root, "arguments.panack")
      failing_source = child(workspace.root, "failure.panack")
      source_text = result_value_or(path_value_to_text(source), "invalid-source")
      bytecode_text = result_value_or(path_value_to_text(bytecode), "invalid-bytecode")
      arguments_text = result_value_or(path_value_to_text(arguments_source), "invalid-arguments")
      failing_text = result_value_or(path_value_to_text(failing_source), "invalid-failure")
      package_root = child(workspace.root, "package")
      package_source_root = child(package_root, "src")
      package_entry = child(package_source_root, "main.panack")
      package_value = child(package_source_root, "value.panack")
      package_manifest = child(package_root, "panack.json")
      library_root = child(workspace.root, "library")
      library_source_root = child(library_root, "src")
      library_private = child(library_source_root, "implementation.panack")
      library_api = child(library_source_root, "api.panack")
      library_extra = child(library_source_root, "extra.panack")
      library_escape = child(library_source_root, "escaped.panack")
      library_escape_target = child(workspace.root, "outside-package.panack")
      library_manifest = child(library_root, "panack.json")
      library_copy_root = child(workspace.root, "library-copy")
      library_copy_manifest = child(library_copy_root, "panack.json")
      internal_root = child(workspace.root, "internal")
      internal_source_root = child(internal_root, "src")
      internal_api = child(internal_source_root, "math.panack")
      internal_manifest = child(internal_root, "panack.json")
      relocated_root = child(workspace.root, "relocated")
      relocated_source_root = child(relocated_root, "src")
      relocated_entry = child(relocated_source_root, "main.panack")
      relocated_value = child(relocated_source_root, "value.panack")
      relocated_manifest = child(relocated_root, "panack.json")
      package_root_text = result_value_or(path_value_to_text(package_root), "invalid-package")
      package_source_root_text = result_value_or(path_value_to_text(package_source_root), "invalid-source-root")
      package_entry_text = result_value_or(path_value_to_text(package_entry), "invalid-entry")
      package_value_text = result_value_or(path_value_to_text(package_value), "invalid-value")
      package_manifest_text = result_value_or(path_value_to_text(package_manifest), "invalid-manifest")
      library_manifest_text = result_value_or(path_value_to_text(library_manifest), "invalid-library-manifest")
      library_escape_text = result_value_or(path_value_to_text(library_escape), "invalid-library-escape")
      library_escape_target_text = result_value_or(path_value_to_text(library_escape_target), "invalid-library-escape-target")
      library_copy_manifest_text = result_value_or(path_value_to_text(library_copy_manifest), "invalid-library-copy-manifest")
      internal_manifest_text = result_value_or(path_value_to_text(internal_manifest), "invalid-internal-manifest")
      relocated_root_text = result_value_or(path_value_to_text(relocated_root), "invalid-relocated")
      relocated_manifest_text = result_value_or(path_value_to_text(relocated_manifest), "invalid-relocated-manifest")
      mut results: [TestResult] = []

      results = results.append(test_run_command("bare source path", command([original]),
        ProcessOutput(0, 0, text_encode_utf8("hello world\n"), bytes_empty())))
      match filesystem_read_bytes(path(original), 1048576) {
        Error(error) => {
          results = results.append(test_expect("default compile output", false,
            "fixture read failed"))
        },
        Ok(content) => {
          match filesystem_write_bytes(source, content) {
            Error(error) => {
              results = results.append(test_expect("default compile output", false,
                "fixture write failed"))
            },
            Ok(value) => {
              results = results.append(test_run_command("default compile output",
                command(["compile", source_text]),
                ProcessOutput(0, 0, text_encode_utf8("wrote ${bytecode_text}\n"), bytes_empty())))
              results = results.append(test_run_command("bare bytecode path",
                command([bytecode_text]),
                ProcessOutput(0, 0, text_encode_utf8("hello world\n"), bytes_empty())))
            }
          }
        }
      }

      filesystem_create_directory(package_root)
      filesystem_create_directory(package_source_root)
      toolchain_version = manifest_toolchain_version()
      manifest_text = "{\"schema\":1,\"package\":\"example.application\",\"version\":\"1.0.0\",\"language\":\"modules-v1\",\"toolchain\":\"${toolchain_version}\",\"source\":\"src\",\"entry\":\"main.panack\",\"exports\":{\"value\":\"value.panack\"},\"dependencies\":{}}"
      filesystem_write_bytes(package_manifest, text_encode_utf8(manifest_text))
      filesystem_write_bytes(package_entry, text_encode_utf8(
        "import project/value as value\nmain(): Void { print(value.answer()); arguments: [Str] = command_args(); print(len(arguments)); }\n"))
      filesystem_write_bytes(package_value, text_encode_utf8("pub pure answer(): Nat { 42 }\n"))
      results = results.append(test_run_command("explicit manifest package check",
        command(["check", "--project", package_manifest_text]),
        ProcessOutput(0, 0, text_encode_utf8("ok\n"), bytes_empty())))
      results = results.append(test_run_command("explicit manifest package source run",
        command(["run", "--project", package_manifest_text, "alpha"]),
        ProcessOutput(0, 0, text_encode_utf8("42\n1\n"), bytes_empty())))
      results = results.append(test_run_command("explicit manifest package compile",
        command(["compile", "--project", package_manifest_text, "-o", bytecode_text]),
        ProcessOutput(0, 0, text_encode_utf8("wrote ${bytecode_text}\n"), bytes_empty())))
      filesystem_create_directory(library_root)
      filesystem_create_directory(library_source_root)
      filesystem_create_directory(internal_root)
      filesystem_create_directory(internal_source_root)
      internal_manifest_contents = "{\"schema\":1,\"package\":\"example.math_support\",\"version\":\"1.0.0\",\"language\":\"modules-v1\",\"toolchain\":\"${toolchain_version}\",\"source\":\"src\",\"exports\":{\"math\":\"math.panack\"},\"dependencies\":{}}"
      filesystem_write_bytes(internal_manifest, text_encode_utf8(internal_manifest_contents))
      filesystem_write_bytes(internal_api, text_encode_utf8("pub pure answer(): Nat { 42 }\n"))
      library_manifest_text_value = "{\"schema\":1,\"package\":\"example.geometry\",\"version\":\"1.0.0\",\"language\":\"modules-v1\",\"toolchain\":\"${toolchain_version}\",\"source\":\"src\",\"exports\":{\"api\":\"api.panack\",\"api_alias\":\"api.panack\",\"extra\":\"extra.panack\"},\"dependencies\":{}}"
      filesystem_write_bytes(library_manifest, text_encode_utf8(library_manifest_text_value))
      filesystem_write_bytes(library_api, text_encode_utf8(
        "import project/implementation as implementation\npub pure answer(): Nat { implementation.answer() }\n"))
      filesystem_write_bytes(library_private, text_encode_utf8("pub pure answer(): Nat { 42 }\n"))
      filesystem_write_bytes(library_extra, text_encode_utf8(
        "import project/api as api\npub pure next_answer(): Nat { api.answer() + 1 }\n"))
      results = results.append(test_run_command("manifest-only library checks each exported module without main",
        source_compiler_command(["check", "--project", library_manifest_text], toolchain_version),
        ProcessOutput(0, 0, text_encode_utf8("ok\n"), bytes_empty())))
      filesystem_write_bytes(library_escape_target, text_encode_utf8("pub pure leaked(): Nat { 99 }\n"))
      escape_link_setup = testing_process_run(path("/bin/ln"), ["-s", library_escape_target_text, library_escape_text],
        bytes_empty(), path_value_current(), [], duration_seconds(10), 1024)
      match escape_link_setup {
        Error(error) => {
          results = results.append(test_expect("package export escape symlink setup", false,
            "symlink command failed"))
        },
        Ok(output) => {
          results = results.append(test_expect("package export escape symlink setup",
            output.exit_code == 0 && output.signal == 0, "symlink command failed"))
        }
      }
      library_escape_manifest_text = replace_first(library_manifest_text_value,
        "\"extra\":\"extra.panack\"",
        "\"extra\":\"extra.panack\",\"escape\":\"escaped.panack\"")
      filesystem_write_bytes(library_manifest, text_encode_utf8(library_escape_manifest_text))
      match testing_process_run(path("./panack-vm"),
          source_compiler_arguments(["check", "--project", library_manifest_text]),
          bytes_empty(), path_value_current(), ["PANACKELTY_VERSION=${toolchain_version}"],
          duration_seconds(10), 1048576) {
        Error(error) => {
          results = results.append(test_expect("package exports reject symlink escapes", false,
            "compiler process failed"))
        },
        Ok(output) => {
          results = results.append(test_expect("package exports reject symlink escapes",
            output.exit_code == 1 && output.signal == 0 &&
              contains(text_decode_utf8(output.stderr), "package source read failed (invalid_argument)"),
            "a package export symlink escaped its physical package root"))
        }
      }
      filesystem_remove_file(library_escape)
      filesystem_remove_file(library_escape_target)
      filesystem_write_bytes(library_manifest, text_encode_utf8(library_manifest_text_value))

      dependency_manifest_text = replace_first(manifest_text, "\"dependencies\":{}",
        "\"dependencies\":{\"geometry\":{\"path\":\"../library\"}}")
      filesystem_write_bytes(package_manifest, text_encode_utf8(dependency_manifest_text))
      filesystem_write_bytes(package_entry, text_encode_utf8(
        "import project/value as value\nimport geometry/api as geometry\nmain(): Void { print(value.answer()); print(geometry.answer()); arguments: [Str] = command_args(); print(len(arguments)); }\n"))
      results = results.append(test_run_command("manifest application checks declared local library",
        source_compiler_command(["check", "--project", package_manifest_text], toolchain_version),
        ProcessOutput(0, 0, text_encode_utf8("ok\n"), bytes_empty())))
      results = results.append(test_run_command("manifest application runs declared local library",
        source_compiler_command(["run", "--project", package_manifest_text, "alpha"], toolchain_version),
        ProcessOutput(0, 0, text_encode_utf8("42\n42\n1\n"), bytes_empty())))
      results = results.append(test_run_command("manifest application compiles declared local library",
        source_compiler_command(["compile", "--project", package_manifest_text, "-o", bytecode_text], toolchain_version),
        ProcessOutput(0, 0, text_encode_utf8("wrote ${bytecode_text}\n"), bytes_empty())))
      results = results.append(test_run_command("manifest application bytecode retains local library",
        command([bytecode_text]),
        ProcessOutput(0, 0, text_encode_utf8("42\n42\n0\n"), bytes_empty())))
      filesystem_write_bytes(package_entry, text_encode_utf8(
        "import geometry/implementation as implementation\nmain(): Void { print(implementation.answer()); }\n"))
      match testing_process_run(path("./panack-vm"),
          source_compiler_arguments(["check", "--project", package_manifest_text]),
          bytes_empty(), path_value_current(), ["PANACKELTY_VERSION=${toolchain_version}"],
          duration_seconds(10), 1048576) {
        Error(error) => {
          results = results.append(test_expect("local dependency hides unexported modules", false,
            "compiler process failed"))
        },
        Ok(output) => {
          results = results.append(test_expect("local dependency hides unexported modules",
            output.exit_code == 1 && output.signal == 0 &&
              contains(text_decode_utf8(output.stderr), "dependency import is not declared or the module is not exported: geometry/implementation"),
            "an unexported dependency module was importable"))
        }
      }
      filesystem_write_bytes(package_entry, text_encode_utf8(
        "import missing/api as api\nmain(): Void { print(api.answer()); }\n"))
      match testing_process_run(path("./panack-vm"),
          source_compiler_arguments(["check", "--project", package_manifest_text]),
          bytes_empty(), path_value_current(), ["PANACKELTY_VERSION=${toolchain_version}"],
          duration_seconds(10), 1048576) {
        Error(error) => {
          results = results.append(test_expect("local dependency aliases must be declared", false,
            "compiler process failed"))
        },
        Ok(output) => {
          results = results.append(test_expect("local dependency aliases must be declared",
            output.exit_code == 1 && output.signal == 0 &&
              contains(text_decode_utf8(output.stderr), "dependency import is not declared or the module is not exported: missing/api"),
            "an undeclared dependency alias was importable"))
        }
      }
      filesystem_write_bytes(package_entry, text_encode_utf8(
        "import project/value as value\nimport geometry/api as geometry\nmain(): Void { print(value.answer()); print(geometry.answer()); arguments: [Str] = command_args(); print(len(arguments)); }\n"))

      second_app_root = child(workspace.root, "second-app")
      second_app_source_root = child(second_app_root, "src")
      second_app_entry = child(second_app_source_root, "main.panack")
      second_app_manifest = child(second_app_root, "panack.json")
      second_app_manifest_text = result_value_or(path_value_to_text(second_app_manifest), "invalid-second-app-manifest")
      filesystem_create_directory(second_app_root)
      filesystem_create_directory(second_app_source_root)
      mut second_app_manifest_contents = replace_first(dependency_manifest_text,
        "example.application", "example.second_application")
      second_app_manifest_contents = replace_first(second_app_manifest_contents,
        "\"geometry\":{\"path\":\"../library\"}",
        "\"geometry\":{\"path\":\"../library\"},\"geometry_copy\":{\"path\":\"../library\"}")
      filesystem_write_bytes(second_app_manifest, text_encode_utf8(second_app_manifest_contents))
      filesystem_write_bytes(second_app_entry, text_encode_utf8(
        "import geometry_copy/api as geometry\nmain(): Void { print(geometry.answer()); }\n"))
      results = results.append(test_run_command("second manifest application shares the local library",
        source_compiler_command(["run", "--project", second_app_manifest_text], toolchain_version),
        ProcessOutput(0, 0, text_encode_utf8("42\n"), bytes_empty())))
      filesystem_create_directory(library_copy_root)
      filesystem_write_bytes(library_copy_manifest, text_encode_utf8(library_manifest_text_value))
      duplicate_root_manifest = replace_first(dependency_manifest_text,
        "\"geometry\":{\"path\":\"../library\"}",
        "\"geometry\":{\"path\":\"../library\"},\"geometry_alt\":{\"path\":\"../library-copy\"}")
      filesystem_write_bytes(package_manifest, text_encode_utf8(duplicate_root_manifest))
      match testing_process_run(path("./panack-vm"),
          source_compiler_arguments(["check", "--project", package_manifest_text]),
          bytes_empty(), path_value_current(), ["PANACKELTY_VERSION=${toolchain_version}"],
          duration_seconds(10), 1048576) {
        Error(error) => {
          results = results.append(test_expect("package identity cannot come from multiple roots", false,
            "compiler process failed"))
        },
        Ok(output) => {
          results = results.append(test_expect("package identity cannot come from multiple roots",
            output.exit_code == 1 && output.signal == 0 &&
              contains(text_decode_utf8(output.stderr), "resolves to multiple physical roots"),
            "duplicate physical package identities were accepted"))
        }
      }
      overlap_package_root = child(package_source_root, "embedded-library")
      overlap_source_root = child(overlap_package_root, "src")
      overlap_manifest = child(overlap_package_root, "panack.json")
      filesystem_create_directory(overlap_package_root)
      filesystem_create_directory(overlap_source_root)
      overlap_manifest_contents = "{\"schema\":1,\"package\":\"example.embedded\",\"version\":\"1.0.0\",\"language\":\"modules-v1\",\"toolchain\":\"${toolchain_version}\",\"source\":\"src\",\"exports\":{\"api\":\"api.panack\"},\"dependencies\":{}}"
      filesystem_write_bytes(overlap_manifest, text_encode_utf8(overlap_manifest_contents))
      app_root_overlap_manifest = replace_first(dependency_manifest_text,
        "\"geometry\":{\"path\":\"../library\"}",
        "\"geometry\":{\"path\":\"src/embedded-library\"}")
      filesystem_write_bytes(package_manifest, text_encode_utf8(app_root_overlap_manifest))
      match testing_process_run(path("./panack-vm"),
          source_compiler_arguments(["check", "--project", package_manifest_text]),
          bytes_empty(), path_value_current(), ["PANACKELTY_VERSION=${toolchain_version}"],
          duration_seconds(10), 1048576) {
        Error(error) => {
          results = results.append(test_expect("package source roots cannot overlap the app root", false,
            "compiler process failed"))
        },
        Ok(output) => {
          results = results.append(test_expect("package source roots cannot overlap the app root",
            output.exit_code == 1 && output.signal == 0 &&
              contains(text_decode_utf8(output.stderr), "physical source root overlaps the application source root"),
            "a dependency source root nested in the application source root was accepted"))
        }
      }
      filesystem_write_bytes(package_manifest, text_encode_utf8(dependency_manifest_text))
      filesystem_remove_file(overlap_manifest)
      filesystem_remove_directory(overlap_source_root)
      filesystem_remove_directory(overlap_package_root)

      overlap_package_root_two = child(library_source_root, "nested-library")
      overlap_source_root_two = child(overlap_package_root_two, "src")
      overlap_manifest_two = child(overlap_package_root_two, "panack.json")
      filesystem_create_directory(overlap_package_root_two)
      filesystem_create_directory(overlap_source_root_two)
      filesystem_write_bytes(overlap_manifest_two, text_encode_utf8(
        replace_first(overlap_manifest_contents, "example.embedded", "example.nested")))
      dependency_overlap_manifest = replace_first(library_manifest_text_value,
        "\"dependencies\":{}",
        "\"dependencies\":{\"nested\":{\"path\":\"src/nested-library\"}}")
      filesystem_write_bytes(library_manifest, text_encode_utf8(dependency_overlap_manifest))
      match testing_process_run(path("./panack-vm"),
          source_compiler_arguments(["check", "--project", package_manifest_text]),
          bytes_empty(), path_value_current(), ["PANACKELTY_VERSION=${toolchain_version}"],
          duration_seconds(10), 1048576) {
        Error(error) => {
          results = results.append(test_expect("nested dependency roots cannot overlap their parent", false,
            "compiler process failed"))
        },
        Ok(output) => {
          results = results.append(test_expect("nested dependency roots cannot overlap their parent",
            output.exit_code == 1 && output.signal == 0 &&
              contains(text_decode_utf8(output.stderr), "physical source root overlaps dependency geometry"),
            "a nested dependency source root overlapped its declaring package"))
        }
      }
      filesystem_write_bytes(package_manifest, text_encode_utf8(dependency_manifest_text))
      filesystem_write_bytes(library_manifest, text_encode_utf8(library_manifest_text_value))
      filesystem_remove_file(overlap_manifest_two)
      filesystem_remove_directory(overlap_source_root_two)
      filesystem_remove_directory(overlap_package_root_two)
      filesystem_write_bytes(package_manifest, text_encode_utf8(dependency_manifest_text))
      missing_dependency_manifest = replace_first(dependency_manifest_text, "../library", "../missing")
      filesystem_write_bytes(package_manifest, text_encode_utf8(missing_dependency_manifest))
      match testing_process_run(path("./panack-vm"),
          source_compiler_arguments(["check", "--project", package_manifest_text]),
          bytes_empty(), path_value_current(), ["PANACKELTY_VERSION=${toolchain_version}"],
          duration_seconds(10), 1048576) {
        Error(error) => {
          results = results.append(test_expect("declared package path must contain a manifest", false,
            "compiler process failed"))
        },
        Ok(output) => {
          results = results.append(test_expect("declared package path must contain a manifest",
            output.exit_code == 1 && output.signal == 0 &&
              contains(text_decode_utf8(output.stderr), "dependency geometry: cannot read local dependency manifest"),
            "a missing dependency manifest was accepted"))
        }
      }
      filesystem_write_bytes(package_manifest, text_encode_utf8(dependency_manifest_text))
      nested_dependency_manifest = replace_first(library_manifest_text_value,
        "\"dependencies\":{}", "\"dependencies\":{\"common\":{\"path\":\"../internal\"}}")
      filesystem_write_bytes(library_manifest, text_encode_utf8(nested_dependency_manifest))
      filesystem_write_bytes(library_api, text_encode_utf8(
        "import common/math as math\npub pure answer(): Nat { math.answer() }\n"))
      nested_diamond_manifest = replace_first(dependency_manifest_text,
        "\"geometry\":{\"path\":\"../library\"}",
        "\"geometry\":{\"path\":\"../library\"},\"math_direct\":{\"path\":\"../internal\"}")
      filesystem_write_bytes(package_manifest, text_encode_utf8(nested_diamond_manifest))
      filesystem_write_bytes(package_entry, text_encode_utf8(
        "import project/value as value\nimport geometry/api as geometry\nimport math_direct/math as direct_math\nmain(): Void { print(value.answer()); print(geometry.answer()); print(direct_math.answer()); arguments: [Str] = command_args(); print(len(arguments)); }\n"))
      match testing_process_run(path("./panack-vm"),
          source_compiler_arguments(["check", "--project", package_manifest_text]),
          bytes_empty(), path_value_current(), ["PANACKELTY_VERSION=${toolchain_version}"],
          duration_seconds(10), 1048576) {
        Error(error) => {
          results = results.append(test_expect("nested diamond dependency checks", false,
            "compiler process failed"))
        },
        Ok(output) => {
          results = results.append(test_expect("nested diamond dependency checks",
            output.exit_code == 0 && output.signal == 0 &&
              text_decode_utf8(output.stdout) == "ok\n" && output.stderr == bytes_empty(),
            "a valid nested dependency graph did not check"))
        }
      }
      results = results.append(test_run_command("manifest application runs nested and direct paths to one library",
        source_compiler_command(["run", "--project", package_manifest_text, "alpha"], toolchain_version),
        ProcessOutput(0, 0, text_encode_utf8("42\n42\n42\n1\n"), bytes_empty())))
      results = results.append(test_run_command("manifest application compiles nested and direct paths to one library",
        source_compiler_command(["compile", "--project", package_manifest_text, "-o", bytecode_text], toolchain_version),
        ProcessOutput(0, 0, text_encode_utf8("wrote ${bytecode_text}\n"), bytes_empty())))
      results = results.append(test_run_command("nested dependency diamond survives bytecode compilation",
        command([bytecode_text]),
        ProcessOutput(0, 0, text_encode_utf8("42\n42\n42\n0\n"), bytes_empty())))
      filesystem_write_bytes(package_entry, text_encode_utf8(
        "import common/math as math\nmain(): Void { print(math.answer()); }\n"))
      match testing_process_run(path("./panack-vm"),
          source_compiler_arguments(["check", "--project", package_manifest_text]),
          bytes_empty(), path_value_current(), ["PANACKELTY_VERSION=${toolchain_version}"],
          duration_seconds(10), 1048576) {
        Error(error) => {
          results = results.append(test_expect("nested dependency alias stays private to its package", false,
            "compiler process failed"))
        },
        Ok(output) => {
          results = results.append(test_expect("nested dependency alias stays private to its package",
            output.exit_code == 1 && output.signal == 0 &&
              contains(text_decode_utf8(output.stderr),
                "dependency import is not declared or the module is not exported: common/math"),
            "the application inherited its dependency's alias"))
        }
      }
      cyclic_internal_manifest = replace_first(internal_manifest_contents,
        "\"dependencies\":{}", "\"dependencies\":{\"geometry\":{\"path\":\"../library\"}}")
      filesystem_write_bytes(internal_manifest, text_encode_utf8(cyclic_internal_manifest))
      match testing_process_run(path("./panack-vm"),
          source_compiler_arguments(["check", "--project", package_manifest_text]),
          bytes_empty(), path_value_current(), ["PANACKELTY_VERSION=${toolchain_version}"],
          duration_seconds(10), 1048576) {
        Error(error) => {
          results = results.append(test_expect("nested package dependency cycle is rejected", false,
            "compiler process failed"))
        },
        Ok(output) => {
          results = results.append(test_expect("nested package dependency cycle is rejected",
            output.exit_code == 1 && output.signal == 0 &&
              contains(text_decode_utf8(output.stderr), "package dependency cycle detected"),
            "a cyclic package graph was accepted"))
        }
      }
      filesystem_write_bytes(internal_manifest, text_encode_utf8(internal_manifest_contents))
      filesystem_write_bytes(package_manifest, text_encode_utf8(dependency_manifest_text))
      filesystem_write_bytes(package_entry, text_encode_utf8(
        "import project/value as value\nimport geometry/api as geometry\nmain(): Void { print(value.answer()); print(geometry.answer()); arguments: [Str] = command_args(); print(len(arguments)); }\n"))
      filesystem_write_bytes(library_manifest, text_encode_utf8(library_manifest_text_value))
      filesystem_write_bytes(library_api, text_encode_utf8(
        "import project/implementation as implementation\npub pure answer(): Nat { implementation.answer() }\n"))
      race_compiler: Str = environment_value("PANACK_TEST_COMPILER")
      race_compiler_path: Str = if race_compiler == "" {
        "build/bootstrap/stage2/compiler.bc"
      } else { race_compiler }
      match testing_process_run(path("/bin/sh"),
          ["tests/functional/cases/cli_commands/package_root_race.sh",
            race_compiler_path, toolchain_version, "src/stdlib"],
          bytes_empty(), path_value_current(), [], duration_seconds(20), 4096) {
        Error(error) => {
          results = results.append(test_expect(
            "package-root symlink replacement never mixes sources", false,
            "race harness could not run"))
        },
        Ok(output) => {
          race_output: Str = text_decode_utf8(output.stdout)
          results = results.append(test_expect(
            "package-root symlink replacement never mixes sources",
            output.exit_code == 0 && output.signal == 0 &&
              contains(race_output, "package root race passed (") &&
              contains(race_output, " identity changes,") &&
              output.stderr == bytes_empty(),
            "loader mixed package roots, missed the replacement, or failed unexpectedly"))
        }
      }
      graph_compiler: Str = environment_value("PANACK_TEST_COMPILER")
      graph_compiler_path: Str = if graph_compiler == "" {
        "build/bootstrap/stage2/compiler.bc"
      } else { graph_compiler }
      mut graph_output: Str = ""
      match testing_process_run(path("/bin/sh"),
          ["tests/functional/cases/cli_commands/package_graph_limits.sh",
            graph_compiler_path, toolchain_version, "src/stdlib"],
          bytes_empty(), path_value_current(), [], duration_seconds(120), 4096) {
        Error(error) => {
          results = results.append(test_expect(
            "nested package graph boundary fixture runs", false,
            "graph boundary fixture could not run"))
        },
        Ok(output) => {
          graph_output = text_decode_utf8(output.stdout)
          results = results.append(test_expect(
            "nested package graph boundary fixture runs",
            output.exit_code == 0 && output.signal == 0 && output.stderr == bytes_empty(),
            "graph boundary fixture did not complete successfully"))
        }
      }
      results = results.append(test_expect("nested package version conflicts are rejected",
        contains(graph_output, "PASS nested version conflict"),
        "a nested package version conflict was accepted"))
      results = results.append(test_expect("nested package identity conflicts are rejected",
        contains(graph_output, "PASS nested package identity resolves to multiple roots"),
        "one nested package identity resolved to multiple roots"))
      results = results.append(test_expect("64 package manifests are accepted",
        contains(graph_output, "PASS 64 package manifests accepted"),
        "the documented package manifest limit rejected its boundary"))
      results = results.append(test_expect("65 package manifests are rejected",
        contains(graph_output, "PASS 65 package manifests rejected"),
        "the package manifest limit accepted an oversized graph"))
      results = results.append(test_expect("256 dependency edges are accepted",
        contains(graph_output, "PASS 256 dependency edges accepted"),
        "the documented dependency edge limit rejected its boundary"))
      results = results.append(test_expect("257 dependency edges are rejected",
        contains(graph_output, "PASS 257 dependency edges rejected"),
        "the dependency edge limit accepted an oversized graph"))
      results = results.append(test_expect("32 package levels are accepted",
        contains(graph_output, "PASS 32 package levels accepted"),
        "the documented package depth limit rejected its boundary"))
      results = results.append(test_expect("33 package levels are rejected",
        contains(graph_output, "PASS 33 package levels rejected"),
        "the package depth limit accepted an oversized graph"))
      results = results.append(test_run_command("manifest-only library compile requires an entry",
        source_compiler_command(["compile", "--project", library_manifest_text, "-o", bytecode_text], toolchain_version),
        ProcessOutput(1, 0, bytes_empty(), text_encode_utf8(
          "error: library manifests support check only; compile and run require an application entry\n"))))
      results = results.append(test_run_command("manifest-only library run requires an entry",
        source_compiler_command(["run", "--project", library_manifest_text], toolchain_version),
        ProcessOutput(1, 0, bytes_empty(), text_encode_utf8(
          "error: library manifests support check only; compile and run require an application entry\n"))))
      empty_library_manifest = replace_first(library_manifest_text_value,
        "\"api\":\"api.panack\",\"api_alias\":\"api.panack\",\"extra\":\"extra.panack\"", "")
      filesystem_write_bytes(library_manifest, text_encode_utf8(empty_library_manifest))
      results = results.append(test_run_command("manifest-only library requires an export",
        source_compiler_command(["check", "--project", library_manifest_text], toolchain_version),
        ProcessOutput(1, 0, bytes_empty(), text_encode_utf8(
          "error: library manifest must export at least one module\n"))))
      filesystem_write_bytes(library_manifest, text_encode_utf8(library_manifest_text_value))
      filesystem_write_bytes(library_extra, text_encode_utf8(
        "import project/api as api\npub pure next_answer(): Nat { true }\n"))
      match testing_process_run(path("./panack-vm"),
          source_compiler_arguments(["check", "--project", library_manifest_text]),
          bytes_empty(), path_value_current(), ["PANACKELTY_VERSION=${toolchain_version}"],
          duration_seconds(10), 1048576) {
        Error(error) => {
          results = results.append(test_expect("manifest-only library rejects invalid export", false,
            "compiler process failed"))
        },
        Ok(output) => {
          results = results.append(test_expect("manifest-only library rejects invalid export",
            output.exit_code == 1 && output.signal == 0 &&
              contains(text_decode_utf8(output.stderr), "expected Nat") && output.stdout == bytes_empty(),
            "invalid exported source passed checking"))
        }
      }
      filesystem_write_bytes(library_extra, text_encode_utf8(
        "import project/api as api\npub pure next_answer(): Nat { api.answer() + 1 }\n"))
      results = results.append(test_run_command("manifest application recompiles direct dependencies after nested checks",
        source_compiler_command(["compile", "--project", package_manifest_text, "-o", bytecode_text], toolchain_version),
        ProcessOutput(0, 0, text_encode_utf8("wrote ${bytecode_text}\n"), bytes_empty())))
      move: ProcessOutput = match testing_process_run(path("/bin/mv"), [package_root_text, relocated_root_text],
          bytes_empty(), path_value_current(), [], duration_seconds(10), 1048576) {
        Error(error) => ProcessOutput(1, 0, bytes_empty(), bytes_empty()),
        Ok(output) => output
      }
      results = results.append(test_expect("manifest package relocation fixture", move.exit_code == 0 && move.signal == 0, "could not move package root"))
      results = results.append(test_run_command("relocated manifest package source run",
        source_compiler_command(["run", "--project", relocated_manifest_text, "alpha"], toolchain_version),
        ProcessOutput(0, 0, text_encode_utf8("42\n42\n1\n"), bytes_empty())))
      results = results.append(test_run_command("saved package bytecode runs after relocation",
        command(["run", bytecode_text]),
        ProcessOutput(0, 0, text_encode_utf8("42\n42\n0\n"), bytes_empty())))
      filesystem_remove_file(relocated_entry)
      filesystem_remove_file(relocated_value)
      filesystem_remove_file(relocated_manifest)
      filesystem_remove_directory(relocated_source_root)
      filesystem_remove_directory(relocated_root)
      filesystem_remove_file(library_api)
      filesystem_remove_file(library_private)
      filesystem_remove_file(library_extra)
      filesystem_remove_file(library_manifest)
      filesystem_remove_directory(library_source_root)
      filesystem_remove_directory(library_root)
      filesystem_remove_file(internal_api)
      filesystem_remove_file(internal_manifest)
      filesystem_remove_directory(internal_source_root)
      filesystem_remove_directory(internal_root)
      filesystem_remove_file(library_copy_manifest)
      filesystem_remove_directory(library_copy_root)
      filesystem_remove_file(second_app_entry)
      filesystem_remove_file(second_app_manifest)
      filesystem_remove_directory(second_app_source_root)
      filesystem_remove_directory(second_app_root)

      match filesystem_write_bytes(arguments_source, text_encode_utf8(
          "main(): Void { arguments: [Str] = command_args(); " +
          "print(len(arguments)); print(arguments[0]); }")) {
        Error(error) => {
          results = results.append(test_expect("program arguments", false,
            "fixture write failed"))
        },
        Ok(value) => {
          results = results.append(test_run_command("program arguments",
            command(["run", arguments_text, "alpha", "beta"]),
            ProcessOutput(0, 0, text_encode_utf8("2\nalpha\n"), bytes_empty())))
        }
      }
      match filesystem_write_bytes(failing_source,
          text_encode_utf8("main(): Void { eprint(\"failure\"); process_exit(7); }")) {
        Error(error) => {
          results = results.append(test_expect("program stderr and exit", false,
            "fixture write failed"))
        },
        Ok(value) => {
          results = results.append(test_run_command("program stderr and exit",
            command(["run", failing_text]),
            ProcessOutput(7, 0, bytes_empty(), text_encode_utf8("failure\n"))))
        }
      }

      match testing_process_run(path("./panack"), ["--help"], bytes_empty(), path_value_current(), [],
          duration_seconds(10), 1048576) {
        Error(error) => {
          results = results.append(test_expect("help command name", false,
            "process failed"))
        },
        Ok(output) => {
          results = results.append(test_expect("help command name",
            output.exit_code == 0 && output.signal == 0 && output.stderr == bytes_empty() &&
              contains(text_decode_utf8(output.stdout), "usage: panack "),
            "unexpected help output"))
        }
      }
      match filesystem_read_bytes(path("VERSION"), 100) {
        Error(error) => {
          results = results.append(test_expect("version", false, "version read failed"))
        },
        Ok(content) => {
          value = text_decode_utf8(content)
          size = value.len()
          if size > 0 {
            release = value.slice(0, size - 1)
            results = results.append(test_run_command("version", command(["--version"]),
              ProcessOutput(0, 0, text_encode_utf8("panack ${release} (bytecode 9)\n"), bytes_empty())))
          } else {
            results = results.append(test_expect("version", false, "empty version"))
          }
        }
      }

      for file in [source, bytecode, arguments_source, failing_source] {
        match filesystem_remove_file(file) {
          Ok(value) => {},
          Error(error) => {
            code = error.code
            results = results.append(test_expect("artifact cleanup", false,
              "file removal failed: ${code}"))
          }
        }
      }
      match test_workspace_remove_empty(workspace) {
        Ok(value) => {},
        Error(error) => {
          code = error.code
          results = results.append(test_expect("workspace cleanup", false,
            "workspace removal failed: ${code}"))
        }
      }
      failures = test_report(results)
      if failures > 0 { host_exit(1) }
    }
  }
}
