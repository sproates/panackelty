import stdlib/result::{result_value_or}
import stdlib/testing_files::{test_workspace_create, test_workspace_remove_empty}
import stdlib/testing_commands::{TestCommand, ProcessOutput, test_run_command}
import stdlib/testing::{TestResult, test_expect, test_report}
import stdlib/time::{duration_seconds}
import stdlib/path::{path_value_from_text, path_value_current, path_value_append, path_value_to_text}
import stdlib/filesystem::{filesystem_read_bytes, filesystem_write_bytes, filesystem_create_directory, filesystem_remove_file, filesystem_remove_directory}
import stdlib/testing_commands::{testing_process_run}
import stdlib/bytes::{bytes_empty, text_encode_utf8, text_decode_utf8}
import stdlib/host::{host_exit, host_stderr_text}
pure path(value: Str): Path {
  result_value_or(path_value_from_text(value), path_value_current())
}

pure child(root: Path, name: Str): Path {
  result_value_or(path_value_append(root, path(name)), root)
}

pure contains(value: Str, fragment: Str): Bool {
  mut found = false
  for index in 0..value.len() {
    if value.starts_with_at(fragment, index) { found = true }
  }
  found
}

pure replace_first(value: Str, needle: Str, replacement: Str): Str {
  mut index: Nat = 0
  mut found: Bool = false
  while index + len(needle) <= len(value) && !found {
    if slice(value, index, index + len(needle)) == needle { found = true }
    else { index = index + 1 }
  }
  if found {
    slice(value, 0, index) + replacement + slice(value, index + len(needle), len(value))
  } else { value }
}

pure manifest_version_from_output(value: Str): Str {
  mut end: Nat = 7
  while end < len(value) && !value.starts_with_at(" ", end) {
    end = end + 1
  }
  if end > 7 { slice(value, 7, end) } else { "" }
}

manifest_toolchain_version(): Str {
  match testing_process_run(path("./panack"), ["--version"], bytes_empty(),
      path_value_current(), [], duration_seconds(10), 1024) {
    Error(error) => "",
    Ok(output) => if output.exit_code == 0 && output.signal == 0 && output.stderr == bytes_empty() {
      manifest_version_from_output(text_decode_utf8(output.stdout))
    } else { "" }
  }
}

pure command(arguments: [Str]): TestCommand {
  TestCommand(path("./panack"), arguments, bytes_empty(), path_value_current(), [],
    duration_seconds(10), 1048576)
}

pure source_compiler_command(arguments: [Str], toolchain_version: Str): TestCommand {
  mut invocation: [Str] = ["run", "build/bootstrap/stage2/compiler.bc"]
  for argument in arguments {
    invocation = invocation.append(argument)
  }
  TestCommand(path("./panack-vm"), invocation, bytes_empty(), path_value_current(),
    ["PANACKELTY_VERSION=${toolchain_version}"], duration_seconds(10), 1048576)
}

main(): Void {
  match test_workspace_create(path("/tmp")) {
    Error(error) => { print("workspace creation failed"); host_exit(1) },
    Ok(workspace) => {
      original = "tests/functional/cases/hello_world/main.panack"
      source = child(workspace.root, "hello.panack")
      bytecode = child(workspace.root, "hello.bc")
      arguments_source = child(workspace.root, "arguments.panack")
      failing_source = child(workspace.root, "failure.panack")
      source_text = result_value_or(path_value_to_text(source), "invalid-source")
      bytecode_text = result_value_or(path_value_to_text(bytecode), "invalid-bytecode")
      arguments_text = result_value_or(path_value_to_text(arguments_source), "invalid-arguments")
      failing_text = result_value_or(path_value_to_text(failing_source), "invalid-failure")
      package_root = child(workspace.root, "package")
      package_source_root = child(package_root, "src")
      package_entry = child(package_source_root, "main.panack")
      package_value = child(package_source_root, "value.panack")
      package_manifest = child(package_root, "panack.json")
      library_root = child(workspace.root, "library")
      library_source_root = child(library_root, "src")
      library_api = child(library_source_root, "api.panack")
      library_extra = child(library_source_root, "extra.panack")
      library_manifest = child(library_root, "panack.json")
      relocated_root = child(workspace.root, "relocated")
      relocated_source_root = child(relocated_root, "src")
      relocated_entry = child(relocated_source_root, "main.panack")
      relocated_value = child(relocated_source_root, "value.panack")
      relocated_manifest = child(relocated_root, "panack.json")
      package_root_text = result_value_or(path_value_to_text(package_root), "invalid-package")
      package_source_root_text = result_value_or(path_value_to_text(package_source_root), "invalid-source-root")
      package_entry_text = result_value_or(path_value_to_text(package_entry), "invalid-entry")
      package_value_text = result_value_or(path_value_to_text(package_value), "invalid-value")
      package_manifest_text = result_value_or(path_value_to_text(package_manifest), "invalid-manifest")
      library_manifest_text = result_value_or(path_value_to_text(library_manifest), "invalid-library-manifest")
      relocated_root_text = result_value_or(path_value_to_text(relocated_root), "invalid-relocated")
      relocated_manifest_text = result_value_or(path_value_to_text(relocated_manifest), "invalid-relocated-manifest")
      mut results: [TestResult] = []

      results = results.append(test_run_command("bare source path", command([original]),
        ProcessOutput(0, 0, text_encode_utf8("hello world\n"), bytes_empty())))
      match filesystem_read_bytes(path(original), 1048576) {
        Error(error) => {
          results = results.append(test_expect("default compile output", false,
            "fixture read failed"))
        },
        Ok(content) => {
          match filesystem_write_bytes(source, content) {
            Error(error) => {
              results = results.append(test_expect("default compile output", false,
                "fixture write failed"))
            },
            Ok(value) => {
              results = results.append(test_run_command("default compile output",
                command(["compile", source_text]),
                ProcessOutput(0, 0, text_encode_utf8("wrote ${bytecode_text}\n"), bytes_empty())))
              results = results.append(test_run_command("bare bytecode path",
                command([bytecode_text]),
                ProcessOutput(0, 0, text_encode_utf8("hello world\n"), bytes_empty())))
            }
          }
        }
      }

      filesystem_create_directory(package_root)
      filesystem_create_directory(package_source_root)
      toolchain_version = manifest_toolchain_version()
      manifest_text = "{\"schema\":1,\"package\":\"example.application\",\"version\":\"1.0.0\",\"language\":\"modules-v1\",\"toolchain\":\"${toolchain_version}\",\"source\":\"src\",\"entry\":\"main.panack\",\"exports\":{\"value\":\"value.panack\"},\"dependencies\":{}}"
      filesystem_write_bytes(package_manifest, text_encode_utf8(manifest_text))
      filesystem_write_bytes(package_entry, text_encode_utf8(
        "import project/value as value\nmain(): Void { print(value.answer()); arguments: [Str] = command_args(); print(len(arguments)); }\n"))
      filesystem_write_bytes(package_value, text_encode_utf8("pub pure answer(): Nat { 42 }\n"))
      results = results.append(test_run_command("explicit manifest package check",
        command(["check", "--project", package_manifest_text]),
        ProcessOutput(0, 0, text_encode_utf8("ok\n"), bytes_empty())))
      results = results.append(test_run_command("explicit manifest package source run",
        command(["run", "--project", package_manifest_text, "alpha"]),
        ProcessOutput(0, 0, text_encode_utf8("42\n1\n"), bytes_empty())))
      results = results.append(test_run_command("explicit manifest package compile",
        command(["compile", "--project", package_manifest_text, "-o", bytecode_text]),
        ProcessOutput(0, 0, text_encode_utf8("wrote ${bytecode_text}\n"), bytes_empty())))
      dependencies_manifest = replace_first(manifest_text, "\"dependencies\":{}", "\"dependencies\":{\"missing\":{\"path\":\"../missing\"}}")
      filesystem_write_bytes(package_manifest, text_encode_utf8(dependencies_manifest))
      results = results.append(test_run_command("unsupported package dependency fails closed",
        command(["check", "--project", package_manifest_text]),
        ProcessOutput(1, 0, bytes_empty(), text_encode_utf8("error: project manifest dependencies are not supported yet\n"))))
      filesystem_write_bytes(package_manifest, text_encode_utf8(manifest_text))

      filesystem_create_directory(library_root)
      filesystem_create_directory(library_source_root)
      library_manifest_text_value = "{\"schema\":1,\"package\":\"example.geometry\",\"version\":\"1.0.0\",\"language\":\"modules-v1\",\"toolchain\":\"${toolchain_version}\",\"source\":\"src\",\"exports\":{\"api\":\"api.panack\",\"api_alias\":\"api.panack\",\"extra\":\"extra.panack\"},\"dependencies\":{}}"
      filesystem_write_bytes(library_manifest, text_encode_utf8(library_manifest_text_value))
      filesystem_write_bytes(library_api, text_encode_utf8("pub pure answer(): Nat { 42 }\n"))
      filesystem_write_bytes(library_extra, text_encode_utf8(
        "import project/api as api\npub pure next_answer(): Nat { api.answer() + 1 }\n"))
      results = results.append(test_run_command("manifest-only library checks each exported module without main",
        source_compiler_command(["check", "--project", library_manifest_text], toolchain_version),
        ProcessOutput(0, 0, text_encode_utf8("ok\n"), bytes_empty())))
      results = results.append(test_run_command("manifest-only library compile requires an entry",
        source_compiler_command(["compile", "--project", library_manifest_text, "-o", bytecode_text], toolchain_version),
        ProcessOutput(1, 0, bytes_empty(), text_encode_utf8(
          "error: library manifests support check only; compile and run require an application entry\n"))))
      results = results.append(test_run_command("manifest-only library run requires an entry",
        source_compiler_command(["run", "--project", library_manifest_text], toolchain_version),
        ProcessOutput(1, 0, bytes_empty(), text_encode_utf8(
          "error: library manifests support check only; compile and run require an application entry\n"))))
      empty_library_manifest = replace_first(library_manifest_text_value,
        "\"api\":\"api.panack\",\"api_alias\":\"api.panack\",\"extra\":\"extra.panack\"", "")
      filesystem_write_bytes(library_manifest, text_encode_utf8(empty_library_manifest))
      results = results.append(test_run_command("manifest-only library requires an export",
        source_compiler_command(["check", "--project", library_manifest_text], toolchain_version),
        ProcessOutput(1, 0, bytes_empty(), text_encode_utf8(
          "error: library manifest must export at least one module\n"))))
      filesystem_write_bytes(library_manifest, text_encode_utf8(library_manifest_text_value))
      filesystem_write_bytes(library_extra, text_encode_utf8(
        "import project/api as api\npub pure next_answer(): Nat { true }\n"))
      match testing_process_run(path("./panack-vm"),
          ["run", "build/bootstrap/stage2/compiler.bc", "check", "--project", library_manifest_text],
          bytes_empty(), path_value_current(), ["PANACKELTY_VERSION=${toolchain_version}"],
          duration_seconds(10), 1048576) {
        Error(error) => {
          results = results.append(test_expect("manifest-only library rejects invalid export", false,
            "compiler process failed"))
        },
        Ok(output) => {
          results = results.append(test_expect("manifest-only library rejects invalid export",
            output.exit_code == 1 && output.signal == 0 &&
              contains(text_decode_utf8(output.stderr), "expected Nat") && output.stdout == bytes_empty(),
            "invalid exported source passed checking"))
        }
      }
      filesystem_write_bytes(library_extra, text_encode_utf8(
        "import project/api as api\npub pure next_answer(): Nat { api.answer() + 1 }\n"))
      move: ProcessOutput = match testing_process_run(path("/bin/mv"), [package_root_text, relocated_root_text],
          bytes_empty(), path_value_current(), [], duration_seconds(10), 1048576) {
        Error(error) => ProcessOutput(1, 0, bytes_empty(), bytes_empty()),
        Ok(output) => output
      }
      results = results.append(test_expect("manifest package relocation fixture", move.exit_code == 0 && move.signal == 0, "could not move package root"))
      results = results.append(test_run_command("relocated manifest package source run",
        command(["run", "--project", relocated_manifest_text, "alpha"]),
        ProcessOutput(0, 0, text_encode_utf8("42\n1\n"), bytes_empty())))
      results = results.append(test_run_command("saved package bytecode runs after relocation",
        command(["run", bytecode_text]),
        ProcessOutput(0, 0, text_encode_utf8("42\n0\n"), bytes_empty())))
      filesystem_remove_file(relocated_entry)
      filesystem_remove_file(relocated_value)
      filesystem_remove_file(relocated_manifest)
      filesystem_remove_directory(relocated_source_root)
      filesystem_remove_directory(relocated_root)
      filesystem_remove_file(library_api)
      filesystem_remove_file(library_extra)
      filesystem_remove_file(library_manifest)
      filesystem_remove_directory(library_source_root)
      filesystem_remove_directory(library_root)

      match filesystem_write_bytes(arguments_source, text_encode_utf8(
          "main(): Void { arguments: [Str] = command_args(); " +
          "print(len(arguments)); print(arguments[0]); }")) {
        Error(error) => {
          results = results.append(test_expect("program arguments", false,
            "fixture write failed"))
        },
        Ok(value) => {
          results = results.append(test_run_command("program arguments",
            command(["run", arguments_text, "alpha", "beta"]),
            ProcessOutput(0, 0, text_encode_utf8("2\nalpha\n"), bytes_empty())))
        }
      }
      match filesystem_write_bytes(failing_source,
          text_encode_utf8("main(): Void { eprint(\"failure\"); process_exit(7); }")) {
        Error(error) => {
          results = results.append(test_expect("program stderr and exit", false,
            "fixture write failed"))
        },
        Ok(value) => {
          results = results.append(test_run_command("program stderr and exit",
            command(["run", failing_text]),
            ProcessOutput(7, 0, bytes_empty(), text_encode_utf8("failure\n"))))
        }
      }

      match testing_process_run(path("./panack"), ["--help"], bytes_empty(), path_value_current(), [],
          duration_seconds(10), 1048576) {
        Error(error) => {
          results = results.append(test_expect("help command name", false,
            "process failed"))
        },
        Ok(output) => {
          results = results.append(test_expect("help command name",
            output.exit_code == 0 && output.signal == 0 && output.stderr == bytes_empty() &&
              contains(text_decode_utf8(output.stdout), "usage: panack "),
            "unexpected help output"))
        }
      }
      match filesystem_read_bytes(path("VERSION"), 100) {
        Error(error) => {
          results = results.append(test_expect("version", false, "version read failed"))
        },
        Ok(content) => {
          value = text_decode_utf8(content)
          size = value.len()
          if size > 0 {
            release = value.slice(0, size - 1)
            results = results.append(test_run_command("version", command(["--version"]),
              ProcessOutput(0, 0, text_encode_utf8("panack ${release} (bytecode 9)\n"), bytes_empty())))
          } else {
            results = results.append(test_expect("version", false, "empty version"))
          }
        }
      }

      for file in [source, bytecode, arguments_source, failing_source] {
        match filesystem_remove_file(file) {
          Ok(value) => {},
          Error(error) => {
            code = error.code
            results = results.append(test_expect("artifact cleanup", false,
              "file removal failed: ${code}"))
          }
        }
      }
      match test_workspace_remove_empty(workspace) {
        Ok(value) => {},
        Error(error) => {
          code = error.code
          results = results.append(test_expect("workspace cleanup", false,
            "workspace removal failed: ${code}"))
        }
      }
      failures = test_report(results)
      if failures > 0 { host_exit(1) }
    }
  }
}
