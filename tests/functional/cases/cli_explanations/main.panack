      explain_write(source, "pure take(value: Nat): Nat { value }\npure caller(): Nat { take(\"wrong\") }\nmain(): Void {}\n")
      results = append(results, explain_run("rejected direct call argument explains type mismatch", ["explain", source, "--function", "caller"], 1,
