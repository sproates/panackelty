import stdlib/testing as std_testing
import stdlib/testing_files as std_testing_files
import stdlib/testing::{TestResult}
import stdlib/filesystem as std_filesystem
import stdlib/host as std_host
import "support.panack"::{explain_path, explain_write, explain_run}

main(): Void {
  match std_testing_files.workspace_create(explain_path("/tmp")) {
    Error(error) => { std_host.stderr("workspace failed"); std_host.exit(1); },
    Ok(workspace) => {
      root: Str = workspace.root.to_text().value_or("")
      source: Str = root + "/main.panack"
      library: Str = root + "/library.panack"
      interpolation: Str = "$" + "{name}"
      mut results: [TestResult] = []
      explain_write(source, "pure identity[T](value: T): T { value }\nprobe(): Void { greeting = \"hello\"; echoed = identity(\"generic\"); explicit: Str = \"annotated\"; }\nmain(): Void {}\n")
      results = results.append(explain_run("inferred locals report initializer evidence", ["explain", source, "--function", "probe"], 0,
        ["inferred locals:", "inferred local: greeting", "expression: \"hello\"", "initializer type: Str", "inferred type: Str", "inferred local: echoed", "expression: identity(\"generic\")", "checked initializer type determines this local type"], ["inferred local: explicit"], ""))
      explain_write(source, "pub pure probe(name: Nat): Str { \"hello " + interpolation + "\" }\nmain(): Void {}\n")
      results = results.append(explain_run("accepted interpolation explains local scalar type", ["explain", source, "--function", "probe"], 0,
        ["checked interpolation type: accepted", "context: string interpolation", "local type: Nat", "allowed interpolation types: scalar type (Nat, Int, Dec, Rat, Str, Bool or Unit)", "accepted this scalar local for interpolation"], [], ""))
      explain_write(source, "pub pure probe(name: [Nat]): Str { \"hello " + interpolation + "\" }\nmain(): Void {}\n")
      results = results.append(explain_run("rejected interpolation explains non-scalar local type", ["explain", source, "--function", "probe"], 1,
        ["checked interpolation type: rejected", "context: string interpolation", "local type: Array[Nat]", "rejected a non-scalar local for interpolation"], [], "interpolation requires a scalar local, got Array[Nat]"))
      explain_write(source, "pub pure probe(): Str { name = missing; \"hello " + interpolation + "\" }\nmain(): Void {}\n")
      results = results.append(explain_run("unresolved interpolation local is explicitly unavailable", ["explain", source, "--function", "probe"], 1,
        ["checked interpolation type: unavailable", "context: string interpolation", "local type: unavailable", "local type needed for interpolation"], [], "unknown local value missing"))
      explain_write(source, "pub type Positive = Nat where value => value > 0\npub pure probe(name: Positive): Str { \"hello " + interpolation + "\" }\nmain(): Void {}\n")
      results = results.append(explain_run("guarded interpolation type is explicitly deferred", ["explain", source, "--function", "probe"], 1,
        ["checked interpolation type: unavailable", "context: string interpolation", "local type: main.panack:Positive", "deferred interpolation of a guarded local type"], [], "function is not completely checked for identity emission: probe"))
      explain_write(source, "pure identity[T](value: T): T { value }\nprobe(): Void {\n  answer = identity(\"typed\");\n}\nmain(): Void {}\n")
      results = results.append(explain_run("type-at selects the smallest checked expression", ["explain", source, "--function", "probe", "--type-at", "3", "23"], 0,
        ["checked expression type: Str", "source: project/main.panack:3:21-3:28\nexpression: \"typed\"", "type retained from the checked expression"], [], ""))
      results = results.append(explain_run("type-at reports the containing generic call type", ["explain", source, "--function", "probe", "--type-at", "3", "12"], 0,
        ["checked expression type: Str", "source: project/main.panack:3:12-3:29\nexpression: identity(\"typed\")"], [], ""))
      results = results.append(explain_run("type-at reports no expression at unrelated location", ["explain", source, "--function", "probe", "--type-at", "1", "1"], 0,
        ["checked expression type: unavailable", "no checked expression covers this source location"], [], ""))
      results = results.append(explain_run("type-at rejects a zero line", ["explain", source, "--function", "probe", "--type-at", "0", "23"], 1,
        [], [], "line and column must be positive decimal numbers"))
      explain_write(source, "pure returns(): Nat { 5 }\nmain(): Void {}\n")
      results = results.append(explain_run("accepted function return type cites checked result", ["explain", source, "--function", "returns"], 0,
        ["return type: accepted", "expression: 5", "actual type: Nat", "expected type: Nat", "compatible with its declared return type"], [], ""))
      explain_write(source, "pure returns(): Nat { \"wrong\" }\nmain(): Void {}\n")
      results = results.append(explain_run("rejected function return explains actual and expected types", ["explain", source, "--function", "returns"], 1,
        ["return type: rejected", "expression: \"wrong\"", "actual type: Str", "expected type: Nat", "incompatible with its declared return type"], [], "return of returns is Str, expected Nat"))
      explain_write(source, "pure returns(): Nat { missing }\nmain(): Void {}\n")
      results = results.append(explain_run("unresolved function return is explicitly unavailable", ["explain", source, "--function", "returns"], 1,
        ["return type: unavailable", "expression: missing", "actual type: unavailable", "expected type: Nat", "did not determine a complete function result type"], [], "unknown local value missing"))
      explain_write(source, "pure take[T](value: T): T { value }\npure caller(): Str { take(\"typed\") }\nmain(): Void {}\n")
      results = results.append(explain_run("accepted direct call argument cites checked types", ["explain", source, "--function", "caller"], 0,
        ["call argument 1 to take: accepted", "expression: \"typed\"", "actual type: Str", "expected type: Str", "compatible with the expected type"], [], ""))
      explain_write(source, "pure take(value: Nat): Nat { value }\npure caller(): Nat { take(\"wrong\") }\nmain(): Void {}\n")
      results = results.append(explain_run("rejected direct call argument explains type mismatch", ["explain", source, "--function", "caller"], 1,
        ["call argument 1 to take: rejected", "expression: \"wrong\"", "actual type: Str", "expected type: Nat", "incompatible with the expected type"], [], "expected Nat"))
      explain_write(source, "pure take(value: Nat): Nat { value }\npure caller(): Nat { take(missing) }\nmain(): Void {}\n")
      results = results.append(explain_run("unresolved direct call argument is explicitly unavailable", ["explain", source, "--function", "caller"], 1,
        ["call argument 1 to take: unavailable", "expression: missing", "actual type: unavailable", "expected type: Nat", "did not determine a complete argument type"], [], "unknown local value missing"))
      explain_write(source, "pure take(value: Nat): Nat { value }; pure caller(): Nat { take(1) }\nmain(): Void {}\n")
      results = results.append(explain_run("accepted direct call arity explains exact argument count", ["explain", source, "--function", "caller"], 0,
        ["call arity checks:", "checked call arity: accepted", "context: direct call arity", "argument counts: expected 1; found 1", "accepted the supplied argument count"], [], ""))
      explain_write(source, "pure take(value: Nat): Nat { value }; pure caller(): Nat { take() }\nmain(): Void {}\n")
      results = results.append(explain_run("missing direct call argument explains arity rejection", ["explain", source, "--function", "caller"], 1,
        ["checked call arity: rejected", "argument counts: expected 1; found 0", "rejected the supplied argument count"], [], "take expects 1 arguments, got 0"))
      explain_write(source, "pure take(value: Nat): Nat { value }; pure caller(): Nat { take(1, 2) }\nmain(): Void {}\n")
      results = results.append(explain_run("extra direct call argument explains arity rejection", ["explain", source, "--function", "caller"], 1,
        ["checked call arity: rejected", "argument counts: expected 1; found 2", "rejected the supplied argument count"], [], "take expects 1 arguments, got 2"))
      explain_write(source, "pure probe(): Nat { \"hello\".len() }\nmain(): Void {}\n")
      results = results.append(explain_run("accepted core call arity reports exact argument count", ["explain", source, "--function", "probe"], 0,
        ["call arity checks:", "checked call arity: accepted", "context: core call arity", "argument counts: expected 1; found 1", "accepted the supplied argument count", "checked type requirement: accepted", "context: len argument", "expression: \"hello\"", "actual type: Str", "expected type: Str, Bytes, Array, Map, or Set"], [], ""))
      explain_write(source, "pure probe(): Nat { bytes().length() }\nmain(): Void {}\n")
      results = results.append(explain_run("len accepts Bytes and explains its type requirement", ["explain", source, "--function", "probe"], 0,
        ["call argument 1 to byte_len: accepted", "actual type: Bytes", "expected type: Bytes"], [], ""))
      explain_write(source, "pure probe(): Nat { [1].len() }\nmain(): Void {}\n")
      results = results.append(explain_run("len accepts arrays and explains its type requirement", ["explain", source, "--function", "probe"], 0,
        ["checked type requirement: accepted", "context: len argument", "expression: [1]", "actual type: Array[Nat]", "expected type: Str, Bytes, Array, Map, or Set"], [], ""))
      explain_write(source, "pure probe(): Nat { 1.len() }\nmain(): Void {}\n")
      results = results.append(explain_run("len rejects unsupported argument types", ["explain", source, "--function", "probe"], 1,
        ["program: rejected"], ["context: len argument"], "unknown owned method Nat.len"))
      explain_write(source, "pure probe(): Nat { missing.len() }\nmain(): Void {}\n")
      results = results.append(explain_run("len reports unavailable argument type", ["explain", source, "--function", "probe"], 1,
        ["program: rejected"], ["context: len argument"], "unknown local value missing"))
      explain_write(source, "caller(): Void { print(1) }\nmain(): Void {}\n")
      results = results.append(explain_run("print explains accepted non-Void arguments", ["explain", source, "--function", "caller"], 0,
        ["checked type requirement: accepted", "context: print argument", "expression: 1", "actual type: Nat", "expected type: any non-Void value", "accepted this type for the requirement"], [], ""))
      explain_write(source, "import stdlib/host as service_host\ncaller(): Void { service_host.stderr(\"x\") }\nmain(): Void {}\n")
      results = results.append(explain_run("eprint explains accepted non-Void arguments", ["explain", source, "--function", "caller"], 0,
        ["call argument 1 to stderr: accepted", "actual type: Str", "expected type: Str"], ["context: eprint argument"], ""))
      explain_write(source, "import stdlib/http_runtime as runtime\nimport stdlib/host as host\nmain(): Void {}\n")
      results = results.append(explain_run("host exit retains performed argument check", ["explain", source, "--function", "stdlib/host.panack:exit"], 0,
        ["call argument 1 to process_exit: accepted", "actual type: Nat", "expected type: Nat"], [], ""))
      results = results.append(explain_run("HTTP writer retains performed argument checks", ["explain", source, "--function", "stdlib/http_runtime.panack:writer_status"], 0,
        ["call argument 1 to http_writer_status: accepted", "call argument 2 to http_writer_status: accepted"], [], ""))
      results = results.append(explain_run("HTTP connection invocation retains the state requirement", ["explain", source, "--function", "stdlib/http_runtime.panack:connection_invoke"], 0,
        ["context: HTTP state shape", "HttpConnectionState with two type arguments", "call argument 4 to http_connection_invoke: accepted"], [], ""))
      explain_write(source, "pure noop(): Void {}; caller(): Void { print(noop()) }\nmain(): Void {}\n")
      results = results.append(explain_run("print explains rejected Void arguments", ["explain", source, "--function", "caller"], 1,
        ["checked type requirement: rejected", "context: print argument", "expression: noop()", "actual type: Void", "expected type: any non-Void value", "rejected this type for the requirement"], [], "Void is not a value and cannot be passed as an argument"))
      explain_write(source, "import stdlib/host as service_host\npure noop(): Void {}; caller(): Void { service_host.stderr(noop()) }\nmain(): Void {}\n")
      results = results.append(explain_run("eprint explains rejected Void arguments", ["explain", source, "--function", "caller"], 1,
        ["call argument 1 to stderr: rejected", "actual type: Void", "expected type: Str"], ["context: eprint argument"], "Void is not a value and cannot be passed as an argument"))
      explain_write(source, "pure noop(): Void {}; caller(): Nat { answer = noop(); 1 }\nmain(): Void {}\n")
      results = results.append(explain_run("explain rejected Void binding storage", ["explain", source, "--function", "caller"], 1,
        ["checked value requirement: rejected", "context: binding storage", "actual type: Void", "required value: non-Void stored value", "Void produces no value and cannot be stored in a binding"], [], "Void is not a value and cannot be stored in binding answer"))
      explain_write(source, "pure noop(): Void {}; caller(): Nat { values = [noop()]; 1 }\nmain(): Void {}\n")
      results = results.append(explain_run("explain rejected Void array element", ["explain", source, "--function", "caller"], 1,
        ["checked value requirement: rejected", "context: array element", "actual type: Void", "required value: non-Void array element", "Void produces no element value and cannot be placed in an array"], [], "Void is not an array element"))
      explain_write(source, "caller(): Void { print(missing) }\nmain(): Void {}\n")
      results = results.append(explain_run("print reports unavailable argument types", ["explain", source, "--function", "caller"], 1,
