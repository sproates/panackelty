      results = results.append(explain_run("rejected core call arity reports exact argument count", ["explain", source, "--function", "probe"], 1,
        ["checked call arity: rejected", "context: core call arity", "argument counts: expected 1; found 2", "rejected the supplied argument count"], [], "len expects 1 arguments, got 2"))
      explain_write(source, "pure identity(value: Nat): Nat { value }; pure probe(): Nat { f: PureFn[Nat,Nat] = @identity; f.call(1) }\nmain(): Void {}\n")
      results = results.append(explain_run("accepted indirect call arity reports exact argument count", ["explain", source, "--function", "probe"], 0,
        ["checked call arity: accepted", "context: indirect call arity", "argument counts: expected 1; found 1", "accepted the supplied argument count", "checked type requirement: accepted", "context: indirect call target", "actual type: PureFn[Nat,Nat]", "expected type: callable type"], [], ""))
      explain_write(source, "pure identity(value: Nat): Nat { value }; pure probe(): Nat { f: PureFn[Nat,Nat] = @identity; f.call() }\nmain(): Void {}\n")
      results = results.append(explain_run("rejected indirect call arity reports exact argument count", ["explain", source, "--function", "probe"], 1,
        ["checked call arity: rejected", "context: indirect call arity", "argument counts: expected 1; found 0", "rejected the supplied argument count"], [], "call expects 1 arguments, got 0"))
      explain_write(source, "pure probe(): Nat { f = missing; f.call(1) }\nmain(): Void {}\n")
      results = results.append(explain_run("unresolved indirect call arity is explicitly unavailable", ["explain", source, "--function", "probe"], 1,
        ["program: rejected"], ["context: indirect call arity"], "unknown local value missing"))
      explain_write(source, "pure probe(): Nat { value: Nat = 1; value.call(1) }\nmain(): Void {}\n")
      results = results.append(explain_run("rejected indirect call target explains non-callable type", ["explain", source, "--function", "probe"], 1,
        ["program: rejected"], ["context: indirect call target"], "unknown owned method Nat.call"))
      explain_write(source, "pure probe[T](value: T): Nat { value.call(1) }\nmain(): Void {}\n")
      results = results.append(explain_run("indirect call target type parameter is explicitly unavailable", ["explain", source, "--function", "probe"], 1,
        ["program: rejected"], ["context: indirect call target"], "owned method requires a known receiver: call"))
      explain_write(source, "import stdlib/http_transport as service_http_transport\nasync request(): Result[Bytes,Str] { await service_http_transport.exchange(\"localhost\",8080,false,bytes(),4096,1000) }; main(): Void {}\n")
      results = results.append(explain_run("native HTTP transport explains accepted argument requirements", ["explain", source, "--function", "request"], 0,
        ["actual type: Str", "expected type: Str", "actual type: Bool", "expected type: Bool", "actual type: Nat", "expected type: Nat", "call argument 3 to exchange: accepted", "call argument 1 to exchange: accepted", "call argument 6 to exchange: accepted"], [], ""))
      explain_write(source, "import stdlib/http_transport as service_http_transport\nasync request(): Result[Bytes,Str] { await service_http_transport.exchange(\"localhost\",8080,1,bytes(),4096,1000) }; main(): Void {}\n")
      results = results.append(explain_run("native HTTP transport explains rejected argument requirement", ["explain", source, "--function", "request"], 1,
        ["expression: 1", "actual type: Nat", "expected type: Bool", "call argument 3 to exchange: rejected"], [], "argument 3 to exchange is Nat, expected Bool"))
      explain_write(source, "import stdlib/http_transport as service_http_transport\nasync request(): Result[Bytes,Str] { await service_http_transport.exchange(\"localhost\",8080,missing,bytes(),4096,1000) }; main(): Void {}\n")
      results = results.append(explain_run("native HTTP transport explains unavailable argument requirement", ["explain", source, "--function", "request"], 1,
        ["expression: missing", "actual type: unavailable", "expected type: Bool", "call argument 3 to exchange: unavailable"], [], "unknown local value missing"))
      explain_write(source, "pure identity(value: Nat): Nat { value }; pure probe(): Nat { f: PureFn[Nat,Nat] = @identity; f.call(1) }\nmain(): Void {}\n")
      results = results.append(explain_run("accepted indirect call argument cites checked type", ["explain", source, "--function", "probe"], 0,
