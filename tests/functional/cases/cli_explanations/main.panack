      results = append(results, explain_run("type-at selects the smallest checked expression", ["explain", source, "--function", "probe", "--type-at", "3", "23"], 0,
        ["checked expression type: Str", "source: project/main.panack:3:21-3:28\nexpression: \"typed\"", "type retained from the checked expression"], [], ""))
      results = append(results, explain_run("type-at reports the containing generic call type", ["explain", source, "--function", "probe", "--type-at", "3", "12"], 0,
        ["checked expression type: Str", "source: project/main.panack:3:12-3:29\nexpression: identity(\"typed\")"], [], ""))
      results = append(results, explain_run("type-at reports no expression at unrelated location", ["explain", source, "--function", "probe", "--type-at", "1", "1"], 0,
        ["checked expression type: unavailable", "no checked expression covers this source location"], [], ""))
      results = append(results, explain_run("type-at rejects a zero line", ["explain", source, "--function", "probe", "--type-at", "0", "23"], 1,
        [], [], "line and column must be positive decimal numbers"))
      explain_write(source, "pure returns(): Nat { 5 }\nmain(): Void {}\n")
