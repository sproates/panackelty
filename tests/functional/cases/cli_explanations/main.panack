import stdlib/process as std_process
import stdlib/text as std_text
import stdlib/option as std_option
import stdlib/testing as std_testing
import stdlib/result as std_result
import stdlib/testing_files as std_testing_files
import stdlib/testing::{TestResult}
import stdlib/time as std_time
import stdlib/path as std_path
import stdlib/filesystem as std_filesystem
import stdlib/testing_commands as std_testing_commands
import stdlib/bytes as byte_buffer
import stdlib/environment as std_environment
import stdlib/host as std_host

pure explain_path(text: Str): Path { std_result.value_or(std_path.from_text(text), std_path.current()) }
pure explain_contains(text: Str, part: Str): Bool {
  mut found: Bool = false
  for offset in 0..len(text) { if text.starts_with_at(part, offset) { found = true; } }
  found
}
explain_write(path: Str, text: Str): Void {
  match std_filesystem.write(explain_path(path), std_text.encode_utf8(text)) {
    Ok(done) => {}, Error(error) => { std_host.stderr("fixture write failed"); std_host.exit(1); }
  }
}
explain_run(name: Str, arguments: [Str], status: Nat, required: [Str], forbidden: [Str], diagnostic: Str): TestResult {
  mut command: Str = "./panack"
  mut command_arguments: [Str] = arguments
  if (std_environment.get("PANACK_TEST_COMPILER") != None()) {
    command = "/usr/bin/env"
    command_arguments = ["-u", "PANACKELTY_BOOTSTRAP_ROOT", "./panack-vm", "run", std_option.value_or(std_environment.get("PANACK_TEST_COMPILER"), "")]
    for argument in arguments { command_arguments = command_arguments.append(argument) }
  }
  match std_process.run(explain_path(command), command_arguments, byte_buffer.empty(), std_path.current(), [], std_time.seconds(15), 1048576) {
    Error(error) => std_testing.expect(name, false, "command failed"),
    Ok(actual) => {
      text: Str = std_text.decode_utf8(actual.stdout)
      mut valid: Bool = actual.exit_code == status && actual.signal == 0
      for part in required { if !explain_contains(text, part) { valid = false; } }
      for part in forbidden { if explain_contains(text, part) { valid = false; } }
      valid = valid && if diagnostic == "" { actual.stderr == byte_buffer.empty() } else { explain_contains(std_text.decode_utf8(actual.stderr), diagnostic) }
      std_testing.expect(name, valid, text + "; " + std_text.decode_utf8(actual.stderr))
    }
  }
}
main(): Void {
  match std_testing_files.workspace_create(explain_path("/tmp")) {
    Error(error) => { std_host.stderr("workspace failed"); std_host.exit(1); },
    Ok(workspace) => {
      root: Str = std_result.value_or(std_path.to_text(workspace.root), "")
      source: Str = root + "/main.panack"
      library: Str = root + "/library.panack"
      other: Str = root + "/right.panack"
      artifact: Str = root + "/main.bc"
      mut results: [TestResult] = []
      original: Str = "import project/library as library\nmain(): Void { print(library.remaining[Str](\"x\", 5)); print(library.remaining[Nat](7, 4)); }\n"
