import stdlib/result::{result_value_or}
import stdlib/testing_files::{test_workspace_create, test_workspace_remove_empty}
import stdlib/testing::{TestResult, test_expect, test_report}
import stdlib/time::{duration_seconds}
import stdlib/path::{path_value_from_text, path_value_current, path_value_to_text}
import stdlib/filesystem::{filesystem_write_bytes, filesystem_remove_file}
import stdlib/testing_commands::{testing_process_run}
import stdlib/bytes::{bytes_empty, text_encode_utf8, text_decode_utf8}
import stdlib/environment::{environment_value, environment_has_value}
import stdlib/host::{host_exit, host_stderr_text}

pure explain_path(text: Str): Path { result_value_or(path_value_from_text(text), path_value_current()) }
pure explain_contains(text: Str, part: Str): Bool {
  mut found: Bool = false
  for offset in 0..len(text) { if text.starts_with_at(part, offset) { found = true; } }
  found
}
explain_write(path: Str, text: Str): Void {
  match filesystem_write_bytes(explain_path(path), text_encode_utf8(text)) {
    Ok(done) => {}, Error(error) => { host_stderr_text("fixture write failed"); host_exit(1); }
  }
}
explain_run(name: Str, arguments: [Str], status: Nat, required: [Str], forbidden: [Str], diagnostic: Str): TestResult {
  mut command: Str = "./panack"
  mut command_arguments: [Str] = arguments
  if environment_has_value("PANACK_TEST_COMPILER") {
    command = "/usr/bin/env"
    command_arguments = ["-u", "PANACKELTY_BOOTSTRAP_ROOT", "./panack-vm", "run", environment_value("PANACK_TEST_COMPILER")]
    for argument in arguments { command_arguments = command_arguments.append(argument) }
  }
  match testing_process_run(explain_path(command), command_arguments, bytes_empty(), path_value_current(), [], duration_seconds(15), 1048576) {
    Error(error) => test_expect(name, false, "command failed"),
    Ok(actual) => {
      text: Str = text_decode_utf8(actual.stdout)
      mut valid: Bool = actual.exit_code == status && actual.signal == 0
      for part in required { if !explain_contains(text, part) { valid = false; } }
      for part in forbidden { if explain_contains(text, part) { valid = false; } }
      valid = valid && if diagnostic == "" { actual.stderr == bytes_empty() } else { explain_contains(text_decode_utf8(actual.stderr), diagnostic) }
      test_expect(name, valid, text + "; " + text_decode_utf8(actual.stderr))
    }
  }
}
main(): Void {
  match test_workspace_create(explain_path("/tmp")) {
    Error(error) => { host_stderr_text("workspace failed"); host_exit(1); },
    Ok(workspace) => {
      root: Str = result_value_or(path_value_to_text(workspace.root), "")
      source: Str = root + "/main.panack"
      library: Str = root + "/library.panack"
      other: Str = root + "/right.panack"
      artifact: Str = root + "/main.bc"
      mut results: [TestResult] = []
      original: Str = "import project/library as library\nmain(): Void { print(library.remaining[Str](\"x\", 5)); print(library.remaining[Nat](7, 4)); }\n"
      explain_write(source, original)
      explain_write(library, "// λ🙂\npub pure remaining[T](item: T, n: Nat): Nat {\n  if n >= 2 { n - 2 } else { 0 }\n}\n")
      results = append(results, explain_run("imported generic proof", ["explain", source, "--function", "remaining"], 0,
        ["program: accepted", "function: remaining", "subtraction: proved", "source: project/library.panack:3:15-3:20\nexpression: n - 2", "left lower bound: 2", "guard branch: true\nsource: project/library.panack:3:6-3:12\nexpression: n >= 2"], ["subtraction: unproved"], ""))
      results = append(results, explain_run("query does not execute main", ["explain", source, "--function", "main"], 0,
        ["subtraction: unavailable", "no subtraction evidence"], ["\n3\n", "\n2\n"], ""))
      results = append(results, explain_run("unknown function", ["explain", source, "--function", "absent"], 1, [], [], "unknown function absent"))
      results = append(results, explain_run("ordinary source executes", [source], 0, ["3\n2\n"], ["program:"], ""))
      results = append(results, explain_run("ordinary compile", ["compile", source, "-o", artifact], 0, ["wrote "], [], ""))
      results = append(results, explain_run("ordinary bytecode executes", [artifact], 0, ["3\n2\n"], ["program:"], ""))
      explain_write(source, "main(): Void { mut n: Nat = 3; if n >= 2 { n = 0; print(n - 2); } }")
      results = append(results, explain_run("stale guard is not cited", ["explain", source, "--function", "main"], 1,
        ["program: rejected", "subtraction: unproved", "does not establish a runtime failure"], ["left lower bound", "guard branch"], "Nat subtraction may underflow"))
      explain_write(source, "main(): Void { mut n: Nat = 3; if n >= 2 { n = 4; if n > 2 { print(n - 3); } } }")
      results = append(results, explain_run("fresh guard is cited", ["explain", source, "--function", "main"], 0,
        ["subtraction: proved", "left lower bound: 3", "expression: n > 2"], ["expression: n >= 2"], ""))
      explain_write(source, "pure f(n: Nat): Nat { if n < 2 { 0 } else { n - 2 } } main(): Void {}")
      results = append(results, explain_run("false branch proof", ["explain", source, "--function", "f"], 0,
        ["subtraction: proved", "guard branch: false", "expression: n < 2"], [], ""))
      explain_write(source, "main(): Void { print(5 - 2); }")
      results = append(results, explain_run("constant proof", ["explain", source, "--function", "main"], 0,
        ["subtraction: proved", "left constant: 5", "right constant: 2", "retained constant values"], ["guard branch"], ""))
      explain_write(source, "pure f(n: Nat, m: Nat): Nat { if n >= m { n - m } else { 0 } } main(): Void {}")
      results = append(results, explain_run("unsupported relationship remains unproved", ["explain", source, "--function", "f"], 1,
        ["subtraction: unproved", "right constant: unknown"], ["guard branch"], "Nat subtraction may underflow"))
      explain_write(source, "main(): Void { n: Int = 3; print(n - 1); }")
      results = append(results, explain_run("Int explanation unavailable", ["explain", source, "--function", "main"], 0,
        ["program: accepted", "subtraction: unavailable", "only explains Nat"], ["subtraction: proved"], ""))
      explain_write(source, "main(): Void { print(true - 1); }")
      results = append(results, explain_run("invalid operand explanation unavailable", ["explain", source, "--function", "main"], 1,
        ["program: rejected", "subtraction: unavailable", "operand checking failed"], ["subtraction: proved"], "does not accept Bool and Nat"))
      for expression in ["3 - 1.0", "3.0 - 1", "true - (-1)"] {
        explain_write(source, "main(): Void { print(" + expression + "); }")
        results = append(results, explain_run("incompatible numeric operands", ["explain", source, "--function", "main"], 1,
          ["program: rejected", "subtraction: unavailable", "operand checking failed"], ["subtraction: unproved", "obligation: left >= right"], "does not accept"))
      }
      explain_write(source, "pure f(): Nat { print(1); 5 - 2 } main(): Void {}")
      results = append(results, explain_run("local proof does not accept impure program", ["explain", source, "--function", "f"], 1,
        ["program: rejected", "subtraction: proved"], ["program: accepted"], "pure"))
      explain_write(source, "main(): Void { print(5 - 2); print(unknown); }")
      results = append(results, explain_run("resolver failure has no fabricated proof", ["explain", source, "--function", "main"], 1,
        ["program: rejected", "subtraction: unavailable"], ["subtraction: proved"], "unknown"))
      explain_write(source, "main(): Void { ??? }")
      results = append(results, explain_run("syntax failure has no fabricated proof", ["explain", source, "--function", "main"], 1,
        ["program: rejected", "subtraction: unavailable"], ["subtraction: proved"], "error:"))
      results = append(results, explain_run("missing source", ["explain", root + "/missing.panack", "--function", "main"], 1,
        ["program: rejected", "subtraction: unavailable"], ["subtraction: proved"], "missing source module"))
      for args in [["explain"], ["explain", artifact, "--function", "main"], ["explain", source, "--function", ""],
          ["explain", source, "--other", "main"], ["explain", source, "--function", "main", "extra"]] {
        results = append(results, explain_run("invalid explain arguments", args, 1, [], ["program:"], "explain usage"))
      }
      match testing_process_run(explain_path("/usr/bin/env"), ["-u", "PANACKELTY_STDLIB_PATH", "./panack-vm", "run",
          "bootstrap/compiler-v9.bc", "explain", source, "--function", "main"], bytes_empty(), path_value_current(), [], duration_seconds(15), 1048576) {
        Error(error) => { results = append(results, test_expect("missing embedded stdlib configuration", false, "command failed")); },
        Ok(actual) => { results = append(results, test_expect("missing embedded stdlib configuration",
          actual.exit_code == 1 && actual.signal == 0 && explain_contains(text_decode_utf8(actual.stderr), "standard library root is not configured") &&
          !explain_contains(text_decode_utf8(actual.stderr), "VM trap"), text_decode_utf8(actual.stderr))); }
      }
      explain_write(library, "// λ🙂\npub pure inspect[T](item: T): Void { print(item); }\n")
      explain_write(source, "import project/library as library\nmain(): Void {}\n")
      results = append(results, explain_run("imported generic effect rejection", ["explain", source, "--function", "inspect"], 1,
        ["effect boundary: rejected", "source: project/library.panack:2:38-2:49", "expression: print(item)", "context: pure", "callee: print", "callee effect: ordinary", "pure function cannot call impure function print"], ["effect boundary: allowed"], "pure function cannot call impure function print"))
      explain_write(source, "pure silent(): Nat { 1 } main(): Void { print(silent()); }")
      results = append(results, explain_run("allowed effect boundaries", ["explain", source, "--function", "main"], 0,
        ["effect boundary: allowed", "callee: print", "ordinary function permits", "callee: silent", "pure call is permitted"], ["effect boundary: rejected"], ""))
      results = append(results, explain_run("no calls has no invented evidence", ["explain", source, "--function", "silent"], 0,
        ["effects: unavailable", "no call or await boundary"], ["effect boundary:"], ""))
      explain_write(source, "pure answer(): Nat { 42 } pure probe(): Nat { f: Fn[Nat] = @answer; f.call() } main(): Void {}")
      results = append(results, explain_run("callable declared effect", ["explain", source, "--function", "probe"], 1,
        ["effect boundary: rejected", "expression: f.call()", "classification basis: callable type", "callee effect: ordinary"], [], "pure function cannot call impure function call"))
      explain_write(source, "async child(): Nat { 42 } async main(): Unit { n = await child(); () }")
      results = append(results, explain_run("allowed async await", ["explain", source, "--function", "main"], 0,
        ["effect boundary: allowed", "context: async", "callee effect: async", "awaited: yes", "async call is awaited inside an async function"], ["effect boundary: rejected", "\n42\n"], ""))
      explain_write(source, "async main(): Unit { print(42); () }")
      results = append(results, explain_run("async blocking rejection", ["explain", source, "--function", "main"], 1,
        ["effect boundary: rejected", "context: async", "async function cannot call blocking function print"], [], "async function cannot call blocking function print"))
      explain_write(source, "async child(): Nat { 42 } async main(): Unit { await child(); () }")
      results = append(results, explain_run("discarded await explains rejection", ["explain", source, "--function", "main"], 1,
        ["effect boundary: rejected", "boundary: await result", "bind, match or return a non-Unit await result"], [], "non-Unit await result"))
      explain_write(source, "main(): Void { n: Bool = 1; print(n); }")
      results = append(results, explain_run("type failure skips effects", ["explain", source, "--function", "main"], 1,
        ["effects: unavailable", "type checking prevented the effect pass"], ["effect boundary:"], "cannot assign"))
      explain_write(source, "pure broken(): Nat { true } pure probe(): Nat { broken() } main(): Void { print(1); }")
      results = append(results, explain_run("valid caller with invalid callee body", ["explain", source, "--function", "probe"], 1,
        ["program: rejected", "effect boundary: allowed", "callee: broken", "classification basis: function declaration", "callee effect: pure"], ["effect boundary: rejected"], "function broken returns Bool"))
      results = append(results, explain_run("invalid body explicitly unavailable", ["explain", source, "--function", "broken"], 1,
        ["effects: unavailable", "function body type checking"], ["effect boundary:"], "function broken returns Bool"))
      explain_write(library, "// λ🙂\npub pure inspect[T](item: T): Void { print(item); }\n")
      explain_write(source, "import project/library as library\nmain(): Void { n: Bool = 1; m: Nat = true; }\n")
      results = append(results, explain_run("recover imported generic rejection", ["explain", source, "--function", "inspect"], 1,
        ["program: rejected", "effect boundary: rejected", "source: project/library.panack:2:38-2:49", "expression: print(item)", "pure function cannot call impure function print"], ["effect boundary: allowed"], "binding n is Nat, expected Bool"))
      // The explanation's stderr must equal ordinary diagnostics byte for byte,
      // including order; recovered purity violations appear only in evidence.
      match testing_process_run(explain_path("./panack"), ["check", source], bytes_empty(), path_value_current(), [], duration_seconds(15), 1048576) {
        Error(error) => { results = append(results, test_expect("recovery diagnostic parity", false, "check failed")); },
        Ok(ordinary) => {
          match testing_process_run(explain_path("./panack"), ["explain", source, "--function", "inspect"], bytes_empty(), path_value_current(), [], duration_seconds(15), 1048576) {
            Error(error) => { results = append(results, test_expect("recovery diagnostic parity", false, "explain failed")); },
            Ok(explained) => { results = append(results, test_expect("recovery diagnostic parity", ordinary.exit_code == 1 && explained.exit_code == 1 && ordinary.stderr == explained.stderr, text_decode_utf8(explained.stderr))); }
          }
        }
      }
      for invalid in ["ordinary(): Nat { 1 } pure bad(): Nat { cb: PureFn[Nat] = @ordinary; cb.call() }",
          "bad(): Void { 42.call(); }", "async child(): Nat { 1 } async bad(): Bool { await child() }",
          "bad(): Void { for cb in 42 { cb.call(); } }"] {
        explain_write(source, "main(): Void { print(1); } " + invalid)
        results = append(results, explain_run("invalid inferred types never yield effects", ["explain", source, "--function", "bad"], 1,
          ["effects: unavailable", "function body type checking"], ["effect boundary:"], "error:"))
        results = append(results, explain_run("valid sibling survives invalid inferred types", ["explain", source, "--function", "main"], 1,
          ["program: rejected", "effect boundary: allowed", "callee: print"], ["effects: unavailable"], "error:"))
      }
      for invalid in ["bad(x: Missing): Void {}", "type Bad = Nat where 1;", "record Bad { x: Nat, x: Bool }", "enum Bad { Value(Missing) }"] {
        explain_write(source, "main(): Void { print(1); } " + invalid)
        results = append(results, explain_run("global declaration prevents recovery", ["explain", source, "--function", "main"], 1,
          ["effects: unavailable", "global declaration checking"], ["effect boundary:"], "error:"))
      }
      explain_write(source, "main(): Void { print(1); }")
      results = append(results, explain_run("repaired source has fresh accepted evidence", ["explain", source, "--function", "main"], 0,
        ["program: accepted", "effect boundary: allowed"], ["effects: unavailable"], ""))
      explain_write(source, "main(): Void { unknown(); }")
      results = append(results, explain_run("resolution failure skips effects", ["explain", source, "--function", "main"], 1,
        ["effects: unavailable", "resolution"], ["effect boundary:"], "unknown"))
      explain_write(source, "main(): Void { ??? }")
      results = append(results, explain_run("syntax failure skips effects", ["explain", source, "--function", "main"], 1,
        ["effects: unavailable"], ["effect boundary:"], "error:"))
      explain_write(source, "import \"library.panack\" as left\nimport \"right.panack\" as right\nmain(): Void { print(left.duplicate()); print(right.duplicate()); }\n")
      explain_write(library, "pub duplicate(): Nat { print(11); 11 }\n")
      explain_write(other, "pub duplicate(): Nat { print(22); 22 }\n")
      results = append(results, explain_run("qualified explanation selects left identity",
        ["explain", source, "--function", "project/library.panack:duplicate"], 0,
        ["program: accepted", "function: project/library.panack:duplicate", "source: project/library.panack:", "expression: print(11)"],
        ["expression: print(22)"], ""))
      results = append(results, explain_run("qualified explanation selects right identity",
        ["explain", source, "--function", "project/right.panack:duplicate"], 0,
        ["program: accepted", "function: project/right.panack:duplicate", "source: project/right.panack:", "expression: print(22)"],
        ["expression: print(11)"], ""))
      results = append(results, explain_run("ambiguous explanation selector rejected",
        ["explain", source, "--function", "duplicate"], 1,
        [], [], "ambiguous function selector duplicate"))
      results = append(results, explain_run("wrong explanation identity rejected",
        ["explain", source, "--function", "project/missing.panack:duplicate"], 1,
        [], [], "mismatched module identity selector"))
      for file in [source, library, artifact] {
        match filesystem_remove_file(explain_path(file)) { Ok(done) => {}, Error(error) => { results = append(results, test_expect("cleanup", false, error.code)); } }
      }
      filesystem_remove_file(explain_path(other))
      match test_workspace_remove_empty(workspace) { Ok(done) => {}, Error(error) => { results = append(results, test_expect("workspace cleanup", false, error.code)); } }
      if test_report(results) > 0 { host_exit(1); }
    }
  }
}
