        ["return type: unavailable", "expression: missing", "actual type: unavailable", "expected type: Nat", "did not determine a complete function result type"], [], "unknown name missing"))
      explain_write(source, "pure take[T](value: T): T { value }\npure caller(): Str { take(\"typed\") }\nmain(): Void {}\n")
