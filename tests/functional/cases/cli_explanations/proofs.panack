import stdlib/process as std_process
import stdlib/testing as std_testing
import stdlib/testing_files as std_testing_files
import stdlib/testing::{TestResult}
import stdlib/time as std_time
import stdlib/path as std_path
import stdlib/filesystem as std_filesystem
import stdlib/bytes as byte_buffer
import stdlib/environment as std_environment
import stdlib/host as std_host

import "support.panack"::{explain_path, explain_write, explain_run, explain_contains}

main(): Void {
  match std_testing_files.workspace_create(explain_path("/tmp")) {
    Error(error) => { std_host.stderr("workspace failed"); std_host.exit(1); },
    Ok(workspace) => {
      root: Str = workspace.root.to_text().value_or("")
      source: Str = root + "/main.panack"
      library: Str = root + "/library.panack"
      other: Str = root + "/right.panack"
      artifact: Str = root + "/main.bc"
      interpolation: Str = "$" + "{name}"
      mut results: [TestResult] = []
      original: Str = "import project/library as library\nmain(): Void { print(library.remaining[Str](\"x\", 5)); print(library.remaining[Nat](7, 4)); }\n"
      explain_write(source, "probe(flag: Bool): Int { if flag { 1 } else { -2 } }\nmain(): Void {}\n")
      results = results.append(explain_run("conditional result explains the combined type", ["explain", source, "--function", "probe"], 0,
        ["checked type join: accepted", "context: conditional result", "input types: Nat and Int", "resulting type: Int"], [], ""))
      explain_write(source, "enum Choice { First, Second }\nprobe(value: Choice): Int { match value { First() => 1, Second() => -2 } }\nmain(): Void {}\n")
      results = results.append(explain_run("match arms explain the combined type", ["explain", source, "--function", "probe"], 0,
        ["checked type join: accepted", "context: match result", "input types: Nat and Int", "resulting type: Int"], [], ""))
      explain_write(source, "pure combine[T](left: T, right: T): T { left }\nprobe(): Int { combine(1, -2) }\nmain(): Void {}\n")
      results = results.append(explain_run("generic calls explain repeated type parameter joins", ["explain", source, "--function", "probe"], 0,
        ["checked type join: accepted", "context: generic parameter T for combine", "context: first constraint for T for combine", "earlier constraint:", "expression: 1", "input types: Nat and Int", "resulting type: Int"], [], ""))
      explain_write(source, "pure combine[T](left: T, right: T): T { left }\nprobe(): Nat { combine(1, \"wrong\") }\nmain(): Void {}\n")
      results = results.append(explain_run("rejected generic inference join preserves checker diagnostic", ["explain", source, "--function", "probe"], 1,
        ["checked type join: rejected", "context: generic parameter T for combine", "input types: Nat and Str", "resulting type: unavailable"], [], "inference for combine: incompatible types Nat and Str"))
      explain_write(source, "pure combine[T](left: T, right: T): T { left }\nprobe(): Int { combine(1, 3 / 2) }\nmain(): Void {}\n")
      results = results.append(explain_run("unresolved generic inference join is explicit", ["explain", source, "--function", "probe"], 1,
        ["checked type join: unavailable", "context: generic parameter T for combine", "input types: Nat and Rat", "resulting type: unavailable", "did not determine a complete join"], [], "argument 2 to combine is Rat, expected Nat"))
      explain_write(source, "probe(): Int { 1 + -2 }\nmain(): Void {}\n")
      results = results.append(explain_run("accepted binary operator explains operand and result types", ["explain", source, "--function", "probe"], 0,
        ["operator type checks:", "operator type check: accepted", "operator: +", "left operand type: Nat", "right operand type: Int", "resulting expression type: Int"], [], ""))
      explain_write(source, "probe(): Int { -1 }\nmain(): Void {}\n")
      results = results.append(explain_run("accepted unary operator marks right operand not applicable", ["explain", source, "--function", "probe"], 0,
        ["operator type check: accepted", "operator: -", "left operand type: Nat", "right operand: not applicable", "resulting expression type: Int"], [], ""))
      explain_write(source, "probe(): Nat { 1 + \"wrong\" }\nmain(): Void {}\n")
      results = results.append(explain_run("rejected operator explains operand type mismatch", ["explain", source, "--function", "probe"], 1,
        ["operator type check: rejected", "operator: +", "left operand type: Nat", "right operand type: Str", "resulting expression type: unavailable"], [], "operator + does not accept Nat and Str"))
      explain_write(source, "probe(): Nat { missing + 1 }\nmain(): Void {}\n")
      results = results.append(explain_run("unresolved operator operand is explicitly unavailable", ["explain", source, "--function", "probe"], 1,
        ["operator type check: unavailable", "operator: +", "left operand type: unavailable", "right operand type: Nat", "resulting expression type: unavailable", "did not determine the required operand types"], [], "unknown local value missing"))
      explain_write(source, "probe(values: [Nat], position: Nat): Nat { values[position] }\nmain(): Void {}\n")
      results = results.append(explain_run("accepted index explains receiver and position types", ["explain", source, "--function", "probe"], 0,
        ["checked type requirements:", "checked type requirement: accepted", "context: index receiver", "actual type: Array[Nat]", "expected type: Str, Bytes or Array[T]", "resulting type: Nat", "context: index position", "actual type: Nat", "expected type: Nat", "resulting type: not applicable"], [], ""))
      explain_write(source, "probe(value: Nat): Nat { value[0] }\nmain(): Void {}\n")
      results = results.append(explain_run("rejected index receiver preserves checker diagnostic", ["explain", source, "--function", "probe"], 1,
        ["context: index receiver", "checked type requirement: rejected", "expression: value", "actual type: Nat", "expected type: Str, Bytes or Array[T]"], [], "indexing requires Str, Bytes or array, got Nat"))
      explain_write(source, "probe(values: [Nat], position: Str): Nat { values[position] }\nmain(): Void {}\n")
      results = results.append(explain_run("rejected index position preserves checker diagnostic", ["explain", source, "--function", "probe"], 1,
        ["context: index position", "checked type requirement: rejected", "expression: position", "actual type: Str", "expected type: Nat"], [], "index is Str, expected Nat"))
      explain_write(source, "probe(): Nat { missing[0] }\nmain(): Void {}\n")
      results = results.append(explain_run("unresolved index receiver is explicitly unavailable", ["explain", source, "--function", "probe"], 1,
        ["context: index receiver", "checked type requirement: unavailable", "actual type: unavailable", "expected type: Str, Bytes or Array[T]", "did not determine a complete type decision"], [], "unknown local value missing"))
      explain_write(source, "probe(): Nat { for item in [1, 2] { item }; 0 }\nmain(): Void {}\n")
      results = results.append(explain_run("accepted array iteration explains its item type", ["explain", source, "--function", "probe"], 0,
        ["checked type requirements:", "checked type requirement: accepted", "context: for iterable", "actual type: Array[Nat]", "expected type: Range, Bytes or Array[T]", "resulting type: Nat"], [], ""))
      explain_write(source, "probe(): Nat { for item in true { 0 }; 0 }\nmain(): Void {}\n")
      results = results.append(explain_run("rejected iteration source preserves checker diagnostic", ["explain", source, "--function", "probe"], 1,
        ["context: for iterable", "checked type requirement: rejected", "expression: true", "actual type: Bool", "expected type: Range, Bytes or Array[T]"], [], "for requires Range, Bytes or array, got Bool"))
      explain_write(source, "probe(): Nat { for item in missing { 0 }; 0 }\nmain(): Void {}\n")
      results = results.append(explain_run("unresolved iteration source is explicitly unavailable", ["explain", source, "--function", "probe"], 1,
        ["context: for iterable", "checked type requirement: unavailable", "actual type: unavailable", "expected type: Range, Bytes or Array[T]", "did not determine a complete type decision"], [], "unknown local value missing"))
      explain_write(source, "probe(flag: Bool): Nat { if flag { 1 } else { 2 } }\nmain(): Void {}\n")
      results = results.append(explain_run("accepted if condition explains its Bool requirement", ["explain", source, "--function", "probe"], 0,
        ["context: if condition", "checked type requirement: accepted", "actual type: Bool", "expected type: Bool", "resulting type: not applicable"], [], ""))
      explain_write(source, "probe(): Nat { if 1 { 1 } else { 2 } }\nmain(): Void {}\n")
      results = results.append(explain_run("rejected if condition preserves checker diagnostic", ["explain", source, "--function", "probe"], 1,
        ["context: if condition", "checked type requirement: rejected", "actual type: Nat", "expected type: Bool"], [], "if condition is Nat, expected Bool"))
      explain_write(source, "probe(): Nat { if missing { 1 } else { 2 } }\nmain(): Void {}\n")
      results = results.append(explain_run("unresolved if condition is explicitly unavailable", ["explain", source, "--function", "probe"], 1,
        ["context: if condition", "checked type requirement: unavailable", "actual type: unavailable", "expected type: Bool", "did not determine a complete type decision"], [], "unknown local value missing"))
      explain_write(source, "probe(flag: Bool): Void { while flag {} }\nmain(): Void {}\n")
      results = results.append(explain_run("accepted while condition explains its Bool requirement", ["explain", source, "--function", "probe"], 0,
        ["context: while condition", "checked type requirement: accepted", "actual type: Bool", "expected type: Bool", "resulting type: not applicable"], [], ""))
      explain_write(source, "enum Choice { First, Second }; probe(value: Choice): Nat { match value { First() => 1 } }\nmain(): Void {}\n")
      results = results.append(explain_run("valid match variant remains accepted when match is non-exhaustive", ["explain", source, "--function", "probe"], 1,
        ["program: rejected", "context: match variant", "checked type requirement: accepted", "expression: First()", "actual type: main.panack:Choice", "expected type: variant of main.panack:Choice", "resulting type: not applicable"], [], "non-exhaustive match; missing Second"))
      explain_write(source, "enum Choice { First }; enum Other { Second }; probe(value: Choice): Nat { match value { Second() => 1 } }\nmain(): Void {}\n")
      results = results.append(explain_run("wrong match variant explains enum membership rejection", ["explain", source, "--function", "probe"], 1,
        ["context: match variant", "checked type requirement: rejected", "expression: Second()", "actual type: main.panack:Choice", "expected type: variant of main.panack:Choice"], [], "pattern Second is not a variant of the matched enum"))
      explain_write(source, "enum Choice { First }; probe(): Nat { match missing { First() => 1 } }\nmain(): Void {}\n")
      results = results.append(explain_run("unresolved match subject leaves variant membership unavailable", ["explain", source, "--function", "probe"], 1,
        ["context: match subject", "checked match decision: unavailable", "decision rule: enum type", "context: match variant", "checked type requirement: unavailable", "actual type: unavailable", "expected type: variant of the matched enum", "did not determine a complete type decision"], [], "unknown local value missing"))
      results = results.append(explain_run("unresolved match subject leaves exhaustiveness unavailable", ["explain", source, "--function", "probe"], 1,
        ["context: match exhaustiveness", "checked match decision: unavailable", "subject type: unavailable", "decision rule: all variants of the matched enum are covered", "did not determine a complete type decision"], [], "unknown local value missing"))
      explain_write(source, "enum Choice { First, Second }; probe(value: Choice): Nat { match value { First() => 1, Second() => 2 } }\nmain(): Void {}\n")
      results = results.append(explain_run("exhaustive match explains complete variant coverage", ["explain", source, "--function", "probe"], 0,
        ["context: match subject", "checked match decision: accepted", "decision rule: enum type", "context: match exhaustiveness", "checked match decision: accepted", "subject type: main.panack:Choice", "decision rule: all variants of main.panack:Choice are covered", "context: match arm uniqueness", "checked match decision: accepted", "reason: the existing checker accepted this match rule"], [], ""))
      explain_write(source, "probe(value: Nat): Nat { match value { None() => 0 } }\nmain(): Void {}\n")
      results = results.append(explain_run("non-enum match subject explains rejection", ["explain", source, "--function", "probe"], 1,
        ["context: match subject", "checked match decision: rejected", "subject type: Nat", "decision rule: enum type", "context: match exhaustiveness", "checked match decision: unavailable", "decision rule: all variants of an enum subject are covered"], [], "match requires an enum, got Nat"))
      explain_write(source, "enum Choice { First, Second }; probe(value: Choice): Nat { match value { First() => 1 } }\nmain(): Void {}\n")
      results = results.append(explain_run("non-exhaustive match explains missing variants", ["explain", source, "--function", "probe"], 1,
        ["context: match exhaustiveness", "checked match decision: rejected", "decision rule: all variants of main.panack:Choice are covered; missing Second", "reason: the existing checker rejected this match rule"], [], "non-exhaustive match; missing Second"))
      explain_write(source, "enum Choice { First }; probe(value: Choice): Nat { match value { First() => 1, First() => 2 } }\nmain(): Void {}\n")
      results = results.append(explain_run("duplicate match arm explains uniqueness rejection", ["explain", source, "--function", "probe"], 1,
        ["context: match arm uniqueness", "checked match decision: rejected", "decision rule: variant First appears at most once in this match", "reason: the existing checker rejected this match rule"], [], "duplicate match arm First"))
      explain_write(source, "enum Choice[T] { Pick(T), Empty }; probe(value: Choice[Nat]): Nat { match value { Pick() => 1, Empty() => 0 } }\nmain(): Void {}\n")
      results = results.append(explain_run("match payload binding count explains rejection", ["explain", source, "--function", "probe"], 1,
        ["context: match payload bindings", "checked match decision: rejected", "decision rule: expected 1 binding(s) for variant Pick; found 0", "reason: the existing checker rejected this match rule"], [], "pattern Pick expects 1 bindings"))
      explain_write(source, "enum Choice[T] { Pick(T), Empty }; probe(value: Choice[Nat]): Nat { match value { Pick(item) => item, Empty() => 0 } }\nmain(): Void {}\n")
      results = results.append(explain_run("accepted match payload binding count explains arity", ["explain", source, "--function", "probe"], 0,
        ["context: match payload bindings", "checked match decision: accepted", "decision rule: expected 1 binding(s) for variant Pick; found 1"], [], ""))
      results = results.append(explain_run("generic match payload explains substituted binding type", ["explain", source, "--function", "probe"], 0,
        ["checked match payload type: accepted", "context: match payload type", "matched enum type: main.panack:Choice[Nat]", "payload source: binding item receives payload 1 of Pick", "resulting type: Nat", "the checker substituted this variant payload type for the pattern binding"], [], ""))
      explain_write(source, "enum Choice[T] { Pick(T), Empty }; probe(): Nat { match missing { Pick(item) => 1, Empty() => 0 } }\nmain(): Void {}\n")
      results = results.append(explain_run("unresolved generic match payload type is explicitly unavailable", ["explain", source, "--function", "probe"], 1,
        ["checked match payload type: unavailable", "context: match payload type", "matched enum type: unavailable", "payload source: binding item receives payload 1 of Pick", "resulting type: unavailable", "could not determine the matched enum type needed for payload substitution"], [], "unknown local value missing"))
      explain_write(source, "record Box[T] { value: T }; probe(box: Box[Nat]): Nat { box.value }\nmain(): Void {}\n")
      results = results.append(explain_run("accepted generic record field explains receiver and result types", ["explain", source, "--function", "probe"], 0,
        ["context: field access", "checked type requirement: accepted", "actual type: main.panack:Box[Nat]", "expected type: record with field value", "resulting type: Nat"], [], ""))
      explain_write(source, "probe(value: Nat): Nat { value.value }\nmain(): Void {}\n")
      results = results.append(explain_run("rejected non-record field receiver preserves diagnostic", ["explain", source, "--function", "probe"], 1,
        ["context: field access", "checked type requirement: rejected", "actual type: Nat", "expected type: record with field value"], [], "field access requires a record, got Nat"))
      explain_write(source, "record Box { value: Nat }; probe(): Nat { missing.value }\nmain(): Void {}\n")
      results = results.append(explain_run("unresolved field receiver is explicitly unavailable", ["explain", source, "--function", "probe"], 1,
        ["context: field access", "checked type requirement: unavailable", "actual type: unavailable", "expected type: record with field value", "The receiver type could not be determined."], [], "unknown local value missing"))
      explain_write(source, "probe(flag: Bool): Rat { if flag { 1 } else { 3 / 2 } }\nmain(): Void {}\n")
      results = results.append(explain_run("unresolved branch join is explicit", ["explain", source, "--function", "probe"], 1,
        ["checked type join: unavailable", "context: conditional result", "input types: Nat and Rat", "resulting type: unavailable", "did not determine a complete join"], [], "function is not completely checked for identity emission: probe"))
      explain_write(source, "probe(): Void { unresolved = []; }\nmain(): Void {}\n")
      results = results.append(explain_run("incomplete inferred local is explicitly unavailable", ["explain", source, "--function", "probe"], 1,
        ["inferred local: unresolved", "inferred type: unavailable", "initializer did not determine a complete type"], ["inferred type: Array"], "cannot infer"))
      results = results.append(explain_run("type-at does not explain an invalid body", ["explain", source, "--function", "probe", "--type-at", "1", "30"], 1,
        ["checked expression type: unavailable", "function body type checking did not complete"], [], "cannot infer"))
      explain_write(source, original)
      explain_write(library, "// \u03bb\ud83d\ude42\npub pure remaining[T](item: T, n: Nat): Nat {\n  if n >= 2 { n - 2 } else { 0 }\n}\n")
      results = results.append(explain_run("imported generic proof", ["explain", source, "--function", "remaining"], 0,
        ["program: accepted", "function: remaining", "subtraction: proved", "source: project/library.panack:3:15-3:20\nexpression: n - 2", "left lower bound: 2", "guard branch: true\nsource: project/library.panack:3:6-3:12\nexpression: n >= 2"], ["subtraction: unproved"], ""))
      results = results.append(explain_run("type-at preserves imported generic expression source", ["explain", source, "--function", "remaining", "--type-at", "3", "17"], 0,
        ["checked expression type: Nat", "source: project/library.panack:3:15-3:20\nexpression: n - 2"], [], ""))
      explain_write(library, "pub type Positive = Nat where value => value > 0\npub pure inspect[T](tag: T, value: Nat): Void {\n  if value > 0 { positive: Positive = value; }\n}\n")
      explain_write(source, "import project/library as library\nmain(): Void { library.inspect[Str](\"tag\", 2); }\n")
      results = results.append(explain_run("imported generic guarded conversion attribution", ["explain", source, "--function", "inspect"], 0,
        ["guarded conversion: proved", "source: project/library.panack:3:", "conversion: Nat -> library.panack:Positive", "target guard: (value > 0)", "facts: value >= 1", "retained value facts satisfy the target guard"], ["guarded conversion: unproved"], ""))
      explain_write(source, "type Positive = Nat where value => value > 0\ntype NonNegative = Nat where candidate => candidate >= 0\npure inspect(value: Nat): Void { if value > 0 { positive: Positive = value; } }\nmain(): Void {}\n")
      results = results.append(explain_run("guarded conversion cites local branch facts", ["explain", source, "--function", "inspect"], 0,
        ["guarded conversions:", "guarded conversion: proved", "conversion: Nat -> main.panack:Positive", "target guard: (value > 0)", "facts: value >= 1", "retained value facts satisfy the target guard"], ["guarded conversion: unproved"], ""))
      explain_write(source, "type Positive = Nat where value => value > 0\ntype NonNegative = Nat where candidate => candidate >= 0\npure inspect(value: Positive): Void { broad: NonNegative = value; }\nmain(): Void {}\n")
      results = results.append(explain_run("guarded source proves a broader guarded target", ["explain", source, "--function", "inspect"], 0,
        ["guarded conversion: proved", "conversion: main.panack:Positive -> main.panack:NonNegative", "source guard: (value > 0)", "target guard: (candidate >= 0)", "facts: value >= 1"], ["guarded conversion: unproved"], ""))
      explain_write(source, "type Positive = Nat where value => value > 0\npure inspect(): Positive { 0 }\nmain(): Void {}\n")
      results = results.append(explain_run("rejected guarded conversion explains missing proof", ["explain", source, "--function", "inspect"], 1,
        ["program: rejected", "guarded conversion: unproved", "source: project/main.panack:2:", "expression: 0", "conversion: Nat -> main.panack:Positive", "facts: value >= 0 and value <= 0", "do not prove the target guard"], [], "return of inspect is Nat, expected main.panack:Positive"))
      explain_write(source, "type Positive = Nat where value => value > 0\npure inspect(value: Positive): Nat { value }\nmain(): Void {}\n")
      results = results.append(explain_run("guarded to base widening has no proof conversion", ["explain", source, "--function", "inspect"], 0,
        ["guarded conversions: none"], ["guarded conversion:"], ""))
      results = results.append(explain_run("query does not execute main", ["explain", source, "--function", "main"], 0,
        ["subtraction: unavailable", "no subtraction evidence"], ["\n3\n", "\n2\n"], ""))
      results = results.append(explain_run("unknown function", ["explain", source, "--function", "absent"], 1,
        [], [], "unknown function absent"))
      explain_write(source, "main(): Void { print(3); print(2); }\n")
      results = results.append(explain_run("ordinary source executes", [source], 0,
        ["3\n2\n"], ["program:"], ""))
      results = results.append(explain_run("ordinary compile", ["compile", source, "-o", artifact], 0,
        ["wrote "], [], ""))
      results = results.append(explain_run("ordinary bytecode executes", [artifact], 0,
        ["3\n2\n"], ["program:"], ""))
      explain_write(source, "main(): Void { mut n: Nat = 3; if n >= 2 { n = 0; print(n - 2); } }")
      results = results.append(explain_run("stale guard is not cited", ["explain", source, "--function", "main"], 1,
        ["program: rejected", "subtraction: unproved", "does not establish a runtime failure"], ["left lower bound", "guard branch"], "Nat subtraction may underflow"))
      explain_write(source, "main(): Void { mut n: Nat = 3; if n >= 2 { n = 4; if n > 2 { print(n - 3); } } }")
      results = results.append(explain_run("fresh guard is cited", ["explain", source, "--function", "main"], 0,
        ["subtraction: proved", "left lower bound: 3", "expression: n > 2"], ["left lower bound: 2"], ""))
      explain_write(source, "pure f(n: Nat): Nat { if n < 2 { 0 } else { n - 2 } } main(): Void {}")
      results = results.append(explain_run("false branch proof", ["explain", source, "--function", "f"], 0,
        ["subtraction: proved", "guard branch: false", "expression: n < 2"], [], ""))
      explain_write(source, "main(): Void { print(5 - 2); }")
      results = results.append(explain_run("constant proof", ["explain", source, "--function", "main"], 0,
        ["subtraction: proved", "left constant: 5", "right constant: 2", "retained constant values"], ["guard branch"], ""))
      explain_write(source, "pure f(n: Nat, m: Nat): Nat { if n >= m { n - m } else { 0 } } main(): Void {}")
      results = results.append(explain_run("unsupported relationship remains unproved", ["explain", source, "--function", "f"], 1,
        ["subtraction: unproved", "right constant: unknown"], ["guard branch"], "Nat subtraction may underflow"))
      explain_write(source, "main(): Void { n: Int = 3; print(n - 1); }")
      results = results.append(explain_run("Int explanation unavailable", ["explain", source, "--function", "main"], 0,
        ["program: accepted", "subtraction: unavailable", "only explains Nat"], ["subtraction: proved"], ""))
      explain_write(source, "main(): Void { print(true - 1); }")
      results = results.append(explain_run("invalid operand explanation unavailable", ["explain", source, "--function", "main"], 1,
        ["program: rejected", "subtraction: unavailable", "operand checking failed"], ["subtraction: proved"], "does not accept Bool and Nat"))
      for expression in ["3 - 1.0", "3.0 - 1", "true - (-1)"] {
        explain_write(source, "main(): Void { print(" + expression + "); }")
        results = results.append(explain_run("incompatible numeric operands", ["explain", source, "--function", "main"], 1,
        ["program: rejected", "subtraction: unavailable", "operand checking failed"], ["subtraction: unproved", "obligation: left >= right"], "does not accept"))
      }
      explain_write(source, "pure f(): Nat { print(1); 5 - 2 } main(): Void {}")
      results = results.append(explain_run("local proof does not accept impure program", ["explain", source, "--function", "f"], 1,
        ["program: rejected", "subtraction: proved"], ["program: accepted"], "pure"))
      explain_write(source, "main(): Void { print(5 - 2); print(unknown); }")
      results = results.append(explain_run("local constant proof survives an unrelated unknown value", ["explain", source, "--function", "main"], 1,
        ["program: rejected", "subtraction: proved", "retained constant values satisfy the obligation"], ["program: accepted"], "unknown"))
      explain_write(source, "main(): Void { ??? }")
      results = results.append(explain_run("syntax failure has no fabricated proof", ["explain", source, "--function", "main"], 1,
        ["program: rejected", "subtraction: unavailable"], ["subtraction: proved"], "error:"))
      results = results.append(explain_run("missing source", ["explain", root + "/missing.panack", "--function", "main"], 1,
        ["program: rejected", "subtraction: unavailable"], ["subtraction: proved"], "missing source module"))
      for args in [["explain"], ["explain", artifact, "--function", "main"], ["explain", source, "--function", ""],
          ["explain", source, "--other", "main"], ["explain", source, "--function", "main", "extra"]] {
        results = results.append(explain_run("invalid explain arguments", args, 1, [], ["program:"], "explain usage"))
      }
      match std_process.run(explain_path("/usr/bin/env"), ["-u", "PANACKELTY_STDLIB_PATH", "./panack-vm", "run",
          "bootstrap/compiler-v9.bc", "explain", source, "--function", "main"], byte_buffer.empty(), std_path.current(), [], std_time.seconds(15), 1048576) {
        Error(error) => { results = results.append(std_testing.expect("missing embedded stdlib configuration", false, "command failed")); },
        Ok(actual) => { results = results.append(std_testing.expect("missing embedded stdlib configuration",
          actual.exit_code == 1 && actual.signal == 0 && explain_contains(actual.stderr.decode_utf8(), "standard library root is not configured") &&
          !explain_contains(actual.stderr.decode_utf8(), "VM trap"), actual.stderr.decode_utf8())); }
      }
      explain_write(library, "// \u03bb\ud83d\ude42\npub pure inspect[T](item: T): Void { print(item); }\n")
      explain_write(source, "import project/library as library\nmain(): Void {}\n")
      results = results.append(explain_run("imported generic effect rejection", ["explain", source, "--function", "inspect"], 1,
        ["effect boundary: rejected", "source: project/library.panack:2:38-2:49", "expression: print(item)", "context: pure", "callee: print", "callee effect: ordinary", "pure function cannot call impure function print"], ["effect boundary: allowed"], "pure function cannot call impure function print"))
