import stdlib/result::{result_value_or}
import stdlib/testing::{TestResult, test_expect, test_report}
import stdlib/testing_files::{test_workspace_create, test_workspace_remove_empty}
import stdlib/time::{duration_seconds}
import stdlib/path::{path_value_from_text, path_value_current, path_value_append, path_value_to_text}
import stdlib/filesystem::{filesystem_write_bytes, filesystem_remove_file}
import stdlib/testing_commands::{testing_process_run}
import stdlib/bytes::{bytes_empty, text_encode_utf8, text_decode_utf8}
import stdlib/host::{host_exit}
pure path(text: Str): Path {
  result_value_or(path_value_from_text(text), path_value_current())
}

pure child(root: Path, name: Str): Path {
  result_value_or(path_value_append(root, path(name)), root)
}

pure contains(value: Str, fragment: Str): Bool {
  mut found = false
  for index in 0..value.len() {
    if value.starts_with_at(fragment, index) { found = true }
  }
  found
}

trap(name: Str, file: Str, message: Str): TestResult {
  match testing_process_run(path("./panack"), ["run", file], bytes_empty(), path_value_current(), [],
      duration_seconds(10), 1048576) {
    Error(error) => test_expect(name, false, "process failed"),
    Ok(output) => test_expect(name,
      output.exit_code != 0 && output.signal == 0 && output.stdout == bytes_empty() &&
        contains(text_decode_utf8(output.stderr), message), "unexpected runtime trap")
  }
}

main(): Void {
  match test_workspace_create(path("/tmp")) {
    Error(error) => { print("workspace creation failed"); host_exit(1) },
    Ok(workspace) => {
      expressions = ["(1/3).nat()", "((-3)/1).nat()", "(1/3).dec()", "1/z",
        "(1/3)/(z/1)", "quotient(1, z)"]
      messages = ["exact Nat", "exact Nat", "non-terminating", "division by zero",
        "division by zero", "division by zero"]
      mut results: [TestResult] = []
      for index in 0..len(expressions) {
        source = child(workspace.root, "rational-${index}.panack")
        artifact = child(workspace.root, "rational-${index}.bc")
        source_text = result_value_or(path_value_to_text(source), "invalid-source")
        artifact_text = result_value_or(path_value_to_text(artifact), "invalid-artifact")
        expression = expressions[index]
        content = "main(): Void { z = nat_from_str(\"0\"); print(${expression}) }"
        match filesystem_write_bytes(source, text_encode_utf8(content)) {
          Error(error) => { results = results.append(test_expect("rational-${index}/fixture",
            false, "source write failed")) },
          Ok(written) => {
            match testing_process_run(path("./panack"), ["compile", source_text, "-o", artifact_text],
                bytes_empty(), path_value_current(), [], duration_seconds(10), 1048576) {
              Error(error) => { results = results.append(test_expect("rational-${index}/compile",
                false, "process failed")) },
              Ok(compiled) => {
                results = results.append(test_expect("rational-${index}/compile",
                  compiled.exit_code == 0 && compiled.signal == 0 &&
                    compiled.stdout == text_encode_utf8("wrote ${artifact_text}\n") &&
                    compiled.stderr == bytes_empty(), "compilation failed"))
                results = results.append(trap("rational-${index}/source", source_text,
                  messages[index]))
                results = results.append(trap("rational-${index}/bytecode", artifact_text,
                  messages[index]))
              }
            }
          }
        }
        for file in [source, artifact] {
          match filesystem_remove_file(file) {
            Ok(removed) => {},
            Error(error) => { results = results.append(test_expect("rational-${index}/cleanup",
              false, "file removal failed")) }
          }
        }
      }
      match test_workspace_remove_empty(workspace) {
        Ok(removed2) => {},
        Error(error) => { results = results.append(test_expect("workspace cleanup", false,
          "directory removal failed")) }
      }
      failures = test_report(results)
      if failures > 0 { host_exit(1) }
    }
  }
}
