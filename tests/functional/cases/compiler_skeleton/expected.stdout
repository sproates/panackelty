usage: panack inventory SOURCE.panack -o FILE [--include SOURCE.panack]
       panack inventory-check SOURCE.panack --inventory FILE [--include SOURCE.panack]
       panack FILE | panack {check,compile,run,disasm} FILE
       panack explain SOURCE.panack --function NAME
       panack compile SOURCE.panack -o ARTIFACT.bc --source-map MAP
       panack locate ARTIFACT.bc --source SOURCE.panack --source-map MAP --function NAME --instruction PC
