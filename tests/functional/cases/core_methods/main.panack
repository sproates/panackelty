import "helpers.panack" as helpers

pure less(a: Nat, b: Nat): Bool { a < b }
pure ends_with(value: Nat): Nat { value + 1 }
pure first(value: Nat): Nat { value + 2 }
pure sort_by(value: Nat): Nat { value + 3 }
pure core_ends_with(value: Nat): Nat { value + 4 }
pure twice(value: Nat): Nat { value * 2 }

main(): Void {
  present: Option[Nat] = Some(42)
  absent: Option[Nat] = None()
  match present { Some(n) => print(n), None() => print(0) }
  match absent { Some(n) => print(n), None() => print("empty") }
  print(helpers.describe(Ok(7)))
  print(helpers.describe(Error("failed")))
  print("hello.panack".ends_with(".panack"))
  print("42".parse_nat().twice())
  print([3, 1, 2].sort_by(@less).first())
  print([].first[Str]())
  print(ends_with(1))
  print(first(1))
  print(sort_by(1))
  print(core_ends_with(1))
  print("abc".slice(1, 3).reverse().starts_with("c"))
  print("abc".starts_with_at("b", 1))
  print("7".is_digit())
  print("a".is_letter())
  print(" ".is_whitespace())
}
