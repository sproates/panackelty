import "external.panack"::{Port as RemotePort}
type Label = Str where text =>
  text != "" && text.len() <= 2
  && text.is_non_blank() && text.has_no_control_characters()

type Short = Str where candidate => candidate.len() <= 3
type Names = [Str] where items => items.len() >= 1 && items.len() <= (1 + 1)
type OneEntry = Map[Str,Nat] where values => values.len() >= 1 && values.len() <= 1
type OneMember = Set[Nat] where values => values.len() >= 1 && values.len() <= 1

pure checked_label(input: Str): Label {
  if input.len() >= 1 && input.len() <= 2 && input.is_non_blank() && input.has_no_control_characters() {
    input
  } else { "?" }
}

pure widen(label: Label): Short { label }

main(): Void {
  print(widen(checked_label("𐐷")))
  print(Label("é").len())
  print(checked_label("\t"))
  names = ["first", "second"]
  print(Names(names).len())
  by_name = map().put("same", 1)
  print(OneEntry(by_name.put("same", 9)).get("same"))
  print(OneMember(set().add(5).add(5)).len())
  print("​".is_non_blank())
  print(" ".has_no_control_characters())
  exercise_validation()
}

type Alternative = Int where n => (n < 2 || n > 8) && n != 4

counted_input(): Str {
  print("evaluated input")
  ""
}

show_label(input: Str): Void {
  match validate[Label](input) {
    Ok(label) => print(label),
    Error(problem) => {
      print(problem.failures.len())
      print(problem.render())
    }
  }
}

exercise_validation(): Void {
  show_label(counted_input())
  show_label("𐐷")
  show_label("  ")
  show_label("𐐷\tprivate")
  match validate[Names]([]) { Ok(names) => print(names.len()), Error(problem) => print(problem.render()) }
  match validate[OneEntry](map().put("secret",1).put("secret",2)) {
    Ok(entries) => print(entries.len()), Error(problem) => print(problem.render())
  }
  match validate[OneMember](set().add(1).add(2)) {
    Ok(items) => print(items.len()), Error(problem) => print(problem.render())
  }
  match validate[Alternative](4) { Ok(n) => print(n), Error(problem) => print(problem.render()) }
  match validate[Alternative](9) { Ok(n) => print(n), Error(problem) => print(problem.render()) }
  match validate[RemotePort](65536) {
    Ok(port) => print(port),
    Error(problem) => { print(problem.target_type.ends_with("external.panack:Port")); print(problem.render()) }
  }
}
