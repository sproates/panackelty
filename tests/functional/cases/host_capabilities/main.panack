import stdlib/text as std_text
import stdlib/filesystem as std_filesystem
import stdlib/host as std_host
import stdlib/process as std_process
import stdlib/result as std_result
import stdlib/time as std_time
import stdlib/path as std_path
import stdlib/host::{HostError}
import stdlib/filesystem::{FileKind, FileKind.RegularFile, FileKind.SymbolicLink}
import stdlib/bytes as byte_buffer

pure path(text: Str): Path { std_result.value_or(std_path.from_text(text), std_path.current()) }
pure outcome[T](result: Result[T,HostError]): Str {
  match result { Ok(value) => "ok", Error(error) => error.code }
}
main(): Void {
  print(outcome(std_host.sleep(std_time.from_nanoseconds(-1))))
  print(outcome(std_host.sleep(std_time.seconds(31536001))))
  print(outcome(std_host.sleep(std_time.from_nanoseconds(0))))
  print(outcome(std_host.decode_utf8(byte_buffer.push(byte_buffer.empty(), 255))))
  print(std_result.value_or(std_host.decode_utf8(std_text.encode_utf8("hello λ")), "bad"))
  match std_filesystem.temp_directory(path("/tmp")) {
    Error(error) => { print(error.code) },
    Ok(directory) => {
      file = std_result.value_or(std_path.join(directory, path("data")), directory)
      print(outcome(std_filesystem.write(file, std_text.encode_utf8("hello"))))
      print(std_result.value_or(std_filesystem.read(file, 5), byte_buffer.empty()) == std_text.encode_utf8("hello"))
      print(outcome(std_filesystem.read(file, 4)))
      match std_filesystem.metadata(file) { Error(error) => { print(error.code) }, Ok(info) => {
        print(info.kind == RegularFile())
        print(info.size)
      } }
      print(outcome(std_filesystem.create_directory(file)))
      print(outcome(std_filesystem.remove_directory(directory)))
      raw = std_result.value_or(std_path.from_native(byte_buffer.push(byte_buffer.empty(), 122)), path("bad"))
      native_file = std_result.value_or(std_path.join(directory, raw), directory)
      print(outcome(std_filesystem.write(native_file, byte_buffer.empty())))
      entries = std_result.value_or(std_filesystem.list_directory(directory), [path("bad")])
      print(len(entries))
      print(std_path.display(entries[0]))
      print(std_path.native_bytes(entries[1]) == std_path.native_bytes(raw))
      print(outcome(std_filesystem.remove_file(native_file)))
      print(outcome(std_filesystem.remove_file(file)))
      print(outcome(std_filesystem.read(file, 1)))
      match std_filesystem.temp_file(directory) {
        Error(error) => { print(error.code) },
        Ok(temporary) => { print(outcome(std_filesystem.remove_file(temporary))) }
      }
      match std_process.run(path("/bin/sh"), ["-c", "printf child > child-output; ln -s child-output child-link"], byte_buffer.empty(), directory, [], std_time.seconds(3), 10) {
        Error(error) => { print(error.code) }, Ok(output) => { print(output.exit_code) }
      }
      child_output = std_result.value_or(std_path.join(directory, path("child-output")), directory)
      child_link = std_result.value_or(std_path.join(directory, path("child-link")), directory)
      print(std_result.value_or(std_filesystem.read(child_link, 5), byte_buffer.empty()) == std_text.encode_utf8("child"))
      match std_filesystem.metadata(child_link) {
        Error(error) => { print(error.code) }, Ok(info) => { print(info.kind == SymbolicLink()) }
      }
      print(outcome(std_filesystem.remove_file(child_link)))
      print(outcome(std_filesystem.remove_file(child_output)))
      child = std_result.value_or(std_path.join(directory, path("child")), directory)
      print(outcome(std_filesystem.create_directory(child)))
      print(outcome(std_filesystem.remove_directory(child)))
      print(outcome(std_filesystem.remove_directory(directory)))
    }
  }
  match std_process.run(path("/bin/sh"), ["-c", "cat; printf err >&2; exit 7"], std_text.encode_utf8("in"), std_path.current(), [], std_time.seconds(3), 100) {
    Error(error) => { print(error.code) },
    Ok(output) => {
      print(output.exit_code)
      print(output.signal)
      print(std_result.value_or(std_host.decode_utf8(output.stdout), "bad"))
      print(std_result.value_or(std_host.decode_utf8(output.stderr), "bad"))
    }
  }
  print(outcome(std_process.run(path("/does-not-exist"), [], byte_buffer.empty(), std_path.current(), [], std_time.seconds(1), 10)))
  print(outcome(std_process.run(path("/bin/sh"), ["-c", "sleep 5"], byte_buffer.empty(), std_path.current(), [], std_time.milliseconds(20), 10)))
  print(outcome(std_process.run(path("/bin/sh"), ["-c", "printf too-long"], byte_buffer.empty(), std_path.current(), [], std_time.seconds(1), 1)))
  print(outcome(std_process.run(path("/bin/sh"), [], byte_buffer.empty(), std_path.current(), ["INVALID"], std_time.seconds(1), 10)))
}
