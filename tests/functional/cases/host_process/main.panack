import stdlib/result::{result_value_or}
import stdlib/time::{duration_seconds, duration_milliseconds}
import stdlib/path::{path_value_from_text, path_value_current}
import stdlib/host::{HostError, ProcessOutput, host_process_run, host_decode_utf8_value}
import stdlib/bytes::{bytes_empty, bytes_join, bytes_length, bytes_at, text_encode_utf8}
pure path(text: Str): Path { result_value_or(path_value_from_text(text), path_value_current()) }
pure code(value: Result[ProcessOutput,HostError]): Str {
  match value { Ok(output) => "ok", Error(error) => error.code }
}
main(): Void {
  mut input = text_encode_utf8("x")
  mut count: Nat = 0
  while count < 17 { input = bytes_join(input, input); count = count + 1 }
  match host_process_run(path("/bin/sh"), ["-c", "dd if=/dev/zero bs=1024 count=128 2>/dev/null; dd if=/dev/zero bs=1024 count=128 >&2 2>/dev/null; cat"], input, path_value_current(), [], duration_seconds(5), 400000) {
    Error(error) => { print(error.code) },
    Ok(output) => { print(bytes_length(output.stdout)); print(bytes_length(output.stderr)); print(output.exit_code) }
  }
  print(code(host_process_run(path("/bin/sh"), ["-c", "exit 0"], input, path_value_current(), [], duration_seconds(3), 0)))
  match host_process_run(path("/bin/sh"), ["-c", "printf \"$PANACK_HOST_TEST\"; printf '\\377' >&2; kill -TERM $$"], bytes_empty(), path_value_current(), ["PANACK_HOST_TEST=value"], duration_seconds(3), 100) {
    Error(error) => { print(error.code) },
    Ok(output) => {
      print(result_value_or(host_decode_utf8_value(output.stdout), "bad"))
      print(bytes_at(output.stderr, 0))
      print(output.signal)
    }
  }
  print(code(host_process_run(path("/bin/sh"), [], bytes_empty(), path_value_current(), ["A=1", "A=2"], duration_seconds(1), 10)))
  print(code(host_process_run(path("/bin/sh"), [], bytes_empty(), path_value_current(), [], duration_seconds(-1), 10)))
  print(code(host_process_run(path("/bin/sh"), [], bytes_empty(), path_value_current(), [], duration_seconds(31536001), 10)))
  print(code(host_process_run(path("/bin/sh"), [], bytes_empty(), path_value_current(), [], duration_seconds(0), 10)))
  print(code(host_process_run(path("/bin/sh"), [], bytes_empty(), path("/does-not-exist"), [], duration_seconds(1), 10)))
  print(code(host_process_run(path("/bin/sh"), ["-c", "sleep 5 & exit 0"], bytes_empty(), path_value_current(), [], duration_milliseconds(30), 10)))
}
