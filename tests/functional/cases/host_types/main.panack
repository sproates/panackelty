import stdlib/result::{result_value_or}
import stdlib/path::{PathError, PathError.EmptyPath, PathError.PathContainsNul, PathError.PathNotUtf8, PathError.AbsolutePathAppend, path_value_from_text, path_value_from_native, path_value_append, path_value_current, path_value_display, path_value_is_absolute, path_value_native_bytes, path_value_filename, path_value_directory, path_value_to_text}
import stdlib/time::{DurationError, DurationError.ZeroDurationDivisor, DurationError.FractionalNanosecond, ClockError, duration_seconds, duration_milliseconds, duration_add, duration_subtract, duration_scale, duration_before, duration_as_seconds, duration_divide, duration_ratio, duration_value_ticks, duration_value_nanoseconds, duration_value_from_seconds, instant_value_now, instant_value_add, instant_value_before, instant_value_difference}
import stdlib/bytes::{bytes_empty, bytes_push, text_encode_utf8}
pure path(value: Str): Path { result_value_or(path_value_from_text(value), path_value_current()) }
pure path_result(value: Result[Path,PathError]): Str {
  match value {
    Ok(p) => path_value_display(p),
    Error(e) => match e {
      EmptyPath() => "empty", PathContainsNul() => "nul",
      PathNotUtf8() => "utf8", AbsolutePathAppend() => "absolute"
    }
  }
}
pure duration_result(value: Result[Duration,DurationError]): Str {
  match value {
    Ok(d) => { ticks = duration_value_ticks(d); "${ticks}ns" },
    Error(e) => match e {
      FractionalNanosecond() => "fractional", ZeroDurationDivisor() => "zero"
    }
  }
}
main(): Void {
  print(path_result(path_value_from_text("")))
  print(path_result(path_value_from_native(bytes_push(bytes_empty(), 0))))
  print(path_result(path_value_append(path("a/../b"), path("./c"))))
  print(path_result(path_value_append(path("a"), path("/b"))))
  print(path_value_display(path_value_directory(path("a/b/"))))
  print(path_value_display(path_value_directory(path("//host"))))
  print(path_value_is_absolute(path("/a")))
  print(path("a") == path("./a"))
  print(path("a") == path("a"))
  print(path_value_native_bytes(path("hello")) == text_encode_utf8("hello"))
  print(match path_value_filename(path("/a/b/")) { Some(p) => path_value_display(p), None() => "none" })
  print(match path_value_filename(path("/")) { Some(p) => path_value_display(p), None() => "none" })
  raw = result_value_or(path_value_from_native(bytes_push(bytes_empty(), 255)), path_value_current())
  print(path_value_display(raw))
  print(match path_value_to_text(raw) { Ok(text) => text, Error(e) => "invalid UTF-8" })
  print(match path_value_to_text(path("λ")) { Ok(text) => text, Error(e) => "invalid" })
  print(path_value_display(path("line\nend")))
  print(duration_value_ticks(duration_seconds(-2)))
  print(duration_value_ticks(duration_milliseconds(250)))
  print(duration_value_ticks(duration_add(duration_seconds(1), duration_milliseconds(500))))
  print(duration_value_ticks(duration_subtract(duration_value_nanoseconds(1), duration_value_nanoseconds(2))))
  print(duration_value_ticks(duration_scale(duration_seconds(1), -3)))
  print(duration_before(duration_seconds(-1), duration_seconds(0)))
  print(duration_as_seconds(duration_milliseconds(250)))
  print(duration_result(duration_value_from_seconds(3/2)))
  print(duration_result(duration_value_from_seconds(-3/2)))
  print(duration_result(duration_value_from_seconds(1/3)))
  print(duration_result(duration_divide(duration_value_nanoseconds(3), 2)))
  print(duration_result(duration_divide(duration_value_nanoseconds(4), -2)))
  print(duration_result(duration_divide(duration_seconds(1), 0)))
  print(result_value_or(duration_ratio(duration_seconds(3), duration_seconds(2)), 0/1))
  print(duration_value_ticks(duration_seconds(999999999999999999999999999999)))
  print(duration_seconds(2) == duration_milliseconds(2000))
  match instant_value_now() {
    Error(e) => print("clock unavailable"),
    Ok(start) => {
      deadline = instant_value_add(start, duration_seconds(5))
      print(instant_value_before(start, deadline))
      print(duration_value_ticks(instant_value_difference(deadline, start)))
      print(duration_value_ticks(instant_value_difference(start, deadline)))
      print(instant_value_add(deadline, duration_seconds(-5)) == start)
      print(start)
      match instant_value_now() {
        Error(e) => print("clock unavailable"),
        Ok(end) => print(!instant_value_before(end, start))
      }
    }
  }
}
