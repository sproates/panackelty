import stdlib/text as std_text
import stdlib/path as std_path
import stdlib/time as std_time
import stdlib/result as std_result
import stdlib/path::{PathError, PathError.EmptyPath, PathError.PathContainsNul, PathError.PathNotUtf8, PathError.AbsolutePathAppend}
import stdlib/time::{DurationError, DurationError.ZeroDurationDivisor, DurationError.FractionalNanosecond, ClockError}
import stdlib/bytes as byte_buffer
pure path(value: Str): Path { std_result.value_or(std_path.from_text(value), std_path.current()) }
pure path_result(value: Result[Path,PathError]): Str {
  match value {
    Ok(p) => std_path.display(p),
    Error(e) => match e {
      EmptyPath() => "empty", PathContainsNul() => "nul",
      PathNotUtf8() => "utf8", AbsolutePathAppend() => "absolute"
    }
  }
}
pure duration_result(value: Result[Duration,DurationError]): Str {
  match value {
    Ok(d) => { ticks = std_time.ticks(d); "${ticks}ns" },
    Error(e) => match e {
      FractionalNanosecond() => "fractional", ZeroDurationDivisor() => "zero"
    }
  }
}
main(): Void {
  print(path_result(std_path.from_text("")))
  print(path_result(std_path.from_native(byte_buffer.push(byte_buffer.empty(), 0))))
  print(path_result(std_path.join(path("a/../b"), path("./c"))))
  print(path_result(std_path.join(path("a"), path("/b"))))
  print(std_path.display(std_path.directory(path("a/b/"))))
  print(std_path.display(std_path.directory(path("//host"))))
  print(std_path.is_absolute(path("/a")))
  print(path("a") == path("./a"))
  print(path("a") == path("a"))
  print(std_path.native_bytes(path("hello")) == std_text.encode_utf8("hello"))
  print(match std_path.filename(path("/a/b/")) { Some(p) => std_path.display(p), None() => "none" })
  print(match std_path.filename(path("/")) { Some(p) => std_path.display(p), None() => "none" })
  raw = std_result.value_or(std_path.from_native(byte_buffer.push(byte_buffer.empty(), 255)), std_path.current())
  print(std_path.display(raw))
  print(match std_path.to_text(raw) { Ok(text) => text, Error(e) => "invalid UTF-8" })
  print(match std_path.to_text(path("λ")) { Ok(text) => text, Error(e) => "invalid" })
  print(std_path.display(path("line\nend")))
  print(std_time.ticks(std_time.seconds(-2)))
  print(std_time.ticks(std_time.milliseconds(250)))
  print(std_time.ticks(std_time.add(std_time.seconds(1), std_time.milliseconds(500))))
  print(std_time.ticks(std_time.subtract(std_time.from_nanoseconds(1), std_time.from_nanoseconds(2))))
  print(std_time.ticks(std_time.scale(std_time.seconds(1), -3)))
  print(std_time.is_before(std_time.seconds(-1), std_time.seconds(0)))
  print(std_time.as_seconds(std_time.milliseconds(250)))
  print(duration_result(std_time.from_seconds(3/2)))
  print(duration_result(std_time.from_seconds(-3/2)))
  print(duration_result(std_time.from_seconds(1/3)))
  print(duration_result(std_time.divide(std_time.from_nanoseconds(3), 2)))
  print(duration_result(std_time.divide(std_time.from_nanoseconds(4), -2)))
  print(duration_result(std_time.divide(std_time.seconds(1), 0)))
  print(std_result.value_or(std_time.ratio(std_time.seconds(3), std_time.seconds(2)), 0/1))
  print(std_time.ticks(std_time.seconds(999999999999999999999999999999)))
  print(std_time.seconds(2) == std_time.milliseconds(2000))
  match std_time.now() {
    Error(e) => print("clock unavailable"),
    Ok(start) => {
      deadline = std_time.add_instant(start, std_time.seconds(5))
      print(std_time.is_before_instant(start, deadline))
      print(std_time.ticks(std_time.difference(deadline, start)))
      print(std_time.ticks(std_time.difference(start, deadline)))
      print(std_time.add_instant(deadline, std_time.seconds(-5)) == start)
      print(start)
      match std_time.now() {
        Error(e) => print("clock unavailable"),
        Ok(end) => print(!std_time.is_before_instant(end, start))
      }
    }
  }
}
