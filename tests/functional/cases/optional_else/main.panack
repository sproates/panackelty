pure classify(value: Nat): Str {
  if value == 0 {
    "first"
  } else if value == 1 {
    "middle"
  } else if value == 2 {
    "last conditional"
  } else {
    "fallback"
  }
}

condition(label: Str, selected: Bool): Bool {
  print(label)
  selected
}

partial(value: Nat): Void {
  // Different tail types are legal here: all results are discarded.
  if value == 0 {
    print("partial first")
    17
  } else if value == 1 {
    print("partial middle")
    "discarded"
  } else if value == 2 {
    print("partial last")
    true
  }
}

main(): Void {
  mut answer: Nat = 0

  if true {
    answer = 42
  }

  if false {
    answer = 0
  }

  // A value produced by the body is discarded in statement position.
  if true {
    99
  }

  print(answer)
  for value in [0, 1, 2, 3] {
    print(classify(value))
    partial(value)
  }

  if condition("condition 1", false) {
    print("wrong first")
  } else if condition("condition 2", true) {
    print("selected second")
  } else if condition("wrong condition 3", true) {
    print("wrong third")
  } else {
    print("wrong fallback")
  }

  // No final else: no match must leave the stack and mutable state intact.
  if false {
    answer = 0
  } else if false {
    answer = 1
  } else if false {
    answer = 2
  }
  print(answer)

  // A final else binds to this inner chain, without capturing the outer if.
  if true {
    print(if false { 1 } else if true { 2 } else { 3 })
  }
  print("finished")
}
