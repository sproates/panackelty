record Fruit {
  value: Nat
}

record Vegetable {
  value: Nat
}

impl Fruit {
  pure apple(): Nat { self.value }
  pure banana(): Nat { self->apple() + 1 }
  pure plus(amount: Nat): Nat { self.value + amount }
}

impl Vegetable {
  pure apple(): Nat { self.value + 100 }
  pure banana(): Nat { self.value + 200 }
}

pure apple(fruit: Fruit): Nat { fruit.value + 1000 }

pure impl(fruit: Fruit): Nat { fruit.value + 2000 }

make_fruit(): Fruit {
  print("receiver evaluated once")
  Fruit(30)
}

make_amount(): Nat {
  print("argument evaluated after receiver")
  5
}

main(): Void {
  fruit = Fruit(10)
  vegetable = Vegetable(20)
  print(fruit->apple())
  print(fruit->banana())
  print(vegetable->apple())
  print(vegetable->banana())
  print(apple(fruit))
  print(apple(fruit))
  print(impl(fruit))
  print(fruit->plus(5))
  print(make_fruit()->banana())
  print([Fruit(40)][0]->apple())
  print("abc"->len())
  print(make_fruit()->plus(make_amount()))
}
