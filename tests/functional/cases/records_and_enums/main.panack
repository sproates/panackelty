record Pair[A, B] {
  first: A,
  second: B
}

enum Maybe[T] {
  Absent,
  Present(T)
}

pure value_or(value: Maybe[Nat], fallback: Nat): Nat {
  match value {
    Present(found) => found,
    Absent() => fallback
  }
}

main(): Void {
  pair: Pair[Str,Nat] = Pair("answer", 42)
  print(pair.first)
  print(value_or(Present(pair.second), 0))
  print(value_or(Absent(), 7))
}
