import stdlib/text as std_text
import stdlib/environment as std_environment
import stdlib/result as std_result
import stdlib/testing_commands::{TestCommand, ProcessOutput}
import stdlib/testing_commands as std_testing_commands
import stdlib/testing as std_testing
import stdlib/time as std_time
import stdlib/path as std_path
import stdlib/host as std_host
import stdlib/bytes as byte_buffer
import stdlib/filesystem as std_filesystem

pure runner_path(text: Str): Path {
  std_result.value_or(std_path.from_text(text), std_path.current())
}

runner_test_environment(): [Str] {
  mut environment: [Str] = ["PANACKELTY_BOOTSTRAP_ROOT=.", "PANACKELTY_STDLIB_VALUE=ambient-test"]
  match std_environment.get("PANACK_TEST_COMPILER") {
    None() => {},
    Some(compiler) => { environment = append(environment, "PANACK_TEST_COMPILER=${compiler}") }
  }
  environment
}

main(): Void {
  if (std_environment.get("PANACK_COVERAGE_ACTIVE") != None()) && (std_environment.get("PANACK_TEST_RUNNER_REPORT") != None()) {
    std_host.stderr("error: cached runner transcript cannot establish fresh coverage; unset PANACK_TEST_RUNNER_REPORT")
    std_host.exit(1)
  }
  names = ["async_await", "callables", "cli_check_disasm", "cli_commands", "cli_diagnostic_display", "cli_environment_files", "cli_explanations", "cli_rational_failures", "collections", "compiler_lexer", "compiler_skeleton", "core_methods", "guard_fact_refresh", "hello_world",
    "host_capabilities", "host_process", "host_types", "local_inference",
    "modules", "optional_else", "owned_async_handlers", "owned_callbacks", "owned_generic_methods", "owned_imports", "owned_intrinsics", "owned_method_dispatch", "owned_methods",
    "owned_server_map", "owned_server_map_alias", "owned_server_map_facade",
    "owned_server_map_identity", "owned_server_map_namespace", "rational_unit", "records_and_enums",
    "semicolonless", "stdlib", "stdlib_module_api", "string_boundaries", "testing_commands",
    "testing_fixtures", "testing_library",
    "vm_numeric_boundaries"]
  mut expected_text: Str = ""
  for name in names {
    expected_text = "${expected_text}PASS case/${name}/source\nPASS case/${name}/compile\nPASS case/${name}/bytecode\n"
  }
  expected_text = "${expected_text}PASS selected fixture count\n"
  examples = ["callables", "collections_and_bytes", "decimal", "euler001",
    "euler001_iterative", "euler002", "euler003", "euler004", "euler005",
    "fibonacci", "fizzbuzz", "generic_functions", "guards", "lexer_foundation",
    "option_result", "palindrome", "strings", "vm_arithmetic", "vm_branch_call",
    "vm_loop", "public_api", "trip_planner", "twin_sensors"]
  for name in examples {
    expected_text = "${expected_text}PASS example/${name}/source\nPASS example/${name}/compile\nPASS example/${name}/bytecode\n"
  }
  expected_text = "${expected_text}PASS selected example count\n"
  failure_names = ["async_bare", "async_blocking", "callable_effect", "constructor_arity", "core_no_global_method", "core_private_helper",
    "core_text_receiver", "core_type_collision", "duplicate_function",
    "else_if_incompatible", "else_if_missing_body", "else_if_non_bool",
    "else_if_without_else_value",
    "fact_mutation_after_loop", "fact_mutation_arguments", "fact_mutation_direct",
    "fact_mutation_for_carried", "fact_mutation_nested", "fact_mutation_operand",
    "fact_mutation_while_carried", "fact_mutation_while_condition",
    "for_iterable_type", "function_arity", "generic_ambiguous", "generic_body",
    "generic_conflict", "generic_main", "generic_purity", "generic_type_arity",
    "guard_not_proven", "if_without_else_value", "immutable_assignment",
    "import_cycle", "imported_unknown_name", "inference_empty_array",
    "inference_immutable", "inference_impure_callable", "inference_shadowing",
    "inference_type_change", "inference_void", "invalid_import_suffix",
    "invalid_logical_import", "invalid_logical_segment", "legacy_function_keyword",
    "main_parameters", "method_collection_receiver", "missing_import",
    "missing_main", "negative_natural", "non_exhaustive_match", "opaque_path",
    "owned_builtin_array", "owned_builtin_bytes", "owned_builtin_map",
    "owned_builtin_set", "owned_builtin_spoof", "owned_builtin_str",
    "owned_duplicate", "owned_generic_assignment", "owned_generic_duplicate_binder", "owned_generic_method_argument", "owned_generic_no_context", "owned_generic_owner_argument", "owned_generic_self", "owned_generic_shadow", "owned_generic_specialized", "owned_generic_unresolved_method", "owned_generic_unused", "owned_generic_wrong_argument", "owned_import_no_fallback",
    "owned_intrinsic_array_type", "owned_intrinsic_bytes_type", "owned_intrinsic_map_key",
    "owned_intrinsic_numeric_type", "owned_intrinsic_set_type", "owned_intrinsic_text_type",
    "owned_intrinsic_unknown", "owned_no_global_fallback",
    "owned_private_import", "owned_public_private_type", "owned_purity",
    "owned_server_map_duplicate", "owned_server_map_foreign", "owned_server_map_get_arity",
    "owned_server_map_map_arity", "owned_server_map_no_fallback", "owned_server_map_private",
    "owned_server_map_purity", "owned_server_map_put_type", "owned_wrong_argument",
    "pure_clock", "pure_io", "same_line_without_separator",
    "stdlib_legacy_api_removed",
    "trailing_semicolon_value", "unexpected_character", "unknown_name",
    "unknown_type", "while_condition_type"]
  for name in failure_names {
    expected_text = "${expected_text}PASS failure/${name}/check\nPASS failure/${name}/compile\n"
    if name == "unknown_name" || name == "imported_unknown_name" ||
        name == "unexpected_character" || name == "same_line_without_separator" ||
        name == "inference_empty_array" || name == "inference_immutable" ||
        name.starts_with_at("fact_mutation_", 0) {
      expected_text = "${expected_text}PASS failure/${name}/run\nPASS failure/${name}/disasm\n"
    }
    expected_text = "${expected_text}PASS failure/${name}/no artifact\n"
  }
  expected = std_text.encode_utf8("${expected_text}PASS selected failure count\ntests: 523, failures: 0\n")
  command = TestCommand(runner_path("./bin/panack"),
    ["run", "tests/runner/main.panack"], byte_buffer.empty(), std_path.current(),
    runner_test_environment(),
    // This deadline encloses the entire fixture corpus, including nested
    // compiler and package checks; individual commands keep their own bounds.
    std_time.seconds(600), 1048576)
  result = match std_environment.get("PANACK_TEST_RUNNER_REPORT") {
    Some(report_path) => {
      match std_filesystem.read(runner_path(report_path), 1048576) {
        Error(error) => std_testing.expect("Panackelty fixture runner", false,
          "runner report read failed"),
        Ok(actual) => std_testing.expect("Panackelty fixture runner", actual == expected,
          "runner report differed")
      }
    },
    None() => {
      destination = match std_environment.get("PANACK_TEST_CAPTURE_RUNNER_REPORT") {
        Some(file) => Some(runner_path(file)),
        None() => None()
      }
      std_testing_commands.capture_report("Panackelty fixture runner", command,
        ProcessOutput(0, 0, expected, byte_buffer.empty()), destination)
    }
  }
  failures = std_testing.report([result])
  if failures > 0 { std_host.exit(1) }
}
