import "helper.panack"

type Positive = Nat where value > 0

main(): Void {
  answer: Nat = add(
    20,
    22
  )
  checked: Positive = 42
  mut values: [Nat] = [
    answer,
    checked + 1
  ]

  if len(values) == 2 {
    print(values[0])
  }

  for value in values {
    if value > answer {
      print(value)
    }
  }
}
