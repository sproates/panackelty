import "helper.panack" as helper

type AllowedAnswer = Nat where number =>
  (number == 42 || number == 43)
  && number > 0

main(): Void {
  answer: Nat = helper.add(
    20,
    22
  )
  checked: AllowedAnswer = 42
  mut values: [Nat] = [
    answer,
    checked + 1
  ]

  if values.len() == 2 {
    print(values[0])
  }

  for value in values {
    if value > answer {
      print(value)
    }
  }
}
