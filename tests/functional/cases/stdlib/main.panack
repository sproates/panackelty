import stdlib/prelude as prelude

pure describe_option(value: Option[Str]): Str {
  match value {
    Some(text) => text,
    None() => "none"
  }
}

pure describe_result(value: Result[Nat,Str]): Str {
  match value {
    Ok(number) => "ok ${number}",
    Error(message) => message
  }
}

main(): Void {
  print(Some("ready").value_or("none"))
  answer: Result[Nat,Str] = Ok(42)
  print(answer.value_or(0))
  print(describe_option(Some("ready")))
  print(describe_result(Ok(42)))
  print("Panackelty".len())
  print("portable".slice(0, 4))
  print("Aλ🙂".reverse())
  encoded: Bytes = "λ".encode_utf8()
  print(encoded.length())
  print(encoded.push(33).decode_utf8())
  print([1, 2].concat([3]))
  mut names: Set[Str] = set()
  names = names.add("stdlib")
  print(names.has("stdlib"))
  path_value: Path = prelude.path.from_text(".").value_or(prelude.path.current())
  print(path_value.display())
  match prelude.filesystem.metadata(path_value) {
    Ok(metadata) => print(metadata.kind == prelude.filesystem.FileKind.Directory()),
    Error(error) => print(error.code)
  }
  print(describe_option(prelude.environment.get("PANACKELTY_STDLIB_VALUE")))
  output: prelude.process.ProcessOutput = prelude.process.ProcessOutput(0, 0, prelude.byte_buffer.empty(), prelude.byte_buffer.empty())
  print(output.exit_code)
}
