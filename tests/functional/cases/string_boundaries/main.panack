describe(text: Str): Void {
  print(text.len())
  print(text.starts_with_at("", text.len()))
  print(text.slice(0, text.len()) == text)
  mut rebuilt: Str = ""
  for index in 0..text.len() {
    rebuilt = rebuilt + text[index]
  }
  print(rebuilt)
}

main(): Void {
  ascii: Str = "abc"
  unicode: Str = "Aλ中🙂é"
  describe(ascii)
  describe(unicode)
  describe("")
  print((ascii + "λ🙂").len())
  interpolated: Str = "${ascii}${unicode}"
  print(interpolated.len())
  print(unicode.reverse().len())
  print(unicode.encode_utf8().decode_utf8().len())
  print(unicode.slice(1, 4))
  print(ascii.slice(3, 3) == "")
  print(unicode.slice(6, 6) == "")
  print(unicode.starts_with_at("🙂", 3))
  print(unicode.starts_with_at("", 7))
  print(ascii.starts_with_at("", 4))
  print(ascii.starts_with_at("", 999999999999999999999999999999))
  nul: Str = bytes().push(0).decode_utf8()
  print(nul.len())
  print(nul[0] == nul)
  print(("a" + nul).slice(1, 2) == nul)
}
