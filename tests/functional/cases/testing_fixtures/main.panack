import stdlib/testing_files as std_testing_files
import stdlib/testing_files::{HostError}
import stdlib/path as std_path
import stdlib/filesystem as std_filesystem
pure path(text: Str): Path {
  std_path.from_text(text).value_or(std_path.current())
}

pure child(parent: Path, name: Str): Path {
  parent.join(path(name)).value_or(parent)
}

pure outcome(result: Result[Unit,HostError]): Str {
  match result { Ok(value) => "ok", Error(error) => error.code }
}

main(): Void {
  match std_testing_files.workspace_create(path("/tmp")) {
    Error(error) => { code = error.code; print("create: ${code}") },
    Ok(workspace) => {
      root = workspace.root
      first = child(root, "a")
      last = child(root, "z")
      file = child(root, "readme")
      print(outcome(std_filesystem.create_directory(last)))
      print(outcome(std_filesystem.create_directory(first)))
      print(outcome(std_filesystem.write(file, "fixture data".encode_utf8())))
      match std_testing_files.discover_fixtures(root) {
        Error(error) => { code = error.code; print("discover: ${code}") },
        Ok(fixtures) => {
          for fixture in fixtures {
            name = match fixture.filename() {
              Some(value) => value,
              None() => fixture
            }
            print(name.display())
          }
          count = fixtures.len()
          print("found ${count}")
        }
      }
      match workspace.remove_empty() {
        Error(error) => { code = error.code; print("nonempty: ${code}") },
        Ok(value) => { print("unexpected empty") }
      }
      print(outcome(std_filesystem.remove_file(file)))
      print(outcome(std_filesystem.remove_directory(first)))
      print(outcome(std_filesystem.remove_directory(last)))
      print(outcome(workspace.remove_empty()))
    }
  }
}
