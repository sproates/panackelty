import stdlib/testing::{TestResult, test_expect, test_equal_str, test_equal_nat, test_report}
main(): Void {
  results: [TestResult] = [
    test_expect("condition", true, "unexpected false"),
    test_equal_nat("number", 2, 3),
    test_equal_str("text", "hello", "hello")
  ]
  failures = test_report(results)
  print("returned ${failures}")
}
