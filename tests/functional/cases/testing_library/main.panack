import stdlib/testing as std_testing
import stdlib/testing::{TestResult}
main(): Void {
  results: [TestResult] = [
    std_testing.expect("condition", true, "unexpected false"),
    std_testing.equal_nat("number", 2, 3),
    std_testing.equal_str("text", "hello", "hello")
  ]
  failures = std_testing.report(results)
  print("returned ${failures}")
}
