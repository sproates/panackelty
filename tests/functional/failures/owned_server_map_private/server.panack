pub record Server {
  id: Nat,
  routes: Map[Str, Nat]
}

impl Server {
  pub pure get(route: Str, fallback: Nat): Nat {
    if self.routes.has(route) {
      self.routes.get(route)
    } else {
      self.id + fallback
    }
  }

  pure put(route: Str, amount: Nat): Server {
    Server(self.id, self.routes.put(route, self.id + amount))
  }
}
