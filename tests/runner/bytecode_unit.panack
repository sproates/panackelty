import "../../src/bytecode/decoder.panack"
import stdlib/testing

pure bytecode_nibble(character: Str): Nat {
  digits: Str = "0123456789abcdef"
  mut result: Nat = 0
  for index in 0..16 { if digits[index] == character { result = index } }
  result
}
pure bytecode_from_hex(value: Str): Bytes {
  mut output = bytes()
  mut high: Nat = 0
  mut half = false
  for index in 0..len(value) {
    character = value[index]
    if !is_whitespace(character) {
      digit = bytecode_nibble(character)
      if !half { high = digit; half = true }
      else { output = byte_append(output, high * 16 + digit); half = false }
    }
  }
  output
}
pure bytecode_contains(actual: Str, expected: Str): Bool {
  mut found = false
  for index in 0..len(actual) { if starts_with_at(actual, expected, index) { found = true } }
  found
}
bytecode_case(name: Str, file: Str, expected: Str): TestResult {
  data = bytecode_from_hex(read_file(file))
  actual = validate_bytecode(data)
  test_expect(name, actual != "ok" && bytecode_contains(actual, expected),
    "expected ${expected}, got ${actual}")
}
