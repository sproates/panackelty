import "../../src/compiler/checker.panack"
import stdlib/testing

// Shared source fixtures preserve independently recorded acceptance expectations.
// Diagnostics retain the original substring assertions; successful cases must
// explicitly return ok, rather than merely agree with the other implementation.
pure checker_unit_contains(actual: Str, expected: Str): Bool {
  mut found = false
  for offset in 0..len(actual) {
    if starts_with_at(actual, expected, offset) { found = true }
  }
  found
}

pure checker_unit_compare(name: Str, actual: Str, expected: Str): TestResult {
  if expected == "ok" { test_equal_str(name, actual, expected) } else {
    test_expect(name, actual != "ok" && checker_unit_contains(actual, expected),
      "expected diagnostic ${expected}, got ${actual}")
  }
}

checker_unit_source(name: Str, expected: Str): TestResult {
  filename = "tests/fixtures/compiler_checker/${name}.panack"
  // Use the compiler loader's file primitive; missing inputs trap and fail the suite.
  checker_unit_compare(name, check_source_types(read_file(filename)), expected)
}

main(): Void {
  mut results: [TestResult] = []
  // Former test_accepts_core_types_records_enums_and_control_flow
  results = results.append(checker_unit_source("accepts_core_types_records_enums_and_control_flow-1", "ok"))
  // Former test_accepts_if_without_else_in_void_position
  results = results.append(checker_unit_source("accepts_if_without_else_in_void_position-1", "ok"))
  // Former test_checks_callable_values_and_functional_array_methods
  results = results.append(checker_unit_source("checks_callable_values_and_functional_array_methods-1", "ok"))
  results = results.append(checker_unit_source("checks_callable_values_and_functional_array_methods-2", "map callback must accept Nat"))
  // Former test_checks_calls_fields_and_constructor_inference
  results = results.append(checker_unit_source("checks_calls_fields_and_constructor_inference-1", "ok"))
  results = results.append(checker_unit_source("checks_calls_fields_and_constructor_inference-2", "Pair expects 2 arguments, got 1"))
  results = results.append(checker_unit_source("checks_calls_fields_and_constructor_inference-3", "record Pair has no field missing"))
  // Former test_checks_guarded_literals_and_control_flow_facts
  results = results.append(checker_unit_source("checks_guarded_literals_and_control_flow_facts-1", "ok"))
  results = results.append(checker_unit_source("checks_guarded_literals_and_control_flow_facts-2", "guard is not proven"))
  results = results.append(checker_unit_source("checks_guarded_literals_and_control_flow_facts-3", "ok"))
  results = results.append(checker_unit_source("checks_guarded_literals_and_control_flow_facts-4", "ok"))
  // Former test_checks_match_exhaustiveness_payloads_and_branch_types
  results = results.append(checker_unit_source("checks_match_exhaustiveness_payloads_and_branch_types-1", "non-exhaustive match; missing None"))
  results = results.append(checker_unit_source("checks_match_exhaustiveness_payloads_and_branch_types-2", "pattern Some expects 1 bindings"))
  results = results.append(checker_unit_source("checks_match_exhaustiveness_payloads_and_branch_types-3", "branches have incompatible types Nat and Str"))
  results = results.append(checker_unit_source("checks_match_exhaustiveness_payloads_and_branch_types-4", "function bad returns Void, expected Nat"))
  // Former test_checks_method_calls_as_receiver_first_calls
  results = results.append(checker_unit_source("checks_method_calls_as_receiver_first_calls-1", "ok"))
  results = results.append(checker_unit_source("checks_method_calls_as_receiver_first_calls-2", "argument 1 to starts_with is Nat, expected Str"))
  results = results.append(checker_unit_source("checks_method_calls_as_receiver_first_calls-3", "unknown function value"))
  results = results.append(checker_unit_source("checks_method_calls_as_receiver_first_calls-4", "has expects a Map or Set, got Array[Nat]"))
  // Former test_checks_mutability_and_entry_point
  results = results.append(checker_unit_source("checks_mutability_and_entry_point-1", "cannot assign to immutable local value"))
  results = results.append(checker_unit_source("checks_mutability_and_entry_point-2", "program has no main function"))
  results = results.append(checker_unit_source("checks_mutability_and_entry_point-3", "main cannot take parameters"))
  // Former test_checks_operators_arrays_indexing_and_loops
  results = results.append(checker_unit_source("checks_operators_arrays_indexing_and_loops-1", "operator + does not accept Str and Nat"))
  results = results.append(checker_unit_source("checks_operators_arrays_indexing_and_loops-2", "index must be Nat, got Str"))
  results = results.append(checker_unit_source("checks_operators_arrays_indexing_and_loops-3", "for requires a Range or array, got Bool"))
  results = results.append(checker_unit_source("checks_operators_arrays_indexing_and_loops-4", "while condition must be Bool"))
  // Former test_checks_persistent_collections_and_builtin_arguments
  results = results.append(checker_unit_source("checks_persistent_collections_and_builtin_arguments-1", "ok"))
  results = results.append(checker_unit_source("checks_persistent_collections_and_builtin_arguments-2", "expected Nat"))
  // Former test_checks_type_references_and_function_returns
  results = results.append(checker_unit_source("checks_type_references_and_function_returns-1", "unknown type Missing"))
  results = results.append(checker_unit_source("checks_type_references_and_function_returns-2", "function bad returns Bool, expected Nat"))
  results = results.append(checker_unit_source("checks_type_references_and_function_returns-3", "Box expects 1 type arguments, got 0"))
  // Former test_checks_types_across_loaded_modules
  results = results.append(checker_unit_compare("checks_types_across_loaded_modules-1",
    check_loaded_source_types([
      LoadedSource("main.panack", "import \"model.panack\"; main(): Void { item: Box = Box(42); print(item.value); }"),
      LoadedSource("model.panack", "record Box { value: Nat }")
    ], "main.panack"), "ok"))
  results = results.append(checker_unit_compare("checks_types_across_loaded_modules-2",
    check_loaded_source_types([
      LoadedSource("main.panack", "import \"model.panack\"; main(): Void { item: Box = Box(\"bad\"); }"),
      LoadedSource("model.panack", "record Box { value: Nat }")
    ], "main.panack"), "argument 1 to Box is Str, expected Nat"))
  results = results.append(checker_unit_compare("checks_types_across_loaded_modules-3",
    check_loaded_source_types([
      LoadedSource("main.panack", "import \"broken.panack\"; main(): Void { broken(); }"),
      LoadedSource("broken.panack", "broken(): Void {\n  invalid: Nat = \"bad\";\n}")
    ], "main.panack"), "broken.panack:2:18: cannot assign Str to Nat; guard is not proven"))
  if test_report(results) > 0 { process_exit(1) }
}
