import project/src/bytecode/codec::{serialize_bytecode}
import project/src/compiler/lexer::{lex}
import project/src/compiler/parser::{parse_program_complete,indexed_program,core_tokens}
import project/src/compiler/checker::{check_source_types,check_loaded_source_types,check_program_types}
import project/src/compiler/resolver::{LoadedSource,render_resolver_diagnostics}
import project/src/compiler/emitter::{compile_program}
import stdlib/filesystem::{filesystem_read_text}
import stdlib/host::{host_run_bytecode, host_exit}
import stdlib/testing::{TestResult, test_expect, test_equal_str, test_report}
// Shared source fixtures preserve independently recorded acceptance expectations.
// Diagnostics retain the original substring assertions; successful cases must
// explicitly return ok, rather than merely agree with the other implementation.
pure checker_unit_contains(actual: Str, expected: Str): Bool {
  mut found = false
  for offset in 0..len(actual) {
    if starts_with_at(actual, expected, offset) { found = true }
  }
  found
}

pure checker_unit_compare(name: Str, actual: Str, expected: Str): TestResult {
  if expected == "ok" { test_equal_str(name, actual, expected) } else {
    test_expect(name, actual != "ok" && checker_unit_contains(actual, expected),
      "expected diagnostic ${expected}, got ${actual}")
  }
}

checker_unit_source(name: Str, expected: Str): TestResult {
  filename = "tests/fixtures/compiler_checker/${name}.panack"
  // Use the compiler loader's file primitive; missing inputs trap and fail the suite.
  checker_unit_compare(name, check_source_types(filesystem_read_text(filename)), expected)
}

checker_sort_contract(source: Str): Str {
  match lex(filesystem_read_text("src/stdlib/core.panack")) {
    Error(errors) => "core lexing failed",
    Ok(tokens) => { match parse_program_complete(core_tokens(tokens)) {
      Error(error) => error.message,
      Ok(core) => { match lex(source) {
        Error(errors) => "test lexing failed",
        Ok(input) => { match parse_program_complete(input) {
          Error(error) => error.message,
          Ok(program) => render_resolver_diagnostics(check_program_types(
            indexed_program(concat(core.declarations, program.declarations))))
        } }
      } }
    } }
  }
}

// A deterministic semantic matrix, not a replay of the invalidation walker.
// Each stale program must be rejected; adding a fresh guard must make the same
// write pattern usable. Accepted programs execute on the VM and independently
// check their numeric result against this small, hand-calculated table.
checker_mutation_matrix(): [TestResult] {
  mut results: [TestResult] = []
  expected_values: [[Nat]] = [[0, 0, 1, 2], [0, 0, 0, 1], [0, 0, 0, 0]]
  for bound_index in 0..3 {
    bound: Nat = bound_index + 1
    start: Nat = bound + 2
    for value in 0..4 {
      writes: [Str] = [
        "n = ${value}",
        "if true { n = ${value} }",
        "for item in 0..2 { n = ${value} }",
        "mut once: Bool = true; while once { n = ${value}; once = false }"
      ]
      mut shape: Nat = 0
      for write in writes {
        label: Str = "mutation-matrix/${bound}/${value}/${shape}"
        prefix: Str = "main(): Void { mut n: Nat = ${start}; if n >= ${bound} { ${write}; "
        stale: Str = prefix + "print(n - ${bound}) } }"
        results = results.append(checker_unit_compare(label + "/stale",
          check_source_types(stale), "Nat subtraction may underflow"))
        expected: Nat = expected_values[bound_index][value]
        fresh: Str = prefix +
          "actual: Nat = if n >= ${bound} { n - ${bound} } else { 0 }; " +
          "if actual != ${expected} { process_exit(1) } } }"
        status: Str = check_source_types(fresh)
        results = results.append(checker_unit_compare(label + "/fresh", status, "ok"))
        if status == "ok" {
          match lex(fresh) {
            Error(errors) => { results = results.append(test_expect(label, false, "lex failed")) },
            Ok(tokens) => { match parse_program_complete(tokens) {
              Error(error) => { results = results.append(test_expect(label, false, error.message)) },
              Ok(program) => { host_run_bytecode(serialize_bytecode(compile_program(program)), []) }
            } }
          }
        }
        shape = shape + 1
      }
    }
  }
  results
}

main(): Void {
  mut results: [TestResult] = []
  results = results.append(checker_unit_compare("core/wrong-text-receiver",
    checker_sort_contract("main(): Void { print(42.ends_with(\"x\")); }"), "expected Str"))
  results = results.append(checker_unit_compare("core/wrong-array-receiver",
    checker_sort_contract("main(): Void { print(42.first()); }"), "argument 1"))
  results = results.append(checker_unit_compare("core/empty-first-needs-type",
    checker_sort_contract("main(): Void { print([].first()); }"), "cannot infer type parameter T"))
  results = results.append(checker_unit_compare("core/empty-first-explicit-type",
    checker_sort_contract("main(): Void { print([].first[Str]()); }"), "ok"))

  // Former test_accepts_core_types_records_enums_and_control_flow
  results = results.append(checker_unit_source("accepts_core_types_records_enums_and_control_flow-1", "ok"))
  // Former test_accepts_if_without_else_in_void_position
  results = results.append(checker_unit_source("accepts_if_without_else_in_void_position-1", "ok"))
  // Former test_checks_callable_values_and_functional_array_methods
  results = results.append(checker_unit_source("checks_callable_values_and_functional_array_methods-1", "ok"))
  results = results.append(checker_unit_source("checks_callable_values_and_functional_array_methods-2", "map callback must accept Nat"))
  // Former test_checks_calls_fields_and_constructor_inference
  results = results.append(checker_unit_source("checks_calls_fields_and_constructor_inference-1", "ok"))
  results = results.append(checker_unit_source("checks_calls_fields_and_constructor_inference-2", "Pair expects 2 arguments, got 1"))
  results = results.append(checker_unit_source("checks_calls_fields_and_constructor_inference-3", "record Pair has no field missing"))
  // Former test_checks_guarded_literals_and_control_flow_facts
  results = results.append(checker_unit_source("checks_guarded_literals_and_control_flow_facts-1", "ok"))
  results = results.append(checker_unit_source("checks_guarded_literals_and_control_flow_facts-2", "guard is not proven"))
  results = results.append(checker_unit_source("checks_guarded_literals_and_control_flow_facts-3", "ok"))
  results = results.append(checker_unit_source("checks_guarded_literals_and_control_flow_facts-4", "ok"))
  // Former test_checks_match_exhaustiveness_payloads_and_branch_types
  results = results.append(checker_unit_source("checks_match_exhaustiveness_payloads_and_branch_types-1", "non-exhaustive match; missing None"))
  results = results.append(checker_unit_source("checks_match_exhaustiveness_payloads_and_branch_types-2", "pattern Some expects 1 bindings"))
  results = results.append(checker_unit_source("checks_match_exhaustiveness_payloads_and_branch_types-3", "branches have incompatible types Nat and Str"))
  results = results.append(checker_unit_source("checks_match_exhaustiveness_payloads_and_branch_types-4", "function bad returns Void, expected Nat"))
  // Former test_checks_method_calls_as_receiver_first_calls
  results = results.append(checker_unit_source("checks_method_calls_as_receiver_first_calls-1", "ok"))
  results = results.append(checker_unit_source("checks_method_calls_as_receiver_first_calls-2", "argument 1 to starts_with is Nat, expected Str"))
  results = results.append(checker_unit_source("checks_method_calls_as_receiver_first_calls-3", "unknown function value"))
  results = results.append(checker_unit_source("checks_method_calls_as_receiver_first_calls-4", "has expects a Map or Set, got Array[Nat]"))
  // Former test_checks_mutability_and_entry_point
  results = results.append(checker_unit_source("checks_mutability_and_entry_point-1", "cannot assign to immutable local value"))
  results = results.append(checker_unit_source("checks_mutability_and_entry_point-2", "program has no main function"))
  results = results.append(checker_unit_source("checks_mutability_and_entry_point-3", "main cannot take parameters"))
  // Former test_checks_operators_arrays_indexing_and_loops
  results = results.append(checker_unit_source("checks_operators_arrays_indexing_and_loops-1", "operator + does not accept Str and Nat"))
  results = results.append(checker_unit_source("checks_operators_arrays_indexing_and_loops-2", "index must be Nat, got Str"))
  results = results.append(checker_unit_source("checks_operators_arrays_indexing_and_loops-3", "for requires a Range or array, got Bool"))
  results = results.append(checker_unit_source("checks_operators_arrays_indexing_and_loops-4", "while condition must be Bool"))
  // Former test_checks_persistent_collections_and_builtin_arguments
  results = results.append(checker_unit_source("checks_persistent_collections_and_builtin_arguments-1", "ok"))
  results = results.append(checker_unit_source("checks_persistent_collections_and_builtin_arguments-2", "expected Nat"))
  // Former test_checks_type_references_and_function_returns
  results = results.append(checker_unit_source("checks_type_references_and_function_returns-1", "unknown type Missing"))
  results = results.append(checker_unit_source("checks_type_references_and_function_returns-2", "function bad returns Bool, expected Nat"))
  results = results.append(checker_unit_source("checks_type_references_and_function_returns-3", "Box expects 1 type arguments, got 0"))
  // Former test_checks_types_across_loaded_modules
  results = results.append(checker_unit_compare("checks_types_across_loaded_modules-1",
    check_loaded_source_types([
      LoadedSource("main.panack", "import \"model.panack\"; main(): Void { item: Box = Box(42); print(item.value); }"),
      LoadedSource("model.panack", "record Box { value: Nat }")
    ], "main.panack"), "ok"))
  results = results.append(checker_unit_compare("checks_types_across_loaded_modules-2",
    check_loaded_source_types([
      LoadedSource("main.panack", "import \"model.panack\"; main(): Void { item: Box = Box(\"bad\"); }"),
      LoadedSource("model.panack", "record Box { value: Nat }")
    ], "main.panack"), "argument 1 to Box is Str, expected Nat"))
  results = results.append(checker_unit_compare("checks_types_across_loaded_modules-3",
    check_loaded_source_types([
      LoadedSource("main.panack", "import \"broken.panack\"; main(): Void { broken(); }"),
      LoadedSource("broken.panack", "broken(): Void {\n  invalid: Nat = \"bad\";\n}")
    ], "main.panack"), "broken.panack:2:18: cannot assign Str to Nat; guard is not proven"))
  results = results.append(checker_unit_compare("sort accepts pure comparator",
    checker_sort_contract("pure less(a: Nat, b: Nat): Bool { a < b } main(): Void { print([2, 1].sort_by(@less)); }"), "ok"))
  results = results.append(checker_unit_compare("sort rejects effectful comparator",
    checker_sort_contract("less(a: Nat, b: Nat): Bool { print(a); a < b } main(): Void { print([2, 1].sort_by(@less)); }"), "expected PureFn"))
  results = results.append(checker_unit_compare("sort rejects nonboolean comparator",
    checker_sort_contract("pure less(a: Nat, b: Nat): Nat { a } main(): Void { print([2, 1].sort_by(@less)); }"), "expected PureFn"))
  results = results.append(checker_unit_source("fact_mutation_direct", "Nat subtraction may underflow"))
  results = results.append(checker_unit_source("fact_mutation_nested", "Nat subtraction may underflow"))
  results = results.append(checker_unit_source("fact_mutation_operand", "Nat subtraction may underflow"))
  results = results.append(checker_unit_source("fact_mutation_arguments", "Nat subtraction may underflow"))
  results = results.append(checker_unit_source("fact_mutation_array", "Nat subtraction may underflow"))
  results = results.append(checker_unit_source("fact_mutation_index", "Nat subtraction may underflow"))
  results = results.append(checker_unit_source("fact_mutation_while_carried", "Nat subtraction may underflow"))
  results = results.append(checker_unit_source("fact_mutation_for_carried", "Nat subtraction may underflow"))
  results = results.append(checker_unit_source("fact_mutation_while_condition", "Nat subtraction may underflow"))
  results = results.append(checker_unit_source("fact_mutation_while_condition_write", "Nat subtraction may underflow"))
  results = results.append(checker_unit_source("fact_mutation_for_iterable_write", "Nat subtraction may underflow"))
  results = results.append(checker_unit_source("fact_mutation_after_loop", "Nat subtraction may underflow"))
  results = results.append(checker_unit_source("fact_mutation_match", "Nat subtraction may underflow"))
  results = results.append(checker_unit_source("fact_mutation_condition", "Nat subtraction may underflow"))
  results = results.append(checker_unit_source("fact_mutation_guarded_assignment", "guard is not proven"))
  results = results.append(checker_unit_source("fact_mutation_guarded_call", "expected Positive"))
  results = results.append(checker_unit_source("fact_mutation_guarded_loop", "guard is not proven"))
  results = results.append(checker_unit_source("fact_mutation_valid", "ok"))
  results = results.append(checker_unit_source("fact_mutation_upper_bound", "guard is not proven"))
  results = results.append(checker_unit_source("fact_mutation_false_branch", "Nat subtraction may underflow"))
  results = results.append(checker_unit_source("fact_mutation_initializer", "Nat subtraction may underflow"))
  results = results.append(checker_unit_source("fact_mutation_short_circuit", "Nat subtraction may underflow"))
  results = results.append(checker_unit_source("fact_mutation_match_subject", "Nat subtraction may underflow"))
  results = results.append(checker_unit_source("fact_mutation_false_refresh", "ok"))
  results = results.append(checker_unit_source("fact_mutation_unrelated_mutable", "ok"))
  results = results.concat(checker_mutation_matrix())
  if test_report(results) > 0 { host_exit(1) }
}
