import "../../src/compiler/driver.panack"
import stdlib/testing

pure contract_contains(actual: Str, expected: Str): Bool {
  mut found = false
  for offset in 0..len(actual) {
    if starts_with_at(actual, expected, offset) { found = true }
  }
  found
}

contract_check(name: Str, expected: Str): TestResult {
  actual = check_source_frontend(read_file("tests/fixtures/compiler_contracts/${name}.panack"))
  if expected == "ok" { test_equal_str(name, actual, expected) } else {
    test_expect(name, actual != "ok" && (expected == "!ok" || contract_contains(actual, expected)),
      "expected ${expected}, got ${actual}")
  }
}

