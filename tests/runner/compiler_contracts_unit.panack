import project/src/compiler/driver
import stdlib/testing

pure contract_contains(actual: Str, expected: Str): Bool {
  mut found = false
  for offset in 0..len(actual) {
    if starts_with_at(actual, expected, offset) { found = true }
  }
  found
}

contract_check(name: Str, expected: Str): TestResult {
  actual = check_source_frontend(read_file("tests/fixtures/compiler_contracts/${name}.panack"))
  if expected == "ok" { test_equal_str(name, actual, expected) } else {
    test_expect(name, actual != "ok" && (expected == "!ok" || contract_contains(actual, expected)),
      "expected ${expected}, got ${actual}")
  }
}

// Independently expected lookup contracts, including unresolved malformed input.
pure indexed_lookup_contracts(): [TestResult] {
  declarations: [TopLevel] = [
    ImportDeclaration("before.panack"),
    TypeDeclaration("Shared", "Nat", BoolExpr(true)),
    RecordDeclaration("Shared", ["R"], [RecordField("first", "R")]),
    EnumDeclaration("Shared", ["E"], [EnumVariant("Repeated", ["E"]), EnumVariant("Kept", [])]),
    FunctionDeclaration("Shared", [], "Nat", true, false, Block([], NoBlockValue()), []),
    TypeDeclaration("Shared", "Int", BoolExpr(false)),
    ImportDeclaration("between.panack"),
    RecordDeclaration("Shared", ["S"], [RecordField("last", "S")]),
    EnumDeclaration("Shared", ["T"], [EnumVariant("Repeated", ["T"]), EnumVariant("Repeated", ["Str"])]),
    FunctionDeclaration("Shared", [FunctionParameter("arg", "Str")], "Bool", false, true, Block([], NoBlockValue()), ["F"])
  ]
  program: Program = indexed_program(declarations)
  guarded: GuardedTypeLookup = guarded_type(program, "Shared")
  record: RecordLookup = record_type(program, "Shared")
  enum_value: EnumLookup = enum_type(program, "Shared")
  function: FunctionLookup = function_type(program, "Shared")
  variant: VariantLookup = variant_type(program, "Repeated")
  kept: VariantLookup = variant_type(program, "Kept")
  mut results: [TestResult] = [
    test_expect("indexed lookup preserves declaration order", program.declarations == declarations, "source order changed"),
    test_expect("indexed type keeps last same-kind declaration", guarded.found && guarded.base == "Int" && guarded.guard == BoolExpr(false), "wrong guarded type"),
    test_expect("indexed record has independent namespace", record.found && record.parameters == ["S"] && record.fields == [RecordField("last", "S")], "wrong record"),
    test_expect("indexed enum keeps complete last declaration", enum_value.found && enum_value.parameters == ["T"] && enum_value.variants == [EnumVariant("Repeated", ["T"]), EnumVariant("Repeated", ["Str"])], "wrong enum"),
    test_expect("indexed function retains signature and effects", function.found && function.parameters == [FunctionParameter("arg", "Str")] && function.return_type == "Bool" && !function.is_pure && function.is_async && function.type_parameters == ["F"], "wrong function"),
    test_expect("indexed variant keeps last duplicate payload", variant.found && variant.enum_name == "Shared" && variant.parameters == ["T"] && variant.payload == ["Str"], "wrong variant"),
    test_expect("indexed variants retain earlier enum-only names", kept.found && kept.parameters == ["E"] && kept.payload == [], "lost earlier variant"),
    test_expect("indexed duplicates still reach resolver", len(collect_symbols(program).diagnostics) > 0, "index hid duplicate declarations")
  ]
  for name in ["", "Missing", "shared", "Repeated"] {
    results = append(results, test_expect("indexed missing declaration/" + name,
      !guarded_type(program, name).found && !record_type(program, name).found &&
      !enum_type(program, name).found && !function_type(program, name).found, "false lookup hit"))
  }
  for name in ["", "Missing", "shared", "Shared"] {
    results = append(results, test_expect("indexed missing variant/" + name, !variant_type(program, name).found, "false variant hit"))
  }
  earlier: Program = indexed_program([EnumDeclaration("Earlier", [], [EnumVariant("V", ["Nat"])])])
  later: Program = indexed_program([EnumDeclaration("Later", ["X"], [EnumVariant("V", ["X"])])])
  merged: Program = append_program_declarations([earlier, indexed_program([]), later])
  merged_variant: VariantLookup = variant_type(merged, "V")
  results = append(results, test_expect("merged module indexes rebuilt", merged_variant.found && merged_variant.enum_name == "Later" && merged_variant.parameters == ["X"] && merged_variant.payload == ["X"] && enum_type(merged, "Earlier").found, "stale module index"))
  results = append(results, test_expect("input module index unchanged", variant_type(earlier, "V").enum_name == "Earlier", "merge mutated input"))
  results = append(results, test_expect("empty indexed program has no match", !record_type(indexed_program([]), "Shared").found && !variant_type(indexed_program([]), "V").found, "empty index matched"))
  results
}

// Boundary assertions for the compiler readability batch. Expected decisions
// are stated directly, including deferral versus a known contradiction.
pure readable_compiler_contracts(): [TestResult] {
  mut results: [TestResult] = []
  results = append(results, test_equal_str("literal escape decoding",
    decode_string_literal("\"a\\n\\r\\t\\b\\f\\q\\\"\\\\z\""), "a\n\r\t\b\fq\"\\z"))
  results = append(results, test_equal_str("literal without escapes",
    decode_string_literal("\"plain\""), "plain"))
  results = append(results, test_equal_str("empty literal",
    decode_string_literal("\"\""), ""))
  results = append(results, test_equal_str("two-byte diagnostic character",
    diagnostic_character("é"), "\\u{e9}"))
  results = append(results, test_equal_str("three-byte diagnostic character",
    diagnostic_character("€"), "\\u{20ac}"))
  results = append(results, test_equal_str("four-byte diagnostic character",
    diagnostic_character("😀"), "\\u{1f600}"))

  module_identity: ModuleIdentity = ModuleIdentity(StandaloneModulePackage(), "readability.panack")
  owner: DeclarationIdentity = DeclarationIdentity(module_identity, "example")
  guarded_identity: DeclarationIdentity = DeclarationIdentity(module_identity, "Positive")
  program: Program = indexed_program([TypeDeclaration("Positive", "Nat", BoolExpr(true))])
  parsed: ParsedModule = ParsedModule(program, [])
  bindings: ModuleBindings = ModuleBindings(module_identity, [], [])
  module: LoadedModule = LoadedModule("readability.panack", parsed, program, bindings)
  context: BodyContext = BodyContext(ModuleBindingGraph([bindings], []), [module], [], owner, [], map())
  natural: SignatureType = SignatureType(SignatureCore("Nat"), [])
  integer: SignatureType = SignatureType(SignatureCore("Int"), [])
  text: SignatureType = SignatureType(SignatureCore("Str"), [])
  void_type: SignatureType = SignatureType(SignatureCore("Void"), [])
  hole: SignatureType = SignatureType(SignatureHole(owner, [], 0), [])
  positive: SignatureType = SignatureType(SignatureNominal(guarded_identity), [])
  pure_callable: SignatureType = SignatureType(SignatureCallable(SignaturePure()), [natural])
  ordinary_callable: SignatureType = SignatureType(SignatureCallable(SignatureOrdinary()), [natural])
  async_callable: SignatureType = SignatureType(SignatureCallable(SignatureAsync()), [natural])

  results = append(results, test_expect("identical types accepted",
    body_compatibility(context, natural, natural) == Some(true), "wrong identity decision"))
  results = append(results, test_expect("Nat widens to Int",
    body_compatibility(context, natural, integer) == Some(true), "widening rejected"))
  results = append(results, test_expect("Int does not narrow to Nat",
    body_compatibility(context, integer, natural) == Some(false), "narrowing accepted"))
  results = append(results, test_expect("hole never stores Void",
    body_compatibility(context, hole, void_type) == Some(false) &&
    body_compatibility(context, void_type, hole) == Some(false), "Void escaped its boundary"))
  results = append(results, test_expect("hole keeps value constraints",
    body_compatibility(context, hole, natural) == Some(true), "value hole rejected"))
  results = append(results, test_expect("guard conversion remains deferred",
    body_compatibility(context, natural, positive) == None() &&
    body_compatibility(context, positive, natural) == None(), "guard proof fabricated"))
  results = append(results, test_expect("pure callable widens to ordinary",
    body_compatibility(context, pure_callable, ordinary_callable) == Some(true), "effect widening rejected"))
  results = append(results, test_expect("ordinary and async do not become pure",
    body_compatibility(context, ordinary_callable, pure_callable) == Some(false) &&
    body_compatibility(context, async_callable, ordinary_callable) == Some(false), "effect coercion accepted"))
  results = append(results, test_expect("callable slots remain exact",
    body_compatibility(context, pure_callable,
      SignatureType(SignatureCallable(SignatureOrdinary()), [integer])) == Some(false), "slot coercion accepted"))
  results = append(results, test_expect("generic arity remains exact",
    body_compatibility(context, SignatureType(SignatureCore("Array"), [natural]),
      SignatureType(SignatureCore("Array"), [])) == Some(false), "arity mismatch accepted"))
  results = append(results, test_expect("nested generic arguments widen",
    body_compatibility(context, SignatureType(SignatureCore("Array"), [natural]),
      SignatureType(SignatureCore("Array"), [integer])) == Some(true), "nested widening rejected"))
  results = append(results, test_expect("known contradiction dominates deferral in either order",
    body_compatibility(context, SignatureType(SignatureCore("Pair"), [natural, natural]),
      SignatureType(SignatureCore("Pair"), [positive, text])) == Some(false) &&
    body_compatibility(context, SignatureType(SignatureCore("Pair"), [natural, natural]),
      SignatureType(SignatureCore("Pair"), [text, positive])) == Some(false), "contradiction hidden"))
  results = append(results, test_expect("deferred generic argument remains deferred",
    body_compatibility(context, SignatureType(SignatureCore("Array"), [natural]),
      SignatureType(SignatureCore("Array"), [positive])) == None(), "deferred proof resolved"))
  results
}

pure else_if_contracts(): [TestResult] {
  mut results: [TestResult] = []
  for source in [
    "pure f(a:Bool,b:Bool):Nat { if a { 1 } else if b { 2 } else { 3 } }",
    "pure f(a:Bool,b:Bool):Void { if a { 1 } else if b { \"discard\" } }",
    "pure f(n:Nat):Nat { if n >= 3 { n - 3 } else if n >= 2 { n - 2 } else { n } }",
    "async f(a:Bool,b:Bool):Nat { if a { await number() } else if b { await number() } else { await number() } }"
  ] {
    results = append(results, test_equal_str("else-if accepts/" + source,
      check_source_frontend(source + " async number():Nat { 1 } main():Void {}"), "ok"))
  }
  for case in [
    ["pure f(a:Bool):Nat { if a { 1 } else if 7 { 2 } else { 3 } }", "if condition must be Bool"],
    ["pure f(a:Bool,b:Bool):Nat { if a { 1 } else if b { 2 } else { \"bad\" } }", "branches have incompatible types"],
    ["pure f(a:Bool,b:Bool):Nat { if a { 1 } else if b { 2 } }", "returns Void, expected Nat"],
    ["pure f(a:Bool,b:Bool):Void { value = if a { 1 } else if b { 2 }; }", "Void"],
    ["pure f(a:Bool,b:Bool):Void { if a {} else if b { print(2) } }", "pure function cannot call impure function print"],
    ["pure f(a:Bool,b:Bool):Void { if a {} else if b { await number() } }", "await"],
    ["pure f(a:Bool,b:Bool):Nat { if a { 1 } else { if b { 2 } } }", "branches have incompatible types"]
  ] {
    actual: Str = check_source_frontend(case[0] + " async number():Nat { 1 } main():Void {}")
    results = append(results, test_expect("else-if rejects/" + case[0],
      actual != "ok" && contract_contains(actual, case[1]), "wrong rejection: " + actual))
  }
  results
}

