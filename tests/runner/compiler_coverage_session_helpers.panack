import project/src/compiler/path_support as path_support
import stdlib/text as std_text
import stdlib/path as std_path
import stdlib/filesystem as std_filesystem
import stdlib/option as std_option
import stdlib/process as std_process
import stdlib/result as std_result
pub import stdlib/testing_commands::{ProcessOutput}
import stdlib/filesystem::{FileKind.Directory}
import stdlib/bytes as byte_buffer
import stdlib/environment as std_environment
import stdlib/host as std_host
import stdlib/time as std_time

pub pure session_path(text: Str): Path { std_result.value_or(std_path.from_text(text), std_path.current()) }
session_environment(base: [Str]): [Str] {
  mut values: [Str] = []
  for variable in base {
    if !starts_with_at(variable, "PANACKELTY_COMPILER_PATH=", 0) && !starts_with_at(variable, "PANACKELTY_STDLIB_PATH=", 0) {
      values = values.append(variable)
    } else {}
  }
  values.append("PANACKELTY_COMPILER_PATH=" + std_option.value_or(std_environment.get("PANACK_TEST_COMPILER"), "")).append("PANACKELTY_STDLIB_PATH=" + std_option.value_or(std_environment.get("PANACKELTY_STDLIB_PATH"), ""))
}
pub session_read(path: Str): Bytes { std_result.value_or(std_filesystem.read(session_path(path), 16777216), bytes()) }
pub session_write(path: Str, data: Bytes): Void {
  parent: Str = path_support.parent(path)
  if parent != "" { std_filesystem.create_directory(session_path(parent)); } else {}
  match std_filesystem.write(session_path(path), data) { Ok(done) => {}, Error(error) => { std_host.stderr("session fixture write failed: " + error.operation + " " + error.code + " " + path); std_host.exit(1); } }
}
pub pure session_contains(text: Str, needle: Str): Bool {
  mut found: Bool = false
  for i in 0..len(text) { if i + len(needle) <= len(text) && slice(text, i, i + len(needle)) == needle { found = true; } }
  found
}
pub session_command(args: [Str]): ProcessOutput { session_command_env(args, []) }
pub session_command_env(args: [Str], environment: [Str]): ProcessOutput {
  mut command: [Str] = []
  if args[0] == "coverage-session" {
    command = args
  } else {
    command = ["run", std_option.value_or(std_environment.get("PANACK_TEST_COMPILER"), "")]
    for argument in args { command = command.append(argument); }
  }
  match std_process.run(session_path("./panack-vm"), command, bytes(), std_path.current(), session_environment(environment), std_time.seconds(90), 1048576) {
    Error(error) => { std_host.stderr("session command failed"); std_host.exit(1); ProcessOutput(1, 0, bytes(), bytes()) }, Ok(result) => result
  }
}
pub session_setup(source: Str, child: Str, artifact: Str, child_bc: Str, inventory: Str, child_inv: Str): [ProcessOutput] {
  session_write(source, std_text.encode_utf8("import stdlib/result as std_result\nimport stdlib/host as std_host\nimport stdlib/filesystem as std_filesystem\nimport stdlib/path as std_path\nimport stdlib/bytes as byte_buffer\nmain(): Void { args = std_host.arguments(); std_host.run(std_result.value_or(std_filesystem.read(std_result.value_or(std_path.from_text(args[0]), std_path.current()), 16777216), byte_buffer.empty()), [args[1]]); }\n"))
  session_write(child, std_text.encode_utf8("import stdlib/host as std_host\npure choose(x: Bool): Nat { if x { 7 } else { 9 } }\npure unused(): Nat { 0 }\nmain(): Void { std_host.stdout(if choose(std_host.arguments()[0] == \"true\") == 7 { \"7\" } else { \"9\" }); }\n"))
  mut outputs: [ProcessOutput] = []
  outputs = append(outputs, session_command(["compile", source, "-o", artifact]))
  outputs = append(outputs, session_command(["compile", child, "-o", child_bc]))
  outputs = append(outputs, session_command(["inventory", source, "-o", inventory]))
  outputs = append(outputs, session_command(["inventory", child, "-o", child_inv]))
  outputs
}
pub session_setup_child(child: Str, child_bc: Str, child_inv: Str): [ProcessOutput] {
  session_write(child, std_text.encode_utf8("import stdlib/host as std_host\npure choose(x: Bool): Nat { if x { 7 } else { 9 } }\npure unused(): Nat { 0 }\nmain(): Void { std_host.stdout(if choose(std_host.arguments()[0] == \"true\") == 7 { \"7\" } else { \"9\" }); }\n"))
  [session_command(["compile", child, "-o", child_bc]), session_command(["inventory", child, "-o", child_inv])]
}
pub session_require_success(outputs: [ProcessOutput]): Void {
  for output in outputs { if output.exit_code != 0 { std_host.stderr("session fixture setup failed: " + std_text.decode_utf8(output.stderr)); std_host.exit(1); } }
}
pub session_clean(path: Str): Void {
  match std_filesystem.list_directory(session_path(path)) {
    Error(error) => {}, Ok(children) => {
      for child in children {
        file: Str = path + "/" + std_result.value_or(std_path.to_text(child), "")
        match std_filesystem.metadata(session_path(file)) {
          Error(error) => {}, Ok(metadata) => {
            if metadata.kind == Directory() { session_clean(file); } else { std_filesystem.remove_file(session_path(file)); }
          }
        }
      }
      std_filesystem.remove_directory(session_path(path));
    }
  }
}
