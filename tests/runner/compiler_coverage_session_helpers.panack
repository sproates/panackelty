import stdlib/result::{result_value_or}
pub import stdlib/testing_commands::{ProcessOutput}
import stdlib/filesystem::{FileKind.Directory,filesystem_read_bytes,filesystem_write_bytes,filesystem_create_directory,filesystem_list_directory,filesystem_metadata,filesystem_remove_file,filesystem_remove_directory}
import stdlib/bytes::{bytes_empty,text_encode_utf8,text_decode_utf8}
import stdlib/path::{path_value_from_text,path_value_current,path_value_to_text,path_string_parent}
import stdlib/environment::{environment_value}
import stdlib/host::{host_process_run,host_stderr_text,host_exit}
import stdlib/time::{duration_seconds}

pub pure session_path(text: Str): Path { result_value_or(path_value_from_text(text), path_value_current()) }
session_environment(base: [Str]): [Str] {
  mut values: [Str] = []
  for variable in base {
    if !starts_with_at(variable, "PANACKELTY_COMPILER_PATH=", 0) && !starts_with_at(variable, "PANACKELTY_STDLIB_PATH=", 0) {
      values = values.append(variable)
    } else {}
  }
  values.append("PANACKELTY_COMPILER_PATH=" + environment_value("PANACK_TEST_COMPILER")).append("PANACKELTY_STDLIB_PATH=" + environment_value("PANACKELTY_STDLIB_PATH"))
}
pub session_read(path: Str): Bytes { result_value_or(filesystem_read_bytes(session_path(path), 16777216), bytes()) }
pub session_write(path: Str, data: Bytes): Void {
  parent: Str = path_string_parent(path)
  if parent != "" { filesystem_create_directory(session_path(parent)); } else {}
  match filesystem_write_bytes(session_path(path), data) { Ok(done) => {}, Error(error) => { host_stderr_text("session fixture write failed: " + error.operation + " " + error.code + " " + path); host_exit(1); } }
}
pub pure session_contains(text: Str, needle: Str): Bool {
  mut found: Bool = false
  for i in 0..len(text) { if i + len(needle) <= len(text) && slice(text, i, i + len(needle)) == needle { found = true; } }
  found
}
pub session_command(args: [Str]): ProcessOutput { session_command_env(args, []) }
pub session_command_env(args: [Str], environment: [Str]): ProcessOutput {
  mut command: [Str] = []
  if args[0] == "coverage-session" {
    command = args
  } else {
    command = ["run", environment_value("PANACK_TEST_COMPILER")]
    for argument in args { command = command.append(argument); }
  }
  match host_process_run(session_path("./panack-vm"), command, bytes(), path_value_current(), session_environment(environment), duration_seconds(90), 1048576) {
    Error(error) => { host_stderr_text("session command failed"); host_exit(1); ProcessOutput(1, 0, bytes(), bytes()) }, Ok(result) => result
  }
}
pub session_setup(source: Str, child: Str, artifact: Str, child_bc: Str, inventory: Str, child_inv: Str): [ProcessOutput] {
  session_write(source, text_encode_utf8("import stdlib/result::{result_value_or}\nimport stdlib/host::{host_command_arguments, host_run_bytecode}\nimport stdlib/filesystem::{filesystem_read_bytes}\nimport stdlib/path::{path_value_from_text, path_value_current}\nimport stdlib/bytes::{bytes_empty}\nmain(): Void { args = host_command_arguments(); host_run_bytecode(result_value_or(filesystem_read_bytes(result_value_or(path_value_from_text(args[0]), path_value_current()), 16777216), bytes_empty()), [args[1]]); }\n"))
  session_write(child, text_encode_utf8("import stdlib/host::{host_command_arguments, host_stdout_text}\npure choose(x: Bool): Nat { if x { 7 } else { 9 } }\npure unused(): Nat { 0 }\nmain(): Void { host_stdout_text(if choose(host_command_arguments()[0] == \"true\") == 7 { \"7\" } else { \"9\" }); }\n"))
  mut outputs: [ProcessOutput] = []
  outputs = append(outputs, session_command(["compile", source, "-o", artifact]))
  outputs = append(outputs, session_command(["compile", child, "-o", child_bc]))
  outputs = append(outputs, session_command(["inventory", source, "-o", inventory]))
  outputs = append(outputs, session_command(["inventory", child, "-o", child_inv]))
  outputs
}
pub session_setup_child(child: Str, child_bc: Str, child_inv: Str): [ProcessOutput] {
  session_write(child, text_encode_utf8("import stdlib/host::{host_command_arguments, host_stdout_text}\npure choose(x: Bool): Nat { if x { 7 } else { 9 } }\npure unused(): Nat { 0 }\nmain(): Void { host_stdout_text(if choose(host_command_arguments()[0] == \"true\") == 7 { \"7\" } else { \"9\" }); }\n"))
  [session_command(["compile", child, "-o", child_bc]), session_command(["inventory", child, "-o", child_inv])]
}
pub session_require_success(outputs: [ProcessOutput]): Void {
  for output in outputs { if output.exit_code != 0 { host_stderr_text("session fixture setup failed: " + text_decode_utf8(output.stderr)); host_exit(1); } }
}
pub session_clean(path: Str): Void {
  match filesystem_list_directory(session_path(path)) {
    Error(error) => {}, Ok(children) => {
      for child in children {
        file: Str = path + "/" + result_value_or(path_value_to_text(child), "")
        match filesystem_metadata(session_path(file)) {
          Error(error) => {}, Ok(metadata) => {
            if metadata.kind == Directory() { session_clean(file); } else { filesystem_remove_file(session_path(file)); }
          }
        }
      }
      filesystem_remove_directory(session_path(path));
    }
  }
}
