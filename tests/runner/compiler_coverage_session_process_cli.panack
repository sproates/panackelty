import stdlib/testing as std_testing
import stdlib/testing_commands::{ProcessOutput}
import stdlib/testing_files as std_testing_files
import stdlib/testing::{TestResult}
import stdlib/bytes as byte_buffer
import stdlib/host as std_host
import project/tests/runner/compiler_coverage_session_helpers::{session_path,session_command,session_command_env,session_setup_child,session_require_success,session_read,session_write,session_contains,session_clean}
main(): Void {
  match std_testing_files.workspace_create(session_path("/tmp")) {
    Error(error) => { std_host.exit(1); }, Ok(workspace) => {
      dir: Str = workspace.root.to_text().value_or("")
      child: Str = dir + "/child.panack"
      child_bc: Str = dir + "/child.bc"
      child_inv: Str = dir + "/child.inv"
      session_require_success(session_setup_child(child, child_bc, child_inv))
      mut results: [TestResult] = []
      // A subprocess must claim a fresh ticket, even when its bytecode is reused.
      process_source: Str = dir + "/process.panack"
      process_bc: Str = dir + "/process.bc"
      process_inv: Str = dir + "/process.inv"
      session_write(process_source, "import stdlib/host as std_host\nimport stdlib/path as std_path\nimport stdlib/bytes as byte_buffer\nimport stdlib/time as std_time\nimport stdlib/process as std_process\nmain(): Void { command = std_host.arguments(); args = if command[0] == \"/bin/sh\" { [\"-c\", \"exit 0\"] } else { [\"run\", command[1], \"true\"] }; match std_process.run(std_path.from_text(command[0]).value_or(std_path.current()), args, byte_buffer.empty(), std_path.current(), [], std_time.seconds(1), 1048576) { Ok(result) => { std_host.stdout(if result.exit_code == 0 { \"0\" } else { \"1\" }); }, Error(error) => { std_host.stdout(\"99\"); } } }\n".encode_utf8())
      for setup in [["compile", process_source, "-o", process_bc], ["inventory", process_source, "-o", process_inv]] {
        result: ProcessOutput = session_command(setup)
        results = results.append(std_testing.expect("process setup", result.exit_code == 0, result.stderr.decode_utf8()))
      }
      process_session: Str = dir + "/process-session"
      process_run_result: ProcessOutput = session_command(["coverage-session", process_session, process_bc, process_inv, child_bc, child_inv, "--", "./bin/panack", child_bc])
      process_report: ProcessOutput = session_command(["coverage-aggregate", "--source", process_source, process_inv, "--source", child, child_inv, "--session", process_session])
      results = results.append(std_testing.expect("subprocess aggregate", process_run_result.stdout == "0\n".encode_utf8() && process_report.exit_code == 0 && session_contains(process_report.stdout.decode_utf8(), "executions=2"), process_run_result.stderr.decode_utf8() + process_report.stderr.decode_utf8()))
      external_session: Str = dir + "/external-session"
      external: ProcessOutput = session_command(["coverage-session", external_session, process_bc, process_inv, child_bc, child_inv, "--", "/bin/sh", child_bc])
      external_report: ProcessOutput = session_command(["coverage-aggregate", "--source", process_source, process_inv, "--source", child, child_inv, "--session", external_session])
      results = results.append(std_testing.expect("noncollecting process executes successfully", external.exit_code == 0 && external.stdout == "0\n".encode_utf8() && external.stderr == byte_buffer.empty(), "external stdout: " + external.stdout.decode_utf8() + " stderr: " + external.stderr.decode_utf8()))
      results = results.append(std_testing.expect("noncollecting process stays unavailable", external_report.exit_code == 1 && external_report.stdout == byte_buffer.empty(), "report stdout: " + external_report.stdout.decode_utf8() + " stderr: " + external_report.stderr.decode_utf8()))
      killed_source: Str = dir + "/killed.panack"
      killed_bc: Str = dir + "/killed.bc"
      killed_inv: Str = dir + "/killed.inv"
      session_write(killed_source, "main(): Void { while true {} }\n".encode_utf8())
      for setup in [["compile", killed_source, "-o", killed_bc], ["inventory", killed_source, "-o", killed_inv]] {
        result: ProcessOutput = session_command(setup)
        results = results.append(std_testing.expect("killed child setup", result.exit_code == 0, result.stderr.decode_utf8()))
      }
      killed_session: Str = dir + "/killed-session"
      killed: ProcessOutput = session_command(["coverage-session", killed_session, process_bc, process_inv, killed_bc, killed_inv, "--", "./bin/panack", killed_bc])
      killed_report: ProcessOutput = session_command(["coverage-aggregate", "--source", process_source, process_inv, "--source", killed_source, killed_inv, "--session", killed_session])
      results = results.append(std_testing.expect("claimed collector killed by timeout stays partial", killed.stdout == "99\n".encode_utf8() &&
        session_read(killed_session + "/claim-0.1") == "claimed\n".encode_utf8() && killed_report.exit_code == 1 && killed_report.stdout == byte_buffer.empty(), "killed collector accepted"))
      trap_source: Str = dir + "/trap.panack"
      trap_bc: Str = dir + "/trap.bc"
      trap_inv: Str = dir + "/trap.inv"
      session_write(trap_source, "main(): Void { print([1][2]); }\n".encode_utf8())
      for setup in [["compile", trap_source, "-o", trap_bc], ["inventory", trap_source, "-o", trap_inv]] {
        result: ProcessOutput = session_command(setup)
        results = results.append(std_testing.expect("trap setup", result.exit_code == 0, result.stderr.decode_utf8()))
      }
      trapped: ProcessOutput = session_command(["coverage-session", dir + "/trapped", trap_bc, trap_inv, "--"])
      trap_report: ProcessOutput = session_command(["coverage-aggregate", "--source", trap_source, trap_inv, "--session", dir + "/trapped"])
      results = results.append(std_testing.expect("terminal trap preserves attempted prefix", trapped.exit_code == 1 && trap_report.exit_code == 0 &&
        session_contains(trap_report.stdout.decode_utf8(), "declaration/0\tfunction\tmain\tobserved\t1\t0\n"), trapped.stderr.decode_utf8()))
      smoke: Str = "tests/functional/cases/runner_smoke/main.panack"
      smoke_bc: Str = dir + "/smoke.bc"
      smoke_inv: Str = dir + "/smoke.inv"
      for setup in [["compile", smoke, "-o", smoke_bc], ["inventory", smoke, "-o", smoke_inv]] {
        result: ProcessOutput = session_command_env(setup, ["PANACKELTY_BOOTSTRAP_ROOT=."])
        results = results.append(std_testing.expect("cache guard setup", result.exit_code == 0, result.stderr.decode_utf8()))
      }
      cached: ProcessOutput = session_command_env(["coverage-session", dir + "/cached", smoke_bc, smoke_inv, "--"],
        ["PANACKELTY_BOOTSTRAP_ROOT=.", "PANACK_TEST_RUNNER_REPORT=" + dir + "/absent-transcript"])
      cached_report: ProcessOutput = session_command_env(["coverage-aggregate", "--source", smoke, smoke_inv, "--session", dir + "/cached"],
        ["PANACKELTY_BOOTSTRAP_ROOT=."])
      results = results.append(std_testing.expect("cached transcript cannot invent fresh execution", cached.exit_code == 1 &&
        session_contains(cached.stderr.decode_utf8(), "cached runner transcript cannot establish fresh coverage") &&
        cached_report.exit_code == 1 && cached_report.stdout == byte_buffer.empty(), "cache bypassed collection"))
      isolated_source: Str = dir + "/isolated.panack"
      isolated_bc: Str = dir + "/isolated.bc"
      isolated_inv: Str = dir + "/isolated.inv"
      session_write(isolated_source, "import stdlib/process as process\nimport stdlib/path as path\nimport stdlib/time as time\nimport stdlib/bytes as byte_buffer\nmain(): Void { executable = path.from_text(\"/usr/bin/env\").value_or(path.current()); match process.run_isolated(executable, [], byte_buffer.empty(), path.current(), [\"ONLY=explicit\"], time.seconds(3), 1024) { Error(problem) => print(problem.code), Ok(output) => print(output.stdout == \"ONLY=explicit\\n\".encode_utf8()) } }\n".encode_utf8())
      for setup in [["compile", isolated_source, "-o", isolated_bc], ["inventory", isolated_source, "-o", isolated_inv]] {
        result: ProcessOutput = session_command(setup)
        results = results.append(std_testing.expect("isolated process setup", result.exit_code == 0, result.stderr.decode_utf8()))
      }
      isolated_session: Str = dir + "/isolated-session"
      isolated_run: ProcessOutput = session_command(["coverage-session", isolated_session, isolated_bc, isolated_inv, "--"])
      isolated_report: ProcessOutput = session_command(["coverage-aggregate", "--source", isolated_source, isolated_inv, "--session", isolated_session])
      results = results.append(std_testing.expect("coverage cannot inject an isolated environment", isolated_run.exit_code == 0 && isolated_run.stdout == "true\n".encode_utf8(), isolated_run.stderr.decode_utf8()))
      results = results.append(std_testing.expect("isolated child is explicitly unobserved", isolated_report.exit_code == 1 && isolated_report.stdout == byte_buffer.empty(), isolated_report.stderr.decode_utf8()))
      session_clean(dir)
      if std_testing.report(results) > 0 { std_host.exit(1); }
    }
  }
}
