import stdlib/result
import stdlib/testing
import stdlib/testing_files
import stdlib/testing_commands
import stdlib/environment
import stdlib/process

pure path(text: Str): Path {
  result_value_or(path_from_text(text), path_current())
}

pure child(root: Path, name: Str): Path {
  result_value_or(path_append(root, path(name)), root)
}

pure command(arguments: [Str], timeout: Nat): TestCommand {
  TestCommand(path("./panack"), arguments, bytes(), path_current(), [],
    duration_seconds(timeout), 1048576)
}

pure compiler_command(compiler: Str, arguments: [Str]): TestCommand {
  command(["run", compiler].concat(arguments), 30)
}

pure compiler_driver_contains(text: Str, expected: Str): Bool {
  mut found: Bool = false
  for offset in 0..len(text) {
    found = found || starts_with_at(text, expected, offset)
  }
  found
}

namespace_source_load_rejection(
  compiler: Str,
  operation: Str,
  source: Str,
  output_path: Str,
  expected: Str
): TestResult {
  name: Str = "namespace source loading rejects ${operation}"
  mut arguments: [Str] = ["run", compiler, operation, source]
  if operation == "compile" {
    arguments = concat(arguments, ["-o", output_path])
  } else {}
  match process_run(
    path("./panack"),
    arguments,
    bytes(),
    path_current(),
    [],
    duration_seconds(30),
    1048576
  ) {
    Error(error) => test_expect(name, false, "compiler process failed"),
    Ok(output) => test_expect(
      name,
      output.exit_code == 1 && output.signal == 0 && output.stdout == bytes() &&
        compiler_driver_contains(utf8_decode(output.stderr), expected),
      utf8_decode(output.stderr)
    )
  }
}

namespace_bootstrap_root_rejection(
  compiler: Str,
  operation: Str,
  source: Str,
  output_path: Str,
  expected: Str,
  environment: [Str]
): TestResult {
  mut arguments: [Str] = ["run", compiler, operation, source]
  if operation == "compile" {
    arguments = concat(arguments, ["-o", output_path])
  } else {}
  match process_run(
    path("./panack"),
    arguments,
    bytes(),
    path_current(),
    environment,
    duration_seconds(30),
    1048576
  ) {
    Error(error) => test_expect("bootstrap-root ${operation} rejection", false, "compiler process failed"),
    Ok(output) => test_expect(
      "bootstrap-root ${operation} rejection",
      output.exit_code == 1 && output.signal == 0 && output.stdout == bytes() &&
        compiler_driver_contains(utf8_decode(output.stderr), expected),
      utf8_decode(output.stderr)
  )
}
}

namespace_bootstrap_root_command(
  name: Str,
  compiler: Str,
  arguments: [Str],
  expected: ProcessOutput,
  environment: [Str]
): TestResult {
  match process_run(
    path("./panack"),
    concat(["run", compiler], arguments),
    bytes(),
    path_current(),
    environment,
    duration_seconds(30),
    1048576
  ) {
    Error(error) => test_expect(name, false, "compiler process failed"),
    Ok(output) => test_expect(
      name,
      output.exit_code == expected.exit_code && output.signal == expected.signal &&
        output.stdout == expected.stdout && output.stderr == expected.stderr,
      utf8_decode(output.stderr)
    )
  }
}

main(): Void {
  match test_workspace_create(path("/tmp")) {
    Error(error) => { print("workspace creation failed"); process_exit(1) },
    Ok(workspace) => {
      own_compiler = child(workspace.root, "compiler.bc")
      own_compiler_text = result_value_or(path_to_text(own_compiler), "invalid-compiler")
      compiler = match environment("PANACK_TEST_COMPILER") {
        Some(value) => value,
        None() => own_compiler_text
      }
      source = "tests/functional/cases/hello_world/main.panack"
      namespace_source = "tests/fixtures/compiler_contracts/namespaces/emission/main.panack"
      namespace_async_source = "tests/fixtures/compiler_contracts/namespaces/emission/async_helpers.panack"
      self_hosted = child(workspace.root, "self-hosted.bc")
      bootstrap = child(workspace.root, "bootstrap.bc")
      namespace_artifact = child(workspace.root, "namespace.bc")
      namespace_async_artifact = child(workspace.root, "namespace-async.bc")
      self_hosted_text = result_value_or(path_to_text(self_hosted), "invalid-self-hosted")
      bootstrap_text = result_value_or(path_to_text(bootstrap), "invalid-bootstrap")
      namespace_artifact_text = result_value_or(path_to_text(namespace_artifact), "invalid-namespace-artifact")
      namespace_async_artifact_text = result_value_or(path_to_text(namespace_async_artifact), "invalid-namespace-async-artifact")
      mut results: [TestResult] = []
      match environment("PANACK_TEST_COMPILER") {
        Some(cached) => {},
        None() => {
          results = results.append(test_run_command("compile compiler",
            command(["compile", "src/compiler/main.panack", "-o", compiler], 90),
            ProcessOutput(0, 0, utf8_encode("wrote ${compiler}\n"), bytes())))
        }
      }
      results = results.append(test_run_command("verify compiler artifact",
        command(["check", compiler], 30), ProcessOutput(0, 0, utf8_encode("ok\n"), bytes())))
      results = results.append(test_run_command("self-hosted check",
        compiler_command(compiler, ["check", source]),
        ProcessOutput(0, 0, utf8_encode("ok\n"), bytes())))
      results = results.append(test_run_command("self-hosted run",
        compiler_command(compiler, ["run", source]),
        ProcessOutput(0, 0, utf8_encode("hello world\n"), bytes())))
      match environment("PANACK_TEST_NAMESPACE_EMISSION") {
        Some(enabled) => {
          results = results.append(test_run_command("namespace identity check",
            compiler_command(compiler, ["check", namespace_source]),
            ProcessOutput(0, 0, utf8_encode("ok\n"), bytes())))
          results = results.append(test_run_command("namespace identity source execution",
            compiler_command(compiler, ["run", namespace_source]),
            ProcessOutput(0, 0, utf8_encode("41\n42\n43\n44\n41\n42\n44\n45\n51\n52\n"), bytes())))
          results = results.append(test_run_command("namespace identity compile",
            compiler_command(compiler, ["compile", namespace_source, "-o", namespace_artifact_text]),
            ProcessOutput(0, 0, utf8_encode("wrote ${namespace_artifact_text}\n"), bytes())))
          results = results.append(test_run_command("namespace saved bytecode execution",
            compiler_command(compiler, ["run", namespace_artifact_text]),
            ProcessOutput(0, 0, utf8_encode("41\n42\n43\n44\n41\n42\n44\n45\n51\n52\n"), bytes())))
          results = results.append(test_run_command("namespace proof and effect check",
            compiler_command(compiler, ["check", namespace_async_source]),
            ProcessOutput(0, 0, utf8_encode("ok\n"), bytes())))
          results = results.append(test_run_command("namespace proof and effect source execution",
            compiler_command(compiler, ["run", namespace_async_source]),
            ProcessOutput(0, 0, bytes(), bytes())))
          results = results.append(test_run_command("namespace proof and effect compile",
            compiler_command(compiler, ["compile", namespace_async_source, "-o", namespace_async_artifact_text]),
            ProcessOutput(0, 0, utf8_encode("wrote ${namespace_async_artifact_text}\n"), bytes())))
          results = results.append(test_run_command("namespace proof and effect saved bytecode execution",
            compiler_command(compiler, ["run", namespace_async_artifact_text]),
            ProcessOutput(0, 0, bytes(), bytes())))

          // Compile an isolated multi-module program, remove every source
          // file, then validate and execute only the saved artifact.
          standalone_root = child(workspace.root, "standalone-project")
          standalone_left = child(standalone_root, "left.panack")
          standalone_right = child(standalone_root, "right.panack")
          standalone_main = child(standalone_root, "main.panack")
          standalone_artifact = child(workspace.root, "standalone.bc")
          standalone_left_text = result_value_or(path_to_text(standalone_left), "invalid-standalone-left")
          standalone_right_text = result_value_or(path_to_text(standalone_right), "invalid-standalone-right")
          standalone_main_text = result_value_or(path_to_text(standalone_main), "invalid-standalone-main")
          standalone_artifact_text = result_value_or(path_to_text(standalone_artifact), "invalid-standalone-artifact")
          fs_create_directory(standalone_root)
          left_write = fs_write(standalone_left, utf8_encode(
            "pub pure answer(): Nat { 11 }\nmain(): Void { print(991) }\n"))
          right_write = fs_write(standalone_right, utf8_encode(
            "pub pure answer(): Nat { 22 }\nmain(): Void { print(992) }\n"))
          main_write = fs_write(standalone_main, utf8_encode(
            "import \"left.panack\" as left\nimport \"right.panack\" as right\nmain(): Void {\n  print(left.answer())\n  print(right.answer())\n}\n"))
          results = append(results, test_expect(
            "standalone bytecode fixture setup",
            match left_write { Ok(written) => true, Error(error) => false } &&
              match right_write { Ok(written) => true, Error(error) => false } &&
              match main_write { Ok(written) => true, Error(error) => false },
            "source fixture write failed"
          ))
          results = append(results, test_run_command("standalone namespace source compile",
            compiler_command(compiler, ["compile", standalone_main_text, "-o", standalone_artifact_text]),
            ProcessOutput(0, 0, utf8_encode("wrote ${standalone_artifact_text}\n"), bytes())))
          for file in [standalone_main, standalone_left, standalone_right] {
            match fs_remove_file(file) {
              Ok(removed) => {},
              Error(error) => { results = append(results, test_expect(
                "standalone bytecode source removal", false, "source file removal failed")) }
            }
          }
          results = append(results, test_expect(
            "standalone bytecode sources are absent",
            !file_exists(standalone_main_text) && !file_exists(standalone_left_text) &&
              !file_exists(standalone_right_text),
            "source files remained after compilation"
          ))
          results = append(results, test_run_command("standalone saved bytecode validation without sources",
            compiler_command(compiler, ["check", standalone_artifact_text]),
            ProcessOutput(0, 0, utf8_encode("ok\n"), bytes())))
          results = append(results, test_run_command("standalone saved bytecode execution without sources",
            compiler_command(compiler, ["run", standalone_artifact_text]),
            ProcessOutput(0, 0, utf8_encode("11\n22\n"), bytes())))
          match fs_remove_file(standalone_artifact) {
            Ok(removed) => {},
            Error(error) => { results = append(results, test_expect(
              "standalone bytecode artifact cleanup", false, "artifact removal failed")) }
          }
          match fs_remove_directory(standalone_root) {
            Ok(removed) => {},
            Error(error) => { results = append(results, test_expect(
              "standalone bytecode directory cleanup", false, "directory removal failed")) }
          }

          // The bootstrap root may contain compiler modules below the entry
          // directory. Core declarations must retain one toolchain identity,
          // while imports that cross the configured root still fail closed.
          bootstrap_root = child(workspace.root, "bootstrap-root")
          bootstrap_compiler_dir = child(bootstrap_root, "compiler")
          bootstrap_main = child(bootstrap_root, "main.panack")
          bootstrap_escape = child(bootstrap_root, "escape.panack")
          bootstrap_symlink_entry = child(bootstrap_root, "symlink.panack")
          bootstrap_left = child(bootstrap_compiler_dir, "left.panack")
          bootstrap_right = child(bootstrap_compiler_dir, "right.panack")
          bootstrap_shared = child(bootstrap_compiler_dir, "shared.panack")
          bootstrap_outside = child(workspace.root, "bootstrap-outside.panack")
          bootstrap_link = child(bootstrap_root, "outside-link.panack")
          bootstrap_artifact = child(workspace.root, "bootstrap-root.bc")
          bootstrap_escape_artifact = child(workspace.root, "bootstrap-escape.bc")
          bootstrap_main_text = result_value_or(path_to_text(bootstrap_main), "invalid-bootstrap-main")
          bootstrap_escape_text = result_value_or(path_to_text(bootstrap_escape), "invalid-bootstrap-escape")
          bootstrap_symlink_entry_text = result_value_or(path_to_text(bootstrap_symlink_entry), "invalid-bootstrap-symlink-entry")
          bootstrap_left_text = result_value_or(path_to_text(bootstrap_left), "invalid-bootstrap-left")
          bootstrap_right_text = result_value_or(path_to_text(bootstrap_right), "invalid-bootstrap-right")
          bootstrap_shared_text = result_value_or(path_to_text(bootstrap_shared), "invalid-bootstrap-shared")
          bootstrap_outside_text = result_value_or(path_to_text(bootstrap_outside), "invalid-bootstrap-outside")
          bootstrap_link_text = result_value_or(path_to_text(bootstrap_link), "invalid-bootstrap-link")
          bootstrap_artifact_text = result_value_or(path_to_text(bootstrap_artifact), "invalid-bootstrap-artifact")
          bootstrap_escape_artifact_text = result_value_or(path_to_text(bootstrap_escape_artifact), "invalid-bootstrap-escape-artifact")
          bootstrap_root_text = result_value_or(path_to_text(bootstrap_root), "invalid-bootstrap-root")
          bootstrap_stdlib_text = environment_get("PANACKELTY_STDLIB_PATH")
          bootstrap_environment = [
            "PANACKELTY_BOOTSTRAP_ROOT=${bootstrap_root_text}",
            "PANACKELTY_STDLIB_PATH=${bootstrap_stdlib_text}"
          ]
          fs_create_directory(bootstrap_root)
          fs_create_directory(bootstrap_compiler_dir)
          bootstrap_left_write = fs_write(bootstrap_left, utf8_encode(
            "pub record Item[T] { value: T }\npub record Envelope[T] { item: Item[T] }\npub enum Outcome[T] { Finished(Envelope[T]) }\npub pure make(): Envelope[Nat] { Envelope(Item(41)) }\npub async fetch(): Nat { 51 }\npub pure identity[T](value: T): T { value }\npub pure indirect_value(): Nat {\n  mut total: Nat = 0\n  values: [Nat] = [20, 21]\n  for value in values {\n    total = total + value\n  }\n  if total == 41 { total + 2 } else { 0 }\n}\npub pure make_outcome(): Outcome[Nat] { Finished(make()) }\npub pure positive(value: Nat): Bool { value == 45 }\npub type Positive = Nat where positive(value)\npub type ProvenPositive = Nat where value > 0\npub pure option_value(): Option[Nat] { Some(71) }\nmain(): Void { print(999) }\n"))
          bootstrap_right_write = fs_write(bootstrap_right, utf8_encode(
            "pub record Item[T] { value: T }\npub record Envelope[T] { item: Item[T] }\npub enum Outcome[T] { Finished(Envelope[T]) }\npub pure make(): Envelope[Nat] { Envelope(Item(42)) }\npub async fetch(): Nat { 52 }\npub pure identity[T](value: T): T { value }\npub pure indirect_value(): Nat {\n  mut total: Nat = 0\n  values: [Nat] = [20, 22]\n  for value in values {\n    total = total + value\n  }\n  if total == 42 { total + 2 } else { 0 }\n}\npub pure make_outcome(): Outcome[Nat] { Finished(make()) }\npub pure positive(value: Nat): Bool { value == 46 }\npub type Positive = Nat where positive(value)\npub type ProvenPositive = Nat where value > 0\npub pure option_value(): Option[Nat] { Some(72) }\nmain(): Void { print(998) }\n"))
          bootstrap_shared_write = fs_write(bootstrap_shared, utf8_encode(
            "pub pure answer(): Option[Nat] { Some(61) }\nmain(): Void { print(997) }\n"))
          bootstrap_main_write = fs_write(bootstrap_main, utf8_encode(
            "import \"compiler/left.panack\" as left\n" +
            "import \"compiler/right.panack\" as right\n" +
            "import \"compiler/shared.panack\" as shared\n" +
            "pure invoke(callback: PureFn[Nat]): Nat { callback.call() }\n" +
            "pure expect(value: Bool): Unit { checked = [0][if value { 0 } else { 1 }]; () }\n" +
            "async left_value(): Nat { await left.fetch() }\n" +
            "async right_value(): Nat { await right.fetch() }\n" +
            "async main(): Unit {\n" +
            "  left_item: left.Envelope[Nat] = left.make()\n" +
            "  right_item: right.Envelope[Nat] = right.make()\n" +
            "  left_outcome: left.Outcome[Nat] = left.make_outcome()\n" +
            "  right_outcome: right.Outcome[Nat] = right.make_outcome()\n" +
            "  expect(left.identity(left_item.item.value) == 41)\n" +
            "  expect(right.identity(right_item.item.value) == 42)\n" +
            "  expect(invoke(@left.indirect_value) == 43)\n" +
            "  expect(invoke(@right.indirect_value) == 44)\n" +
            "  match left_outcome { left.Outcome.Finished(value) => expect(value.item.value == 41) }\n" +
            "  match right_outcome { right.Outcome.Finished(value) => expect(value.item.value == 42) }\n" +
            "  left_positive: left.ProvenPositive = 45\n" +
            "  right_positive: right.ProvenPositive = 46\n" +
            "  expect(left_positive - 1 == 44)\n" +
            "  expect(right_positive - 1 == 45)\n" +
            "  expect(if left.positive(45) { 51 } else { 0 } == 51)\n" +
            "  expect(if right.positive(46) { 52 } else { 0 } == 52)\n" +
            "  shared_option: Option[Nat] = shared.answer()\n" +
            "  left_option: Option[Nat] = left.option_value()\n" +
            "  right_option: Option[Nat] = right.option_value()\n" +
            "  match shared_option { Some(item) => expect(item == 61), None() => expect(false) }\n" +
            "  match left_option { Some(item) => expect(item == 71), None() => expect(false) }\n" +
            "  match right_option { Some(item) => expect(item == 72), None() => expect(false) }\n" +
            "  expect(await left_value() == 51)\n" +
            "  expect(await right_value() == 52)\n" +
            "  ()\n" +
            "}\n"))
          bootstrap_outside_write = fs_write(bootstrap_outside, utf8_encode(
            "main(): Void { print(777) }\n"))
          results = append(results, test_expect(
            "bootstrap-root fixture setup",
            match bootstrap_left_write { Ok(written) => true, Error(error) => false } &&
              match bootstrap_right_write { Ok(written) => true, Error(error) => false } &&
              match bootstrap_shared_write { Ok(written) => true, Error(error) => false } &&
              match bootstrap_main_write { Ok(written) => true, Error(error) => false } &&
              match bootstrap_outside_write { Ok(written) => true, Error(error) => false },
            "source fixture write failed"
          ))
          results = append(results, namespace_bootstrap_root_command(
            "bootstrap-root core identity source execution",
            compiler,
            ["run", bootstrap_main_text],
            ProcessOutput(0, 0, bytes(), bytes()),
            bootstrap_environment))
          results = append(results, namespace_bootstrap_root_command(
            "slice 6 integrated staged source check",
            compiler,
            ["check", bootstrap_main_text],
            ProcessOutput(0, 0, utf8_encode("ok\n"), bytes()),
            bootstrap_environment))
          results = append(results, namespace_bootstrap_root_command(
            "slice 6 integrated staged source compile",
            compiler,
            ["compile", bootstrap_main_text, "-o", bootstrap_artifact_text],
            ProcessOutput(0, 0, utf8_encode("wrote ${bootstrap_artifact_text}\n"), bytes()),
            bootstrap_environment))
          for file in [bootstrap_main, bootstrap_left, bootstrap_right, bootstrap_shared] {
            match fs_remove_file(file) {
              Ok(removed) => {},
              Error(error) => { results = append(results, test_expect(
                "slice 6 integrated source removal", false, "source file removal failed")) }
            }
          }
          results = append(results, test_expect(
            "slice 6 integrated sources are absent",
            !file_exists(bootstrap_main_text) && !file_exists(bootstrap_left_text) &&
              !file_exists(bootstrap_right_text) && !file_exists(bootstrap_shared_text),
            "source files remained after compilation"
          ))
          results = append(results, test_run_command(
            "slice 6 integrated saved bytecode validation without sources",
            compiler_command(compiler, ["check", bootstrap_artifact_text]),
            ProcessOutput(0, 0, utf8_encode("ok\n"), bytes())))
          results = append(results, test_run_command(
            "slice 6 integrated saved bytecode execution without sources",
            compiler_command(compiler, ["run", bootstrap_artifact_text]),
            ProcessOutput(0, 0, bytes(), bytes())))
          fs_write(bootstrap_escape, utf8_encode(
            "import \"../bootstrap-outside.panack\"\nmain(): Void {}\n"))
          results = append(results, namespace_bootstrap_root_rejection(
            compiler,
            "compile",
            bootstrap_escape_text,
            bootstrap_escape_artifact_text,
            "module path escapes the entry directory and standard library roots",
            bootstrap_environment
          ))
          results = append(results, test_expect(
            "bootstrap-root escape publishes no artifact",
            !file_exists(bootstrap_escape_artifact_text),
            "rejected bootstrap import produced an artifact"
          ))
          fs_write(bootstrap_symlink_entry, utf8_encode(
            "import \"outside-link.panack\"\nmain(): Void {}\n"))
          bootstrap_link_setup = process_run(
            path("/bin/ln"),
            ["-s", bootstrap_outside_text, bootstrap_link_text],
            bytes(),
            workspace.root,
            [],
            duration_seconds(5),
            1024
          )
          results = append(results, test_expect(
            "bootstrap-root symlink fixture setup",
            match bootstrap_link_setup { Ok(output) => output.exit_code == 0 && output.signal == 0, Error(error) => false },
            "symlink setup failed"
          ))
          results = append(results, namespace_bootstrap_root_rejection(
            compiler,
            "run",
            bootstrap_symlink_entry_text,
            "",
            "module path traverses a symbolic link",
            bootstrap_environment
          ))
          for file in [bootstrap_main, bootstrap_escape, bootstrap_symlink_entry,
              bootstrap_left, bootstrap_right, bootstrap_shared, bootstrap_link,
              bootstrap_outside, bootstrap_artifact,
              bootstrap_escape_artifact] {
            if file_exists(result_value_or(path_to_text(file), "")) {
              match fs_remove_file(file) {
                Ok(removed) => {},
                Error(error) => { results = append(results, test_expect(
                  "bootstrap-root fixture cleanup", false, "file removal failed")) }
              }
            } else {}
          }
          match fs_remove_directory(bootstrap_compiler_dir) {
            Ok(removed) => {},
            Error(error) => { results = append(results, test_expect(
              "bootstrap-root compiler directory cleanup", false, "directory removal failed")) }
          }
          match fs_remove_directory(bootstrap_root) {
            Ok(removed) => {},
            Error(error) => { results = append(results, test_expect(
              "bootstrap-root directory cleanup", false, "directory removal failed")) }
          }

          source_root = child(workspace.root, "source-project")
          outside_source = child(workspace.root, "outside.panack")
          escape_entry = child(source_root, "escape.panack")
          symlink_entry = child(source_root, "symlink.panack")
          symlink_import = child(source_root, "outside-link.panack")
          escape_artifact = child(workspace.root, "escape.bc")
          escape_entry_text = result_value_or(path_to_text(escape_entry), "invalid-escape-entry")
          symlink_entry_text = result_value_or(path_to_text(symlink_entry), "invalid-symlink-entry")
          symlink_import_text = result_value_or(path_to_text(symlink_import), "invalid-symlink-import")
          escape_artifact_text = result_value_or(path_to_text(escape_artifact), "invalid-escape-artifact")
          outside_source_text = result_value_or(path_to_text(outside_source), "invalid-outside-source")
          fs_create_directory(source_root)
          fs_write(outside_source, utf8_encode("pure answer(): Nat { 99 }\n"))
          fs_write(escape_entry, utf8_encode("import \"../outside.panack\"\nmain(): Void {}\n"))
          results = append(results, namespace_source_load_rejection(
            compiler,
            "check",
            escape_entry_text,
            "",
            "module path escapes the entry directory"
          ))
          results = append(results, namespace_source_load_rejection(
            compiler,
            "compile",
            escape_entry_text,
            escape_artifact_text,
            "module path escapes the entry directory"
          ))
          results = append(results, test_expect(
            "source-loading rejection publishes no bytecode",
            !file_exists(escape_artifact_text),
            "rejected project produced an artifact"
          ))
          fs_write(symlink_entry, utf8_encode("import \"outside-link.panack\"\nmain(): Void {}\n"))
          link_setup = process_run(
            path("/bin/ln"),
            ["-s", outside_source_text, symlink_import_text],
            bytes(),
            workspace.root,
            [],
            duration_seconds(5),
            1024
          )
          results = append(results, test_expect(
            "source-loading symlink fixture setup",
            match link_setup { Ok(output) => output.exit_code == 0 && output.signal == 0, Error(error) => false },
            "symlink setup failed"
          ))
          results = append(results, namespace_source_load_rejection(
            compiler,
            "run",
            symlink_entry_text,
            "",
            "module path traverses a symbolic link"
          ))
          for file in [escape_entry, symlink_entry, symlink_import, outside_source] {
            match fs_remove_file(file) {
              Ok(removed) => {},
              Error(error) => { results = append(results, test_expect("source-loading fixture cleanup", false, "file removal failed")) }
            }
          }
          match fs_remove_directory(source_root) {
            Ok(removed) => {},
            Error(error) => { results = append(results, test_expect("source-loading directory cleanup", false, "directory removal failed")) }
          }
        },
        None() => {}
      }
      results = results.append(test_run_command("self-hosted compile",
        compiler_command(compiler, ["--", "compile", source, "-o", self_hosted_text]),
        ProcessOutput(0, 0, utf8_encode("wrote ${self_hosted_text}\n"), bytes())))
      results = results.append(test_run_command("bootstrap compile",
        command(["compile", source, "-o", bootstrap_text], 30),
        ProcessOutput(0, 0, utf8_encode("wrote ${bootstrap_text}\n"), bytes())))
      match fs_read(self_hosted, 1048576) {
        Error(error) => { results = results.append(test_expect("byte-identical compiler output",
          false, "self-hosted artifact read failed")) },
        Ok(hosted_bytes) => {
          match fs_read(bootstrap, 1048576) {
            Error(error) => { results = results.append(test_expect("byte-identical compiler output",
              false, "bootstrap artifact read failed")) },
            Ok(bootstrap_bytes) => { results = results.append(test_expect(
              "byte-identical compiler output", hosted_bytes == bootstrap_bytes,
              "compiler artifacts differed")) }
          }
        }
      }
      match process_run(path("./panack"), ["run", compiler, "disasm", source],
          bytes(), path_current(), [], duration_seconds(30), 1048576) {
        Error(error) => { results = results.append(test_expect("self-hosted disassembly",
          false, "source command failed")) },
        Ok(source_disasm) => {
          results = results.append(test_expect("self-hosted disassembly",
            source_disasm.exit_code == 0 && source_disasm.signal == 0 &&
              source_disasm.stderr == bytes(), "source disassembly failed"))
          results = results.append(test_run_command("self-hosted bytecode disassembly",
            compiler_command(compiler, ["disasm", self_hosted_text]),
            ProcessOutput(0, 0, source_disasm.stdout, bytes())))
        }
      }
      for file in [self_hosted, bootstrap] {
        match fs_remove_file(file) {
          Ok(removed) => {},
          Error(error) => { results = results.append(test_expect("artifact cleanup", false,
            "file removal failed")) }
        }
      }
      match environment("PANACK_TEST_NAMESPACE_EMISSION") {
        Some(enabled) => {
          for file in [namespace_artifact, namespace_async_artifact] {
            match fs_remove_file(file) {
              Ok(removed) => {},
              Error(error) => { results = results.append(test_expect("namespace artifact cleanup", false, "file removal failed")) }
            }
          }
        },
        None() => {}
      }
      match environment("PANACK_TEST_COMPILER") {
        Some(cached) => {},
        None() => {
          match fs_remove_file(own_compiler) {
            Ok(removed2) => {},
            Error(error) => { results = results.append(test_expect("compiler cleanup", false,
              "file removal failed")) }
          }
        }
      }
      match test_workspace_remove_empty(workspace) {
        Ok(removed3) => {},
        Error(error) => { results = results.append(test_expect("workspace cleanup", false,
          "directory removal failed")) }
      }
      failures = test_report(results)
      if failures > 0 { process_exit(1) }
    }
  }
}
