      "pub pure map_value(): Nat { values: Map[Str,Nat] = map(); values.put(\"key\",1); values.get(\"key\") }; " +
      "pub pure set_operations(): Bool { values: Set[Nat] = set(); values.add(1); values.has(1) }; " +
      "pub pure append_value(): [Nat] { [1].append(2) }; " +
      "pub pure concat_value(): [Nat] { [1].concat([2]) }; " +
      "pub pure mapped(): [Nat] { [1,2].map(@twice) }; " +
      "pub pure reduced(): Nat { [1,2].reduce(0,@sum) }; " +
