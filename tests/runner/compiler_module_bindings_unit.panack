  core_methods: CheckedModuleBodies = body_test_graph([core_app, core_method_library], core_method_graph, core_app)
  results = append(results, test_expect("core methods use reserved original signatures", len(core_methods.diagnostics) == 0 && len(core_methods.functions) == 15 && core_methods.functions[0].status == BodyIdentityChecked() && core_methods.functions[1].body.children[0].type == Some(SignatureType(SignatureCore("Option"), [SignatureType(SignatureCore("Nat"), [])])) && core_methods.functions[2].body.children[0].type == Some(SignatureType(SignatureCore("Bool"), [])) && core_methods.functions[1].status == BodyIdentityChecked() && core_methods.functions[2].status == BodyIdentityChecked() && core_methods.functions[3].status == BodyIdentityChecked() && core_methods.functions[4].status == BodyIdentityChecked() && core_methods.functions[5].status == BodyIdentityChecked() && core_methods.functions[6].status == BodyIdentityChecked() && core_methods.functions[7].status == BodyIdentityChecked() && core_methods.functions[8].status == BodyIdentityChecked() && core_methods.functions[9].status == BodyIdentityChecked() && core_methods.functions[10].status == BodyIdentityChecked() && core_methods.functions[11].status == BodyIdentityChecked(), if len(core_methods.diagnostics) > 0 { core_methods.diagnostics[0].message } else { "core method identity/type evidence missing" }))
  aliases: CheckedModuleBodies = body_test_module(
