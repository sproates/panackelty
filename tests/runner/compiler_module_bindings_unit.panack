    body_test_error("pub pure f(): Str { slice(\"text\", 1) }"),
    "slice expects 3 arguments, got 2"
  ))
  for source in [
    "pub pure identity(value: Nat): Nat { value }",
    "pub pure widen(value: Nat): Int { value }",
    "pub pure widen(value: [Nat]): [Int] { value }",
    "pub pure f(): Nat { local: Nat = 1; local }",
    "pub pure f(): Nat { local = 1; local }",
    "pub pure f(): Nat { mut local: Nat = 1; local = 2; local }",
    "pub pure f(): Nat { later(1) }; pure later(value: Nat): Nat { value }",
    "pub pure f[T](value: T): T { later[T](value) }; pure later[T](value: T): T { value }",
    "pub pure f[T](value: Option[T]): Option[T] { later[T](value) }; pure later[U](value: Option[U]): Option[U] { value }",
    "pub pure f(): Fn[Nat] { @answer }; pure answer(): Nat { 1 }",
    "pub pure f(value: Nat): Nat { value.helper() }; pure helper(value: Nat): Nat { value }",
    "pub pure f(): Nat { first(1) }; pure first(value: Nat): Nat { value }",
    "pub pure f(): Nat { nothing(); 1 }; pure nothing(): Void {}"
  ] {
