      "pub pure map_get_alias(): Nat { values: Map[Str,Nat] = map(); map_put(values, \"key\", 1); map_get(values, \"key\") }; " +
      "pub pure map_has_alias(): Bool { values: Map[Str,Nat] = map(); map_put(values, \"key\", 1); map_has(values, \"key\") }; " +
      "pub pure set_add_alias(): Set[Nat] { set_add(set(), 1) }; " +
