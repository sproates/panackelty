  wrong_sort_graph: ModuleBindingGraph = ModuleBindingGraph([wrong_sort_app.bindings, core_method_library.bindings], [ModuleImportEdge(wrong_sort_app.bindings.identity, 0, core_method_library.bindings.identity)])
  wrong_sort_checked: CheckedModuleBodies = body_test_graph([wrong_sort_app, core_method_library], wrong_sort_graph, wrong_sort_app)
  results = append(results, test_expect("sort_by rejects callback type mismatch",
