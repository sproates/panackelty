  ))
  results = append(results, std_testing.equal_str(
    "starts_with_at checks arity",
    body_test_error("pub pure f(): Bool { starts_with_at(\"text\", \"t\") }"),
    "starts_with_at expects 3 arguments, got 2"
  ))
  rational_conversions: CheckedModuleBodies = body_test_module(
