    if len(wrong_sort_checked.diagnostics) > 0 { wrong_sort_checked.diagnostics[0].message } else { "sort_by accepted a callback for the wrong element type" }))
  for source in [
    "pub pure f(): Str { len([1]) }",
    "pub pure f(): Bool { [1].append(2) }",
    "pub pure f(): [Str] { [1].concat([2]) }",
    "pub pure f(): Bool { values: Map[Str,Nat] = map(); values.put(\"key\", 1) }",
    "pub pure f(): Bool { values: Map[Str,Nat] = map(); values.get(\"key\") }",
    "pub pure f(): Nat { values: Map[Str,Nat] = map(); values.has(\"key\") }",
    "pub pure f(): Nat { values: Set[Nat] = set(); values.add(1) }",
    "pub pure f(): Nat { values: Set[Nat] = set(); values.has(1) }"
  ] {
    checked: CheckedModuleBodies = body_test_module(source)
