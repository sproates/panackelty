    "pub pure f(): [Nat] { concat([1]) }",
    "pub pure f(): [Nat] { concat([1], [2], [3]) }",
    "pub pure f(): Map[Str,Nat] { map_put(map(), \"key\") }",
    "pub pure f(): Nat { map_get(map(), \"key\", \"extra\") }",
    "pub pure f(): Bool { map_has(map(), \"key\", \"extra\") }",
    "pub pure f(): Set[Nat] { set_add(set()) }",
    "pub pure f(): Bool { set_has(set(), 1, 2) }",
    "pub pure f(): [Nat] { [1].append() }",
    "pub pure f(): [Nat] { [1].append(2, 3) }",
    "pub pure f(): [Nat] { [1].concat() }",
    "pub pure f(): [Nat] { [1].concat([2], [3]) }",
    "pub pure f(): [Nat] { [1].map() }",
    "pub pure f(): [Nat] { [1].map(@twice, @twice) }; pure twice(value: Nat): Nat { value }",
    "pub pure f(): Nat { [1].reduce(0) }",
    "pub pure f(): Nat { [1].reduce(0, @sum, @sum) }; pure sum(left: Nat, right: Nat): Nat { left + right }",
    "pub pure f(): Map[Str,Nat] { values: Map[Str,Nat] = map(); values.put(\"key\") }",
    "pub pure f(): Map[Str,Nat] { values: Map[Str,Nat] = map(); values.put(\"key\", 1, 2) }",
    "pub pure f(): Nat { values: Map[Str,Nat] = map(); values.get() }",
    "pub pure f(): Nat { values: Map[Str,Nat] = map(); values.get(\"key\", \"extra\") }",
    "pub pure f(): Bool { values: Map[Str,Nat] = map(); values.has() }",
    "pub pure f(): Bool { values: Map[Str,Nat] = map(); values.has(\"key\", \"extra\") }",
    "pub pure f(): Set[Nat] { values: Set[Nat] = set(); values.add() }",
    "pub pure f(): Set[Nat] { values: Set[Nat] = set(); values.add(1, 2) }",
    "pub pure f(): Bool { values: Set[Nat] = set(); values.has() }",
    "pub pure f(): Bool { values: Set[Nat] = set(); values.has(1, 2) }"
  ] {
