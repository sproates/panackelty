  results = append(results, std_testing.equal_str(
    "rational conversion checks arity",
    body_test_error("pub pure f(): Nat { (3 / 1).nat(2) }"),
    "nat expects 1 arguments, got 2"
  ))
  results = append(results, std_testing.equal_str(
