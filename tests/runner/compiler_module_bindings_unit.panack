      if len(checked.diagnostics) > 0 { checked.diagnostics[0].message } else { "core result was accepted against the declared return type" }))
  }
  for source in [
    "pub pure f(): Nat { len(1) }",
    "pub pure f(): [Nat] { [1].append(\"bad\") }",
    "pub pure f(): [Nat] { [1].concat([\"bad\"]) }",
    "pub pure f(): [Nat] { append([1], \"bad\") }",
    "pub pure f(): [Nat] { concat([1], [\"bad\"]) }",
    "pub pure f(): Option[Nat] { [1].first(\"bad\") }",
    "pub pure f(): Bool { \"text\".ends_with(1) }",
    "pub pure f(): Map[Nat,Nat] { values: Map[Nat,Nat] = map(); values.put(\"bad\", 1); values }",
    "pub pure f(): Map[Nat,Nat] { values: Map[Nat,Nat] = map(); values.put(1, \"bad\"); values }",
    "pub pure f(): Bool { values: Map[Nat,Nat] = map(); values.has(\"bad\") }",
    "pub pure f(): Map[Nat,Nat] { values: Map[Nat,Nat] = map(); map_put(values, \"bad\", 1) }",
    "pub pure f(): Map[Nat,Nat] { values: Map[Nat,Nat] = map(); map_put(values, 1, \"bad\") }",
    "pub pure f(): Nat { values: Map[Nat,Nat] = map(); map_get(values, \"bad\") }",
    "pub pure f(): Bool { values: Map[Nat,Nat] = map(); map_has(values, \"bad\") }",
    "pub pure f(): Set[Nat] { values: Set[Nat] = set(); values.add(\"bad\"); values }",
    "pub pure f(): Bool { values: Set[Nat] = set(); values.has(\"bad\") }",
    "pub pure f(): Set[Nat] { values: Set[Nat] = set(); set_add(values, \"bad\") }",
    "pub pure f(): Bool { values: Set[Nat] = set(); set_has(values, \"bad\") }"
  ] {
    invalid_app: LoadedModule = signature_test_module(namespace_identity("invalid_core_argument"), source)
    invalid_graph: ModuleBindingGraph = ModuleBindingGraph([invalid_app.bindings, core_method_library.bindings], [ModuleImportEdge(invalid_app.bindings.identity, 0, core_method_library.bindings.identity)])
    checked: CheckedModuleBodies = body_test_graph([invalid_app, core_method_library], invalid_graph, invalid_app)
    results = append(results, test_expect("core argument mismatch rejects/" + source,
      len(checked.diagnostics) > 0 && len(checked.functions) > 0 && checked.functions[0].status == BodyInvalid(),
      if len(checked.diagnostics) > 0 { checked.diagnostics[0].message } else { "invalid core argument was accepted" }))
  }
  results = append(results, test_equal_str("core method arity checked", body_test_graph([signature_test_module(namespace_identity("wrong_core_method"), "pub pure f(): Option[Nat] { [1].first(\"extra\") }") , core_method_library], ModuleBindingGraph([namespace_test_bindings("wrong_core_method", "pub pure f(): Option[Nat] { [1].first(\"extra\") }"), core_method_library.bindings], []), signature_test_module(namespace_identity("wrong_core_method"), "pub pure f(): Option[Nat] { [1].first(\"extra\") }")).diagnostics[0].message, "first expects 1 arguments, got 2"))
  results = append(results, test_equal_str("return mismatch", body_test_error("pub pure f(): Nat { \"bad\" }"), "return of f is Str, expected Nat"))
  results = append(results, test_equal_str("initializer cannot see new binding", body_test_error("pub pure f(): Nat { value = value; value }"), "unknown local value value"))
  results = append(results, test_equal_str("inferred binding remains immutable", body_test_error("pub pure f(): Nat { value = 1; value = 2; value }"), "cannot assign immutable binding value"))
  results = append(results, test_equal_str("mutable assignment checks type", body_test_error("pub pure f(): Nat { mut value = 1; value = \"bad\"; value }"), "assignment value is Str, expected Nat"))
  results = append(results, test_equal_str("ordinary callable cannot satisfy pure", body_test_error("pub pure f(): PureFn[Nat] { @answer }; answer(): Nat { 1 }"), "return of f is Fn[Nat], expected PureFn[Nat]"))
  results = append(results, test_equal_str("async callable keeps distinct effect", body_test_error("pub pure f(): Fn[Nat] { @answer }; async answer(): Nat { 1 }"), "return of f is AsyncFn[Nat], expected Fn[Nat]"))
  results = append(results, test_equal_str("generic function reference rejected", body_test_error("pub pure f(): Fn[Nat,Nat] { @identity }; pure identity[T](value: T): T { value }"), "generic function references require a non-generic wrapper"))
  results = append(results, test_equal_str("explicit generic substitution checks type", body_test_error("pub pure f(): Nat { identity[Nat](\"bad\") }; pure identity[T](value: T): T { value }"), "argument 1 to identity is Str, expected Nat"))
  results = append(results, test_equal_str("explicit generic arity checked", body_test_error("pub pure f(): Nat { identity[Nat,Str](1) }; pure identity[T](value: T): T { value }"), "call identity has incorrect type argument count"))
  for source in [

    "pub pure f(): Nat { [1].first() }",
    "pub pure f(): Nat { [1].first() }; pure first(value: Str): Str { value }"
  ] {
    checked: CheckedModuleBodies = body_test_module(source)
    results = append(results, test_equal_nat("deferred body has no invented error/" + source, len(checked.diagnostics), 0))
    results = append(results, test_expect("unsupported proof/inference explicitly deferred/" + source, len(checked.functions) > 0 && len(checked.functions[0].deferred) > 0, "unsupported body marked complete"))
  }
  guarded_branch: CheckedModuleBodies = body_test_module(
    "pub type Positive = Nat where value > 0; pub pure f(value: Nat): Nat { if value > 0 { positive: Positive = value; value - 1 } else { 0 } }"
  )
  results = append(results, test_expect(
    "identity guard facts prove guarded conversion and Nat subtraction",
    len(guarded_branch.diagnostics) == 0 && len(guarded_branch.functions) == 1 &&
      guarded_branch.functions[0].status == BodyIdentityChecked(),
    if len(guarded_branch.diagnostics) > 0 { guarded_branch.diagnostics[0].message } else { "branch guard did not discharge its proof obligations" }
  ))
  guarded_invariant: CheckedModuleBodies = body_test_module(
    "pub type Positive = Nat where value > 0; pub pure f(value: Positive): Nat { value - 1 }"
  )
  results = append(results, test_expect(
    "guarded type invariant proves Nat subtraction",
    len(guarded_invariant.diagnostics) == 0 && len(guarded_invariant.functions) == 1 &&
      guarded_invariant.functions[0].status == BodyIdentityChecked(),
    if len(guarded_invariant.diagnostics) > 0 { guarded_invariant.diagnostics[0].message } else { "guarded invariant was not used for subtraction" }
  ))
  guarded_literal: CheckedModuleBodies = body_test_module(
    "pub type Positive = Nat where value > 0; pub pure f(): Positive { 0 }"
  )
  results = append(results, test_expect(
    "known failing guarded conversion is rejected",
    len(guarded_literal.diagnostics) > 0 && guarded_literal.functions[0].status == BodyInvalid(),
    "known failing guard was accepted or deferred"
  ))
  guarded_literal_positive: CheckedModuleBodies = body_test_module(
    "pub type Positive = Nat where value > 0; pub pure f(): Positive { 1 }"
  )
  results = append(results, test_expect(
    "known passing guarded conversion is checked",
    len(guarded_literal_positive.diagnostics) == 0 &&
      guarded_literal_positive.functions[0].status == BodyIdentityChecked(),
    "known passing guard remained deferred or was rejected"
  ))
  guarded_mutation: CheckedModuleBodies = body_test_module(
    "pub type Positive = Nat where value > 0; pub pure f(value: Nat): Nat { mut current = value; if current > 0 { current = 0; positive: Positive = current; 0 } else { 0 } }"
  )
  results = append(results, test_expect(
    "reassignment invalidates only the mutated local guard fact",
    len(guarded_mutation.diagnostics) == 0,
    "unexpected mutation diagnostic"
  ))
  results = append(results, test_expect(
    "reassignment leaves the guard conversion pending",
    len(guarded_mutation.functions) == 1 &&
      guarded_mutation.functions[0].status == BodyDeferred(),
    "stale mutable-local fact discharged a guard obligation"
  ))
  left: LoadedModule = signature_test_module(namespace_identity("left"), "pub record Item { value: Nat }; pub pure take(value: Item): Item { value }; pub pure id[T](value: T): T { value }")
  right: LoadedModule = signature_test_module(namespace_identity("right"), "pub record Item { value: Nat }")
  app: LoadedModule = signature_test_module(namespace_identity("app"), "import project/left as first; import project/left as second; import project/right as other; pure okay(value: first.Item): second.Item { first.take(value) }; pure wrong(value: other.Item): first.Item { first.take(value) }; pure wrong_return(value: other.Item): first.Item { value }")
  graph: ModuleBindingGraph = ModuleBindingGraph([app.bindings, right.bindings, left.bindings], [ModuleImportEdge(app.bindings.identity, 0, left.bindings.identity), ModuleImportEdge(app.bindings.identity, 1, left.bindings.identity), ModuleImportEdge(app.bindings.identity, 2, right.bindings.identity)])
  checked: CheckedModuleBodies = body_test_graph([app, right, left], graph, app)
  results = append(results, test_equal_nat("same nominal via aliases accepted, different nominal rejected twice", len(checked.diagnostics), 2))
  if len(checked.diagnostics) == 2 {
    results = append(results, test_equal_str("qualified argument names source identity", checked.diagnostics[0].message, "argument 1 to take is right:Item, expected left:Item"))
    results = append(results, test_equal_str("return uses tagged nominal identity", checked.diagnostics[1].message, "return of wrong_return is right:Item, expected left:Item"))
    results = append(results, test_equal_str("body error owns original source", checked.diagnostics[0].position.file, "module.panack"))
  }
  if len(checked.functions) == 3 {
    call: BoundBody = checked.functions[0].body.children[0]
    results = append(results, test_expect("qualified bound call retains declaration identity", match call.node { BodyCall(target, types) => match target { BodyDeclaration(binding) => binding.identity == DeclarationIdentity(left.bindings.identity, "take"), BodyCore(name) => false }, BodyLiteral(value) => false, BodyInterpolation(parts) => false, BodyLocalUse(local) => false, BodyFunction(binding) => false, BodyArray() => false, BodyUnary(operator) => false, BodyBinary(operator) => false, BodyField(name) => false, BodyIndex() => false, BodyIf(has_else) => false, BodyBlock(has_tail) => false, BodyMatch(targets, bindings) => false, BodyBinding(local, type, mutable) => false, BodyAssignment(local) => false, BodyWhile() => false, BodyFor(local) => false, BodyEmpty() => false }, "call target was re-spelled"))
  }
  lexical: CheckedModuleBodies = body_test_module("pub pure f(value: Nat): Nat { mut local = value; local = 2; if true { inner = local; inner }; local }")
  results = append(results, test_equal_nat("nested lexical body binds", len(lexical.diagnostics), 0))
  if len(lexical.functions) == 1 {
    children: [BoundBody] = lexical.functions[0].body.children
    results = append(results, test_expect("block preserves tail distinction", lexical.functions[0].body.node == BodyBlock(true), "lost block tail"))
    results = append(results, test_expect("assignment reuses lexical local identity", children[1].node == BodyAssignment(BodyLocalIdentity(lexical.functions[0].signature.binding.identity, [1,0], "local")), "assignment created fresh identity"))
  }
  results = append(results, test_equal_str("nested binding cannot escape", body_test_error("pub pure f(): Nat { if true { inner = 1; inner }; inner }"), "unknown local value inner"))
  for binding in ["local = nothing()", "mut local = nothing()"] {
    results = append(results, test_equal_str("Void cannot become inferred local/" + binding, body_test_error("pub pure f(): Nat { " + binding + "; 1 }; pure nothing(): Void {}"), "Void is not a value and cannot be stored in binding local"))
  }
  results = append(results, test_equal_str("annotated local cannot shadow parameter", body_test_error("pub pure f(value: Nat): Nat { value: Nat = 1; value }"), "local value shadows an existing binding"))
  results = append(results, test_equal_str("loop local cannot shadow parameter", body_test_error("pub pure f(value: Nat): Nat { for value in [1] {}; value }"), "loop variable value shadows an existing binding"))
  results = append(results, test_equal_str("pattern local cannot shadow parameter", body_test_error("pub pure f(value: Nat): Nat { match Some(1) { Some(value) => value, None() => 0 } }"), "pattern binding value shadows an existing binding"))
  results = append(results, test_equal_str("pattern requires original variant category", body_test_error("pub pure f(): Nat { match 1 { helper() => 1 } }; pure helper(): Nat { 1 }"), "match requires an enum, got Nat"))
  results = append(results, test_equal_str("private guard still resolves names", body_test_error("type Hidden = Nat where missing(value); pub pure f(): Nat { 1 }"), "module body.panack has no binding missing"))
  results = append(results, test_equal_str("later recursive callable contract exists", body_test_error("pub pure f(value: Nat): Nat { f(value) }"), "ok"))
  core: LoadedModule = signature_test_module(ModuleIdentity(ToolchainModulePackage(), "core.panack"), "pub enum Option[T] { Some(T), None }; pub enum Result[T,E] { Ok(T), Error(E) }")
  alias: LoadedModule = signature_test_module(namespace_identity("core_body"), "import stdlib/core::{Option as Maybe}; pub pure f(): Option[Nat] { Maybe.Some(1) }")
  core_graph: ModuleBindingGraph = ModuleBindingGraph([alias.bindings, core.bindings], [ModuleImportEdge(alias.bindings.identity, 0, core.bindings.identity)])
  core_result: CheckedModuleBodies = body_test_graph([alias, core], core_graph, alias)
  maps: CheckedModuleBodies = body_test_module("pub pure direct(): Map[Nat,Nat] { map() }; pub pure receiver(value: [Nat]): [Nat] { value.map(@identity) }; pure identity(value: Nat): Nat { value }")
  results = append(results, test_equal_nat("core map target fixtures bind", len(maps.diagnostics), 0))
  if len(maps.functions) == 3 {
    results = append(results, test_expect("direct map retains constructor identity", maps.functions[0].body.children[0].node == BodyCall(BodyCore("map"), [SignatureType(SignatureCore("Nat"), []), SignatureType(SignatureCore("Nat"), [])]), "direct map lowered as receiver method"))
    results = append(results, test_expect("receiver map retains reserved method identity", maps.functions[1].body.children[0].node == BodyCall(BodyCore("$method_map"), []), "receiver map lost method lowering"))
  }
  results = append(results, test_equal_nat("qualified private core alias constructor remains available", len(core_result.diagnostics), 0))
  results = append(results, test_expect("core alias constructor inference is identity checked", len(core_result.functions) == 1 && core_result.functions[0].status == BodyIdentityChecked(), "constructor did not retain inferred evidence"))
  results
}

// Test-only adapter for the raw binding/guard-resolution contracts. Production
// function bodies use the retained bound tree, not this projection.
pure namespace_raw_uses_unchecked(graph: ModuleBindingGraph, identity: ModuleIdentity, parsed: ParsedModule): ResolvedModuleUses {
  mut result: ResolvedModuleUses = ResolvedModuleUses([], [])
  mut index: Nat = 0
  for declaration in parsed.program.declarations {
    origin: SourceSpan = parsed.syntax[index].span
    match declaration {
      ImportDeclaration(path) => {},
      TypeDeclaration(name, base, guard) => {
        result = combine_module_uses(result, resolve_qualified_type_uses(graph, identity, base, origin))
        result = combine_module_uses(result, resolve_module_expression_uses(graph, identity, guard, origin, set_add(set(), "value")))
      },
      RecordDeclaration(name, parameters, fields) => { for field in fields { result = combine_module_uses(result, resolve_qualified_type_uses(graph, identity, field.type_name, origin)) } },
      EnumDeclaration(name, parameters, variants) => { for variant in variants { for type_name in variant.payload { result = combine_module_uses(result, resolve_qualified_type_uses(graph, identity, type_name, origin)) } } },
      FunctionDeclaration(name, parameters, return_type, is_pure, is_async, body, type_parameters) => {
        result = combine_module_uses(result, resolve_qualified_type_uses(graph, identity, return_type, origin))
        for parameter in parameters { result = combine_module_uses(result, resolve_qualified_type_uses(graph, identity, parameter.type_name, origin)) }
        mut parameters_in_scope: Set[Str] = set()
        for parameter in parameters { parameters_in_scope = parameters_in_scope.add(parameter.name) }
        result = combine_module_uses(result, resolve_module_block_uses(graph, identity, body, origin, parameters_in_scope))
      }
    }
    index = index + 1
  }
  result
}

// An invalid lexical scope cannot yield misleading namespace identities.
pure namespace_raw_uses(graph: ModuleBindingGraph, identity: ModuleIdentity, parsed: ParsedModule): ResolvedModuleUses {
  match binding_graph_module(graph, identity) {
    Error(message) => ResolvedModuleUses([], [Diagnostic(message, SourcePos("", 0, 1, 1))]),
    Ok(module) => {
      diagnostics: [Diagnostic] = concat(module_binding_diagnostics(module), module_import_shadow_diagnostics(module, parsed))
      if len(diagnostics) > 0 { ResolvedModuleUses([], diagnostics) }
      else { namespace_raw_uses_unchecked(graph, identity, parsed) }
    }
  }
}

pure namespace_expression_tests(): [TestResult] {
  mut results: [TestResult] = []
  for source in [
    "pub pure f(): Nat { 1 + 2 * 3 }",
    "pub pure f(): Int { -1 }",
    "pub pure f(): Rat { 1 / 2 }",
    "pub pure f(a: Rat, b: Int): Rat { a + b }",
    "pub pure f(a: Dec, b: Dec): Dec { a / b }",
    "pub pure f(a: Int, b: Int): Int { a % b }",
    "pub pure f(a: Rat, b: Nat): Bool { a < b }",
    "pub pure f(a: Bool): Bool { !a || (a && false) }",
    "pub pure f(a: Str): Str { a + \"ok\" }",
    "pub pure f(a: Bool): Int { if a { 1 } else { -1 } }",
    "pub pure f(a: Bool): Nat { if a { 1 + 2 } else { 3 } }",
    "pub pure f(a: Bool): Void { if a { 42 } }",
    "pub pure f(): Nat { mut value = 1; value = value + 1; value }",
    "pub pure f(): Nat { mut value = 0; while value < 2 { value = value + 1 }; value }",
    "pub pure f(): Nat { mut sum = 0; for item in 0..3 { sum = sum + item }; sum }",
    "pub pure f(values: [Nat]): Nat { mut sum = 0; for item in values { sum = sum + item }; sum }",
    "pub pure f(values: Bytes): Nat { mut sum = 0; for item in values { sum = sum + item }; sum }",
    "pub pure f[T](values: [T], fallback: T): T { for item in values { copy: T = item }; fallback }",
    "pub pure f(value: Str): Str { value[0] }",
    "pub pure f(value: Bytes): Nat { value[0] }",
    "pub pure f[T](value: [T]): T { value[0] }",
    "pub pure f(a: Bool, left: PureFn[Nat], right: Fn[Nat]): Fn[Nat] { if a { left } else { right } }",
    "pub record Item { value: Nat }; pub pure f(a: Bool, left: Item, right: Item): Item { if a { left } else { right } }",
    "pub record Item { value: Nat }; pub pure f(left: Item, right: Item): Bool { left == right }"
  ] {
    checked: CheckedModuleBodies = body_test_module(source)
    message: Str = if len(checked.diagnostics) > 0 { checked.diagnostics[0].message } else { "missing checked body" }
    results = append(results, test_expect("ordinary identity expression/" + source, len(checked.diagnostics) == 0 && len(checked.functions) > 0 && checked.functions[0].status == BodyIdentityChecked(), message))
  }
  for source in [
    "pub pure f(a: Dec, b: Nat): Dec { a + b }",
    "pub pure f(a: Rat, b: Dec): Rat { a + b }",
    "pub pure f(a: Rat, b: Rat): Rat { a % b }",
    "pub pure f(): Nat { -true }",
    "pub pure f(): Bool { !1 }",
    "pub pure f(): Bool { 1 && true }",
    "pub pure f(): Bool { false && (1 + true) }",
    "pub pure f(): Nat { if 1 { 2 } else { 3 } }",
    "pub pure f(): Nat { if true { 1 } else { \"bad\" } }",
    "pub pure f(): Nat { value = if true { 1 }; 1 }",
    "pub pure f(): Nat { if true { 1 } }",
    "pub pure f(): Void { while 1 {} }",
    "pub pure f(): Void { for item in \"bad\" {} }",
    "pub pure f(): Void { for item in 0..true {} }",
    "pub pure f(): Nat { for item in 0..2 {}; item }",
    "pub pure f(): Nat { if true { item = 1 }; item }",
    "pub pure f(): Nat { value = 1; while true { value = 2 }; value }",
    "pub pure f(value: Str): Str { value[true] }",
    "pub pure f(value: Nat): Nat { value[0] }",
    "pub record Item { value: Nat }; pub pure f(item: Item): Nat { item + 1 }",
    "pub pure f[T](value: T): T { value + value }"
  ] {
    checked: CheckedModuleBodies = body_test_module(source)
    results = append(results, test_expect("ordinary identity expression rejects/" + source, len(checked.diagnostics) > 0 && len(checked.functions) > 0 && checked.functions[0].status == BodyInvalid(), "invalid expression was accepted or merely deferred"))
  }
  for source in [
    "pub pure f(): Nat { 2 - 1 }",
    "pub pure f(): Bool { false && ((2 - 1) == 1) }",
    "pub pure f(): Nat { if (2 - 1) == 1 { 0 } else { 1 } }",
    "pub pure f(): Void { while (2 - 1) == 1 {} }",
    "pub pure f(): Void { for item in 0..(2 - 1) {} }",
    "pub pure f(a: Bool, rational: Rat): Rat { if a { rational } else { 1 } }",
    "pub pure f(a: Bool, rational: Rat): Int { if a { 1 } else { rational } }"
  ] {
    checked: CheckedModuleBodies = body_test_module(source)
    results = append(results, test_expect("pending identity obligation propagates/" + source, len(checked.diagnostics) == 0 && len(checked.functions) > 0 && checked.functions[0].status == BodyDeferred() && len(checked.functions[0].deferred) > 0, "pending proof/inference/effect appeared checked"))
  }
  interpolation: Str = "$" + "{name}"
  interpolated: CheckedModuleBodies = body_test_module("pub pure f(name: Str): Str { \"hi " + interpolation + "\\n" + interpolation + "\" }")
  results = append(results, test_equal_nat("interpolation identities bind without diagnostics", len(interpolated.diagnostics), 0))
  if len(interpolated.functions) == 1 {
    function: BoundFunctionBody = interpolated.functions[0]
    node: BoundBody = function.body.children[0]
    results = append(results, test_expect("interpolation parts share existing escape semantics", node.node == BodyInterpolation(["hi ", "\n", ""]), "literal parsing changed"))
    results = append(results, test_expect("repeated interpolation preserves ordered local IDs", len(node.children) == 2 && node.children[0].node == BodyLocalUse(function.parameters[0].identity) && node.children[1].node == node.children[0].node, "local interpolation identity/order lost"))
    results = append(results, test_expect("interpolation owns original literal span", node.span.start.line == 1 && node.children[0].span == node.span, "interpolation source ownership changed"))
    results = append(results, test_expect("known interpolation is identity checked", function.status == BodyIdentityChecked(), "valid interpolation deferred"))
  }
  for source in [
    "pub pure f(): Str { \"" + interpolation + "\" }",
    "pub pure f(): Str { value = \"" + interpolation + "\"; name = \"late\"; value }",
    "pub pure f(): Str { if true { name = \"inner\" }; \"" + interpolation + "\" }",
    "pub pure f(name: [Nat]): Str { \"" + interpolation + "\" }"
  ] {
    checked: CheckedModuleBodies = body_test_module(source)
    results = append(results, test_expect("invalid interpolation rejects/" + source, len(checked.diagnostics) > 0 && len(checked.functions) == 1 && checked.functions[0].status == BodyInvalid(), "invalid interpolation accepted"))
  }
  for source in ["pub pure f(): Str { \"plain\\ntext\" }", "pub pure f(name: Nat): Str { if true { \"" + interpolation + "\" } else { \"none\" } }"] {
    checked: CheckedModuleBodies = body_test_module(source)
    results = append(results, test_expect("plain/nested interpolation accepted/" + source, len(checked.diagnostics) == 0 && len(checked.functions) == 1 && checked.functions[0].status == BodyIdentityChecked(), "literal or nested interpolation failed"))
  }
  // Both branches retain the same source-local spelling but distinct origins.
  left: LoadedModule = signature_test_module(namespace_identity("left"), "pub record Item { value: Nat }")
  right: LoadedModule = signature_test_module(namespace_identity("right"), "pub record Item { value: Nat }")
  app: LoadedModule = signature_test_module(namespace_identity("app"), "import project/left as a; import project/right as b; pure f(flag: Bool, left: a.Item, right: b.Item): a.Item { if flag { left } else { right } }; pure equal(left: a.Item, right: b.Item): Bool { left == right }")
  graph: ModuleBindingGraph = ModuleBindingGraph([app.bindings, left.bindings, right.bindings], [ModuleImportEdge(app.bindings.identity, 0, left.bindings.identity), ModuleImportEdge(app.bindings.identity, 1, right.bindings.identity)])
  distinct: CheckedModuleBodies = body_test_graph([app, left, right], graph, app)
  results = append(results, test_expect("joins and equality do not erase nominal origins", len(distinct.diagnostics) == 2 && len(distinct.functions) == 2 && distinct.functions[0].status == BodyInvalid() && distinct.functions[1].status == BodyInvalid(), "distinct nominal identities unified"))
  results
}

pure namespace_aggregate_tests(): [TestResult] {
  mut results: [TestResult] = []
  for source in [
    "pub pure f(): Nat { identity(1) }; pure identity[T](value: T): T { value }",
    "pub enum Choice { Pick(Nat) }; pub pure f(): Choice { Choice.Pick(1) }",
    "pub pure f(): Nat { [1,2][0] }",
    "pub record Box[T] { value: T }; pub pure f(): Box[Nat] { Box(1) }",
    "pub record Box[T] { value: T }; pub pure f(): Nat { Box(1).value }",
    "pub record Pair[A,B] { left: A, right: B }; pub pure f(): [Str] { Pair(1, [\"ok\"]).right }",
    "pub record Pair[T] { left: T, right: T }; pub pure f(): Pair[Int] { Pair(1, -1) }",
    "pub record Pair[T] { left: T, right: T }; pub pure f(): Pair[Int] { Pair(-1, 1) }",
    "pub record Box[T] { value: T }; pub pure f(): Box[[Nat]] { Box([]) }",
    "pub record Box[T] { value: T }; pub pure f(): Nat { value: Box[[Nat]] = Box([]); value.value[0] }",
    "pub record Box[T] { value: T }; pub pure f[T](value: T): T { Box(value).value }",
    "pub pure f(): [[Nat]] { [[], [1]] }",
    "pub pure f(): [[Nat]] { [[1], []] }",
    "pub pure f(): [[Int]] { [[1], [-1]] }",
    "pub pure f(): [Nat] { [] }",
    "pub pure f(): [Nat] { mut values: [Nat] = []; values = [1]; values }",
    "pub pure f(): Bool { None() == Some(1) }",
    "pub pure f(): Bool { [] == [1] }",
    "pub pure f(): Option[Nat] { None() }",
    "pub pure f(): Option[Nat] { Some(1) }",
    "pub pure f(): Result[Nat,Str] { Ok(1) }",
    "pub pure f(): Result[Nat,Str] { Error(\"bad\") }",
    "pub pure f(): Map[Str,Nat] { map() }",
    "pub pure f(): Set[Nat] { set() }",
    "pub pure f(flag: Bool): Option[Nat] { value = if flag { None() } else { Some(1) }; value }",
    "pub pure f(flag: Bool): Result[Nat,Str] { value = if flag { Ok(1) } else { Error(\"bad\") }; value }",
    "pub pure f(): [Option[Nat]] { values = [None(), Some(1)]; values }",
    "pub pure f(): [Option[Nat]] { values = [Some(1), None()]; values }",
    "pub pure f(): Option[[Nat]] { Some([]) }",
    "pub pure f(): Nat { take([]) }; pure take(value: [Nat]): Nat { 1 }",
    "pub pure f(): [Nat] { identity[[Nat]]([]) }; pure identity[T](value: T): T { value }",
    "pub pure f(): Str { choose([], \"ok\") }; pure choose[T](items: [T], fallback: T): T { fallback }",
    "pub pure f(): Int { choose(1, -1) }; pure choose[T](a: T, b: T): T { a }",
    "pub pure f(): Int { choose(-1, 1) }; pure choose[T](a: T, b: T): T { a }",
    "pub pure f(): Option[Nat] { choose(None(), Some(1)) }; pure choose[T](a: T, b: T): T { a }",
    "pub pure f[T](value: T): T { identity(value) }; pure identity[T](value: T): T { value }",
    "pub pure f(): Nat { 1.identity() }; pure identity[T](value: T): T { value }",
    "pub pure f(): Fn[Nat] { choose(@answer) }; pure choose[T](callback: Fn[T]): Fn[T] { callback }; pure answer(): Nat { 1 }",
    "pub pure f(value: Option[Nat]): Nat { match value { Some(item) => item, None() => 0 } }",
    "pub pure f(value: Result[Nat,Str]): Nat { match value { Ok(item) => item, Error(message) => 0 } }",
    "pub enum Choice[T] { Pick(T), Empty }; pub pure f(value: Choice[Nat]): Nat { match value { Choice.Pick(item) => item, Empty() => 0 } }",
    "pub enum Choice[T] { Pick(T), Empty }; pub pure f[T](value: Choice[T], fallback: T): T { match value { Pick(item) => item, Empty() => fallback } }",
    "pub enum Choice[T] { Pick(T), Empty }; pub pure f(): Choice[Nat] { Empty() }",
    "pub enum Choice[T] { Pick(T), Empty }; pub pure f(flag: Bool): Choice[Nat] { value = if flag { Pick(1) } else { Empty() }; value }",
    "pub enum Choice { Pick(Nat), Empty }; pub pure f(value: Choice): Int { match value { Pick(item) => item, Empty() => -1 } }",
    "pub enum Choice { Pick(Nat), Empty }; pub pure f(value: Choice): Option[Nat] { result = match value { Pick(item) => Some(item), Empty() => None() }; result }",
    "pub pure f(value: Option[Option[Nat]]): Nat { match value { Some(inner) => match inner { Some(item) => item, None() => 0 }, None() => 0 } }",
    "pub record Box[T] { value: T }; pub pure f(): [Nat] { mut result: [Nat] = []; result = Box([]).value; result }"
  ] {
    checked: CheckedModuleBodies = body_test_module(source)
    message: Str = if len(checked.diagnostics) > 0 { checked.diagnostics[0].message } else { "missing/invalid/deferred body" }
    results = append(results, test_expect("aggregate identity checks/" + source, len(checked.diagnostics) == 0 && len(checked.functions) > 0 && checked.functions[0].status == BodyIdentityChecked(), message))
  }
  for source in [
    "pub record Box[T] { value: T }; pub pure f(): Box[Nat] { Box() }",
    "pub record Box[T] { value: T }; pub pure f(): Box[Nat] { Box(1,2) }",
    "pub record Box { value: Nat }; pub pure f(): Box { Box(\"bad\") }",
    "pub record Box[T] { value: T }; pub pure f(): Box[Nat] { Box[Nat](1) }",
    "pub record Pair[T] { left: T, right: T }; pub pure f(): Pair[Nat] { Pair(1, \"bad\") }",
    "pub record Box { value: Nat }; pub pure f(value: Box): Nat { value.missing }",
    "pub pure f(value: Nat): Nat { value.missing }",
    "pub enum Choice { Pick }; pub pure f(value: Choice): Nat { value.missing }",
    "pub pure f(): [Nat] { [1, \"bad\", 2] }",
    "pub pure f(): [Nat] { [1, 1.5] }",
    "pub pure f(): [Nat] { [nothing()] }; pure nothing(): Void {}",
    "pub pure f(): Option[Nat] { Some(nothing()) }; pure nothing(): Void {}",
    "pub pure f(): Option[Nat] { Some() }",
    "pub pure f(): Option[Nat] { None(1) }",
    "pub pure f(): Option[Nat] { Some[Nat](1) }",
    "pub pure f(): Map[Nat,Nat] { map(1) }",
    "pub pure f(): Map[Nat,Nat] { map[Nat,Nat]() }",
    "pub pure f(): Set[Nat] { set(1) }",
    "pub pure f(): [Nat] { value = []; value }",
    "pub pure f(): Option[Nat] { value = None(); value }",
    "pub pure f(): Option[[Nat]] { value = Some([]); value }",
    "pub pure f(): Map[Nat,Nat] { value = map(); value }",
    "pub pure f(): Set[Nat] { value = set(); value }",
    "pub pure f(): [Nat] { mut value = []; value = [1]; value }",
    "pub pure f(): [Nat] { value: [Nat] = identity([]); value }; pure identity[T](value: T): T { value }",
    "pub pure f(): Nat { make() }; pure make[T](): T { make[T]() }",
    "pub pure f(): Nat { choose(1, \"bad\", 2) }; pure choose[T](a:T,b:T,c:T):T { a }",
    "pub pure f(): Nat { identity[Nat](-1) }; pure identity[T](value:T):T { value }",
    "pub pure f[T](value:T):T { choose(value, 1) }; pure choose[U](a:U,b:U):U { a }",
    "pub pure f(): Nat { identity(nothing()) }; pure identity[T](value:T):T { value }; pure nothing():Void {}",
    "pub pure f(value: Option[Nat]): Nat { match value { Some(item) => item } }",
    "pub pure f(value: Option[Nat]): Nat { match value { Some(item) => item, None() => 0, None() => 1 } }",
    "pub pure f(value: Option[Nat]): Nat { match value { Some() => 1, None() => 0 } }",
    "pub pure f(value: Option[Nat]): Nat { match value { Some(a,b) => a, None() => 0 } }",
    "pub pure f(value: Option[Nat]): Nat { match value { Ok(item) => item, None() => 0 } }",
    "pub pure f(value: Option[Nat]): Nat { match value { Some(item) => { item = 2; item }, None() => 0 } }",
    "pub pure f(value: Option[Nat]): Nat { match value { Some(item) => item, None() => \"bad\" } }",
    "pub enum Choice { Pick }; pub pure f(value: Choice): Nat { match value { Choice.Pick() => 1, Pick() => 2 } }",
    "pub enum Choice { Pick(Nat,Nat) }; pub pure f(value: Choice): Nat { match value { Pick(item,item) => item } }",
    "pub enum Choice { Pick }; pub pure f(): Choice { Choice() }",
    "pub enum Choice { Pick }; pub pure f(value: Choice): Nat { match value { helper() => 1 } }; pure helper():Nat { 1 }"
  ] {
    checked: CheckedModuleBodies = body_test_module(source)
    results = append(results, test_expect("aggregate identity rejects/" + source, len(checked.diagnostics) > 0 && len(checked.functions) > 0 && checked.functions[0].status == BodyInvalid(), "invalid aggregate appeared checked/deferred"))
  }
  for source in [
    "pub pure f(): [Nat] { [2 - 1] }",
    "pub record Box[T] { value:T }; pub pure f(): Box[Nat] { Box(2 - 1) }",
    "pub pure f(): Nat { match Some(2 - 1) { Some(item) => item, None() => 0 } }",
    "pub pure f(): Nat { identity(2 - 1) }; pure identity[T](value:T):T { value }",
    "pub pure f(): Nat { match Some(1) { Some(item) => unknown_core(item), None() => 0 } }; pure unknown_core(value:Nat):Nat { value - 1 }"
  ] {
    checked: CheckedModuleBodies = body_test_module(source)
    mut pending: Bool = false
    for function in checked.functions { pending = pending || function.status == BodyDeferred() }
    results = append(results, test_expect("aggregate retains later obligations/" + source, len(checked.diagnostics) == 0 && pending, "later proof/core check lost or rejected"))
  }
  for source in ["pub pure f(): Map[Nat,Nat] { map().put(1, 2) }", "pub pure f(): Set[Nat] { set().add(1) }"] {
    checked: CheckedModuleBodies = body_test_module(source)
    results = append(results, test_expect("core receiver contract checks/" + source,
      len(checked.diagnostics) == 0 && checked.functions[0].status == BodyIdentityChecked(),
      if len(checked.diagnostics) > 0 { checked.diagnostics[0].message } else { "core receiver contract remained deferred" }))
  }
  results = append(results, test_equal_str("inference failure explains missing evidence", body_test_error("pub pure f(): [Nat] { identity([]) }; pure identity[T](value:T):T { value }"), "cannot infer type parameter T for identity; supply explicit type arguments"))
  results = append(results, test_equal_str("constructor arity is concrete", body_test_error("pub record Box { value:Nat }; pub pure f():Box { Box() }"), "Box expects 1 arguments, got 0"))
  results = append(results, test_equal_str("missing variant is named", body_test_error("pub pure f(value:Option[Nat]):Nat { match value { Some(item) => item } }"), "non-exhaustive match; missing None"))
  for source in [
    "pub record Pair[A,B]{first:A,second:B}; pub pure f():Pair[Nat,Str] { match None() { None()=>Pair(1,\"x\"), Some(value)=>Pair(value,value) } }",
    "pub pure f():Option[Nat] { value = if true { 2 - 1; None() } else { None() }; value }",
    "pub pure f():Nat { match None() { None()=>0, Some(v)=>{ consume(v); v } } }; pure consume(value:Str):Void {}",
    "pub pure f():Nat { match None() { None()=>0, Some(v)=>{ consume(v,v); v } } }; pure consume(a:Nat,b:Str):Void {}",
    "pub pure f():[Option[Nat]] { match None() { None()=>[Some(1)], Some(value)=>[value,Some(value)] } }"
  ] {
    checked: CheckedModuleBodies = body_test_module(source)
    results = append(results, test_expect("conflicting or incomplete hole evidence rejects/" + source, len(checked.diagnostics)>0 && len(checked.functions)>0 && checked.functions[0].status==BodyInvalid(), if len(checked.diagnostics)>0 { checked.diagnostics[0].message } else { "hole conflict hidden by context or proof deferral" }))
  }
  for source in ["pub pure f():Void { []; }", "pub pure f():Void { None(); }", "pub pure f():Void { for item in [] {} }"] {
    checked: CheckedModuleBodies = body_test_module(source)
    results = append(results, test_expect("discarded unresolved evidence stays explicit/" + source, len(checked.diagnostics)==0 && checked.functions[0].status==BodyDeferred(), "retained holes silently certified"))
  }
  for source in [
    "pub pure f():Nat { match [1].first() { helper()=>0 } }; pure helper():Nat { 0 }",
    "pub record Box { value:Nat }; pub pure f():Nat { match [1].first() { Box(value)=>0 } }",
    "pub pure f():Nat { match [1].first() { map()=>0 } }",
    "pub pure f():Nat { match [1].first() { Some(a,b)=>0, None()=>0 } }"
  ] {
    checked: CheckedModuleBodies = body_test_module(source)
    results = append(results, test_expect("unknown subject retains independent pattern rejection/" + source, len(checked.diagnostics)>0 && len(checked.functions)>0 && checked.functions[0].status==BodyInvalid(), "known pattern error hidden by deferred subject"))
  }
  unknown_subject: CheckedModuleBodies = body_test_module("pub pure f():Nat { match [1].first() { Some(item)=>0, None()=>0 } }")
  results = append(results, test_expect("unknown subject with valid pattern contracts stays deferred", len(unknown_subject.diagnostics)==0 && unknown_subject.functions[0].status==BodyDeferred(), "unknown subject invented membership acceptance or rejection"))
  results = concat(results, namespace_aggregate_origin_tests())
  results
}

pure namespace_aggregate_origin_tests(): [TestResult] {
  mut results: [TestResult] = []
  left: LoadedModule = signature_test_module(namespace_identity("left"), "pub record Item { value:Nat }; pub record Box[T] { value:T }; pub enum Choice[T] { Pick(T), Empty }; pub pure id[T](value:T):T { value }")
  right: LoadedModule = signature_test_module(namespace_identity("right"), "pub record Item { value:Nat }; pub enum Choice[T] { Pick(T), Empty }")
  for source in [
    "pure f():a.Box[a.Item] { a.Box(a.Item(1)) }",
    "pure f():a.Item { a.id(a.Item(1)) }",
    "pure f(value:a.Box[a.Item]):a.Item { value.value }",
    "pure f(value:a.Choice[a.Item]):a.Item { match value { a.Choice.Pick(item) => item, a.Choice.Empty() => a.Item(0) } }",
    "pure f():[a.Item] { [a.Item(1), alias.Item(2)] }"
  ] {
    app: LoadedModule = signature_test_module(namespace_identity("app"), "import project/left as a; import project/right as b; import project/left as alias; " + source)
    graph: ModuleBindingGraph = ModuleBindingGraph([app.bindings,left.bindings,right.bindings], [ModuleImportEdge(app.bindings.identity,0,left.bindings.identity),ModuleImportEdge(app.bindings.identity,1,right.bindings.identity),ModuleImportEdge(app.bindings.identity,2,left.bindings.identity)])
    checked: CheckedModuleBodies = body_test_graph([app,left,right],graph,app)
    results = append(results, test_expect("aggregate preserves aliases/" + source, len(checked.diagnostics)==0 && len(checked.functions)==1 && checked.functions[0].status==BodyIdentityChecked(), if len(checked.diagnostics)>0 { checked.diagnostics[0].message } else { "not checked" }))
  }
  for source in [
    "pure f():a.Box[a.Item] { a.Box(b.Item(1)) }",
    "pure f():a.Item { a.id(b.Item(1)) }",
    "pure f(value:a.Box[b.Item]):a.Item { value.value }",
    "pure f():[a.Item] { [a.Item(1), b.Item(2)] }",
    "pure f(value:a.Choice[a.Item]):a.Item { match value { b.Choice.Pick(item) => item, a.Choice.Empty() => a.Item(0) } }",
    "pure f(value:a.Choice[Nat]):Nat { match value { a.Choice.Pick(item) => item, alias.Choice.Pick(item) => item, a.Choice.Empty() => 0 } }"
  ] {
    app: LoadedModule = signature_test_module(namespace_identity("app"), "import project/left as a; import project/right as b; import project/left as alias; " + source)
    graph: ModuleBindingGraph = ModuleBindingGraph([app.bindings,left.bindings,right.bindings], [ModuleImportEdge(app.bindings.identity,0,left.bindings.identity),ModuleImportEdge(app.bindings.identity,1,right.bindings.identity),ModuleImportEdge(app.bindings.identity,2,left.bindings.identity)])
    checked: CheckedModuleBodies = body_test_graph([app,left,right],graph,app)
    results = append(results, test_expect("aggregate rejects wrong nominal/" + source, len(checked.diagnostics)>0 && len(checked.functions)==1 && checked.functions[0].status==BodyInvalid(), "nominal identity or alias uniqueness lost"))
  }
  refined: CheckedModuleBodies = body_test_module("pub record Pair[A,B] { left:A,right:B }; pub pure f():Pair[Option[Nat],Option[Str]] { Pair(None(),None()) }")
  results = append(results, test_expect("independent constructor holes refine separately", len(refined.diagnostics)==0 && len(refined.functions)==1 && refined.functions[0].status==BodyIdentityChecked(), "independent holes captured each other"))
  if len(refined.functions)==1 {
    pair: BoundBody = refined.functions[0].body.children[0]
    results = append(results, test_expect("context reaches first constructor child", pair.children[0].type==Some(SignatureType(SignatureCore("Option"),[SignatureType(SignatureCore("Nat"),[])])), "first child not specialized"))
    results = append(results, test_expect("context reaches second constructor child", pair.children[1].type==Some(SignatureType(SignatureCore("Option"),[SignatureType(SignatureCore("Str"),[])])), "second child not specialized"))
  }
  results
}


pure namespace_else_if_tests(): [TestResult] {
  mut results: [TestResult] = []
  for source in [
    "pub pure f(a:Bool,b:Bool):Nat { if a { 1 } else if b { 2 } else { 3 } }",
    "pub pure f(a:Bool,b:Bool,c:Bool):Void { if a { 1 } else if b { \"discard\" } else if c { true } }"
  ] {
    checked: CheckedModuleBodies = body_test_module(source)
    results = append(results, test_expect("namespace else-if accepts/" + source,
      len(checked.diagnostics) == 0 && checked.functions[0].status == BodyIdentityChecked(),
      "chain was invalid or deferred"))
  }
  for source in [
    "pub pure f(a:Bool):Nat { if a { 1 } else if 7 { 2 } else { 3 } }",
    "pub pure f(a:Bool,b:Bool):Nat { if a { 1 } else if b { 2 } }",
    "pub pure f(a:Bool,b:Bool):Nat { if a { 1 } else if b { \"bad\" } else { 3 } }"
  ] {
    checked: CheckedModuleBodies = body_test_module(source)
    results = append(results, test_expect("namespace else-if rejects/" + source,
      len(checked.diagnostics) > 0 && checked.functions[0].status == BodyInvalid(),
      "invalid chain appeared checked"))
  }
  results
}
