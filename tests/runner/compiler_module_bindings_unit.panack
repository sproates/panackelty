    "argument 2 to starts_with is Nat, expected Str"
  ))
  results = append(results, std_testing.equal_str(
    "starts_with checks arity",
    body_test_error("pub pure f(value: Str): Bool { value.starts_with() }"),
    "starts_with expects 2 arguments, got 1"
  ))
  results = append(results, std_testing.equal_str(
    "reverse checks arity",
    body_test_error("pub pure f(value: Str): Str { value.reverse(1) }"),
    "reverse expects 1 arguments, got 2"
  ))
  results = append(results, std_testing.equal_str(
