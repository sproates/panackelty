pure namespace_parse(source: Str): Result[ParsedModule,Diagnostic] {
  match lex_file(source, "module.panack") {
    Ok(tokens) => parse_module_complete(tokens),
    Error(errors) => Error(errors[0])
  }
}

pure namespace_parse_error(source: Str): Str {
  match namespace_parse(source) {
    Error(error) => diagnostic_text(error),
    Ok(parsed) => "unexpected success"
  }
}

pure namespace_export_name(bindings: ModuleBindings, selector: Str): Str {
  match module_export(bindings, selector) {
    Error(message) => message,
    Ok(binding) => binding.identity.module.path + ":" + binding.identity.name
  }
}

pure namespace_toolchain_bindings(project: LoadedProject, path: Str): Option[ModuleBindings] {
  mut found: Option[ModuleBindings] = None()
  for module in project.modules {
    if module.bindings.identity.package == ToolchainModulePackage() &&
      module.bindings.identity.path == path {
      found = Some(module.bindings)
    } else {}
  }
  found
}

stdlib_public_api_tests(): [TestResult] {
  loaded: LoadedProject = load_project("tests/functional/cases/stdlib/main.panack")
  path: Option[ModuleBindings] = namespace_toolchain_bindings(loaded, "path.panack")
  filesystem: Option[ModuleBindings] = namespace_toolchain_bindings(loaded, "filesystem.panack")
  mut results: [TestResult] = []
  match path {
    None() => { results = append(results, std_testing.expect("typed path module loaded", false, "missing path.panack")) },
    Some(bindings) => {
      results = append(results, std_testing.equal_str("typed path constructor is public", namespace_export_name(bindings, "from_text"), "path.panack:from_text"))
      results = append(results, std_testing.equal_str("legacy string path wrapper is removed", namespace_export_name(bindings, "path_string_join"), "module has no exported declaration path_string_join"))
    }
  }
  match filesystem {
    None() => { results = append(results, std_testing.expect("typed filesystem module loaded", false, "missing filesystem.panack")) },
    Some(bindings) => {
      results = append(results, std_testing.equal_str("typed file read is public", namespace_export_name(bindings, "read"), "filesystem.panack:read"))
      results = append(results, std_testing.equal_str("legacy trapping text read is removed", namespace_export_name(bindings, "filesystem_read_text"), "module has no exported declaration filesystem_read_text"))
      results = append(results, std_testing.equal_str("legacy trapping existence check is removed", namespace_export_name(bindings, "filesystem_exists"), "module has no exported declaration filesystem_exists"))
    }
  }
  results
}

pure namespace_syntax_tests(): [TestResult] {
  mut results: [TestResult] = []
  source: Str = "// heading\nimport project/math as arithmetic\npub import project/errors::{HttpError.Timeout as timed_out, HttpError}\npub pure answer(): Nat { 42 }\nrecord Private { value: Nat }"
  match namespace_parse(source) {
    Error(error) => { results = append(results, std_testing.expect("namespace metadata parses", false, diagnostic_text(error))) },
    Ok(parsed) => {
      results = append(results, std_testing.equal_nat("retained declaration count", len(parsed.program.declarations), 4))
      results = append(results, std_testing.equal_nat("one metadata row per declaration", len(parsed.syntax), 4))
      results = append(results, std_testing.equal_nat("import source line", parsed.syntax[0].span.start.line, 2))
      results = append(results, std_testing.equal_str("import source file", parsed.syntax[0].span.start.file, "module.panack"))
      results = append(results, std_testing.equal_nat("import span end", parsed.syntax[0].span.end.column, 34))
      results = append(results, std_testing.expect("visibility remains per declaration", !parsed.syntax[0].is_public && parsed.syntax[1].is_public && parsed.syntax[2].is_public && !parsed.syntax[3].is_public, "wrong visibility"))
      match parsed.syntax[0].binding {
        NamespaceImportBinding(alias, explicit_alias) => {
          results = append(results, std_testing.expect("explicit namespace alias retained", alias == "arithmetic" && explicit_alias, "wrong alias"))
        },
        NoImportBinding() => { results = append(results, std_testing.expect("alias kind", false, "missing binding")) },
        SelectiveImportBinding(selectors) => { results = append(results, std_testing.expect("alias kind", false, "selective binding")) }
      }
      match parsed.syntax[1].binding {
        SelectiveImportBinding(selectors) => {
          results = append(results, std_testing.equal_nat("selector count", len(selectors), 2))
          results = append(results, std_testing.equal_str("qualified variant selector", selectors[0].name, "HttpError.Timeout"))
          results = append(results, std_testing.equal_str("selective alias", selectors[0].alias, "timed_out"))
          results = append(results, std_testing.equal_str("default selective alias", selectors[1].alias, "HttpError"))
          results = append(results, std_testing.equal_nat("selector span", selectors[0].span.start.column, 29))
        },
        NoImportBinding() => { results = append(results, std_testing.expect("selector kind", false, "missing binding")) },
        NamespaceImportBinding(alias, explicit_alias) => { results = append(results, std_testing.expect("selector kind", false, "namespace binding")) }
      }
      results = append(results, std_testing.equal_nat("staged forms all rejected", len(module_execution_diagnostics(parsed)), 3))
    }
  }
  results = append(results, std_testing.equal_str("logical default alias", default_import_alias("project/shared/math"), "math"))
  results = append(results, std_testing.equal_str("quoted default alias", default_import_alias("../shared/math.panack"), "math"))
  results = append(results, std_testing.equal_str("missing alias", namespace_parse_error("import project/math as"), "module.panack:1:23: expected namespace alias after as"))
  results = append(results, std_testing.equal_str("empty selectors", namespace_parse_error("import project/math::{}"), "module.panack:1:23: expected imported declaration name"))
  results = append(results, std_testing.equal_str("missing selective alias", namespace_parse_error("import project/math::{sum as}"), "module.panack:1:29: expected import alias after as"))
  results
}

pure namespace_binding_tests(): [TestResult] {
  mut results: [TestResult] = []
  identity: ModuleIdentity = ModuleIdentity(StandaloneModulePackage(), "math.panack")
  match namespace_parse("pub record Vector { value: Nat }\npub enum Failure { Missing, Detail(Str) }\npure helper(): Nat { 1 }\npub pure answer(): Nat { helper() }") {
    Error(error) => { results = append(results, std_testing.expect("bindings parse", false, diagnostic_text(error))) },
    Ok(parsed) => {
      bindings: ModuleBindings = collect_module_bindings(identity, parsed)
      results = append(results, std_testing.equal_nat("type variant function inventory", len(bindings.declarations), 6))
      results = append(results, std_testing.equal_str("record exported identity", namespace_export_name(bindings, "Vector"), "math.panack:Vector"))
      results = append(results, std_testing.equal_str("enum exported identity", namespace_export_name(bindings, "Failure"), "math.panack:Failure"))
      results = append(results, std_testing.equal_str("variant exported identity", namespace_export_name(bindings, "Failure.Detail"), "math.panack:Detail"))
      results = append(results, std_testing.equal_str("variant selection must be explicit", namespace_export_name(bindings, "Detail"), "module has no exported declaration Detail"))
      results = append(results, std_testing.equal_str("private helper rejected", namespace_export_name(bindings, "helper"), "module declaration helper is private"))
      other: ModuleBindings = collect_module_bindings(ModuleIdentity(StandaloneModulePackage(), "other.panack"), parsed)
      results = append(results, std_testing.expect("same spelling distinct module identity", bindings.declarations[0].identity != other.declarations[0].identity, "identities collapsed"))
      results = append(results, std_testing.expect("package identity is tagged", identity != ModuleIdentity(ToolchainModulePackage(), "math.panack"), "package tags collapsed"))
      geometry: ModuleIdentity = source_package_module_identity("/work/geometry/src/vector.panack", "/work/geometry/src", "/toolchain/stdlib", "geometry.core", "1.2.3")
      geometry_copy: ModuleIdentity = source_package_module_identity("/relocated/geometry/src/vector.panack", "/relocated/geometry/src", "/toolchain/stdlib", "geometry.core", "1.2.3")
      other_geometry: ModuleIdentity = source_package_module_identity("/work/geometry/src/vector.panack", "/work/geometry/src", "/toolchain/stdlib", "geometry.other", "1.2.3")
      results = append(results, std_testing.expect("manifest identity survives relocation", geometry == geometry_copy, "physical checkout leaked into semantic identity"))
      results = append(results, std_testing.expect("manifest package names distinguish modules", geometry != other_geometry, "distinct package identities collapsed"))
      results = append(results, std_testing.equal_str("manifest module path is source-root relative", geometry.path, "vector.panack"))
    }
  }
  match namespace_parse("import project/one as shared\nimport project/one as shared\nimport project/two::{answer as local}\npure local(): Nat { 1 }\nimport project/three as print") {
    Error(error) => { results = append(results, std_testing.expect("conflicts parse", false, diagnostic_text(error))) },
    Ok(parsed) => {
      errors: [Diagnostic] = module_binding_diagnostics(collect_module_bindings(identity, parsed))
      results = append(results, std_testing.equal_nat("all binding collisions rejected", len(errors), 3))
      results = append(results, std_testing.equal_str("repeated identical alias rejected", diagnostic_text(errors[0]), "module.panack:2:1: import binding shared conflicts with an existing module binding"))
      results = append(results, std_testing.equal_str("declaration alias collision", errors[1].message, "import binding local conflicts with an existing module binding"))
      results = append(results, std_testing.equal_str("builtin alias collision", errors[2].message, "import binding print conflicts with a built-in"))
    }
  }
  results = append(results, std_testing.equal_str("standalone relative path", source_module_identity("/one/app/lib/math.panack", "/one/app", "/tool/stdlib").path, "lib/math.panack"))
  results = append(results, std_testing.expect("relocation preserves semantic identity", source_module_identity("/one/app/lib/math.panack", "/one/app", "/tool/stdlib") == source_module_identity("/two/app/lib/math.panack", "/two/app", "/other/stdlib"), "relocation changed identity"))
  results = append(results, std_testing.equal_str("bootstrap parent path is relative", module_relative_path("/repo/src/bytecode/codec.panack", "/repo/src/compiler"), "../bytecode/codec.panack"))
  results = append(results, std_testing.equal_str("root path identity", module_relative_path("/main.panack", "/"), "main.panack"))
  results
}

pure namespace_execution_boundary_tests(): [TestResult] {
  mut results: [TestResult] = []
  message: Str = "namespace syntax is parsed but execution is not yet supported (language namespace migration pending)"
  for source in ["pub main(): Void {}", "import project/math as api; main(): Void {}", "import project/math::{answer}; main(): Void {}", "pub import project/math; main(): Void {}"] {
    results = append(results, std_testing.equal_str("resolver fails closed", resolve_source(source), message))
    results = append(results, std_testing.equal_str("checker fails closed", check_source_types(source), message))
    results = append(results, std_testing.equal_str("purity fails closed", check_source_frontend(source), message))
    results = append(results, std_testing.equal_str("emitter fails closed", compile_source_disassembly(source), message))
    results = append(results, std_testing.expect("codec emits no runnable artifact", compile_source_bytecode(source) == bytes(), "namespace syntax emitted bytecode"))
  }
  results
}

pure namespace_origin_tests(): [TestResult] {
  mut results: [TestResult] = []
  mut modules: [LoadedModule] = []
  for source in [LoadedSource("first.panack", "pure helper(): Nat { 1 }"),
      LoadedSource("second.panack", "\npure helper(): Nat { 2 }"),
      LoadedSource("third.panack", "\n\npure helper(): Nat { 3 }")] {
    match lex_file(source.source, source.path) {
      Error(errors) => { results = append(results, std_testing.expect("origin source lexes", false, "lex failure")) },
      Ok(tokens) => match parse_module_complete(tokens) {
        Error(error) => { results = append(results, std_testing.expect("origin source parses", false, error.message)) },
        Ok(parsed) => {
          bindings: ModuleBindings = collect_module_bindings(ModuleIdentity(StandaloneModulePackage(), source.path), parsed)
          modules = append(modules, LoadedModule(source.path, parsed, parsed.program, bindings, loaded_module_declaration_index(parsed)))
        }
      }
    }
  }
  errors: [Diagnostic] = resolve_program_at(append_program_declarations(module_programs(modules)), module_declaration_positions(modules))
  results = append(results, std_testing.equal_str("three duplicates retain separate origins", render_resolver_diagnostics(errors),
    "second.panack:2:1: top-level name helper is already declared\nthird.panack:3:1: top-level name helper is already declared"))
  match namespace_parse("pure Pick(): Nat { 1 }\nenum Choice { Pick }") {
    Error(error) => { results = append(results, std_testing.expect("variant source parses", false, error.message)) },
    Ok(parsed) => {
      errors2: [Diagnostic] = resolve_program_at(parsed.program, [parsed.syntax[0].span.start, parsed.syntax[1].span.start])
      results = append(results, std_testing.equal_str("function conflict attributed to function", render_resolver_diagnostics(errors2),
        "module.panack:1:1: top-level name Pick conflicts with a constructor or built-in"))
    }
  }
  results
}


main(): Void {
  mut results: [TestResult] = namespace_syntax_tests().concat(namespace_binding_tests()).concat(namespace_execution_boundary_tests()).concat(namespace_origin_tests()).concat(namespace_resolution_tests()).concat(namespace_qualified_syntax_tests()).concat(namespace_resolution_failure_tests()).concat(namespace_lexical_receiver_tests()).concat(namespace_signature_tests()).concat(namespace_body_tests()).concat(namespace_effect_tests()).concat(namespace_expression_tests()).concat(namespace_aggregate_tests()).concat(namespace_else_if_tests()).concat(module_emission_identity_tests()).concat(module_emission_program_tests()).concat(module_emission_effect_tests()).concat(module_emission_status_tests()).concat(stdlib_public_api_tests())
  loaded: LoadedProject = load_project("tests/fixtures/compiler_contracts/indexed_lookup/main.panack")
  results = append(results, std_testing.expect(
    "existing project resolves with identity-checked bodies",
    loaded.identity_ready,
    "loaded project is not identity ready"
  ))
  mut saw_main: Bool = false
  mut saw_core: Bool = false
  for module in loaded.modules {
    if module.bindings.identity.path == "main.panack" { saw_main = len(module.bindings.declarations) > 0 } else {}
    if module.bindings.identity == ModuleIdentity(ToolchainModulePackage(), "core.panack") {
      for declaration in module.bindings.declarations {
        if declaration.identity.name == "core_first" { saw_core = true } else {}
      }
    } else {}
  }
  results = append(results, std_testing.expect("loader retains entry module bindings", saw_main, "missing entry metadata"))
  results = append(results, std_testing.expect("core origin precedes internalization", saw_core, "missing original core name"))
  if std_testing.report(results) > 0 { std_host.exit(1) }
}

pure module_emission_identity_tests(): [TestResult] {
  entry: ModuleIdentity = namespace_identity("app")
  left: ModuleIdentity = namespace_identity("left")
  right: ModuleIdentity = namespace_identity("right")
  graph: ModuleBindingGraph = ModuleBindingGraph([
    ModuleBindings(left, [], []),
    ModuleBindings(right, [], []),
    ModuleBindings(entry, [], [])
  ], [])
  left_name: Str = module_emission_symbol(graph, entry, DeclarationIdentity(left, "same"))
  right_name: Str = module_emission_symbol(graph, entry, DeclarationIdentity(right, "same"))
  mut results: [TestResult] = []
  results = append(results, std_testing.equal_str(
    "module emission names left origin",
    left_name,
    "$module0_same"
  ))
  results = append(results, std_testing.equal_str(
    "module emission names right origin",
    right_name,
    "$module1_same"
  ))
  results = append(results, std_testing.expect(
    "module emission separates equal source names",
    left_name != right_name,
    "source declaration spellings collided: " + left_name
  ))
  results = append(results, std_testing.equal_str(
    "module emission reserves entry main",
    module_emission_symbol(graph, entry, DeclarationIdentity(entry, "main")),
    "main"
  ))
  results = append(results, std_testing.expect(
    "module emission renames imported main",
    module_emission_symbol(graph, entry, DeclarationIdentity(left, "main")) != "main",
    "imported main collides with the entry"
  ))
  results
}

module_emission_guard_call_name(expression: Expr): Str {
  match unlocated_expression(expression) {
    CallExpr(name, arguments, types) => name,
    LocatedExpr(span, value, located_type_argument_spans) => "",
    NatExpr(value) => "",
    DecimalExpr(value) => "",
    StringExpr(value) => "",
    BoolExpr(value) => "",
    NameExpr(name) => "",
    FunctionExpr(name) => "",
    ArrayExpr(items) => "",
    UnaryExpr(operator, value) => "",
    BinaryExpr(operator, left, right) => "",
    DotCallExpr(target, name, arguments, types) => "",
    FieldExpr(target, name) => "",
    IndexExpr(target, index) => "",
    IfExpr(condition, yes, no, has_else) => "",
    BlockExpr(block) => "",
    MatchExpr(subject, arms) => ""
  }
}

module_emission_program_tests(): [TestResult] {
  entry_path: Str = path_support.resolve("tests/fixtures/compiler_contracts/namespaces/emission/main.panack")
  project_root: Str = path_support.parent(entry_path)
  stdlib_root: Str = path_support.resolve(std_option.value_or(std_environment.get("PANACKELTY_STDLIB_PATH"), ""))
  loaded: LoadedProject = load_project(entry_path)
  graph: ModuleBindingGraph = loaded_binding_graph(loaded.modules, project_root, stdlib_root)
  identity: ModuleIdentity = source_module_identity(entry_path, project_root, stdlib_root)
  emitted: ModuleEmissionResult = module_emission_program(graph, loaded.modules, loaded.module_signatures, loaded.module_bodies, identity)
  mut results: [TestResult] = []
  results = append(results, std_testing.expect("identity emission accepts checked public fixture", len(emitted.diagnostics) == 0, if len(emitted.diagnostics) > 0 { emitted.diagnostics[0].message } else { "unexpected emission failure" }))
  results = append(results, std_testing.expect("identity emission retains only entry main", emitted.program.function_indices.has("main"), "entry main missing"))
  left_identity: ModuleIdentity = source_module_identity(path_support.join(project_root, "left.panack"), project_root, stdlib_root)
  right_identity: ModuleIdentity = source_module_identity(path_support.join(project_root, "right.panack"), project_root, stdlib_root)
  left_make: Str = module_emission_symbol(graph, identity, DeclarationIdentity(left_identity, "make"))
  right_make: Str = module_emission_symbol(graph, identity, DeclarationIdentity(right_identity, "make"))
  left_main: Str = module_emission_symbol(graph, identity, DeclarationIdentity(left_identity, "main"))
  right_main: Str = module_emission_symbol(graph, identity, DeclarationIdentity(right_identity, "main"))
  left_item: Str = module_emission_symbol(graph, identity, DeclarationIdentity(left_identity, "Item"))
  right_item: Str = module_emission_symbol(graph, identity, DeclarationIdentity(right_identity, "Item"))
  left_envelope: Str = module_emission_symbol(graph, identity, DeclarationIdentity(left_identity, "Envelope"))
  right_envelope: Str = module_emission_symbol(graph, identity, DeclarationIdentity(right_identity, "Envelope"))
  left_outcome: Str = module_emission_symbol(graph, identity, DeclarationIdentity(left_identity, "Outcome"))
  right_outcome: Str = module_emission_symbol(graph, identity, DeclarationIdentity(right_identity, "Outcome"))
  left_finished: Str = module_emission_symbol(graph, identity, DeclarationIdentity(left_identity, "Finished"))
  right_finished: Str = module_emission_symbol(graph, identity, DeclarationIdentity(right_identity, "Finished"))
  left_positive: Str = module_emission_symbol(graph, identity, DeclarationIdentity(left_identity, "positive"))
  right_positive: Str = module_emission_symbol(graph, identity, DeclarationIdentity(right_identity, "positive"))
  mut left_guard_call: Str = ""
  mut right_guard_call: Str = ""
  for declaration in emitted.program.declarations {
    match declaration {
      TypeDeclaration(name, base, guard) => {
        if name == module_emission_symbol(graph, identity, DeclarationIdentity(left_identity, "Positive")) {
          left_guard_call = module_emission_guard_call_name(guard)
        } else if name == module_emission_symbol(graph, identity, DeclarationIdentity(right_identity, "Positive")) {
          right_guard_call = module_emission_guard_call_name(guard)
        } else {}
      },
      ImportDeclaration(path) => {},
      RecordDeclaration(name, parameters, fields) => {},
      EnumDeclaration(name, parameters, variants) => {},
      FunctionDeclaration(name, parameters, return_type, pure_flag, async_flag, body, type_parameters) => {}
    }
  }
  results = append(results, std_testing.expect("identity emission binds left guarded type helper", left_guard_call == left_positive && left_guard_call != right_positive, left_guard_call))
  results = append(results, std_testing.expect("identity emission binds right guarded type helper", right_guard_call == right_positive && right_guard_call != left_positive, right_guard_call))
  results = append(results, std_testing.expect("identity emission includes left same-spelled function", emitted.program.function_indices.has(left_make), left_make + " missing"))
  results = append(results, std_testing.expect("identity emission includes right same-spelled function", emitted.program.function_indices.has(right_make), right_make + " missing"))
  results = append(results, std_testing.expect("identity emission internalizes imported mains", left_main != "main" && right_main != "main" && emitted.program.function_indices.has(left_main) && emitted.program.function_indices.has(right_main), "imported main was not internalized"))
  results = append(results, std_testing.expect("identity emission keeps same-spelled functions distinct", left_make != right_make, "make identities collided"))
  results = append(results, std_testing.expect("identity emission keeps same-spelled records distinct", emitted.program.record_indices.has(left_item) && emitted.program.record_indices.has(right_item) && left_item != right_item, "Item identities collided"))
  results = append(results, std_testing.expect("identity emission keeps same-spelled nested generic records distinct", emitted.program.record_indices.has(left_envelope) && emitted.program.record_indices.has(right_envelope) && left_envelope != right_envelope, "Envelope identities collided"))
  results = append(results, std_testing.expect("identity emission keeps same-spelled enums distinct", emitted.program.enum_indices.has(left_outcome) && emitted.program.enum_indices.has(right_outcome) && left_outcome != right_outcome, "Outcome identities collided"))
  results = append(results, std_testing.expect("identity emission keeps same-spelled variants distinct", emitted.program.variants.has(left_finished) && emitted.program.variants.has(right_finished) && left_finished != right_finished, "Finished identities collided"))
  left_target: ResolvedModuleTarget = match resolve_module_path(graph, identity, "left.make") {
    Error(message) => NamespaceTarget(identity),
    Ok(target) => target
  }
  left_binding: ModuleDeclarationBinding = match left_target {
    DeclarationTarget(binding) => binding,
    NamespaceTarget(module) => ModuleDeclarationBinding(DeclarationIdentity(module, "make"), ModuleFunction(), false, SourceSpan(SourcePos("", 0, 1, 1), SourcePos("", 0, 1, 1)))
  }
  call: BoundBody = BoundBody(
    BodyCall(BodyDeclaration(left_binding), [], []),
    SourceSpan(SourcePos("", 0, 1, 1), SourcePos("", 0, 1, 1)),
    [],
    Some(SignatureType(SignatureCore("Nat"), [])),
    [],
    [],
    [],
    [],
    []
  )
  emitted_call: Expr = module_emission_expression(graph, identity, call)
  results = append(results, std_testing.expect("identity expression targets the left declaration", match unlocated_expression(emitted_call) {
    CallExpr(name, arguments, types) => name == left_make,
    LocatedExpr(span, expression, located_type_argument_spans) => false,
    DotCallExpr(target, name, arguments, types) => false,
    StringExpr(text) => false,
    NatExpr(value) => false,
    DecimalExpr(value) => false,
    BoolExpr(value) => false,
    NameExpr(name) => false,
    FunctionExpr(name) => false,
    ArrayExpr(items) => false,
    UnaryExpr(operator, operand) => false,
    BinaryExpr(operator, left, right) => false,
    FieldExpr(target, name) => false,
    IndexExpr(target, index) => false,
    IfExpr(condition, yes, no, has_else) => false,
    BlockExpr(block) => false,
    MatchExpr(subject, arms) => false
  }, "wrong target"))
  if len(emitted.diagnostics) == 0 {
    artifact: Bytes = serialize_bytecode(compile_program(emitted.program))
    results = append(results, std_testing.expect("identity emission produces verified bytecode", len(artifact) > 0, "empty artifact"))
  } else {}
  results
}

pure module_emission_await_call_name(expression: Expr): Str {
  match unlocated_expression(expression) {
    UnaryExpr(operator, operand) => if operator == "await" {
      match unlocated_expression(operand) {
        CallExpr(name, arguments, types) => name,
        LocatedExpr(span, value, located_type_argument_spans) => "",
        NatExpr(value) => "",
        DecimalExpr(value) => "",
        StringExpr(value) => "",
        BoolExpr(value) => "",
        NameExpr(name) => "",
        FunctionExpr(name) => "",
        ArrayExpr(items) => "",
        UnaryExpr(nested, value) => "",
        BinaryExpr(nested, left, right) => "",
        DotCallExpr(target, name, arguments, types) => "",
        FieldExpr(target, field) => "",
        IndexExpr(target, index) => "",
        IfExpr(condition, yes, no, has_else) => "",
        BlockExpr(block) => "",
        MatchExpr(subject, arms) => ""
      }
    } else {
      ""
    },
    LocatedExpr(span, value, located_type_argument_spans) => "",
    NatExpr(value) => "",
    DecimalExpr(value) => "",
    StringExpr(value) => "",
    BoolExpr(value) => "",
    NameExpr(name) => "",
    FunctionExpr(name) => "",
    ArrayExpr(items) => "",
    BinaryExpr(operator, left, right) => "",
    CallExpr(name, arguments, types) => "",
    DotCallExpr(target, name, arguments, types) => "",
    FieldExpr(target, field) => "",
    IndexExpr(target, index) => "",
    IfExpr(condition, yes, no, has_else) => "",
    BlockExpr(block) => "",
    MatchExpr(subject, arms) => ""
  }
}

module_emission_effect_tests(): [TestResult] {
  entry_path: Str = path_support.resolve("tests/fixtures/compiler_contracts/namespaces/emission/async_helpers.panack")
  project_root: Str = path_support.parent(entry_path)
  stdlib_root: Str = path_support.resolve(std_option.value_or(std_environment.get("PANACKELTY_STDLIB_PATH"), ""))
  loaded: LoadedProject = load_project(entry_path)
  graph: ModuleBindingGraph = loaded_binding_graph(loaded.modules, project_root, stdlib_root)
  entry: ModuleIdentity = source_module_identity(entry_path, project_root, stdlib_root)
  left: ModuleIdentity = source_module_identity(path_support.join(project_root, "left.panack"), project_root, stdlib_root)
  right: ModuleIdentity = source_module_identity(path_support.join(project_root, "right.panack"), project_root, stdlib_root)
  left_function: Str = module_emission_symbol(graph, entry, DeclarationIdentity(entry, "left_value"))
  right_function: Str = module_emission_symbol(graph, entry, DeclarationIdentity(entry, "right_value"))
  left_fetch: Str = module_emission_symbol(graph, entry, DeclarationIdentity(left, "fetch"))
  right_fetch: Str = module_emission_symbol(graph, entry, DeclarationIdentity(right, "fetch"))
  emitted: ModuleEmissionResult = module_emission_program(graph, loaded.modules, loaded.module_signatures, loaded.module_bodies, entry)
  mut left_is_async: Bool = false
  mut right_is_async: Bool = false
  mut left_await_target: Str = ""
  mut right_await_target: Str = ""
  for declaration in emitted.program.declarations {
    match declaration {
      FunctionDeclaration(name, parameters, result_type, is_pure, is_async, body, type_parameters) => {
        if name == left_function {
          left_is_async = is_async
          match body.value {
            TailBlockValue(value) => { left_await_target = module_emission_await_call_name(value) },
            NoBlockValue() => {}
          }
        } else {
          if name == right_function {
            right_is_async = is_async
            match body.value {
              TailBlockValue(value) => { right_await_target = module_emission_await_call_name(value) },
              NoBlockValue() => {}
            }
          } else {}
        }
      },
      TypeDeclaration(name, base, guard) => {},
      ImportDeclaration(path) => {},
      RecordDeclaration(name, parameters, fields) => {},
      EnumDeclaration(name, parameters, variants) => {}
    }
  }
  [
    std_testing.equal_nat("proof/effect emission fixture diagnostics", len(emitted.diagnostics), 0),
    std_testing.expect("proof/effect emission retains async function identities", left_is_async && right_is_async, "async flags were dropped"),
    std_testing.expect("await emission targets the left imported async identity", left_await_target == left_fetch, left_await_target),
    std_testing.expect("await emission targets the right imported async identity", right_await_target == right_fetch && left_await_target != right_await_target, right_await_target)
  ]
}

pure module_emission_bodies_with_status(
  bodies: [BoundFunctionBody],
  target: DeclarationIdentity,
  status: BodyCheckStatus
): [BoundFunctionBody] {
  mut result: [BoundFunctionBody] = []
  for body in bodies {
    if body.signature.binding.identity == target {
      result = append(result, BoundFunctionBody(
        body.signature,
        body.parameters,
        body.body,
        body.deferred,
        status,
        body.return_type_evidence
      ))
    } else {
      result = append(result, body)
    }
  }
  result
}

pure module_emission_rejects_unchecked_function(
  result: ModuleEmissionResult,
  symbol: Str,
  name: Str
): Bool {
  mut diagnostic_found: Bool = false
  for diagnostic in result.diagnostics {
    if diagnostic.message == "function is not completely checked for identity emission: " + name {
      diagnostic_found = true
    } else {}
  }
  diagnostic_found && !result.program.function_indices.has(symbol)
}

module_emission_status_tests(): [TestResult] {
  entry_path: Str = path_support.resolve("tests/fixtures/compiler_contracts/namespaces/emission/main.panack")
  project_root: Str = path_support.parent(entry_path)
  stdlib_root: Str = path_support.resolve(std_option.value_or(std_environment.get("PANACKELTY_STDLIB_PATH"), ""))
  loaded: LoadedProject = load_project(entry_path)
  graph: ModuleBindingGraph = loaded_binding_graph(loaded.modules, project_root, stdlib_root)
  entry: ModuleIdentity = source_module_identity(entry_path, project_root, stdlib_root)
  left: ModuleIdentity = source_module_identity(path_support.join(project_root, "left.panack"), project_root, stdlib_root)
  target: DeclarationIdentity = DeclarationIdentity(left, "indirect_value")
  symbol: Str = module_emission_symbol(graph, entry, target)
  deferred: ModuleEmissionResult = module_emission_program(
    graph,
    loaded.modules,
    loaded.module_signatures,
    module_emission_bodies_with_status(loaded.module_bodies, target, BodyDeferred()),
    entry
  )
  invalid: ModuleEmissionResult = module_emission_program(
    graph,
    loaded.modules,
    loaded.module_signatures,
    module_emission_bodies_with_status(loaded.module_bodies, target, BodyInvalid()),
    entry
  )
  [
    std_testing.expect(
      "identity emission rejects deferred ordinary bodies",
      module_emission_rejects_unchecked_function(deferred, symbol, "indirect_value"),
      "deferred function was emitted or lacked its diagnostic"
    ),
    std_testing.expect(
      "identity emission rejects invalid ordinary bodies",
      module_emission_rejects_unchecked_function(invalid, symbol, "indirect_value"),
      "invalid function was emitted or lacked its diagnostic"
    )
  ]
}

pure namespace_identity(path: Str): ModuleIdentity {
  ModuleIdentity(StandaloneModulePackage(), path)
}

pure namespace_test_bindings(path: Str, source: Str): ModuleBindings {
  match namespace_parse(source) {
    Error(error) => ModuleBindings(namespace_identity("PARSE FAILURE: " + error.message), [], []),
    Ok(parsed) => collect_module_bindings(namespace_identity(path), parsed)
  }
}

pure namespace_target_text(result: Result[ResolvedModuleTarget,Str]): Str {
  match result {
    Error(message) => message,
    Ok(target) => match target {
      NamespaceTarget(identity) => "namespace:" + identity.path,
      DeclarationTarget(declaration) => declaration.identity.module.path + ":" + declaration.identity.name
    }
  }
}

pure namespace_resolution_graph(): ModuleBindingGraph {
  library: ModuleBindings = namespace_test_bindings("library", "pub pure get(): Nat { 1 }\npub pure first(): Nat { 2 }\npure helper(): Nat { 3 }\npub record Box[T] { value: T }\npub enum Failure { Timeout, Detail(Str) }\nenum Hidden { Secret }\npub type Positive = Nat where value > 0")
  facade: ModuleBindings = namespace_test_bindings("facade", "pub import project/library as api\npub import project/library::{get as answer, Box as Crate, Failure, Failure.Timeout as expired}\nimport project/library as hidden")
  application: ModuleBindings = namespace_test_bindings("app", "import project/facade as facade\nimport project/library as api\nimport project/facade::{answer, Crate, expired}\nimport project/library as second\nmain(): Void {}")
  other: ModuleBindings = namespace_test_bindings("other", "pub record Box[T] { value: T }\npure helper(): Nat { 4 }")
  ModuleBindingGraph([application, other, facade, library], [
    ModuleImportEdge(namespace_identity("facade"), 0, namespace_identity("library")),
    ModuleImportEdge(namespace_identity("facade"), 1, namespace_identity("library")),
    ModuleImportEdge(namespace_identity("facade"), 2, namespace_identity("library")),
    ModuleImportEdge(namespace_identity("app"), 0, namespace_identity("facade")),
    ModuleImportEdge(namespace_identity("app"), 1, namespace_identity("library")),
    ModuleImportEdge(namespace_identity("app"), 2, namespace_identity("facade")),
    ModuleImportEdge(namespace_identity("app"), 3, namespace_identity("library"))])
}

pure namespace_resolution_tests(): [TestResult] {
  mut results: [TestResult] = []
  graph: ModuleBindingGraph = namespace_resolution_graph()
  app: ModuleIdentity = namespace_identity("app")
  results = append(results, std_testing.equal_nat("valid diamond graph has no diagnostics", len(module_graph_diagnostics(graph)), 0))
  walked: ModuleGraphWalk = walk_module_graph(graph)
  results = append(results, std_testing.equal_nat("shared modules visited once", len(walked.completed), 4))
  for spelling in ["api.get", "second.get", "facade.api.get", "facade.answer", "answer"] {
    results = append(results, std_testing.equal_str("function aliases retain origin/" + spelling, namespace_target_text(resolve_module_path(graph, app, spelling)), "library:get"))
  }
  for spelling in ["api.Box", "facade.Crate", "Crate"] {
    results = append(results, std_testing.equal_str("type aliases retain origin/" + spelling, namespace_target_text(resolve_module_path(graph, app, spelling)), "library:Box"))
  }
  for spelling in ["api.Failure.Timeout", "facade.Failure.Timeout", "facade.expired", "expired"] {
    results = append(results, std_testing.equal_str("variants retain origin/" + spelling, namespace_target_text(resolve_module_path(graph, app, spelling)), "library:Timeout"))
  }
  results = append(results, std_testing.equal_str("namespace export retained", namespace_target_text(resolve_module_path(graph, app, "facade.api")), "namespace:library"))
  results = append(results, std_testing.equal_str("private helper rejected across module", namespace_target_text(resolve_module_path(graph, app, "api.helper")), "module declaration helper is private in library"))
  results = append(results, std_testing.equal_str("private enum cannot export variants", namespace_target_text(resolve_module_path(graph, app, "api.Hidden.Secret")), "module declaration Hidden is private in library"))
  results = append(results, std_testing.equal_str("bare private variant unavailable", namespace_target_text(resolve_module_path(graph, app, "api.Secret")), "module library has no binding Secret"))
  results = append(results, std_testing.equal_str("public enum does not open bare variants", namespace_target_text(resolve_module_path(graph, app, "facade.Timeout")), "module facade has no binding Timeout"))
  results = append(results, std_testing.equal_str("imports do not open transitively", namespace_target_text(resolve_module_path(graph, app, "get")), "module app has no binding get"))
  results = append(results, std_testing.equal_str("private namespace reexport rejected", namespace_target_text(resolve_module_path(graph, app, "facade.hidden.get")), "import binding hidden is private in facade"))
  results = append(results, std_testing.equal_str("own helper remains visible", namespace_target_text(resolve_module_path(graph, namespace_identity("library"), "helper")), "library:helper"))
  results = append(results, std_testing.expect("same named nominal origins differ", resolve_module_type(graph, namespace_identity("library"), "Box") != resolve_module_type(graph, namespace_identity("other"), "Box"), "nominal identities collapsed"))
  results = append(results, std_testing.expect("guarded type resolves", match resolve_module_type(graph, app, "api.Positive") { Ok(binding) => binding.kind == ModuleGuardedType(), Error(message) => false }, "guarded type lookup failed"))
  results = append(results, std_testing.expect("function cannot resolve as type", match resolve_module_type(graph, app, "api.get") { Ok(binding) => false, Error(message) => message == "function is not a type: api.get" }, "wrong kind accepted"))
  results = append(results, std_testing.expect("record cannot resolve as function reference", match resolve_module_function(graph, app, "api.Box") { Ok(binding) => false, Error(message) => message == "declaration is not a function: api.Box" }, "constructor accepted as function"))
  for method in ["get", "first"] {
    results = append(results, std_testing.expect("namespace call precedes method lowering/" + method,
      match resolve_module_dot_call(graph, app, NameExpr("api"), method, [], []) {
        Error(message) => false,
        Ok(call) => match call {
          NamespaceCall(binding, arguments, types) => binding.identity.name == method && len(arguments) == 0,
          ValueMethodCall(target, name, arguments, types) => false
        }
      }, "namespace call was lowered as value method"))
    results = append(results, std_testing.expect("ordinary receiver remains value method/" + method,
      match resolve_module_dot_call(graph, app, NameExpr("items"), method, [NatExpr(0)], []) {
        Error(message) => false,
        Ok(call) => match call {
          NamespaceCall(binding, arguments, types) => false,
          ValueMethodCall(target, name, arguments, types) => name == method && target == NameExpr("items") && len(arguments) == 1
        }
      }, "value receiver mistaken for namespace"))
  }
  missing: ModuleBindingGraph = ModuleBindingGraph(graph.modules, [])
  results = append(results, std_testing.expect("missing import edges diagnosed", len(module_graph_diagnostics(missing)) > 0, "missing edge accepted"))
  duplicate: ModuleBindingGraph = ModuleBindingGraph(append(graph.modules, graph.modules[0]), graph.edges)
  results = append(results, std_testing.expect("duplicate graph identity diagnosed", len(module_graph_diagnostics(duplicate)) > 0, "duplicate module accepted"))
  a: ModuleBindings = namespace_test_bindings("a", "pub import project/b as b")
  b: ModuleBindings = namespace_test_bindings("b", "import project/a as a")
  cycle: ModuleBindingGraph = ModuleBindingGraph([a, b], [ModuleImportEdge(a.identity, 0, b.identity), ModuleImportEdge(b.identity, 0, a.identity)])
  results = append(results, std_testing.equal_str("unused reexport cycle ordered diagnostic", module_graph_diagnostics(cycle)[0].message, "module import cycle: a -> b -> a"))
  bad: ModuleBindings = namespace_test_bindings("bad", "pub import project/library::{helper as exposed}")
  bad_graph: ModuleBindingGraph = ModuleBindingGraph(append(graph.modules, bad), append(graph.edges, ModuleImportEdge(bad.identity, 0, namespace_identity("library"))))
  bad_errors: [Diagnostic] = module_graph_diagnostics(bad_graph)
  results = append(results, std_testing.equal_nat("private selective reexport rejected even unused", len(bad_errors), 1))
  results = append(results, std_testing.equal_str("private reexport error", bad_errors[0].message, "module declaration helper is private in library"))
  results = append(results, std_testing.equal_nat("selector diagnostic retains source column", bad_errors[0].position.column, 30))
  results
}

pure namespace_qualified_syntax_tests(): [TestResult] {
  mut results: [TestResult] = []
  graph: ModuleBindingGraph = namespace_resolution_graph()
  source: Str = "import project/library as api\npure use(value: api.Box[[api.Positive]]): api.Positive {\n  callback: PureFn[Nat] = @api.get\n  item = api.Box[api.Positive](1)\n  code = api.Failure.Timeout()\n  match code { api.Failure.Timeout() => api.first(), api.Failure.Detail(text) => api.get() }\n}"
  match namespace_parse(source) {
    Error(error) => { results = append(results, std_testing.expect("qualified syntax parses", false, diagnostic_text(error))) },
    Ok(parsed) => {
      uses: ResolvedModuleUses = namespace_raw_uses(graph, namespace_identity("app"), parsed)
      results = append(results, std_testing.equal_nat("qualified uses resolve", len(uses.diagnostics), 0))
      results = append(results, std_testing.equal_nat("all nested types calls references and patterns retained", len(uses.references), 11))
      mut saw_reference: Bool = false
      mut saw_call: Bool = false
      for reference in uses.references {
        if reference.spelling == "api.get" && reference.span.start.line == 3 {
          saw_reference = reference.span.start.column == 27 && reference.span.end.column == 35
        }
        if reference.spelling == "api.Box" && reference.span.start.line == 4 { saw_call = true }
      }
      results = append(results, std_testing.expect("function reference keeps complete written span", saw_reference, "reference span lost"))
      results = append(results, std_testing.expect("qualified generic constructor retained", saw_call, "constructor missing"))
    }
  }
  match namespace_parse("pure f(): Nat { api.get(1) }") {
    Error(error) => { results = append(results, std_testing.expect("raw dot call parses", false, diagnostic_text(error))) },
    Ok(parsed) => match parsed.program.declarations[0] {
      FunctionDeclaration(name, parameters, return_type, is_pure, is_async, body, type_parameters) => match body.value {
        NoBlockValue() => { results = append(results, std_testing.expect("raw dot call tail", false, "missing tail")) },
        TailBlockValue(value) => {
          results = append(results, std_testing.expect("raw dot call preserves receiver spelling arguments", raw_namespace_dot_call(value), "raw dot call was lowered"))
        }
      },
      ImportDeclaration(path) => {}, TypeDeclaration(name, base, guard) => {}, RecordDeclaration(name, parameters, fields) => {}, EnumDeclaration(name, parameters, variants) => {}
    }
  }
  results
}

pure raw_namespace_dot_call(expression: Expr): Bool {
  match unlocated_expression(expression) {
    DotCallExpr(target, name, arguments, types) => unlocated_expression(target) == NameExpr("api") && name == "get" && len(arguments) == 1 && unlocated_expression(arguments[0]) == NatExpr(1),
    LocatedExpr(span, value, located_type_argument_spans) => false, NatExpr(value) => false, DecimalExpr(text) => false,
    StringExpr(text) => false, BoolExpr(value) => false, NameExpr(name) => false,
    FunctionExpr(name) => false, ArrayExpr(items) => false, UnaryExpr(operator, operand) => false,
    BinaryExpr(operator, left, right) => false, CallExpr(name, arguments, types) => false,
    FieldExpr(target, field) => false, IndexExpr(target, index) => false,
    IfExpr(condition, yes, no, has_else) => false, BlockExpr(block) => false, MatchExpr(subject, arms) => false
  }
}

pure namespace_resolution_failure_tests(): [TestResult] {
  mut results: [TestResult] = []
  graph: ModuleBindingGraph = namespace_resolution_graph()
  for body in ["pure f(api: Nat): Nat { api.get() }", "pure f[api](value: api): Nat { api.get() }", "pure f(): Nat { api: Nat = 1; api.get() }", "pure f(): Nat { api = 1; api.get() }", "pure f(): Nat { for api in [1] { api.get() }; 0 }", "pure f(): Nat { match Some(1) { Some(api) => api.get(), None() => 0 } }"] {
    match namespace_parse("import project/library as api\n" + body) {
      Error(error) => { results = append(results, std_testing.expect("shadow fixture parses", false, diagnostic_text(error))) },
      Ok(parsed) => {
        uses: ResolvedModuleUses = namespace_raw_uses(graph, namespace_identity("app"), parsed)
        results = append(results, std_testing.equal_nat("import shadow yields no misleading references", len(uses.references), 0))
        results = append(results, std_testing.expect("import shadow rejected", len(uses.diagnostics) > 0 && uses.diagnostics[0].message == "local binding api conflicts with an import binding", "missing shadow diagnostic"))
      }
    }
  }
  for expression in ["api", "api.Box", "api.helper()", "@api.Box", "api.missing()", "facade.hidden.get()"] {
    match namespace_parse("import project/library as api\npure f(): Nat { " + expression + " }") {
      Error(error) => { results = append(results, std_testing.expect("invalid use parses", false, diagnostic_text(error))) },
      Ok(parsed) => {
        uses: ResolvedModuleUses = namespace_raw_uses(graph, namespace_identity("app"), parsed)
        results = append(results, std_testing.expect("invalid namespace use rejected/" + expression, len(uses.diagnostics) > 0, "bad use accepted"))
      }
    }
  }
  match namespace_parse("pub pure f(): Option[Nat] { Some(1) }") {
    Error(error) => { results = append(results, std_testing.expect("core use parses", false, diagnostic_text(error))) },
    Ok(parsed) => {
      uses: ResolvedModuleUses = namespace_raw_uses(graph, namespace_identity("app"), parsed)
      results = append(results, std_testing.equal_nat("implicit core constructor not falsely rejected", len(uses.diagnostics), 0))
    }
  }
  message: Str = "namespace syntax is parsed but execution is not yet supported (language namespace migration pending)"
  for source in ["import project/api; main(): Void { api.get() }", "import project/api; main(): Void { api.first() }", "pure f(value: api.Box[other.Item]): Nat { 1 }", "pure f(): PureFn[Nat] { @api.get }", "enum Choice { Pick }; pure f(): Choice { Choice.Pick() }", "pure f(): Nat { match 1 { api.Choice.Pick() => 1 } }"] {
    results = append(results, std_testing.equal_str("unmarked qualified syntax fails closed", check_source_frontend(source), message))
    results = append(results, std_testing.expect("unmarked qualified source emits no bytecode", compile_source_bytecode(source) == bytes(), "staged syntax emitted bytecode"))
  }
  results = append(results, std_testing.equal_str("legacy value method still lowers", check_source_types("pure f(): Nat { [1].len() }; main(): Void {}"), "ok"))
  mut modules: [ModuleBindings] = [namespace_test_bindings("leaf", "pub pure answer(): Nat { 1 }")]
  mut edges: [ModuleImportEdge] = []
  mut previous: ModuleIdentity = namespace_identity("leaf")
  for index in 0..16 {
    name: Str = "layer${index}"
    module: ModuleBindings = namespace_test_bindings(name, "import project/next as left\nimport project/next as right")
    modules = append(modules, module)
    edges = append(edges, ModuleImportEdge(module.identity, 0, previous))
    edges = append(edges, ModuleImportEdge(module.identity, 1, previous))
    previous = module.identity
  }
  diamond: ModuleBindingGraph = ModuleBindingGraph(modules, edges)
  walked: ModuleGraphWalk = walk_module_graph(diamond)
  results = append(results, std_testing.equal_nat("layered diamond completes each module once", len(walked.completed), 17))
  results = append(results, std_testing.equal_nat("layered diamond validates without repeated subtree work", len(module_graph_diagnostics(diamond)), 0))
  results
}


pure namespace_lexical_receiver_tests(): [TestResult] {
  mut results: [TestResult] = []
  for function_source in [
    "pure f(Choice: [Nat]): Nat { Choice.len() }",
    "pure f(): Nat { Choice = [1]; Choice.len() }",
    "pure f(): Nat { for Choice in [[1]] { Choice.len() }; 0 }",
    "pure f(input: Wrap): Nat { match input { Wrapped(Choice) => Choice.len(), Empty() => 0 } }"] {
    source: Str = "enum Wrap { Wrapped([Nat]), Empty }; enum Choice { Pick(Nat) }; " + function_source + "; main(): Void {}"
    results = append(results, std_testing.equal_str("legacy enum-spelled value receiver remains executable", check_source_types(source), "ok"))
    match namespace_parse(source + "; pure actual(): Choice { Choice.Pick(1) }") {
      Error(error) => { results = append(results, std_testing.expect("lexical receiver fixture parses", false, diagnostic_text(error))) },
      Ok(parsed) => {
        identity: ModuleIdentity = namespace_identity("lexical")
        graph: ModuleBindingGraph = ModuleBindingGraph([collect_module_bindings(identity, parsed)], [])
        uses: ResolvedModuleUses = namespace_raw_uses(graph, identity, parsed)
        results = append(results, std_testing.equal_nat("value receiver scope produces no errors", len(uses.diagnostics), 0))
        results = append(results, std_testing.equal_nat("value scope does not hide other function enum qualification", len(uses.references), 1))
        results = append(results, std_testing.equal_nat("only actual qualified enum declaration is gated", len(module_execution_diagnostics(parsed)), 1))
      }
    }
  }
  match namespace_parse("import project/library as value; type Positive = Nat where value.get()") {
    Error(error) => { results = append(results, std_testing.expect("guard shadow fixture parses", false, diagnostic_text(error))) },
    Ok(parsed) => {
      identity: ModuleIdentity = namespace_identity("guard")
      graph: ModuleBindingGraph = ModuleBindingGraph([
        collect_module_bindings(identity, parsed), namespace_test_bindings("library", "pub pure get(): Bool { true }")],
        [ModuleImportEdge(identity, 0, namespace_identity("library"))])
      uses: ResolvedModuleUses = namespace_raw_uses(graph, identity, parsed)
      results = append(results, std_testing.equal_nat("implicit guarded value gives no namespace reference", len(uses.references), 0))
      results = append(results, std_testing.equal_str("implicit guarded value import collision diagnosed", uses.diagnostics[0].message, "local binding value conflicts with an import binding"))
    }
  }
  match namespace_parse("import stdlib/result; record Item { outcome: Nat }; pure f(result: Item): Nat { result.outcome }") {
    Error(error) => { results = append(results, std_testing.expect("default basename fixture parses", false, diagnostic_text(error))) },
    Ok(parsed) => { results = append(results, std_testing.equal_nat("legacy default import basename is not a reserved value name", len(module_execution_diagnostics(parsed)), 0)) }
  }
  results
}

pure signature_test_module(identity: ModuleIdentity, source: Str): LoadedModule {
  parsed: ParsedModule = match namespace_parse(source) {
    Ok(value) => value,
    Error(error) => ParsedModule(indexed_program([]), [])
  }
  LoadedModule(identity.path, parsed, parsed.program, collect_module_bindings(identity, parsed), loaded_module_declaration_index(parsed))
}
pure signature_test_error(source: Str): Str {
  module: LoadedModule = signature_test_module(namespace_identity("signature.panack"), source)
  result: CheckedModuleSignatures = check_module_signatures(ModuleBindingGraph([module.bindings], []), [module], module)
  if len(result.diagnostics) == 0 { "ok" } else { result.diagnostics[0].message }
}
pure signature_test_position(source: Str): SourcePos {
  module: LoadedModule = signature_test_module(namespace_identity("signature.panack"), source)
  result: CheckedModuleSignatures = check_module_signatures(ModuleBindingGraph([module.bindings], []), [module], module)
  if len(result.diagnostics) == 0 { SourcePos("", 0, 0, 0) } else { result.diagnostics[0].position }
}
pure signature_test_type(graph: ModuleBindingGraph, modules: [LoadedModule], binder: DeclarationIdentity, parameters: [Str], spelling: Str, public_flag: Bool): SignatureType {
  match signature_type(graph, modules, binder, parameters, spelling, public_flag, true) {
    Ok(value) => value, Error(message) => SignatureType(SignatureCore("ERROR:" + message), [])
  }
}
pure namespace_signature_tests(): [TestResult] {
  mut results: [TestResult] = []
  match namespace_parse("import project/api as api; record Item { old: Nat }; record Item { latest: Str }") {
    Error(error) => { results = append(results, std_testing.expect("loaded declaration index fixture parses", false, diagnostic_text(error))); },
    Ok(parsed) => {
      index: Map[Str,TopLevel] = loaded_module_declaration_index(parsed)
      latest: TopLevel = index.get("Item")
      latest_field: Str = match latest {
        RecordDeclaration(name, parameters, fields) => fields[0].name,
        ImportDeclaration(path) => "import",
        TypeDeclaration(name, base, guard) => "type",
        EnumDeclaration(name, parameters, variants) => "enum",
        FunctionDeclaration(name, parameters, result, pure_flag, async_flag, body, types) => "function"
      }
      results = append(results, std_testing.expect("loaded declaration index keeps last declaration", index.has("Item") && latest_field == "latest", latest_field))
      results = append(results, std_testing.expect("loaded declaration index excludes imports", !index.has("api"), "import alias indexed as declaration"))
    }
  }
  left: LoadedModule = signature_test_module(namespace_identity("left"), "pub record Item[T] { value: T }; pub async fetch(): Nat { 1 }")
  right: LoadedModule = signature_test_module(namespace_identity("right"), "pub record Item[T] { value: T }")
  app: LoadedModule = signature_test_module(namespace_identity("app"), "import project/left as private_alias; pub import project/left as public_alias; pub import project/right as other; pub pure wrap[T](value: private_alias.Item[PureFn[T,Nat]]): other.Item[T] { 0 }")
  modules: [LoadedModule] = [left, right, app]
  graph: ModuleBindingGraph = ModuleBindingGraph([left.bindings, right.bindings, app.bindings], [ModuleImportEdge(app.bindings.identity, 0, left.bindings.identity), ModuleImportEdge(app.bindings.identity, 1, left.bindings.identity), ModuleImportEdge(app.bindings.identity, 2, right.bindings.identity)])
  binder: DeclarationIdentity = DeclarationIdentity(app.bindings.identity, "wrap")
  a: SignatureType = signature_test_type(graph, modules, binder, [], "private_alias.Item[Nat]", true)
  b: SignatureType = signature_test_type(graph, modules, binder, [], "public_alias.Item[Nat]", true)
  c: SignatureType = signature_test_type(graph, modules, binder, [], "other.Item[Nat]", true)
  results = append(results, std_testing.expect("same-spelled module nominals are distinct", a != c && a.identity == SignatureNominal(DeclarationIdentity(left.bindings.identity, "Item")), "lost nominal identity"))
  results = append(results, std_testing.expect("private spelling publicly reachable by alias preserves identity", a == b, "alias minted identity"))
  checked: CheckedModuleSignatures = check_module_signatures(graph, modules, app)
  results = append(results, std_testing.equal_nat("nested generic callable public signature accepted", len(checked.diagnostics), 0))
  results = append(results, std_testing.equal_nat("signature table retains one function", len(checked.declarations), 1))
  results = append(results, std_testing.expect("pure signature keeps classification", checked.declarations[0].effect == Some(SignaturePure()), "lost pure effect"))
  async_signature: CheckedModuleSignatures = check_module_signatures(graph, modules, left)
  results = append(results, std_testing.expect("async declaration keeps classification", async_signature.declarations[1].effect == Some(SignatureAsync()), "lost async effect"))
  parameter: SignatureType = signature_test_type(graph, modules, binder, ["Item"], "Item", false)
  results = append(results, std_testing.expect("lexical type parameter wins over another module spelling", parameter.identity == SignatureParameter(binder, 0), "captured parameter"))
  another: DeclarationIdentity = DeclarationIdentity(app.bindings.identity, "another")
  results = append(results, std_testing.expect("type parameter binder identity distinguishes declarations", parameter != signature_test_type(graph, modules, another, ["Item"], "Item", false), "parameter capture"))
  renamed: SignatureType = signature_test_type(graph, modules, binder, ["Renamed"], "Renamed", false)
  results = append(results, std_testing.expect("type parameter alpha rename preserves position", parameter == renamed, "spelling controls parameter identity"))
  results = append(results, std_testing.expect("substitution uses binder identity", substitute_signature_type(parameter, binder, [a]) == Ok(a) && substitute_signature_type(parameter, another, [c]) == Ok(parameter), "capture during substitution"))
  results = append(results, std_testing.expect("missing substitution rejects safely", substitute_signature_type(parameter, binder, []) == Error("missing signature substitution"), "missing argument accepted"))
  for spelling in ["PureFn[Nat,Void]", "Fn[Nat,Void]", "AsyncFn[Nat,Nat]"] {
    resolved: SignatureType = signature_test_type(graph, modules, binder, [], spelling, true)
    expected: SignatureEffect = signature_effect(starts_with_at(spelling, "Pure", 0), starts_with_at(spelling, "Async", 0))
    results = append(results, std_testing.expect("callable signature effect/" + spelling, resolved.identity == SignatureCallable(expected), "effect erased"))
  }
  results = append(results, std_testing.equal_str("record private field leak", signature_test_error("record Hidden { value: Nat }; pub record Box { value: Hidden }"), "signature Box.value: public signature exposes inaccessible type Hidden from signature.panack"))
  results = append(results, std_testing.equal_str("enum nested private payload leak", signature_test_error("record Hidden { value: Nat }; pub enum Box { Wrap(Option[[Hidden]]) }"), "signature Box.Wrap:0: public signature exposes inaccessible type Hidden from signature.panack"))
  results = append(results, std_testing.equal_str("callable private parameter leak", signature_test_error("record Hidden { value: Nat }; pub pure f(value: PureFn[Hidden,Nat]): Nat { 0 }"), "signature f.value: public signature exposes inaccessible type Hidden from signature.panack"))
  results = append(results, std_testing.equal_str("private return leak", signature_test_error("record Hidden { value: Nat }; pub pure f(): Hidden { 0 }"), "signature f.return: public signature exposes inaccessible type Hidden from signature.panack"))
  results = append(results, std_testing.equal_str("public wrapper may call private body helper", signature_test_error("pure helper(): Nat { 1 }; pub pure wrap(): Nat { helper() }"), "ok"))
  results = append(results, std_testing.equal_str("public guard direct helper leak", signature_test_error("pure hidden(value: Nat): Bool { true }; pub type Good = Nat where hidden(value)"), "public guard depends on inaccessible declaration hidden from signature.panack"))
  results = append(results, std_testing.equal_str("public guard receiver helper leak", signature_test_error("pure hidden(value: Nat): Bool { true }; pub type Good = Nat where value.hidden()"), "public guard depends on inaccessible declaration hidden from signature.panack"))
  results = append(results, std_testing.equal_str("public guard accessible helper", signature_test_error("pub pure exposed(value: Nat): Bool { true }; pub type Good = Nat where exposed(value)"), "ok"))
  results = append(results, std_testing.equal_str("reserved core nominal rejected", signature_test_error("pub record Option[T] { value: T }"), "declaration Option conflicts with a reserved core identity"))
  results = append(results, std_testing.equal_str("reserved scalar nominal rejected", signature_test_error("pub record Nat { value: Int }"), "declaration Nat conflicts with a reserved core identity"))
  results = append(results, std_testing.equal_str("duplicate parameter rejected", signature_test_error("pub record Pair[T,T] { value: T }"), "invalid or duplicate type parameter T"))
  results = append(results, std_testing.equal_str("callable Void parameter rejected", signature_test_error("pub pure f(value: Fn[Void,Nat]): Nat { 0 }"), "signature f.value: Void is only valid as a function return type"))
  results = append(results, std_testing.equal_str("async Void result rejected", signature_test_error("pub async f(): Void {}"), "signature f.return: Void is only valid as a function return type"))
  field_position: SourcePos = signature_test_position("pub record Box { first: Nat, missing: Missing }")
  results = append(results, std_testing.expect("unknown field type points at the type token", field_position.file == "module.panack" && field_position.line == 1 && field_position.column == 39, "wrong diagnostic position"))
  nested_position: SourcePos = signature_test_position("pub pure f(value: Nat): Option[[Missing]] { 0 }")
  results = append(results, std_testing.expect("nested return type points at the type reference", nested_position.file == "module.panack" && nested_position.line == 1 && nested_position.column == 25, "wrong diagnostic position"))
  enum_position: SourcePos = signature_test_position("pub enum Choice { Known(Nat), Broken(Missing) }")
  results = append(results, std_testing.expect("enum payload type points at the type token", enum_position.file == "module.panack" && enum_position.line == 1 && enum_position.column == 38, "wrong diagnostic position"))
  parameter_position: SourcePos = signature_test_position("pub pure f(value: Missing): Nat { 0 }")
  results = append(results, std_testing.expect("function parameter type points at the type token", parameter_position.file == "module.panack" && parameter_position.line == 1 && parameter_position.column == 19, "wrong diagnostic position"))
  guarded_base_position: SourcePos = signature_test_position("pub type Positive = Missing where value > 0")
  results = append(results, std_testing.expect("guarded type base points at the type token", guarded_base_position.file == "module.panack" && guarded_base_position.line == 1 && guarded_base_position.column == 21, "wrong diagnostic position"))
  leaked: LoadedModule = signature_test_module(namespace_identity("leaked"), "import project/left as api; pub pure expose(): api.Item[Nat] { 0 }")
  leak_graph: ModuleBindingGraph = ModuleBindingGraph([left.bindings, leaked.bindings], [ModuleImportEdge(leaked.bindings.identity, 0, left.bindings.identity)])
  leak_result: CheckedModuleSignatures = check_module_signatures(leak_graph, [left, leaked], leaked)
  results = append(results, std_testing.equal_str("imported public type without export route leaks", leak_result.diagnostics[0].message, "signature expose.return: public signature exposes inaccessible type api.Item from left"))
  results = append(results, std_testing.equal_str("signature errors retain owner source", leak_result.diagnostics[0].position.file, "module.panack"))
  results = append(results, std_testing.equal_nat("invalid signature not retained", len(leak_result.declarations), 0))
  facade: LoadedModule = signature_test_module(namespace_identity("facade"), "pub import project/left::{Item as Reexported, fetch as load}")
  use: LoadedModule = signature_test_module(namespace_identity("use"), "pub import project/facade as api; pub pure f(): api.Reexported[Nat] { 0 }")
  reexports: ModuleBindingGraph = ModuleBindingGraph([left.bindings, facade.bindings, use.bindings], [ModuleImportEdge(facade.bindings.identity, 0, left.bindings.identity), ModuleImportEdge(use.bindings.identity, 0, facade.bindings.identity)])
  results = append(results, std_testing.expect("selective transitive reexport retains nominal identity", signature_test_type(reexports, [left, facade, use], DeclarationIdentity(use.bindings.identity, "f"), [], "api.Reexported[Nat]", true) == a, "reexport changed identity"))
  results = append(results, std_testing.expect("reexport generic arity checked at origin", signature_type(reexports, [left, facade, use], DeclarationIdentity(use.bindings.identity, "f"), [], "api.Reexported", true, true) == Error("api.Reexported has incorrect type argument count"), "arity not checked"))
  core: LoadedModule = signature_test_module(ModuleIdentity(ToolchainModulePackage(), "core.panack"), "pub enum Option[T] { Some(T), None }; pub enum Result[T,E] { Ok(T), Error(E) }")
  core_use: LoadedModule = signature_test_module(namespace_identity("core_use"), "import stdlib/core::{Option as Maybe, Result as Outcome}; pub pure f(): Maybe[Nat] { 0 }")
  core_graph: ModuleBindingGraph = ModuleBindingGraph([core.bindings, core_use.bindings], [ModuleImportEdge(core_use.bindings.identity, 0, core.bindings.identity)])
  core_owner: DeclarationIdentity = DeclarationIdentity(core_use.bindings.identity, "f")
  results = append(results, std_testing.expect("toolchain core alias equals implicit core identity", signature_test_type(core_graph, [core, core_use], core_owner, [], "Maybe[Nat]", true) == signature_test_type(core_graph, [core, core_use], core_owner, [], "Option[Nat]", true), "second core identity"))
  results = append(results, std_testing.equal_str("guard function reference retains privacy", signature_test_error("pure hidden(): Bool { true }; pub type Good = Nat where @hidden"), "public guard depends on inaccessible declaration hidden from signature.panack"))
  results = append(results, std_testing.equal_str("empty callable signature rejects", signature_test_error("pub pure f(value: Fn): Nat { 0 }"), "signature f.value: Fn expects at least a return type"))
  results = append(results, std_testing.expect("private Result alias equals implicit core identity", signature_test_type(core_graph, [core, core_use], core_owner, [], "Outcome[Nat,Str]", true) == signature_test_type(core_graph, [core, core_use], core_owner, [], "Result[Nat,Str]", true), "second Result identity"))
  results = append(results, std_testing.equal_nat("private implicit-core alias public contract accepted", len(check_module_signatures(core_graph, [core, core_use], core_use).diagnostics), 0))
  core_guard: LoadedModule = signature_test_module(namespace_identity("core_guard"), "import stdlib/core::{Option as Maybe}; pub type Good = Nat where Maybe.Some(value) == Maybe.Some(value)")
  core_guard_graph: ModuleBindingGraph = ModuleBindingGraph([core.bindings, core_guard.bindings], [ModuleImportEdge(core_guard.bindings.identity, 0, core.bindings.identity)])
  results = append(results, std_testing.equal_nat("private core alias qualified guard constructor is reachable", len(check_module_signatures(core_guard_graph, [core, core_guard], core_guard).diagnostics), 0))
  results = append(results, std_testing.equal_str("core string method in public guard remains available", signature_test_error("pub type Good = Str where value.ends_with(\"x\")"), "ok"))
  for method in ["first", "ends_with", "sort_by", "parse_nat", "get", "put", "has", "add", "call", "map", "reduce"] {
    method_module: LoadedModule = signature_test_module(namespace_identity("method"), "pub pure f(value: Nat): Nat { value." + method + "() }")
    method_graph: ModuleBindingGraph = ModuleBindingGraph([method_module.bindings], [])
    results = append(results, std_testing.equal_nat("reserved value method remains a checker responsibility/" + method,
      len(namespace_raw_uses(method_graph, method_module.bindings.identity, method_module.parsed).diagnostics), 0))
  }
  choices: LoadedModule = signature_test_module(namespace_identity("choices"), "pub enum Choice { Pick(Nat) }")
  choice_guard: LoadedModule = signature_test_module(namespace_identity("choice_guard"), "pub import project/choices::{Choice}; pub type Good = Nat where Choice.Pick(value)")
  choice_graph: ModuleBindingGraph = ModuleBindingGraph([choices.bindings, choice_guard.bindings], [ModuleImportEdge(choice_guard.bindings.identity, 0, choices.bindings.identity)])
  results = append(results, std_testing.equal_nat("public enum reexport exposes qualified guard constructor", len(check_module_signatures(choice_graph, [choices, choice_guard], choice_guard).diagnostics), 0))
  results = append(results, std_testing.expect("public enum route reaches original variant identity", signature_public_identity(choice_graph, choice_guard.bindings.identity, DeclarationIdentity(choices.bindings.identity, "Pick"), []), "variant inaccessible"))
  only_variant: LoadedModule = signature_test_module(namespace_identity("only_variant"), "pub import project/choices::{Choice.Pick as picked}; main(): Void {}")
  only_graph: ModuleBindingGraph = ModuleBindingGraph([choices.bindings, only_variant.bindings], [ModuleImportEdge(only_variant.bindings.identity, 0, choices.bindings.identity)])
  results = append(results, std_testing.expect("variant-only export does not expose parent type", !signature_public_identity(only_graph, only_variant.bindings.identity, DeclarationIdentity(choices.bindings.identity, "Choice"), []), "variant leaked parent"))
  results
}

pure body_test_module(source: Str): CheckedModuleBodies {
  body_test_module_mode(source, true)
}

pure body_test_module_mode(source: Str, retain_guard_conversions: Bool): CheckedModuleBodies {
  match namespace_parse(source) {
    Error(error) => CheckedModuleBodies([], [error]),
    Ok(parsed) => {
      identity: ModuleIdentity = namespace_identity("body.panack")
      module: LoadedModule = LoadedModule(identity.path, parsed, parsed.program, collect_module_bindings(identity, parsed), loaded_module_declaration_index(parsed))
      graph: ModuleBindingGraph = ModuleBindingGraph([module.bindings], [])
      signatures: CheckedModuleSignatures = check_module_signatures(graph, [module], module)
      checked: CheckedModuleBodies = check_module_bodies_explained(
        graph, [module], signatures.declarations, module, retain_guard_conversions
      )
      CheckedModuleBodies(checked.functions, concat(signatures.diagnostics, checked.diagnostics))
    }
  }
}

pure body_binding_inference_marker(body: BoundBody): Option[Bool] {
  match body.node {
    BodyBinding(identity, type, mutable, inferred, type_evidence) => inferred,
    BodyLiteral(value) => None(),
    BodyInterpolation(parts) => None(),
    BodyLocalUse(local) => None(),
    BodyFunction(binding) => None(),
    BodyCall(target, types, call_arguments) => None(),
    BodyArray() => None(),
    BodyUnary(operator) => None(),
    BodyBinary(operator) => None(),
    BodyField(name) => None(),
    BodyIndex() => None(),
    BodyIf(has_else) => None(),
    BodyBlock(has_tail) => None(),
    BodyMatch(targets, bindings, spans) => None(),
    BodyAssignment(local, assignment_evidence) => None(),
    BodyWhile() => None(),
    BodyFor(local) => None(),
    BodyEmpty() => None()
  }
}

pure body_guard_conversion_entries(body: BoundBody): [GuardConversionEvidence] {
  mut entries: [GuardConversionEvidence] = body.guard_conversions
  for child in body.children {
    entries = concat(entries, body_guard_conversion_entries(child))
  }
  entries
}
pure body_test_error(source: Str): Str {
  checked: CheckedModuleBodies = body_test_module(source)
  if len(checked.diagnostics) == 0 { "ok" } else { checked.diagnostics[0].message }
}
pure body_test_graph(modules: [LoadedModule], graph: ModuleBindingGraph, entry: LoadedModule): CheckedModuleBodies {
  mut signatures: [ModuleSignature] = []
  mut diagnostics: [Diagnostic] = []
  for module in modules {
    checked: CheckedModuleSignatures = check_module_signatures(graph, modules, module)
    signatures = concat(signatures, checked.declarations); diagnostics = concat(diagnostics, checked.diagnostics)
  }
  bodies: CheckedModuleBodies = check_module_bodies(graph, modules, signatures, entry)
  CheckedModuleBodies(bodies.functions, concat(diagnostics, bodies.diagnostics))
}
pure body_test_effects(source: Str, retain: Bool): CheckedModuleEffects {
  match namespace_parse(source) {
    Error(error) => CheckedModuleEffects([error], [], map()),
    Ok(parsed) => {
      identity: ModuleIdentity = namespace_identity("body.panack")
      module: LoadedModule = LoadedModule(identity.path, parsed, parsed.program, collect_module_bindings(identity, parsed), loaded_module_declaration_index(parsed))
      graph: ModuleBindingGraph = ModuleBindingGraph([module.bindings], [])
      checked_signatures: CheckedModuleSignatures = check_module_signatures(graph, [module], module)
      checked_bodies: CheckedModuleBodies = check_module_bodies(graph, [module], checked_signatures.declarations, module)
      checked: CheckedModuleEffects = check_module_effects(graph, [module], checked_signatures.declarations, checked_bodies.functions, retain)
      CheckedModuleEffects(concat(checked_signatures.diagnostics, concat(checked_bodies.diagnostics, checked.diagnostics)), checked.evidence, checked.function_types)
    }
  }
}
pure body_effect_error(source: Str): Str {
  checked: CheckedModuleEffects = body_test_effects(source, false)
  if len(checked.diagnostics) == 0 { "ok" } else { checked.diagnostics[0].message }
}
pure body_test_graph_effects(modules: [LoadedModule], graph: ModuleBindingGraph, entry: LoadedModule): CheckedModuleEffects {
  mut signatures: [ModuleSignature] = []
  mut diagnostics: [Diagnostic] = []
  for module in modules {
    checked: CheckedModuleSignatures = check_module_signatures(graph, modules, module)
    signatures = concat(signatures, checked.declarations)
    diagnostics = concat(diagnostics, checked.diagnostics)
  }
  bodies: CheckedModuleBodies = check_module_bodies(graph, modules, signatures, entry)
  checked: CheckedModuleEffects = check_module_effects(graph, modules, signatures, bodies.functions, false)
  CheckedModuleEffects(concat(diagnostics, concat(bodies.diagnostics, checked.diagnostics)), checked.evidence, checked.function_types)
}
pure namespace_effect_tests(): [TestResult] {
  mut results: [TestResult] = []
  results = append(results, std_testing.equal_str("identity effects allow pure direct call", body_effect_error("pub pure f(): Nat { later() }; pure later(): Nat { 1 }"), "ok"))
  results = append(results, std_testing.equal_str("identity effects reject ordinary call from pure", body_effect_error("pub pure f(): Nat { later() }; later(): Nat { 1 }"), "pure function cannot call impure function body.panack:later"))
  results = append(results, std_testing.equal_str("identity effects allow ordinary call from ordinary", body_effect_error("pub f(): Nat { later() }; later(): Nat { 1 }"), "ok"))
  results = append(results, std_testing.equal_str("identity effects reject blocking call from async", body_effect_error("pub async f(): Unit { print(1); () }"), "async function cannot call blocking function print"))
  results = append(results, std_testing.equal_str("identity effects accept ordinary printing", body_effect_error("pub f(): Void { print(1) }"), "ok"))
  results = append(results, std_testing.equal_str("identity effects require awaiting async direct calls", body_effect_error("pub async f(): Unit { later(); () }; async later(): Unit { () }"), "async call requires await inside an async function"))
  results = append(results, std_testing.equal_str("identity effects reject async call from pure", body_effect_error("pub pure f(): Nat { later() }; async later(): Nat { 1 }"), "async call requires await inside an async function"))
  results = append(results, std_testing.equal_str("identity effects accept awaited async direct calls", body_effect_error("pub async f(): Nat { await later() }; async later(): Nat { 1 }"), "ok"))
  results = append(results, std_testing.equal_str("identity effects require async context for await", body_effect_error("pub f(): Nat { await later() }; async later(): Nat { 1 }"), "await requires an async function"))
  results = append(results, std_testing.equal_str("identity effects reject awaiting ordinary calls", body_effect_error("pub async f(): Nat { await later() }; later(): Nat { 1 }"), "await requires an async call"))
  results = append(results, std_testing.equal_str("identity effects reject await of values", body_effect_error("pub async f(): Nat { await 1 }"), "await requires an async call"))
  results = append(results, std_testing.equal_str("identity effects reject discarded non-Unit await", body_effect_error("pub async f(): Unit { await later(); () }; async later(): Nat { 1 }"), "bind, match or return a non-Unit await result"))
  results = append(results, std_testing.equal_str("identity effects allow discarded Unit await", body_effect_error("pub async f(): Unit { await later(); () }; async later(): Unit { () }"), "ok"))
  indirect: CheckedModuleEffects = body_test_effects("pub async f(callback: AsyncFn[Nat]): Nat { await callback.call() }", false)
  results = append(results, std_testing.equal_str("identity effects accept awaited async indirect call", if len(indirect.diagnostics) == 0 { "ok" } else { indirect.diagnostics[0].message }, "ok"))
  indirect_bare: CheckedModuleEffects = body_test_effects("pub async f(callback: AsyncFn[Nat]): Unit { callback.call(); () }", false)
  results = append(results, std_testing.equal_str("identity effects reject bare async indirect call", if len(indirect_bare.diagnostics) == 0 { "ok" } else { indirect_bare.diagnostics[0].message }, "async call requires await inside an async function"))
  imported: LoadedModule = signature_test_module(namespace_identity("effect_imported"), "pub async identity[T](value: T): T { value }; pub pure ordinary(): Nat { 1 }; pub ordinary_blocking(): Nat { 2 }")
  app: LoadedModule = signature_test_module(namespace_identity("effect_app"), "import project/effect_imported as api; pub async f(): Nat { await api.identity[Nat](1) }; pub pure g(): Nat { api.ordinary() }; pub pure h(): Nat { api.ordinary_blocking() }")
  graph: ModuleBindingGraph = ModuleBindingGraph([app.bindings, imported.bindings], [ModuleImportEdge(app.bindings.identity, 0, imported.bindings.identity)])
  imported_effects: CheckedModuleEffects = body_test_graph_effects([app, imported], graph, app)
  results = append(results, std_testing.expect("identity effects follow imported generic and aliased declarations", len(imported_effects.diagnostics) == 1 && imported_effects.diagnostics[0].message == "pure function cannot call impure function effect_imported:ordinary_blocking", if len(imported_effects.diagnostics) > 0 { imported_effects.diagnostics[0].message } else { "imported callable effect lost canonical identity" }))
  recovered: CheckedModuleEffects = body_test_effects("pub pure bad(): Nat { ordinary() }; pub pure good(): Nat { later() }; ordinary(): Nat { 1 }; pure later(): Nat { 2 }", true)
  results = append(results, std_testing.expect("identity effect explanation retains valid sibling evidence", len(recovered.diagnostics) == 1 && len(recovered.evidence) == 2 && recovered.evidence[0].function_name == "bad" && len(recovered.evidence[0].violations) == 1 && recovered.evidence[1].function_name == "good", "valid sibling effect evidence was not recovered"))
  results
}
pure namespace_body_tests(): [TestResult] {
  mut results: [TestResult] = []
  results = concat(results, network_core_body_tests())
  joined_array: CheckedModuleBodies = body_test_module("pub pure array(): [Int] { [1, -2] }")
