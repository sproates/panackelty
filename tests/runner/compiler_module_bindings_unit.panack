  arithmetic_operators: [OperatorTypeEvidence] = body_operator_type_evidence(checked_operator.functions[0].body)
  results = append(results, std_testing.expect(
    "explanation checker retains nested binary and unary operator decisions",
    len(arithmetic_operators) == 2,
    "nested binary and unary operator decisions were not both retained"
