  results = append(results, std_testing.expect(
    "explanation checking marks inferred locals",
    len(inferred_local.functions) == 1 &&
      body_binding_inference_marker(inferred_local.functions[0].body.children[0]) == Some(true),
    "inferred binding metadata was not retained"
  ))
  results = append(results, std_testing.expect(
    "explanation checking distinguishes annotated locals",
    len(annotated_local.functions) == 1 &&
      body_binding_inference_marker(annotated_local.functions[0].body.children[0]) == Some(false),
    "annotation was reported as inference"
