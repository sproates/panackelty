    results = append(results, std_testing.equal_str("checked body identity subset/" + source, if len(checked.diagnostics) == 0 { "ok" } else { checked.diagnostics[0].message }, "ok"))
    results = append(results, std_testing.expect("checked subset has explicit type evidence/" + source, len(checked.functions) > 0 && checked.functions[0].body.type != None() && len(checked.functions[0].deferred) == 0, "missing type evidence or unexpectedly deferred"))
  }
  results = append(results, std_testing.equal_str("annotated local mismatch", body_test_error("pub pure f(): Nat { value: Nat = \"bad\"; value }"), "binding value is Str, expected Nat"))
  annotated_type_location: CheckedModuleBodies = body_test_module(
    "pub pure f(): Nat { value: MissingType = 1; value }"
  )
  results = append(results, std_testing.expect(
    "invalid body-local type points to its type token",
    len(annotated_type_location.diagnostics) > 0 &&
      annotated_type_location.diagnostics[0].position.file == "module.panack" &&
      annotated_type_location.diagnostics[0].position.line == 1 &&
      annotated_type_location.diagnostics[0].position.column == 28,
    if len(annotated_type_location.diagnostics) > 0 {
      diagnostic_text(annotated_type_location.diagnostics[0])
    } else {
      "invalid local type was accepted"
    }
  ))
  results = append(results, std_testing.equal_str("direct argument mismatch", body_test_error("pub pure f(): Nat { next(\"bad\") }; pure next(value: Nat): Nat { value }"), "argument 1 to next is Str, expected Nat"))
  indirect: CheckedModuleBodies = body_test_module("pub pure apply(callback: PureFn[Nat,Nat], value: Nat): Nat { callback.call(value) }")
  results = append(results, std_testing.expect("indirect call shares callable parameter and result contract", len(indirect.diagnostics) == 0 && len(indirect.functions) == 1 && indirect.functions[0].status == BodyIdentityChecked() && indirect.functions[0].body.children[0].type == Some(SignatureType(SignatureCore("Nat"), [])), "callable signature was not checked"))
  results = append(results, std_testing.equal_str("indirect argument mismatch", body_test_error("pub pure apply(callback: PureFn[Nat,Nat]): Nat { callback.call(\"bad\") }"), "argument 1 to call is Str, expected Nat"))
  results = append(results, std_testing.equal_str("indirect arity mismatch", body_test_error("pub pure apply(callback: PureFn[Nat,Nat]): Nat { callback.call() }"), "call expects 1 arguments, got 0"))
  results = append(results, std_testing.equal_str("indirect excess arity mismatch", body_test_error("pub pure apply(callback: PureFn[Nat,Nat]): Nat { callback.call(1, 2) }"), "call expects 1 arguments, got 2"))
  results = append(results, std_testing.equal_str("non-callable receiver rejects", body_test_error("pub pure apply(value: Nat): Nat { value.call(1) }"), "call expects a callable, got Nat"))
  results = append(results, std_testing.equal_str("indirect result mismatch", body_test_error("pub pure apply(callback: PureFn[Nat,Nat]): Str { callback.call(1) }"), "return of apply is Nat, expected Str"))
  async_indirect: CheckedModuleBodies = body_test_module("pub pure apply(callback: AsyncFn[Nat,Nat]): Nat { callback.call(1) }")
  results = append(results, std_testing.expect("async indirect call retains identity and result types", len(async_indirect.diagnostics) == 0 && len(async_indirect.functions) == 1 && async_indirect.functions[0].status == BodyIdentityChecked() && len(async_indirect.functions[0].deferred) == 0 && async_indirect.functions[0].body.children[0].type == Some(SignatureType(SignatureCore("Nat"), [])), "async indirect result was not inferred"))
  core_method_library: LoadedModule = signature_test_module(
    ModuleIdentity(ToolchainModulePackage(), "core.panack"),
    "pub enum Option[T] { Some(T), None }; pub enum Result[T,E] { Ok(T), Error(E) }; " +
      "pure core_first[T](values: [T]): Option[T] { None() }; " +
      "pure core_ends_with(value: Str, suffix: Str): Bool { true }; " +
