  results = append(results, std_testing.equal_str("print body contract", body_test_error("pub f(): Void { print(1) }"), "ok"))
  results = append(results, std_testing.equal_str("print wrong arity", body_test_error("pub f(): Void { print() }"), "print expects 1 arguments, got 0"))
