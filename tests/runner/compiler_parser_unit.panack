  [
    std_testing.equal_str("parser/parentheses_override_precedence/1",
      parse_source("(1 + 2) * 3"),
      "((1 + 2) * 3)")
  ]
}

pure parser_unit_parses_bindings_assignments_and_nested_type_references(): [TestResult] {
  [
    std_testing.equal_str("parser/parses_bindings_assignments_and_nested_type_references/1",
      parse_block_source("{ answer: Nat = 40 + 2; mut values: Map[Str,[Nat]] = build(); values = update(values); values }"),
      "{ answer: Nat = (40 + 2); mut values: Map[Str,[Nat]] = build(); values = update(values); values }")
  ]
}

pure parser_unit_parses_complete_mixed_program(): [TestResult] {
  [
    std_testing.equal_str("parser/parses_complete_mixed_program/1",
      parse_program_source("import \"runtime.panack\"; type Positive = Int where value > 0; record Pair[A, B] { first: A, second: B } enum Option[T] { None, Some(T) } pure value_or(value: Option[Nat], fallback: Nat): Nat { match value { Some(found) => found, None() => fallback } } main(): Void { print(value_or(Some(42), 0)); }"),
      "import \"runtime.panack\"; type Positive = Int where (value > 0); record Pair[A,B] { first: A, second: B } enum Option[T] { None, Some(T) } pure value_or(value: Option[Nat], fallback: Nat): Nat { match value { Some(found) => found, None() => fallback } } main(): Void { print(value_or(Some(42), 0)); }")
  ]
}

pure parser_unit_parses_complete_nested_type_references(): [TestResult] {
  [
    std_testing.equal_str("parser/parses_complete_nested_type_references/1",
      parse_type_source("Nat"),
      "Nat"),
    std_testing.equal_str("parser/parses_complete_nested_type_references/2",
      parse_type_source("[Nat]"),
      "[Nat]"),
    std_testing.equal_str("parser/parses_complete_nested_type_references/3",
      parse_type_source("Map[Str,[Nat]]"),
      "Map[Str,[Nat]]"),
    std_testing.equal_str("parser/parses_complete_nested_type_references/4",
      parse_type_source("Result[Option[Nat],Map[Str,[Dec]]]"),
      "Result[Option[Nat],Map[Str,[Dec]]]")
  ]
}

pure parser_unit_parses_empty_and_import_only_programs(): [TestResult] {
  [
    std_testing.equal_str("parser/parses_empty_and_import_only_programs/1",
      parse_program_source(""),
      ""),
    std_testing.equal_str("parser/parses_empty_and_import_only_programs/2",
      parse_program_source("import \"types.panack\""),
      "import \"types.panack\";"),
    std_testing.equal_str("parser/parses_empty_and_import_only_programs/3",
      parse_program_source("import \"types.panack\";"),
      "import \"types.panack\";"),
    std_testing.equal_str("parser/parses_empty_and_import_only_programs/4",
      parse_program_source("import \"types.panack\";\n// shared parser data\nimport \"lexer.panack\";"),
      "import \"types.panack\"; import \"lexer.panack\";"),
    std_testing.equal_str("parser/parses_empty_and_import_only_programs/5",
      parse_program_source("import \"../shared/token.panack\";"),
      "import \"../shared/token.panack\";"),
    std_testing.equal_str("parser/parses_empty_and_import_only_programs/6",
      parse_program_source("import stdlib/option"),
      "import \"stdlib/option\";"),
    std_testing.equal_str("parser/parses_empty_and_import_only_programs/7",
      parse_program_source("import project/shared/token.panack;"),
      "import \"project/shared/token\";"),
    std_testing.equal_str("parser/parses_empty_and_import_only_programs/8",
      parse_program_source("import \"stdlib/result.panack\";"),
      "import \"stdlib/result.panack\";")
  ]
}

pure parser_unit_parses_empty_statement_and_value_blocks(): [TestResult] {
  [
    std_testing.equal_str("parser/parses_empty_statement_and_value_blocks/1",
      parse_block_source("{}"),
      "{}"),
    std_testing.equal_str("parser/parses_empty_statement_and_value_blocks/2",
      parse_block_source("{ 42 }"),
      "{ 42 }"),
    std_testing.equal_str("parser/parses_empty_statement_and_value_blocks/3",
      parse_block_source("{ 42; }"),
      "{ 42; }"),
    std_testing.equal_str("parser/parses_empty_statement_and_value_blocks/4",
      parse_block_source("{ print(1); print(2); }"),
      "{ print(1); print(2); }"),
    std_testing.equal_str("parser/parses_empty_statement_and_value_blocks/5",
      parse_block_source("{ print(1); 2 + 3 }"),
      "{ print(1); (2 + 3) }")
  ]
}

pure parser_unit_parses_enum_declarations(): [TestResult] {
  [
    std_testing.equal_str("parser/parses_enum_declarations/1",
      parse_program_source("enum Empty {}"),
      "enum Empty {}"),
    std_testing.equal_str("parser/parses_enum_declarations/2",
      parse_program_source("enum Direction { North, South, East, West }"),
      "enum Direction { North, South, East, West }"),
    std_testing.equal_str("parser/parses_enum_declarations/3",
      parse_program_source("enum Option[T] { None, Some(T), }"),
      "enum Option[T] { None, Some(T) }"),
    std_testing.equal_str("parser/parses_enum_declarations/4",
      parse_program_source("enum Result[T, E] { Ok(T), Error(E) }"),
      "enum Result[T,E] { Ok(T), Error(E) }"),
    std_testing.equal_str("parser/parses_enum_declarations/5",
      parse_program_source("enum Entry[K, V] { Missing, Found(K,Map[K,[V]]) }"),
      "enum Entry[K,V] { Missing, Found(K,Map[K,[V]]) }")
  ]
}

pure parser_unit_parses_every_binary_operator(): [TestResult] {
  [
    std_testing.equal_str("parser/parses_every_binary_operator/1",
      parse_source("left .. right"),
      "(left .. right)"),
    std_testing.equal_str("parser/parses_every_binary_operator/2",
      parse_source("left || right"),
      "(left || right)"),
    std_testing.equal_str("parser/parses_every_binary_operator/3",
      parse_source("left && right"),
      "(left && right)"),
    std_testing.equal_str("parser/parses_every_binary_operator/4",
      parse_source("left == right"),
      "(left == right)"),
    std_testing.equal_str("parser/parses_every_binary_operator/5",
      parse_source("left != right"),
      "(left != right)"),
    std_testing.equal_str("parser/parses_every_binary_operator/6",
      parse_source("left < right"),
      "(left < right)"),
    std_testing.equal_str("parser/parses_every_binary_operator/7",
      parse_source("left <= right"),
      "(left <= right)"),
    std_testing.equal_str("parser/parses_every_binary_operator/8",
      parse_source("left > right"),
      "(left > right)"),
    std_testing.equal_str("parser/parses_every_binary_operator/9",
      parse_source("left >= right"),
      "(left >= right)"),
    std_testing.equal_str("parser/parses_every_binary_operator/10",
      parse_source("left + right"),
      "(left + right)"),
    std_testing.equal_str("parser/parses_every_binary_operator/11",
      parse_source("left - right"),
      "(left - right)"),
    std_testing.equal_str("parser/parses_every_binary_operator/12",
      parse_source("left * right"),
      "(left * right)"),
    std_testing.equal_str("parser/parses_every_binary_operator/13",
      parse_source("left / right"),
      "(left / right)"),
    std_testing.equal_str("parser/parses_every_binary_operator/14",
      parse_source("left % right"),
      "(left % right)")
  ]
}

pure parser_unit_parses_every_binary_precedence_level(): [TestResult] {
  [
    std_testing.equal_str("parser/parses_every_binary_precedence_level/1",
      parse_source("1..2 || false && 3 == 4 < 5 + 6 * 7"),
      "(1 .. (2 || (false && (3 == (4 < (5 + (6 * 7)))))))")
