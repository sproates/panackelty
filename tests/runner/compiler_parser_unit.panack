import stdlib/testing as std_testing
import project/src/compiler/parser::{parse_source,parse_program_source,parse_block_source,parse_type_source,lex,parse_module_complete, OwnedMethodSyntax}
import stdlib/host as std_host
import stdlib/testing::{TestResult}
// Direct parser contracts, grouped by the former Python test method.
// Expected strings are fixed syntax/diagnostic contracts, not compiler output
// generated at test time. Every expanded former subtest has its own assertion.

pure parser_unit_binary_operators_are_left_associative(): [TestResult] {
  [
    std_testing.equal_str("parser/binary_operators_are_left_associative/1",
      parse_source("10 - 3 - 2"),
      "((10 - 3) - 2)")
  ]
}

pure parser_unit_generic_function_syntax_and_explicit_calls_round_trip(): [TestResult] {
  [
    std_testing.equal_str("parser/generic_function_syntax_and_explicit_calls_round_trip/1",
      parse_program_source("pure identity[T](value: T): T { value }"),
      "pure identity[T](value: T): T { value }"),
    std_testing.equal_str("parser/generic_function_syntax_and_explicit_calls_round_trip/2",
      parse_source("identity[Str](text)"),
      "identity[Str](text)"),
    std_testing.equal_str("parser/generic_function_syntax_and_explicit_calls_round_trip/3",
      parse_source("identity[[Nat]](values)"),
      "identity[[Nat]](values)"),
    std_testing.equal_str("parser/generic_function_syntax_and_explicit_calls_round_trip/4",
      parse_source("values[0]"),
      "values[0]"),
    std_testing.equal_str("parser/generic_function_syntax_and_explicit_calls_round_trip/5",
      parse_source("value.identity[Nat]()"),
      "value.identity[Nat]()")
  ]
}

pure parser_unit_match_expressions_participate_in_precedence_and_blocks(): [TestResult] {
  [
    std_testing.equal_str("parser/match_expressions_participate_in_precedence_and_blocks/1",
      parse_block_source("{ selected: Nat = 1 + match option { Some(value) => value, None() => 0 }; selected }"),
      "{ selected: Nat = (1 + match option { Some(value) => value, None() => 0 }); selected }")
  ]
}

pure parser_unit_dot_calls_retain_receiver_until_namespace_resolution(): [TestResult] {
  [
    std_testing.equal_str("parser/dot_calls_retain_receiver_until_namespace_resolution/1",
      parse_source("value.transform()"),
      "value.transform()"),
    std_testing.equal_str("parser/dot_calls_retain_receiver_until_namespace_resolution/2",
      parse_source("values.append(1)"),
      "values.append(1)"),
    std_testing.equal_str("parser/dot_calls_retain_receiver_until_namespace_resolution/3",
      parse_source("values.append(1).len()"),
      "values.append(1).len()"),
    std_testing.equal_str("parser/dot_calls_retain_receiver_until_namespace_resolution/4",
      parse_source("make().field.transform(2)"),
      "make().field.transform(2)"),
    std_testing.equal_str("parser/dot_calls_retain_receiver_until_namespace_resolution/5",
      parse_source("values.put(\"key\", 1)"),
      "values.put(\"key\", 1)"),
    std_testing.equal_str("parser/dot_calls_retain_receiver_until_namespace_resolution/6",
      parse_source("values.has(\"key\")"),
      "values.has(\"key\")"),
    std_testing.equal_str("parser/dot_calls_retain_receiver_until_namespace_resolution/7",
      parse_source("values.get(\"key\")"),
      "values.get(\"key\")"),
    std_testing.equal_str("parser/dot_calls_retain_receiver_until_namespace_resolution/8",
      parse_source("values.add(1)"),
      "values.add(1)")
  ]
}

