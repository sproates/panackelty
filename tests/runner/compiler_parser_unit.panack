      "\"hello\""),
    std_testing.equal_str("parser/parses_scalar_and_array_literals/4",
      parse_source("true"),
      "true"),
    std_testing.equal_str("parser/parses_scalar_and_array_literals/5",
      parse_source("false"),
      "false"),
    std_testing.equal_str("parser/parses_scalar_and_array_literals/6",
      parse_source("[]"),
      "[]"),
    std_testing.equal_str("parser/parses_scalar_and_array_literals/7",
