pure parser_unit_reports_malformed_blocks(): [TestResult] {
  [
    std_testing.equal_str("parser/reports_malformed_blocks/1",
      parse_block_source("42"),
      "expected opening brace"),
    std_testing.equal_str("parser/reports_malformed_blocks/2",
      parse_block_source("{"),
      "expected closing brace"),
    std_testing.equal_str("parser/reports_malformed_blocks/3",
      parse_block_source("{ mut }"),
      "expected binding name"),
    std_testing.equal_str("parser/reports_malformed_blocks/4",
      parse_block_source("{ mut name Nat = 1; }"),
      "expected : or = after binding name"),
    std_testing.equal_str("parser/reports_malformed_blocks/5",
      parse_block_source("{ name: = 1; }"),
      "expected type"),
    std_testing.equal_str("parser/reports_malformed_blocks/6",
      parse_block_source("{ name: Nat 1; }"),
      "expected = after binding type"),
    std_testing.equal_str("parser/reports_malformed_blocks/7",
      parse_block_source("{ print(1) print(2); }"),
      "expected semicolon or closing brace"),
    std_testing.equal_str("parser/reports_malformed_blocks/8",
      parse_block_source("{ name: Map[] = 1; }"),
      "expected type"),
    std_testing.equal_str("parser/reports_malformed_blocks/9",
      parse_block_source("{} extra"),
      "unexpected token after block")
  ]
}

pure parser_unit_reports_malformed_enum_declarations(): [TestResult] {
  [
    std_testing.equal_str("parser/reports_malformed_enum_declarations/1",
      parse_program_source("enum"),
      "expected enum name"),
    std_testing.equal_str("parser/reports_malformed_enum_declarations/2",
      parse_program_source("enum Option"),
      "expected opening enum brace"),
    std_testing.equal_str("parser/reports_malformed_enum_declarations/3",
      parse_program_source("enum Option[] {}"),
      "expected type parameter"),
    std_testing.equal_str("parser/reports_malformed_enum_declarations/4",
      parse_program_source("enum Option[T,] {}"),
      "expected type parameter"),
    std_testing.equal_str("parser/reports_malformed_enum_declarations/5",
      parse_program_source("enum Option[T E] {}"),
      "expected comma or closing type parameter bracket"),
    std_testing.equal_str("parser/reports_malformed_enum_declarations/6",
      parse_program_source("enum Option { 1 }"),
      "expected enum variant name"),
    std_testing.equal_str("parser/reports_malformed_enum_declarations/7",
      parse_program_source("enum Option { Some( }"),
      "expected type"),
    std_testing.equal_str("parser/reports_malformed_enum_declarations/8",
      parse_program_source("enum Option { Some(Nat }"),
      "expected comma or closing variant parenthesis"),
    std_testing.equal_str("parser/reports_malformed_enum_declarations/9",
      parse_program_source("enum Option { Some(Nat,) }"),
      "expected type"),
    std_testing.equal_str("parser/reports_malformed_enum_declarations/10",
      parse_program_source("enum Pair { Both(Nat Str) }"),
      "expected comma or closing variant parenthesis"),
    std_testing.equal_str("parser/reports_malformed_enum_declarations/11",
      parse_program_source("enum Option { None Some(Nat) }"),
      "expected comma or closing enum brace"),
    std_testing.equal_str("parser/reports_malformed_enum_declarations/12",
      parse_program_source("enum Option { None"),
      "expected closing enum brace")
  ]
}

