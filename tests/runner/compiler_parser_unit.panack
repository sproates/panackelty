pure parser_unit_parses_semicolonless_blocks_and_multiline_expressions(): [TestResult] {
  [
    std_testing.equal_str("parser/parses_semicolonless_blocks_and_multiline_expressions/1",
      parse_block_source("{\nname: Nat = (\n20 +\n22\n)\nname = name +\n1\nprint(name)\nname\n}"),
      "{ name: Nat = (20 + 22); name = (name + 1); print(name); name }"),
    std_testing.equal_str("parser/parses_semicolonless_blocks_and_multiline_expressions/2",
      parse_block_source("{ name: Nat = 1 }"),
      "{ name: Nat = 1; }"),
    std_testing.equal_str("parser/parses_semicolonless_blocks_and_multiline_expressions/3",
      parse_block_source("{ name = 1 }"),
      "{ name = 1; }")
  ]
}

pure parser_unit_parses_unary_calls_fields_and_indexes(): [TestResult] {
  [
    std_testing.equal_str("parser/parses_unary_calls_fields_and_indexes/1",
      parse_source("!items[1 + 2].ready"),
      "(!items[(1 + 2)].ready)"),
