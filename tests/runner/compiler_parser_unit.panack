      "(-(-value))")
  ]
}

pure parser_unit_parses_while_and_for_statements(): [TestResult] {
  [
    std_testing.equal_str("parser/parses_while_and_for_statements/1",
      parse_block_source("{ while ready { print(1); } }"),
      "{ while ready { print(1); } }"),
    std_testing.equal_str("parser/parses_while_and_for_statements/2",
      parse_block_source("{ while cursor > 0 { cursor = cursor - 1; }; cursor }"),
      "{ while (cursor > 0) { cursor = (cursor - 1); } cursor }"),
    std_testing.equal_str("parser/parses_while_and_for_statements/3",
      parse_block_source("{ for value in 0..limit { print(value); } }"),
      "{ for value in (0 .. limit) { print(value); } }"),
    std_testing.equal_str("parser/parses_while_and_for_statements/4",
      parse_block_source("{ for item in values { while ready { use(item); } }; result }"),
      "{ for item in values { while ready { use(item); } } result }")
  ]
}

