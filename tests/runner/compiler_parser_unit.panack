pure parser_unit_parses_match_expressions_and_patterns(): [TestResult] {
  [
    std_testing.equal_str("parser/parses_match_expressions_and_patterns/1",
      parse_source("match option { Some(value) => value, None() => 0 }"),
      "match option { Some(value) => value, None() => 0 }"),
    std_testing.equal_str("parser/parses_match_expressions_and_patterns/2",
      parse_source("match pair { Pair(left, right) => left + right }"),
      "match pair { Pair(left, right) => (left + right) }"),
    std_testing.equal_str("parser/parses_match_expressions_and_patterns/3",
      parse_source("match result { Ok(value) => { print(value); value }, Error(message) => fail(message), }"),
      "match result { Ok(value) => { print(value); value }, Error(message) => fail(message) }"),
    std_testing.equal_str("parser/parses_match_expressions_and_patterns/4",
      parse_source("match outer { Some(value) => match value { Some(inner) => inner, None() => 0 }, None() => 0 }"),
      "match outer { Some(value) => match value { Some(inner) => inner, None() => 0 }, None() => 0 }"),
    std_testing.equal_str("parser/parses_match_expressions_and_patterns/5",
      parse_source("match value {}"),
      "match value {}")
  ]
}

