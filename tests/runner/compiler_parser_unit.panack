pure parser_unit_parses_scalar_and_array_literals(): [TestResult] {
  [
    std_testing.equal_str("parser/parses_scalar_and_array_literals/1",
      parse_source("42"),
      "42"),
    std_testing.equal_str("parser/parses_scalar_and_array_literals/2",
