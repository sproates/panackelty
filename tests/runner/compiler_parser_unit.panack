}

pure parser_unit_parses_function_declarations(): [TestResult] {
  [
    std_testing.equal_str("parser/parses_function_declarations/1",
      parse_program_source("main(): Void {}"),
      "main(): Void {}"),
    std_testing.equal_str("parser/parses_function_declarations/2",
      parse_program_source("pure answer(): Nat { 40 + 2 }"),
      "pure answer(): Nat { (40 + 2) }"),
    std_testing.equal_str("parser/parses_function_declarations/3",
      parse_program_source("pure lookup(index: Map[Str,[Nat]], fallback: Option[Nat]): Result[Nat,Str] { if len(index) > 0 { Ok(1) } else { Error(\"empty\") } }"),
      "pure lookup(index: Map[Str,[Nat]], fallback: Option[Nat]): Result[Nat,Str] { if (len(index) > 0) { Ok(1) } else { Error(\"empty\") } }"),
    std_testing.equal_str("parser/parses_function_declarations/4",
      parse_program_source("process(values: [Nat]): Void { for value in values { print(value); } }"),
      "process(values: [Nat]): Void { for value in values { print(value); } }")
  ]
}

pure parser_unit_parses_guarded_type_declarations(): [TestResult] {
  [
    std_testing.equal_str("parser/parses_guarded_type_declarations/1",
      parse_program_source("import \"types.panack\"; type Positive = Int where value > 0; type Port = Nat where value >= 1 && value <= 65535;"),
      "import \"types.panack\"; type Positive = Int where (value > 0); type Port = Nat where ((value >= 1) && (value <= 65535));")
  ]
}

pure parser_unit_parses_if_expressions_as_block_items(): [TestResult] {
  [
    std_testing.equal_str("parser/parses_if_expressions_as_block_items/1",
      parse_block_source("{ if ready { print(1); } else { print(0); }; if answer > 0 { answer } else { 0 } }"),
      "{ if ready { print(1); } else { print(0); }; if (answer > 0) { answer } else { 0 } }")
  ]
}

pure parser_unit_parses_if_expressions_with_block_branches(): [TestResult] {
  [
    std_testing.equal_str("parser/parses_if_expressions_with_block_branches/1",
      parse_source("if ready { 1 } else { 0 }"),
      "if ready { 1 } else { 0 }"),
    std_testing.equal_str("parser/parses_if_expressions_with_block_branches/2",
      parse_source("if ready { print(1); }"),
      "if ready { print(1); }"),
    std_testing.equal_str("parser/parses_if_expressions_with_block_branches/3",
      parse_source("if value > 0 { print(value); value } else { 0 }"),
      "if (value > 0) { print(value); value } else { 0 }"),
    std_testing.equal_str("parser/parses_if_expressions_with_block_branches/4",
      parse_source("1 + if ready { 2 } else { 3 }"),
      "(1 + if ready { 2 } else { 3 })")
  ]
}

pure parser_unit_parses_inferred_bindings_without_new_operators(): [TestResult] {
  [
    std_testing.equal_str("parser/parses_inferred_bindings_without_new_operators/1",
