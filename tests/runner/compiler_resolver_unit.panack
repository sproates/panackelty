import "../../src/compiler/resolver.panack"
import stdlib/testing

// Fixed resolver contracts, grouped by the former Python test methods.
// Inputs and exact expected diagnostics are independent of the resolver output.

pure resolver_unit_enforces_lexical_scope_and_shadowing(): [TestResult] {
  [
    test_equal_str("resolver/enforces_lexical_scope_and_shadowing/1",
      resolve_source("main(value: Nat, value: Nat): Void {}"),
      "parameter value is already declared"),
    test_equal_str("resolver/enforces_lexical_scope_and_shadowing/2",
      resolve_source("main(value: Nat): Void { value: Nat = 1; }"),
      "local value shadows an existing binding"),
    test_equal_str("resolver/enforces_lexical_scope_and_shadowing/3",
      resolve_source("main(): Void { value: Nat = 1; for value in 0..1 {} }"),
      "loop variable value shadows an existing binding"),
    test_equal_str("resolver/enforces_lexical_scope_and_shadowing/4",
      resolve_source("enum Option[T] { None, Some(T) } main(value: Option[Nat]): Void { match value { Some(value) => print(value), None() => print(0) }; }"),
      "pattern binding value shadows an existing binding"),
    test_equal_str("resolver/enforces_lexical_scope_and_shadowing/5",
      resolve_source("main(): Void { if true { inner: Nat = 1; } else {}; print(inner); }"),
      "unknown name inner")
  ]
}

pure resolver_unit_method_calls_use_global_callable_lookup(): [TestResult] {
  [
    test_equal_str("resolver/method_calls_use_global_callable_lookup/1",
      resolve_source("record Box { value: Nat } main(): Void { Box(1).missing(); }"),
      "unknown function missing")
  ]
}

pure resolver_unit_propagates_lexer_and_parser_failures(): [TestResult] {
  [
    test_equal_str("resolver/propagates_lexer_and_parser_failures/1",
      resolve_source("#"),
      "lexing failed"),
    test_equal_str("resolver/propagates_lexer_and_parser_failures/2",
      resolve_source("main"),
      "expected opening function parenthesis")
  ]
}

pure resolver_unit_reports_duplicate_and_conflicting_top_level_symbols(): [TestResult] {
  [
    test_equal_str("resolver/reports_duplicate_and_conflicting_top_level_symbols/1",
      resolve_source("type Value = Nat where value > 0; record Value {} main(): Void {}"),
      "top-level name Value is already declared"),
    test_equal_str("resolver/reports_duplicate_and_conflicting_top_level_symbols/2",
      resolve_source("print(): Void {} main(): Void {}"),
      "top-level name print conflicts with a constructor or built-in"),
    test_equal_str("resolver/reports_duplicate_and_conflicting_top_level_symbols/3",
      resolve_source("enum First { Same } enum Second { Same } main(): Void {}"),
      "variant constructor Same is declared by more than one enum"),
    test_equal_str("resolver/reports_duplicate_and_conflicting_top_level_symbols/4",
      resolve_source("enum Output { print } main(): Void {}"),
      "variant constructor print conflicts with a built-in"),
    test_equal_str("resolver/reports_duplicate_and_conflicting_top_level_symbols/5",
      resolve_source("enum Choice { Pick } record Pick {} main(): Void {}"),
      "top-level name Pick conflicts with a constructor or built-in")
  ]
}

pure resolver_unit_reports_module_graph_failures(): [TestResult] {
  [
    test_equal_str("resolver/reports_module_graph_failures/1",
      resolve_loaded_sources([
        LoadedSource("main.panack", "import \"missing.panack\"; main(): Void {}")
      ], "main.panack"),
      "module missing.panack is not loaded"),
    test_equal_str("resolver/reports_module_graph_failures/2",
      resolve_loaded_sources([
        LoadedSource("other.panack", "pure answer(): Nat { 42 }")
      ], "main.panack"),
      "module main.panack is not loaded"),
    test_equal_str("resolver/reports_module_graph_failures/3",
      resolve_loaded_sources([
        LoadedSource("first.panack", "import \"second.panack\";"),
        LoadedSource("second.panack", "import \"first.panack\";")
      ], "first.panack"),
      "import cycle includes first.panack"),
    test_equal_str("resolver/reports_module_graph_failures/4",
      resolve_loaded_sources([
        LoadedSource("main.panack", "main(): Void {}"),
        LoadedSource("main.panack", "pure answer(): Nat { 42 }")
      ], "main.panack"),
      "module main.panack is loaded more than once"),
    test_equal_str("resolver/reports_module_graph_failures/5",
      resolve_loaded_sources([
        LoadedSource("main.panack", "import \"first.panack\"; import \"second.panack\"; main(): Void {}"),
        LoadedSource("first.panack", "pure answer(): Nat { 1 }"),
        LoadedSource("second.panack", "pure answer(): Nat { 2 }")
      ], "main.panack"),
      "top-level name answer is already declared")
  ]
}

pure resolver_unit_reports_module_parse_and_lex_failures_with_paths(): [TestResult] {
  [
    test_equal_str("resolver/reports_module_parse_and_lex_failures_with_paths/1",
      resolve_loaded_sources([
        LoadedSource("broken.panack", "#")
      ], "broken.panack"),
      "broken.panack:1:1: unexpected character #"),
    test_equal_str("resolver/reports_module_parse_and_lex_failures_with_paths/2",
      resolve_loaded_sources([
        LoadedSource("broken.panack", "// heading\nmain")
      ], "broken.panack"),
      "broken.panack:2:5: expected opening function parenthesis")
  ]
}

pure resolver_unit_reports_name_failure_in_owning_module(): [TestResult] {
  [
    test_equal_str("resolver/reports_name_failure_in_owning_module/1",
      resolve_loaded_sources([
        LoadedSource("main.panack", "import \"broken.panack\"; main(): Void { broken(); }"),
        LoadedSource("broken.panack", "broken(): Void {\n  print(missing);\n}")
      ], "main.panack"),
      "broken.panack:2:9: unknown name missing")
  ]
}

pure resolver_unit_reports_unknown_names_functions_and_variants(): [TestResult] {
  [
    test_equal_str("resolver/reports_unknown_names_functions_and_variants/1",
      resolve_source("\nenum Option[T] { None, Some(T) }\nmain(): Void {\n  print(missing);\n  unknown();\n  option: Option[Nat] = None();\n  match option { Other(value) => value };\n}\n"),
      "unknown name missing\nunknown function unknown\nunknown variant Other")
  ]
}

pure resolver_unit_resolves_guard_value_and_recursive_calls(): [TestResult] {
  [
    test_equal_str("resolver/resolves_guard_value_and_recursive_calls/1",
      resolve_source("\ntype Positive = Int where value > 0;\npure countdown(value: Nat): Nat {\n  if value == 0 { 0 } else { countdown(value - 1) }\n}\nmain(): Void { print(countdown(3)); }\n"),
      "ok")
  ]
}

pure resolver_unit_resolves_reachable_transitive_modules(): [TestResult] {
  [
    test_equal_str("resolver/resolves_reachable_transitive_modules/1",
      resolve_loaded_sources([
        LoadedSource("main.panack", "import \"service.panack\"; main(): Void { print(result()); }"),
        LoadedSource("service.panack", "import \"values.panack\"; pure result(): Nat { answer() }"),
        LoadedSource("values.panack", "pure answer(): Nat { 42 }"),
        LoadedSource("unused.panack", "main(): Void { print(missing); }")
      ], "main.panack"),
      "ok")
  ]
}

pure resolver_unit_resolves_top_level_callables_builtins_and_local_names(): [TestResult] {
  [
    test_equal_str("resolver/resolves_top_level_callables_builtins_and_local_names/1",
      resolve_source("\nrecord Pair { left: Nat, right: Nat }\nenum Option[T] { None, Some(T) }\n\npure sum(pair: Pair): Nat { pair.left + pair.right }\n\npure value_or(option: Option[Nat], fallback: Nat): Nat {\n  match option { Some(value) => value, None() => fallback }\n}\n\nmain(): Void {\n  pair: Pair = Pair(20, 22);\n  print(sum(pair));\n  print(pair.sum());\n  mut values: Map[Str,Nat] = map();\n  values = values.put(\"answer\", 42);\n  print(values.has(\"answer\"));\n  print(values.get(\"answer\"));\n  print(set().add(\"seen\").has(\"seen\"));\n  print(value_or(Some(1), 0));\n}\n"),
      "ok")
  ]
}

pure resolver_unit_visits_a_diamond_dependency_only_once(): [TestResult] {
  [
    test_equal_str("resolver/visits_a_diamond_dependency_only_once/1",
      resolve_loaded_sources([
        LoadedSource("main.panack", "import \"left.panack\"; import \"right.panack\"; main(): Void { print(left() + right()); }"),
        LoadedSource("left.panack", "import \"shared.panack\"; pure left(): Nat { shared() }"),
        LoadedSource("right.panack", "import \"shared.panack\"; pure right(): Nat { shared() }"),
        LoadedSource("shared.panack", "pure shared(): Nat { 21 }")
      ], "main.panack"),
      "ok")
  ]
}

main(): Void {
  mut results: [TestResult] = []
  results = results.concat(resolver_unit_enforces_lexical_scope_and_shadowing())
  results = results.concat(resolver_unit_method_calls_use_global_callable_lookup())
  results = results.concat(resolver_unit_propagates_lexer_and_parser_failures())
  results = results.concat(resolver_unit_reports_duplicate_and_conflicting_top_level_symbols())
  results = results.concat(resolver_unit_reports_module_graph_failures())
  results = results.concat(resolver_unit_reports_module_parse_and_lex_failures_with_paths())
  results = results.concat(resolver_unit_reports_name_failure_in_owning_module())
  results = results.concat(resolver_unit_reports_unknown_names_functions_and_variants())
  results = results.concat(resolver_unit_resolves_guard_value_and_recursive_calls())
  results = results.concat(resolver_unit_resolves_reachable_transitive_modules())
  results = results.concat(resolver_unit_resolves_top_level_callables_builtins_and_local_names())
  results = results.concat(resolver_unit_visits_a_diamond_dependency_only_once())
  if test_report(results) > 0 { process_exit(1) }
}
