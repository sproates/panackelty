import stdlib/testing as std_testing
import stdlib/process as std_process
import stdlib/testing_files as std_testing_files
import stdlib/testing::{TestResult}
import stdlib/time as std_time
import stdlib/path as std_path
import stdlib/filesystem as std_filesystem
import stdlib/host as std_host
pure inventory_path(text: Str): Path { std_path.from_text(text)->value_or(std_path.current()) }
inventory_read(path: Str): Bytes { std_filesystem.read(inventory_path(path), 16777216)->value_or(bytes()) }
inventory_write(path: Str, data: Bytes): Void {
  match std_filesystem.write(inventory_path(path), data) {
    Ok(done) => {},
    Error(error) => { std_host.stderr("inventory fixture write failed"); std_host.exit(1); }
  }
}
inventory_command(name: Str, args: [Str], status: Nat, stdout: Str): TestResult {
  match std_process.run(inventory_path("./bin/panack"), args, bytes(), std_path.current(), [], std_time.seconds(90), 1048576) {
    Error(error) => std_testing.expect(name, false, "command failed"),
    Ok(actual) => std_testing.expect(name, actual.exit_code == status && actual.signal == 0 &&
      actual.stdout == stdout->encode_utf8() && (if status == 0 { actual.stderr == bytes() } else { actual.stderr->length() > 0 }),
      "unexpected output: " + actual.stdout->decode_utf8() + "; " + actual.stderr->decode_utf8())
  }
}
pure inventory_slice(data: Bytes, start: Nat, end: Nat): Bytes {
  if end > start + 128 {
    middle: Nat = (start + end)->divide(2)
    inventory_slice(data, start, middle)->join(inventory_slice(data, middle, end))
  } else {
    mut result: Bytes = bytes()
    for index in start..end { result = result->push(data->at(index)); }
    result
  }
}
main(): Void {
  match std_testing_files.workspace_create(inventory_path("/tmp")) {
    Error(error) => { std_host.stderr("inventory workspace failed"); std_host.exit(1); },
    Ok(workspace) => {
      root: Str = workspace.root->to_text()->value_or("")
      source: Str = root + "/main.panack"
      unused: Str = root + "/unused.panack"
      extra: Str = root + "/extra.panack"
      inventory: Str = root + "/inventory.pinv"
      second: Str = root + "/second.pinv"
      broken: Str = root + "/broken.pinv"
      before: Str = root + "/before.bc"
      after: Str = root + "/after.bc"
      inventory_write(source, "import \"unused.panack\"\nmain(): Void { print(7); }\n"->encode_utf8())
      inventory_write(unused, "pure unused(): Nat { 9 }\n"->encode_utf8())
      inventory_write(extra, "pure unimported(): Nat { 11 }\n"->encode_utf8())
      mut results: [TestResult] = []
      results = results->append(inventory_command("ordinary compile before inventory", ["compile", source, "-o", before], 0, "wrote ${before}\n"))
      results = results->append(inventory_command("create inventory including unimported file", ["inventory", source, "-o", inventory, "--include", extra], 0, "wrote inventory ${inventory}\n"))
      results = results->append(inventory_command("deterministic second inventory", ["inventory", source, "-o", second, "--include", extra], 0, "wrote inventory ${second}\n"))
      results = results->append(std_testing.expect("exact repeat identity", inventory_read(inventory)->length() > 0 && inventory_read(inventory) == inventory_read(second), "inventory differs"))
      check: [Str] = ["inventory-check", source, "--inventory", inventory, "--include", extra]
      results = results->append(inventory_command("validate inventory", check, 0, "inventory: valid\n"))
      results = results->append(inventory_command("ordinary compile after inventory", ["compile", source, "-o", after], 0, "wrote ${after}\n"))
      results = results->append(std_testing.expect("inventory preserves bytecode", inventory_read(before) == inventory_read(after), "artifact changed"))
      results = results->append(inventory_command("ordinary execution", ["run", after], 0, "7\n"))
      results = results->append(inventory_command("reject omitted root", ["inventory-check", source, "--inventory", inventory], 1, ""))
      for path in [source, unused, extra] {
        saved: Bytes = inventory_read(path)
        inventory_write(path, saved->join("// stale comment\n"->encode_utf8()))
        results = results->append(inventory_command("reject stale source including unused roots", check, 1, ""))
        inventory_write(path, saved)
      }
      saved: Bytes = inventory_read(inventory)
      for data in [bytes(), "PANACKINVENTORY2\n"->encode_utf8(), saved->join("padding"->encode_utf8()), bytes()->push(255)] {
        inventory_write(broken, data)
        results = results->append(inventory_command("reject malformed or incompatible inventory", ["inventory-check", source, "--inventory", broken, "--include", extra], 1, ""))
      }
      if saved->length() <= 101 { std_testing.report(results); std_host.stderr("missing inventory fixture"); std_host.exit(1); }
      // Same-length corruption inside the compiler identity, not just a marker.
      mut forged: Bytes = bytes()
      forged = inventory_slice(saved, 0, 100)->join(bytes()->push((saved->at(100) + 1) % 256))
      forged = forged->join(inventory_slice(saved, 101, saved->length()))
      inventory_write(broken, forged)
      results = results->append(inventory_command("reject forged compiler identity", ["inventory-check", source, "--inventory", broken, "--include", extra], 1, ""))
      saved_size: Nat = saved->length()
      inventory_write(broken, inventory_slice(saved, 0, if saved_size > 0 { saved_size - 1 } else { 0 }))
      results = results->append(inventory_command("reject truncation", ["inventory-check", source, "--inventory", broken, "--include", extra], 1, ""))
      results = results->append(inventory_command("reject missing inventory", ["inventory-check", source, "--inventory", root + "/missing"], 1, ""))
      results = results->append(inventory_command("refuse overwrite", ["inventory", source, "-o", inventory], 1, ""))
      results = results->append(std_testing.expect("existing file unchanged", inventory_read(inventory) == saved, "overwrote inventory"))
      results = results->append(inventory_command("refuse source overwrite", ["inventory", source, "-o", source], 1, ""))
      results = results->append(inventory_command("reject duplicate root alias", ["inventory", source, "-o", root + "/duplicate", "--include", root + "/./main.panack"], 1, ""))
      inventory_write(extra, "invalid syntax"->encode_utf8())
      results = results->append(inventory_command("reject invalid extra root", ["inventory", source, "-o", root + "/invalid", "--include", extra], 1, ""))
      for file in [source, unused, extra, inventory, second, broken, before, after] { std_filesystem.remove_file(inventory_path(file)); }
      match workspace->remove_empty() { Ok(done) => {}, Error(error) => { results = results->append(std_testing.expect("cleanup", false, "cleanup failed")); } }
      if std_testing.report(results) > 0 { std_host.exit(1); }
    }
  }
}
