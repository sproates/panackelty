import "../../src/compiler/parser.panack"
import stdlib/testing

pure span_text(span: SourceSpan): Str {
  start: SourcePos = span.start
  end: SourcePos = span.end
  file: Str = start.file
  first: Nat = start.offset
  last: Nat = end.offset
  line: Nat = start.line
  column: Nat = start.column
  end_line: Nat = end.line
  end_column: Nat = end.column
  "${file}|${first}:${line}:${column}-${last}:${end_line}:${end_column}"
}

pure root_span(source: Str): Str {
  match lex_file(source, "sample.panack") {
    Error(errors) => "lex error",
    Ok(tokens) => match parse_complete(tokens) {
      Error(error) => "parse error",
      Ok(expression) => match expression_span(expression) {
        None() => "unavailable",
        Some(span) => span_text(span)
      }
    }
  }
}

pure trace_block(block: Block): Str {
  mut output: Str = ""
  for statement in block.statements {
    match statement {
      BindingStatement(name, type_name, mutable, value) => { output = output + trace_span(value); },
      AssignmentStatement(name, value) => { output = output + trace_span(value); },
      ExpressionStatement(value) => { output = output + trace_span(value); },
      WhileStatement(condition, body) => { output = output + trace_span(condition) + trace_block(body); },
      ForStatement(name, iterable, body) => { output = output + trace_span(iterable) + trace_block(body); }
    }
  }
  match block.value {
    NoBlockValue() => {},
    TailBlockValue(value) => { output = output + trace_span(value); }
  }
  output
}

pure trace_children(expression: Expr): Str {
  match expression {
    LocatedExpr(span, value) => "unexpected wrapper;",
    NatExpr(value) => "", DecimalExpr(text) => "", StringExpr(text) => "", BoolExpr(value) => "",
    NameExpr(name) => "", FunctionExpr(name) => "",
    ArrayExpr(items) => { mut output: Str = ""; for item in items { output = output + trace_span(item); } output },
    UnaryExpr(operator, operand) => trace_span(operand),
    BinaryExpr(operator, left, right) => trace_span(left) + trace_span(right),
    DotCallExpr(target, name, arguments, types) => { mut output: Str = trace_span(target); for argument in arguments { output = output + trace_span(argument); } output },
    CallExpr(name, arguments, types) => { mut output: Str = ""; for argument in arguments { output = output + trace_span(argument); } output },
    FieldExpr(target, field) => trace_span(target),
    IndexExpr(target, index) => trace_span(target) + trace_span(index),
    IfExpr(condition, yes, no, has_else) => trace_span(condition) + trace_block(yes) + trace_block(no),
    BlockExpr(block) => trace_block(block),
    MatchExpr(subject, arms) => { mut output: Str = trace_span(subject); for arm in arms { output = output + trace_span(arm.body); } output }
  }
}

pure trace_span(expression: Expr): Str {
  match expression_span(expression) {
    None() => "missing;",
    Some(span) => {
      first: Nat = span.start.offset
      last: Nat = span.end.offset
      "${first}..${last};" + trace_children(unlocated_expression(expression))
    }
  }
}

pure expression_trace(source: Str): Str {
  match lex_file(source, "sample.panack") {
    Error(errors) => "lex error",
    Ok(tokens) => match parse_complete(tokens) {
      Error(error) => "parse error",
      Ok(expression) => trace_span(expression)
    }
  }
}

pure program_trace(source: Str): Str {
  match lex_file(source, "sample.panack") {
    Error(errors) => "lex error",
    Ok(tokens) => match parse_program_complete(tokens) {
      Error(error) => "parse error",
      Ok(program) => {
        mut output: Str = ""
        for declaration in program.declarations {
          match declaration {
            FunctionDeclaration(name, parameters, return_type, pure_function, async_function, body, types) => { output = output + trace_block(body); },
            TypeDeclaration(name, base, guard) => { output = output + trace_span(guard); },
            ImportDeclaration(path) => {}, RecordDeclaration(name, types, fields) => {}, EnumDeclaration(name, types, variants) => {}
          }
        }
        output
      }
    }
  }
}

main(): Void {
  mut results: [TestResult] = []
  results = results.append(test_equal_str("spans/natural", root_span("12"), "sample.panack|0:1:1-2:1:3"))
  results = results.append(test_equal_str("spans/decimal", root_span("1.25"), "sample.panack|0:1:1-4:1:5"))
  results = results.append(test_equal_str("spans/bool", root_span("false"), "sample.panack|0:1:1-5:1:6"))
  results = results.append(test_equal_str("spans/string", root_span("\"λ🙂\""), "sample.panack|0:1:1-4:1:5"))
  results = results.append(test_equal_str("spans/reference", root_span("@worker"), "sample.panack|0:1:1-7:1:8"))
  results = results.append(test_equal_str("spans/unit", root_span("()"), "sample.panack|0:1:1-2:1:3"))
  results = results.append(test_equal_str("spans/array", root_span("[1, 2]"), "sample.panack|0:1:1-6:1:7"))
  results = results.append(test_equal_str("spans/generic-call", root_span("identity[[Nat]]([1])"), "sample.panack|0:1:1-20:1:21"))
  results = results.append(test_equal_str("spans/index", root_span("items[index]"), "sample.panack|0:1:1-12:1:13"))
  results = results.append(test_equal_str("spans/method", root_span("values.map[Nat](@worker)"), "sample.panack|0:1:1-24:1:25"))
  results = results.append(test_equal_str("spans/chain", root_span("make().field[0].transform(2)"), "sample.panack|0:1:1-28:1:29"))
  results = results.append(test_equal_str("spans/unary", root_span("!-value"), "sample.panack|0:1:1-7:1:8"))
  results = results.append(test_equal_str("spans/await", root_span("await reader.call(1)"), "sample.panack|0:1:1-20:1:21"))
  results = results.append(test_equal_str("spans/binary", root_span("1 + 2 * 3"), "sample.panack|0:1:1-9:1:10"))
  results = results.append(test_equal_str("spans/range", root_span("1..2 + 3"), "sample.panack|0:1:1-8:1:9"))
  results = results.append(test_equal_str("spans/parentheses", root_span("((1 + 2))"), "sample.panack|0:1:1-9:1:10"))
  results = results.append(test_equal_str("spans/if", root_span("if flag { 1 } else { 2 }"), "sample.panack|0:1:1-24:1:25"))
  results = results.append(test_equal_str("spans/if-no-else", root_span("if flag { print(1); }"), "sample.panack|0:1:1-21:1:22"))
  results = results.append(test_equal_str("spans/match", root_span("match value { Some(x) => { x }, None() => 0 }"), "sample.panack|0:1:1-45:1:46"))
  results = results.append(test_equal_str("spans/whitespace-comments", root_span("  items[0] // trailing"), "sample.panack|2:1:3-10:1:11"))
  results = results.append(test_equal_str("spans/multiline-unicode-crlf", root_span("// λ🙂\r\n  items[\r\n    0\r\n  ] // end"), "sample.panack|9:2:3-27:4:4"))
  results = results.append(test_equal_str("spans/nested-index", expression_trace("items[indices[index]]"), "0..21;0..5;6..20;6..13;14..19;"))
  results = results.append(test_equal_str("spans/precedence", expression_trace("1 + 2 * 3"), "0..9;0..1;4..9;4..5;8..9;"))
  results = results.append(test_equal_str("spans/left-associative", expression_trace("10 - 3 - 2"), "0..10;0..6;0..2;5..6;9..10;"))
  results = results.append(test_equal_str("spans/parenthesised-receiver", expression_trace("(items)[index]"), "0..14;0..7;8..13;"))
  results = results.append(test_equal_str("spans/lowered-method", expression_trace("values.map[Nat](@worker)"), "0..24;0..6;16..23;"))
  results = results.append(test_equal_str("spans/conditional-children", expression_trace("if flag { 1 } else { 2 }"), "0..24;3..7;10..11;21..22;"))
  results = results.append(test_equal_str("spans/match-block", expression_trace("match value { Some(x) => { x }, None() => 0 }"), "0..45;6..11;25..30;27..28;42..43;"))
  results = results.append(test_equal_str("spans/synthetic-unavailable", trace_span(BinaryExpr("+", NatExpr(1), NatExpr(2))), "missing;"))
  results = results.append(test_equal_str("spans/empty-input", root_span(""), "parse error"))
  results = results.append(test_equal_str("spans/generic-body", program_trace("pure pick[T](items: [T], index: Nat): T { items[index] }"), "42..54;42..47;48..53;"))
  results = results.append(test_equal_str("spans/binding-assignment-loops", program_trace("main(): Void { mut x = 1 + 2; x = 3; while x > 0 { x = 0; } for item in [1, 2] { print(item); } }"), "23..28;23..24;27..28;34..35;43..48;43..44;47..48;55..56;72..78;73..74;76..77;81..92;87..91;"))
  results = results.append(test_equal_str("spans/implicit-semicolons", program_trace("main(): Void {\n  mut x = 1\n  x = 2\n  print(x)\n}"), "25..26;33..34;37..45;43..44;"))
  if test_report(results) > 0 { process_exit(1) }
}
