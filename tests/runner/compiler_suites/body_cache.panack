import project/src/compiler/body_cache_codec::{encode_checked_bodies, decode_checked_bodies}
import project/src/compiler/loader::{load_project_sources, check_project_sources, check_project_sources_cached}
import project/src/compiler/module_reuse::{CachedModuleBodies}
import project/src/compiler/module_bodies::{BoundFunctionBody, BoundBody, BodyNode.BodyEmpty, BodyCheckStatus.BodyIdentityChecked}
import project/src/compiler/types::{SourcePos, SourceSpan}
import project/src/compiler/emitter::{compile_program}
import project/src/bytecode/codec::{serialize_bytecode, encode_u32}
import stdlib/bytes as byte_buffer
import stdlib/testing as testing
pub import stdlib/testing::{TestResult}

pub body_cache_tests(): [TestResult] {
  mut results: [TestResult] = []
  for fixture in ["collections", "records_and_enums", "callables", "async_await", "domain_constraints", "owned_core_methods", "string_boundaries"] {
    source = load_project_sources("tests/functional/cases/" + fixture + "/main.panack")
    fresh = check_project_sources(source)
    results = results.append(testing.expect(fixture + " cache fixture accepted", fresh.preparation != None(), "fixture rejected"))
    encoded = encode_checked_bodies(fresh.module_bodies)
    match decode_checked_bodies(encoded) {
      None() => { results = results.append(testing.expect(fixture + " cached bodies decode", false, "decode failed")) },
      Some(decoded) => {
        mut cached: [CachedModuleBodies] = []
        for module in fresh.modules {
          mut bodies: [BoundFunctionBody] = []
          for body in decoded {
            if body.signature.binding.identity.module == module.bindings.identity { bodies = bodies.append(body) }
          }
          cached = cached.append(CachedModuleBodies(module.bindings.identity, bodies))
        }
        restored = check_project_sources_cached(source, cached)
        results = results.append(testing.expect(fixture + " disk bodies preserve diagnostics",
          restored.snapshot.project.diagnostics == fresh.diagnostics, "diagnostic mismatch"))
        results = results.append(testing.expect(fixture + " disk bodies preserve bytecode",
          serialize_bytecode(compile_program(restored.snapshot.project.program)) == serialize_bytecode(compile_program(fresh.program)), "bytecode mismatch"))
        results = results.append(testing.equal_nat(fixture + " reuses every body module", restored.reused.len(), fresh.modules.len()))
      }
    }
    // Exercise framing, incomplete dictionaries and incomplete body payloads.
    for size in [0, 1, 4, encoded.length().divide(2)] {
      results = results.append(testing.expect(fixture + " truncated cache rejected",
        decode_checked_bodies(byte_buffer.slice(encoded, 0, size)) == None(), "truncated cache accepted"))
    }
    results = results.append(testing.expect(fixture + " trailing cache bytes rejected",
      decode_checked_bodies(encoded.push(0)) == None(), "trailing cache bytes accepted"))
  }
  source = load_project_sources("tests/functional/cases/hello_world/main.panack")
  fresh = check_project_sources(source)
  signature = fresh.module_bodies[0].signature
  for coordinate in [0, 4294967294, 4294967295, 18446744073709551616] {
    span = SourceSpan(SourcePos("λ.panack", coordinate, 7, 11), SourcePos("λ.panack", 3, coordinate, coordinate))
    body = BoundFunctionBody(signature, [], BoundBody(BodyEmpty(), span, [], None(), [], [], [], [], [], []), [], BodyIdentityChecked(), None())
    encoded = encode_checked_bodies([body])
    decoded = decode_checked_bodies(encoded)
    results = results.append(testing.expect("position coordinate boundary round trip", decoded == Some([body]), "position changed"))
    length = encoded.length()
    if length > 0 {
      results = results.append(testing.expect("position coordinate payload truncation rejected",
        decode_checked_bodies(byte_buffer.slice(encoded, 0, length - 1)) == None(), "truncated position payload accepted"))
    }
  }
  for end_position in [SourcePos("other.panack", 4294967295, 2, 3),
      SourcePos("other.panack", 1, 18446744073709551616, 3),
      SourcePos("other.panack", 1, 2, 4294967295)] {
    end_span = SourceSpan(SourcePos("λ.panack", 1, 2, 3), end_position)
    end_body = BoundFunctionBody(signature, [], BoundBody(BodyEmpty(), end_span, [], None(), [], [], [], [], [], []), [], BodyIdentityChecked(), None())
    results = results.append(testing.expect("span end large coordinate round trip",
      decode_checked_bodies(encode_checked_bodies([end_body])) == Some([end_body]), "end position changed"))
  }
  span = SourceSpan(SourcePos("position.panack", 16909060, 84281096, 151653132), SourcePos("position.panack", 13, 14, 15))
  body = BoundFunctionBody(signature, [], BoundBody(BodyEmpty(), span, [], None(), [], [], [], [], [], []), [], BodyIdentityChecked(), None())
  encoded = encode_checked_bodies([body])
  marker = encode_u32(16909060).join(encode_u32(84281096)).join(encode_u32(151653132))
  mut position: Option[Nat] = None()
  for index in 0..encoded.length() {
    if index >= 4 && index + 12 <= encoded.length() && byte_buffer.slice(encoded, index, index + 12) == marker {
      position = Some(index - 4)
    }
  }
  results = results.append(testing.expect("position fixture locates its encoded coordinates", position != None(), "position marker missing"))
  match position {
    None() => {},
    Some(start) => {
      if start >= 4 {
        results = results.append(testing.expect("span fixture follows the final body-node tag",
          byte_buffer.slice(encoded, start - 4, start) == encode_u32(17), "body tag not found"))
        for invalid_tag in [18, 4294967295] {
          invalid_node = byte_buffer.slice(encoded, 0, start - 4).join(encode_u32(invalid_tag))
            .join(byte_buffer.slice(encoded, start, encoded.length()))
          results = results.append(testing.expect("out-of-range body-node tag rejected",
            decode_checked_bodies(invalid_node) == None(), "unknown body node accepted"))
        }
      }
      for size in [0, 3, 4, 7, 8, 11, 12, 15, 16, 19, 20, 23, 24, 27, 28, 31] {
        results = results.append(testing.expect("partial fixed-width position rejected",
          decode_checked_bodies(byte_buffer.slice(encoded, 0, start + size)) == None(), "truncated position accepted"))
      }
      corrupted = byte_buffer.slice(encoded, 0, start).join(encode_u32(4294967294))
        .join(byte_buffer.slice(encoded, start + 4, encoded.length()))
      results = results.append(testing.expect("position dictionary index is checked", decode_checked_bodies(corrupted) == None(), "invalid file index accepted"))
      bad_end_file = byte_buffer.slice(encoded, 0, start + 16).join(encode_u32(4294967294))
        .join(byte_buffer.slice(encoded, start + 20, encoded.length()))
      results = results.append(testing.expect("span end dictionary index is checked", decode_checked_bodies(bad_end_file) == None(), "invalid end file index accepted"))
    }
  }
  results
}
