import stdlib/testing_commands as std_testing_commands
import stdlib/testing_files as std_testing_files
import project/src/compiler/path_support as path_support
import stdlib/path as std_path
import stdlib/testing as std_testing
import stdlib/process as std_process
import project/src/compiler/filesystem_support as filesystem_support
import stdlib/result as std_result
import stdlib/testing::{TestResult}
import stdlib/testing_files::{TestWorkspace, HostError}
import stdlib/testing_commands::{TestCommand, ProcessOutput}
import stdlib/time as std_time
import stdlib/filesystem::{FileKind.SymbolicLink}
import stdlib/bytes as byte_buffer
import stdlib/environment as std_environment
import stdlib/filesystem as std_filesystem
import stdlib/host as std_host
pure host_path(value: Str): Path { std_result.value_or(std_path.from_text(value), std_path.current()) }
pure host_text(value: Path): Str { std_result.value_or(std_path.to_text(value), "invalid path") }
pure host_error[T](result: Result[T,HostError]): Str {
  match result { Ok(value) => "ok", Error(problem) => problem.code }
}
pure host_contains(actual: Str, expected: Str): Bool {
  mut found = false
  for index in 0..len(actual) {
    if starts_with_at(actual, expected, index) { found = true }
  }
  found
}
pure host_repeat(input: Bytes, count: Nat): Bytes {
  mut result = input
  for unused in 0..count { result = byte_buffer.join(result, result) }
  result
}
pure host_digit(character: Str): Nat {
  digits = "0123456789abcdef"
  mut result: Nat = 0
  for index in 0..16 { if digits[index] == character { result = index } }
  result
}
pure host_hex(value: Str): Bytes {
  mut output = byte_buffer.empty()
  mut high: Nat = 0
  mut half = false
  for index in 0..len(value) {
    character = value[index]
    if !is_whitespace(character) {
      digit = host_digit(character)
      if !half { high = digit; half = true }
      else { output = byte_buffer.push(output, high * 16 + digit); half = false }
    }
  }
  output
}

host_impure(name: Str, workspace: TestWorkspace): TestResult {
  root = host_text(workspace.root)
  target = host_path("${root}/pure.bc")
  data = host_hex(filesystem_support.read_text("tests/fixtures/host_runtime/pure_${name}.hex"))
  match std_filesystem.write(target, data) {
    Error(problem) => std_testing.expect("pure ${name}", false, problem.code),
    Ok(written) => {
      result = std_testing_commands.run_command("pure ${name}", TestCommand(host_path("./panack"),
        ["check", host_text(target)], byte_buffer.empty(), std_path.current(), [],
        std_time.seconds(10), 1048576),
        ProcessOutput(1, 0, byte_buffer.empty(), utf8_encode("error: pure function calls impure function\n")))
      match std_filesystem.remove_file(target) {
        Error(problem) => std_testing.expect("pure ${name}", false, "bytecode cleanup failed"),
        Ok(removed) => result
      }
    }
  }
}

host_fixture(name: Str, filename: Str, args: [Str], environment: [Str],
             expected: ProcessOutput): TestResult {
  std_testing_commands.run_command(name, TestCommand(host_path("./panack"),
    ["run", "tests/fixtures/host_runtime/${filename}.panack"].concat(args),
    byte_buffer.empty(), std_path.current(), environment, std_time.seconds(20), 1048576), expected)
}

host_fixture_error(name: Str, filename: Str, expected: Str): TestResult {
  match std_process.run(host_path("./panack"),
      ["run", "tests/fixtures/host_runtime/${filename}.panack"], byte_buffer.empty(),
      std_path.current(), [], std_time.seconds(20), 1048576) {
    Error(problem) => std_testing.expect(name, false, problem.code),
    Ok(command) => std_testing.expect(name,
      command.exit_code == 1 && command.signal == 0 && command.stdout == byte_buffer.empty() &&
      host_contains(utf8_decode(command.stderr), expected), "unexpected trap or exit")
  }
}

host_nested(workspace: TestWorkspace, source: Str, args: Bool): [TestResult] {
  mut results: [TestResult] = []
  root = host_text(workspace.root)
  artifact = host_path("${root}/nested.bc")
  program = host_path("${root}/wrapper.panack")
  source_file = "tests/fixtures/host_runtime/${source}.panack"
  artifact_file = host_text(artifact)
  results = results.append(std_testing_commands.run_command("compile nested ${source}",
    TestCommand(host_path("./panack"), ["compile", source_file, "-o", artifact_file],
      byte_buffer.empty(), std_path.current(), [], std_time.seconds(20), 1048576),
    ProcessOutput(0, 0, utf8_encode("wrote ${artifact_file}\n"), byte_buffer.empty())))
  script = if args {
    "import stdlib/host as std_host\n" +
      "fixture_read(path: Str): Bytes { read_bytes(path) }\n" +
      "main(): Void { std_host.run(fixture_read(\"${artifact_file}\"), [\"child\"]) }\n"
  } else {
    "import stdlib/host as std_host\n" +
      "fixture_suffix(path: Str): Str { path_suffix(path) }\n" +
      "fixture_resolve(path: Str): Str { path_resolve(path) }\n" +
      "fixture_exists(path: Str): Bool { file_exists(path) }\n" +
      "fixture_read(path: Str): Bytes { read_bytes(path) }\n" +
      "main(): Void { print(fixture_suffix(\"${artifact_file}\")); " +
      "print(fixture_exists(fixture_resolve(\"${artifact_file}\"))); " +
      "std_host.run(fixture_read(\"${artifact_file}\"), []); }\n"
  }
  results = results.append(std_testing.equal_str("write nested ${source}",
    host_error(std_filesystem.write(program, utf8_encode(script))), "ok"))
  expected = if args { "1\nchild\n" } else { ".bc\ntrue\nnested\n" }
  results = results.append(std_testing_commands.run_command("execute nested ${source}",
    TestCommand(host_path("./panack"), ["run", host_text(program)], byte_buffer.empty(),
      std_path.current(), [], std_time.seconds(20), 1048576),
    ProcessOutput(0, 0, utf8_encode(expected), byte_buffer.empty())))
  results = results.append(std_testing.equal_str("remove nested wrapper ${source}",
    host_error(std_filesystem.remove_file(program)), "ok"))
  results = results.append(std_testing.equal_str("remove nested bytecode ${source}",
    host_error(std_filesystem.remove_file(artifact)), "ok"))
  results
}

host_direct(workspace: TestWorkspace): [TestResult] {
  mut results: [TestResult] = []
  root = workspace.root
  root_text = host_text(root)
  sh = host_path("/bin/sh")
  empty = byte_buffer.empty()
  results = results.append(std_testing.expect("character classes stay ASCII",
    is_letter("A") && !is_letter("λ") && is_digit("7") && !is_digit("٧") &&
      is_whitespace("\t"), "unexpected character classification"))

  zeros = host_repeat(byte_buffer.push(empty, 0), 17)
  payload = host_repeat(byte_buffer.push(empty, 120), 17)
  large = std_process.run(sh, ["-c", "dd if=/dev/zero bs=1024 count=128 2>/dev/null; " +
    "dd if=/dev/zero bs=1024 count=128 >&2 2>/dev/null; cat"], payload,
    root, [], std_time.seconds(3), 1000000)
  match large {
    Error(problem) => { results = results.append(std_testing.expect("large duplex streams", false, problem.code)) },
    Ok(command) => {
      results = results.append(std_testing.expect("large duplex streams",
        command.exit_code == 0 && command.signal == 0 &&
        command.stdout == byte_buffer.join(zeros, payload) && command.stderr == zeros,
        "binary streams or process status differed"))
    }
  }
  match std_process.run(sh, ["-c", "exit 0"], payload, root, [], std_time.seconds(3), 100) {
    Error(problem) => { results = results.append(std_testing.expect("early stdin close", false, problem.code)) },
    Ok(command) => { results = results.append(std_testing.expect("early stdin close",
      command.exit_code == 0 && command.signal == 0, "child did not exit cleanly")) }
  }
  // /tmp may be a symlink: compare the actual directory, not shell pwd spelling.
  match std_process.run(sh, ["-c", "test . -ef \"$1\" || exit 8; " +
      "printf '%s\\n' \"$PANACK_HOST_TEST\"; printf '\\377' >&2; exit 9",
      "host-cwd-check", root_text],
      empty, root, ["PANACK_HOST_TEST=value"], std_time.seconds(3), 1000) {
    Error(problem) => { results = results.append(std_testing.expect("environment cwd and binary stderr", false, problem.code)) },
    Ok(command) => {
      mut invalid = byte_buffer.push(empty, 255)
      results = results.append(std_testing.expect("environment cwd and binary stderr",
        command.exit_code == 9 && command.signal == 0 &&
        command.stdout == utf8_encode("value\n") && command.stderr == invalid,
        "process output differed"))
      results = results.append(std_testing.equal_str("invalid UTF-8 process output",
        host_error(std_host.decode_utf8(command.stderr)), "invalid_utf8"))
    }
  }
  match std_process.run(sh, ["-c", "kill -TERM $$"], empty, root, [], std_time.seconds(3), 100) {
    Error(problem) => { results = results.append(std_testing.expect("child signal", false, problem.code)) },
    Ok(command) => { results = results.append(std_testing.equal_nat("child signal", command.signal, 15)) }
  }
  results = results.append(std_testing.expect("no child environment leakage",
    !(std_environment.get("PANACK_HOST_TEST") != None()), "process environment escaped child"))
  results = results.append(std_testing.equal_str("duplicate environment is rejected",
    host_error(std_process.run(sh, ["-c", "true"], empty, root,
      ["A=1", "A=2"], std_time.seconds(1), 10)), "invalid_environment"))
  results = results.append(std_testing.equal_str("missing cwd fails launch",
    host_error(std_process.run(sh, ["-c", "true"], empty, host_path("${root_text}/missing"),
      [], std_time.seconds(1), 10)), "launch_failed"))

  start = std_time.now()
  results = results.append(std_testing.equal_str("bounded timeout",
    host_error(std_process.run(sh, ["-c", "sleep 10 & wait"], empty, root, [],
      std_time.milliseconds(20), 10)), "timeout"))
  match start {
    Error(problem) => { results = results.append(std_testing.expect("bounded timeout elapsed", false, "clock unavailable")) },
    Ok(before) => {
      match std_time.now() {
        Error(problem) => { results = results.append(std_testing.expect("bounded timeout elapsed", false, "clock unavailable")) },
        Ok(after) => {
          results = results.append(std_testing.expect("bounded timeout elapsed",
            std_time.ticks(std_time.difference(after, before)) < 2000000000,
            "timeout took two seconds or more"))
        }
      }
    }
  }
  results = results.append(std_testing.equal_str("output bound",
    host_error(std_process.run(sh, ["-c", "printf x"], empty, root, [],
      std_time.seconds(1), 0)), "output_limit"))
  results = results.append(std_testing.equal_str("negative timeout",
    host_error(std_process.run(sh, ["-c", "true"], empty, root, [],
      std_time.from_nanoseconds(-1), 10)), "negative_duration"))
  results = results.append(std_testing.equal_str("out of range timeout",
    host_error(std_process.run(sh, ["-c", "true"], empty, root, [],
      std_time.seconds(31536001), 10)), "out_of_range"))
  results = results.append(std_testing.equal_str("zero timeout",
    host_error(std_process.run(sh, ["-c", "touch should-not-exist"], empty, root, [],
      std_time.from_nanoseconds(0), 10)), "timeout"))
  results = results.append(std_testing.equal_str("zero timeout starts no child",
    host_error(std_filesystem.metadata(host_path("${root_text}/should-not-exist"))), "not_found"))
  before_sleep = std_time.now()
  results = results.append(std_testing.equal_str("sleep accepts one millisecond",
    host_error(std_host.sleep(std_time.milliseconds(1))), "ok"))
  after_sleep = std_time.now()
  match before_sleep {
    Error(problem) => { results = results.append(std_testing.expect("sleep elapsed", false, "clock unavailable")) },
    Ok(started) => match after_sleep {
      Error(problem) => { results = results.append(std_testing.expect("sleep elapsed", false, "clock unavailable")) },
      Ok(ended) => { results = results.append(std_testing.expect("sleep elapsed",
        std_time.ticks(std_time.difference(ended, started)) >= 1000000,
        "returned before requested duration")) }
    }
  }
  results = results.append(std_testing.equal_str("negative sleep",
    host_error(std_host.sleep(std_time.from_nanoseconds(-1))), "negative_duration"))
  results = results.append(std_testing.equal_str("too long sleep",
    host_error(std_host.sleep(std_time.seconds(31536001))), "out_of_range"))

  file = host_path("${root_text}/file")
  link = host_path("${root_text}/link")
  fifo = host_path("${root_text}/fifo")
  results = results.append(std_testing.equal_str("write file", host_error(std_filesystem.write(file, utf8_encode("ab"))), "ok"))
  results = results.append(std_testing.equal_str("file size limit", host_error(std_filesystem.read(file, 1)), "output_limit"))
  results = results.append(std_testing.equal_str("directory is not regular file", host_error(std_filesystem.read(root, 0)), "not_regular_file"))
  match std_process.run(sh, ["-c", "ln -s \"$1\" \"$2\"; mkfifo \"$3\"", "file-setup",
      host_text(file), host_text(link), host_text(fifo)], empty, root, [], std_time.seconds(5), 100) {
    Error(problem) => { results = results.append(std_testing.expect("symlink and fifo setup", false, problem.code)) },
    Ok(command) => { results = results.append(std_testing.expect("symlink and fifo setup",
      command.exit_code == 0 && command.signal == 0 && command.stderr == empty,
      "symlink or fifo creation failed")) }
  }
  match std_filesystem.metadata(link) {
    Error(problem) => { results = results.append(std_testing.expect("symlink metadata", false, problem.code)) },
    Ok(info) => { results = results.append(std_testing.expect("symlink metadata",
      info.kind == SymbolicLink(), "final link was followed")) }
  }
  results = results.append(std_testing.expect("symlink reads target", std_result.value_or(std_filesystem.read(link, 2), empty) == utf8_encode("ab"), "link read failed"))
  results = results.append(std_testing.equal_str("fifo is not regular file", host_error(std_filesystem.read(fifo, 0)), "not_regular_file"))
  results = results.append(std_testing.equal_str("remove symlink", host_error(std_filesystem.remove_file(link)), "ok"))
  results = results.append(std_testing.expect("target remains after removing link", std_result.value_or(std_filesystem.read(file, 2), empty) == utf8_encode("ab"), "target lost"))

  match std_filesystem.temp_file(root) {
    Error(problem) => { results = results.append(std_testing.expect("first private temporary", false, problem.code)) },
    Ok(first) => {
      match std_filesystem.temp_file(root) {
        Error(problem) => { results = results.append(std_testing.expect("second private temporary", false, problem.code)) },
        Ok(second) => {
          results = results.append(std_testing.expect("unique temporary files", first != second, "names collided"))
          script = "if stat -c %a \"$1\" >/dev/null 2>&1; then stat -c %a \"$1\"; else stat -f %Lp \"$1\"; fi"
          results = results.append(std_testing_commands.run_command("private temporary mode", TestCommand(sh,
            ["-c", script, "mode", host_text(first)], empty, root, [], std_time.seconds(5), 100),
            ProcessOutput(0, 0, utf8_encode("600\n"), empty)))
          results = results.append(std_testing.equal_str("remove second temporary", host_error(std_filesystem.remove_file(second)), "ok"))
        }
      }
      results = results.append(std_testing.equal_str("remove first temporary", host_error(std_filesystem.remove_file(first)), "ok"))
    }
  }
  raw_name = byte_buffer.push(utf8_encode("${root_text}/"), 255)
  match std_path.from_native(raw_name) {
    Error(problem) => { results = results.append(std_testing.expect("non UTF-8 path setup", false, "path rejected")) },
    Ok(raw) => {
      match std_filesystem.write(raw, utf8_encode("raw")) {
        Error(problem) => { results = results.append(std_testing.expect("non UTF-8 filesystem name", true, "host filesystem rejected raw name")) },
        Ok(written) => {
          mut found = false
          match std_filesystem.list_directory(root) {
            Error(problem) => { results = results.append(std_testing.expect("non UTF-8 directory listing", false, problem.code)) },
            Ok(names) => {
              for entry in names {
                if std_path.native_bytes(entry) == byte_buffer.push(empty, 255) { found = true }
              }
              results = results.append(std_testing.expect("non UTF-8 directory listing", found, "raw name absent"))
            }
          }
          results = results.append(std_testing.expect("non UTF-8 file data", std_result.value_or(std_filesystem.read(raw, 3), empty) == utf8_encode("raw"), "raw file unreadable"))
          results = results.append(std_testing.equal_str("remove non UTF-8 name", host_error(std_filesystem.remove_file(raw)), "ok"))
        }
      }
    }
  }
  for item in [fifo, file] {
    name = host_text(item)
    results = results.append(std_testing.equal_str("cleanup ${name}", host_error(std_filesystem.remove_file(item)), "ok"))
  }
  results
}

host_paths(): [TestResult] {
  mut results: [TestResult] = []
  names = ["a", "a//b", "/", "//", "///", "//host/a", "./", "a/../b/"]
  directories = [".", "a/", "/", "//", "///", "//host", ".", "a/.."]
  filenames = ["a", "b", "none", "none", "none", "a", ".", "b"]
  for index in 0..len(names) {
    current_name = names[index]
    input = host_path(current_name)
    results = results.append(std_testing.expect("directory ${current_name}",
      std_path.native_bytes(std_path.directory(input)) == utf8_encode(directories[index]), "parent path changed"))
    actual = match std_path.filename(input) { None() => "none", Some(value) => host_text(value) }
    results = results.append(std_testing.equal_str("filename ${current_name}", actual, filenames[index]))
  }
  results = results.append(std_testing.equal_str("lexical path join", path_support.join("project/src", "../tests"), "project/tests"))
  results
}

main(): Void {
  match std_testing_files.workspace_create(host_path("/tmp")) {
    Error(problem) => { eprint("host test workspace failed: ${problem.code}"); std_host.exit(1) },
    Ok(workspace) => {
      mut results = host_direct(workspace).concat(host_paths())
      results = results.append(host_fixture("testing report order and empty case", "library_reports", [], [],
        ProcessOutput(0, 0, utf8_encode("tests: 0, failures: 0\n0\nFAIL first: reason\nPASS second\ntests: 2, failures: 1\n1\n"), byte_buffer.empty())))
      results = results.append(host_fixture("testing command comparison", "library_commands", [], [],
        ProcessOutput(0, 0, utf8_encode("PASS match\nFAIL exit: expected exit 0, got 2\nFAIL signal: expected signal 0, got 9\nFAIL stdout: stdout differed\nFAIL stderr: stderr differed\nFAIL host: command failed: timeout\ntests: 6, failures: 5\n5\n"), byte_buffer.empty())))
      results = results.append(host_fixture("stdlib environment option", "environment_option", [], ["PRESENT=configured"],
        ProcessOutput(0, 0, utf8_encode("configured\nnone\n"), byte_buffer.empty())))
      results = results.append(host_fixture("command argument snapshot", "arguments", ["alpha", "beta"], [],
        ProcessOutput(0, 0, utf8_encode("2\nalpha\n"), byte_buffer.empty())))
      results = results.append(host_fixture("environment snapshot", "environment_snapshot", [], ["PANACK_PRESENT=configured"],
        ProcessOutput(0, 0, utf8_encode("true\nconfigured\nfalse\n"), byte_buffer.empty())))
      missing = std_process.run(host_path("/bin/sh"), ["-c", "unset PANACK_MISSING; exec ./panack \"$@\"",
        "host-missing", "run", "tests/fixtures/host_runtime/environment_missing.panack"], byte_buffer.empty(),
        std_path.current(), [], std_time.seconds(20), 1048576)
      match missing {
        Error(problem) => { results = results.append(std_testing.expect("missing environment traps", false, problem.code)) },
        Ok(command) => { results = results.append(std_testing.expect("missing environment traps",
          command.exit_code == 1 && command.signal == 0 && command.stdout == byte_buffer.empty() &&
          host_contains(utf8_decode(command.stderr), "environment variable was not found"),
          "missing variable did not trap")) }
      }
      results = results.append(host_fixture("stderr and exit status", "process_exit", [], [],
        ProcessOutput(7, 0, byte_buffer.empty(), utf8_encode("failure\n"))))
      results = results.append(host_fixture("native arguments, environment and status", "native_boundary",
        ["argument"], ["PANACK_NATIVE_TEST=snapshot"],
        ProcessOutput(7, 0, utf8_encode("argument\nsnapshot\n"), utf8_encode("native stderr\n"))))
      results = results.append(host_fixture("lexical path join source", "path_join", [], [],
        ProcessOutput(0, 0, utf8_encode("project/tests\n/project/tests\n"), byte_buffer.empty())))
      results = results.concat(host_nested(workspace, "nested", false))
      results = results.concat(host_nested(workspace, "nested_arguments", true))
      for service in ["read_file", "read_bytes", "write_file", "write_bytes"] {
        results = results.append(host_fixture_error("NUL ${service}", "nul_${service}",
          "VM trap: path contains NUL byte"))
      }
      for operation in ["fs_read", "fs_write", "fs_metadata", "fs_list", "fs_create_directory",
          "fs_remove_file", "fs_remove_directory", "fs_temp_file", "fs_temp_directory",
          "host_sleep", "process_run", "instant_now"] {
        results = results.append(host_impure(operation, workspace))
      }
      results = results.append(std_testing_commands.run_command("ignored inherited SIGPIPE",
        TestCommand(host_path("/bin/sh"),
          ["-c", "trap '' PIPE; exec ./panack run tests/functional/cases/host_process/main.panack"],
          byte_buffer.empty(), std_path.current(), [], std_time.seconds(20), 1048576),
        ProcessOutput(0, 0, filesystem_support.read_file_bytes("tests/functional/cases/host_process/expected.stdout"), byte_buffer.empty())))
      workspace_name = host_text(workspace.root)
      missing_root = host_path("${workspace_name}/missing")
      results = results.append(std_testing.equal_str("missing fixture root", host_error(std_testing_files.discover_fixtures(missing_root)), "not_found"))
      regular = host_path("${workspace_name}/regular")
      results = results.append(std_testing.equal_str("fixture file setup", host_error(std_filesystem.write(regular, utf8_encode("data"))), "ok"))
      results = results.append(std_testing.equal_str("regular file fixture root", host_error(std_testing_files.discover_fixtures(regular)), "not_directory"))
      results = results.append(std_testing.equal_str("fixture file cleanup", host_error(std_filesystem.remove_file(regular)), "ok"))
      match std_testing_files.workspace_remove_empty(workspace) {
        Error(problem) => { results = results.append(std_testing.expect("host workspace cleanup", false, problem.code)) },
        Ok(removed) => {}
      }
      if std_testing.report(results) > 0 { std_host.exit(1) }
    }
  }
}
