import stdlib/process as std_process
import stdlib/testing_files as std_testing_files
import stdlib/text as std_text
import stdlib/testing as std_testing
import stdlib/result as std_result
import stdlib/testing::{TestOutcome.TestPassed, TestOutcome.TestFailed, TestResult}
import stdlib/testing_files::{TestWorkspace}
import stdlib/testing_commands::{TestCommand, ProcessOutput}
import stdlib/time as std_time
import stdlib/path as std_path
import stdlib/filesystem as std_filesystem
import stdlib/testing_commands as std_testing_commands
import stdlib/bytes as byte_buffer
import stdlib/host as std_host

// Run from the repository root. Native harness tests cover failure propagation.
pure runner_path(text: Str): Path {
  std_result.value_or(std_path.from_text(text), std_path.current())
}

pure runner_child(parent: Path, name: Str): Path {
  std_result.value_or(std_path.join(parent, runner_path(name)), parent)
}

pure runner_name(directory: Path): Str {
  component = match std_path.filename(directory) {
    Some(value) => value,
    None() => directory
  }
  std_result.value_or(std_path.to_text(component), "invalid-name")
}

pure runner_selected(name: Str): Bool {
  name == "async_await" || name == "callables" || name == "cli_check_disasm" || name == "cli_commands" ||
    name == "cli_explanations" || name == "cli_diagnostic_display" || name == "cli_environment_files" ||
    name == "cli_rational_failures" ||
    name == "core_methods" || name == "collections" || name == "compiler_lexer" ||
    name == "compiler_skeleton" ||
    name == "guard_fact_refresh" || name == "hello_world" || name == "host_capabilities" ||
    name == "host_process" || name == "host_types" ||
    name == "local_inference" || name == "modules" || name == "optional_else" ||
    name == "rational_unit" || name == "records_and_enums" ||
    name == "semicolonless" || name == "string_boundaries" ||
    name == "testing_commands" || name == "testing_fixtures" ||
    name == "testing_library" || name == "stdlib" || name == "stdlib_module_api" ||
    name == "vm_numeric_boundaries"
}

runner_source(directory: Path): Result[Path,Str] {
  local = runner_child(directory, "main.panack")
  reference = runner_child(directory, "source.path")
  local_exists = match std_filesystem.read(local, 1048576) { Ok(value) => true, Error(error) => false }
  reference_exists = match std_filesystem.read(reference, 4096) { Ok(value) => true, Error(error) => false }
  if local_exists == reference_exists {
    Error("expected exactly one of main.panack or source.path")
  } else {
    if local_exists { Ok(local) } else {
      reference_text = std_result.value_or(std_path.to_text(reference), "")
      // Resolve both paths physically; compare with a directory separator so
      // sibling prefixes and links outside the checkout cannot be accepted.
      script = "IFS= read -r target < \"$1\" || [ -n \"$target\" ] || exit 2; " +
        "[ -n \"$target\" ] || exit 2; root=$(realpath .) || exit 2; " +
        "resolved=$(realpath \"$target\") || exit 2; " +
        "case \"$resolved\" in \"$root\"/*) printf '%s\\n' \"$resolved\" ;; *) exit 3 ;; esac"
      match std_process.run(runner_path("/bin/sh"), ["-c", script, "runner-source", reference_text],
          byte_buffer.empty(), std_path.current(), [], std_time.seconds(5), 4096) {
        Error(error) => Error("source.path resolution failed: ${error.code}"),
        Ok(output) => {
          if output.exit_code != 0 || output.signal != 0 {
            Error("source.path points outside the repository or cannot be resolved")
          } else {
            value = std_text.decode_utf8(output.stdout)
            size = value.len()
            if size == 0 { Error("source.path resolution returned no path") }
            else {
              match std_path.from_text(value.slice(0, size - 1)) {
                Ok(path) => Ok(path),
                Error(error) => Error("source.path resolution returned invalid path")
              }
            }
          }
        }
      }
    }
  }
}

pure runner_command(arguments: [Str], clear_stdlib_value: Bool): TestCommand {
  runner_timed_command(arguments, clear_stdlib_value, 20)
}

pure runner_bootstrap_command(arguments: [Str], timeout: Nat): TestCommand {
  TestCommand(runner_path("./panack"), arguments, byte_buffer.empty(), std_path.current(),
    ["PANACKELTY_BOOTSTRAP_ROOT=."], std_time.seconds(timeout), 1048576)
}

pure runner_timed_command(arguments: [Str], clear_stdlib_value: Bool,
                          timeout: Nat): TestCommand {
  // std_process.run can override inherited variables, but cannot remove them.
  // The stdlib fixture expects this variable to be absent, as in the Python harness.
  if clear_stdlib_value {
    TestCommand(runner_path("/bin/sh"),
      ["-c", "unset PANACKELTY_STDLIB_VALUE PANACKELTY_BOOTSTRAP_ROOT; exec \"$@\"", "runner-stdlib",
        "./panack"].concat(arguments), byte_buffer.empty(), std_path.current(), [],
      std_time.seconds(timeout), 1048576)
  } else {
    TestCommand(runner_path("/usr/bin/env"),
      ["-u", "PANACKELTY_BOOTSTRAP_ROOT", "./panack"].concat(arguments), byte_buffer.empty(), std_path.current(), [],
      std_time.seconds(timeout), 1048576)
  }
}

pure runner_bytes_preview(value: Bytes): Str {
  text = std_text.decode_utf8(value)
  shown = if text.len() < 160 { text.len() } else { 160 }
  preview = text.slice(0, shown)
  if text.len() > shown { "${preview}..." } else { preview }
}

runner_test_command(name: Str, command: TestCommand, expected: ProcessOutput,
                    include_diagnostics: Bool): TestResult {
  match std_process.run(command.executable, command.arguments, command.stdin,
      command.working_directory, command.environment, command.timeout,
      command.output_limit) {
    Error(error) => {
      code = error.code
      std_testing.expect(name, false, "command failed: ${code}")
    },
    Ok(actual) => {
      result = std_testing_commands.command_output(name, actual, expected)
      if !include_diagnostics { result } else {
        match result.outcome {
          TestPassed() => result,
          TestFailed(reason) => {
            actual_exit = actual.exit_code
            actual_signal = actual.signal
            stdout_length = byte_buffer.length(actual.stdout)
            stdout_preview = runner_bytes_preview(actual.stdout)
            stderr_length = byte_buffer.length(actual.stderr)
            stderr_preview = runner_bytes_preview(actual.stderr)
            std_testing.expect(name, false,
              "${reason}; exit=${actual_exit}; signal=${actual_signal}; stdout_bytes=${stdout_length}; stdout_prefix=${stdout_preview}; stderr_bytes=${stderr_length}; stderr_prefix=${stderr_preview}")
          }
        }
      }
    }
  }
}

runner_case(directory: Path, workspace: TestWorkspace): [TestResult] {
  name = runner_name(directory)
  source_result = runner_source(directory)
  expected_file = runner_child(directory, "expected.stdout")
  artifact = runner_child(workspace.root, "${name}.bc")
  expected_path = std_result.value_or(std_path.to_text(artifact), "invalid-artifact")
  match source_result {
    Error(reason) => [std_testing.expect("case/${name}/fixture", false, reason)],
    Ok(source) => runner_program("case/${name}", source, expected_file, artifact, expected_path)
  }
}

runner_program(label: Str, source: Path, expected_file: Path,
               artifact: Path, expected_path: Str): [TestResult] {
  source_path = std_result.value_or(std_path.to_text(source), "invalid-source")
  match std_filesystem.read(expected_file, 1048576) {
    Error(error) => {
      code = error.code
      [std_testing.expect("${label}/fixture", false, "fixture read failed: ${code}")]
    },
    Ok(expected) => {
      mut results: [TestResult] = []
      // This source path builds the complete compiler before executing it.
      // Match compiler_driver's build allowance; ordinary cases keep 20s.
      // Both CLI corpora execute many bounded child commands. Apply the same
      // aggregate allowance to source and saved-bytecode execution.
      execution_timeout = if label == "case/cli_commands" || label == "case/cli_explanations" {
        120
      } else { 20 }
      source_timeout = if label == "case/compiler_skeleton" {
        90
      } else {
        execution_timeout
      }
      source_command = if label == "case/compiler_skeleton" || label == "case/compiler_lexer" {
        runner_bootstrap_command(["run", source_path], source_timeout)
      } else {
        runner_timed_command(["run", source_path], label == "case/stdlib", source_timeout)
      }
      source_result = runner_test_command("${label}/source",
        source_command,
        ProcessOutput(0, 0, expected, byte_buffer.empty()), label == "case/cli_commands")
      results = results.append(source_result)

      compile_command = if label == "case/compiler_skeleton" {
        // The bootstrap recipe has already built and verified this artifact.
        TestCommand(runner_path("/bin/sh"),
          ["-c", "if [ -n \"${PANACK_TEST_COMPILER:-}\" ]; then cp \"$PANACK_TEST_COMPILER\" \"$1\" && printf 'wrote %s\\n' \"$1\"; else exec ./panack compile \"$2\" -o \"$1\"; fi",
            "runner-compiler", expected_path, source_path], byte_buffer.empty(), std_path.current(),
          ["PANACKELTY_BOOTSTRAP_ROOT=."],
          std_time.seconds(90), 1048576)
      } else if label == "case/compiler_lexer" {
        runner_bootstrap_command(["compile", source_path, "-o", expected_path], source_timeout)
      } else {
        runner_command(["compile", source_path, "-o", expected_path], label == "case/stdlib")
      }
      compile_result = runner_test_command("${label}/compile", compile_command,
        ProcessOutput(0, 0, std_text.encode_utf8("wrote ${expected_path}\n"), byte_buffer.empty()),
        label == "case/cli_commands")
      results = results.append(compile_result)
      match compile_result.outcome {
        TestPassed() => {
          results = results.append(runner_test_command("${label}/bytecode",
            runner_timed_command(["run", expected_path], label == "case/stdlib",
              execution_timeout),
            ProcessOutput(0, 0, expected, byte_buffer.empty()), label == "case/cli_commands"))
        },
        TestFailed(reason) => {}
      }
      match std_filesystem.remove_file(artifact) {
        Ok(value) => {},
        Error(error) => {
          code = error.code
          results = results.append(std_testing.expect("${label}/artifact cleanup",
            false, "cleanup failed: ${code}"))
        }
      }
      results
    }
  }
}

pure runner_stem(name: Str, extension: Str): Option[Str] {
  size = name.len()
  // Both supported suffixes have seven code points.
  if size > 7 {
    if name.starts_with_at(extension, size - 7) {
      Some(name.slice(0, size - 7))
    } else { None() }
  } else { None() }
}

pure runner_contains_file(names: [Path], filename: Str): Bool {
  mut found = false
  for name in names {
    if runner_name(name) == filename { found = true }
  }
  found
}

runner_namespace_main(namespace_root: Path, name: Str): Option[Path] {
  directory = runner_child(namespace_root, name)
  match std_filesystem.list_directory(directory) {
    Error(error) => None(),
    Ok(names) => {
      if runner_contains_file(names, "main.panack") {
        Some(runner_child(directory, "main.panack"))
      } else { None() }
    }
  }
}

runner_example_exists(source_root: Path, namespace_root: Path, name: Str): Bool {
  match std_filesystem.list_directory(source_root) {
    Error(error) => false,
    Ok(sources) => {
      runner_contains_file(sources, "${name}.panack") ||
        match runner_namespace_main(namespace_root, name) {
          Some(source) => true,
          None() => false
        }
    }
  }
}

runner_examples(workspace: TestWorkspace, selected: Str): [TestResult] {
  source_root = runner_path("examples")
  namespace_root = runner_child(source_root, "namespaces")
  output_root = runner_path("tests/functional/expected/examples")
  match std_filesystem.list_directory(output_root) {
    Error(error) => {
      code = error.code
      [std_testing.expect("example discovery", false, "output discovery failed: ${code}")]
    },
    Ok(outputs) => {
      mut results: [TestResult] = []
      mut count: Nat = 0
      match std_filesystem.list_directory(source_root) {
        Error(error) => {
          code = error.code
          results = results.append(std_testing.expect("example discovery", false,
            "source discovery failed: ${code}"))
        },
        Ok(sources) => {
          for source_name in sources {
            match runner_stem(runner_name(source_name), ".panack") {
              None() => {},
              Some(name) => {
                if selected == "" || selected == name {
                  count = count + 1
                  source = runner_child(source_root, "${name}.panack")
                  expected_file = runner_child(output_root, "${name}.stdout")
                  artifact = runner_child(workspace.root, "example-${name}.bc")
                  artifact_text = std_result.value_or(std_path.to_text(artifact), "invalid-artifact")
                  if runner_contains_file(outputs, "${name}.stdout") {
                    results = results.concat(runner_program("example/${name}", source,
                      expected_file, artifact, artifact_text))
                  } else {
                    results = results.append(std_testing.expect("example/${name}/fixture", false,
                      "missing expected stdout"))
                  }
                }
              }
            }
          }
        }
      }
      match std_filesystem.list_directory(namespace_root) {
        Error(error) => {
          code = error.code
          results = results.append(std_testing.expect("namespace example discovery", false,
            "source discovery failed: ${code}"))
        },
        Ok(directories) => {
          for directory_name in directories {
            name = runner_name(directory_name)
            match runner_namespace_main(namespace_root, name) {
              None() => {},
              Some(source) => {
                if selected == "" || selected == name {
                  count = count + 1
                  expected_file = runner_child(output_root, "${name}.stdout")
                  artifact = runner_child(workspace.root, "example-${name}.bc")
                  artifact_text = std_result.value_or(std_path.to_text(artifact), "invalid-artifact")
                  if runner_contains_file(outputs, "${name}.stdout") {
                    results = results.concat(runner_program("example/${name}", source,
                      expected_file, artifact, artifact_text))
                  } else {
                    results = results.append(std_testing.expect("example/${name}/fixture", false,
                      "missing expected stdout"))
                  }
                }
              }
            }
          }
        }
      }
      for output_name in outputs {
        match runner_stem(runner_name(output_name), ".stdout") {
          None() => {},
          Some(name) => {
            if (selected == "" || selected == name) &&
                !runner_example_exists(source_root, namespace_root, name) {
              results = results.append(std_testing.expect("example/${name}/fixture", false,
                "missing example source"))
            }
          }
        }
      }
      expected_count: Nat = if selected == "" { 23 } else { 1 }
      results.append(std_testing.equal_nat("selected example count", count, expected_count))
    }
  }
}

pure runner_normalize_diagnostic(value: Str, prefix: Str): Str {
  mut normalized: Str = ""
  mut start: Nat = 0
  for index in 0..value.len() {
    if index >= start && value.starts_with_at(prefix, index) {
      segment = value.slice(start, index)
      normalized = "${normalized}${segment}<case>"
      start = index + prefix.len()
    }
  }
  remainder = value.slice(start, value.len())
  "${normalized}${remainder}"
}

runner_failure_prefix(directory: Path): Result[Str,Str] {
  directory_text = std_result.value_or(std_path.to_text(directory), "")
  match std_process.run(runner_path("/bin/sh"),
      ["-c", "exec realpath \"$1\"", "runner-failure", directory_text],
      byte_buffer.empty(), std_path.current(), [], std_time.seconds(5), 4096) {
    Error(error) => Error("path resolution failed: ${error.code}"),
    Ok(output) => {
      if output.exit_code != 0 || output.signal != 0 {
        Error("path resolution failed")
      } else {
        value = std_text.decode_utf8(output.stdout)
        size = value.len()
        if size == 0 { Error("path resolution returned no path") }
        else { Ok(value.slice(0, size - 1)) }
      }
    }
  }
}

runner_failure_command(label: Str, command: TestCommand,
                       expected: Bytes, prefix: Str): TestResult {
  match std_process.run(command.executable, command.arguments, command.stdin,
      command.working_directory, command.environment, command.timeout,
      command.output_limit) {
    Error(error) => {
      code = error.code
      std_testing.expect(label, false, "command failed: ${code}")
    },
    Ok(output) => {
      normalized = std_text.encode_utf8(runner_normalize_diagnostic(
        std_text.decode_utf8(output.stderr), prefix))
      std_testing_commands.command_output(label,
        ProcessOutput(output.exit_code, output.signal, output.stdout, normalized),
        ProcessOutput(1, 0, byte_buffer.empty(), expected))
    }
  }
}

runner_failure(directory: Path, workspace: TestWorkspace): [TestResult] {
  name = runner_name(directory)
  label = "failure/${name}"
  source = runner_child(directory, "main.panack")
  expected_file = runner_child(directory, "expected.stderr")
  artifact = runner_child(workspace.root, "failure-${name}.bc")
  match std_filesystem.read(source, 1048576) {
    Error(error) => {
      code = error.code
      [std_testing.expect("${label}/fixture", false, "source read failed: ${code}")]
    },
    Ok(source_contents) => {
      match std_filesystem.read(expected_file, 1048576) {
        Error(error) => {
          code = error.code
          [std_testing.expect("${label}/fixture", false, "expected stderr read failed: ${code}")]
        },
        Ok(expected) => {
          match runner_failure_prefix(directory) {
            Error(reason) => [std_testing.expect("${label}/fixture", false, reason)],
            Ok(prefix) => {
              // Use the same physical path for invocation and normalization.
              // A checkout may reach tests through a symlink.
              source_text = "${prefix}/main.panack"
              artifact_text = std_result.value_or(std_path.to_text(artifact), "invalid-artifact")
              mut results: [TestResult] = []
              results = results.append(runner_failure_command("${label}/check",
                runner_command(["check", source_text], false), expected, prefix))
              results = results.append(runner_failure_command("${label}/compile",
                runner_command(["compile", source_text, "-o", artifact_text], false),
                expected, prefix))
              if name == "unknown_name" || name == "imported_unknown_name" ||
                  name == "unexpected_character" || name == "same_line_without_separator" ||
                  name == "inference_empty_array" || name == "inference_immutable" ||
                  name.starts_with_at("fact_mutation_", 0) {
                results = results.append(runner_failure_command("${label}/run",
                  runner_command(["run", source_text], false), expected, prefix))
                results = results.append(runner_failure_command("${label}/disasm",
                  runner_command(["disasm", source_text], false), expected, prefix))
              }
              match std_filesystem.metadata(artifact) {
                Ok(metadata) => {
                  results = results.append(std_testing.expect("${label}/no artifact", false,
                    "failed compilation left bytecode"))
                  match std_filesystem.remove_file(artifact) {
                    Ok(value) => {},
                    Error(error) => {
                      code = error.code
                      results = results.append(std_testing.expect("${label}/artifact cleanup", false,
                        "cleanup failed: ${code}"))
                    }
                  }
                },
                Error(error) => {
                  code = error.code
                  results = results.append(std_testing.expect("${label}/no artifact",
                    code == "not_found", "artifact inspection failed: ${code}"))
                }
              }
              results
            }
          }
        }
      }
    }
  }
}

runner_failures(workspace: TestWorkspace, selected: Str): [TestResult] {
  match std_testing_files.discover_fixtures(runner_path("tests/functional/failures")) {
    Error(error) => {
      code = error.code
      [std_testing.expect("failure discovery", false, "discovery failed: ${code}")]
    },
    Ok(directories) => {
      mut results: [TestResult] = []
      mut count: Nat = 0
      for directory in directories {
        if selected == "" || runner_name(directory) == selected {
          count = count + 1
          results = results.concat(runner_failure(directory, workspace))
        }
      }
      expected_count: Nat = if selected == "" { 60 } else { 1 }
      results.append(std_testing.equal_nat("selected failure count", count, expected_count))
    }
  }
}

main(): Void {
  arguments = std_host.arguments()
  if len(arguments) > 0 && arguments[0] == "--self-test" {
    count = std_testing.report([std_testing.expect("deliberate mismatch", false, "expected failure")])
    if count > 0 { std_host.exit(1) }
  } else {
    inject_cleanup_failure = len(arguments) >= 2 && arguments[0] == "--test-cleanup-failure"
    selected_case = if len(arguments) == 2 && arguments[0] == "--case" { arguments[1] }
      else { if inject_cleanup_failure && len(arguments) == 4 && arguments[2] == "--case" {
        arguments[3]
      } else { "" } }
    selected_example = if len(arguments) == 2 && arguments[0] == "--example" {
      arguments[1]
    } else { "" }
    selected_failure = if len(arguments) == 2 && arguments[0] == "--failure" {
      arguments[1]
    } else { "" }
    only_failures = len(arguments) == 1 && arguments[0] == "--failures-only"
    parent = if inject_cleanup_failure { runner_path(arguments[1]) } else { runner_path("/tmp") }
    match std_testing_files.workspace_create(parent) {
      Error(error) => {
        code = error.code
        print("workspace creation failed: ${code}")
        std_host.exit(1)
      },
      Ok(workspace) => {
        mut results: [TestResult] = []
        mut found: Nat = 0
        match std_testing_files.discover_fixtures(runner_path("tests/functional/cases")) {
          Error(error) => {
            code = error.code
            results = results.append(std_testing.expect("fixture discovery", false,
              "discovery failed: ${code}"))
          },
          Ok(directories) => {
            for directory in directories {
              name = runner_name(directory)
              if runner_selected(name) && !only_failures && selected_example == "" && selected_failure == "" &&
                  (selected_case == "" || selected_case == name) {
                found = found + 1
                results = results.concat(runner_case(directory, workspace))
              }
            }
          }
        }
        expected_count: Nat = if only_failures || selected_example != "" || selected_failure != "" { 0 }
          else { if selected_case == "" { 30 } else { 1 } }
        results = results.append(std_testing.equal_nat("selected fixture count", found, expected_count))
        if selected_case == "" && selected_failure == "" && !only_failures {
          results = results.concat(runner_examples(workspace, selected_example))
        }
        if selected_case == "" && selected_example == "" {
          results = results.concat(runner_failures(workspace, selected_failure))
        }
        sentinel = runner_child(workspace.root, "runner-cleanup-sentinel")
        if inject_cleanup_failure {
          match std_filesystem.write(sentinel, std_text.encode_utf8("deliberate cleanup obstacle")) {
            Ok(value) => {},
            Error(error) => {
              code = error.code
              results = results.append(std_testing.expect("cleanup injection", false,
                "sentinel creation failed: ${code}"))
            }
          }
        }
        match std_testing_files.workspace_remove_empty(workspace) {
          Ok(value) => {},
          Error(error) => {
            code = error.code
            results = results.append(std_testing.expect("workspace cleanup", false,
              "cleanup failed: ${code}"))
          }
        }
        if inject_cleanup_failure {
          match std_filesystem.remove_file(sentinel) {
            Ok(value) => {},
            Error(error) => {
              code = error.code
              results = results.append(std_testing.expect("cleanup recovery", false,
                "sentinel removal failed: ${code}"))
            }
          }
          match std_testing_files.workspace_remove_empty(workspace) {
            Ok(value) => {},
            Error(error) => {
              code = error.code
              results = results.append(std_testing.expect("workspace recovery", false,
                "workspace removal failed: ${code}"))
            }
          }
        }
        failures = std_testing.report(results)
        if failures > 0 { std_host.exit(1) }
      }
    }
  }
}
