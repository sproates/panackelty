import stdlib/testing
import stdlib/testing_files
import stdlib/testing_commands
import stdlib/text

// Run from the repository root. This covers success fixtures and examples;
// failure cases stay with the Python runner.
pure runner_path(text: Str): Path {
  result_value_or(path_from_text(text), path_current())
}

pure runner_child(parent: Path, name: Str): Path {
  result_value_or(path_append(parent, runner_path(name)), parent)
}

pure runner_name(directory: Path): Str {
  component = match path_filename(directory) {
    Some(value) => value,
    None() => directory
  }
  result_value_or(path_to_text(component), "invalid-name")
}

pure runner_selected(name: Str): Bool {
  name == "callables" || name == "collections" || name == "compiler_lexer" ||
    name == "compiler_skeleton" ||
    name == "hello_world" || name == "host_capabilities" ||
    name == "host_process" || name == "host_types" ||
    name == "local_inference" || name == "modules" || name == "optional_else" ||
    name == "rational_unit" || name == "records_and_enums" ||
    name == "semicolonless" || name == "string_boundaries" ||
    name == "testing_commands" || name == "testing_fixtures" ||
    name == "testing_library" || name == "stdlib" ||
    name == "vm_numeric_boundaries"
}

runner_source(directory: Path): Result[Path,Str] {
  local = runner_child(directory, "main.panack")
  reference = runner_child(directory, "source.path")
  local_exists = match fs_read(local, 1048576) { Ok(value) => true, Error(error) => false }
  reference_exists = match fs_read(reference, 4096) { Ok(value) => true, Error(error) => false }
  if local_exists == reference_exists {
    Error("expected exactly one of main.panack or source.path")
  } else {
    if local_exists { Ok(local) } else {
      reference_text = result_value_or(path_to_text(reference), "")
      // Resolve both paths physically; compare with a directory separator so
      // sibling prefixes and links outside the checkout cannot be accepted.
      script = "IFS= read -r target < \"$1\" || [ -n \"$target\" ] || exit 2; " +
        "[ -n \"$target\" ] || exit 2; root=$(realpath .) || exit 2; " +
        "resolved=$(realpath \"$target\") || exit 2; " +
        "case \"$resolved\" in \"$root\"/*) printf '%s\\n' \"$resolved\" ;; *) exit 3 ;; esac"
      match process_run(runner_path("/bin/sh"), ["-c", script, "runner-source", reference_text],
          bytes(), path_current(), [], duration_seconds(5), 4096) {
        Error(error) => Error("source.path resolution failed: ${error.code}"),
        Ok(output) => {
          if output.exit_code != 0 || output.signal != 0 {
            Error("source.path points outside the repository or cannot be resolved")
          } else {
            value = utf8_decode(output.stdout)
            size = text_length(value)
            if size == 0 { Error("source.path resolution returned no path") }
            else {
              match path_from_text(text_slice(value, 0, size - 1)) {
                Ok(path) => Ok(path),
                Error(error) => Error("source.path resolution returned invalid path")
              }
            }
          }
        }
      }
    }
  }
}

pure runner_command(arguments: [Str], clear_stdlib_value: Bool): TestCommand {
  // process_run can override inherited variables, but cannot remove them.
  // The stdlib fixture expects this variable to be absent, as in the Python harness.
  if clear_stdlib_value {
    TestCommand(runner_path("/bin/sh"),
      ["-c", "unset PANACKELTY_STDLIB_VALUE; exec \"$@\"", "runner-stdlib",
        "./panack"].concat(arguments), bytes(), path_current(), [],
      duration_seconds(20), 1048576)
  } else {
    TestCommand(runner_path("./panack"), arguments, bytes(), path_current(), [],
      duration_seconds(20), 1048576)
  }
}

runner_case(directory: Path, workspace: TestWorkspace): [TestResult] {
  name = runner_name(directory)
  source_result = runner_source(directory)
  expected_file = runner_child(directory, "expected.stdout")
  artifact = runner_child(workspace.root, "${name}.bc")
  expected_path = result_value_or(path_to_text(artifact), "invalid-artifact")
  match source_result {
    Error(reason) => [test_expect("case/${name}/fixture", false, reason)],
    Ok(source) => runner_program("case/${name}", source, expected_file, artifact, expected_path)
  }
}

runner_program(label: Str, source: Path, expected_file: Path,
               artifact: Path, expected_path: Str): [TestResult] {
  source_path = result_value_or(path_to_text(source), "invalid-source")
  match fs_read(expected_file, 1048576) {
    Error(error) => {
      code = error.code
      [test_expect("${label}/fixture", false, "fixture read failed: ${code}")]
    },
    Ok(expected) => {
      mut results: [TestResult] = []
      source_result = test_run_command("${label}/source",
        runner_command(["run", source_path], label == "case/stdlib"),
        ProcessOutput(0, 0, expected, bytes()))
      results = results.append(source_result)

      compile_command = if label == "case/compiler_skeleton" {
        // The bootstrap recipe has already built and verified this artifact.
        TestCommand(runner_path("/bin/sh"),
          ["-c", "if [ -n \"${PANACK_TEST_COMPILER:-}\" ]; then cp \"$PANACK_TEST_COMPILER\" \"$1\" && printf 'wrote %s\\n' \"$1\"; else exec ./panack compile \"$2\" -o \"$1\"; fi",
            "runner-compiler", expected_path, source_path], bytes(), path_current(), [],
          duration_seconds(20), 1048576)
      } else {
        runner_command(["compile", source_path, "-o", expected_path], label == "case/stdlib")
      }
      compile_result = test_run_command("${label}/compile", compile_command,
        ProcessOutput(0, 0, utf8_encode("wrote ${expected_path}\n"), bytes()))
      results = results.append(compile_result)
      match compile_result.outcome {
        TestPassed() => {
          results = results.append(test_run_command("${label}/bytecode",
            runner_command(["run", expected_path], label == "case/stdlib"),
            ProcessOutput(0, 0, expected, bytes())))
        },
        TestFailed(reason) => {}
      }
      match fs_remove_file(artifact) {
        Ok(value) => {},
        Error(error) => {
          code = error.code
          results = results.append(test_expect("${label}/artifact cleanup",
            false, "cleanup failed: ${code}"))
        }
      }
      results
    }
  }
}

pure runner_stem(name: Str, extension: Str): Option[Str] {
  size = text_length(name)
  // Both supported suffixes have seven code points.
  if size > 7 {
    if text_starts_with_at(name, extension, size - 7) {
      Some(text_slice(name, 0, size - 7))
    } else { None() }
  } else { None() }
}

pure runner_contains_file(names: [Path], filename: Str): Bool {
  mut found = false
  for name in names {
    if runner_name(name) == filename { found = true }
  }
  found
}

runner_examples(workspace: TestWorkspace, selected: Str): [TestResult] {
  source_root = runner_path("examples")
  output_root = runner_path("tests/functional/expected/examples")
  match fs_list(source_root) {
    Error(error) => {
      code = error.code
      [test_expect("example discovery", false, "source discovery failed: ${code}")]
    },
    Ok(sources) => {
      match fs_list(output_root) {
        Error(error) => {
          code = error.code
          [test_expect("example discovery", false, "output discovery failed: ${code}")]
        },
        Ok(outputs) => {
          mut results: [TestResult] = []
          mut count: Nat = 0
          for source_name in sources {
            match runner_stem(runner_name(source_name), ".panack") {
              None() => {},
              Some(name) => {
                if selected == "" || selected == name {
                  count = count + 1
                  source = runner_child(source_root, "${name}.panack")
                  expected_file = runner_child(output_root, "${name}.stdout")
                  artifact = runner_child(workspace.root, "example-${name}.bc")
                  artifact_text = result_value_or(path_to_text(artifact), "invalid-artifact")
                  if runner_contains_file(outputs, "${name}.stdout") {
                    results = results.concat(runner_program("example/${name}", source,
                      expected_file, artifact, artifact_text))
                  } else {
                    results = results.append(test_expect("example/${name}/fixture", false,
                      "missing expected stdout"))
                  }
                }
              }
            }
          }
          for output_name in outputs {
            match runner_stem(runner_name(output_name), ".stdout") {
              None() => {},
              Some(name) => {
                if (selected == "" || selected == name) &&
                    !runner_contains_file(sources, "${name}.panack") {
                  results = results.append(test_expect("example/${name}/fixture", false,
                    "missing example source"))
                }
              }
            }
          }
          expected_count: Nat = if selected == "" { 20 } else { 1 }
          results.append(test_equal_nat("selected example count", count, expected_count))
        }
      }
    }
  }
}

main(): Void {
  arguments = command_args()
  if len(arguments) > 0 && arguments[0] == "--self-test" {
    count = test_report([test_expect("deliberate mismatch", false, "expected failure")])
    if count > 0 { process_exit(1) }
  } else {
    inject_cleanup_failure = len(arguments) >= 2 && arguments[0] == "--test-cleanup-failure"
    selected_case = if len(arguments) == 2 && arguments[0] == "--case" { arguments[1] }
      else { if inject_cleanup_failure && len(arguments) == 4 && arguments[2] == "--case" {
        arguments[3]
      } else { "" } }
    selected_example = if len(arguments) == 2 && arguments[0] == "--example" {
      arguments[1]
    } else { "" }
    parent = if inject_cleanup_failure { runner_path(arguments[1]) } else { runner_path("/tmp") }
    match test_workspace_create(parent) {
      Error(error) => {
        code = error.code
        print("workspace creation failed: ${code}")
        process_exit(1)
      },
      Ok(workspace) => {
        mut results: [TestResult] = []
        mut found: Nat = 0
        match test_discover_fixtures(runner_path("tests/functional/cases")) {
          Error(error) => {
            code = error.code
            results = results.append(test_expect("fixture discovery", false,
              "discovery failed: ${code}"))
          },
          Ok(directories) => {
            for directory in directories {
              name = runner_name(directory)
              if runner_selected(name) && selected_example == "" &&
                  (selected_case == "" || selected_case == name) {
                found = found + 1
                results = results.concat(runner_case(directory, workspace))
              }
            }
          }
        }
        expected_count: Nat = if selected_example != "" { 0 }
          else { if selected_case == "" { 20 } else { 1 } }
        results = results.append(test_equal_nat("selected fixture count", found, expected_count))
        if selected_case == "" {
          results = results.concat(runner_examples(workspace, selected_example))
        }
        sentinel = runner_child(workspace.root, "runner-cleanup-sentinel")
        if inject_cleanup_failure {
          match fs_write(sentinel, utf8_encode("deliberate cleanup obstacle")) {
            Ok(value) => {},
            Error(error) => {
              code = error.code
              results = results.append(test_expect("cleanup injection", false,
                "sentinel creation failed: ${code}"))
            }
          }
        }
        match test_workspace_remove_empty(workspace) {
          Ok(value) => {},
          Error(error) => {
            code = error.code
            results = results.append(test_expect("workspace cleanup", false,
              "cleanup failed: ${code}"))
          }
        }
        if inject_cleanup_failure {
          match fs_remove_file(sentinel) {
            Ok(value) => {},
            Error(error) => {
              code = error.code
              results = results.append(test_expect("cleanup recovery", false,
                "sentinel removal failed: ${code}"))
            }
          }
          match test_workspace_remove_empty(workspace) {
            Ok(value) => {},
            Error(error) => {
              code = error.code
              results = results.append(test_expect("workspace recovery", false,
                "workspace removal failed: ${code}"))
            }
          }
        }
        failures = test_report(results)
        if failures > 0 { process_exit(1) }
      }
    }
  }
}
