import project/src/packages/archive::{stage_archive, discard_archive}
import project/src/packages/tree_digest::{tree_digest, verify_tree_digest}
import stdlib/testing as testing
import stdlib/host as host
import stdlib/filesystem as filesystem
import stdlib/path as path

main(): Void {
  arguments = host.arguments()
  match stage_archive(arguments[0], arguments[1]) {
    Error(problem) => { print(problem); host.exit(1) },
    Ok(archive) => {
      expected: Str = if arguments.len() == 3 { arguments[2] }
        else { "dc14fa4336cf0b13632c89c8cc0914684e89544f8b16a28d118dc50d8a5d4e29" }
      actual = tree_digest(archive.root, archive.entries)
      verified = verify_tree_digest(archive.root, expected)
      mut changed: Bool = false
      match path.from_text(archive.root + "/nested/example.txt") {
        Error(problem) => {},
        Ok(file) => match filesystem.write(file, "changed".encode_utf8()) {
          Error(problem) => {},
          Ok(unit) => { changed = true }
        }
      }
      corrupt = verify_tree_digest(archive.root, expected)
      cleanup = discard_archive(archive)
      results = [
        testing.expect("canonical tree matches independent vector", actual == Ok(expected), "wrong canonical digest"),
        testing.expect("extracted tree verifies", verified == Ok(()), "tree verification failed"),
        testing.expect("changed cache file is rejected", changed && match corrupt {
          Error(problem) => true, Ok(unit) => false
        }, "changed tree accepted"),
        testing.expect("staging directory removed", cleanup == Ok(()), "cleanup failed")
      ]
      if testing.report(results) > 0 { host.exit(1) }
    }
  }
}
