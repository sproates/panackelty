import project/src/packages/command_diagnostic::{validate_package_command}
import project/src/packages/input_diagnostic::{input_problem, encoding_problem, input_read_problem}
import project/src/packages/manifest::{parse_package_manifest}
import project/src/packages/diagnostic::{checksum_problem, problem_value, publication_problem}
import project/src/packages/remote_archive::{http_status_problem, http_limit_problem, archive_redirect}
import project/src/packages/diagnostic::{package_problem, problem_context, render_problem, diagnostic_text}
import stdlib/testing as testing
import stdlib/host as host
import stdlib/bytes as byte_buffer
import project/src/packages/diagnostic::{PackageProblem}
import project/src/packages/selective_update::{validate_selective_update}
import project/src/packages/lock::{PackageLock, PackageLockEdge}
import project/src/project_model/package_manifest::{ManifestJsonValue.ManifestJsonObject, PackageManifestError}
import project/src/packages/remote_archive::{http_problem}
import project/packages/http/src/types::{HttpError.DnsFailure, HttpError.TlsFailure, HttpError.Timeout, HttpError.ProtocolError}
import project/src/packages/tar_header::{tar_normalize_path, tar_number}

pure failure_reason(result: Result[Unit, PackageProblem]): Str {
  match result { Error(problem) => problem.reason, Ok(unit) => "unexpected success" }
}
pure failure_message(result: Result[Unit, PackageProblem]): Str {
  match result { Error(problem) => problem.message, Ok(unit) => "unexpected success" }
}
pure text_failure[T](result: Result[T, PackageProblem]): Str {
  match result { Error(problem) => problem.message, Ok(value) => "unexpected success" }
}
pure parsed_problem(text: Str): PackageProblem {
  match parse_package_manifest(text.encode_utf8(), "1.0.0") {
    Error(error) => input_problem("panack.json", text.encode_utf8(), error, false),
    Ok(value) => package_problem("UNEXPECTED", "unexpected success")
  }
}

main(): Void {
  leaf = package_problem("PKG_INTEGRITY", "digest mismatch")
  inner = problem_context(leaf, "outer -> inner")
  outer = problem_context(inner, "app -> outer")
  rendered = render_problem(package_problem("PKG_CACHE_MISSING", "missing cache"), "/tmp/Ian's app/panack.json", "run")
  expected_tail = "  panack deps restore --project '/tmp/Ian'\"'\"'s app/panack.json'"
  control = byte_buffer.empty().push(27).decode_utf8()
  chosen = PackageLockEdge("chosen", "pkg.chosen@1.0.0", ManifestJsonObject([]))
  other = PackageLockEdge("other", "pkg.other@1.0.0", ManifestJsonObject([]))
  changed = PackageLockEdge("other", "pkg.other@2.0.0", ManifestJsonObject([]))
  before = PackageLock("app", "1.0.0", "", "test", [chosen, other], [])
  after = PackageLock("app", "1.0.0", "", "test", [chosen, changed], [])
  syntax = parsed_problem("{\n broken")
  shape = parsed_problem("{}")
  permission = package_problem("PKG_CACHE_INVALID", "cannot inspect cache entry")
  state = package_problem("PKG_CACHE_STATE_MISSING", "state record missing")
  offline_missing = render_problem(package_problem("PKG_CACHE_MISSING", "missing"), "/app/panack.json", "deps restore --offline")
  invalid_text = input_problem("panack.lock.json", byte_buffer.empty().push(255), PackageManifestError("invalid UTF-8", 0), true)
  denied = input_read_problem("panack.json", "/app/panack.json", "permission_denied", false)
  bounded = input_read_problem("panack.lock.json", "/app/panack.lock.json", "output_limit", true)
  publication = publication_problem("/app/.panack_modules/demo.library", "destination_conflict", false)
  state_save = publication_problem("/app/.panack_modules/.state/lock.json", "permission_denied", true)
  unknown_offset = input_problem("panack.lock.json", "{}".encode_utf8(), PackageManifestError("missing field", 0), true)
  results = [
    testing.equal_str("archive download limit is specific", http_limit_problem("response body").message, "Cannot finish downloading the archive because the archive exceeds Panack's 64 MiB download limit."),
    testing.equal_str("chunk line limit is specific", http_limit_problem("chunk line").message, "Cannot finish downloading the archive because a chunk-size line exceeds Panack's 8 KiB limit."),
    testing.equal_str("header limit includes trailers", http_limit_problem("response trailers").message, "Cannot finish downloading the archive because the HTTP headers and trailers exceed Panack's combined 64 KiB limit."),
    testing.equal_str("informational response count is specific", http_limit_problem("informational responses").message, "Cannot finish downloading the archive because the server sent more than Panack's limit of eight informational responses before the archive response."),
    testing.equal_str("unknown manifest field names the actual field", parsed_problem("{\"typo\":true}").reason, "Unknown manifest field: 'typo'."),
    testing.expect("relative redirect accepted", archive_redirect("https://example.test/path/lib.tar.gz", ["next.tar.gz"], 0) == Ok("https://example.test/path/next.tar.gz"), "relative redirect rejected"),
    testing.expect("root redirect accepted", archive_redirect("https://example.test/path/lib.tar.gz", ["/lib.tar.gz"], 0) == Ok("https://example.test/lib.tar.gz"), "root redirect rejected"),
    testing.expect("network path redirect accepted", archive_redirect("https://example.test/lib.tar.gz", ["//cdn.test/lib.tar.gz"], 0) == Ok("https://cdn.test/lib.tar.gz"), "network redirect rejected"),
    testing.expect("absolute HTTPS redirect accepted", archive_redirect("https://example.test/lib.tar.gz", ["https://cdn.test/lib.tar.gz"], 4) == Ok("https://cdn.test/lib.tar.gz"), "fifth redirect rejected"),
    testing.equal_str("sixth redirect refused", text_failure(archive_redirect("https://example.test/lib.tar.gz", ["/lib.tar.gz"], 5)), "Cannot download the archive because the server exceeded Panack's limit of five redirects."),
    testing.equal_str("empty redirect is not missing", text_failure(archive_redirect("https://example.test/lib.tar.gz", [""], 0)), "Cannot download the archive because the server sent an empty redirect destination (Location header)."),
    testing.equal_str("missing redirect is explicit", text_failure(archive_redirect("https://example.test/lib.tar.gz", [], 0)), "Cannot download the archive because the server sent a redirect without a destination (Location header)."),
    testing.equal_str("duplicate redirects are explicit", text_failure(archive_redirect("https://example.test/lib.tar.gz", ["/one", "/two"], 0)), "Cannot download the archive because the server sent more than one redirect destination (Location header)."),
    testing.equal_str("HTTP downgrade refused", text_failure(archive_redirect("https://example.test/lib.tar.gz", ["http://example.test/lib.tar.gz"], 0)), "Cannot download the archive because the server redirected the download to an unencrypted HTTP address."),
    testing.equal_str("other schemes are not relative paths", text_failure(archive_redirect("https://example.test/lib.tar.gz", ["ftp://example.test/lib.tar.gz"], 0)), "Cannot download the archive because the redirect destination uses an unsupported URL scheme; Panack requires HTTPS."),
    testing.equal_str("truncation distinguishes incomplete response", http_problem(ProtocolError("truncated HTTP response body")).message, "Cannot finish downloading the archive because the HTTP response ended before Panack received all the required data."),
    testing.equal_str("framing distinguishes malformed response", http_problem(ProtocolError("duplicate Content-Length")).message, "Cannot finish downloading the archive because the server's HTTP response is incorrectly formatted."),
    testing.equal_str("semantic lock error does not invent a source position", problem_value(unknown_offset, "Location"), ""),
    testing.equal_str("package publication names its destination", problem_value(publication, "Destination directory"), "/app/.panack_modules/demo.library"),
    testing.equal_str("publication retains the filesystem cause", publication.message, "Cannot save the prepared package directory: the destination is not a replaceable package directory (destination_conflict)."),
    testing.equal_str("publication guidance preserves conflicting contents", publication.help, "Preserve any contents you need before moving the conflicting destination elsewhere. Then prepare the packages recorded in the lockfile by running:"),
    testing.equal_str("state publication explains packages already saved", state_save.reason, "Panack saved the package directories, but could not save the state record used to verify those directories against the lockfile."),
    testing.equal_str("state publication names its destination", problem_value(state_save, "Destination file"), "/app/.panack_modules/.state/lock.json"),
    testing.equal_str("publication selects explicit restore recovery", problem_value(publication, "Recovery operation"), "restore"),
    testing.expect("lock command accepted", validate_package_command(["deps", "lock", "--project", "/app/panack.json"]) == Ok(()), "valid lock rejected"),
    testing.expect("selected update accepted", validate_package_command(["deps", "update", "--project", "/app/panack.json", "lib"]) == Ok(()), "valid update rejected"),
    testing.expect("offline restore accepted", validate_package_command(["deps", "restore", "--project", "/app/panack.json", "--offline"]) == Ok(()), "valid restore rejected"),
    testing.expect("prepare accepted", validate_package_command(["prepare", "--project", "/app/panack.json"]) == Ok(()), "valid prepare rejected"),
    testing.equal_str("missing operation is specific", failure_message(validate_package_command(["deps"])), "Cannot run panack deps because no operation was supplied."),
    testing.equal_str("unsupported operation is specific", failure_message(validate_package_command(["deps", "frobnicate"])), "Cannot run panack deps because the operation is not supported."),
    testing.equal_str("missing project is specific", failure_message(validate_package_command(["deps", "lock"])), "Cannot run the package command because --project is required after the operation."),
    testing.equal_str("empty path is rejected", failure_message(validate_package_command(["deps", "lock", "--project", ""])), "Cannot run the package command because --project has no manifest path."),
    testing.equal_str("option is not a path", failure_message(validate_package_command(["deps", "restore", "--project", "--offline"])), "Cannot run the package command because --project has no manifest path."),
    testing.equal_str("repeated offline is specific", failure_message(validate_package_command(["deps", "restore", "--project", "/app/panack.json", "--offline", "--offline"])), "Cannot run this command because --offline was supplied more than once."),
    testing.equal_str("offline update is specific", failure_message(validate_package_command(["deps", "update", "--project", "/app/panack.json", "--offline"])), "Cannot run this command because --offline is only supported by panack deps restore."),
    testing.equal_str("unknown update option is not a dependency", failure_message(validate_package_command(["deps", "update", "--project", "/app/panack.json", "--mystery"])), "Cannot run the package command because an option is not supported."),
    testing.equal_str("permission retains filesystem classification", denied.code, "PKG_FILESYSTEM"),
    testing.equal_str("permission retains the actual path", problem_value(denied, "File"), "/app/panack.json"),
    testing.equal_str("permission does not invent a missing file", problem_value(denied, "Missing file"), ""),
    testing.equal_str("lock read size limit is explicit", bounded.message, "Cannot process panack.lock.json because the file exceeds Panack's 1 MiB (1048576 bytes) size limit."),
    testing.equal_str("lock read bound has no invented location", problem_value(bounded, "Location"), ""),
    testing.equal_str("invalid UTF-8 uses shared encoding guidance", invalid_text.help, encoding_problem("panack.json", false).help),
    testing.equal_str("invalid UTF-8 lock retains its code", invalid_text.code, "PKG_LOCK_INVALID"),
    testing.equal_str("invalid UTF-8 does not invent a text location", problem_value(invalid_text, "Location"), ""),
    testing.expect("restore failure does not claim a build failed", offline_missing.starts_with_at("panack: error[PKG_CACHE_MISSING]: Cannot restore the dependencies", 0), "wrong operation in diagnostic"),
    testing.equal_str("JSON syntax has its own explanation", syntax.message, "Cannot understand panack.json because it contains invalid JSON."),
    testing.equal_str("JSON location uses line and column", problem_value(syntax, "Location"), "line 2, column 2"),
    testing.equal_str("valid JSON with missing settings is not called invalid JSON", shape.message, "Cannot use panack.json because its package settings are invalid."),
    testing.expect("state errors do not claim changed package bytes", state.reason != checksum_problem("/cache").reason, "state was called a checksum failure"),
    testing.expect("unverifiable cache does not claim a checksum mismatch", permission.reason != checksum_problem("/cache").reason, "access failure was called a checksum mismatch"),
    testing.equal_str("HTTP 401 explains authentication", http_status_problem(401).message, "Cannot download the archive because the server requires authentication."),
    testing.equal_str("HTTP 429 explains rate limiting", http_status_problem(429).message, "Cannot download the archive because the server is limiting requests."),
    testing.equal_str("HTTP 500 explains server failure", http_status_problem(500).message, "Cannot download the archive because the server reported an error."),
    testing.equal_str("leaf cause survives", outer.message, "digest mismatch"),
    testing.equal_str("leaf code survives", outer.code, "PKG_INTEGRITY"),
    testing.equal_str("outer context first", outer.contexts[0].value, "app -> outer"),
    testing.equal_str("inner context retained", outer.contexts[1].value, "outer -> inner"),
    testing.equal_str("terminal controls escaped", diagnostic_text("a\nb\rc\td" + control), "a\\nb\\rc\\td?"),
    testing.equal_str("C1 controls escaped", diagnostic_text(byte_buffer.empty().push(194).push(155).decode_utf8()), "?"),
    testing.equal_str("Unicode preserved", diagnostic_text("café/日本語"), "café/日本語"),
    testing.expect("recovery shell quoting", rendered.ends_with(expected_tail + "\n\nRunning this command will restore the local packages without changing the lockfile.\n\nAn internet connection is needed if remote packages must be downloaded."), "unsafe shell quoting"),
    testing.equal_str("missing and corrupt are distinct", package_problem("PKG_CACHE_INVALID", "corrupt").phase, "checking saved packages"),
    testing.equal_str("integrity phase", leaf.phase, "checking package contents"),
    testing.equal_str("missing manifest phase", package_problem("PKG_MANIFEST_MISSING", "missing").phase, "finding panack.json"),
    testing.equal_str("unknown name explains lookup failure", failure_reason(validate_selective_update(before, after, ["absent"])),
      "Panack could not find this dependency name in panack.json or in the existing lockfile. Panack has not changed the lockfile."),
    testing.equal_str("unselected change explains scope refusal", failure_reason(validate_selective_update(before, after, ["chosen"])),
      "Your command did not select this dependency. Panack has stopped because the update would also change this dependency. Panack has not changed the lockfile."),
    testing.equal_str("changed project version is identified", failure_message(validate_selective_update(before,
      PackageLock("app", "2.0.0", "", "test", [chosen, other], []), ["chosen"])), "Cannot update only the selected dependencies because the project's version has changed."),
    testing.equal_str("DNS advice addresses hostname", http_problem(DnsFailure()).help,
      "Check the hostname in the dependency's archive URL. If the hostname is correct, check network connectivity and DNS configuration in the environment running Panack, then retry your command."),
    testing.equal_str("TLS advice does not guess a certificate cause", http_problem(TlsFailure()).help,
      "Check whether the archive URL is accessible over HTTPS from the same environment. If you manage the server, check its HTTPS configuration and certificate; otherwise, report the failure to the server administrator."),
    testing.equal_str("timeout describes elapsed wait", http_problem(Timeout()).reason,
      "Panack did not receive the complete archive within the time limit. Panack has stopped the download."),
    testing.equal_str("absolute archive path has a specific cause", text_failure(tar_normalize_path("/file")),
      "Cannot unpack the archive because the path is absolute."),
    testing.equal_str("parent archive path has a specific cause", text_failure(tar_normalize_path("../file")),
      "Cannot unpack the archive because the path contains a parent-directory component ('..')."),
    testing.equal_str("archive number syntax is distinct from its bound", text_failure(tar_number("x".encode_utf8(), 0, 1, 10)),
      "Cannot unpack the archive because an archive number contains invalid digits or spacing."),
    testing.equal_str("archive number bound is explicit", text_failure(tar_number("999999999".encode_utf8(), 0, 9, 10)),
      "Cannot unpack the archive because a numeric archive field exceeds Panack's supported maximum of 268435456.")
  ]
  if testing.report(results) > 0 { host.exit(1) }
}
