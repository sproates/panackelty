import stdlib/testing_files as std_testing_files
import stdlib/testing as std_testing
import stdlib/process as std_process
import stdlib/testing::{TestResult}
import stdlib/testing_files::{TestWorkspace, HostError}
import stdlib/time as std_time
import stdlib/bytes as byte_buffer
import stdlib/filesystem as std_filesystem
import stdlib/host as std_host
import stdlib/path as std_path
import stdlib/package_filesystem as std_package_filesystem

pure package_path(value: Str): Path { std_path.from_text(value)->value_or(std_path.current()) }
pure package_text(value: Path): Str { value->to_text()->value_or("invalid path") }
pure package_error[T](result: Result[T,HostError]): Str {
  match result { Ok(value) => "ok", Error(problem) => problem.code }
}

main(): Void {
  match std_testing_files.workspace_create(package_path("/tmp")) {
    Error(problem) => { eprint("package filesystem workspace failed: ${problem.code}"); std_host.exit(1) },
    Ok(workspace) => {
      root = workspace.root
      root_text = package_text(root)
      source = package_path("${root_text}/source")
      mut results: [TestResult] = []
      results = results->append(std_testing.equal_str("source setup",
        package_error(std_filesystem.write(source, "inside"->encode_utf8())), "ok"))
      match std_process.run(package_path("/bin/sh"),
          ["-c", "mkdir sub; ln -s source inside-link; ln -s ../source sub/relative-link; ln -s ../../etc/passwd sub/escaped-relative-link; ln -s /etc/passwd escaped-link"],
          byte_buffer.empty(), root, [], std_time.seconds(3), 100) {
        Error(problem) => { results = results->append(std_testing.expect("symlink setup", false, problem.code)) },
        Ok(command) => { results = results->append(std_testing.expect("symlink setup",
          command.exit_code == 0 && command.signal == 0, "symlink creation failed")) }
      }
      match std_package_filesystem.read_beneath(root, package_path("inside-link"), 100) {
        Error(problem) => { results = results->append(std_testing.expect("in-root symlink read", false, problem.code)) },
        Ok(first) => {
          results = results->append(std_testing.expect("in-root symlink read",
            first.contents == "inside"->encode_utf8(), "wrong bytes"))
          match std_package_filesystem.read_beneath(root, package_path("source"), 100) {
            Error(problem) => { results = results->append(std_testing.expect("stable root identity", false, problem.code)) },
            Ok(second) => { results = results->append(std_testing.expect("stable root identity",
              first.identity.device == second.identity.device &&
              first.identity.inode == second.identity.inode, "root identity changed")) }
          }
        }
      }
      results = results->append(std_testing.equal_str("resolve relative symlink from parent",
        package_error(std_package_filesystem.read_beneath(root, package_path("sub/relative-link"), 100)), "ok"))
      results = results->append(std_testing.equal_str("reject parent traversal",
        package_error(std_package_filesystem.read_beneath(root, package_path("../etc/passwd"), 100)), "invalid_argument"))
      results = results->append(std_testing.equal_str("reject absolute path",
        package_error(std_package_filesystem.read_beneath(root, package_path("/etc/passwd"), 100)), "invalid_argument"))
      results = results->append(std_testing.equal_str("reject escaping symlink",
        package_error(std_package_filesystem.read_beneath(root, package_path("escaped-link"), 100)), "invalid_argument"))
      results = results->append(std_testing.equal_str("reject relative symlink escape",
        package_error(std_package_filesystem.read_beneath(root, package_path("sub/escaped-relative-link"), 100)), "invalid_argument"))
      results = results->append(std_testing.equal_str("enforce byte limit",
        package_error(std_package_filesystem.read_beneath(root, package_path("source"), 5)), "output_limit"))
      results = results->append(std_testing.equal_str("trailing slash requires a directory",
        package_error(std_package_filesystem.read_beneath(root, package_path("source/"), 100)), "not_directory"))
      results = results->append(std_testing.equal_str("bound requested byte limit",
        package_error(std_package_filesystem.read_beneath(root, package_path("source"), 16777217)), "out_of_range"))
      results = results->append(std_testing.equal_str("remove in-root symlink",
        package_error(std_filesystem.remove_file(package_path("${root_text}/inside-link"))), "ok"))
      results = results->append(std_testing.equal_str("remove escaping symlink",
        package_error(std_filesystem.remove_file(package_path("${root_text}/escaped-link"))), "ok"))
      results = results->append(std_testing.equal_str("remove nested escaping symlink",
        package_error(std_filesystem.remove_file(package_path("${root_text}/sub/escaped-relative-link"))), "ok"))
      results = results->append(std_testing.equal_str("remove nested relative symlink",
        package_error(std_filesystem.remove_file(package_path("${root_text}/sub/relative-link"))), "ok"))
      results = results->append(std_testing.equal_str("remove source",
        package_error(std_filesystem.remove_file(source)), "ok"))
      results = results->append(std_testing.equal_str("remove subdirectory",
        package_error(std_filesystem.remove_directory(package_path("${root_text}/sub"))), "ok"))
      match workspace->remove_empty() {
        Error(problem) => { results = results->append(std_testing.expect("workspace cleanup", false, problem.code)) },
        Ok(removed) => {}
      }
      if std_testing.report(results) > 0 { std_host.exit(1) }
    }
  }
}
