import stdlib/testing::{test_expect, test_report}
import stdlib/option::{option_value_or}
import stdlib/result::{result_value_or}
import stdlib/time::{DurationError.ZeroDurationDivisor, duration_divide, duration_ratio}
import stdlib/time::{duration_value_nanoseconds, duration_value_ticks}
import stdlib/host::{host_exit}

record SortEntry { key: Nat, label: Str }
pure nat_less(left: Nat, right: Nat): Bool { left < right }
pure nat_greater(left: Nat, right: Nat): Bool { left > right }
pure entry_less(left: SortEntry, right: SortEntry): Bool { left.key < right.key }
pure never_less(left: Nat, right: Nat): Bool { false }
pure str_less(left: Str, right: Str): Bool { left < right }

main(): Void {
  original = [3, 1, 2, 1, 0]
  entries = [SortEntry(2, "first"), SortEntry(1, "a"), SortEntry(2, "second"),
    SortEntry(1, "b"), SortEntry(2, "third")]
  mut descending: [Nat] = []
  mut ascending: [Nat] = []
  for index in 0..257 {
    ascending = ascending.append(index)
  }
  mut remaining: Nat = 257
  while remaining > 0 {
    remaining = remaining - 1
    descending = descending.append(remaining)
  }
  results = [
    test_expect("empty sort", [].sort_by[Nat](@nat_less) == [], "expected empty"),
    test_expect("singleton sort", [7].sort_by(@nat_less) == [7], "expected singleton"),
    test_expect("duplicates and zero", original.sort_by(@nat_less) == [0, 1, 1, 2, 3], "wrong order"),
    test_expect("input unchanged", original == [3, 1, 2, 1, 0], "input mutated"),
    test_expect("descending comparator", original.sort_by(@nat_greater) == [3, 2, 1, 1, 0], "wrong order"),
    test_expect("record stability", entries.sort_by(@entry_less) ==
      [SortEntry(1, "a"), SortEntry(1, "b"), SortEntry(2, "first"),
       SortEntry(2, "second"), SortEntry(2, "third")], "equal keys reordered"),
    test_expect("all equivalent", original.sort_by(@never_less) == original, "equivalents reordered"),
    test_expect("odd sized reverse input", descending.sort_by(@nat_less) == ascending, "lost or misplaced values"),
    test_expect("already sorted", ascending.sort_by(@nat_less) == ascending, "sorted input changed"),
    test_expect("exact large naturals", [9007199254740993, 9007199254740992].sort_by(@nat_less) ==
      [9007199254740992, 9007199254740993], "lost precision"),
    test_expect("Unicode string ordering", ["🙂", "λ", "a", ""].sort_by(@str_less) == ["", "a", "λ", "🙂"], "wrong string order"),
    test_expect("empty suffix", "abc".ends_with(""), "empty suffix must match"),
    test_expect("both empty", "".ends_with(""), "empty strings must match"),
    test_expect("empty value", !"".ends_with("a"), "unexpected match"),
    test_expect("whole value", "abc".ends_with("abc"), "whole value must match"),
    test_expect("long suffix", !"ab".ends_with("cab"), "unexpected match"),
    test_expect("literal punctuation", "file.*".ends_with(".*"), "not literal"),
    test_expect("no glob expansion", !"file.txt".ends_with(".*"), "wildcard expanded"),
    test_expect("case sensitive", !"file.TXT".ends_with(".txt"), "case folded"),
    test_expect("prefix is not suffix", !"abca".ends_with("abc"), "matched prefix"),
    test_expect("Unicode boundary", "aλ🙂".ends_with("λ🙂"), "wrong code-point offset"),
    test_expect("Unicode mismatch", !"aλ🙂".ends_with("a🙂"), "unexpected match"),
    test_expect("combining code point", "é".ends_with("́"), "expected code-point match"),
    test_expect("no normalization", !"é".ends_with("é"), "unexpected normalization"),
    test_expect("Some keeps zero", option_value_or[Nat](Some(0), 99) == 0, "used fallback for Some"),
    test_expect("None uses fallback", option_value_or[Nat](None(), 99) == 99, "lost fallback"),
    test_expect("Some keeps empty text", option_value_or[Str](Some(""), "fallback") == "", "treated empty as absent"),
    test_expect("Ok keeps zero", result_value_or[Nat,Str](Ok(0), 99) == 0, "used fallback for Ok"),
    test_expect("Error uses fallback", result_value_or[Nat,Str](Error("failure"), 99) == 99, "lost error fallback"),
    test_expect("Ok keeps empty text", result_value_or[Str,Nat](Ok(""), "fallback") == "", "treated empty as failure"),
    test_expect("duration ratio exact", duration_ratio(duration_value_nanoseconds(3), duration_value_nanoseconds(2)) == Ok(3/2), "rounded ratio"),
    test_expect("duration ratio negative denominator", duration_ratio(duration_value_nanoseconds(3), duration_value_nanoseconds(-2)) == Ok(-3/2), "lost sign"),
    test_expect("duration ratio zero denominator", duration_ratio(duration_value_nanoseconds(3), duration_value_nanoseconds(0)) == Error(ZeroDurationDivisor()), "accepted zero denominator"),
    test_expect("duration ratio zero numerator", duration_ratio(duration_value_nanoseconds(0), duration_value_nanoseconds(2)) == Ok(0/1), "wrong zero ratio"),
    test_expect("duration divide natural zero", duration_divide(duration_value_nanoseconds(3), 0) == Error(ZeroDurationDivisor()), "accepted natural zero"),
    test_expect("duration divide signed zero", duration_divide(duration_value_nanoseconds(3), duration_value_ticks(duration_value_nanoseconds(0))) == Error(ZeroDurationDivisor()), "accepted signed zero")
  ]
  if test_report(results) > 0 { host_exit(1) }
}
