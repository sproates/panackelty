import stdlib/testing
import stdlib/testing_files
import stdlib/testing_commands
import stdlib/time

pure vm_nibble(character: Str): Nat {
  digits = "0123456789abcdef"
  mut result: Nat = 0
  for index in 0..16 { if digits[index] == character { result = index } }
  result
}
pure vm_hex(value: Str): Bytes {
  mut output = bytes()
  mut high: Nat = 0
  mut half = false
  for index in 0..len(value) {
    character = value[index]
    if !is_whitespace(character) {
      digit = vm_nibble(character)
      if !half { high = digit; half = true }
      else { output = byte_append(output, high * 16 + digit); half = false }
    }
  }
  output
}
pure vm_path(value: Str): Path { result_value_or(path_from_text(value), path_current()) }
pure vm_text(value: Path): Str { result_value_or(path_to_text(value), "invalid-path") }

pure vm_contains(actual: Str, expected: Str): Bool {
  mut found = false
  for offset in 0..len(actual) { if starts_with_at(actual, expected, offset) { found = true } }
  found
}
vm_environment(): [Str] {
  mut values: [Str] = []
  for key in ["ASAN_OPTIONS", "UBSAN_OPTIONS", "LLVM_PROFILE_FILE", "PANACKELTY_STDLIB_PATH"] {
    if environment_has(key) { values = values.append("${key}=" + environment_get(key)) }
  }
  values
}
vm_executable(key: Str, fallback: Str): Path {
  vm_path(if environment_has(key) { environment_get(key) } else { fallback })
}
vm_case(name: Str, mode: Str, status: Nat, target: Path): TestResult {
  prefix = "tests/fixtures/vm_contracts/${name}"
  match fs_write(target, vm_hex(read_file("${prefix}.hex"))) {
    Error(problem) => test_expect(name, false, "fixture write failed"),
    Ok(done) => {
      result = test_run_command(name, TestCommand(
        vm_executable("PANACK_NATIVE_BINARY", "./panack-vm"), [mode, vm_text(target)],
        bytes(), path_current(), vm_environment(), duration_seconds(30), 1048576),
        ProcessOutput(status, 0, read_bytes("${prefix}.stdout"), read_bytes("${prefix}.stderr")))
      match fs_remove_file(target) {
        Error(problem) => test_expect(name, false, "fixture cleanup failed"),
        Ok(removed) => result
      }
    }
  }
}
vm_fault(name: Str, file: Str, mode: Str, module: Bool, target: Path): TestResult {
  match fs_write(target, vm_hex(read_file("tests/fixtures/vm_contracts/${file}.hex"))) {
    Error(problem) => test_expect(name, false, "fixture write failed"),
    Ok(done) => {
      executable = if module { vm_executable("PANACK_NATIVE_MODULE_TEST", "./build/vm/test_modules") }
                   else { vm_executable("PANACK_NATIVE_FAULT_TEST", "./build/fault/test_faults") }
      outcome = process_run(executable, [mode, vm_text(target)], bytes(), path_current(),
                            vm_environment(), duration_seconds(30), 16777216)
      mut valid = false
      match outcome {
        Error(problem) => {},
        Ok(command) => {
          marker = if module { "decoder corpus:" } else { "allocation failures checked" }
          valid = command.exit_code == 0 && command.signal == 0 && vm_contains(utf8_decode(command.stdout), marker)
        }
      }
      if mode == "execute" || mode == "trap" {
        match process_run(vm_executable("PANACK_NATIVE_BINARY", "./panack-vm"), ["run", "bootstrap/compiler-v8.bc", "disasm", vm_text(target)],
          bytes(), path_current(), vm_environment(), duration_seconds(30), 1048576) {
          Error(problem) => { valid = false },
          Ok(listing) => {
            valid = valid && listing.exit_code == 0 && listing.signal == 0 && listing.stderr == bytes()
            for opcode in ["INTERPOLATE", "UNARY", "CALL_VALUE", "ITER_NEXT", "MAKE_RECORD", "MAKE_VARIANT"] {
              valid = valid && vm_contains(utf8_decode(listing.stdout), opcode)
            }
          }
        }
      }
      match fs_remove_file(target) {
        Error(problem) => test_expect(name, false, "fixture cleanup failed"),
        Ok(removed) => test_expect(name, valid, "native fault/mutation contract failed")
      }
    }
  }
}
