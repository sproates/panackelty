      results = results.append(vm_case("NativeExecutionTests-native_vm_rechecks_indirect_call_purity-1", "run", 1, target))
      results = results.append(vm_fault("all operand decode failures", "fault_operands", "decode", false, target))
      results = results.append(vm_fault("all operand mutations", "fault_operands", "mutate", true, target))
      results = results.append(vm_fault("ownership allocation failures", "ownership_execute", "execute", false, target))
      results = results.append(vm_fault("nested trap allocation failures", "ownership_trap", "trap", false, target))
      match test_workspace_remove_empty(workspace) {
        Error(problem) => { results = results.append(test_expect("VM workspace cleanup", false, "directory not empty")) },
        Ok(removed) => {}
      }
      if test_report(results) > 0 { process_exit(1) }
    }
  }
}
