      results = results.append(vm_fault("all operand mutations", "fault_operands", "mutate", true, target))
      results = results.append(vm_fault("ownership allocation failures", "ownership_execute", "execute", false, target))
      results = results.append(vm_fault("nested trap allocation failures", "ownership_trap", "trap", false, target))
