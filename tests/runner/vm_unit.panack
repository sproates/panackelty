      results = results.append(vm_case("ExecutionTests-arrays_iteration_indexing_and_len-1", "tasks", 0, target))
      match std_testing_files.workspace_remove_empty(workspace) {
        Error(problem) => { results = results.append(std_testing.expect("VM workspace cleanup", false, "directory not empty")) },
        Ok(removed) => {}
      }
      if std_testing.report(results) > 0 { std_host.exit(1) }
