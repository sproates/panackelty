import stdlib/testing_commands as std_testing_commands
import stdlib/text as std_text
import stdlib/option as std_option
import stdlib/testing as std_testing
import stdlib/process as std_process
import project/src/compiler/filesystem_support as filesystem_support
import stdlib/result as std_result
import stdlib/testing::{TestResult}
import stdlib/testing_files as std_testing_files
import stdlib/testing_commands::{TestCommand, ProcessOutput}
import stdlib/time as std_time
import stdlib/bytes as byte_buffer
import stdlib/environment as std_environment
import stdlib/filesystem as std_filesystem
import stdlib/host as std_host
import stdlib/path as std_path
pure vm_nibble(character: Str): Nat {
  digits = "0123456789abcdef"
  mut result: Nat = 0
  for index in 0..16 { if digits[index] == character { result = index } }
  result
}
pure vm_hex(value: Str): Bytes {
  mut output = byte_buffer.empty()
  mut high: Nat = 0
  mut half = false
  for index in 0..len(value) {
    character = value[index]
    if !is_whitespace(character) {
      digit = vm_nibble(character)
      if !half { high = digit; half = true }
      else { output = byte_buffer.push(output, high * 16 + digit); half = false }
    }
  }
  output
}
pure vm_path(value: Str): Path { std_result.value_or(std_path.from_text(value), std_path.current()) }
pure vm_text(value: Path): Str { std_result.value_or(std_path.to_text(value), "invalid-path") }

pure vm_contains(actual: Str, expected: Str): Bool {
  mut found = false
  for offset in 0..len(actual) { if starts_with_at(actual, expected, offset) { found = true } }
  found
}
vm_environment(): [Str] {
  mut values: [Str] = []
  for key in ["ASAN_OPTIONS", "UBSAN_OPTIONS", "LLVM_PROFILE_FILE", "PANACKELTY_STDLIB_PATH"] {
    if (std_environment.get(key) != None()) { values = values.append("${key}=" + std_option.value_or(std_environment.get(key), "")) }
  }
  values
}
vm_executable(key: Str, fallback: Str): Path {
  vm_path(if (std_environment.get(key) != None()) { std_option.value_or(std_environment.get(key), "") } else { fallback })
}
vm_case(name: Str, mode: Str, status: Nat, target: Path): TestResult {
  prefix = "tests/fixtures/vm_contracts/${name}"
  match std_filesystem.write(target, vm_hex(filesystem_support.read_text("${prefix}.hex"))) {
    Error(problem) => std_testing.expect(name, false, "fixture write failed"),
    Ok(done) => {
      result = std_testing_commands.run_command(if mode == "return-void" { "${name}/return kind" } else { name }, TestCommand(
        if mode == "return-void" || mode == "tasks" { vm_executable("PANACK_NATIVE_MODULE_TEST", "./build/vm/test_modules") }
        else { vm_executable("PANACK_NATIVE_BINARY", "./panack-vm") }, [mode, vm_text(target)],
        byte_buffer.empty(), std_path.current(), vm_environment(), std_time.seconds(30), 1048576),
        ProcessOutput(status, 0, filesystem_support.read_file_bytes("${prefix}.stdout"), filesystem_support.read_file_bytes("${prefix}.stderr")))
      match std_filesystem.remove_file(target) {
        Error(problem) => std_testing.expect(name, false, "fixture cleanup failed"),
        Ok(removed) => result
      }
    }
  }
}
vm_fault(name: Str, file: Str, mode: Str, module: Bool, target: Path): TestResult {
  match std_filesystem.write(target, vm_hex(filesystem_support.read_text("tests/fixtures/vm_contracts/${file}.hex"))) {
    Error(problem) => std_testing.expect(name, false, "fixture write failed"),
    Ok(done) => {
      executable = if module { vm_executable("PANACK_NATIVE_MODULE_TEST", "./build/vm/test_modules") }
                   else { vm_executable("PANACK_NATIVE_FAULT_TEST", "./build/fault/test_faults") }
      outcome = std_process.run(executable, [mode, vm_text(target)], byte_buffer.empty(), std_path.current(),
                            vm_environment(), std_time.seconds(30), 16777216)
      mut valid = false
      match outcome {
        Error(problem) => {},
        Ok(command) => {
          marker = if module { "decoder corpus:" } else { "allocation failures checked" }
          valid = command.exit_code == 0 && command.signal == 0 && vm_contains(utf8_decode(command.stdout), marker)
        }
      }
      if mode == "execute" || mode == "trap" {
        match std_process.run(vm_executable("PANACK_NATIVE_BINARY", "./panack-vm"), ["run", "bootstrap/compiler-v9.bc", "disasm", vm_text(target)],
          byte_buffer.empty(), std_path.current(), vm_environment(), std_time.seconds(30), 1048576) {
          Error(problem) => { valid = false },
          Ok(listing) => {
            valid = valid && listing.exit_code == 0 && listing.signal == 0 && listing.stderr == byte_buffer.empty()
            for opcode in ["INTERPOLATE", "UNARY", "CALL_VALUE", "ITER_NEXT", "MAKE_RECORD", "MAKE_VARIANT"] {
              valid = valid && vm_contains(utf8_decode(listing.stdout), opcode)
            }
          }
        }
      }
      match std_filesystem.remove_file(target) {
        Error(problem) => std_testing.expect(name, false, "fixture cleanup failed"),
        Ok(removed) => std_testing.expect(name, valid, "native fault/mutation contract failed")
      }
    }
  }
}
main(): Void {
  match std_testing_files.workspace_create(vm_path("/tmp")) {
    Error(problem) => { eprint("VM workspace creation failed"); std_host.exit(1) },
    Ok(workspace) => {
      mut results: [TestResult] = []
      target = std_result.value_or(std_path.join(workspace.root, vm_path("input.bc")), workspace.root)
      progress = std_result.value_or(std_path.join(workspace.root, vm_path("native-module-progress.txt")), workspace.root)
      progress_text = vm_text(progress)
      module_outcome = std_process.run(
        vm_executable("PANACK_NATIVE_MODULE_TEST", "./build/vm/test_modules"), [], byte_buffer.empty(),
        std_path.current(), vm_environment().append("PANACK_NATIVE_MODULE_PROGRESS_FILE=${progress_text}"),
        std_time.seconds(20), 1048576)
      mut module_succeeded = false
      module_result = match module_outcome {
        Error(problem) => {
          code = problem.code
          stage = match std_filesystem.read(progress, 4096) {
            Ok(contents) => {
              text = std_text.decode_utf8(contents)
              if text == "" { "none recorded" } else { text }
            },
            Error(read_error) => "none recorded"
          }
          std_testing.expect("native module contracts", false,
            "command failed: ${code}; last completed group: ${stage}")
        },
        Ok(output) => {
          module_succeeded = true
          std_testing_commands.command_output("native module contracts", output,
            ProcessOutput(0, 0, utf8_encode("native module contracts: ok\n"), byte_buffer.empty()))
        }
      }
      results = results.append(module_result)
      if module_succeeded {
        stage = match std_filesystem.read(progress, 4096) {
          Ok(contents) => std_text.decode_utf8(contents),
          Error(read_error) => "none recorded"
        }
        results = results.append(std_testing.expect("native module progress checkpoint",
          stage == "builtin_domains\n", "final completed-group marker was missing"))
      }
      match std_filesystem.remove_file(progress) {
        Error(problem) => if problem.code != "not_found" {
          code = problem.code
          results = results.append(std_testing.expect("native module progress cleanup", false,
            "cleanup failed: ${code}"))
        },
        Ok(removed) => {}
      }
      results = results.append(std_testing_commands.run_command("bigint exceeds host word size", TestCommand(
        vm_executable("PANACK_NATIVE_BIGINT_TEST", "./build/vm/test_bigint"), [], byte_buffer.empty(),
        std_path.current(), vm_environment(), std_time.seconds(20), 1048576),
        ProcessOutput(0, 0, utf8_encode("8999999999999999999999999999991\n999999999999999999999999999999\n1\n"), byte_buffer.empty())))
      results = results.append(std_testing_commands.run_command("decimal division preserves significant zeros", TestCommand(
        vm_executable("PANACK_NATIVE_MODULE_TEST", "./build/vm/test_modules"), ["arithmetic"],
        utf8_encode("decimal 3 100000000000000000000 -2 80 -1\ndecimal 3 0 -20 80 -1\ndecimal 3 -1000 -3 20 -1\ndecimal 3 1000 -3 80 -1\ndecimal 2 100 -2 200 -2\n"),
        std_path.current(), vm_environment(), std_time.seconds(10), 1048576),
        ProcessOutput(0, 0, utf8_encode("125000000000000000\n0\n-0.5\n0.125\n2.0000\n"), byte_buffer.empty())))
      match std_process.run(vm_executable("PANACK_NATIVE_FAULT_TEST", "./build/fault/test_faults"), [],
        byte_buffer.empty(), std_path.current(), vm_environment(), std_time.seconds(30), 16777216) {
        Error(problem) => { results = results.append(std_testing.expect("allocation and host failures", false, "command failed")) },
        Ok(command) => { results = results.append(std_testing.expect("allocation and host failures",
          command.exit_code == 0 && command.signal == 0 && vm_contains(utf8_decode(command.stdout), "allocation failures checked"),
          "native fault contract failed")) }
      }
      results = results.append(vm_case("ExecutionTests-array_index_is_bounds_checked_by_vm-1", "run", 1, target))
      results = results.append(vm_case("ExecutionTests-arrays_iteration_indexing_and_len-1", "run", 0, target))
