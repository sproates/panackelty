import project/src/compiler/path_support as path_support
import project/src/compiler/filesystem_support as filesystem_support
import stdlib/environment as std_environment
import stdlib/host as std_host
import project/src/compiler/coverage::{coverage_mapped_project, CoverageEdge, coverage_edge, coverage_probe_key, coverage_source_function_name, EmissionProbe, Instruction, Instruction.ReturnInstruction, Instruction.ConstInstruction, Instruction.LoadInstruction, Instruction.StoreInstruction, Instruction.PopInstruction, Instruction.UnaryInstruction, Instruction.BinaryInstruction, Instruction.MakeRangeInstruction, Instruction.MakeArrayInstruction, Instruction.IndexGetInstruction, Instruction.InterpolateInstruction, Instruction.IterInitInstruction, Instruction.IterNextInstruction, Instruction.MakeRecordInstruction, Instruction.FieldGetInstruction, Instruction.MakeVariantInstruction, Instruction.MatchVariantInstruction, Instruction.MatchFailInstruction, Instruction.CallInstruction, Instruction.CallValueInstruction, Instruction.AwaitCallInstruction, Instruction.AwaitValueInstruction, Instruction.JumpFalseInstruction, Instruction.JumpInstruction, Instruction.PendingEndJumpInstruction, LoadedProject}
import project/src/compiler/loader::{load_project_for_inventory, loaded_binding_graph}
import project/src/compiler/module_bindings::{DeclarationIdentity, source_module_identity}
import project/src/compiler/module_emission::{module_emission_symbol}
import project/src/compiler/module_resolution::{resolve_module_path, ResolvedModuleTarget.DeclarationTarget, ResolvedModuleTarget.NamespaceTarget}
import project/src/compiler/emitter::{SourceMappedProgram}
import project/src/compiler/source_inventory::{inventory_module, serialize_source_inventory}
import project/src/compiler/source_maps::{source_map_blob, source_map_join, source_map_position, source_map_write, source_snapshots, source_snapshots_unchanged}
import project/src/bytecode/codec::{encode_text, encode_u8, encode_u32, serialize_bytecode, sort_functions}

pure plan_parent_id(id: Str): Str {
  mut end: Nat = 0
  for index in 0..id->len() { if id->slice(index, index + 1) == "/" { end = index; } }
  id->slice(0, end)
}

pure plan_returns(instruction: Instruction): Nat {
  match instruction {
    ReturnInstruction() => 1,
    ConstInstruction(a0) => 0, LoadInstruction(a0) => 0,
    StoreInstruction(a0) => 0, PopInstruction() => 0,
    UnaryInstruction(a0) => 0, BinaryInstruction(a0) => 0,
    MakeRangeInstruction() => 0, MakeArrayInstruction(a0) => 0,
    IndexGetInstruction() => 0, InterpolateInstruction(a0) => 0,
    IterInitInstruction(a0) => 0, IterNextInstruction(a0,a1,a2) => 0,
    MakeRecordInstruction(a0,a1) => 0, FieldGetInstruction(a0) => 0,
    MakeVariantInstruction(a0,a1,a2) => 0,
    MatchVariantInstruction(a0,a1) => 0, MatchFailInstruction() => 0,
    CallInstruction(a0,a1) => 0, CallValueInstruction(a0) => 0,
    AwaitCallInstruction(a0,a1) => 0, AwaitValueInstruction(a0) => 0,
    JumpFalseInstruction(a0) => 0, JumpInstruction(a0) => 0,
    PendingEndJumpInstruction() => 0
  }
}

// Local compiler-produced plan. Consumers bind it to these exact artifact,
// inventory, compiler and source bytes; no downloaded plan drives compilation.
main(): Void {
  args = std_host.arguments()
  entry = path_support.resolve(args[0])
  source_root = path_support.parent(entry)
  project_root = path_support.resolve(std_environment.get("PANACKELTY_BOOTSTRAP_ROOT")->value_or(""))
  stdlib = path_support.resolve(std_environment.get("PANACKELTY_STDLIB_PATH")->value_or(""))
  compiler = filesystem_support.read_file_bytes(std_environment.get("PANACKELTY_COMPILER_PATH")->value_or(""))
  project = load_project_for_inventory(entry)
  match coverage_mapped_project(project, entry, project_root, stdlib) {
    Error(diagnostics) => {
      for diagnostic in diagnostics { eprint(diagnostic.message); }
      eprint("coverage plan: checked namespace failed")
      std_host.exit(1)
    },
    Ok(mapped) => coverage_plan(project, mapped, entry, project_root, source_root, stdlib, compiler, args)
  }
}

coverage_plan(
  project: LoadedProject,
  mapped: SourceMappedProgram,
  entry: Str,
  project_root: Str,
  source_root: Str,
  stdlib: Str,
  compiler: Bytes,
  args: [Str]
): Void {
  artifact = serialize_bytecode(mapped.bytecode)
  inner = serialize_source_inventory(project, artifact, compiler, entry, source_root, stdlib)
  inventory = source_map_join(["PANACKINVENTORY1\n"->encode_utf8(), encode_u32(1), source_map_blob(inner)], 0, 3)
  codes = sort_functions(mapped.bytecode.functions)
  mut indices: Map[Str,Nat] = map()
  mut probes: Map[Str,Map[Str,[EmissionProbe]]] = map()
  mut chunks: [Bytes] = ["PANACKPLAN1\n"->encode_utf8(), source_map_blob(compiler), source_map_blob(artifact), source_map_blob(inventory), encode_u32(codes->len())]
  for i in 0..codes->len() {
    code = codes[i]
    indices = indices->put(code.name, i)
    chunks = chunks->append(encode_text(code.name))->append(encode_u32(code.instructions->len()))
    for pc in 0..code.instructions->len() {
      edge: CoverageEdge = coverage_edge(code.instructions[pc], pc)
      chunks = chunks->append(source_map_join([
        encode_u8(if edge.conditional { 1 } else { 0 }),
        encode_u32(edge.target), encode_u8(if edge.falls { 1 } else { 0 }),
        encode_u8(plan_returns(code.instructions[pc]))
      ], 0, 4))
    }
  }
  for mapping in mapped.probes {
    mut index: Map[Str,[EmissionProbe]] = if probes->has(mapping.name) { probes->get(mapping.name) } else { map() }
    for probe in mapping.entries {
      key: Str = coverage_probe_key(probe.kind, probe.span)
      prior: [EmissionProbe] = if index->has(key) { index->get(key) } else { [] }
      index = index->put(key, prior->append(probe))
    }
    probes = probes->put(mapping.name, index)
  }
  snapshots = source_snapshots(project, source_root, stdlib)
  graph = loaded_binding_graph(project.modules, project_root, stdlib)
  entry_identity = source_module_identity(entry, project_root, stdlib)
  chunks = chunks->append(encode_u32(snapshots->len()))
  header = source_map_join(chunks, 0, chunks->len())
  if !source_map_write(args[1] + ".plan", header) {
    size = header->length()
    eprint("coverage plan: header output failure (${size} bytes)")
    std_host.exit(1)
  }
  mut source_number: Nat = 0
  for snapshot in snapshots {
    for module in project.modules {
      if module.source_path == snapshot.path {
        items = inventory_module(module)
        mut decisions: Map[Str,Str] = map()
        for item in items { if item.kind == "decision" { decisions = decisions->put(item.id, item.detail); } }
        chunks = [encode_text(snapshot.name), encode_text(snapshot.text), encode_u32(items->len())]
        mut name: Str = ""
        mut declaration: Nat = 0
        for item in items {
          if item.kind == "function" || item.kind == "excluded" {
            while declaration < module.parsed.program.declarations->len() && item.id != "declaration/${declaration}" { declaration = declaration + 1; }
            if declaration < module.execution_program.declarations->len() {
              name = coverage_source_function_name(graph, entry_identity, module.bindings.identity,
                module.execution_program.declarations[declaration])
            }
          }
          mut function: Nat = if indices->has(name) && item.kind != "excluded" { indices->get(name) + 1 } else { 0 }
          mut start: Nat = 0
          mut end: Nat = 0
          mut mode: Nat = 0
          if function > 0 && item.kind != "function" {
            parent = plan_parent_id(item.id)
            kind = if item.kind == "expression" || item.kind == "statement" { "expression" }
              else { if item.kind == "decision" { if item.detail == "match" { "expression" } else { item.detail } }
              else { if decisions->has(parent) && item.id == parent + "/" + item.detail { decisions->get(parent) } else { "arm:" + item.detail } } }
            mut probe_kind: Str = kind
            if item.kind == "outcome" && kind->len() > 4 && kind->slice(0, 4) == "arm:" {
              variant: DeclarationIdentity = match resolve_module_path(graph, module.bindings.identity, item.detail) {
                Error(message) => DeclarationIdentity(module.bindings.identity, item.detail),
                Ok(target) => match target {
                  DeclarationTarget(binding) => binding.identity,
                  NamespaceTarget(identity) => DeclarationIdentity(module.bindings.identity, item.detail)
                }
              }
              emitted_variant: Str = module_emission_symbol(graph, entry_identity,
                variant)
              emitted_key: Str = coverage_probe_key("arm:" + emitted_variant, item.span)
              if probes->has(name) && probes->get(name)->has(emitted_key) {
                probe_kind = "arm:" + emitted_variant
              }
            }
            key = coverage_probe_key(probe_kind, item.span)
            if probes->has(name) && probes->get(name)->has(key) && probes->get(name)->get(key)->len() == 1 {
              probe = probes->get(name)->get(key)[0]
              start = probe.start
              end = probe.end
              mode = if kind == "expression" { 1 } else { 4 }
              if item.kind == "outcome" {
                branch = item.detail == "false" || item.detail == "exit" || (kind == "&&" && item.detail == "skip-right") || (kind == "||" && item.detail == "evaluate-right")
                mode = if branch { 3 } else { 2 }
              }
            } else { mode = 5; }
          }
          chunks = chunks->append(source_map_join([encode_text(item.id), encode_text(item.kind), encode_text(item.detail), source_map_position(item.span.start), source_map_position(item.span.end), encode_u32(function), encode_u32(start), encode_u32(end), encode_u8(mode)], 0, 9))
        }
        if !source_map_write(args[1] + ".source-${source_number}.plan", source_map_join(chunks, 0, chunks->len())) { eprint("coverage plan: source output failure"); std_host.exit(1); }
        source_number = source_number + 1
      }
    }
  }
  if !source_snapshots_unchanged(project) || inner->length() == 0 { eprint("coverage plan: source changed"); std_host.exit(1); }
  if source_number != snapshots->len() || !source_map_write(args[1] + ".bc", artifact) || !source_map_write(args[1] + ".inv", inventory) { eprint("coverage plan: output failure"); std_host.exit(1); }
  print("plan: wrote")
}
