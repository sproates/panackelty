import project/src/compiler/module_bodies::{BodyCheckStatus.BodyDeferred, BodyCheckStatus.BodyInvalid, BoundBody, BoundFunctionBody, body_type_text, body_type_complete,
  body_call_argument_evidence, body_binding_type_evidence, body_assignment_type_evidence, body_type_join_evidence,
  body_collection_callback_evidence, body_operator_type_evidence, body_type_check_evidence}
import project/src/compiler/module_signatures::{SignatureType}
import project/src/compiler/explanations::{body_guard_conversions, body_inferred_locals, inferred_local_type}
import project/src/compiler/emitter::{SourceMappedProgram, compile_program_with_sources, render_instruction, instruction_purpose}
import project/src/compiler/source_maps::{SourceMapFunctionSelector, source_identifier}
import project/src/compiler/loader::{LoadedProject}
import project/src/compiler/checker::{SubtractionEvidence}
import project/src/compiler/types::{SourceSpan}
import project/src/compiler/loader::{load_project_explained}
import project/src/compiler/project_frontend::{prepare_project_program}
import project/src/compiler/explanations::{explanation_function_selector}
import project/src/compiler/module_bindings::{source_module_identity}
import project/src/compiler/source_maps::{source_map_escape}
import project/src/compiler/path_support as paths
import stdlib/environment as env
import stdlib/host as host

record Origin { label: Str, source: Str }
record Decision { site: SourceSpan, label: Str, verdict: Str, why: Str, origins: [Origin] }
record Section { statement: Str, decisions: [Decision] }
record Review { source: Str, name: Str, signature: Str, status: Str, sections: [Section] }

pure previous(n: Nat): Nat { if n > 0 { n - 1 } else { 0 } }
pure remaining_space(size: Nat, used: Nat): Nat {
  signed_size: Int = size
  if size > used { ((signed_size - used) / 1).nat() } else { 0 }
}
pure source_text(source: Str): Str {
  mut output = ""
  mut start: Nat = 0
  for i in 0..source.len() {
    if source[i] == "\n" {
      output = output + source_map_escape(source.slice(start,i)) + "\n"
      start = i + 1
    }
  }
  output + source_map_escape(source.slice(start,source.len()))
}
pure excerpt(source: Str, span: SourceSpan): Str {
  source_text(source.slice(span.start.offset, span.end.offset))
}

// Show the original source around the selected span. Indentation belongs to
// the program. Never use a line number as the navigation key.
pure context(source: Str, span: SourceSpan): Str {
  mut start = span.start.offset
  mut end = span.end.offset
  while start > 0 && source[previous(start)] != "\n" { start = previous(start) }
  while end < source.len() && source[end] != "\n" { end = end + 1 }
  source_map_escape(source.slice(start, span.start.offset)) + excerpt(source, span) +
    source_map_escape(source.slice(span.end.offset, end))
}

// Use child spans from the checked expression. Splitting displayed text at
// the minus sign would misidentify operands in a nested subtraction.
pure operand_name(body: BoundBody, span: SourceSpan, source: Str): Option[Str] {
  mut name: Option[Str] = None()
  if body.span == span && body.children.len() == 2 {
    name = Some(excerpt(source, body.children[0].span))
  } else {
    for child in body.children {
      if name == None() && child.span.start.offset <= span.start.offset && child.span.end.offset >= span.end.offset {
        name = operand_name(child, span, source)
      }
    }
  }
  name
}

pure subtraction(source: Str, span: SourceSpan, item: SubtractionEvidence, left: Str): Decision {
  proof = item.decision
  code = excerpt(source, span)
  mut verdict = if proof.proven { "Proved" } else { "Unproved" }
  mut why = ""
  if proof.rule == "unsupported" || proof.rule == "invalid-operands" {
    verdict = "Unavailable"
    why = if proof.rule == "unsupported" { "This operation has no Nat subtraction obligation." }
      else { "Operand checking failed before Panack could establish a subtraction proof." }
  } else {
    if item.left.has_nat {
      n = item.left.nat_value
      why = left + " has the value ${n} here. "
    } else if proof.has_lower {
      n = proof.lower
      why = "Panack knows " + left + " is at least ${n} here. "
    }
    if item.right.has_nat {
      amount = item.right.nat_value
      why = why + if proof.proven { "Subtracting ${amount} therefore leaves zero or more." }
        else { "Subtracting ${amount} safely requires " + left + " to be at least ${amount}. Panack cannot prove that here." }
    } else {
      why = why + if proof.proven { "Panack proved the result cannot be negative." }
        else { "Panack cannot prove the result stays at or above zero." }
    }
  }
  mut condition = ""
  mut branch = ""
  mut origin = ""
  match proof.guard {
    None() => {},
    Some(guard) => match guard.span {
      None() => {},
      Some(site) => if site.start.file == span.start.file && site.end.offset <= source.len() {
        condition = excerpt(source, site)
        branch = if guard.truth { "true" } else { "false" }
        origin = context(source, site)
      }
    }
  }
  mut origins: [Origin] = []
  if condition != "" { origins = origins.append(Origin(condition + " must be " + branch + " in this branch.", origin)) }
  match proof.invalidated_at {
    None() => {}, Some(site) => if site.start.file == span.start.file {
      why = why + " A reassignment invalidated the earlier bound."
      origins = origins.append(Origin("Reassignment that invalidated the bound", context(source,site)))
    }
  }
  Decision(span, code + (if proof.proven { " => Nat" } else { "" }), verdict, why, origins)
}

pure describe(t: Option[SignatureType]): Str {
  match t { None() => "unknown", Some(value) => source_map_escape(body_type_text(value)) }
}
pure outcome(check: Option[Bool]): Str {
  match check { None() => "Undetermined", Some(valid) => if valid { "Accepted" } else { "Rejected" } }
}
pure requirement(span: SourceSpan, label: Str, actual: Option[SignatureType], expected: Str, accepted: Option[Bool]): Decision {
  why = if actual == None() { "Required: " + expected + "." }
    else { "The expression has type " + describe(actual) + ". Required: " + expected + "." }
  Decision(span, source_map_escape(label), outcome(accepted), why, [])
}
pure origin(project: LoadedProject, span: SourceSpan, label: Str): [Origin] {
  if project.sources.has(span.start.file) {
    [Origin(label, source_map_escape(span.start.file) + "\n" + context(project.sources.get(span.start.file),span))]
  } else { [] }
}
pure facts(project: LoadedProject, function: BoundFunctionBody, selected: SourceMapFunctionSelector,
  source: Str): [Decision] {
  body = function.body
  mut rows: [Decision] = []
  for item in project.evidence {
    if item.function_name == selected.emitted_name || item.function_name == selected.identity.name {
      match item.span {
        None() => {}, Some(span) => if span.start.file == selected.source_path {
          rows = rows.append(subtraction(source,span,item,operand_name(body,span,source).value_or("the left operand")))
        }
      }
    }
  }
  match function.return_type_evidence {
    None() => {}, Some(e) => { rows = rows.append(requirement(e.span,"Function result",e.actual,describe(Some(e.expected)),e.accepted)) }
  }
  for e in body_guard_conversions(body) {
    mut links: [Origin] = []
    mut why = "To use " + source_map_escape(e.source_type) + " as " + source_map_escape(e.target_type) + ", Panack must establish " + source_map_escape(e.target_guard) + "."
    match e.source_guard { None() => {}, Some(guard) => { why = why + " The source type guarantees " + source_map_escape(guard) + "." } }
    match e.bounds {
      None() => { why = why + " No applicable numeric bounds were retained." },
      Some(bounds) => {
        if bounds.has_lower { n = bounds.lower; why = why + " Lower bound: ${n}." }
        if bounds.has_upper { n = bounds.upper; why = why + " Upper bound: ${n}." }
        for reason in [bounds.lower_origin,bounds.upper_origin] {
          match reason { None() => {}, Some(guard) => match guard.span {
            None() => {}, Some(site) => { links = links.concat(origin(project,site,
              if guard.truth { "Condition is true here" } else { "Condition is false here" })) }
          } }
        }
        match bounds.invalidated_at { None() => {}, Some(site) => { links = links.concat(origin(project,site,"Earlier bound invalidated here")) } }
      }
    }
    rows = rows.append(Decision(e.span,"Convert to " + source_map_escape(e.target_type),outcome(e.proven),why,links))
  }
  for local in body_inferred_locals(body) {
    t = inferred_local_type(local)
    rows = rows.append(Decision(local.span, "Infer local type", if t == None() { "Undetermined" } else { describe(t) },
      "Panack uses the type of the initializer: " + describe(t) + ".", []))
  }
  for e in body_call_argument_evidence(body) { rows = rows.append(requirement(e.span,e.label,e.actual,describe(Some(e.expected)),e.accepted)) }
  for e in body_binding_type_evidence(body) { rows = rows.append(requirement(e.span,e.label,e.actual,describe(Some(e.expected)),e.accepted)) }
  for e in body_assignment_type_evidence(body) { rows = rows.append(requirement(e.span,e.label,e.actual,describe(e.expected),e.accepted)) }
  for e in body_type_join_evidence(body) {
    rows = rows.append(Decision(e.span,source_map_escape(e.context),outcome(e.accepted),
      (if e.context.starts_with("first constraint for ") { "This argument supplies the first type constraint, " + describe(e.right) + ". Result: " + describe(e.result) + "." }
      else { "Panack combines the earlier type " + describe(e.left) + " with " + describe(e.right) + ". Result: " + describe(e.result) + "." }),
      match e.dependency { None() => [], Some(site) => origin(project,site,"Earlier generic argument") }))
  }
  for e in body_collection_callback_evidence(body) {
    mut inputs: [Str] = []
    for t in e.expected_parameters { inputs = inputs.append(describe(Some(t))) }
    mut signature = ""
    for t in inputs { signature = signature + (if signature == "" { "" } else { ", " }) + t }
    rows = rows.append(Decision(e.span,e.operation + " callback",outcome(e.accepted),
      "The collection requires a pure function taking (" + signature + "). The supplied callback is " + describe(e.callback) +
      ". Expected result: " + (if e.expected_result == None() { "any non-Void value" } else { describe(e.expected_result) }) + ".",[]))
  }
  for e in body_operator_type_evidence(body) {
    rows = rows.append(Decision(e.span,"Operator " + e.operator,outcome(e.accepted),
      "Operand types: " + describe(e.left) + (if e.unary { "" } else { " and " + describe(e.right) }) + ". Result: " + describe(e.result) + ".",[]))
  }
  for e in body_type_check_evidence(body) {
    base = requirement(e.span,e.context,e.actual,source_map_escape(e.expected),e.accepted)
    links = match e.dependency { None() => [], Some(site) => origin(project,site,"Earlier constraint") }
    rows = rows.append(Decision(e.span,base.label,base.verdict,base.why + (if e.reason == "" { "" } else { " " + source_map_escape(e.reason) }),links))
  }
  for e in project.effects {
    if e.function_name == selected.identity.name || e.function_name == selected.emitted_name {
      match e.span { None() => {}, Some(span) => if span.start.file == selected.source_path {
        mut why = "The enclosing function is " + e.mode + "."
        if e.kind == "call" { why = why + " The callee " + source_map_escape(e.target) + " is " + e.target_effect + " (" + e.basis + ")." }
        for error in e.violations { why = why + " " + source_map_escape(error) + "." }
        mut links: [Origin] = []
        for edge in e.dependencies { links = links.concat(origin(project,edge.span,"Local resource call: " + source_map_escape(edge.target))) }
        rows = rows.append(Decision(span,e.kind + " permission",if e.violations.len() > 0 { "Rejected" }
          else if e.target_effect == "unavailable" { "Undetermined" } else { "Allowed" },why,links))
      } }
    }
  }
  rows
}

pure ordered(left: Decision, right: Decision): Bool { left.site.start.offset < right.site.start.offset }
pure sections(source: Str, entries: [Decision]): [Section] {
  mut groups: [Section] = []
  mut current: [Decision] = []
  mut last: Nat = 0
  mut text = ""
  for item in entries.sort_by(@ordered) {
    if item.site.start.line != last {
      if current.len() > 0 { groups = groups.append(Section(text,current)) }
      current = []
      // The overview is one original line, including the enclosing statement.
      mut start = item.site.start.offset
      while start > 0 && source[previous(start)] != "\n" { start = previous(start) }
      mut end = start
      while end < source.len() && source[end] != "\n" { end = end + 1 }
      text = source_map_escape(source.slice(start,end))
      last = item.site.start.line
    }
    current = current.append(item)
  }
  if current.len() > 0 { groups = groups.append(Section(text,current)) }
  groups
}
load(source_path: Str, selector: Str): Result[Review,Str] {
  entry = paths.resolve(source_path)
  root = env.get("PANACKELTY_BOOTSTRAP_ROOT").value_or(paths.parent(entry))
  library = env.get("PANACKELTY_STDLIB_PATH").value_or("")
  project = load_project_explained(entry)
  mut identity = source_module_identity(entry, root, library)
  for module in project.modules {
    if module.source_path == entry { identity = module.bindings.identity }
  }
  prepared = prepare_project_program(project,root,library,identity)
  mut status = match prepared {
    Ok(program) => "Project compiles",
    Error(errors) => if errors.len() > 0 { "Compilation failed: " + source_map_escape(errors[0].message) }
      else { "Compilation failed" }
  }
  match explanation_function_selector(project, selector, entry, root, library) {
    Error(message) => Error(status + "\n" + source_map_escape(message)),
    Ok(selected) => {
      mut rows: [Decision] = []
      mut signature = ""
      if project.sources.has(selected.source_path) {
        source = project.sources.get(selected.source_path)
        for function in project.module_bodies {
          if function.signature.binding.identity == selected.identity {
            if function.status == BodyDeferred() {
              status = status + "\nThis function has unresolved checks. Only decisions reached by the checker are available."
            } else if function.status == BodyInvalid() {
              status = status + "\nThis function has failed checks. Later dependent checks may be unavailable."
            }
            name_span = function.signature.binding.span
            // The declaration span can include the body. Show the first line.
            mut start = name_span.start.offset
            while start > 0 && source[previous(start)] != "\n" { start = previous(start) }
            mut end = start
            while end < source.len() && source[end] != "\n" { end = end + 1 }
            signature = source_map_escape(source.slice(start,end))
            rows = facts(project,function,selected,source)
          }
        }
        match prepared {
          Error(problems) => {},
          Ok(program) => {
            mapped = compile_program_with_sources(program)
            for i in 0..mapped.sources.len() {
              mapping = mapped.sources[i]
              if mapping.name == selected.emitted_name {
                for item in mapping.entries {
                  if item.span.start.file == selected.source_path {
                    instruction = mapped.bytecode.functions[i].instructions[item.index]
                    pc = item.index
                    rows = rows.append(Decision(item.span, source_map_escape(instruction_purpose(instruction)), "Compiled",
                      (if item.reason == "" { "" } else { item.reason + " " }) + "Instruction ${pc} in " + source_map_escape(selected.display_name) + ": " + source_map_escape(render_instruction(instruction)),
                      origin(project,item.span,if item.lowered { "Generated from this construct" } else { "Written expression" })))
                  }
                }
              }
            }
          }
        }
      }
      if signature == "" { Error(status + "\nNo checked function body for " + source_map_escape(selector)) }
      else { Ok(Review(project.sources.get(selected.source_path), source_map_escape(selected.display_name),signature,status,sections(project.sources.get(selected.source_path),rows))) }
    }
  }
}

// All dynamic text has been escaped for terminal display by the model. Wrap
// long source lines too, preserving indentation and splitting at spaces when possible.
pure wrap_line(text: Str, width: Nat): [Str] {
  mut lines: [Str] = []
  mut start: Nat = 0
  while start + width < text.len() {
    mut end = start + width
    while end > start && text[previous(end)] != " " { end = previous(end) }
    if end == start { end = start + width }
    lines = lines.append(text.slice(start,end))
    start = end
  }
  lines.append(text.slice(start,text.len()))
}
pure wrap(text: Str, width: Nat): [Str] {
  mut lines: [Str] = []
  mut start: Nat = 0
  for i in 0..text.len() {
    if text[i] == "\n" { lines = lines.concat(wrap_line(text.slice(start,i),width)); start = i + 1 }
  }
  lines.concat(wrap_line(text.slice(start,text.len()),width))
}
record Frame { text: Str, last_scroll: Nat }
pure screen(model: Review, group: Nat, selected: Nat, depth: Nat, width: Nat, height: Nat, page: Nat, jump: Bool): Frame {
  esc = bytes().push(27).decode_utf8()
  clear = esc + "[H" + esc + "[2J"
  if width < 30 || height < 10 { Frame(clear + "Enlarge terminal | q quit", 0) }
  else {
    cols = previous(width)
    mut lines: [Str] = []
    mut selected_line: Nat = 0
    mut footer = "Up/Down select   Enter open   Left back   q quit"
    if model.sections.len() == 0 {
      lines = ["No decisions or instructions were retained for this function."]
    } else if depth == 0 {
      lines = ["Select a statement to explore.", ""]
      for i in 0..model.sections.len() {
        section = model.sections[i]
        if group == i { selected_line = lines.len() }
        lines = lines.append((if i == group { "> " } else { "  " }) + section.statement)
      }
    } else {
      section = model.sections[group]
      lines = [section.statement, ""]
      if depth == 1 {
        for i in 0..section.decisions.len() {
          row = section.decisions[i]
          if selected == i { selected_line = lines.len() }
          lines = lines.append((if selected == i { "> " } else { "  " }) + row.label + "  [" + row.verdict + "]")
        }
      } else {
        row = section.decisions[selected]
        if depth == 2 {
          snippet = excerpt(model.source, row.site)
          lines = lines.append(row.label + "  [" + row.verdict + "]")
          if snippet != row.label && snippet != section.statement { lines = lines.append(snippet) }
          lines = lines.append(row.why)
          for site in row.origins { lines = lines.append(site.label) }
          footer = if row.origins.len() > 0 { "Enter show source   Left back   q quit" } else { "Left back   q quit" }
        } else {
          for site in row.origins { lines = lines.append(site.label).append(site.source).append("") }
          footer = "Left back   q quit"
        }
      }
    }
    if jump { footer = footer + "   n first unproved" }
    mut content = wrap(model.status,cols).concat(wrap(model.signature,cols)).append("")
    mut focus = content.len()
    for i in 0..lines.len() {
      if i == selected_line { focus = content.len() }
      content = content.concat(wrap(lines[i],cols))
    }
    mut footer_lines = wrap(footer,cols)
    mut room = remaining_space(height, footer_lines.len() + 2)
    mut offset: Nat = 0
    mut last_scroll: Nat = 0
    if content.len() > room {
      footer_lines = wrap("d/u scroll   " + footer,cols)
      room = remaining_space(height, footer_lines.len() + 2)
      if depth <= 1 && focus >= room { offset = remaining_space(focus + 1, room) }
      last_scroll = remaining_space(content.len(), offset + room)
      offset = offset + page
      if offset + room > content.len() { offset = remaining_space(content.len(), room) }
    }
    mut output = clear + "Panack explain"
    for i in 0..room {
      j = offset + i
      output = output + "\n"
      if j < content.len() { output = output + content[j] }
    }
    for line in footer_lines { output = output + "\n" + line }
    Frame(output, last_scroll)
  }
}

explore(model: Review): Void {
  mut problem_group: Nat = 0
  mut problem: Option[Nat] = None()
  for g in 0..model.sections.len() {
    rows = model.sections[g].decisions
    for i in 0..rows.len() {
      if problem == None() && (rows[i].verdict == "Unproved" || rows[i].verdict == "Rejected") {
        problem = Some(i)
        problem_group = g
      }
    }
  }
  mut group: Nat = 0
  mut selected: Nat = 0
  mut depth: Nat = 0
  mut page: Nat = 0
  mut width: Nat = 80
  mut height: Nat = 24
  mut last_scroll: Nat = 0
  mut running = true
  while running {
    event = read_line()
    if event == "quit" || event == "" { running = false } else {
      if event == "resize" {
        width = read_line().parse_nat()
        height = read_line().parse_nat()
        page = 0
      } else if event == "first_unproved" {
        match problem {
          None() => {},
          Some(index) => { group = problem_group; selected = index; depth = 1; page = 0 }
        }
      } else if event == "open" && model.sections.len() > 0 {
        if depth < 2 { depth = depth + 1 }
        else if model.sections[group].decisions[selected].origins.len() > 0 { depth = 3 }
        page = 0
      } else if event == "back" || event == "close" {
        depth = previous(depth)
        page = 0
      } else if event == "down" {
        if depth == 0 && group + 1 < model.sections.len() { group = group + 1; selected = 0 }
        else if depth == 1 && selected + 1 < model.sections[group].decisions.len() { selected = selected + 1 }
        page = 0
      } else if event == "up" {
        if depth == 0 { group = previous(group); selected = 0 } else if depth == 1 { selected = previous(selected) }
        page = 0
      }
      else if event == "pagedown" && page < last_scroll { page = page + 1 }
      else if event == "pageup" { page = previous(page) }
      frame = screen(model,group,selected,depth,width,height,page,problem != None())
      last_scroll = frame.last_scroll
      print(frame.text)
    }
  }
}
main(): Void {
  args = host.arguments()
  if args.len() != 3 || args[1] != "--function" { host.stderr("Expected SOURCE --function NAME"); host.exit(2) }
  else {
    match load(args[0],args[2]) {
      Error(problem) => { host.stderr(problem); host.exit(1) },
      Ok(model) => explore(model)
    }
  }
}
