#!/usr/bin/expect -f
# Run from the checkout root. Exercise the same command and keys as the reviewer.
set timeout 60
log_user 0
set booking tools/explain/samples/booking.panack
proc see {snippet} {
  expect {
    -exact $snippet {}
    timeout {error "Did not display '$snippet'"}
    eof {error "Explorer exited before displaying '$snippet'"}
  }
}
proc launch {file function} {
  global spawn_id env
  set binary [expr {[info exists env(PANACK_BIN)] ? $env(PANACK_BIN) : "./bin/panack"}]
  # Compare tty mode before and after the command, including Ctrl-C.
  spawn -noecho sh -c {modes() { stty -a | tr " ;" "\n" | grep -E "^-?(echo|icanon|isig|ixon|icrnl)$"; }; before=$(modes); test -n "$before" || exit 2; "$3" explain "$1" --function "$2"; rc=$?; test "$before" = "$(modes)" && echo TTY-restored; exit "$rc"} sh $file $function $binary
}
proc finish {key} {
  send -- $key
  see TTY-restored
  expect eof
  set status [wait]
  if {[lindex $status 3] != 0} {error "Explorer exited with $status"}
}
launch $booking book_pair
see "Compilation failed"
see ">   if seats >= 2 \{"
see "n first unproved"
send "n"
see "> credit - 50"
send "\r"
see "credit is at least 25"
send "\r"
see "if credit >= 25"
send "\033\[D"
see "credit is at least 25"
send "\033\[D"
see "> credit - 50"
send "\033\[D"
see ">       Ok(Balance"
finish q

set work [exec mktemp -d]
set tmpname [file join $work booking.panack]
set tmp [open $tmpname w]
set src [open $booking]
puts -nonewline $tmp [string map {{credit >= 25} {credit >= 50}} [read $src]]
close $src
close $tmp
set failed [catch {
  launch $tmpname book_pair
  see "Project compiles"
  see "Select a statement"
  send "\r"
  see "Compiled"
  finish q
} reason]
file delete -force $work
if {$failed} {error $reason}

launch examples/fibonacci.panack previous
see "Project compiles"
see "Select a statement"
send "\r"
see "Compiled"
finish "\003"
# Generated validation decisions can belong to a longer imported file.
# Exercise both the overview and detail screen against that file's own source.
set work [exec mktemp -d]
set failed [catch {
  set lib [open [file join $work rules.panack] w]
  puts $lib [string repeat "// padding for the imported declaration\n" 32]
  puts $lib {pub type Word = Str where s => s.is_non_blank()}
  close $lib
  set f [open [file join $work main.panack] w]
  puts $f {import "rules.panack"::{Word}}
  puts $f {main(): Void { print(validate[Word]("hi")) }}
  close $f
  launch [file join $work main.panack] main
  see "Project compiles"
  see "rules.panack  pub type Word"
  send "\033\[B"
  see "> project/rules.panack"
  send "\r"
  see "Enter open"
  send "\r"
  see "s.is_non_blank()"
  finish q
} reason]
file delete -force $work
if {$failed} {error $reason}

puts "Passed terminal selection, proof, source origin, back navigation, successful compilation and terminal restoration."
